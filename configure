#!/bin/bash
# Top-level "configure" for ACES_PROGRAM (aces2 + aces3 + pyaces).
#
# This is a THIN orchestrator, not a from-scratch build system: it does not
# replace any subsystem's own build machinery (aces2's GNUmakefile, aces3's
# autotools, pyaces's build.sh) -- it only records the shared toolchain
# (Intel compilers + Intel MKL, the choice already baked into all three
# subsystems independently) and module set so build.sh/run_tests.sh can
# drive them consistently instead of each needing its own manual `module
# load` + invocation remembered separately.
set -euo pipefail

MODULES="intel/2025.1.0 openmpi/5.0.7 python/3.12"
NP=4

while [ $# -gt 0 ]; do
  case "$1" in
    --modules=*) MODULES="${1#*=}" ;;
    --np=*) NP="${1#*=}" ;;
    -h|--help)
      cat <<EOF
Usage: ./configure [--modules="mod1 mod2 ..."] [--np=N]

Records the shared module/toolchain set used to build and test aces2,
aces3, and pyaces consistently (Intel compilers + Intel MKL). Does not
replace any subsystem's own build system -- see ./build.sh and
./run_tests.sh, which drive aces2/aces3/pyaces's existing build/test
scripts using this config.

  --modules   modules to 'module load' before any build/test step
              (default: "$MODULES")
  --np        default MPI rank / parallel-job count for test suites
              (default: $NP)
EOF
      exit 0 ;;
    *) echo "unknown option: $1 (see --help)" >&2; exit 1 ;;
  esac
  shift
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cat > "$ROOT/build_config.sh" <<EOF
# generated by ./configure on $(date -u +%Y-%m-%dT%H:%M:%SZ) -- do not edit by hand,
# re-run ./configure instead.
ACES_PROGRAM_ROOT="$ROOT"
ACES_PROGRAM_MODULES="$MODULES"
ACES_PROGRAM_NP=$NP
EOF

echo "Wrote $ROOT/build_config.sh"
echo "  modules: $MODULES"
echo "  np:      $NP"
echo
echo "Next:"
echo "  ./build.sh [aces2] [aces3] [pyaces]      (default: all three, dependency order)"
echo "  ./run_tests.sh [aces2] [aces3] [pyaces]  (default: all three, unified rollup table)"
echo "  sbatch build_logs/submit_unified_build.sh"
echo "  sbatch build_logs/submit_unified_tests.sh"
