     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

           PARDO i, a

                 GET R1A_HIST(a,i,NINDEX50)
                 GET CORR_VECa(a,i)

                 Tai(a,i)  = R1A_HIST(a,i,NINDEX50)
                 T1ai(a,i) = CORR_VECa(a,i)
                 TMP          = Tai(a,i) * T1ai(a,i) 

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO i, a

           PARDO j, b

                 GET R1B_HIST(b,j,NINDEX50)
                 GET CORR_VECb(b,j)

                 Tbj(b,j)  = R1B_HIST(b,j,NINDEX50)
                 T1bj(b,j) = CORR_VECb(b,j)
                 TMP          = Tbj(b,j) * T1bj(b,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO j, b
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMB   = 0.0
     C_A    = 0.0
     C_B    = 0.0

     PARDO i, a
           GET CORR_VECa(a,i)
           Tai(a,i)   = CORR_VECa(a,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
  
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              GET R1A_HIST(a,i,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ai(a,i)  = R1A_HIST(a,i,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ai(a,i) *= FACT
              T1ai(a,i) *= -1.0
              Tai(a,i)  += T1ai(a,i)

           ENDDO NINDEX50

           PUT R1a_INTMD(a,i) = Tai(a,i)

           TMP    = Tai(a,i) * Tai(a,i)
           SUMA  += TMP

     ENDPARDO i, a
     EXECUTE SERVER_BARRIER
     COLLECTIVE C_A += SUMA

     PARDO j, b
          GET CORR_VECb(b,j)
          Tbj(b,j)  = CORR_VECb(b,j)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             GET R1B_HIST(b,j,NINDEX50)
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bj(b,j) = R1B_HIST(b,j,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1bj(b,j) *= FACT
             T1bj(b,j) *= -1.0
             Tbj(b,j)  += T1bj(b,j)

          ENDDO NINDEX50

          PUT R1b_INTMD(b,j) = Tbj(b,j)

          TMP   = Tbj(b,j) * Tbj(b,j) 
          SUMB += TMP

     ENDPARDO j, b

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_B += SUMB
     EXECUTE SIP_BARRIER

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_B

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#end_debug

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a_intmd(a,i)
#         Tmp = r1a_intmd(a,i) * r1a_intmd(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get r1b_intmd(b,j)
#         tmp =   r1b_intmd(b,j) *r1b_intmd(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------

     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA = 0.0
     SUMB = 0.0
     TMPA = 0.0
     TMPB = 0.0
     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            TMPA += TMP

      ENDPARDO i, a

      EXECUTE SIP_BARRIER
      COLLECTIVE  SUMA += TMPA

      PARDO j, b

            GET  R1b_intmd(b,j)
            Tbj(b,j) =  R1b_intmd(b,j)
            TMP   = Tbj(b,j) * Tbj(b,j)
            TMPB += TMP

      ENDPARDO j, b

      EXECUTE SIP_BARRIER
      COLLECTIVE  SUMB += TMPB
      SUM_R  = SUMA
      SUM_R += SUMB

#bgn_debug
#     execute print_scalar SUM_R
#end_debug
 
      EXPONENT = 0.5
      EXECUTE NORM_FAC SUM_R EXPONENT
      INV_SQRT_NORM_ORTGC  = SUM_R
      SQRT_OVERLAP         = EXPONENT
 
      EXECUTE SIP_BARRIER
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#end_debug

    DO a
       DO i
          GET R1a_intmd(a,i)

          Tai(a,i)  = R1a_intmd(a,i)
          Tai(a,i) *= INV_SQRT_NORM_ORTGC

          PUT R1a(a,i) =  Tai(a,i)

        ENDDO i
     ENDDO a

     DO b
        DO j
           GET R1b_intmd(b,j)

           Tbj(b,j)  = R1b_intmd(b,j)
           Tbj(b,j) *= INV_SQRT_NORM_ORTGC

           PUT R1b(b,j) =  Tbj(b,j)

        ENDDO j
    ENDDO b

    EXECUTE SIP_BARRIER
#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a(a,i)
#         Tmp =  r1a(a,i) *  r1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get r1b(b,j)
#         tmp = r1b(b,j) * r1b(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug
#
    ENDPROC RESCALE_NEW_C
#   ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50) = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)   = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50

     PARDO a, i
           tai(a,i)      = 0.0
           PUT Y1a(a,i,NINDEX50)  = tai(a,i)
           PUT HY1a(a,i,NINDEX50) = tai(a,i)
           PUT R1a_intmd(a,i) = tai(a,i)
     ENDPARDO a, i

     PARDO b, j
           tbj(b,j)      = 0.0
           PUT Y1b(b,j,NINDEX50)  = tbj(b,j)
           PUT HY1b(b,j,NINDEX50) = tbj(b,j)
           PUT R1b_intmd(b,j) =  tbj(b,j)
     ENDPARDO b, j
      
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0

                     PARDO a, i

                            GET R1A_HIST(a,i,NINDEX50)
                            GET R1A_HIST(a,i,MINDEX50)

                            Tai(a,i )  = R1A_HIST(a,i,NINDEX50)
                            T1ai(a,i)  = R1A_HIST(a,i,MINDEX50)

                            TMP   = Tai(a,i ) * T1ai(a,i)
                            SUMA += TMP

                     ENDPARDO a, i

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A += SUMA

                     PARDO b, j

                           GET R1B_HIST(b,j,NINDEX50)
                           GET R1B_HIST(b,j,MINDEX50)

                           Tbj(b,j)  = R1B_HIST(b,j,NINDEX50)
                           T1bj(b,j) = R1B_HIST(b,j,MINDEX50)

                            TMP   = Tbj(b,j) * T1bj(b,j)
                            SUMB += TMP

                     ENDPARDO b, j 

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_B += SUMB

                     A_VALUE  = HC_A
                     A_VALUE += HC_B

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

              ENDDO MINDEX50
     ENDDO NINDEX50

     execute print_static etemp  iter_count

     ENDPROC C_CHECK
#    ---------------

      PROC DUMP_DENS_2JOBARC 
#     ----------------------

      DO i
      DO i1
         tmpii(i,i1) = DENS_OO_AA(i,i1)
         DO mu
            txi(mu,i1) = tmpii(i,i1) * CA(mu,i)
            DO nu
               txx1(mu,nu) = txi(mu,i1) * CA(nu,i1)
               AO_DENSITY (mu,nu) += txx1(mu,nu)
            ENDDO nu
         ENDDO mu
      ENDDO i1
      ENDDO i

      DO j
      DO j1
         tmpjj(j,j1) = DENS_OO_BB(j,j1)
         DO mu
            txj(mu,j1) = tmpjj(j,j1) * CB(mu,j)
            DO nu
               txx1(mu,nu) = txj(mu,j1) * CB(nu,j1)
               AO_DENSITY (mu,nu) += txx1(mu,nu)
            ENDDO nu
         ENDDO mu
      ENDDO j1
      ENDDO j

      DO a
      DO a1
         tmpaa(a,a1) = DENS_VV_AA(a,a1)
         DO mu
            txa(mu,a1) = tmpaa(a,a1) * CA(mu,a)
            DO nu
               txx1(mu,nu) = txa(mu,a1) * CA(nu,a1)
               AO_DENSITY (mu, nu) += txx1(mu,nu)
            ENDDO nu
         ENDDO mu
      ENDDO a1
      ENDDO a

      DO b
      DO b1
         tmpbb(b,b1) = DENS_VV_BB(b,b1)
         DO mu
            txb(mu,b1) = tmpbb(b,b1) * CB(mu,b)
            DO nu
               txx1(mu,nu) = txb(mu,b1) * CB(nu,b1)
               AO_DENSITY (mu, nu) += txx1(mu,nu)
            ENDDO nu
         ENDDO mu
      ENDDO b1
      ENDDO b

      EXECUTE SIP_BARRIER
      IF RANK == 0.0
         IF RHF_UHF == ONE
            IDENS +=  1.0
            EXECUTE  DENS2JOBARC  DENS_OO_AA IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  DENS_VV_AA IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  AO_DENSITY IDENS
         ENDIF 
         IF RHF_UHF == TWO
            IDENS +=  1.0
            EXECUTE  DENS2JOBARC  DENS_OO_AA IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  DENS_OO_BB IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  DENS_VV_AA IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  DENS_VV_BB IDENS
            IDENS += 1.0
            EXECUTE  DENS2JOBARC  AO_DENSITY IDENS
         ENDIF 
      ENDIF 

      EXECUTE  C1_FULL_PRINT  amp_print_a amp_print_b

      ENDPROC DUMP_DENS_2JOBARC 
#     -------------------------

      PROC XPROP
#     ----------
#
# Compute the density matrices and the transition moments for CIS.
#
      ONE     = 1.0
      TWO     = 2.0
      THREE   = 3.0
      ONEHALF = 0.5
      FACT_23 = TWO/THREE

      Sum1 = 0.0
      Sum2 = 0.0
      Sum3 = 0.0

      etemp1 = 0.0
      etemp2 = 0.0
      etemp3 = 0.0

      DO i
      DO i1
         tmpii(i,i1) = 0.0
         DENS_OO_AA(i,i1) = tmpii(i,i1)
      ENDDO i1
      ENDDO i

      DO j
      DO j1
         tmpjj(j,j1) = 0.0
         DENS_OO_BB(j,j1) = tmpjj(j,j1)
      ENDDO j1
      ENDDO j

      DO a
      DO a1
         tmpaa(a,a1) = 0.0
         DENS_VV_AA(a,a1) = tmpaa(a,a1)
      ENDDO a1
      ENDDO a
      DO b
      DO b1
         tmpbb(b,b1) = 0.0
         DENS_VV_BB(b,b1) = tmpbb(b,b1)
      ENDDO b1
      ENDDO b
      DO mu
      DO nu
         Txx1(mu,nu) = 0.0
         AO_DENSITY(mu,nu) = 0.0
      ENDDO nu
      ENDDO mu

      EXECUTE SIP_BARRIER

      DO i
      DO i1
      DO a
         tmpii(i,i1)  = amp_print_a(a,i)*amp_print_a(a,i1)
         DENS_OO_AA(i,i1) += tmpii(i,i1)
      ENDDO a
      ENDDO i1
      ENDDO i

      DO j
      DO j1
      DO b
         tmpjj(j,j1)  = amp_print_b(b,j)*amp_print_b(b,j1)
         DENS_OO_BB(j,j1) += tmpjj(j,j1)
      ENDDO b
      ENDDO j1
      ENDDO j

      DO a1
      DO a
      DO i
         tmp_tia(i,a1) = amp_print_a(a1,i)
         tmpaa(a,a1)  = amp_print_a(a,i)*tmp_tia(i,a1)
         DENS_VV_AA(a,a1) += tmpaa(a,a1)
      ENDDO i
      ENDDO a
      ENDDO a1

      DO b1
      DO b
      DO j
         tmp_tjb(j,b1) = amp_print_b(b1,j)
         tmpbb(b,b1)  = amp_print_b(b,j)*tmp_tjb(j,b1)
         DENS_VV_BB(b,b1) += tmpbb(b,b1)
      ENDDO j
      ENDDO b
      ENDDO b1

      EXECUTE SIP_BARRIER
#
# Density building is complete; start the transition moments
#
      PARDO mu, a
            tmpxa(mu,a) = 0.0
            PUT INTxa(mu,a) = tmpxa(mu,a)
      ENDPARDO mu, a

      PARDO mu, b
            tmpxb(mu,b) = 0.0
            PUT INTxb(mu,b) = tmpxb(mu,b)
      ENDPARDO mu, b

      PARDO mu, nu
            tmpxx(mu,nu) = 0.0
            PUT CIS_VEC_AO(mu,nu) = tmpxx(mu,nu)
      ENDPARDO mu, nu

      EXECUTE SIP_BARRIER

      PARDO mu, a
      DO i
         tmpxa(mu,a)  = amp_print_a(a,i)*Ca(mu,i)
         PUT INTxa(mu,a) += tmpxa(mu,a)
      ENDDO i
      ENDPARDO mu, a

      PARDO mu, b
      DO j
         tmpxb(mu,b)  = amp_print_b(b,j)*CB(mu,j)
         PUT INTxb(mu,b) += tmpxb(mu,b)
      ENDDO j
      ENDPARDO mu, b

      EXECUTE SIP_BARRIER

      PARDO mu, nu
      DO a
         GET INTxa(mu,a)
         tmpxx(mu,nu)  = INTxa(mu,a)*Ca(nu,a)
         PUT CIS_VEC_AO(mu,nu) += tmpxx(mu,nu)
      ENDDO a
      ENDPARDO mu, nu

      PARDO mu, nu
      DO b
         GET INTxb(mu,b)
         tmpxx(mu,nu)  = INTxb(mu,b)*CB(nu,b)
         PUT CIS_VEC_AO(mu,nu) += tmpxx(mu,nu)
      ENDDO b
      ENDPARDO mu,nu

      EXECUTE SIP_BARRIER
#bn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         Tmp = amp_print_a (a,i) * amp_print_a (a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         tmp = amp_print_b (b,j) * amp_print_b (b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#      esum = 0.0
#      etmp = 0.0
#      PARDO mu, nu
#            GET CIS_VEC_AO(mu,nu) 
#            etemp1 = CIS_VEC_AO(mu,nu)* CIS_VEC_AO(mu,nu)
#            etmp += etemp1
#      ENDPARDO mu, nu
#      execute sip_barrier 
#      collective esum+=etmp
#      EXECUTE PRINT_SCALAR ESUM
#en_debug

     PARDO  mu, nu

         GET  CIS_VEC_AO (mu,nu)

         txx1 (mu,nu) = 0.0
         txx2 (mu,nu) = 0.0
         txx3 (mu,nu) = 0.0

         EXECUTE  RETURN_1ST_MOM  txx1  ONE
         EXECUTE  RETURN_1ST_MOM  txx2  TWO
         EXECUTE  RETURN_1ST_MOM  txx3  THREE

         etmp = CIS_VEC_AO (mu,nu) * txx1  (mu,nu)
         sum1 += etmp

         etmp = CIS_VEC_AO (mu,nu) * txx2 (mu,nu)
         sum2 += etmp

         etmp = CIS_VEC_AO (mu,nu) * txx3 (mu,nu)
         sum3 += etmp

      ENDPARDO  mu, nu

      EXECUTE  SIP_BARRIER

      COLLECTIVE  etemp1 += sum1
      COLLECTIVE  etemp2 += sum2
      COLLECTIVE  etemp3 += sum3

      etemp1 *= -1.0
      etemp2 *= -1.0
      etemp3 *= -1.0
#bn_debug
      execute print_scalar etemp1
      execute print_scalar etemp2
      execute print_scalar etemp3
#en_debug

      DIP_MOM_X = etemp1
      DIP_MOM_Y = etemp2
      DIP_MOM_Z = etemp3

      DIP_SQR_X = DIP_MOM_X*DIP_MOM_X
      DIP_SQR_Y = DIP_MOM_Y*DIP_MOM_Y
      DIP_SQR_Z = DIP_MOM_Z*DIP_MOM_Z

      SQR_SUM =  DIP_SQR_X
      SQR_SUM += DIP_SQR_Y
      SQR_SUM += DIP_SQR_Z

#      EXECUTE SQUARE_ROOT SQR_SUM ONEHALF
#bn_debug
#      execute print_scalar SQR_SUM
      execute print_scalar CIS_ENEG
#en_debug

      CIS_TMOM = CIS_ENEG*SQR_SUM
      CIS_TMOM = FACT_23*CIS_TMOM
#bn_debug
      execute print_scalar CIS_TMOM
#en_debug

      EXECUTE  SIP_BARRIER

      ENDPROC XPROP
#     -------------

     PROC ANALYZE_STATE
#    ------------------

       
       DO mu
       DO nu
          txx1(mu,nu) = 0.0
          HF_DENSITY(mu,nu) = 0.0
       ENDDO nu
       ENDDO mu

       EXECUTE  SIP_BARRIER

       DO mu
       Do nu
       DO i
          txi(nu, i) = CA (nu,i)
          txx1 (mu,nu) = CA (mu,i) * txi (nu,i)
          HF_DENSITY(mu,nu) +=  txx1 (mu,nu)

       ENDDO i
       ENDDO nu
       ENDDO mu

       DO mu
       Do nu
       DO j
          txj(nu, j) = CB (nu,j)
          txx1 (mu,nu) = CB (mu,j) * txj (nu,j)
          HF_DENSITY(mu,nu) +=  txx1 (mu,nu)

       ENDDO j
       ENDDO nu
       ENDDO mu

       EXECUTE  SIP_BARRIER

# The singlet states 

       MCOUNT = 0.0
       DO MROOTS
          MCOUNT += 1.0
          IF MCOUNT > TARGET_ROOTS
             EXIT
          ENDIF 
#bgn_debug
#             execute print_scalar mcount 
#end_debug

          DO i
          DO a
            GET CISA_S_VECS(a,i,mroots)
            amp_print_a (a,i) =  CISA_S_VECS(a,i,mroots)
          ENDDO a
          ENDDO i

          DO j
          DO b
            GET  CISB_S_VECS(b,j,mroots)
            amp_print_b (b,j) = CISB_S_VECS(b,j,mroots)
          ENDDO b
          ENDDO j
 
          ROOT_ID = MCOUNT 
          EXECUTE RETURN_SELECTED CIS_S_EES ROOT_ID
          CIS_ENEG = ROOT_ID
#bgn_debug
#      execute print_scalar CIS_ENEG
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         Tmp = amp_print_a (a,i) * amp_print_a (a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         tmp = amp_print_b (b,j) * amp_print_b (b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug
          CALL XPROP

# Note that the only twelve roots can be handle through JOBARC.

          CALL DUMP_DENS_2JOBARC 

       ENDDO MROOTS

# The triplet states 

       IF RHF_UHF == TWO
          MCOUNT = 0.0
          DO MROOTS
             MCOUNT += 1.0
             IF MCOUNT > TARGET_ROOTS
                EXIT
             ENDIF
#bgn_debug
#             execute print_scalar mcount 
#end_debug
             DO i
             DO a
               GET CISA_T_VECS(a,i,mroots)
               amp_print_a (a,i) =  CISA_T_VECS(a,i,mroots)
             ENDDO a
             ENDDO i

             DO j
             DO b
               GET  CISB_T_VECS(b,j,mroots)
               amp_print_b (b,j) = CISB_T_VECS(b,j,mroots)
             ENDDO b
             ENDDO j

             ROOT_ID = MCOUNT 
             EXECUTE RETURN_SELECTED CIS_T_EES ROOT_ID
             CIS_ENEG = ROOT_ID

#bgn_debug
#     execute print_scalar CIS_ENEG
#end_debug
             CALL XPROP

# Note that the only twelve roots can be handle through JOBARC.

             CALL DUMP_DENS_2JOBARC 

          ENDDO MROOTS

       ENDIF 

     ENDPROC ANALYZE_STATE
#    ---------------------

#     BEGIN MAIN PROGRAM
#     -----------------
#
# Some initialization of constants 
#
      MULT  = 0.0
      ZERO  = 0.0
      ONE   = 1.0
      TWO   = 2.0
      THREE = 3.0
      MONE  = -1.0

      TARGET_ROOTS = eom_roots  
      CIS_THRES    = CIS_TOL
      EOM_MAXCYC   = EE_MAXCYC
      RHF_UHF      = REFERENCE 
      RHF_UHF     += ONE
      AO_DIRECT    = ONE
      EXACT_HY     = ZERO

#bgn_debug
      EXECUTE  PRINT_SCALAR  eom_maxcyc
      EXECUTE  PRINT_SCALAR  RHF_UHF 
      EXECUTE  PRINT_SCALAR  CIS_THRES
#end_debug

      CALL CREATE_ARRAYS
      IF AO_DIRECT != ONE
         CALL TRAN_UHF
      ENDIF 

      CALL FORM_DIAG
#
# The initial guess is moved to the loop that treat singlets and triplet.
# Since the triplets are simply genetrated by changing the beta block's
# element's sign one can generate the guess once for both singlets and
# tiplets, but some internal ACES III issues prevent me from doing that.
# It's so cheap it is adavantages to do it twice instead of storing.

      MAX_SUBSP_DIM = EOM_MAXCYC
#bgn_debug
      EXECUTE  PRINT_SCALAR  MAX_SUBSP_DIM
#end_debug

      SINGLET   = ZERO
      TRIPLET   = ZERO 

      DO SPN_MULT 

         MULT  += 1.0
   
         IF MULT  > RHF_UHF
            EXIT
         ENDIF 

         IF MULT == ONE 
            SINGLET = ONE
            TRIPLET = ZERO
         ELSE 
            SINGLET = ZERO 
            TRIPLET = ONE 
         ENDIF 
#bgn_debug
#         execute print_scalar mult
         execute print_scalar singlet 
         execute print_scalar triplet 
#end_debug

         CALL FORM_INITIAL_GUESS

         ROOT_COUNT = 0.0
         DO NROOTS

            EDIFF       = 0.0
            ROOT_COUNT += 1.0
            IF ROOT_COUNT > TARGET_ROOTS
               EXIT
            ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
            MYROOT = ROOT_COUNT
            CALL PREP_RPA_GUESS

            ITER_COUNT = 0.0
   
            DO SUBSP_DIM
   
               CALL SET_TO_ZERO
   
               ITER_COUNT += 1.0
#bgn_debug
         execute print_scalar ITER_COUNT
#end_debug
               IF ITER_COUNT > MAX_SUBSP_DIM
                   EXIT
                ENDIF

                CALL SAVE_C_VECTORS
#bgn_debug
#            call c_check
#end_debug
                IF AO_DIRECT == ONE
                   CALL DIRECT_AO_HC_MULT
                ELSE
                   CALL HC_MULT_MO
                ENDIF 

                CALL SAVE_HC_VECTORS

                IF ITER_COUNT ==  ONE
                   CALL FORM_A_MATRIX_11
                ELSE
                  CALL FORM_A_MATRIX_IJ
                  CALL FORM_A_MATRIX_JI
                  CALL FORM_A_MATRIX_II
                ENDIF
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
              EXECUTE XGEEV A_MATRIX DVECTORS
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
               IF ITER_COUNT != 1.0
                  CALL REORDER_A_EIGS
               ENDIF
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal.
#
               IF ITER_COUNT == 1.0
                  CALL FORM_NEWVECS_ITR1
               ELSE

                  IF EXACT_HY == ONE
                     CALL FORM_NEWVECS
                     CALL SELECT_VECS
                     CALL FORM_SELECTED_Y
                     CALL FORM_HBAR_Y_VECS
                  ElSE
                     CALL FORM_NEWVECS
                     CALL SELECT_VECS
                     CALL FORM_SELECTED_Y
                     CALL FORM_NEW_HBAR_Y_VECS
                     CALL SELECT_HBAR_Y_VEC_TOGO
                  ENDIF 
    
                  CALL FORM_RESIDUAL_VEC
    
                  CALL CHECK_CONVERGENCE

                  IF ITER_COUNT > ONE
                     EDIFF = E_OLD - OMEGA
                  ENDIF
                  E_OLD = OMEGA
                  EDIFF *=EDIFF
                  EXECUTE SQUARE_ROOT EDIFF HALF

#bgn_debug
      execute print_scalar RESIDUAL_NORM
      execute print_scalar OMEGA
      execute print_scalar EDIFF 
#end_debug
                  IF RESIDUAL_NORM  < CIS_THRES
                     EXIT
                  ELSE
                     CALL FORM_CORRECTION_VEC
    
                     CALL DRIVE_ORTHO
    
                     CALL RESCALE_NEW_C
                  ENDIF 

               ENDIF 

             ENDDO SUBSP_DIM
    
             EXECUTE SERVER_BARRIER

             IF ITER_COUNT == MAX_SUBSP_DIM
                IF RESIDUAL_NORM  > CIS_THRES
                   IF EDIFF < CIS_THRES
#bgn_debug
      execute print_scalar EDIFF 
#end_debug
                      OMEGA= OMEGA
                   ELSE

# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means
#
                      OMEGA = 0.0
                   ENDIF 
                ENDIF
             ENDIF
    
             IF SINGLET == ONE 
                MCOUNT = 0.0
                DO MROOTS
                   MCOUNT += 1.0
                   IF MCOUNT == ROOT_COUNT
                      CIS_S_EES(MROOTS) = OMEGA
                   PARDO a, i
                      GET R1A(a,i) 
#bgn_debug
#                      execute dump_amp R1A(a,i)
#end_debug
                      PUT CISA_S_VECS(a,i,MROOTS) = R1A(a,i)
                   ENDPARDO a, i
                   PARDO b, j
                      GET R1B(b,j) 
#bgn_debug
#                      execute dump_amp R1B(b,j)
#end_debug
                      PUT CISB_S_VECS(b,j,MROOTS) = R1B(b,j)
                   ENDPARDO b, j
                   ENDIF
                ENDDO MROOTS
             ENDIF 

             IF TRIPLET == ONE 
                MCOUNT = 0.0
                DO MROOTS
                   MCOUNT += 1.0
                   IF MCOUNT == ROOT_COUNT
                      CIS_T_EES(MROOTS) = OMEGA
                   PARDO a, i
                      GET R1A(a,i) 
                      PUT CISA_T_VECS(a,i,MROOTS) = R1A(a,i)
                   ENDPARDO a, i
                   PARDO b, j
                      GET R1B(b,j) 
                      PUT CISB_T_VECS(b,j,MROOTS) = R1B(b,j)
                   ENDPARDO b, j
                   ENDIF
                ENDDO MROOTS 
              ENDIF 

          ENDDO NROOTS


#bgn_debug
      ROOT_COUNT -= 1.0
      IF SINGLET == ONE
         execute print_static CIS_S_EES ROOT_COUNT
         MARKER = 28.0
         execute print_rel_info MARKER CIS_S_EES 
      ENDIF 
      IF TRIPLET == ONE
         execute print_static CIS_T_EES ROOT_COUNT
         MARKER = 29.0
         execute print_rel_info MARKER CIS_T_EES 
      ENDIF 
#end_debug

      ENDDO SPN_MULT

      EXECUTE SERVER_BARRIER

# The following DENS2JOBARC call add record "CIS" to the JOBARC file.

      IF RANK == 0.0
        NINE_NINE = 99.0 
        execute print_rel_info NINE_NINE CIS_T_EES 
        PRINT_FLAG = -1.0
        EXECUTE DENS2JOBARC HF_DENSITY PRINT_FLAG
      ENDIF 
      IDENS = 1.0
      CALL ANALYZE_STATE 

      EXECUTE SERVER_BARRIER 
      EXECUTE BLOCKS_TO_LIST  CISA_S_VECS
      EXECUTE BLOCKS_TO_LIST  CISB_S_VECS 
      EXECUTE BLOCKS_TO_LIST  CISA_T_VECS
      EXECUTE BLOCKS_TO_LIST  CISB_T_VECS
      EXECUTE WRITE_BLOCKS_TO_LIST
      EXECUTE SERVER_BARRIER 

                       ENDSIAL AO_DIRECT_CIS_UHF
#                      -------------------------
