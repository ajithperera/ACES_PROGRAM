#      execute print_scalar sumb
#end_debug

     EXECUTE SIP_BARRIER

     ENDPROC FORM_MO_R1AB
#    --------------------

     PROC AO_HC_MULTIPLY
#    -------------------

#  (A+B)(ai,bj)  R+_old(b,J)  = R+_new(a,i)
#  (A-B)(ai,bj)  R-_old(b,J)  = R__new(a,i)

#  All possible spin-combinations are included.

     PARDO MU, NU, LAMBDA, SIGMA

         TAPXX(MU,LAMBDA) = 0.0
         TBPXX(MU,LAMBDA) = 0.0

         COMPUTE_INTEGRALS AOINT(MU,LAMBDA,NU,SIGMA)
         TC0XXXX(MU,LAMBDA,NU,SIGMA) = AOINT(MU,LAMBDA,NU,SIGMA)

         COMPUTE_INTEGRALS AOINT(MU,SIGMA,LAMBDA,NU)
         TE1XXXX(MU,SIGMA,LAMBDA,NU) = AOINT(MU,SIGMA,LAMBDA,NU)

         GET R1A_AO(NU,SIGMA)
         GET R1B_AO(NU,SIGMA)

         TAXXP(NU,SIGMA) = R1A_AO(NU,SIGMA)
         TBXXP(NU,SIGMA) = R1B_AO(NU,SIGMA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TAPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TAPXX_INT(MU,LAMBDA) *= -1.0
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TBPXX_INT(MU,LAMBDA) *= -1.0
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         PUT HR1A_AO(MU,LAMBDA) += TAPXX(MU,LAMBDA)
         PUT HR1B_AO(MU,LAMBDA) += TBPXX(MU,LAMBDA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SIP_BARRIER

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo mu, nu
#         get hr1a_ao(mu,nu)
#         Tmp =  hr1a_ao(mu,nu) *  hr1a_ao(mu,nu)
#         tmpa += tmp
#      endpardo mu,nu
#      pardo mu, nu
#         get hr1b_ao(mu,nu)
#         tmp =  hr1b_ao(mu,nu) *  hr1b_ao(mu,nu)
#         tmpb += tmp
#      endpardo mu,nu
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug


     ENDPROC AO_HC_MULTIPLY
#    ----------------------

    PROC DIRECT_AO_HC_MULT
#    ----------------------

     PARDO A, I
        TAIP_R(A,I)   = 0.0
        PUT HR1A(A,I) = TAIP_R(A,I)
     ENDPARDO A, I

     PARDO B, J
        TBJP_R(B,J)   = 0.0
        PUT HR1B(B,J) = TBJP_R(B,J)
     ENDPARDO B, J

     PARDO mu, nu
          TXXP_T(MU,NU)     = 0.0

          PUT R1A_AO(MU,NU) =  TXXP_T(MU,NU)
          PUT R1B_AO(MU,NU) =  TXXP_T(MU,NU)

          PUT HR1A_AO(MU,NU) =  TXXP_T(MU,NU)
          PUT HR1B_AO(MU,NU) =  TXXP_T(MU,NU)
     ENDPARDO mu, nu
     EXECUTE SIP_BARRIER

     CALL FORM_AO_R1AB

     CALL AO_HC_MULTIPLY

     CALL FORM_FOCK_CONTRIBUTION

     CALL FORM_MO_R1AB

     ENDPROC DIRECT_AO_HC_MULT
#    ----------------------

      PROC HC_MULT_MO
#     ---------------
      PARDO a, i
            tai(a,i) = 0.0
            PUT HR1A(a,i) = tai(a,i)
      ENDPARDO a, i
#
      PARDO b, j
            tbj(b,j) = 0.0
            PUT HR1B(b,j) = tbj(b,j)
      ENDPARDO b, j
      EXECUTE SIP_BARRIER 
#
      PARDO a, i
#
            tai(a,i) = 0.0
#
            DO i1
               GET         R1A(a,i1)
               t2ai(a,i) = R1A(a,i1)*fock_a(i1,i)
               tai(a,i) -= t2ai(a,i)
            ENDDO i1
#
            DO a1
#
               GET         R1A(a1,i)
               t1ai(a,i) = R1A(a1,i)*fock_a(a,a1)
               tai(a,i) += t1ai(a,i)
#
            ENDDO a1
#
            PUT HR1A(a,i) = tai(a,i)
#
      ENDPARDO a, i
#
      PARDO b, j
#
            tbj(b,j) = 0.0
#
            DO j1
#
               GET         R1B(b,j1)
               t2bj(b,j) = R1B(b,j1)*fock_b(j1,j)
               tbj(b,j) -= t2bj(b,j)
#
            eNDDO j1
#
            DO b1
#
               GET         R1B(b1,j)
               t1bj(b,j) = R1B(b1,j)*fock_b(b,b1)
               tbj(b,j) += t1bj(b,j)
#
            ENDDO b1
#
            PUT HR1B(b,j) = tbj(b,j)
#
      ENDPARDO b, j
#
      execute sip_barrier 
#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get hr1a(a,i)
#         Tmp =  hr1a(a,i) *  hr1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get hr1b(b,j)
#         tmp = hr1b(b,j) * hr1b(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug
#
      PARDO a, i, b, j 
#
            REQUEST              Viabj(i,a,b,j) a 
            GET                  R1B(b,j)
            t2ai(a,i)          = Viabj(i,a,b,j)*R1B(b,j)
            PUT HR1A(a,i) += t2ai(a,i)
            GET                  R1A(a,i)
            t1bj(b,j)          =  Viabj(i,a,b,j)*R1A(a,i)
            PUT HR1B(b,j)+= t1bj(b,j)

      ENDPARDO a, i, b, j 
#
      PARDO a, i, a1, i1     
#
            REQUEST             Viaai(i1,a1,a,i) i
            GET                 R1A(a1,i1)
            tai(a,i)          = Viaai(i1,a1,a,i)*R1A(a1,i1)
            PUT HR1A(a,i)+= tai(a,i)
#
      ENDPARDO a, i, a1, i1     
#
      PARDO b, j, b1, j1  
#
            REQUEST             Vjbbj(j1,b1,b,j) j
            GET                 R1B(b1,j1)
            tbj(b,j)          = Vjbbj(j1,b1,b,j)*R1B(b1,j1)
            PUT HR1B(b,j)+= tbj(b,j)
#
      ENDPARDO b, j, b1, j1    
      execute sip_barrier
#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get hr1a(a,i)
#         tai(a,i) =  hr1a(a,i)
#         execute dump_amp tai(a,i) 
#         Tmp =  hr1a(a,i) *  hr1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get hr1b(b,j)
#         tbj(b,j) =  hr1b(b,j)
#         execute dump_amp tbj(b,j) 
#         tmp = hr1b(b,j) * hr1b(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug
#
      ENDPROC HC_MULT_MO
#     -----------------
#
     PROC FORM_INITIAL_GUESS
#    -----------------------
     DO NROOTS 
        PARDO a, i
            INIT_RVEC_AA(a,i,NROOTS) = 0.0
            DIAGA(a,i)               = 0.0
        ENDPARDO a, i
     ENDDO NROOTS 

     DO NROOTS 
        PARDO b, j
            INIT_RVEC_BB(b,j,NROOTS) = 0.0
            DIAGB(b,j)               = 0.0
        ENDPARDO b, j
     ENDDO NROOTS 

     DO a 
     DO i
        GET R1DA(a,i)
        Tai(a,i)   = R1DA(a,i)
        DIAGA(a,i) = Tai(a,i)
     ENDDO i
     ENDDO a 

     DO b
     DO j
        GET R1DB(b,j)
        Tbj(b,j)   = R1DB(b,j)
        DIAGB(b,j) = Tbj(b,j)
     ENDDO j 
     ENDDO b
     EXECUTE SIP_BARRIER 
   
     EXECUTE FORM_RPA_GUESS DIAGA INIT_RVEC_AA
     EXECUTE FORM_RPA_GUESS DIAGB INIT_RVEC_BB

     EXECUTE SIP_BARRIER 

     ENDPROC FORM_INITIAL_GUESS
#    --------------------------

     PROC PREP_RPA_GUESS
#    -------------------

      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_AA MYROOT 
      IF TRIPLET == ONE 
          MYROOT *= -1.0
      ENDIF 
      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_BB MYROOT 
      IF TRIPLET == ONE 
          MYROOT *= -1.0
      ENDIF 

      COUNTER = 0.0
#
# Always copy the position one because the above SIP copies the 
# the guess for the current root to position one. 

      DO MROOTS

         COUNTER += 1.0
        
         IF COUNTER > ONE 
            EXIT
         ENDIF 

            PARDO a, i 
                Tai(a,i) =  INIT_RVEC_AA(a,i,mroots)
                PUT R1a_intmd(a,i)  =  Tai(a,i)
                PUT INIT_VEC_A(a,i) =  Tai(a,i)
            ENDPARDO a, i

            PARDO b, j
               Tbj(b,j)  = INIT_RVEC_BB(b,j,mroots)
               PUT R1b_intmd(b,j)  =  Tbj(b,j)
               PUT INIT_VEC_B(b,j) =  Tbj(b,j)
            ENDPARDO b, j

      ENDDO MROOTS

      EXECUTE SIP_BARRIER
#bgn_debug
#      tmpa = 0.0
#      do i 
#      do a
#         Get R1a_intmd(a,i)
#         tmp  = R1a_intmd(a,i) * R1a_intmd(a,i)
#         tmpa += tmp
#      enddo a
#      enddo i
#      execute print_scalar tmpa
#end_debug

      SUMA = 0.0
      SUMB = 0.0
      TMPA = 0.0
      TMPB = 0.0
      PARDO i, a
            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            TMPA += TMP
      ENDPARDO i, a

      PARDO j, b
            GET  R1b_intmd(b,j)
            Tbj(b,j) =  R1b_intmd(b,j)
            TMP   = Tbj(b,j) * Tbj(b,j)
            TMPB += TMP
      ENDPARDO j, b

      EXECUTE SIP_BARRIER
      COLLECTIVE  SUMA += TMPA
      COLLECTIVE  SUMB += TMPB
      EXECUTE SIP_BARRIER
      SUMAB  = SUMA
      SUMAB += SUMB

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB
      NORM_R = SUMAB

      PARDO i, a
            GET  R1a_intmd(a,i)
            Tai(a,i)  = R1a_intmd(a,i)
            Tai(a,i) *= INV_SQRT_NORM_R
            PUT R1a(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO j, b
            GET  R1b_intmd(b,j)
            Tbj(b,j)  =  R1b_intmd(b,j)
            Tbj(b,j) *= INV_SQRT_NORM_R
            PUT  R1b(b,j) = Tbj(b,j)
      ENDPARDO j, b

      EXECUTE SIP_BARRIER

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a(a,i)
#         tai(a,i) = r1a(a,i)
#         execute dump_amp tai
#         Tmp =  r1a(a,i) *  r1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get r1b(b,j)
#         tbj(b,j) = r1b(b,j)
#         execute dump_amp tbj
#        tmp = r1b(b,j) * r1b(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug

     ENDPROC PREP_RPA_GUESS
#    ----------------------
#
     PROC FORM_DIAG
#    --------------
#
# -----prepare f_ii diagonal = Sdii
#
     PARDO i, i1
      WHERE i==i1
#
           tii(i1,i)      = fock_a(i1,i)
           execute return_diagonal4 tii
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1

# -----prepare f_aa diagonal = DDaa

     PARDO a, a1
      WHERE a==a1

           taa(a,a1)      = fock_a(a,a1)
           execute return_diagonal4 taa
           put DDaa(a,a1) = taa(a,a1)
#
     ENDPARDO a, a1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
      WHERE j==j1
#
        tjj(j1,j)      = fock_b(j1,j)
        execute return_diagonal4 tjj
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1

# -----prepare f_bb diagonal = DDbb

     PARDO b, b1
      WHERE b==b1
#
        tbb(b,b1)      = fock_b(b,b1)
        execute return_diagonal4 tbb
        put DDbb(b,b1) = tbb(b,b1)
#
     ENDPARDO b, b1

     execute sip_barrier

# -----prepare Hbar_aiai diagonal

     IF AO_DIRECT==ZERO

     PARDO a, i

           tai(a,i) = 0.0

           do a1
           do i1

               REQUEST             Viaai(i1,a1,a,i) i
               Tiaai(i1,a1,a,i)  = Viaai(i1,a1,a,i)

               Taaii(a,a1,i,i1)  = Tiaai(i1,a1,a,i)
               execute return_diagonal4 Taaii
               tia(i1,a1)        = 1.0
               t1ai(a,i)         = Taaii(a,a1,i,i1)*tia(i1,a1)
               tai(a,i)         += t1ai(a,i)

           enddo i1
           enddo a1

           PUT R1DA(a,i) = tai(a,i)

     ENDPARDO a, i

# -----prepare Hbar_bjbj diagonal

     PARDO b, j

           tbj(b,j) = 0.0

           do b1
           do j1

               REQUEST             Vjbbj(j1,b1,b,j) j

               Tjbbj(j1,b1,b,j)  = Vjbbj(j1,b1,b,j)

               Tbbjj(b,b1,j,j1)  = Tjbbj(j1,b1,b,j)
               execute return_diagonal4 Tbbjj
               tjb(j1,b1)        = 1.0
               t1bj(b,j)         = Tbbjj(b,b1,j,j1)*tjb(j1,b1)
               tbj(b,j)         += t1bj(b,j)

           enddo j1
           enddo b1

           PUT R1DB(b,j) = tbj(b,j)

     ENDPARDO b, j
     ENDIF 

#     execute sip_barrier
#
# ---------compute T(a,i)=F(a,a)-f(i,i)-v(a,i,a,i)
#
     PARDO a, i
#
           tai(a,i) = 0.0
#
           do a1
#
              get         DDaa(a,a1)
              tia(i,a1) = 1.0
              taa(a1,a) = DDaa(a,a1)
#
              t2ai(a,i) = tia(i,a1)*taa(a1,a)
              tai(a,i) += t2ai(a,i)
#
           enddo a1
#
           do i1
#
              get         DDii(i1,i)
              t2ia(i1,a)= 1.0
              tii(i,i1) = DDii(i1,i)
#
              t2ai(a,i) = tii(i,i1)*t2ia(i1,a)
              t2ai(a,i)*= -1.0
              tai(a,i) += t2ai(a,i)
#
           enddo i1
#
           PUT R1DA(a,i)+=tai(a,i)
#
     ENDPARDO a, i
#
# ---------compute T(b,j)=F(b,b)-f(j,j)
#
     PARDO b, j
#
           tbj(b,j)=0.0
#
           do b1
#
              get         DDbb(b,b1)
              tjb(j,b1) = 1.0
              tbb(b1,b) = DDbb(b,b1)
              t2bj(b,j) = tjb(j,b1)*tbb(b1,b)
              tbj(b,j) += t2bj(b,j)
#
           enddo b1
#
           do j1
#
              get         DDjj(j1,j)
              t2jb(j1,b)= 1.0
              tjj(j,j1) = DDjj(j1,j)
              t2bj(b,j) = tjj(j,j1)*t2jb(j1,b)
              t2bj(b,j)*= -1.0
              tbj(b,j) += t2bj(b,j)
#
           enddo j1
#
           PUT R1DB(b,j)+= tbj(b,j)
#
     ENDPARDO b, j
#
     execute sip_barrier

     ENDPROC FORM_DIAG
#    -----------------

      PROC SAVE_C_VECTORS
#     ------------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            DO a
               DO i
                  GET R1A(a,i)
                  Tai(a,i) = R1A(a,i)
                  Taix(a,i,NINDEX50) = Tai(a,i)
                  PUT R1A_HIST(a,i,NINDEX50) = Taix(a,i,NINDEX50)
               ENDDO i
            ENDDO a

            DO b
               DO j
                  GET R1B(b,j)
                  Tbj(b,j) = R1B(b,j)
                  Tbjx(b,j,NINDEX50) = Tbj(b,j)
                  PUT R1B_HIST(b,j,NINDEX50) = Tbjx(b,j,NINDEX50) 
               ENDDO j
            ENDDO b
        ENDIF

      ENDDO NINDEX50

      execute sip_barrier 
