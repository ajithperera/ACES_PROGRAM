      temp Tbbai(b,b1,a,i)
      temp T1aix(a,i,NINDEX50)
      temp T1bjx(b,j,NINDEX50)
      temp TXX(MINDEX50,MINDEX50)
      temp Taip_R(a,i)
      temp Tbjp_R(b,j)
      temp Txxp(mu,nu)
      temp Txxp_t(mu,nu)
      temp Txip_t(mu,i)
      temp Txjp_t(mu,j)
