#      execute print_scalar sumb
#end_debug

   ENDPROC FORM_AO_R1AB
#  --------------------

     PROC FORM_MO_R1AB
#    -----------------

     PARDO MU, NU

         GET HR1A_AO(NU,MU)
         TXXP(NU,MU) = HR1A_AO(NU,MU)
         DO A
            TXAP(NU,A) = TXXP(NU,MU) * CA(MU,A)
            DO I
               TAIP_R(A,I)    = TXAP(NU,A) * CA(NU,I)
               PUT HR1A(A,I) += TAIP_R(A,I)
            ENDDO I
         ENDDO A

     ENDPARDO MU, NU

    PARDO MU, NU

         GET HR1B_AO(NU,MU)
         TXXP(NU,MU) = HR1B_AO(NU,MU)
         DO B
            TXBP(NU,B) = TXXP(NU,MU) * CB(MU,B)
            DO J
               TBJP_R(B,J)    = TXBP(NU,B) * CB(NU,J)
               PUT HR1B(B,J) += TBJP_R(B,J)
             ENDDO J
         ENDDO B
     ENDPARDO MU, NU

#bgn_debug
