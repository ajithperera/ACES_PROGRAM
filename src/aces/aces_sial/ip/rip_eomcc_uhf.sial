              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2bb_a_HIST(b,j,kk1,i,MINDEX50) i

                       Tbjkis(b,j,kk1,i,MINDEX50) = HR2bb_a_HIST(b,j,kk1,i,MINDEX50)
                       T1bjkis(b,j,kk1,i,NINDEX50) = Tbjkis(b,j,kk1,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50) += T1bjkis(b,j,kk1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER

    ENDPROC TRANSFORM_HC
#   --------------------

    PROC COPY_NORM_C
#   ----------------

     NCOUNT = 0.0
     DO NINDEX50

     NCOUNT += 1.0
     IF NCOUNT <= NREDUCE

     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0

     PARDO i, kk1

            GET  Y1a_TRUNCT(i,kk1,NINDEX50)
            Tikk(i,kk1) = Y1a_TRUNCT(i,kk1,NINDEX50)
            TMP   = Tikk(i,kk1) * Tikk(i,kk1)
            HC_A += TMP

      ENDPARDO i, kk1

      PARDO j, kk1

            GET Y1b_TRUNCT(j,kk1,NINDEX50)
            Tjkk(j,kk1) = Y1b_TRUNCT(j,kk1,NINDEX50)
            TMP   = Tjkk(j,kk1) * Tjkk(j,kk1)
            HC_B += TMP

      ENDPARDO j, kk1

      PARDO i, i1, kk1, a

              REQUEST Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50) i
              Taiki(a,i,kk1,i1) = Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50)
              TMP   = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1)
              HC_AAA += TMP

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b

              REQUEST Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50) j
              Tbjkj(b,j,kk1,j1) = Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50)
              TMP   = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
              HC_BBB +=  TMP

     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

              REQUEST Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50) i
              Taikj(a,i,kk1,j) = Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50)
              TMP   = Taikj(a,i,kk1,j) * Taikj(a,i,kk1,j)
              HC_AAB +=  TMP

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

              REQUEST Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50) j
              Tbjki(b,j,kk1,i) = Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50)
              TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i)
              HC_BBA +=  TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT

     EXECUTE SIP_BARRIER
     DO kk1
        DO i
           GET Y1a_TRUNCT(i,kk1,NINDEX50)
           Tikk(i,kk1)  = Y1a_TRUNCT(i,kk1,NINDEX50)
           Tikk(i,kk1) *= INV_SQRT_NORM_ORTGC
           PUT R1a_HIST(i,kk1,NINDEX50) =  Tikk(i,kk1)
         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET Y1b_TRUNCT(j,kk1,NINDEX50)
            Tjkk(j,kk1)  = Y1b_TRUNCT(j,kk1,NINDEX50)
            Tjkk(j,kk1) *= INV_SQRT_NORM_ORTGC
            PUT R1b_HIST(j,kk1,NINDEX50) =  Tjkk(j,kk1)
         ENDDO j
     ENDDO kk1

     PARDO i, i1, kk1, a
         REQUEST Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50) i
         Taiki(a,i,kk1,i1)  = Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50)
         Taiki(a,i,kk1,i1) *= INV_SQRT_NORM_ORTGC
         PREPARE R2aa_a_HIST(a,i,kk1,i1,NINDEX50) = Taiki(a,i,kk1,i1)
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b
         REQUEST Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50) j
         Tbjkj(b,j,kk1,j1)  = Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50)
         Tbjkj(b,j,kk1,j1) *= INV_SQRT_NORM_ORTGC
         PREPARE R2bb_b_HIST(b,j,kk1,j1,NINDEX50) = Tbjkj(b,j,kk1,j1)
     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j
        REQUEST Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50) i
        Taikj(a,i,kk1,j)  =  Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50)
        Taikj(a,i,kk1,j) *= INV_SQRT_NORM_ORTGC
        PREPARE R2aa_b_HIST(a,i,kk1,j,NINDEX50) = Taikj(a,i,kk1,j)
     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
        REQUEST Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50) j
        Tbjki(b,j,kk1,i)  = Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50)
        Tbjki(b,j,kk1,i) *= INV_SQRT_NORM_ORTGC
        PREPARE R2bb_a_HIST(b,j,kk1,i,NINDEX50) = Tbjki(b,j,kk1,i)
     ENDPARDO j, i, kk1, b

     ENDIF
     ENDDO NINDEX50 

     EXECUTE SERVER_BARRIER
   
    ENDPROC COPY_NORM_C
#   -------------------

     PROC COPY_HC
#    ------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT <= NREDUCE
         DO kk1
           DO i
              GET Y1a_TRUNCT(i,kk1,NINDEX50)
              Tikk(i,kk1)  = Y1a_TRUNCT(i,kk1,NINDEX50)
              PUT HR1a_HIST(i,kk1,NINDEX50) =  Tikk(i,kk1)
            ENDDO i
        ENDDO kk1

        DO kk1
            DO j
               GET Y1b_TRUNCT(j,kk1,NINDEX50)
               Tjkk(j,kk1)  = Y1b_TRUNCT(j,kk1,NINDEX50)
               PUT HR1b_HIST(j,kk1,NINDEX50) =  Tjkk(j,kk1)
            ENDDO j
        ENDDO kk1

        PARDO i, i1, kk1, a
            REQUEST Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50) i
            Taiki(a,i,kk1,i1)  = Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50)
            PREPARE HR2aa_a_HIST(a,i,kk1,i1,NINDEX50) = Taiki(a,i,kk1,i1)
        ENDPARDO i, i1, kk1, a

        PARDO j, j1, kk1, b
            REQUEST Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50) j
            Tbjkj(b,j,kk1,j1)  = Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50)
            PREPARE HR2bb_b_HIST(b,j,kk1,j1,NINDEX50) = Tbjkj(b,j,kk1,j1)
        ENDPARDO j, j1, kk1, b

        PARDO a, i, kk1, j
           REQUEST Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50) i
           Taikj(a,i,kk1,j)  =  Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50)
           PREPARE HR2aa_b_HIST(a,i,kk1,j,NINDEX50) = Taikj(a,i,kk1,j)
        ENDPARDO a, i, kk1, j

        PARDO j, i, kk1, b
           REQUEST Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50) j
           Tbjki(b,j,kk1,i)  = Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50)
           PREPARE HR2bb_a_HIST(b,j,kk1,i,NINDEX50) = Tbjki(b,j,kk1,i)
        ENDPARDO j, i, kk1, b

     ENDIF
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

     ENDPROC COPY_HC
#    ---------------

     PROC TRUNCATE
#    -------------
# Reduce the subspace dimension.

     EXECUTE SERVER_BARRIER  
     IF EOM_MAXCYC < TWELVE
        NREDUCE  = EOM_MAXCYC
        NREDUCE -= THREE
     ELSE
        NREDUCE = TWELVE
     ENDIF
     NFULL  = ITER_COUNT

     EXECUTE SET_ACES3_VARS NREDUCE TEN
     EXECUTE SET_ACES3_VARS NFULL   ELV
     EXECUTE SET_ACES3_VARS OMEGA   TWL

     EXECUTE TRUNCATE_EOM_SUBSPACE A_DIAGS DVECTORS
#bgn_debug
#     execute print_static A_DIAGS NREDUCE
#     execute print_static DVECTORS NFULL
#end_debug

     IF TRNC_COUNT > ONE
        CALL INIT_TO_ZERO
     ENDIF
     CALL TRANSFORM_C
     CALL COPY_NORM_C
     CALL INIT_TO_ZERO
     CALL TRANSFORM_HC
     CALL COPY_HC

     ENDPROC TRUNCATE
#    ----------------

     PROC INIT_DESTN_ARRAYS
#    ----------------------
  
     DO MROOTS 
     PARDO i, i1, kk1, a
         Taiki(a,i,kk1,i1)  = ZERO
         PREPARE R2aa_a_VECS(a,i,kk1,i1,MROOTS) = Taiki(a,i,kk1,i1)
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b
         Tbjkj(b,j,kk1,j1)  = ZERO
         PREPARE R2bb_b_VECS(b,j,kk1,j1,MROOTS) = Tbjkj(b,j,kk1,j1)
     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j
         Taikj(a,i,kk1,j)  =  ZERO
         PREPARE R2aa_b_VECS(a,i,kk1,j,MROOTS) = Taikj(a,i,kk1,j)
     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
        Tbjki(b,j,kk1,i)  = ZERO
        PREPARE R2bb_a_VECS(b,j,kk1,i,MROOTS) = Tbjki(b,j,kk1,i)
     ENDPARDO j, i, kk1, b
     ENDDO MROOTS 

     EXECUTE SERVER_BARRIER 

     ENDPROC INIT_DESTN_ARRAYS
#    -------------------------

     PROC SET_EOM_INCLUDE
#    --------------------

     EXECUTE SET_ACES3_VARS ITER_COUNT FORT
     EXECUTE SET_ACES3_VARS ROOT_COUNT FIFT

     ENDPROC SET_EOM_INCLUDE
#    -----------------------
     
     PROC INIT_AUX_STATIC_ARRAYS
#    ---------------------------

      DO MINDEX50
      DO NINDEX50
         ETEMP(NINDEX50,MINDEX50)    = ZERO
      ENDDO NINDEX50
      ENDDO MINDEX50

      DO NINDEX50
        A_DIAGS(NINDEX50)          = ZERO
        OVERLAP_R(NINDEX50)        = ZERO
      ENDDO NINDEX50

      DO KK1
      DO MROOTS
         PSEUDO_ROOTS(MROOTS,KK1) = ZERO
         EOM_IPS(MROOTS)          = ZERO
         DUMMY(KK1,KK1)           = ZERO
      ENDDO MROOTS
      ENDDO KK1

      DO i 
      DO NROOTS
          RVEC_AA_INTMD(i,NROOTS) = ZERO
      ENDDO NROOTS
      ENDDO i

      dO j
      DO NROOTS
         RVEC_BB_INTMD(j,NROOTS) = ZERO
      ENDDO NROOTS
      ENDDO j 

      EXECUTE SIP_BARRIER

     ENDPROC INIT_AUX_STATIC_ARRAYS
#    ------------------------------

    PROC ORTHO_NEW_ROOT
#   -------------------
# If we wants to use the exsisting sub-space for the next root, we
# need to orthogonalize the new guess vector to the exsisting subspace.
# Lets use the exsisting arrays and the Schmidt routines.

    PARDO i, kk1
        GET R1A(i,kk1)
        Tikk(i,kk1) = R1A(i,kk1)
        PUT CORR_VECa(i,kk1) = Tikk(i,kk1)
    ENDPARDO i, kk1

    PARDO j, kk1
        GET R1B(j,kk1)
        Tjkk(j,kk1) = R1B(j,kk1)
        PUT  CORR_VECb(j,kk1) =  Tjkk(j,kk1)
    ENDPARDO j, kk1

    PARDO i, i1, kk1, a
        Taiki(a,i,kk1,i1) = 0.0
        PUT CORR_VECaa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)
    ENDPARDO i, i1, kk1, a

    PARDO j, j1, kk1, b
        Tbjkj(b,j,kk1,j1) = 0.0
        PUT CORR_VECbb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)
    ENDPARDO j, j1, kk1, b

    PARDO a, i, kk1, j
        Taikj(a,i,kk1,j) = 0.0
        PUT CORR_VECaa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)
    ENDPARDO a,i, kk1, j

    PARDO j, i, kk1, b
        Tbjki(b,j,kk1,i) = 0.0
         PUT CORR_VECbb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)
    ENDPARDO j, i, kk1, b

    EXECUTE SIP_BARRIER 

    CALL DRIVE_ORTHO

    CALL RESCALE_NEW_C

    ENDPROC ORTHO_NEW_ROOT
#   ----------------------

#     BEGIN MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO     = 0.0
     ONE      = 1.0
     TEN      = 10.0
     ELV      = 11.0
     TWELVE   = 12.0
     THRTEN   = 13.0
     TWL      = TWELVE
     NINETEEN = 19.0
     MONE     = -1.0
     THREE    = 3.0
     FORT     = 14.0
     FIFT     = 15.0

     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC
     EXACT_HY     = ZERO
     MAX_OVLP     = ONE
     MIN_ENEG     = ZERO
     LOCK_THRES   = 0.001
     FIRST_VEC    = ONE
     PREVS_VEC    = ZERO
     LEFT         = ZERO
     RIGHT        = ZERO
     FRESH_SBSP   = ZERO
#
     CALL READ_DATA
     CALL CREATE_ARRAYS 
     CALL INIT_DESTN_ARRAYS 
     CALL INIT_AUX_STATIC_ARRAYS

     EXECUTE SET_ACES3_VARS RIGHT LEFT

# The default denominator is 1P-Hbar and can be switched to Hbar
     
     CALL FORM_1HHP_DIAG
     IF EOM_DENOM == ONE
        CALL FORM_12HHP_DIAG
     ENDIF

     CALL FORM_INITIAL_GUESS 

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC

     ROOT_COUNT = ZERO
     ITER_COUNT = ZERO
     TRNC_COUNT = ZERO

     DO NROOTS

         ROOT_COUNT += ONE 
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
         MYROOT = ROOT_COUNT 
         CALL PREP_IP_GUESS 

         CALL KEEP_GUESS_VECS
      
         LOCK       = ZERO
         IF FRESH_SBSP != ONE
            IF ROOT_COUNT != ONE
               CALL ORTHO_NEW_ROOT
               E_OLD      = OMEGA
            ENDIF
         ENDIF

         IF FRESH_SBSP == ONE
            ITER_COUNT = ZERO
         ENDIF
         SBSP_COUNT = ZERO

         DO EOM_CYCLE

            CALL SET_TO_ZERO

            ITER_COUNT += ONE 
            SBSP_COUNT += ONE 

            CALL SET_EOM_INCLUDE
#bgn_debug
        execute print_scalar ITER_COUNT
        execute print_scalar SBSP_COUNT
#end_debug
            IF SBSP_COUNT > MAX_SUBSP_DIM 
               EXIT
            ENDIF 

            CALL SAVE_C_VECTORS 
#bgn_debug
#            call c_check 
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS 

            IF ITER_COUNT == 1.0
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
           IF ITER_COUNT != ONE
              CALL REORDER_A_EIGS
           ENDIF 
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal. 
#
           IF ITER_COUNT == ONE
              CALL FORM_NEWVECS_ITR1
           ELSE

              IF EXACT_HY == ONE
                 CALL FORM_NEWVECS 

                 IF MAX_OVLP == ONE
                    IF FIRST_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF

                 CALL FORM_SELECTED_Y
                 CALL FORM_HBAR_Y_VECS
              ELSE
                 CALL FORM_NEWVECS

                 IF MAX_OVLP == ONE
                    IF FIRST_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF

                 CALL FORM_SELECTED_Y
                 CALL FORM_NEW_HBAR_Y_VECS
                 CALL SELECT_HBAR_Y_VEC_TOGO
              ENDIF 

              CALL FORM_RESIDUAL_VEC
              CALL CHECK_CONVERGENCE

              IF ITER_COUNT > ONE
                   EDIFF = E_OLD - OMEGA
                ENDIF
                E_OLD = OMEGA
                EDIFF *=EDIFF
                EXECUTE SQUARE_ROOT EDIFF HALF
#bgn_debug
      execute print_scalar RESIDUAL_NORM
      execute print_scalar OMEGA
      execute print_scalar EDIFF
#end_debug
              IF LOCK == ZERO
              IF EDIFF < LOCK_THRES
                 LOCK = ONE
              ENDIF
              ENDIF 

              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ELSE 
                CALL FORM_CORRECTION_VEC
                CALL DRIVE_ORTHO
                CALL RESCALE_NEW_C  
              ENDIF 

# The subspace truncation. When the iteration count goes above
# 19 and still have not converged, then select 12 vectors closest
# to the eigenvalue of interest and start Davidson procedure
# from iteration 13 again.

              IF ITER_COUNT > NINETEEN

                 TRNC_COUNT += ONE
                 CALL TRUNCATE
                 ITER_COUNT  = TWL

              ENDIF

           ENDIF 

         ENDDO EOM_CYCLE 

         EXECUTE SERVER_BARRIER 
#bgn_debug
      execute print_scalar OMEGA 
#end_debug

         IF SBSP_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means

            DO KK1
            MCOUNT = ZERO
            DO MROOTS 
               MCOUNT += ONE
               IF MCOUNT == ROOT_COUNT
                  PSEUDO_ROOTS(MROOTS,KK1) = OMEGA
               ENDIF
            ENDDO MROOTS 
            ENDDO KK1

            IF FRESH_SBSP != ONE
              CALL SAVE_C_VECTORS
              OMEGA_KEEP= OMEGA
            ENDIF
            OMEGA = ZERO
     
            ENDIF 
         ENDIF 

         DO kk1
            MCOUNT = ZERO
            DO MROOTS
               MCOUNT += ONE
               IF MCOUNT == ROOT_COUNT
                  EOM_IPS(MROOTS) = OMEGA
                  IF OMEGA != ZERO
                     PSEUDO_ROOTS(MROOTS,KK1) = OMEGA
                  ENDIF
               ENDIF
            ENDDO MROOTS
         ENDDO kk1
             
         MCOUNT = ZERO
         DO MROOTS
            MCOUNT += ONE
            IF MCOUNT == ROOT_COUNT
               DO kk1
               DO i
                  GET R1a(i,kk1)
                  Tikk(i,kk1)  = R1a(i,kk1)
                  PUT R1a_VECS(i,kk1,MROOTS) =  Tikk(i,kk1)
               ENDDO i

               DO j
                  GET R1b(j,kk1)
                  Tjkk(j,kk1)  = R1b(j,kk1)
                  PUT R1b_VECS(j,kk1,MROOTS) =  Tjkk(j,kk1)
               ENDDO j
               ENDDO kk1

               PARDO i, i1, kk1, a
                   Get R2aa_a(a,i,kk1,i1)
                   Taiki(a,i,kk1,i1)  = R2aa_a(a,i,kk1,i1)
                   PREPARE R2aa_a_VECS(a,i,kk1,i1,MROOTS) = Taiki(a,i,kk1,i1)
               ENDPARDO i, i1, kk1, a

               PARDO j, j1, kk1, b
                   Get R2bb_b(b,j,kk1,j1)
                   Tbjkj(b,j,kk1,j1)  = R2bb_b(b,j,kk1,j1)
                   PREPARE R2bb_b_VECS(b,j,kk1,j1,MROOTS) = Tbjkj(b,j,kk1,j1)
               ENDPARDO j, j1, kk1, b

               PARDO a, i, kk1, j
                   Get R2aa_b(a,i,kk1,j)
                   Taikj(a,i,kk1,j)  =  R2aa_b(a,i,kk1,j)
                   PREPARE R2aa_b_VECS(a,i,kk1,j,MROOTS) = Taikj(a,i,kk1,j)
               ENDPARDO a, i, kk1, j

               PARDO j, i, kk1, b
                   Get R2bb_a(b,j,kk1,i)
                   Tbjki(b,j,kk1,i)  = R2bb_a(b,j,kk1,i)
                   PREPARE R2bb_a_VECS(b,j,kk1,i,MROOTS) = Tbjki(b,j,kk1,i)
               ENDPARDO j, i, kk1, b
               ENDIF 

            ENDDO MROOTS

            EXECUTE SERVER_BARRIER
            IF FRESH_SBSP != ONE
               OMEGA = OMEGA_KEEP
            ENDIF

      ENDDO NROOTS 

      EXECUTE SERVER_BARRIER 

      PRINT_FLAG = 60.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG EOM_IPS
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO WARNING DUMMY
#bgn_debug
      ROOT_COUNT -= 1.0
      execute print_static EOM_IPS ROOT_COUNT 
#end_debug

      execute server_barrier 
      execute blocks_to_list                VSpipi(p,i,p1,i1)
      execute blocks_to_list                Vaaii
      execute blocks_to_list                Viaai
      execute blocks_to_list                VSaaai
      execute blocks_to_list                VSqjqj(q,j,q1,j1)
      execute blocks_to_list                Vbbjj
      execute blocks_to_list                Vjbbj
      execute blocks_to_list                VSbbbj
      execute blocks_to_list                Vbbii
      execute blocks_to_list                Vjbii
      execute blocks_to_list                Vbbai
      execute blocks_to_list                Vpiqj(p,i,q,j)
      execute blocks_to_list                Vaajj
      execute blocks_to_list                Viabj
      execute blocks_to_list                Vaabj
#
      execute blocks_to_list                t1a
      execute blocks_to_list                t1b
      execute blocks_to_list                T2aa
      execute blocks_to_list                T2ab
      execute blocks_to_list                T2bb

      execute blocks_to_list                l1a
      execute blocks_to_list                l1b
      execute blocks_to_list                L2aa
      execute blocks_to_list                L2ab
      execute blocks_to_list                L2bb

      execute blocks_to_list                R1a_vecs
