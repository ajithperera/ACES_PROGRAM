#      pardo i,j1,b,kk1
#            get R2bb_a(b,j1,kk1,i)
#            tmp = R2bb_a(b,j1,kk1,i) * R2bb_a(b,j1,kk1,i)
#            tmpa+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug

     ENDPROC FORM_NEWVECS_ITR1
#    -------------------------

     PROC FORM_NEWVECS
#    ------------------
     PARDO i, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1A_HIST(i,kk1,MINDEX50)
                       Tixs(i,kk1,MINDEX50)  = R1A_HIST(i,kk1,MINDEX50)
                       T1ixs(i,kk1,NINDEX50) = Tixs(i,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A(i,kk1,NINDEX50) += T1ixs(i,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, kk1


     PARDO j, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET R1B_HIST(j,kk1,MINDEX50)
                       Tjxs(j,kk1,MINDEX50)  = R1B_HIST(j,kk1,MINDEX50)
                       T1jxs(j,kk1,NINDEX50) = Tjxs(j,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B(j,kk1,NINDEX50) += T1jxs(j,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  j, kk1


     PARDO i, i1, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                       Taikis(a,i,kk1,i1,MINDEX50) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)
                       T1aikis(a,i,kk1,i1,NINDEX50) = Taikis(a,i,kk1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa_a(a,i,kk1,i1,NINDEX50) += T1aikis(a,i,kk1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                       Tbjkjs(b,j,kk1,j1,MINDEX50) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                       T1bjkjs(b,j,kk1,j1,NINDEX50) = Tbjkjs(b,j,kk1,j1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_b(b,j,kk1,j1,NINDEX50) += T1bjkjs(b,j,kk1,j1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF 

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50) j

                       Taikjs(a,i,kk1,j,MINDEX50) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                       T1aikjs(a,i,kk1,j,NINDEX50) = Taikjs(a,i,kk1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2aa_b(a,i,kk1,j,NINDEX50) += T1aikjs(a,i,kk1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50) i

                       Tbjkis(b,j,kk1,i,MINDEX50) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
                       T1bjkis(b,j,kk1,i,NINDEX50) = Tbjkis(b,j,kk1,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_a(b,j,kk1,i,NINDEX50) += T1bjkis(b,j,kk1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, i, kk1, b
  
     EXECUTE SERVER_BARRIER 
#bgn_debug
#      mcount=0.0
#      do mindex50
#      mcount += 1.0
#      if mcount > iter_count 
#         exit
#      endif 
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
