#            Taiki(a,i,kk1,i1) =  hR2aa_a_hist(a,i,kk1,i1,nindex50)
#            tmp = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1) 
#            tmpa += tmp
#      endpardo a,i1,kk1,i
#      endif 
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      ncount = 0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo b,j,j1, kk1
#            request  hR2bb_b_hist(b,j,kk1,j1,nindex50) j
#            Tbjkj(b,j,kk1,j1) = hR2bb_b_hist(b,j,kk1,j1,nindex50)
#            tmp = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1) 
#            tmpa+= tmp
#      endpardo b,j,j1, kk1
#      endif 
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50 
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50 
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT 

                    PARDO i, kk1

                          GET HR1A_HIST(i,kk1,NINDEX50)
                          GET R1A_HIST(i,kk1,MINDEX50) 

                          Tikk(i,kk1)   = HR1A_HIST(i,kk1,NINDEX50)
                          T1ikk(i,kk1)  = R1A_HIST(i,kk1,MINDEX50)

                          TMP   = Tikk(i,kk1) *  T1ikk(i,kk1) 
                          SUMA += TMP

                    ENDPARDO i, kk1

                    PARDO j, kk1

                          GET HR1B_HIST(j,kk1,NINDEX50)
                          GET R1B_HIST(j,kk1,MINDEX50)

                          Tjkk(j,kk1)   = HR1B_HIST(j,kk1,NINDEX50)
                          T1jkk(j,kk1)  = R1B_HIST(j,kk1,MINDEX50)

                          TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                          SUMB += TMP

                    ENDPARDO j, kk1

                    EXECUTE SERVER_BARRIER 
                    COLLECTIVE HC_A += SUMA
                    COLLECTIVE HC_B += SUMB

                 ENDIF

              ENDDO MINDEX50 
           ENDIF

        ENDDO NINDEX50

      ENDIF 
#
# In iteration one there are no contributions from R1AAA, R1BBB.. since
# those are zero at the start. Note that HR1AAA are non-zero but the 
# overlap is still zero.
         
     A_VALUE  = HC_A
     A_VALUE += HC_B
#bgn_debug
#     execute print_scalar A_value 
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50 
               MCOUNT += 1.0
               IF MCOUNT == 1.0
  
                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF 
             ENDDO MINDEX50
         ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC FORM_A_MATRIX_11
#    -------------------------

     PROC FORM_A_MATRIX_IJ
#    ----------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO i, kk1

                            GET HR1A_HIST(i,kk1,NINDEX50)
                            GET R1A_HIST(i,kk1,MINDEX50)

                            Tikk(i,kk1)   = HR1A_HIST(i,kk1,NINDEX50)
                            T1ikk(i,kk1)  = R1A_HIST(i,kk1,MINDEX50)

                            TMP   = Tikk(i,kk1) *  T1ikk(i,kk1)
                            SUMA += TMP

                     ENDPARDO i, kk1

                     EXECUTE SERVER_BARRIER

                     PARDO j, kk1

                           GET HR1B_HIST(j,kk1,NINDEX50)
                           GET R1B_HIST(j,kk1,MINDEX50)

                           Tjkk(j,kk1)  = HR1B_HIST(j,kk1,NINDEX50)
                           T1jkk(j,kk1) = R1B_HIST(j,kk1,MINDEX50)

                            TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                            SUMB += TMP

                     ENDPARDO j, kk1


                     PARDO i, i1, kk1, a

                           REQUEST HR2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                           REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                           Taiki(a,i,kk1,i1)  = HR2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                           T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)

                           TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 
                           SUMAAA += TMP
                
                     ENDPARDO i, i1, kk1, a

                     PARDO j, j1, kk1, b
                           REQUEST HR2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                           Tbjkj(b,j,kk1,j1)  = HR2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                           T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                        
                           TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)
                           SUMBBB += TMP

                     ENDPARDO j, j1, kk1, b

                     PARDO a, i, kk1, j
                           REQUEST HR2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50)  j
            
                           Taikj(a,i,kk1,j)  = HR2aa_b_HIST(a,i,kk1,j,NINDEX50)
                           T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                              
                           TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)
                           SUMAAB += TMP
    
                     ENDPARDO a, i, kk1, j

                     PARDO j, i, kk1, b
                           REQUEST HR2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                           REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50)  i
                
                           Tbjki(b,j,kk1,i)  = HR2bb_a_HIST(b,j,kk1,i,NINDEX50)
                           T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
        
                           TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)
                           SUMBBA += TMP
    
                     ENDPARDO j, i, kk1, b
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A += SUMA
                     COLLECTIVE HC_B += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------

     PROC FORM_A_MATRIX_JI
#    ----------------------

# Built A_jk where k=1, ..j-1, <(HC_k)_j | C_k>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT >= NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO i, kk1

                            GET HR1A_HIST(i,kk1,MINDEX50)
                            GET R1A_HIST(i,kk1,NINDEX50)

                            Tikk(i,kk1)   = HR1A_HIST(i,kk1,MINDEX50)
                            T1ikk(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)

                            TMP   = Tikk(i,kk1) *  T1ikk(i,kk1)
                            SUMA += TMP

                     ENDPARDO i, kk1

                     PARDO j, kk1

                           GET HR1B_HIST(j,kk1,MINDEX50)
                           GET R1B_HIST(j,kk1,NINDEX50)

                           Tjkk(j,kk1)  = HR1B_HIST(j,kk1,MINDEX50)
                           T1jkk(j,kk1) = R1B_HIST(j,kk1,NINDEX50)

                            TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                            SUMB += TMP

                     ENDPARDO j, kk1

                     PARDO i, i1, kk1, a

                           REQUEST HR2aa_a_HIST(a,i,kk1,i1,MINDEX50) i1
                           REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50)  i1

                           Taiki(a,i,kk1,i1)  = HR2aa_a_HIST(a,i,kk1,i1,MINDEX50)
                           T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)

                           TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 
                           SUMAAA += TMP
                
                     ENDPARDO i, i1, kk1, a

                     PARDO j, j1, kk1, b
                           REQUEST HR2bb_b_HIST(b,j,kk1,j1,MINDEX50) j1
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50)  j1

                           Tbjkj(b,j,kk1,j1)  = HR2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                           T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                        
                           TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)
                           SUMBBB += TMP

                     ENDPARDO j, j1, kk1, b

                     PARDO a, i, kk1, j
                           REQUEST HR2aa_b_HIST(a,i,kk1,j,MINDEX50) j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50)  j
            
                           Taikj(a,i,kk1,j)  = HR2aa_b_HIST(a,i,kk1,j,MINDEX50)
                           T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
                              
                           TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)
                           SUMAAB += TMP
    
                     ENDPARDO a, i, kk1, j

                     PARDO j, i, kk1, b
                           REQUEST HR2bb_a_HIST(b,j,kk1,i,MINDEX50) i
                           REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50)  i
                
                           Tbjki(b,j,kk1,i)  = HR2bb_a_HIST(b,j,kk1,i,MINDEX50)
                           T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
        
                           TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)
                           SUMBBA += TMP
    
                     ENDPARDO j, i, kk1, b
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA
                     EXECUTE SIP_BARRIER 
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------

     PROC  FORM_A_MATRIX_II
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0
     HC_AAB = 0.0
     HC_BBA = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0
                 IF NCOUNT == MCOUNT

                    PARDO i, kk1

                           GET HR1A_HIST(i,kk1,NINDEX50)
                           GET R1A_HIST(i,kk1,MINDEX50)

                           Tikk(i,kk1)  = HR1A_HIST(i,kk1,NINDEX50)
                           T1ikk(i,kk1) = R1A_HIST(i,kk1,MINDEX50)

                            TMP   = Tikk(i,kk1) *  T1ikk(i,kk1)
                            SUMA += TMP

                   ENDPARDO i, kk1

                   PARDO j, kk1
  
                         GET HR1B_HIST(j,kk1,NINDEX50)
                         GET R1B_HIST(j,kk1,MINDEX50)
      
                         Tjkk(j,kk1)  = HR1B_HIST(j,kk1,NINDEX50)
                         T1jkk(j,kk1) = R1B_HIST(j,kk1,MINDEX50)
      
                         TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                         SUMB += TMP
    
                   ENDPARDO j, kk1
      
                   PARDO i, i1, kk1, a
   
                         REQUEST HR2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                         REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50) i1
      
                         Taiki(a,i,kk1,i1)  = HR2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                         T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)
      
                         TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 
                         SUMAAA += TMP
                         
                   ENDPARDO i, i1, kk1, a
      
                   PARDO j, j1, kk1, b
                         REQUEST HR2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                         REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50) j1
      
                         Tbjkj(b,j,kk1,j1)  = HR2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                         T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                           
                         TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)
                         SUMBBB += TMP
      
                   ENDPARDO j, j1, kk1, b
      
                   PARDO a, i, kk1, j
                         REQUEST HR2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                         REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50) j
      
                         Taikj(a,i,kk1,j)  = HR2aa_b_HIST(a,i,kk1,j,NINDEX50)
                         T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                              
                         TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)
                         SUMAAB += TMP
    
                   ENDPARDO a, i, kk1, j
      
                   PARDO j, i, kk1, b
                         REQUEST HR2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                         REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50) i
      
                         Tbjki(b,j,kk1,i)  = HR2bb_a_HIST(b,j,kk1,i,NINDEX50)
                         T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
      
                         TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)
                         SUMBBA += TMP
      
                   ENDPARDO j, i, kk1, b
      
                   EXECUTE SERVER_BARRIER
                   COLLECTIVE HC_A   += SUMA
                   COLLECTIVE HC_B   += SUMB
                   COLLECTIVE HC_AAA += SUMAAA
                   COLLECTIVE HC_BBB += SUMBBB
                   COLLECTIVE HC_AAB += SUMAAB
                   COLLECTIVE HC_BBA += SUMBBA 

                   A_VALUE  = HC_A
                   A_VALUE += HC_B
                   A_VALUE += HC_AAA
                   A_VALUE += HC_BBB
                   A_VALUE += HC_AAB
                   A_VALUE += HC_BBA
                   EXECUTE SIP_BARRIER 

                   KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50
                ENDIF 
              ENDDO NINDEX50 
       ENDIF 

     ENDDO MINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_II
#    -------------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE 
     OMEGA0M  = A_VALUE 
     OMEGA0M *= -1.0
     E_OLD    = OMEGA0
#bgn_debug
     execute print_scalar OMEGA0M
#end_debug

# First the residual vector for iteration 1
     
     PARDO i, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1A_HIST(i,kk1,NINDEX50)
              GET R1A_HIST(i,kk1,NINDEX50)

              Tix(i,kk1)   = HR1A_HIST(i,kk1,NINDEX50)
              T1ix(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
              T1ix(i,kk1) *= OMEGA0M
              Tix(i,kk1)  += T1ix(i,kk1)
 
              PUT RES1a(i,kk1) = Tix(i,kk1)

           ENDDO NINDEX50
     ENDPARDO i, kk1

     PARDO j, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1B_HIST(j,kk1,NINDEX50)
              GET R1B_HIST(j,kk1,NINDEX50)

              Tjx(j,kk1)   = HR1B_HIST(j,kk1,NINDEX50)
              T1jx(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
              T1jx(j,kk1) *= OMEGA0M
              Tjx(j,kk1)  += T1jx(j,kk1)

              PUT RES1b(j,kk1) = Tjx(j,kk1)

           ENDDO NINDEX50
     ENDPARDO  j, kk1

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO i, i1, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2aa_a_HIST(a,i,kk1,i1,NINDEX50)  i1

              Taiki(a,i,kk1,i1)  = HR2aa_a_HIST(a,i,kk1,i1,NINDEX50)
              PUT RES2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

           ENDDO NINDEX50
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2bb_b_HIST(b,j,kk1,j1,NINDEX50)  j1

              Tbjkj(b,j,kk1,j1)  = HR2bb_b_HIST(b,j,kk1,j1,NINDEX50)
              PUT RES2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)

           ENDDO NINDEX50
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2aa_b_HIST(a,i,kk1,j,NINDEX50) j

              Taikj(a,i,kk1,j)  = HR2aa_b_HIST(a,i,kk1,j,NINDEX50)
              PUT RES2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)

           ENDDO NINDEX50
     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST HR2bb_a_HIST(b,j,kk1,i,NINDEX50) i

              Tbjki(b,j,kk1,i)  = HR2bb_a_HIST(b,j,kk1,i,NINDEX50)
              PUT RES2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)

           ENDDO NINDEX50
     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER 

# Now the correction vector for iteration 1

     DO kk1
        DO i
           GET RES1a(i,kk1)
           GET Ri(i,kk1)

           Tikk(i,kk1)   = Ri(i,kk1)
           T1ikk(i,kk1)  = RES1a(i,kk1)

           Tikk(i,kk1)  *= -1.0
           T2ikk(i,kk1)  = OMEGA0
           Tikk(i,kk1)  += T2ikk(i,kk1)

           EXECUTE APPLY_DEN2_NOR  T1ikk Tikk

           PUT CORR_VECa(i,kk1) =  T1ikk(i,kk1)

         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET RES1b(j,kk1)
            GET Rj(j,kk1)

            Tjkk(j,kk1)   = Rj(j,kk1)
            T1jkk(j,kk1)  = RES1b(j,kk1)

            Tjkk(j,kk1)  *= -1.0
            T2jkk(j,kk1)  = OMEGA0
            Tjkk(j,kk1)  += T2jkk(j,kk1)

            EXECUTE APPLY_DEN2_NOR  T1jkk Tjkk

            PUT CORR_VECb(j,kk1) =  T1jkk(j,kk1)

         ENDDO j
     ENDDO kk1

    PARDO i, i1, kk1, a
         GET RES2aa_a(a,i,kk1,i1)
         GET Raixi(a,i,kk1,i1)

         Taiki(a,i,kk1,i1)  = Raixi(a,i,kk1,i1)
         T1aiki(a,i,kk1,i1) = RES2aa_a(a,i,kk1,i1)

         Taiki(a,i,kk1,i1) *= -1.0
         T2aiki(a,i,kk1,i1) = OMEGA0
         Taiki(a,i,kk1,i1)  += T2aiki(a,i,kk1,i1)

         EXECUTE APPLY_DEN4 T1aiki Taiki
             
         PUT CORR_VECaa_a(a,i,kk1,i1) = T1aiki(a,i,kk1,i1)

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b
         GET RES2bb_b(b,j,kk1,j1)
         GET Rbjxj(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  = Rbjxj(b,j,kk1,j1)
         T1bjkj(b,j,kk1,j1) = RES2bb_b(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  *= -1.0
         T2bjkj(b,j,kk1,j1)  = OMEGA0
         Tbjkj(b,j,kk1,j1)  += T2bjkj(b,j,kk1,j1)

         EXECUTE APPLY_DEN4 T1bjkj Tbjkj

         PUT CORR_VECbb_b(b,j,kk1,j1) = T1bjkj(b,j,kk1,j1)

     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j
        GET RES2aa_b(a,i,kk1,j)
        GET Raixj(a,i,kk1,j)

        Taikj(a,i,kk1,j)   = Raixj(a,i,kk1,j)
        T1aikj(a,i,kk1,j)  = RES2aa_b(a,i,kk1,j)

        Taikj(a,i,kk1,j)  *= -1.0
        T2aikj(a,i,kk1,j)  = OMEGA0
        Taikj(a,i,kk1,j) += T2aikj(a,i,kk1,j)

        EXECUTE APPLY_DEN4 T1aikj Taikj

        PUT CORR_VECaa_b(a,i,kk1,j) = T1aikj(a,i,kk1,j)

     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
        GET RES2bb_a(b,j,kk1,i)
        GET Rbjxi(b,j,kk1,i)

        Tbjki(b,j,kk1,i)   = Rbjxi(b,j,kk1,i)
        T1bjki(b,j,kk1,i)  = RES2bb_a(b,j,kk1,i)

        Tbjki(b,j,kk1,i)  *= -1.0
        T2bjki(b,j,kk1,i)  = OMEGA0
        Tbjki(b,j,kk1,i)  += T2bjki(b,j,kk1,i)

        EXECUTE APPLY_DEN4 T1bjki Tbjki

        PUT CORR_VECbb_a(b,j,kk1,i) = T1bjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

     PARDO i, kk1
           GET CORR_VECa(i,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1A_HIST(i,kk1,NINDEX50)

              Tix(i,kk1)   = CORR_VECa(i,kk1) 
              T1ix(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
              TMP   = Tix(i,kk1) * T1ix(i,kk1) 
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO i, kk1

     PARDO j, kk1

           GET CORR_VECb(j,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1B_HIST(j,kk1,NINDEX50)

              Tjx(j,kk1)   = CORR_VECb(j,kk1)
              T1jx(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
              TMP  = Tjx(j,kk1) * T1jx(j,kk1)  
              SUMB += TMP

           ENDDO NINDEX50
     ENDPARDO  j, kk1

     EXECUTE SIP_BARRIER
     COLLECTIVE  HC_A += SUMA
     COLLECTIVE  HC_B += SUMB
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
     NORM_GHG += HC_B
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO i, kk1

           GET CORR_VECa(i,kk1)
           Tix(i,kk1) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1A_HIST(i,kk1,NINDEX50)

              Tix(i,kk1)   = CORR_VECa(i,kk1) 
              T1ix(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
              T1ix(i,kk1) *= NORM_GHG
              T1ix(i,kk1) *= -1.0
              Tix(i,kk1)  += T1ix(i,kk1)

           ENDDO NINDEX50

          PUT R1a_intmd(i,kk1) = Tix(i,kk1)
     ENDPARDO i, kk1

     PARDO j, kk1

           GET CORR_VECb(j,kk1)
           Tjx(j,kk1) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1B_HIST(j,kk1,NINDEX50)

              Tjx(j,kk1)   = CORR_VECb(j,kk1) 
              T1jx(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
              T1jx(j,kk1) *= NORM_GHG
              T1jx(j,kk1) *= -1.0
              Tjx(j,kk1)  += T1jx(j,kk1)

           ENDDO NINDEX50

           PUT R1b_intmd(j,kk1) = Tjx(j,kk1)
     ENDPARDO  j, kk1

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO i, i1, kk1, a

           GET CORR_VECaa_a(a,i,kk1,i1) 

           Taiki(a,i,kk1,i1)  = CORR_VECaa_a(a,i,kk1,i1)
           PUT R2aa_a_intmd(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           GET CORR_VECbb_b(b,j,kk1,j1)

           Tbjkj(b,j,kk1,j1)  = CORR_VECbb_b(b,j,kk1,j1)
           PUT R2bb_b_intmd(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)

     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           GET CORR_VECaa_b(a,i,kk1,j)

           Taikj(a,i,kk1,j)  = CORR_VECaa_b(a,i,kk1,j)
           PUT R2aa_b_intmd(a,i,kk1,j) = Taikj(a,i,kk1,j)

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           GET CORR_VECbb_a(b,j,kk1,i)

           Tbjki(b,j,kk1,i)  = CORR_VECbb_a(b,j,kk1,i)
           PUT R2bb_a_intmd(b,j,kk1,i) = Tbjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER 

# Final normalization 

     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0
     TMPA    = 0.0
     TMPB    = 0.0

     PARDO i, kk1

            GET  R1a_intmd(i,kk1)
            Tikk(i,kk1) = R1a_intmd(i,kk1)
            TMP   = Tikk(i,kk1) * Tikk(i,kk1)
            HC_A += TMP

      ENDPARDO i, kk1

      PARDO j, kk1

            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1) =  R1b_intmd(j,kk1)
            TMP   = Tjkk(j,kk1) * Tjkk(j,kk1)
            HC_B += TMP

      ENDPARDO j, kk1

      PARDO i, i1, kk1, a

              GET R2aa_a_intmd(a,i,kk1,i1) 
              Taiki(a,i,kk1,i1) = R2aa_a_intmd(a,i,kk1,i1)

              TMP   = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1)
              HC_AAA += TMP

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b

              GET R2bb_b_intmd(b,j,kk1,j1)
              Tbjkj(b,j,kk1,j1) = R2bb_b_intmd(b,j,kk1,j1)

              TMP   = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
              HC_BBB +=  TMP
              
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

              GET R2aa_b_intmd(a,i,kk1,j) 
              Taikj(a,i,kk1,j) = R2aa_b_intmd(a,i,kk1,j)

              TMP   = Taikj(a,i,kk1,j) * Taikj(a,i,kk1,j)
              HC_AAB +=  TMP

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

              GET R2bb_a_intmd(b,j,kk1,i) 
              Tbjki(b,j,kk1,i) = R2bb_a_intmd(b,j,kk1,i)  

              TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i) 
              HC_BBA +=  TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA


     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXECUTE SIP_BARRIER 

     PARDO i, kk1

            GET  R1a_intmd(i,kk1)
            Tikk(i,kk1) = R1a_intmd(i,kk1)
            Tikk(i,kk1) *= INV_SQRT_NORM_R
            PUT R1a(i,kk1) = Tikk(i,kk1) 

      ENDPARDO i, kk1

      PARDO j, kk1

            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1)  =  R1b_intmd(j,kk1)
            Tjkk(j,kk1) *=  INV_SQRT_NORM_R
            PUT  R1b(j,kk1) = Tjkk(j,kk1)

      ENDPARDO j, kk1
   
      EXECUTE SIP_BARRIER 

      PARDO i, i1, kk1, a

              GET R2aa_a_intmd(a,i,kk1,i1) 
              Taiki(a,i,kk1,i1)  = R2aa_a_intmd(a,i,kk1,i1)
              Taiki(a,i,kk1,i1) *= INV_SQRT_NORM_R
              PUT R2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1) 
      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b

              GET R2bb_b_intmd(b,j,kk1,j1)
              Tbjkj(b,j,kk1,j1)  = R2bb_b_intmd(b,j,kk1,j1)
              Tbjkj(b,j,kk1,j1) *= INV_SQRT_NORM_R
              PUT R2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)
              
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

              GET R2aa_b_intmd(a,i,kk1,j) 
              Taikj(a,i,kk1,j)  = R2aa_b_intmd(a,i,kk1,j)
              Taikj(a,i,kk1,j) *= INV_SQRT_NORM_R
              PUT R2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

              GET R2bb_a_intmd(b,j,kk1,i) 
              Tbjki(b,j,kk1,i)  = R2bb_a_intmd(b,j,kk1,i)  
              Tbjki(b,j,kk1,i) *= INV_SQRT_NORM_R
              PUT R2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER
#
#bgn_debug
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,kk1
#         get r1a(i,kk1)
