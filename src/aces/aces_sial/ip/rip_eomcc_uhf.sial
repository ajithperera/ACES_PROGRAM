                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  j, kk1

     PARDO i, i1, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                       Taikis(a,i,kk1,i1,MINDEX50) = HR2aa_a_HIST(a,i,kk1,i1,MINDEX50)
                       T1aikis(a,i,kk1,i1,NINDEX50) = Taikis(a,i,kk1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50) += T1aikis(a,i,kk1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, kk1, a
     PARDO j, j1, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                       Tbjkjs(b,j,kk1,j1,MINDEX50) = HR2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                       T1bjkjs(b,j,kk1,j1,NINDEX50) = Tbjkjs(b,j,kk1,j1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50) += T1bjkjs(b,j,kk1,j1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2aa_b_HIST(a,i,kk1,j,MINDEX50) j

                       Taikjs(a,i,kk1,j,MINDEX50) = HR2aa_b_HIST(a,i,kk1,j,MINDEX50)
                       T1aikjs(a,i,kk1,j,NINDEX50) = Taikjs(a,i,kk1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50) += T1aikjs(a,i,kk1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
