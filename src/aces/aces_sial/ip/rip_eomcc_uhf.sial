      ENDPROC HR_MULT
#     ---------------

      PROC SAVE_C_VECTORS 
#     ------------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0
         
         IF NCOUNT == ITER_COUNT

            DO kk1
               DO i
                  GET R1A(i,kk1) 
                  Tikk(i,kk1) = R1A(i,kk1)
                  PUT R1A_HIST(i,Kk1,NINDEX50) = Tikk(i,kk1) 
               ENDDO i
            ENDDO kk1

            DO kk1
               DO j
                  GET R1B(j,kk1) 
                  Tjkk(j,kk1) = R1B(j,kk1)
                  PUT R1B_HIST(j,Kk1,NINDEX50) = Tjkk(j,kk1) 
               ENDDO j
            ENDDO kk1
        ENDIF 

      ENDDO NINDEX50 

      PARDO i, i1, kk1, a
            GET R2aa_a(a,i,kk1,i1) 
            Taiki(a,i,kk1,i1) =  R2aa_a(a,i,kk1,i1)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE R2aa_a_HIST(a,i,kk1,i1,NINDEX50) = Taiki(a,i,kk1,i1)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b
            GET R2bb_b(b,j,kk1,j1) 
            Tbjkj(b,j,kk1,j1) = R2bb_b(b,j,kk1,j1)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE R2bb_b_HIST(b,j,kk1,j1,NINDEX50) = Tbjkj(b,j,kk1,j1)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO j, j1, kk1, b

      PARDO a, i, kk1, j
            GET R2aa_b(a,i,kk1,j)
            Taikj(a,i,kk1,j) = R2aa_b(a,i,kk1,j) 

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE R2aa_b_HIST(a,i,kk1,j,NINDEX50) = Taikj(a,i,kk1,j)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO a, i, kk1, j

      PARDO j, i, kk1, b
            GET R2bb_a(b,j,kk1,i)
            Tbjki(b,j,kk1,i) = R2bb_a(b,j,kk1,i)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE R2bb_a_HIST(b,j,kk1,i,NINDEX50) = Tbjki(b,j,kk1,i)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO j, i, kk1, b

      EXECUTE SERVER_BARRIER 

      ENDPROC SAVE_C_VECTORS 
#     ---------------------

      PROC SAVE_HC_VECTORS
#     --------------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0
         
         IF NCOUNT == ITER_COUNT

            DO kk1
               DO i
                  GET HR1A(i,kk1) 
                  Tikk(i,kk1) = HR1A(i,kk1)
                  PUT HR1A_HIST(i,Kk1,NINDEX50) = Tikk(i,kk1) 
               ENDDO i
            ENDDO kk1

            DO kk1
               DO j
                  GET HR1B(j,kk1) 
                  Tjkk(j,kk1) = HR1B(j,kk1)
                  PUT HR1B_HIST(j,Kk1,NINDEX50) = Tjkk(j,kk1) 
               ENDDO j
            ENDDO kk1
        ENDIF 

      ENDDO NINDEX50 

      PARDO i, i1, kk1, a
            GET HR2aa_a(a,i,kk1,i1) 
            Taiki(a,i,kk1,i1) =  HR2aa_a(a,i,kk1,i1)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE HR2aa_a_HIST(a,i,kk1,i1,NINDEX50) = Taiki(a,i,kk1,i1)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b
            GET HR2bb_b(b,j,kk1,j1) 
            Tbjkj(b,j,kk1,j1) = HR2bb_b(b,j,kk1,j1)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE HR2bb_b_HIST(b,j,kk1,j1,NINDEX50) = Tbjkj(b,j,kk1,j1)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO j, j1, kk1, b

      PARDO a, i, kk1, j
            GET HR2aa_b(a,i,kk1,j)
            Taikj(a,i,kk1,j) = HR2aa_b(a,i,kk1,j) 

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE HR2aa_b_HIST(a,i,kk1,j,NINDEX50) = Taikj(a,i,kk1,j)
               ENDIF 
            ENDDO NINDEX50

      ENDPARDO a, i, kk1, j

      PARDO j, i, kk1, b
            GET HR2bb_a(b,j,kk1,i)
            Tbjki(b,j,kk1,i) = HR2bb_a(b,j,kk1,i)

            NCOUNT = 0.0
            DO NINDEX50
               NCOUNT += 1.0
               IF NCOUNT == ITER_COUNT 
                  PREPARE HR2bb_a_HIST(b,j,kk1,i,NINDEX50) = Tbjki(b,j,kk1,i)
               ENDIF 
            ENDDO NINDEX50
      ENDPARDO j, i, kk1, b

      EXECUTE SERVER_BARRIER

     ENDPROC SAVE_HC_VECTORS
