     ENDPROC FORM_CORRECTION_VEC
#     ---------------------------

     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF  

           PARDO i, kk1

                 GET R1A_HIST(i,kk1,NINDEX50)
                 GET CORR_VECa(i,kk1)
                 
                 Tikk(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
                 T1ikk(i,kk1) = CORR_VECa(i,kk1)
                 TMP          = Tikk(i,kk1) *  T1ikk(i,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 
                 
           ENDPARDO i, kk1

           PARDO j, kk1

                 GET R1B_HIST(j,kk1,NINDEX50)
                 GET CORR_VECb(j,kk1)

                 Tjkk(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
                 T1jkk(j,kk1) = CORR_VECb(j,kk1)
                 TMP          = Tjkk(j,kk1) *  T1jkk(j,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, kk1

           PARDO i, i1, kk1, a

                 REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                 GET CORR_VECaa_a(a,i,kk1,i1)

                 Taiki(a,i,kk1,i1)  = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                 T1aiki(a,i,kk1,i1) = CORR_VECaa_a(a,i,kk1,i1)

                 TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, i1, kk1, a

           PARDO j, j1, kk1, b

                 REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                 GET CORR_VECbb_b(b,j,kk1,j1)

                 Tbjkj(b,j,kk1,j1)  = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                 T1bjkj(b,j,kk1,j1) = CORR_VECbb_b(b,j,kk1,j1)
                        
                 TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, j1, kk1, b

           PARDO i, a, kk1, j

                 REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                 GET CORR_VECaa_b(a,i,kk1,j)

                 Taikj(a,i,kk1,j)  = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
                 T1aikj(a,i,kk1,j) = CORR_VECaa_b(a,i,kk1,j)
                        
                 TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, a, kk1, j

           PARDO j, i, kk1, b

                 REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                 GET CORR_VECbb_a(b,j,kk1,i)

                 Tbjki(b,j,kk1,i)  = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
                 T1bjki(b,j,kk1,i) = CORR_VECbb_a(b,j,kk1,i)

                 TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, i, kk1, b

#        ENDIF 
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT 
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     C_A    = 0.0
     C_B    = 0.0
     C_AAA  = 0.0
     C_BBB  = 0.0
     C_AAB  = 0.0
     C_BBA  = 0.0

     PARDO i, kk1
           GET CORR_VECa(i,kk1)
           Tikk(i,kk1)   = CORR_VECa(i,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
   
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET R1A_HIST(i,kk1,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ikk(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ikk(i,kk1) *= FACT
              T1ikk(i,kk1) *= -1.0
              Tikk(i,kk1)  += T1ikk(i,kk1)

           ENDDO NINDEX50

           PUT R1a_INTMD(i,kk1) = Tikk(i,kk1)

           TMP    = Tikk(i,kk1) * Tikk(i,kk1)
           SUMA  += TMP
                 
     ENDPARDO i, kk1

     PARDO j, kk1
          GET CORR_VECb(j,kk1)
          Tjkk(j,kk1)  = CORR_VECb(j,kk1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             GET R1B_HIST(j,kk1,NINDEX50)
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1jkk(j,kk1) = R1B_HIST(j,kk1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1jkk(j,kk1) *= FACT
             T1jkk(j,kk1) *= -1.0
             Tjkk(j,kk1)  += T1jkk(j,kk1) 

          ENDDO NINDEX50
                     
          PUT R1b_INTMD(j,kk1) = Tjkk(j,kk1)
                 
          TMP   = Tjkk(j,kk1) * Tjkk(j,kk1) 
          SUMB += TMP

     ENDPARDO j, kk1

     PARDO i, i1, kk1, a
          GET CORR_VECaa_a(a,i,kk1,i1)
          Taiki(a,i,kk1,i1)  = CORR_VECaa_a(a,i,kk1,i1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                 
             EXECUTE RETURN_SVAL Txx FACT

             T1aiki(a,i,kk1,i1)  *= FACT
             T1aiki(a,i,kk1,i1)  *= -1.0
             Taiki(a,i,kk1,i1)   += T1aiki(a,i,kk1,i1)

           ENDDO NINDEX50

           PUT R2aa_a_intmd(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

           TMP  =  Taiki(a,i,kk1,i1) *  Taiki(a,i,kk1,i1)
           SUMAAA  += TMP

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           GET CORR_VECbb_b(b,j,kk1,j1)
           Tbjkj(b,j,kk1,j1)  = CORR_VECbb_b(b,j,kk1,j1)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT
                 
             T1bjkj(b,j,kk1,j1) *= FACT
             T1bjkj(b,j,kk1,j1) *= -1.0
             Tbjkj(b,j,kk1,j1) += T1bjkj(b,j,kk1,j1)

           ENDDO NINDEX50
                
          PUT R2bb_b_intmd(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)

          TMP = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
          SUMBBB += TMP
                 
     ENDPARDO j, j1, kk1, b

     PARDO i, a, kk1, j
           GET CORR_VECaa_b(a,i,kk1,j)
           Taikj(a,i,kk1,j)  = CORR_VECaa_b(a,i,kk1,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                
              EXECUTE RETURN_SVAL Txx FACT
                       
              T1aikj(a,i,kk1,j) *= FACT
              T1aikj(a,i,kk1,j) *= -1.0
              Taikj(a,i,kk1,j)  += T1aikj(a,i,kk1,j)

          ENDDO NINDEX50

          PUT R2aa_b_intmd(a,i,kk1,j) = Taikj(a,i,kk1,j)

          TMP =  Taikj(a,i,kk1,j) *  Taikj(a,i,kk1,j)
          SUMAAB += TMP

     ENDPARDO i, a, kk1, j

     PARDO j, i, kk1, b
           GET CORR_VECbb_a(b,j,kk1,i)
           Tbjki(b,j,kk1,i)  = CORR_VECbb_a(b,j,kk1,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
  
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT

             T1bjki(b,j,kk1,i) *= FACT
             T1bjki(b,j,kk1,i) *= -1.0
             Tbjki(b,j,kk1,i)  += T1bjki(b,j,kk1,i)

          ENDDO NINDEX50

          PUT R2bb_a_intmd(b,j,kk1,i) = Tbjki(b,j,kk1,i)

          TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i)
          SUMBBA += TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER 
     COLLECTIVE   C_A   += SUMA 
     COLLECTIVE   C_B   += SUMB
     COLLECTIVE   C_AAA += SUMAAA
     COLLECTIVE   C_BBB += SUMBBB
     COLLECTIVE   C_AAB += SUMAAB
     COLLECTIVE   C_BBA += SUMBBA

     EXECUTE SIP_BARRIER 

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_B
     NORM_NEW_ORTGC += C_AAA
     NORM_NEW_ORTGC += C_BBB
     NORM_NEW_ORTGC += C_AAB
     NORM_NEW_ORTGC += C_BBA

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------
    
     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT 

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0

     PARDO i, kk1

            GET  R1a_intmd(i,kk1)
            Tikk(i,kk1) = R1a_intmd(i,kk1)
            TMP   = Tikk(i,kk1) * Tikk(i,kk1)
            HC_A += TMP

      ENDPARDO i, kk1

      PARDO j, kk1

            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1) =  R1b_intmd(j,kk1)
            TMP   = Tjkk(j,kk1) * Tjkk(j,kk1)
            HC_B += TMP

      ENDPARDO j, kk1

      PARDO i, i1, kk1, a

              GET R2aa_a_intmd(a,i,kk1,i1) 
              Taiki(a,i,kk1,i1) = R2aa_a_intmd(a,i,kk1,i1)

              TMP   = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1)
              HC_AAA += TMP

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b

              GET R2bb_b_intmd(b,j,kk1,j1)
              Tbjkj(b,j,kk1,j1) = R2bb_b_intmd(b,j,kk1,j1)

              TMP   = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
              HC_BBB +=  TMP
              
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

              GET R2aa_b_intmd(a,i,kk1,j) 
              Taikj(a,i,kk1,j) = R2aa_b_intmd(a,i,kk1,j)

              TMP   = Taikj(a,i,kk1,j) * Taikj(a,i,kk1,j)
              HC_AAB +=  TMP

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

              GET R2bb_a_intmd(b,j,kk1,i) 
              Tbjki(b,j,kk1,i) = R2bb_a_intmd(b,j,kk1,i)  

              TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i) 
              HC_BBA +=  TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT
     
     EXECUTE SIP_BARRIER 
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     DO kk1
        DO i
           GET R1a_intmd(i,kk1)

           Tikk(i,kk1)  = R1a_intmd(i,kk1)
           Tikk(i,kk1) *= INV_SQRT_NORM_ORTGC

           PUT R1a(i,kk1) =  Tikk(i,kk1)

         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET R1b_intmd(j,kk1)

            Tjkk(j,kk1)  = R1b_intmd(j,kk1)
            Tjkk(j,kk1) *= INV_SQRT_NORM_ORTGC

            PUT R1b(j,kk1) =  Tjkk(j,kk1)

         ENDDO j
     ENDDO kk1

    PARDO i, i1, kk1, a
         
         GET R2aa_a_intmd(a,i,kk1,i1)

         Taiki(a,i,kk1,i1)  = R2aa_a_intmd(a,i,kk1,i1)
         Taiki(a,i,kk1,i1) *= INV_SQRT_NORM_ORTGC

         PUT R2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

         GET R2bb_b_intmd(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  = R2bb_b_intmd(b,j,kk1,j1)
         Tbjkj(b,j,kk1,j1) *= INV_SQRT_NORM_ORTGC

         PUT R2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1) 

     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j

        GET R2aa_b_intmd(a,i,kk1,j)

        Taikj(a,i,kk1,j)  =  R2aa_b_intmd(a,i,kk1,j)
        Taikj(a,i,kk1,j) *= INV_SQRT_NORM_ORTGC

        PUT R2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)

     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b

        GET R2bb_a_intmd(b,j,kk1,i) 

        Tbjki(b,j,kk1,i)  = R2bb_a_intmd(b,j,kk1,i)
        Tbjki(b,j,kk1,i) *= INV_SQRT_NORM_ORTGC

        PUT R2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER

#bgn_debug
      sumab=0.0
      tmpa=0.0
      tmpb=0.0
      suma=0.0
      sumb=0.0
      pardo i,kk1
         get r1a(i,kk1)
         tmp = r1a(i,kk1) * r1a(i,kk1)
         tmpa += tmp
      endpardo i,kk1
      pardo j,kk1
         get r1b(j,kk1)
         tmp = r1b(j,kk1) * r1b(j,kk1)
         tmpb += tmp
      endpardo j,kk1
      execute sip_barrier
      collective suma +=tmpa
      collective sumb +=tmpb
      execute print_scalar suma
      execute print_scalar sumb
      sumab  = suma
      sumab += sumb
      tmpa =0.0
      suma =0.0
      pardo a,i1,kk1,i
            get  R2aa_a(a,i1,kk1,i)
            tmp = R2aa_a(a,i1,kk1,i) * R2aa_a(a,i1,kk1,i)
            tmpa += tmp
      endpardo a,i1,kk1,i
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
      sumab += suma
      tmpa =0.0
      suma =0.0
      pardo b,j,j1, kk1
            get  R2bb_b(b,j1,kk1,j)
            tmp = R2bb_b(b,j1,kk1,j) * R2bb_b(b,j1,kk1,j)
            tmpa+= tmp
      endpardo b,j,j1, kk1
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
      sumab += suma
      tmpa =0.0
      suma =0.0
      pardo j,i1,a,kk1
            get R2aa_b(a,i1,kk1,j)
            tmp = R2aa_b(a,i1,kk1,j) * R2aa_b(a,i1,kk1,j)
            tmpa+= tmp
      endpardo j,i1,a,kk1
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
      sumab += suma
      tmpa=0.0
      suma=0.0
      pardo i,j1,b,kk1
            get R2bb_a(b,j1,kk1,i)
            tmp = R2bb_a(b,j1,kk1,i) * R2bb_a(b,j1,kk1,i)
            tmpa+= tmp
      endpardo i,j1,b,kk1
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
      sumab += suma
      execute print_scalar sumab
#end_debug
     ENDPROC RESCALE_NEW_C
#    ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50)  = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)  = 0.0
           DVECTORS(MINDEX50,NINDEX50)  = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50 

     PARDO i
        DO kk1
           tix(i,kk1)      = 0.0
           PUT Y1a(i,kk1,NINDEX50)  = tix(i,kk1)
           PUT HY1a(i,kk1,NINDEX50) = tix(i,kk1)
           PUT R1a_intmd(i,kk1) = tix(i,kk1)
        ENDDO kk1
     ENDPARDO i

     PARDO j
        DO kk1
           tjx(j,kk1)      = 0.0
           PUT Y1b(j,kk1,NINDEX50)  = tjx(j,kk1)
           PUT HY1b(j,kk1,NINDEX50) = tjx(j,kk1)
           PUT R1b_intmd(j,kk1) =  tjx(j,kk1)
       ENDDO kk1
     ENDPARDO j

     PARDO i, i1, a
           DO kk1
              taixi(a,i1,kk1,i)       = 0.0
              PREPARE Y2aa_a(a,i1,kk1,i,NINDEX50)  = taixi(a,i1,kk1,i)
              PREPARE HY2aa_a(a,i1,kk1,i,NINDEX50) = taixi(a,i1,kk1,i)
              PUT R2aa_a_intmd(a,i1,kk1,i) = taixi(a,i1,kk1,i)
           ENDDO kk1
     ENDPARDO i, i1, a

     PARDO j, j1, b
           DO kk1
              tbjxj(b,j1,kk1,j)       = 0.0
              PREPARE Y2bb_b(b,j1,kk1,j,NINDEX50)  = tbjxj(b,j1,kk1,j)
              PREPARE HY2bb_b(b,j1,kk1,j,NINDEX50) = tbjxj(b,j1,kk1,j)
              PUT R2bb_b_intmd(b,j1,kk1,j) = tbjxj(b,j1,kk1,j)
           ENDDO kk1
     ENDPARDO j, j1, b

     PARDO j, i1, a
           DO kk1
              taixj(a,i1,kk1,j)       = 0.0
              PREPARE Y2aa_b(a,i1,kk1,j,NINDEX50)  = taixj(a,i1,kk1,j)
              PREPARE HY2aa_b(a,i1,kk1,j,NINDEX50) = taixj(a,i1,kk1,j)
              PUT R2aa_b_intmd(a,i1,kk1,j) = taixj(a,i1,kk1,j)
           ENDDO kk1
     ENDPARDO j, i1, a

     PARDO i, j1, b
           DO kk1
              tbjxi(b,j1,kk1,i)       = 0.0
              PREPARE Y2bb_a(b,j1,kk1,i,NINDEX50)  = tbjxi(b,j1,kk1,i)
              PREPARE HY2bb_a(b,j1,kk1,i,NINDEX50) = tbjxi(b,j1,kk1,i)
              PUT R2bb_a_intmd(b,j1,kk1,i) = tbjxi(b,j1,kk1,i)
           ENDDO kk1
     ENDPARDO i, j1, b

     ENDDO NINDEX50 

     EXECUTE  SERVER_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC REORDER_A_EIGS
#    -------------------
     
     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE 
              A_DIAGS(MINDEX50)      = EIG_VALUE 
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS 
     
     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF 

#                 IF MCOUNT == ITER_COUNT 
#                    IF NCOUNT == ITER_COUNT
#                       EXIT
#                    ENDIF 
#                ENDIF 

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO i, kk1

                            GET R1A_HIST(i,kk1,NINDEX50)
                            GET R1A_HIST(i,kk1,MINDEX50)

                            Tikk(i,kk1)   = R1A_HIST(i,kk1,NINDEX50)
                            T1ikk(i,kk1)  = R1A_HIST(i,kk1,MINDEX50)

                            TMP   = Tikk(i,kk1) *  T1ikk(i,kk1)
                            SUMA += TMP

                     ENDPARDO i, kk1

                     PARDO j, kk1

                           GET R1B_HIST(j,kk1,NINDEX50)
                           GET R1B_HIST(j,kk1,MINDEX50)

                           Tjkk(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
                           T1jkk(j,kk1) = R1B_HIST(j,kk1,MINDEX50)

                            TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                            SUMB += TMP

                     ENDPARDO j, kk1

                     PARDO i, i1, kk1, a

                           REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                           REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                           Taiki(a,i,kk1,i1)  = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                           T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)

                           TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 
                           SUMAAA += TMP
                
                     ENDPARDO i, i1, kk1, a

                     PARDO j, j1, kk1, b
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                           Tbjkj(b,j,kk1,j1)  = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                           T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                        
                           TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)
                           SUMBBB += TMP

                     ENDPARDO j, j1, kk1, b

                     PARDO a, i, kk1, j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50)  j
            
                           Taikj(a,i,kk1,j)  = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
                           T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                              
                           TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)
                           SUMAAB += TMP
    
                     ENDPARDO a, i, kk1, j

                     PARDO j, i, kk1, b
                           REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                           REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50)  i
                
                           Tbjki(b,j,kk1,i)  = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
                           T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
        
                           TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)
                           SUMBBA += TMP
    
                     ENDPARDO j, i, kk1, b
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

#bgn_debug
     execute print_static etemp  iter_count 
#end_debug

     ENDPROC C_CHECK
#    ---------------

     PROC INIT_TO_ZERO
#    -----------------

     NCOUNT = ZERO
     DO NINDEX50
        
     NCOUNT +=1.0

     IF NCOUNT <= NREDUCE 
     PARDO i
        DO kk1
           tix(i,kk1)      = 0.0
           PUT Y1a_TRUNCT(i,kk1,NINDEX50)  = tix(i,kk1)
        ENDDO kk1
     ENDPARDO i

     PARDO j
        DO kk1
           tjx(j,kk1)      = 0.0
           PUT Y1b_TRUNCT(j,kk1,NINDEX50)  = tjx(j,kk1)
       ENDDO kk1
     ENDPARDO j

     PARDO i, i1, a
           DO kk1
              taixi(a,i1,kk1,i)       = 0.0
              PREPARE Y2aa_a_TRUNCT(a,i1,kk1,i,NINDEX50)  = taixi(a,i1,kk1,i)
           ENDDO kk1
     ENDPARDO i, i1, a

     PARDO j, j1, b
           DO kk1
              tbjxj(b,j1,kk1,j)       = 0.0
              PREPARE Y2bb_b_TRUNCT(b,j1,kk1,j,NINDEX50)  = tbjxj(b,j1,kk1,j)
           ENDDO kk1
     ENDPARDO j, j1, b

     PARDO j, i1, a
           DO kk1
              taixj(a,i1,kk1,j)       = 0.0
              PREPARE Y2aa_b_TRUNCT(a,i1,kk1,j,NINDEX50)  = taixj(a,i1,kk1,j)
           ENDDO kk1
     ENDPARDO j, i1, a

     PARDO i, j1, b
           DO kk1
              tbjxi(b,j1,kk1,i)       = 0.0
              PREPARE Y2bb_a_TRUNCT(b,j1,kk1,i,NINDEX50)  = tbjxi(b,j1,kk1,i)
           ENDDO kk1
     ENDPARDO i, j1, b
     ENDIF 

     ENDDO NINDEX50

     EXECUTE  SERVER_BARRIER

     ENDPROC INIT_TO_ZERO
#    -------------------

     PROC TRANSFORM_C
#   -----------------

     PARDO i, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1A_HIST(i,kk1,MINDEX50)
                       Tixs(i,kk1,MINDEX50)  = R1A_HIST(i,kk1,MINDEX50)
                       T1ixs(i,kk1,NINDEX50) = Tixs(i,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(i,kk1,NINDEX50) += T1ixs(i,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, kk1

     PARDO j, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET R1B_HIST(j,kk1,MINDEX50)
                       Tjxs(j,kk1,MINDEX50)  = R1B_HIST(j,kk1,MINDEX50)
                       T1jxs(j,kk1,NINDEX50) = Tjxs(j,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B_TRUNCT(j,kk1,NINDEX50) += T1jxs(j,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  j, kk1

     PARDO i, i1, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                       Taikis(a,i,kk1,i1,MINDEX50) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)
                       T1aikis(a,i,kk1,i1,NINDEX50) = Taikis(a,i,kk1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa_a_TRUNCT(a,i,kk1,i1,NINDEX50) += T1aikis(a,i,kk1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0 

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                       Tbjkjs(b,j,kk1,j1,MINDEX50) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                       T1bjkjs(b,j,kk1,j1,NINDEX50) = Tbjkjs(b,j,kk1,j1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_b_TRUNCT(b,j,kk1,j1,NINDEX50) += T1bjkjs(b,j,kk1,j1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50) j

                       Taikjs(a,i,kk1,j,MINDEX50) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                       T1aikjs(a,i,kk1,j,NINDEX50) = Taikjs(a,i,kk1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2aa_b_TRUNCT(a,i,kk1,j,NINDEX50) += T1aikjs(a,i,kk1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50) i

                       Tbjkis(b,j,kk1,i,MINDEX50) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
                       T1bjkis(b,j,kk1,i,NINDEX50) = Tbjkis(b,j,kk1,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2bb_a_TRUNCT(b,j,kk1,i,NINDEX50) += T1bjkis(b,j,kk1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER

    ENDPROC TRANSFORM_C
#   --------------------

    PROC TRANSFORM_HC
#   -----------------

     PARDO i, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET HR1A_HIST(i,kk1,MINDEX50)
                       Tixs(i,kk1,MINDEX50)  = HR1A_HIST(i,kk1,MINDEX50)
                       T1ixs(i,kk1,NINDEX50) = Tixs(i,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(i,kk1,NINDEX50) += T1ixs(i,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, kk1
     PARDO j, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET HR1B_HIST(j,kk1,MINDEX50)
                       Tjxs(j,kk1,MINDEX50)  = HR1B_HIST(j,kk1,MINDEX50)
                       T1jxs(j,kk1,NINDEX50) = Tjxs(j,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
