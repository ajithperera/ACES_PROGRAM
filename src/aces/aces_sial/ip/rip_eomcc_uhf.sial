    ENDPROC FORM_12HHP_DIAG
#   -----------------------

    PROC FORM_1HHP_DIAG
#   -------------------
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#
           GET              Uii(i1,i)
           Sii(i1,i)      = Uii(i1,i)
#           Sii(i1,i)      = fock_a(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET              Ujj(j1,j)
        Sjj(j1,j)      = Ujj(j1,j)
#        Sjj(j1,j)      = fock_a(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1
#
# -----prepare f_aa diagonal = DDaa
#
     PARDO a, a1
#
           GET              Uaa(a,a1)
           Saa(a,a1)      = Uaa(a,a1)
#           Saa(a,a1)      = fock_a(a,a1)
           execute return_diagonal Saa Sdaa
           taa(a,a1)      = Sdaa(a,a1)
           put DDaa(a,a1) = taa(a,a1)
#
     ENDPARDO a, a1
#
#
#
# -----prepare f_bb diagonal = DDbb
#
     PARDO b, b1
#
        GET              Ubb(b,b1)
        Sbb(b,b1)      = Ubb(b,b1)
#        Sbb(b,b1)      = fock_a(b,b1)
        execute return_diagonal Sbb Sdbb
        tbb(b,b1)      = Sdbb(b,b1)
        put DDbb(b,b1) = tbb(b,b1)
#
     ENDPARDO b, b1
#
     execute sip_barrier
#
     PARDO i
        DO kk1
#
           tis(i,kk1)=0.0
#
           do i1
#
              get          DDii(i1,i)
              t1is(i1,kk1) = 1.0
              tii(i,i1)  = DDii(i1,i)
#
              t2is(i,kk1)  = tii(i,i1)*t1is(i1,kk1)
              tis(i,kk1)  += t2is(i,kk1)
#
           enddo i1
#
           PUT Ri(i,kk1) += tis(i,kk1)
#
        ENDDO kk1
     ENDPARDO i

     PARDO j
        DO kk1
#
           tjs(j,kk1)=0.0
#
           do j1
#
              get          DDjj(j1,j)
              t1js(j1,kk1) = 1.0
              tjj(j,j1)  = DDjj(j1,j)
#
              t2js(j,kk1)  = tjj(j,j1)*t1js(j1,kk1)
              tjs(j,kk1)  += t2js(j,kk1)
#
           enddo j1
           PUT Rj(j,kk1) += tjs(j,kk1)
#
        ENDDO kk1
     ENDPARDO j
#
     PARDO a, i, i1
        DO kk1
#
           taixi(a,i,kk1,i1) = 0.0
#
           do i2
#
              GET                   DDii(i2,i1)
              tiaix(i2,a,i,kk1)   = 1.0
              tii(i1,i2)          = DDii(i2,i1)
#
              t1aixi(a,i,kk1,i1)  = tiaix(i2,a,i,kk1)*tii(i1,i2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo i2
#
           do i2
#
              GET                   DDii(i2,i)
              tiaix(i2,a,i1,kk1)  = 1.0
              tii(i,i2)           = DDii(i2,i)
#
              t1aixi(a,i,kk1,i1)  = tiaix(i2,a,i1,kk1)*tii(i,i2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo i2
#
           do a2
#
              GET                   DDaa(a2,a)
              t2aixi(a2,i,kk1,i1)  =-1.0
              taa(a,a2)           = DDaa(a2,a)
#
              t1aixi(a,i,kk1,i1)  = t2aixi(a2,i,kk1,i1)*taa(a,a2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo a2
#
           PUT Raixi(a,i,kk1,i1) += taixi(a,i,kk1,i1)
#
        ENDDO kk1
     ENDPARDO a, i, i1

     PARDO b, j, j1
        DO kk1
#
           tbjxj(b,j,kk1,j1) = 0.0
#
           do j2
#
              GET                   DDjj(j2,j1)
              tjbjx(j2,b,j,kk1)   = 1.0
              tjj(j1,j2)          = DDjj(j2,j1)
#
              t1bjxj(b,j,kk1,j1)  = tjbjx(j2,b,j,kk1)*tjj(j1,j2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo j2
#
           do j2
#
              GET                   DDjj(j2,j)
              tjbjx(j2,b,j1,kk1)  = 1.0
              tjj(j,j2)           = DDjj(j2,j)
#
              t1bjxj(b,j,kk1,j1)  = tjbjx(j2,b,j1,kk1)*tjj(j,j2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo j2
#
           do b2
#
              GET                   DDbb(b2,b)
              t2bjxj(b2,j,kk1,j1)  =-1.0
              tbb(b,b2)           = DDbb(b2,b)
#
              t1bjxj(b,j,kk1,j1)  = t2bjxj(b2,j,kk1,j1)*tbb(b,b2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo b2
#
           PUT Rbjxj(b,j,kk1,j1) += tbjxj(b,j,kk1,j1)
#
        ENDDO kk1
     ENDPARDO b, j, j1

     PARDO a, i, j1
        DO kk1
#
           taixj(a,i,kk1,j1) = 0.0
#
           do j2
#
              GET                   DDjj(j2,j1)
              tjaix(j2,a,i,kk1)   = 1.0
              tjj(j1,j2)          = DDjj(j2,j1)
#
              t1aixj(a,i,kk1,j1)  = tjaix(j2,a,i,kk1)*tjj(j1,j2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo j2
#
           do i2
#
              GET                   DDii(i2,i)
              tiajx(i2,a,j1,kk1)  = 1.0
              tii(i,i2)           = DDii(i2,i)
#
              t1aixj(a,i,kk1,j1)  = tiajx(i2,a,j1,kk1)*tii(i,i2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo i2
#
           do a2
#
              GET                   DDaa(a2,a)
              t2aixj(a2,i,kk1,j1)  =-1.0
              taa(a,a2)           = DDaa(a2,a)
#
              t1aixj(a,i,kk1,j1)  = t2aixj(a2,i,kk1,j1)*taa(a,a2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo a2
#
           PUT Raixj(a,i,kk1,j1) += taixj(a,i,kk1,j1)
#
        ENDDO kk1
     ENDPARDO a, i, j1

     PARDO b, j, i1
        DO kk1
#
           tbjxi(b,j,kk1,i1) = 0.0
#
           do i2
#
              GET                   DDii(i2,i1)
              tibjx(i2,b,j,kk1)   = 1.0
              tii(i1,i2)          = DDii(i2,i1)
#
              t1bjxi(b,j,kk1,i1)  = tibjx(i2,b,j,kk1)*tii(i1,i2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo i2
#
           do j2
#
              GET                   DDjj(j2,j)
              tjbix(j2,b,i1,kk1)  = 1.0
              tjj(j,j2)           = DDjj(j2,j)
#
              t1bjxi(b,j,kk1,i1)  = tjbix(j2,b,i1,kk1)*tjj(j,j2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo j2
#
           do b2
#
              GET                   DDbb(b2,b)
              t2bjxi(b2,j,kk1,i1)  =-1.0
              tbb(b,b2)           = DDbb(b2,b)
#
              t1bjxi(b,j,kk1,i1)  = t2bjxi(b2,j,kk1,i1)*tbb(b,b2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo b2
#
           PUT Rbjxi(b,j,kk1,i1) += tbjxi(b,j,kk1,i1)
#
        ENDDO kk1
     ENDPARDO b, j, i1

     execute sip_barrier 

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,kk1,i
#            get  Raixi(a,i,kk1,i1)
#            tmp = Raixi(a,i,kk1,i1) * Raixi(a,i,kk1,i1)
#            tmpa += tmp
#      endpardo a,i1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1, kk1
#            get Rbjxj(b,j,kk1,j1)
#            tmp = Rbjxj(b,j,kk1,j1) * Rbjxj(b,j,kk1,j1)
#            tmpa+= tmp
#      endpardo b,j,j1, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i,a,kk1
#            get Raixj(a,i,kk1,j)
#            tmp =  Raixj(a,i,kk1,j) *  Raixj(a,i,kk1,j)
#            tmpa+= tmp
#      endpardo j,i,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo i,j,b,kk1
#            get Rbjxi(b,j,kk1,i)
#            tmp = Rbjxi(b,j,kk1,i) * Rbjxi(b,j,kk1,i)
#            tmpa+= tmp
#      endpardo i,j,b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

    ENDPROC FORM_1HHP_DIAG
#   ----------------------

      PROC HR_MULT
#     ------------
#
# Zero out HR arrays
# ------------------
#
      PARDO i
         DO kk1
            tix(i,kk1)      = 0.0
            PUT HR1a(i,kk1) = tix(i,kk1)
         ENDDO kk1
      ENDPARDO i
#
      PARDO j
         DO kk1
            tjx(j,kk1)      = 0.0
            PUT HR1b(j,kk1) = tjx(j,kk1)
         ENDDO kk1
      ENDPARDO j
#
      PARDO i, i1, a
            DO kk1
               taixi(a,i1,kk1,i)       = 0.0
               PUT HR2aa_a(a,i1,kk1,i) = taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO i, i1, a
#
      PARDO j, j1, b
            DO kk1
               tbjxj(b,j1,kk1,j)       = 0.0
               PUT HR2bb_b(b,j1,kk1,j) = tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO j, j1, b

      PARDO i, j1, b
            DO kk1
               tbjxi(b,j1,kk1,i)       = 0.0
               PUT HR2bb_a(b,j1,kk1,i) = tbjxi(b,j1,kk1,i)
            ENDDO kk1
      ENDPARDO i, j1, b

      PARDO j, i1, a
            DO kk1
               taixj(a,i1,kk1,j)       = 0.0
               PUT HR2aa_b(a,i1,kk1,j) = taixj(a,i1,kk1,j)
            ENDDO kk1
      ENDPARDO j, i1, a
#
      create Iax
      create Ibx

      execute sip_barrier
#
# Create intermediates for 3-body term
# ------------------------------------
#
      PARDO a, i1, i
         DO kk1
            GET R2aa_a(a,i,kk1,i1)
            DO a1
               REQUEST            VSpipi(a1,i1,a,i) a1
               tax(a1,kk1)      = VSpipi(a1,i1,a,i)*R2aa_a(a,i,kk1,i1)
               tax(a1,kk1)     *= 0.5
               PUT Iax(a1,kk1) += tax(a1,kk1)
            ENDDO a1
         ENDDO kk1
      ENDPARDO a, i1, i
#
      PARDO b, i1, j
         DO kk1
            GET R2bb_a(b,j,kk1,i1)
            DO a1
               REQUEST            Vpiqj(a1,i1,b,j) a1
               tax(a1,kk1)      = Vpiqj(a1,i1,b,j)*R2bb_a(b,j,kk1,i1)
               PUT Iax(a1,kk1) += tax(a1,kk1)
            ENDDO a1
         ENDDO kk1
      ENDPARDO b, i1, j
#bgn_debug
#      execute sip_barrier
#      tmpa=0.0
#      suma=0.0
#      pardo a1,kk1
#         get iax(a1,kk1)
#         tmp = iax(a1,kk1) * iax(a1,kk1)
#         tmpa += tmp
#      endpardo a1,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
      PARDO b, j1, j
         DO kk1
            GET R2bb_b(b,j,kk1,j1)
            DO b1
               REQUEST            VSqjqj(b1,j1,b,j) b1
               tbx(b1,kk1)      = VSqjqj(b1,j1,b,j)*R2bb_b(b,j,kk1,j1)
               tbx(b1,kk1)     *= 0.5
               PUT Ibx(b1,kk1) += tbx(b1,kk1)
            ENDDO b1
         ENDDO kk1
      ENDPARDO b, j1, j
#
      PARDO a, j1, i
         DO kk1
            GET R2aa_b(a,i,kk1,j1)
            DO b1
               REQUEST            Vpiqj(a,i,b1,j1) b1
               tbx(b1,kk1)      = Vpiqj(a,i,b1,j1)*R2aa_b(a,i,kk1,j1)
               PUT Ibx(b1,kk1) += tbx(b1,kk1)
            ENDDO b1
         ENDDO kk1
      ENDPARDO a, j1, i
#bgn_debug
#      execute sip_barrier
#      sumb=0.0
#      tmpb=0.0
#      pardo b,kk1
#         get Ibx(b,kk1)
#         tmp =  Ibx(b,kk1) *  Ibx(b,kk1)
#         tmpb += tmp
#      endpardo b,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
# (HR)_i
# ------
#
      PARDO i, i1
            DO kk1
               GET                Uii(i1,i)
               GET                R1a(i1,kk1)
               tix(i,kk1)       = Uii(i1,i)*R1a(i1,kk1)
               tix(i,kk1)      *= -1.0
               PUT HR1a(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, i1
#
      PARDO i, a, i1, i2
            DO kk1
               REQUEST            Wiiia(i2,i,i1,a) i
               GET                R2aa_a(a,i1,kk1,i2)
               tix(i,kk1)       = R2aa_a(a,i1,kk1,i2)*Wiiia(i2,i,i1,a)
               tix(i,kk1)      *= -0.5
               PUT HR1a(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, a, i1, i2
#bgn_debug
#      execute sip_barrier
#      tmpa=0.0
#      suma=0.0
#      pardo i,kk1
#         get hr1a(i,kk1)
#         tmp = hr1a(i,kk1) * hr1a(i,kk1)
#         tmpa += tmp
#      endpardo i,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,kk1,i
#            get  R2aa_a(a,i1,kk1,i)
#            tmp = R2aa_a(a,i1,kk1,i) * R2aa_a(a,i1,kk1,i)
#            tmpa += tmp
#      endpardo a,i1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo i,a,i1,i2
#          request Wiiia(i2,i,i1,a) i
#          tmp = Wiiia(i2,i,i1,a) * Wiiia(i2,i,i1,a)
#          tmpa += tmp
#      endpardo i,a,i1,i2
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
#
      PARDO i, b, j1, i2
            DO kk1
               REQUEST            Wiijb(i2,i,j1,b) i
               GET                R2bb_a(b,j1,kk1,i2)
               tix(i,kk1)       = R2bb_a(b,j1,kk1,i2)*Wiijb(i2,i,j1,b)
               tix(i,kk1)      *= -1.0
               PUT HR1a(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, b, j1, i2

      PARDO i, i1, a
            DO kk1
               GET                Uia(i1,a)
               GET                R2aa_a(a,i1,kk1,i)
               tix(i,kk1)       = R2aa_a(a,i1,kk1,i)*Uia(i1,a)
               PUT HR1a(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, i1, a
#
      PARDO i, j1, b
            DO kk1
               GET                Ujb(j1,b)
               GET                R2bb_a(b,j1,kk1,i)
               tix(i,kk1)       = R2bb_a(b,j1,kk1,i)*Ujb(j1,b)
               PUT HR1a(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, j1, b
#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo i,kk1
#         get hr1a(i,kk1)
#         tmp = hr1a(i,kk1) * hr1a(i,kk1)
#         tmpa += tmp
#      endpardo i,kk1
#      execute sip_barrier
#     collective suma +=tmpa
#      execute print_scalar suma
#end_debug
#
# (HR)_j
# ------
#
      PARDO j, j1
            DO kk1
               GET                Ujj(j1,j)
               GET                R1b(j1,kk1)
               tjx(j,kk1)       = Ujj(j1,j)*R1b(j1,kk1)
               tjx(j,kk1)      *= -1.0
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, j1
#
      PARDO j, b, j1, j2
            DO kk1
               REQUEST            Wjjjb(j2,j,j1,b) j
               GET                R2bb_b(b,j1,kk1,j2)
               tjx(j,kk1)       = R2bb_b(b,j1,kk1,j2)*Wjjjb(j2,j,j1,b)
               tjx(j,kk1)      *= -0.5
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, b, j1, j2
#bgn_debug
#      execute sip_barrier
#      sumb=0.0
#      tmpb=0.0
#      pardo j,kk1
#         get hr1b(j,kk1)
#         tmp = hr1b(j,kk1) * hr1b(j,kk1)
#         tmpb += tmp
#      endpardo j,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1, kk1
#            get  R2bb_b(b,j1,kk1,j)
#            tmp = R2bb_b(b,j1,kk1,j) * R2bb_b(b,j1,kk1,j)
#            tmpa+= tmp
#      endpardo b,j,j1, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumb=0.0
#      tmpb=0.0
#      pardo j, b, j1, j2
#         request Wjjjb(j2,j,j1,b) j
#         tmp = Wjjjb(j2,j,j1,b) * Wjjjb(j2,j,j1,b)
#         tmpb += tmp
#      endpardo j, b, j1, j2
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
      PARDO j, a, i1, j2
            DO kk1
               REQUEST            Wjjia(j2,j,i1,a) j
               GET                R2aa_b(a,i1,kk1,j2)
               tjx(j,kk1)       = R2aa_b(a,i1,kk1,j2)*Wjjia(j2,j,i1,a)
               tjx(j,kk1)      *= -1.0
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, a, i1, j2
#
      PARDO j, j1, b
            DO kk1
               GET                Ujb(j1,b)
               GET                R2bb_b(b,j1,kk1,j)
               tjx(j,kk1)       = R2bb_b(b,j1,kk1,j)*Ujb(j1,b)
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, j1, b
#
      PARDO j, i1, a
            DO kk1
               GET                Uia(i1,a)
               GET                R2aa_b(a,i1,kk1,j)
               tjx(j,kk1)       = R2aa_b(a,i1,kk1,j)*Uia(i1,a)
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, i1, a
#bgn_debug
#      execute sip_barrier 
#      sumb=0.0
#      tmpb=0.0
#      pardo j,kk1
#         get hr1b(j,kk1)
#         tmp = hr1b(j,kk1) * hr1b(j,kk1)
#         tmpb += tmp
#      endpardo j,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
# (HR)^a_{i,i1)
# -------------
#
      PARDO i, i1, a, i2
            DO kk1
               REQUEST                   Wiiai(i2,i,a,i1) i
               GET                       R1a(i2,kk1)
               taixi(a,i1,kk1,i)       = Wiiai(i2,i,a,i1)*R1a(i2,kk1)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO i, i1, a, i2
#
      PARDO a, i1, i, i2
            DO kk1
               GET                       Uii(i2,i1)
               GET                       R2aa_a(a,i2,kk1,i)
               taixi(a,i1,kk1,i)       = R2aa_a(a,i2,kk1,i)*Uii(i2,i1)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO a, i1, i, i2
#
      PARDO i, i1, a, i2
            DO kk1
               GET                       Uii(i2,i)
               GET                       R2aa_a(a,i1,kk1,i2)
               taixi(a,i1,kk1,i)       = R2aa_a(a,i1,kk1,i2)*Uii(i2,i)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO i, i1, a, i2
#
      PARDO a, i, i1, a1
            DO kk1
               GET                       R2aa_a(a1,i1,kk1,i)
               GET                       Uaa(a,a1)
               taixi(a,i1,kk1,i)       = R2aa_a(a1,i1,kk1,i)*Uaa(a,a1)
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO a, i, i1, a1

      PARDO i, i1, i2, i3
            REQUEST             Wiiii(i2,i,i3,i1) i2
            Tiiii(i3,i1,i2,i) = Wiiii(i2,i,i3,i1)
            DO a
            DO kk1
               GET                        R2aa_a(a,i3,kk1,i2)
               taixi(a,i1,kk1,i)        = R2aa_a(a,i3,kk1,i2)*Tiiii(i3,i1,i2,i)  
               taixi(a,i1,kk1,i)       *= 0.5
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
            ENDDO a
      ENDPARDO i, i1, i2, i3
#
      PARDO i1, a, a1, i2
            REQUEST Wiaai(i2,a1,a,i1) a1
            DO i
            DO kk1
               GET                        R2aa_a(a1,i2,kk1,i)
               taixi(a,i1,kk1,i)        = R2aa_a(a1,i2,kk1,i)*Wiaai(i2,a1,a,i1)  
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)       = taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)      *= -1.0
               PUT HR2aa_a(a,i,kk1,i1) += t1aixi(a,i,kk1,i1)
            ENDDO kk1
            ENDDO i
      ENDPARDO i1, a, a1, i2
#
      PARDO i1, a, b1, j2
            REQUEST Wjbai(j2,b1,a,i1) b1
            DO i
            DO kk1
               GET                        R2bb_a(b1,j2,kk1,i)
               taixi(a,i1,kk1,i)        = R2bb_a(b1,j2,kk1,i)*Wjbai(j2,b1,a,i1)  
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)       = taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)      *= -1.0
               PUT HR2aa_a(a,i,kk1,i1) += t1aixi(a,i,kk1,i1)
            ENDDO kk1
            ENDDO i
      ENDPARDO i1, a, b1, j2
#
# (HR)^b_{j,j1)
# -------------
#
      PARDO j, j1, b, j2
            DO kk1
               REQUEST                   Wjjbj(j2,j,b,j1) j
               GET                       R1b(j2,kk1)
               tbjxj(b,j1,kk1,j)       = Wjjbj(j2,j,b,j1)*R1b(j2,kk1)
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO j, j1, b, j2
#
      PARDO b, j1, j, j2
            DO kk1
               GET                       Ujj(j2,j1)
               GET                       R2bb_b(b,j2,kk1,j)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b,j2,kk1,j)*Ujj(j2,j1)
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO b, j1, j, j2
#
      PARDO j, j1, b, j2
            DO kk1
               GET                       Ujj(j2,j)
               GET                       R2bb_b(b,j1,kk1,j2)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b,j1,kk1,j2)*Ujj(j2,j)           
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO j, j1, b, j2
#
      PARDO b, j, j1, b1
            DO kk1
               GET                       R2bb_b(b1,j1,kk1,j)
               GET                       Ubb(b,b1)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b1,j1,kk1,j)*Ubb(b,b1)
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO b, j, j1, b1
      PARDO j, j1, j2, j3
            REQUEST Wjjjj(j2,j,j3,j1) j2
            tjjjj(j3,j1,j2,j) = Wjjjj(j2,j,j3,j1)
            DO b
            DO kk1
               GET                        R2bb_b(b,j3,kk1,j2)
               tbjxj(b,j1,kk1,j)        = R2bb_b(b,j3,kk1,j2)*tjjjj(j3,j1,j2,j)  
               tbjxj(b,j1,kk1,j)       *= 0.5
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
            ENDDO b
      ENDPARDO j, j1, j2, j3
#
      PARDO j1, b, b1, j2
            REQUEST Wjbbj(j2,b1,b,j1) b1
            DO j
            DO kk1
               GET                        R2bb_b(b1,j2,kk1,j)
               tbjxj(b,j1,kk1,j)        = R2bb_b(b1,j2,kk1,j)*Wjbbj(j2,b1,b,j1)  
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)       = tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)      *= -1.0
               PUT HR2bb_b(b,j,kk1,j1) += t1bjxj(b,j,kk1,j1)
            ENDDO kk1
            ENDDO j
      ENDPARDO j1, b, b1, j2
#
      PARDO j1, b, a1, i2
            REQUEST Wiabj(i2,a1,b,j1) a1
            DO j
            DO kk1
               GET                        R2aa_b(a1,i2,kk1,j)
               tbjxj(b,j1,kk1,j)        = R2aa_b(a1,i2,kk1,j)*Wiabj(i2,a1,b,j1)  
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)       = tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)      *= -1.0
               PUT HR2bb_b(b,j,kk1,j1) += t1bjxj(b,j,kk1,j1)
            ENDDO kk1
            ENDDO j
      ENDPARDO j1, b, a1, i2
#
# (HR)^a_{i,j)
# ------------
#
      PARDO a, j, i, j1
            DO kk1
               REQUEST                   Wjjai(j1,j,a,i) a
               GET                       R1b(j1,kk1)
               taixj(a,i,kk1,j)        = Wjjai(j1,j,a,i)*R1b(j1,kk1)
               taixj(a,i,kk1,j)       *= -1.0
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
      ENDPARDO a, j, i, j1
#bgn_debug
#      execute sip_barrier
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,kk1
#            get HR2aa_b(a,i1,kk1,j)
#            tmp = HR2aa_b(a,i1,kk1,j) * HR2aa_b(a,i1,kk1,j)
#            tmpa+= tmp
#      endpardo j,i1,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
##end_debug
#
      PARDO j, a, i1
            DO kk1
               GET R2aa_b(a,i1,kk1,j)
               DO i
                  GET                       Uii(i1,i)
                  taixj(a,i,kk1,j)        = R2aa_b(a,i1,kk1,j)*Uii(i1,i)
                  taixj(a,i,kk1,j)       *= -1.0
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO i
            ENDDO kk1
      ENDPARDO j, a, i1
#
      PARDO a, i, j1
            DO kk1
               GET R2aa_b(a,i,kk1,j1)
               DO j
                  GET                       Ujj(j1,j)
                  taixj(a,i,kk1,j)        = R2aa_b(a,i,kk1,j1)*Ujj(j1,j)
                  taixj(a,i,kk1,j)       *= -1.0
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO j
            ENDDO kk1
      ENDPARDO a, i, j1
#
      PARDO i, j, a1
            DO kk1
               GET R2aa_b(a1,i,kk1,j)
               DO a
                  GET                       Uaa(a,a1)
                  taixj(a,i,kk1,j)        = R2aa_b(a1,i,kk1,j)*Uaa(a,a1)
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO a
            ENDDO kk1
      ENDPARDO i, j, a1
#
      PARDO i, j, j1, i1
            REQUEST Wiijj(i1,i,j1,j) i1
            DO a
            DO kk1
               GET                       R2aa_b(a,i1,kk1,j1)
               taixj(a,i,kk1,j)        = R2aa_b(a,i1,kk1,j1)*Wiijj(i1,i,j1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO a
      ENDPARDO i, j, j1, i1
#
      PARDO i, a, j1, b
            REQUEST Wjbai(j1,b,a,i) b
            DO j
            DO kk1
               GET                       R2bb_b(b,j1,kk1,j)
               taixj(a,i,kk1,j)        = Wjbai(j1,b,a,i)*R2bb_b(b,j1,kk1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO j
      ENDPARDO i, a, j1, b
#
      PARDO i, a, i1, a1
            REQUEST Wiaai(i1,a1,a,i) a1
            DO j
            DO kk1
               GET                       R2aa_b(a1,i1,kk1,j)
               taixj(a,i,kk1,j)        = Wiaai(i1,a1,a,i)*R2aa_b(a1,i1,kk1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO j
      ENDPARDO i, a, i1, a1
#bgn_debug
#      execute sip_barrier
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,kk1
#            get HR2aa_b(a,i1,kk1,j)
#            tmp = HR2aa_b(a,i1,kk1,j) * HR2aa_b(a,i1,kk1,j)
#            tmpa+= tmp
#      endpardo j,i1,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
# (HR)^b_{j,i) 
# ------------ 
#
      PARDO b, i, j, i1
            DO kk1
               REQUEST                   Wiibj(i1,i,b,j) b
               GET                       R1a(i1,kk1)
               tbjxi(b,j,kk1,i)        = Wiibj(i1,i,b,j)*R1a(i1,kk1)
               tbjxi(b,j,kk1,i)       *= -1.0
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
      ENDPARDO b, i, j, i1
#bgn_debug
#      execute sip_barrier
#      tmpb =0.0
#      sumb =0.0
#      pardo i,j1,b,kk1
#            get HR2bb_a(b,j1,kk1,i)
#            tmp = HR2bb_a(b,j1,kk1,i) * HR2bb_a(b,j1,kk1,i)
#            tmpb+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
      PARDO i, b, j1
            DO kk1
               GET R2bb_a(b,j1,kk1,i)
               DO j
                  GET                       Ujj(j1,j)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b,j1,kk1,i)*Ujj(j1,j)
                  tbjxi(b,j,kk1,i)       *= -1.0
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO j
            ENDDO kk1
      ENDPARDO i, b, j1
#
      PARDO b, j, i1
            DO kk1
               GET R2bb_a(b,j,kk1,i1)
               DO i
                  GET                       Uii(i1,i)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b,j,kk1,i1)*Uii(i1,i)
                  tbjxi(b,j,kk1,i)       *= -1.0
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO i
            ENDDO kk1
      ENDPARDO b, j, i1
#
      PARDO j, i, b1
            DO kk1
               GET R2bb_a(b1,j,kk1,i)
               DO b
                  GET                       Ubb(b,b1)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b1,j,kk1,i)*Ubb(b,b1)
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO b
            ENDDO kk1
      ENDPARDO j, i, b1
#
      PARDO i, j, j1, i1
            REQUEST            Wiijj(i1,i,j1,j) i1
            tjjii(j1,j,i1,i) = Wiijj(i1,i,j1,j)
            DO b
            DO kk1
               GET                       R2bb_a(b,j1,kk1,i1)
               tbjxi(b,j,kk1,i)        = R2bb_a(b,j1,kk1,i1)*tjjii(j1,j,i1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO b
      ENDPARDO i, j, j1, i1
#
      PARDO j, b, i1, a
            REQUEST Wiabj(i1,a,b,j) a
            DO i
            DO kk1
               GET                       R2aa_a(a,i1,kk1,i)
               tbjxi(b,j,kk1,i)        = Wiabj(i1,a,b,j)*R2aa_a(a,i1,kk1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO i
      ENDPARDO j, b, i1, a
#
      PARDO j, b, j1, b1
            REQUEST Wjbbj(j1,b1,b,j) b1
            DO i
            DO kk1
               GET                       R2bb_a(b1,j1,kk1,i)
               tbjxi(b,j,kk1,i)        = Wjbbj(j1,b1,b,j)*R2bb_a(b1,j1,kk1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO i
      ENDPARDO j, b, j1, b1
#
      execute sip_barrier
#bgn_debug
#      execute sip_barrier
#      tmpb =0.0
#      sumb =0.0
#      pardo i,j1,b,kk1
#            get HR2bb_a(b,j1,kk1,i)
#            tmp = HR2bb_a(b,j1,kk1,i) * HR2bb_a(b,j1,kk1,i)
#            tmpb+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug

#
      PARDO a1, a, i1, i
         DO kk1
            REQUEST                     T2aa(a1,i1,a,i) a1
            GET                         Iax(a,kk1)
            taixi(a1,i1,kk1,i)        = T2aa(a1,i1,a,i)*Iax(a,kk1)
            taixi(a1,i1,kk1,i)       *= -1.0
            PUT HR2aa_a(a1,i1,kk1,i) += taixi(a1,i1,kk1,i)
         ENDDO kk1
      ENDPARDO a1, a, i1, i
#
      PARDO b1, a, j1, i
         DO kk1
            REQUEST                     T2ab(a,i,b1,j1) b1
            GET                         Iax(a,kk1)
            tbjxi(b1,j1,kk1,i)        = T2ab(a,i,b1,j1)*Iax(a,kk1)
            tbjxi(b1,j1,kk1,i)       *= -1.0
            PUT HR2bb_a(b1,j1,kk1,i) += tbjxi(b1,j1,kk1,i)
         ENDDO kk1
      ENDPARDO b1, a, j1, i
#
      PARDO b1, b, j1, j
         DO kk1
            REQUEST                     T2bb(b1,j1,b,j) b1
            GET                         Ibx(b,kk1)
            tbjxj(b1,j1,kk1,j)        = T2bb(b1,j1,b,j)*Ibx(b,kk1)
            tbjxj(b1,j1,kk1,j)       *= -1.0
            PUT HR2bb_b(b1,j1,kk1,j) += tbjxj(b1,j1,kk1,j)
         ENDDO kk1
      ENDPARDO b1, b, j1, j
#
      PARDO a1, b, i1, j
         DO kk1
            REQUEST                     T2ab(a1,i1,b,j) a1
            GET                         Ibx(b,kk1)
            taixj(a1,i1,kk1,j)        = T2ab(a1,i1,b,j)*Ibx(b,kk1)
            taixj(a1,i1,kk1,j)       *= -1.0
            PUT HR2aa_b(a1,i1,kk1,j) += taixj(a1,i1,kk1,j)
         ENDDO kk1
      ENDPARDO a1, b, i1, j

      PARDO b, b1, i, i1
          REQUEST                   Wiibb(i1,i,b,b1) b
          DO j
          DO kk1
             GET                       R2bb_a(b1,j,kk1,i1)
             tbjxi(b,j,kk1,i)        = R2bb_a(b1,j,kk1,i1)*Wiibb(i1,i,b,b1)
            #tbjxi(b,j,kk1,i)       *= -1.0
             PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
          ENDDO kk1
          ENDDO j
      ENDPARDO b, b1, i, i1
#
      PARDO a, a1, j, j1
          REQUEST                   Wjjaa(j1,j,a,a1) a
          DO i 
          DO kk1
             GET                       R2aa_b(a1,i,kk1,j1)
             taixj(a,i,kk1,j)        = R2aa_b(a1,i,kk1,j1)*Wjjaa(j1,j,a,a1)
            #taixj(a,i,kk1,j)       *= -1.0
             PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
          ENDDO kk1
          ENDDO i
      ENDPARDO a, a1, j, j1
#
      execute server_barrier
      delete Iax
      delete Ibx

#      PARDO a, i, i1, kk1
