     PROC FORM_NEW_HBAR_Y_VECS
#    -------------------------
     PARDO i, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET HR1A_HIST(i,kk1,MINDEX50)
                       Tixs(i,kk1,MINDEX50)  = HR1A_HIST(i,kk1,MINDEX50)
                       T1ixs(i,kk1,NINDEX50) = Tixs(i,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT HY1A(i,kk1,NINDEX50) += T1ixs(i,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, kk1


     PARDO j, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET HR1B_HIST(j,kk1,MINDEX50)
                       Tjxs(j,kk1,MINDEX50)  = HR1B_HIST(j,kk1,MINDEX50)
                       T1jxs(j,kk1,NINDEX50) = Tjxs(j,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT HY1B(j,kk1,NINDEX50) += T1jxs(j,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  j, kk1


     PARDO i, i1, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                       Taikis(a,i,kk1,i1,MINDEX50) = HR2aa_a_HIST(a,i,kk1,i1,MINDEX50)
                       T1aikis(a,i,kk1,i1,NINDEX50) = Taikis(a,i,kk1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE HY2aa_a(a,i,kk1,i1,NINDEX50) += T1aikis(a,i,kk1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                       Tbjkjs(b,j,kk1,j1,MINDEX50) = HR2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                       T1bjkjs(b,j,kk1,j1,NINDEX50) = Tbjkjs(b,j,kk1,j1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE HY2bb_b(b,j,kk1,j1,NINDEX50) += T1bjkjs(b,j,kk1,j1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF 

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2aa_b_HIST(a,i,kk1,j,MINDEX50) j

                       Taikjs(a,i,kk1,j,MINDEX50) = HR2aa_b_HIST(a,i,kk1,j,MINDEX50)
                       T1aikjs(a,i,kk1,j,NINDEX50) = Taikjs(a,i,kk1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE HY2aa_b(a,i,kk1,j,NINDEX50) += T1aikjs(a,i,kk1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2bb_a_HIST(b,j,kk1,i,MINDEX50) i

                       Tbjkis(b,j,kk1,i,MINDEX50) = HR2bb_a_HIST(b,j,kk1,i,MINDEX50)
                       T1bjkis(b,j,kk1,i,NINDEX50) = Tbjkis(b,j,kk1,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE HY2bb_a(b,j,kk1,i,NINDEX50) += T1bjkis(b,j,kk1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, i, kk1, b
  
     EXECUTE SERVER_BARRIER 
                
     ENDPROC FORM_NEW_HBAR_Y_VECS
#    ----------------------------

     PROC KEEP_GUESS_VECS
#    --------------------

      PARDO i, kk1
          GET  R1a(i,kk1)
          Tikk(i,kk1)  = R1a(i,kk1)
          PUT INITIAL_R1A(i,kk1) = Tikk(i,kk1)
      ENDPARDO i, kk1

      PARDO j, kk1
          GET  R1b(j,kk1)
          Tjkk(j,kk1)  =  R1b(j,kk1)
          PUT INITIAL_R1b(j,kk1) = Tjkk(j,kk1)
      ENDPARDO j, kk1

     EXECUTE SIP_BARRIER

     ENDPROC KEEP_GUESS_VECS
#    -----------------------

     PROC SELECT_VECS_MAX_OVLP1
#    --------------------------

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT >  ITER_COUNT
           EXIT
        ENDIF

        SUMA   = 0.0
        SUMB   = 0.0
        CY_A   = 0.0
        CY_B   = 0.0

        PARDO i, kk1

             GET INITIAL_R1A(i,kk1)
             GET Y1a(i,kk1,MINDEX50)

             Tix(i,kk1)  = INITIAL_R1A(i,kk1)
             T1ix(i,kk1) = Y1a(i,kk1,MINDEX50)

             TMP   =  Tix(i,kk1) * T1ix(i,kk1)
             SUMA +=  TMP

        ENDPARDO i, kk1

        PARDO j, kk1

            GET INITIAL_R1B(j,kk1)
            GET Y1b(j,kk1,MINDEX50)

            Tjx(j,kk1)  = INITIAL_R1B(j,kk1)
            T1jx(j,kk1) = Y1b(j,kk1,MINDEX50)

            TMP    =  Tjx(j,kk1) * T1jx(j,kk1)
            SUMB   +=  TMP

        ENDPARDO j, kk1

        EXECUTE SIP_BARRIER
        COLLECTIVE CY_A += SUMA
        COLLECTIVE CY_B += SUMB

        CY_AB  = CY_A
        CY_AB += CY_B

        KCOUNT = 0.0
        DO KINDEX50
            KCOUNT += 1.0

            IF KCOUNT == MCOUNT
               OVERLAP_R(MINDEX50) = CY_AB
            ENDIF

        ENDDO KINDEX50

     ENDDO  MINDEX50

     EXECUTE SIP_BARRIER

     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
      ELSE
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
      ENDIF

#bgn_debug
#     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP1
#    -----------------------------

     PROC SELECT_VECS_MAX_OVLP2
#    --------------------------

     IF PREVS_VEC == ONE
        FOLLOW = ITER_COUNT
        FOLLOW -= ONE
     ENDIF 

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

         IF NCOUNT != FOLLOW 
            EXIT 
         ENDIF

           MCOUNT = 0.0
           DO MINDEX50
              MCOUNT += 1.0
              IF MCOUNT >  ITER_COUNT
                 EXIT
              ENDIF

     	         SUMA   = 0.0
	         SUMB   = 0.0
                 CY_A   = 0.0
                 CY_B   = 0.0

                 PARDO i, kk1

                       GET R1A_HIST(i,kk1,NINDEX50)
                       GET Y1a(i,kk1,MINDEX50)

                       Tix(i,kk1)  = R1A_HIST(i,kk1,NINDEX50) 
                       T1ix(i,kk1) = Y1a(i,kk1,MINDEX50) 
               
                       TMP   =  Tix(i,kk1) * T1ix(i,kk1)
                       SUMA +=  TMP
                       
                  ENDPARDO i, kk1

                  PARDO j, kk1

                       GET R1b_HIST(j,kk1,NINDEX50)
                       GET Y1b(j,kk1,MINDEX50)

                       Tjx(j,kk1)  = R1b_HIST(j,kk1,NINDEX50)
                       T1jx(j,kk1) = Y1b(j,kk1,MINDEX50)

                       TMP    =  Tjx(j,kk1) * T1jx(j,kk1)
                       SUMB   +=  TMP

                  ENDPARDO j, kk1

                  EXECUTE SIP_BARRIER
                  COLLECTIVE CY_A += SUMA
                  COLLECTIVE CY_B += SUMB
                       
                  CY_AB  = CY_A
                  CY_AB += CY_B

                  KCOUNT = 0.0 
                  DO KINDEX50 
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT 
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF 

                  ENDDO KINDEX50 

           ENDDO  MINDEX50

#        ENDIF

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
      ELSE
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
      ENDIF

#bgn_debug
#     execute print_scalar imax 
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP2
#    -----------------------------

     PROC SELECT_VECS_MIN_ENEG
#    -------------------------

     IF ROOT_COUNT == ONE

# Always pick the closest eigenvalue to the starting eigenvalue 

        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS A_DIAGS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
        IF IMAX_KEEP ==  ZERO
           IMAX = ONE
        ENDIF

      ELSE

# Find the root from the subspace that is not too close to the
# roots that have already been found.

        IF LOCK != ONE
           EXECUTE FIND_MIN_ENEG A_DIAGS PSEUDO_ROOTS
           EXECUTE SET_ACES3_VARS IMAX MONE
           IMAX_KEEP = IMAX
        ELSE
           EXECUTE SET_ACES3_VARS OMEGA THRTEN
           EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
           EXECUTE SET_ACES3_VARS IMAX MONE
           IMAX_KEEP = IMAX
        ENDIF
      ENDIF

#bgn_debug
     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MIN_ENEG
#    ----------------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, kk1
 
                 GET Y1a(i,kk1,NINDEX50) 
                 Tix(i,kk1) = Y1a(i,kk1,NINDEX50)
                 PUT Y1a_PICKED(i,kk1) = Tix(i,kk1)

           ENDPARDO i, kk1
        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO j, kk1
 
                 GET Y1b(j,kk1,NINDEX50) 
                 Tjx(j,kk1) = Y1b(j,kk1,NINDEX50)
                 PUT Y1b_PICKED(j,kk1) = Tjx(j,kk1)

           ENDPARDO j, kk1
        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, i1, kk1, a

                 REQUEST Y2aa_a(a,i1,kk1,i,NINDEX50) i
                 Taiki(a,i1,kk1,i) = Y2aa_a(a,i1,kk1,i,NINDEX50) 
                 PUT Y2aa_a_picked(a,i1,kk1,i) = Taiki(a,i1,kk1,i)

           ENDPARDO i, i1, kk1, a

        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO j, j1, kk1, b

                 REQUEST Y2bb_b(b,j1,kk1,j,NINDEX50) j
                 Tbjkj(b,j1,kk1,j) = Y2bb_b(b,j1,kk1,j,NINDEX50)
                 PUT Y2bb_b_picked(b,j1,kk1,j) = Tbjkj(b,j1,kk1,j)

           ENDPARDO j, j1, kk1, b

        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, kk1, a

                 REQUEST Y2aa_b(a,i,kk1,j,NINDEX50) j
                 Taikj(a,i,kk1,j) = Y2aa_b(a,i,kk1,j,NINDEX50) 
                 PUT Y2aa_b_picked(a,i,kk1,j) = Taikj(a,i,kk1,j)

           ENDPARDO i, j, kk1, a

        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO j, i, kk1, b

                 REQUEST Y2bb_a(b,j,kk1,i,NINDEX50) i
                 Tbjki(b,j,kk1,i) = Y2bb_a(b,j,kk1,i,NINDEX50)
                 PUT Y2bb_a_picked(b,j,kk1,i) = Tbjki(b,j,kk1,i)

           ENDPARDO j, i, kk1, b

        ENDIF 
     ENDDO NINDEX50
        
     EXECUTE SIP_BARRIER
#bgn_debug
