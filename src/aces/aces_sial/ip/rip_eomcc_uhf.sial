     ENDPROC FORM_RESIDUAL_VEC
#    -----------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0
     HC_AAB = 0.0
     HC_BBA = 0.0

     PARDO i, kk1

           GET RES1a(i,kk1)

           Tikk(i,kk1)   = RES1a(i,kk1)

           TMP   = Tikk(i,kk1) *  Tikk(i,kk1)
           SUMA += TMP

     ENDPARDO i, kk1

     PARDO j, kk1

           GET RES1b(j,kk1)

           Tjkk(j,kk1)  = RES1b(j,kk1)

           TMP   = Tjkk(j,kk1) *  Tjkk(j,kk1)
           SUMB += TMP

     ENDPARDO j, kk1

     PARDO i, i1, kk1, a

           GET RES2aa_a(a,i,kk1,i1) 

           Taiki(a,i,kk1,i1)  = RES2aa_a(a,i,kk1,i1)

           TMP     = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1) 
           SUMAAA += TMP
                
     ENDPARDO i, i1, kk1, a
   
     PARDO j, j1, kk1, b
           GET RES2bb_b(b,j,kk1,j1) 

           Tbjkj(b,j,kk1,j1)  = RES2bb_b(b,j,kk1,j1)
                     
           TMP     = Tbjkj(b,j,kk1,j1) *  Tbjkj(b,j,kk1,j1)
           SUMBBB += TMP

     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j
           GET RES2aa_b(a,i,kk1,j) 
            
           Taikj(a,i,kk1,j)  = RES2aa_b(a,i,kk1,j)
                            
           TMP     = Taikj(a,i,kk1,j) * Taikj(a,i,kk1,j)
           SUMAAB += TMP
    
     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
           GET RES2bb_a(b,j,kk1,i) 
                
           Tbjki(b,j,kk1,i)  = RES2bb_a(b,j,kk1,i)
        
           TMP   = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i)
           SUMBBA += TMP
    
     ENDPARDO j, i, kk1, b
      
     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A += SUMA
     COLLECTIVE HC_B += SUMB
     COLLECTIVE HC_AAA += SUMAAA
     COLLECTIVE HC_BBB += SUMBBB
     COLLECTIVE HC_AAB += SUMAAB
     COLLECTIVE HC_BBA += SUMBBA

     A_VALUE  = HC_A
     A_VALUE += HC_B
     A_VALUE += HC_AAA
     A_VALUE += HC_BBB
     A_VALUE += HC_AAB
     A_VALUE += HC_BBA

     EXECUTE SIP_BARRIER

     HALF = 0.5
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------

     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     DO kk1
        DO i
           GET RES1a(i,kk1)
           GET Ri(i,kk1)

           Tikk(i,kk1)   = Ri(i,kk1)
           T1ikk(i,kk1)  = RES1a(i,kk1)

           Tikk(i,kk1)  *= -1.0
           T2ikk(i,kk1)  = Omega
           Tikk(i,kk1)  += T2ikk(i,kk1)

           EXECUTE APPLY_DEN2_NOR  T1ikk Tikk

           PUT CORR_VECa(i,kk1) =  T1ikk(i,kk1)

         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET RES1b(j,kk1)
            GET Rj(j,kk1)

            Tjkk(j,kk1)   = Rj(j,kk1)
            T1jkk(j,kk1)  = RES1b(j,kk1)

            Tjkk(j,kk1)  *= -1.0
            T2jkk(j,kk1)  = Omega
            Tjkk(j,kk1)  += T2jkk(j,kk1)

            EXECUTE APPLY_DEN2_NOR  T1jkk Tjkk

            PUT CORR_VECb(j,kk1) =  T1jkk(j,kk1)
         ENDDO j
     ENDDO kk1

    PARDO i, i1, kk1, a
         GET RES2aa_a(a,i,kk1,i1)
         GET Raixi(a,i,kk1,i1)

         Taiki(a,i,kk1,i1)  = Raixi(a,i,kk1,i1)
         T1aiki(a,i,kk1,i1) = RES2aa_a(a,i,kk1,i1)

         Taiki(a,i,kk1,i1) *= -1.0
         T2aiki(a,i,kk1,i1) = Omega
         Taiki(a,i,kk1,i1)  += T2aiki(a,i,kk1,i1)

         EXECUTE APPLY_DEN4 T1aiki Taiki
             
         PUT CORR_VECaa_a(a,i,kk1,i1) = T1aiki(a,i,kk1,i1)
     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b
         GET RES2bb_b(b,j,kk1,j1)
         GET Rbjxj(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  = Rbjxj(b,j,kk1,j1)
         T1bjkj(b,j,kk1,j1) = RES2bb_b(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  *= -1.0
         T2bjkj(b,j,kk1,j1)  = Omega
         Tbjkj(b,j,kk1,j1)  += T2bjkj(b,j,kk1,j1)

         EXECUTE APPLY_DEN4 T1bjkj Tbjkj

         PUT CORR_VECbb_b(b,j,kk1,j1) = T1bjkj(b,j,kk1,j1)
     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j
        GET RES2aa_b(a,i,kk1,j)
        GET Raixj(a,i,kk1,j)

        Taikj(a,i,kk1,j)   = Raixj(a,i,kk1,j)
        T1aikj(a,i,kk1,j)  = RES2aa_b(a,i,kk1,j)

        Taikj(a,i,kk1,j)  *= -1.0
        T2aikj(a,i,kk1,j)  = Omega
        Taikj(a,i,kk1,j) += T2aikj(a,i,kk1,j)

        EXECUTE APPLY_DEN4 T1aikj Taikj

        PUT CORR_VECaa_b(a,i,kk1,j) = T1aikj(a,i,kk1,j)
     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
        GET RES2bb_a(b,j,kk1,i)
        GET Rbjxi(b,j,kk1,i)

        Tbjki(b,j,kk1,i)   = Rbjxi(b,j,kk1,i)
        T1bjki(b,j,kk1,i)  = RES2bb_a(b,j,kk1,i)

        Tbjki(b,j,kk1,i)  *= -1.0
        T2bjki(b,j,kk1,i)  = Omega
        Tbjki(b,j,kk1,i)  += T2bjki(b,j,kk1,i)

        EXECUTE APPLY_DEN4 T1bjki Tbjki

        PUT CORR_VECbb_a(b,j,kk1,i) = T1bjki(b,j,kk1,i)
     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER

#bgn_debug
#      if iter_count == 1.0
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,kk1
#         get CORR_VECa(i,kk1)
#         tmp = CORR_VECa(i,kk1) * CORR_VECa(i,kk1)
#         tmpa += tmp
#      endpardo i,kk1
#      pardo j,kk1
#         get CORR_VECb(j,kk1)
#         tmp = CORR_VECb(j,kk1) * CORR_VECb(j,kk1)
#         tmpb += tmp
#      endpardo j,kk1
#      execute sip_barrier
