#            get  R2aa_a(a,i1,kk1,i)
#            tmp = R2aa_a(a,i1,kk1,i) * R2aa_a(a,i1,kk1,i)
#            tmpa += tmp
#      endpardo a,i1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1, kk1
#            get  R2bb_b(b,j1,kk1,j)
#            tmp = R2bb_b(b,j1,kk1,j) * R2bb_b(b,j1,kk1,j)
#            tmpa+= tmp
#      endpardo b,j,j1, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,kk1
#            get R2aa_b(a,i1,kk1,j)
#            tmp = R2aa_b(a,i1,kk1,j) * R2aa_b(a,i1,kk1,j)
#            tmpa+= tmp
#      endpardo j,i1,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa=0.0
#      suma=0.0
#      pardo i,j1,b,kk1
#            get R2bb_a(b,j1,kk1,i)
#            tmp = R2bb_a(b,j1,kk1,i) * R2bb_a(b,j1,kk1,i)
#            tmpa+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug
     ENDPROC RESCALE_NEW_C
#    ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50)  = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)   = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50 

     PARDO i
        DO kk1
           tix(i,kk1)      = 0.0
           PUT Y1a(i,kk1,NINDEX50) = tix(i,kk1)
           PUT R1a_intmd(i,kk1) = tix(i,kk1)
        ENDDO kk1
     ENDPARDO i

     PARDO j
        DO kk1
           tjx(j,kk1)      = 0.0
           PUT Y1b(j,kk1,NINDEX50) = tjx(j,kk1)
           PUT R1b_intmd(j,kk1) =  tjx(j,kk1)
       ENDDO kk1
     ENDPARDO j

     PARDO i, i1, a
           DO kk1
              taixi(a,i1,kk1,i)       = 0.0
              PREPARE Y2aa_a(a,i1,kk1,i,NINDEX50) = taixi(a,i1,kk1,i)
              PUT R2aa_a_intmd(a,i1,kk1,i) = taixi(a,i1,kk1,i)
           ENDDO kk1
     ENDPARDO i, i1, a

     PARDO j, j1, b
           DO kk1
              tbjxj(b,j1,kk1,j)       = 0.0
              PREPARE Y2bb_b(b,j1,kk1,j,NINDEX50) = tbjxj(b,j1,kk1,j)
              PUT R2bb_b_intmd(b,j1,kk1,j) = tbjxj(b,j1,kk1,j)
           ENDDO kk1
     ENDPARDO j, j1, b

     PARDO j, i1, a
           DO kk1
              taixj(a,i1,kk1,j)       = 0.0
              PREPARE Y2aa_b(a,i1,kk1,j,NINDEX50) = taixj(a,i1,kk1,j)
              PUT R2aa_b_intmd(a,i1,kk1,j) = taixj(a,i1,kk1,j)
           ENDDO kk1
     ENDPARDO j, i1, a

     PARDO i, j1, b
           DO kk1
              tbjxi(b,j1,kk1,i)       = 0.0
              PREPARE Y2bb_a(b,j1,kk1,i,NINDEX50) = tbjxi(b,j1,kk1,i)
              PUT R2bb_a_intmd(b,j1,kk1,i) = tbjxi(b,j1,kk1,i)
           ENDDO kk1
     ENDPARDO i, j1, b

     ENDDO NINDEX50 

     EXECUTE  SERVER_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC REORDER_A_EIGS
#    -------------------
     
     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE 
              A_DIAGS(MINDEX50)      = EIG_VALUE 
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS 
     
     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF 

#                 IF MCOUNT == ITER_COUNT 
#                    IF NCOUNT == ITER_COUNT
#                       EXIT
#                    ENDIF 
#                ENDIF 

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO i, kk1

                            GET R1A_HIST(i,kk1,NINDEX50)
                            GET R1A_HIST(i,kk1,MINDEX50)

                            Tikk(i,kk1)   = R1A_HIST(i,kk1,NINDEX50)
                            T1ikk(i,kk1)  = R1A_HIST(i,kk1,MINDEX50)

                            TMP   = Tikk(i,kk1) *  T1ikk(i,kk1)
                            SUMA += TMP

                     ENDPARDO i, kk1

                     PARDO j, kk1

                           GET R1B_HIST(j,kk1,NINDEX50)
                           GET R1B_HIST(j,kk1,MINDEX50)

                           Tjkk(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
                           T1jkk(j,kk1) = R1B_HIST(j,kk1,MINDEX50)

                            TMP   = Tjkk(j,kk1) *  T1jkk(j,kk1)
                            SUMB += TMP

                     ENDPARDO j, kk1

                     PARDO i, i1, kk1, a

                           REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                           REQUEST R2aa_a_HIST(a,i,kk1,i1,MINDEX50)  i1

                           Taiki(a,i,kk1,i1)  = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                           T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,MINDEX50)

                           TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 
                           SUMAAA += TMP
                
                     ENDPARDO i, i1, kk1, a

                     PARDO j, j1, kk1, b
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                           REQUEST R2bb_b_HIST(b,j,kk1,j1,MINDEX50)  j1

                           Tbjkj(b,j,kk1,j1)  = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                           T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,MINDEX50)
                        
                           TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)
                           SUMBBB += TMP

                     ENDPARDO j, j1, kk1, b

                     PARDO a, i, kk1, j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                           REQUEST R2aa_b_HIST(a,i,kk1,j,MINDEX50)  j
            
                           Taikj(a,i,kk1,j)  = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
                           T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,MINDEX50)
                              
                           TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)
                           SUMAAB += TMP
    
                     ENDPARDO a, i, kk1, j

                     PARDO j, i, kk1, b
                           REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                           REQUEST R2bb_a_HIST(b,j,kk1,i,MINDEX50)  i
                
                           Tbjki(b,j,kk1,i)  = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
                           T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,MINDEX50)
        
                           TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)
                           SUMBBA += TMP
    
                     ENDPARDO j, i, kk1, b
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

#bgn_debug
     execute print_static etemp  iter_count 
#end_debug

     ENDPROC C_CHECK
#    ---------------

#     BEGIN MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO = 0.0
     ONE  = 1.0
     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC

#
      CALL READ_DATA
      CALL CREATE_ARRAYS 

# The default denominator is 1P-Hbar and can be switched to Hbar
     
      CALL FORM_1HHP_DIAG
      IF EOM_DENOM == ONE
         CALL FORM_12HHP_DIAG
      ENDIF

      CALL FORM_INITIAL_GUESS 

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC

      ROOT_COUNT = 0.0
      DO NROOTS

         ROOT_COUNT += 1.0
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
         MYROOT = ROOT_COUNT 
         CALL PREP_IP_GUESS 
      
         ITER_COUNT = 0.0

         DO SUBSP_DIM

            CALL SET_TO_ZERO

            ITER_COUNT += 1.0
#bgn_debug
        execute print_scalar ITER_COUNT
#end_debug
            IF ITER_COUNT > MAX_SUBSP_DIM 
               EXIT
            ENDIF 

            CALL SAVE_C_VECTORS 
#bgn_debug
#            call c_check 
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS 

            IF ITER_COUNT == 1.0
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
           IF ITER_COUNT != 1.0
              CALL REORDER_A_EIGS
           ENDIF 
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal. 
#
           IF ITER_COUNT == 1.0
              CALL FORM_NEWVECS_ITR1
           ELSE

              CALL FORM_NEWVECS 

              CALL SELECT_VECS

              CALL FORM_SELECTED_Y
         
              CALL FORM_HBAR_Y_VECS

              CALL FORM_RESIDUAL_VEC

              CALL CHECK_CONVERGENCE
#bgn_debug
      execute print_scalar RESIDUAL_NORM
#end_debug
              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ENDIF 

              CALL FORM_CORRECTION_VEC

              CALL DRIVE_ORTHO
         
              CALL RESCALE_NEW_C

           ENDIF 

         ENDDO SUBSP_DIM

         EXECUTE SERVER_BARRIER 
#bgn_debug
      execute print_scalar OMEGA 
#end_debug

         IF ITER_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means
#
                OMEGA = 0.0
             ENDIF 
          ENDIF 
             
#         DO kk1
            MCOUNT = 0.0
            DO MROOTS
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  EOM_IPS(MROOTS) = OMEGA
               ENDIF 
            ENDDO MROOTS
#         ENDDO kk1

      ENDDO NROOTS 

      EXECUTE SERVER_BARRIER 

      PRINT_FLAG = 60.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG EOM_IPS
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO WARNING DUMMY

#bgn_debug
      ROOT_COUNT -= 1.0
      execute print_static EOM_IPS ROOT_COUNT 
#end_debug

                           ENDSIAL IP_EOMCCSD
#                          ------------------


