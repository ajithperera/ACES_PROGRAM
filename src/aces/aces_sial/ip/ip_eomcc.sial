     ENDPROC FORM_CORRECTION_VEC
#     ---------------------------

     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF  

           PARDO i, kk1

                 GET R1A_HIST(i,kk1,NINDEX50)
                 GET CORR_VECa(i,kk1)
                 
                 Tikk(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
                 T1ikk(i,kk1) = CORR_VECa(i,kk1)
                 TMP          = Tikk(i,kk1) *  T1ikk(i,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 
                 
           ENDPARDO i, kk1

           PARDO j, kk1

                 GET R1B_HIST(j,kk1,NINDEX50)
                 GET CORR_VECb(j,kk1)

                 Tjkk(j,kk1)  = R1B_HIST(j,kk1,NINDEX50)
                 T1jkk(j,kk1) = CORR_VECb(j,kk1)
                 TMP          = Tjkk(j,kk1) *  T1jkk(j,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, kk1

           PARDO i, i1, kk1, a

                 REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
                 GET CORR_VECaa_a(a,i,kk1,i1)

                 Taiki(a,i,kk1,i1)  = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
                 T1aiki(a,i,kk1,i1) = CORR_VECaa_a(a,i,kk1,i1)

                 TMP     = Taiki(a,i,kk1,i1) * T1aiki(a,i,kk1,i1) 

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, i1, kk1, a

           PARDO j, j1, kk1, b

                 REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
                 GET CORR_VECbb_b(b,j,kk1,j1)

                 Tbjkj(b,j,kk1,j1)  = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
                 T1bjkj(b,j,kk1,j1) = CORR_VECbb_b(b,j,kk1,j1)
                        
                 TMP     = Tbjkj(b,j,kk1,j1) *  T1bjkj(b,j,kk1,j1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, j1, kk1, b

           PARDO i, a, kk1, j

                 REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
                 GET CORR_VECaa_b(a,i,kk1,j)

                 Taikj(a,i,kk1,j)  = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
                 T1aikj(a,i,kk1,j) = CORR_VECaa_b(a,i,kk1,j)
                        
                 TMP     = Taikj(a,i,kk1,j) * T1aikj(a,i,kk1,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, a, kk1, j

           PARDO j, i, kk1, b

                 REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
                 GET CORR_VECbb_a(b,j,kk1,i)

                 Tbjki(b,j,kk1,i)  = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
                 T1bjki(b,j,kk1,i) = CORR_VECbb_a(b,j,kk1,i)

                 TMP   = Tbjki(b,j,kk1,i) * T1bjki(b,j,kk1,i)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO j, i, kk1, b

#        ENDIF 
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT 
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     C_A    = 0.0
     C_B    = 0.0
     C_AAA  = 0.0
     C_BBB  = 0.0
     C_AAB  = 0.0
     C_BBA  = 0.0

     PARDO i, kk1
           GET CORR_VECa(i,kk1)
           Tikk(i,kk1)   = CORR_VECa(i,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
   
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET R1A_HIST(i,kk1,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ikk(i,kk1)  = R1A_HIST(i,kk1,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ikk(i,kk1) *= FACT
              T1ikk(i,kk1) *= -1.0
              Tikk(i,kk1)  += T1ikk(i,kk1)

           ENDDO NINDEX50

           PUT R1a_INTMD(i,kk1) = Tikk(i,kk1)

           TMP    = Tikk(i,kk1) * Tikk(i,kk1)
           SUMA  += TMP
                 
     ENDPARDO i, kk1

     PARDO j, kk1
          GET CORR_VECb(j,kk1)
          Tjkk(j,kk1)  = CORR_VECb(j,kk1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             GET R1B_HIST(j,kk1,NINDEX50)
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1jkk(j,kk1) = R1B_HIST(j,kk1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1jkk(j,kk1) *= FACT
             T1jkk(j,kk1) *= -1.0
             Tjkk(j,kk1)  += T1jkk(j,kk1) 

          ENDDO NINDEX50
                     
          PUT R1b_INTMD(j,kk1) = Tjkk(j,kk1)
                 
          TMP   = Tjkk(j,kk1) * Tjkk(j,kk1) 
          SUMB += TMP

     ENDPARDO j, kk1

     PARDO i, i1, kk1, a
          GET CORR_VECaa_a(a,i,kk1,i1)
          Taiki(a,i,kk1,i1)  = CORR_VECaa_a(a,i,kk1,i1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2aa_a_HIST(a,i,kk1,i1,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1aiki(a,i,kk1,i1) = R2aa_a_HIST(a,i,kk1,i1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                 
             EXECUTE RETURN_SVAL Txx FACT

             T1aiki(a,i,kk1,i1)  *= FACT
             T1aiki(a,i,kk1,i1)  *= -1.0
             Taiki(a,i,kk1,i1)   += T1aiki(a,i,kk1,i1)

           ENDDO NINDEX50

           PUT R2aa_a_intmd(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

           TMP  =  Taiki(a,i,kk1,i1) *  Taiki(a,i,kk1,i1)
           SUMAAA  += TMP

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

           GET CORR_VECbb_b(b,j,kk1,j1)
           Tbjkj(b,j,kk1,j1)  = CORR_VECbb_b(b,j,kk1,j1)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2bb_b_HIST(b,j,kk1,j1,NINDEX50) j1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bjkj(b,j,kk1,j1) = R2bb_b_HIST(b,j,kk1,j1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT
                 
             T1bjkj(b,j,kk1,j1) *= FACT
             T1bjkj(b,j,kk1,j1) *= -1.0
             Tbjkj(b,j,kk1,j1) += T1bjkj(b,j,kk1,j1)

           ENDDO NINDEX50
                
          PUT R2bb_b_intmd(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)

          TMP = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
          SUMBBB += TMP
                 
     ENDPARDO j, j1, kk1, b

     PARDO i, a, kk1, j
           GET CORR_VECaa_b(a,i,kk1,j)
           Taikj(a,i,kk1,j)  = CORR_VECaa_b(a,i,kk1,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              REQUEST R2aa_b_HIST(a,i,kk1,j,NINDEX50) j
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1aikj(a,i,kk1,j) = R2aa_b_HIST(a,i,kk1,j,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                
              EXECUTE RETURN_SVAL Txx FACT
                       
              T1aikj(a,i,kk1,j) *= FACT
              T1aikj(a,i,kk1,j) *= -1.0
              Taikj(a,i,kk1,j)  += T1aikj(a,i,kk1,j)

          ENDDO NINDEX50

          PUT R2aa_b_intmd(a,i,kk1,j) = Taikj(a,i,kk1,j)

          TMP =  Taikj(a,i,kk1,j) *  Taikj(a,i,kk1,j)
          SUMAAB += TMP

     ENDPARDO i, a, kk1, j

     PARDO j, i, kk1, b
           GET CORR_VECbb_a(b,j,kk1,i)
           Tbjki(b,j,kk1,i)  = CORR_VECbb_a(b,j,kk1,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
  
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2bb_a_HIST(b,j,kk1,i,NINDEX50) i
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bjki(b,j,kk1,i) = R2bb_a_HIST(b,j,kk1,i,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT

             T1bjki(b,j,kk1,i) *= FACT
             T1bjki(b,j,kk1,i) *= -1.0
             Tbjki(b,j,kk1,i)  += T1bjki(b,j,kk1,i)

          ENDDO NINDEX50

          PUT R2bb_a_intmd(b,j,kk1,i) = Tbjki(b,j,kk1,i)

          TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i)
          SUMBBA += TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SERVER_BARRIER 
     COLLECTIVE   C_A   += SUMA 
     COLLECTIVE   C_B   += SUMB
     COLLECTIVE   C_AAA += SUMAAA
     COLLECTIVE   C_BBB += SUMBBB
     COLLECTIVE   C_AAB += SUMAAB
     COLLECTIVE   C_BBA += SUMBBA

     EXECUTE SIP_BARRIER 

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_B
     NORM_NEW_ORTGC += C_AAA
     NORM_NEW_ORTGC += C_BBB
     NORM_NEW_ORTGC += C_AAB
     NORM_NEW_ORTGC += C_BBA

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------
    
     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT 

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0

     PARDO i, kk1

            GET  R1a_intmd(i,kk1)
            Tikk(i,kk1) = R1a_intmd(i,kk1)
            TMP   = Tikk(i,kk1) * Tikk(i,kk1)
            HC_A += TMP

      ENDPARDO i, kk1

      PARDO j, kk1

            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1) =  R1b_intmd(j,kk1)
            TMP   = Tjkk(j,kk1) * Tjkk(j,kk1)
            HC_B += TMP

      ENDPARDO j, kk1

      PARDO i, i1, kk1, a

              GET R2aa_a_intmd(a,i,kk1,i1) 
              Taiki(a,i,kk1,i1) = R2aa_a_intmd(a,i,kk1,i1)

              TMP   = Taiki(a,i,kk1,i1) * Taiki(a,i,kk1,i1)
              HC_AAA += TMP

      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b

              GET R2bb_b_intmd(b,j,kk1,j1)
              Tbjkj(b,j,kk1,j1) = R2bb_b_intmd(b,j,kk1,j1)

              TMP   = Tbjkj(b,j,kk1,j1) * Tbjkj(b,j,kk1,j1)
              HC_BBB +=  TMP
              
     ENDPARDO j, j1, kk1, b

     PARDO i, j, kk1, a

              GET R2aa_b_intmd(a,i,kk1,j) 
              Taikj(a,i,kk1,j) = R2aa_b_intmd(a,i,kk1,j)

              TMP   = Taikj(a,i,kk1,j) * Taikj(a,i,kk1,j)
              HC_AAB +=  TMP

     ENDPARDO i, j, kk1, a

     PARDO j, i, kk1, b

              GET R2bb_a_intmd(b,j,kk1,i) 
              Tbjki(b,j,kk1,i) = R2bb_a_intmd(b,j,kk1,i)  

              TMP = Tbjki(b,j,kk1,i) * Tbjki(b,j,kk1,i) 
              HC_BBA +=  TMP

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT
     
     EXECUTE SIP_BARRIER 
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     DO kk1
        DO i
           GET R1a_intmd(i,kk1)

           Tikk(i,kk1)  = R1a_intmd(i,kk1)
           Tikk(i,kk1) *= INV_SQRT_NORM_ORTGC

           PUT R1a(i,kk1) =  Tikk(i,kk1)

         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET R1b_intmd(j,kk1)

            Tjkk(j,kk1)  = R1b_intmd(j,kk1)
            Tjkk(j,kk1) *= INV_SQRT_NORM_ORTGC

            PUT R1b(j,kk1) =  Tjkk(j,kk1)

         ENDDO j
     ENDDO kk1

    PARDO i, i1, kk1, a
         
         GET R2aa_a_intmd(a,i,kk1,i1)

         Taiki(a,i,kk1,i1)  = R2aa_a_intmd(a,i,kk1,i1)
         Taiki(a,i,kk1,i1) *= INV_SQRT_NORM_ORTGC

         PUT R2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

         GET R2bb_b_intmd(b,j,kk1,j1)

         Tbjkj(b,j,kk1,j1)  = R2bb_b_intmd(b,j,kk1,j1)
         Tbjkj(b,j,kk1,j1) *= INV_SQRT_NORM_ORTGC

         PUT R2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1) 

     ENDPARDO j, j1, kk1, b

     PARDO a, i, kk1, j

        GET R2aa_b_intmd(a,i,kk1,j)

        Taikj(a,i,kk1,j)  =  R2aa_b_intmd(a,i,kk1,j)
        Taikj(a,i,kk1,j) *= INV_SQRT_NORM_ORTGC

        PUT R2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)

     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b

        GET R2bb_a_intmd(b,j,kk1,i) 

        Tbjki(b,j,kk1,i)  = R2bb_a_intmd(b,j,kk1,i)
        Tbjki(b,j,kk1,i) *= INV_SQRT_NORM_ORTGC

        PUT R2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,kk1
#         get r1a(i,kk1)
#         tmp = r1a(i,kk1) * r1a(i,kk1)
#         tmpa += tmp
#      endpardo i,kk1
#      pardo j,kk1
#         get r1b(j,kk1)
#         tmp = r1b(j,kk1) * r1b(j,kk1)
#         tmpb += tmp
#      endpardo j,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute print_scalar suma
#      execute print_scalar sumb
#      sumab  = suma
#      sumab += sumb
