#         request Wjjjb(j2,j,j1,b) j
#         tmp = Wjjjb(j2,j,j1,b) * Wjjjb(j2,j,j1,b)
#         tmpb += tmp
#      endpardo j, b, j1, j2
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
      PARDO j, a, i1, j2
            DO kk1
               REQUEST            Wjjia(j2,j,i1,a) j
               GET                R2aa_b(a,i1,kk1,j2)
               tjx(j,kk1)       = R2aa_b(a,i1,kk1,j2)*Wjjia(j2,j,i1,a)
               tjx(j,kk1)      *= -1.0
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, a, i1, j2
#
      PARDO j, j1, b
            DO kk1
               GET                Ujb(j1,b)
               GET                R2bb_b(b,j1,kk1,j)
               tjx(j,kk1)       = R2bb_b(b,j1,kk1,j)*Ujb(j1,b)
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, j1, b
#
      PARDO j, i1, a
            DO kk1
               GET                Uia(i1,a)
               GET                R2aa_b(a,i1,kk1,j)
               tjx(j,kk1)       = R2aa_b(a,i1,kk1,j)*Uia(i1,a)
               PUT HR1b(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, i1, a
#bgn_debug
#      execute sip_barrier 
#      sumb=0.0
#      tmpb=0.0
#      pardo j,kk1
#         get hr1b(j,kk1)
#         tmp = hr1b(j,kk1) * hr1b(j,kk1)
#         tmpb += tmp
#      endpardo j,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
# (HR)^a_{i,i1)
# -------------
#
      PARDO i, i1, a, i2
            DO kk1
               REQUEST                   Wiiai(i2,i,a,i1) i
               GET                       R1a(i2,kk1)
               taixi(a,i1,kk1,i)       = Wiiai(i2,i,a,i1)*R1a(i2,kk1)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO i, i1, a, i2
#
      PARDO a, i1, i, i2
            DO kk1
               GET                       Uii(i2,i1)
               GET                       R2aa_a(a,i2,kk1,i)
               taixi(a,i1,kk1,i)       = R2aa_a(a,i2,kk1,i)*Uii(i2,i1)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO a, i1, i, i2
#
      PARDO i, i1, a, i2
            DO kk1
               GET                       Uii(i2,i)
               GET                       R2aa_a(a,i1,kk1,i2)
               taixi(a,i1,kk1,i)       = R2aa_a(a,i1,kk1,i2)*Uii(i2,i)
               taixi(a,i1,kk1,i)      *= -1.0
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO i, i1, a, i2
#
      PARDO a, i, i1, a1
            DO kk1
               GET                       R2aa_a(a1,i1,kk1,i)
               GET                       Uaa(a,a1)
               taixi(a,i1,kk1,i)       = R2aa_a(a1,i1,kk1,i)*Uaa(a,a1)
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
      ENDPARDO a, i, i1, a1

      PARDO i, i1, i2, i3
            REQUEST             Wiiii(i2,i,i3,i1) i2
            Tiiii(i3,i1,i2,i) = Wiiii(i2,i,i3,i1)
            DO a
            DO kk1
               GET                        R2aa_a(a,i3,kk1,i2)
               taixi(a,i1,kk1,i)        = R2aa_a(a,i3,kk1,i2)*Tiiii(i3,i1,i2,i)  
               taixi(a,i1,kk1,i)       *= 0.5
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
            ENDDO kk1
            ENDDO a
      ENDPARDO i, i1, i2, i3
#
      PARDO i1, a, a1, i2
            REQUEST Wiaai(i2,a1,a,i1) a1
            DO i
            DO kk1
               GET                        R2aa_a(a1,i2,kk1,i)
               taixi(a,i1,kk1,i)        = R2aa_a(a1,i2,kk1,i)*Wiaai(i2,a1,a,i1)  
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)       = taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)      *= -1.0
               PUT HR2aa_a(a,i,kk1,i1) += t1aixi(a,i,kk1,i1)
            ENDDO kk1
            ENDDO i
      ENDPARDO i1, a, a1, i2
#
      PARDO i1, a, b1, j2
            REQUEST Wjbai(j2,b1,a,i1) b1
            DO i
            DO kk1
               GET                        R2bb_a(b1,j2,kk1,i)
               taixi(a,i1,kk1,i)        = R2bb_a(b1,j2,kk1,i)*Wjbai(j2,b1,a,i1)  
               PUT HR2aa_a(a,i1,kk1,i) += taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)       = taixi(a,i1,kk1,i)
               t1aixi(a,i,kk1,i1)      *= -1.0
               PUT HR2aa_a(a,i,kk1,i1) += t1aixi(a,i,kk1,i1)
            ENDDO kk1
            ENDDO i
      ENDPARDO i1, a, b1, j2
#
# (HR)^b_{j,j1)
# -------------
#
      PARDO j, j1, b, j2
            DO kk1
               REQUEST                   Wjjbj(j2,j,b,j1) j
               GET                       R1b(j2,kk1)
               tbjxj(b,j1,kk1,j)       = Wjjbj(j2,j,b,j1)*R1b(j2,kk1)
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO j, j1, b, j2
#
      PARDO b, j1, j, j2
            DO kk1
               GET                       Ujj(j2,j1)
               GET                       R2bb_b(b,j2,kk1,j)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b,j2,kk1,j)*Ujj(j2,j1)
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO b, j1, j, j2
#
      PARDO j, j1, b, j2
            DO kk1
               GET                       Ujj(j2,j)
               GET                       R2bb_b(b,j1,kk1,j2)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b,j1,kk1,j2)*Ujj(j2,j)           
               tbjxj(b,j1,kk1,j)      *= -1.0
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO j, j1, b, j2
#
      PARDO b, j, j1, b1
            DO kk1
               GET                       R2bb_b(b1,j1,kk1,j)
               GET                       Ubb(b,b1)
               tbjxj(b,j1,kk1,j)       = R2bb_b(b1,j1,kk1,j)*Ubb(b,b1)
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
      ENDPARDO b, j, j1, b1
      PARDO j, j1, j2, j3
            REQUEST Wjjjj(j2,j,j3,j1) j2
            tjjjj(j3,j1,j2,j) = Wjjjj(j2,j,j3,j1)
            DO b
            DO kk1
               GET                        R2bb_b(b,j3,kk1,j2)
               tbjxj(b,j1,kk1,j)        = R2bb_b(b,j3,kk1,j2)*tjjjj(j3,j1,j2,j)  
               tbjxj(b,j1,kk1,j)       *= 0.5
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
            ENDDO kk1
            ENDDO b
      ENDPARDO j, j1, j2, j3
#
      PARDO j1, b, b1, j2
            REQUEST Wjbbj(j2,b1,b,j1) b1
            DO j
            DO kk1
               GET                        R2bb_b(b1,j2,kk1,j)
               tbjxj(b,j1,kk1,j)        = R2bb_b(b1,j2,kk1,j)*Wjbbj(j2,b1,b,j1)  
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)       = tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)      *= -1.0
               PUT HR2bb_b(b,j,kk1,j1) += t1bjxj(b,j,kk1,j1)
            ENDDO kk1
            ENDDO j
      ENDPARDO j1, b, b1, j2
#
      PARDO j1, b, a1, i2
            REQUEST Wiabj(i2,a1,b,j1) a1
            DO j
            DO kk1
               GET                        R2aa_b(a1,i2,kk1,j)
               tbjxj(b,j1,kk1,j)        = R2aa_b(a1,i2,kk1,j)*Wiabj(i2,a1,b,j1)  
               PUT HR2bb_b(b,j1,kk1,j) += tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)       = tbjxj(b,j1,kk1,j)
               t1bjxj(b,j,kk1,j1)      *= -1.0
               PUT HR2bb_b(b,j,kk1,j1) += t1bjxj(b,j,kk1,j1)
            ENDDO kk1
            ENDDO j
      ENDPARDO j1, b, a1, i2
#
# (HR)^a_{i,j)
# ------------
#
      PARDO a, j, i, j1
            DO kk1
               REQUEST                   Wjjai(j1,j,a,i) a
               GET                       R1b(j1,kk1)
               taixj(a,i,kk1,j)        = Wjjai(j1,j,a,i)*R1b(j1,kk1)
               taixj(a,i,kk1,j)       *= -1.0
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
      ENDPARDO a, j, i, j1
#bgn_debug
#      execute sip_barrier
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,kk1
#            get HR2aa_b(a,i1,kk1,j)
#            tmp = HR2aa_b(a,i1,kk1,j) * HR2aa_b(a,i1,kk1,j)
#            tmpa+= tmp
#      endpardo j,i1,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
##end_debug
#
      PARDO j, a, i1
            DO kk1
               GET R2aa_b(a,i1,kk1,j)
               DO i
                  GET                       Uii(i1,i)
                  taixj(a,i,kk1,j)        = R2aa_b(a,i1,kk1,j)*Uii(i1,i)
                  taixj(a,i,kk1,j)       *= -1.0
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO i
            ENDDO kk1
      ENDPARDO j, a, i1
#
      PARDO a, i, j1
            DO kk1
               GET R2aa_b(a,i,kk1,j1)
               DO j
                  GET                       Ujj(j1,j)
                  taixj(a,i,kk1,j)        = R2aa_b(a,i,kk1,j1)*Ujj(j1,j)
                  taixj(a,i,kk1,j)       *= -1.0
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO j
            ENDDO kk1
      ENDPARDO a, i, j1
#
      PARDO i, j, a1
            DO kk1
               GET R2aa_b(a1,i,kk1,j)
               DO a
                  GET                       Uaa(a,a1)
                  taixj(a,i,kk1,j)        = R2aa_b(a1,i,kk1,j)*Uaa(a,a1)
                  PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
               ENDDO a
            ENDDO kk1
      ENDPARDO i, j, a1
#
      PARDO i, j, j1, i1
            REQUEST Wiijj(i1,i,j1,j) i1
            DO a
            DO kk1
               GET                       R2aa_b(a,i1,kk1,j1)
               taixj(a,i,kk1,j)        = R2aa_b(a,i1,kk1,j1)*Wiijj(i1,i,j1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO a
      ENDPARDO i, j, j1, i1
#
      PARDO i, a, j1, b
            REQUEST Wjbai(j1,b,a,i) b
            DO j
            DO kk1
               GET                       R2bb_b(b,j1,kk1,j)
               taixj(a,i,kk1,j)        = Wjbai(j1,b,a,i)*R2bb_b(b,j1,kk1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO j
      ENDPARDO i, a, j1, b
#
      PARDO i, a, i1, a1
            REQUEST Wiaai(i1,a1,a,i) a1
            DO j
            DO kk1
               GET                       R2aa_b(a1,i1,kk1,j)
               taixj(a,i,kk1,j)        = Wiaai(i1,a1,a,i)*R2aa_b(a1,i1,kk1,j)
               PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
            ENDDO kk1
            ENDDO j
      ENDPARDO i, a, i1, a1
#bgn_debug
#      execute sip_barrier
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,kk1
#            get HR2aa_b(a,i1,kk1,j)
#            tmp = HR2aa_b(a,i1,kk1,j) * HR2aa_b(a,i1,kk1,j)
#            tmpa+= tmp
#      endpardo j,i1,a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
# (HR)^b_{j,i) 
# ------------ 
#
      PARDO b, i, j, i1
            DO kk1
               REQUEST                   Wiibj(i1,i,b,j) b
               GET                       R1a(i1,kk1)
               tbjxi(b,j,kk1,i)        = Wiibj(i1,i,b,j)*R1a(i1,kk1)
               tbjxi(b,j,kk1,i)       *= -1.0
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
      ENDPARDO b, i, j, i1
#bgn_debug
#      execute sip_barrier
#      tmpb =0.0
#      sumb =0.0
#      pardo i,j1,b,kk1
#            get HR2bb_a(b,j1,kk1,i)
#            tmp = HR2bb_a(b,j1,kk1,i) * HR2bb_a(b,j1,kk1,i)
#            tmpb+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug
#
      PARDO i, b, j1
            DO kk1
               GET R2bb_a(b,j1,kk1,i)
               DO j
                  GET                       Ujj(j1,j)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b,j1,kk1,i)*Ujj(j1,j)
                  tbjxi(b,j,kk1,i)       *= -1.0
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO j
            ENDDO kk1
      ENDPARDO i, b, j1
#
      PARDO b, j, i1
            DO kk1
               GET R2bb_a(b,j,kk1,i1)
               DO i
                  GET                       Uii(i1,i)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b,j,kk1,i1)*Uii(i1,i)
                  tbjxi(b,j,kk1,i)       *= -1.0
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO i
            ENDDO kk1
      ENDPARDO b, j, i1
#
      PARDO j, i, b1
            DO kk1
               GET R2bb_a(b1,j,kk1,i)
               DO b
                  GET                       Ubb(b,b1)
                  tbjxi(b,j,kk1,i)        = R2bb_a(b1,j,kk1,i)*Ubb(b,b1)
                  PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
               ENDDO b
            ENDDO kk1
      ENDPARDO j, i, b1
#
      PARDO i, j, j1, i1
            REQUEST            Wiijj(i1,i,j1,j) i1
            tjjii(j1,j,i1,i) = Wiijj(i1,i,j1,j)
            DO b
            DO kk1
               GET                       R2bb_a(b,j1,kk1,i1)
               tbjxi(b,j,kk1,i)        = R2bb_a(b,j1,kk1,i1)*tjjii(j1,j,i1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO b
      ENDPARDO i, j, j1, i1
#
      PARDO j, b, i1, a
            REQUEST Wiabj(i1,a,b,j) a
            DO i
            DO kk1
               GET                       R2aa_a(a,i1,kk1,i)
               tbjxi(b,j,kk1,i)        = Wiabj(i1,a,b,j)*R2aa_a(a,i1,kk1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO i
      ENDPARDO j, b, i1, a
#
      PARDO j, b, j1, b1
            REQUEST Wjbbj(j1,b1,b,j) b1
            DO i
            DO kk1
               GET                       R2bb_a(b1,j1,kk1,i)
               tbjxi(b,j,kk1,i)        = Wjbbj(j1,b1,b,j)*R2bb_a(b1,j1,kk1,i)
               PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
            ENDDO kk1
            ENDDO i
      ENDPARDO j, b, j1, b1
#
      execute sip_barrier
#bgn_debug
#      execute sip_barrier
#      tmpb =0.0
#      sumb =0.0
#      pardo i,j1,b,kk1
#            get HR2bb_a(b,j1,kk1,i)
#            tmp = HR2bb_a(b,j1,kk1,i) * HR2bb_a(b,j1,kk1,i)
#            tmpb+= tmp
#      endpardo i,j1,b,kk1
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar sumb
#end_debug

#
      PARDO a1, a, i1, i
         DO kk1
            REQUEST                     T2aa(a1,i1,a,i) a1
            GET                         Iax(a,kk1)
            taixi(a1,i1,kk1,i)        = T2aa(a1,i1,a,i)*Iax(a,kk1)
            taixi(a1,i1,kk1,i)       *= -1.0
            PUT HR2aa_a(a1,i1,kk1,i) += taixi(a1,i1,kk1,i)
         ENDDO kk1
      ENDPARDO a1, a, i1, i
#
      PARDO b1, a, j1, i
         DO kk1
            REQUEST                     T2ab(a,i,b1,j1) b1
            GET                         Iax(a,kk1)
            tbjxi(b1,j1,kk1,i)        = T2ab(a,i,b1,j1)*Iax(a,kk1)
            tbjxi(b1,j1,kk1,i)       *= -1.0
            PUT HR2bb_a(b1,j1,kk1,i) += tbjxi(b1,j1,kk1,i)
         ENDDO kk1
      ENDPARDO b1, a, j1, i
#
      PARDO b1, b, j1, j
         DO kk1
            REQUEST                     T2bb(b1,j1,b,j) b1
            GET                         Ibx(b,kk1)
            tbjxj(b1,j1,kk1,j)        = T2bb(b1,j1,b,j)*Ibx(b,kk1)
            tbjxj(b1,j1,kk1,j)       *= -1.0
            PUT HR2bb_b(b1,j1,kk1,j) += tbjxj(b1,j1,kk1,j)
         ENDDO kk1
      ENDPARDO b1, b, j1, j
#
      PARDO a1, b, i1, j
         DO kk1
            REQUEST                     T2ab(a1,i1,b,j) a1
            GET                         Ibx(b,kk1)
            taixj(a1,i1,kk1,j)        = T2ab(a1,i1,b,j)*Ibx(b,kk1)
            taixj(a1,i1,kk1,j)       *= -1.0
            PUT HR2aa_b(a1,i1,kk1,j) += taixj(a1,i1,kk1,j)
         ENDDO kk1
      ENDPARDO a1, b, i1, j

      PARDO b, b1, i, i1
          REQUEST                   Wiibb(i1,i,b,b1) b
          DO j
          DO kk1
             GET                       R2bb_a(b1,j,kk1,i1)
             tbjxi(b,j,kk1,i)        = R2bb_a(b1,j,kk1,i1)*Wiibb(i1,i,b,b1)
            #tbjxi(b,j,kk1,i)       *= -1.0
             PUT HR2bb_a(b,j,kk1,i) += tbjxi(b,j,kk1,i)
          ENDDO kk1
          ENDDO j
      ENDPARDO b, b1, i, i1
#
      PARDO a, a1, j, j1
          REQUEST                   Wjjaa(j1,j,a,a1) a
          DO i 
          DO kk1
             GET                       R2aa_b(a1,i,kk1,j1)
             taixj(a,i,kk1,j)        = R2aa_b(a1,i,kk1,j1)*Wjjaa(j1,j,a,a1)
            #taixj(a,i,kk1,j)       *= -1.0
             PUT HR2aa_b(a,i,kk1,j) += taixj(a,i,kk1,j)
          ENDDO kk1
          ENDDO i
      ENDPARDO a, a1, j, j1
#
      execute server_barrier
      delete Iax
      delete Ibx

#      PARDO a, i, i1, kk1
#
#            IF i == i1
#
#              GET HR2aa_a_I(a,i,kk1,i1) 
#               taixi(a,i,kk1,i1) = HR2aa_a_I(a,i,kk1,i1)  
#               execute symm_force_i taixi(a,i,kk1,i1)
#
#               PUT HR2aa_a(a,i,kk1,i1)  += taixi(a,i,kk1,i1)
#            ENDIF 
#           
#            IF i < i1
#               GET HR2aa_a_I(a,i,kk1,i1) 
#               taixi(a,i,kk1,i1) = HR2aa_a_I(a,i,kk1,i1)  
#               t1aixi(a,i1,kk1,i) = taixi(a,i,kk1,i1)
#               t1aixi(a,i1,kk1,i) *= -1.0
#
#               PUT HR2aa_a(a,i1,kk1,i)  += t1aixi(a,i1,kk1,i)
#            ENDIF 
#
#      ENDPARDO a, i, i1, kk1
#
#      PARDO b, j1, j, kk1
#
#
#            IF j == j1
#               
#               GET HR2bb_b_I(b,j1,kk1,j) 
#               tbjxj(b,j1,kk1,j) = HR2bb_b_I(b,j1,kk1,j) 
#               execute symm_force_i tbjxj(b,j1,kk1,j)
#
#               PUT HR2bb_b(b,j1,kk1,j)  += tbjxj(b,j1,kk1,j)
#            ENDIF 
#  
#            IF j < j1
#
#               GET HR2bb_b_I(b,j1,kk1,j) 
#               tbjxj(b,j1,kk1,j) = HR2bb_b_I(b,j1,kk1,j) 
#               t1bjxj(b,j,kk1,j1)  = tbjxj(b,j1,kk1,j)
#               t1bjxj(b,j,kk1,j1) *= -1.0
#
#               PUT HR2bb_b(b,j,kk1,j1)  = t1bjxj(b,j,kk1,j1)
#            ENDIF 
#
#      ENDPARDO b, j1, j, kk1
#
#      EXECUTE SERVER_BARRIER 
#
#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,kk1
#         get hr1a(i,kk1)
#         tmp = hr1a(i,kk1) * hr1a(i,kk1)
