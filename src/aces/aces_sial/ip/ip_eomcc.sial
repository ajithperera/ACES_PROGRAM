     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO kk1, i
         GET Y1a_PICKED(i,kk1)
         Tikk(i,kk1) = Y1a_PICKED(i,kk1)
         PUT R1a(i,kk1) =  Tikk(i,kk1)
      ENDPARDO kk1, i

      PARDO kk1, j
         GET Y1b_PICKED(j,kk1)
         Tjkk(j,kk1) = Y1b_PICKED(j,kk1)
         PUT R1b(j,kk1) =  Tjkk(j,kk1)
      ENDPARDO kk1, j

      PARDO i, i1, kk1, a
         GET Y2aa_a_picked(a,i,kk1,i1) 
         Taiki(a,i,kk1,i1) = Y2aa_a_picked(a,i,kk1,i1) 
         PUT R2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)
      ENDPARDO i, i1, kk1, a

      PARdO j, j1, kk1, b
         GET Y2bb_b_picked(b,j1,kk1,j)
         Tbjkj(b,j1,kk1,j) = Y2bb_b_picked(b,j1,kk1,j)
         PUT R2bb_b(b,j1,kk1,j) = Tbjkj(b,j1,kk1,j)
      ENDPARDO j, j1, kk1, b

      PARDO a,i,kk1,j 
         GET Y2aa_b_picked(a,i,kk1,j)
         Taikj(a,i,kk1,j) = Y2aa_b_picked(a,i,kk1,j)
         PUT R2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)
      ENDPARDO a, i, kk1, j

      PARDO j, i, kk1, b
         GET Y2bb_a_picked(b,j,kk1,i)
         Tbjki(b,j,kk1,i) =  Y2bb_a_picked(b,j,kk1,i)
         PUT R2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)
      ENDPARDO j, i, kk1, b

      EXECUTE SIP_BARRIER 

      CALL HR_MULT

     PARDO kk1, i
            GET HR1a(i,kk1)
            Tikk(i,kk1) = HR1a(i,kk1)
            PUT HY1a_picked(i,kk1) =  Tikk(i,kk1)
     ENDPARDO kk1,i

     PARDO kk1, j
            GET HR1b(j,kk1)
            Tjkk(j,kk1) = HR1b(j,kk1)
            PUT HY1b_picked(j,kk1) =  Tjkk(j,kk1)
      ENDPARDO kk1, j

      PARDO i, i1, kk1, a
         GET HR2aa_a(a,i1,kk1,i)
         Taiki(a,i1,kk1,i) = HR2aa_a(a,i1,kk1,i)
         PUT HY2aa_a_picked(a,i1,kk1,i) = Taiki(a,i1,kk1,i)
      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b
         GET HR2bb_b(b,j1,kk1,j)
         Tbjkj(b,j1,kk1,j) =  HR2bb_b(b,j1,kk1,j)
         PUT HY2bb_b_picked(b,j1,kk1,j) = Tbjkj(b,j1,kk1,j)
      ENDPARDO j, j1, kk1, b

      PARDO a,i,kk1,j
         GET HR2aa_b(a,i,kk1,j)
         Taikj(a,i,kk1,j) = HR2aa_b(a,i,kk1,j)
         PUT HY2aa_b_picked(a,i,kk1,j) = Taikj(a,i,kk1,j)
      ENDPARDO a, i, kk1, j

      PARDO j, i, kk1, b
         GET HR2bb_a(b,j,kk1,i)
         Tbjki(b,j,kk1,i) =  HR2bb_a(b,j,kk1,i) 
         PUT HY2bb_a_picked(b,j,kk1,i) = Tbjki(b,j,kk1,i)
      ENDPARDO j, i, kk1, b

      EXECUTE SIP_BARRIER
#bgn_debug
