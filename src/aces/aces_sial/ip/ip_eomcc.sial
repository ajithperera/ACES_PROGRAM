     PROC FORM_RESIDUAL_VEC
#    ----------------------

      EXECUTE RETURN_SELECTED A_DIAGS IMAX 
      OMEGA   = IMAX
      OMEGAM  = OMEGA
      OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug

     DO kk1
        DO i
           GET HY1a_picked(i,kk1)
           GET Y1a_picked(i,kk1)

           Tikk(i,kk1)   = HY1a_picked(i,kk1)
           T1ikk(i,kk1)  = Y1a_picked(i,kk1)
           T1ikk(i,kk1) *= Omegam
           Tikk(i,kk1)  +=  T1ikk(i,kk1) 
           PUT RES1a(i,kk1) =  Tikk(i,kk1)
         ENDDO i
     ENDDO kk1

     DO kk1
         DO j
            GET HY1b_picked(j,kk1)
            GET Y1b_picked(j,kk1)
            Tjkk(j,kk1)   = HY1b_picked(j,kk1)
            T1jkk(j,kk1)  = Y1b_picked(j,kk1)
            T1jkk(j,kk1) *= Omegam
            Tjkk(j,kk1)  += T1jkk(j,kk1)
            PUT RES1b(j,kk1) =  Tjkk(j,kk1)
         ENDDO j
     ENDDO kk1

     PARDO i, i1, kk1, a

         GET HY2aa_a_picked(a,i1,kk1,i)
         GET Y2aa_a_picked(a,i1,kk1,i)
         Taiki(a,i1,kk1,i)   = HY2aa_a_picked(a,i1,kk1,i)
         T1aiki(a,i1,kk1,i)  = Y2aa_a_picked(a,i1,kk1,i)
         T1aiki(a,i1,kk1,i) *= Omegam
         Taiki(a,i1,kk1,i)  += T1aiki(a,i1,kk1,i)
         PUT RES2aa_a(a,i1,kk1,i) = Taiki(a,i1,kk1,i)

     ENDPARDO i, i1, kk1, a

     PARDO j, j1, kk1, b

         GET HY2bb_b_picked(b,j,kk1,j1)
         GET Y2bb_b_picked(b,j,kk1,j1)
         Tbjkj(b,j,kk1,j1)   = HY2bb_b_picked(b,j,kk1,j1)
         T1bjkj(b,j,kk1,j1)  = Y2bb_b_picked(b,j,kk1,j1)
         T1bjkj(b,j,kk1,j1) *= Omegam
         Tbjkj(b,j,kk1,j1)  += T1bjkj(b,j,kk1,j1)
         PUT RES2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)

     ENDPARDO j, j1, kk1, b

     PARDO a,i,kk1,j
        GET HY2aa_b_picked(a,i,kk1,j)
        GET Y2aa_b_picked(a,i,kk1,j)

        Taikj(a,i,kk1,j)   = HY2aa_b_picked(a,i,kk1,j)
        T1aikj(a,i,kk1,j)  = Y2aa_b_picked(a,i,kk1,j)
        T1aikj(a,i,kk1,j) *= Omegam
        Taikj(a,i,kk1,j)  += T1aikj(a,i,kk1,j) 
        PUT RES2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)

     ENDPARDO a, i, kk1, j

     PARDO j, i, kk1, b
        GET HY2bb_a_picked(b,j,kk1,i)
        GET Y2bb_a_picked(b,j,kk1,i)

        Tbjki(b,j,kk1,i)   = HY2bb_a_picked(b,j,kk1,i)
        T1bjki(b,j,kk1,i)  = Y2bb_a_picked(b,j,kk1,i)
        T1bjki(b,j,kk1,i) *= Omegam
        Tbjki(b,j,kk1,i)  += T1bjki(b,j,kk1,i)
        PUT RES2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)

     ENDPARDO j, i, kk1, b

     EXECUTE SIP_BARRIER
#bgn_debug
