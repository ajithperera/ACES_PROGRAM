#
      PARDO b, j1, j
         DO kk1
            GET R2bb_b(b,j,kk1,j1)
            DO b1
               REQUEST            VSqjqj(b1,j1,b,j) b1
               tbx(b1,kk1)      = VSqjqj(b1,j1,b,j)*R2bb_b(b,j,kk1,j1)
               tbx(b1,kk1)     *= 0.5
               PUT Ibx(b1,kk1) += tbx(b1,kk1)
            ENDDO b1
         ENDDO kk1
      ENDPARDO b, j1, j
#
      PARDO a, j1, i
         DO kk1
            GET R2aa_b(a,i,kk1,j1)
            DO b1
               REQUEST            Vpiqj(a,i,b1,j1) b1
               tbx(b1,kk1)      = Vpiqj(a,i,b1,j1)*R2aa_b(a,i,kk1,j1)
               PUT Ibx(b1,kk1) += tbx(b1,kk1)
            ENDDO b1
         ENDDO kk1
      ENDPARDO a, j1, i
#bgn_debug
