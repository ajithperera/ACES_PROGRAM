# -----------------------------------------------------------

      PROC READ_DATA
#     --------------
#
      create t1a
      create t1b
      create Uaa
      create Ubb
      create Uii
      create Ujj
      create Uia
      create Ujb

      execute sip_barrier
      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vbbii
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
#
      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb
#
      execute list_to_blocks                Uaa
      execute list_to_blocks                Ubb
      execute list_to_blocks                Uii
      execute list_to_blocks                Ujj
      execute list_to_blocks                Uia
      execute list_to_blocks                Ujb
#
      execute list_to_blocks                Wiiii
      execute list_to_blocks                Wjjjj
      execute list_to_blocks                Wiijj
#
      execute list_to_blocks                Waiaa # HBAR_AIBC_aaaa
      execute list_to_blocks                Wbjbb # HBAR_AIBC_bbbb
      execute list_to_blocks                Waibb # HBAR_AIBC_aabb
      execute list_to_blocks                Wbjaa # HBAR_AIBC_bbaa
#
      execute list_to_blocks                Wiiia # HBAR_JKIA_aaaa
      execute list_to_blocks                Wjjjb # HBAR_JKIA_bbbb
      execute list_to_blocks                Wiijb # HBAR_JKIA_aabb
      execute list_to_blocks                Wjjia # HBAR_JKIA_bbaa
#
      execute list_to_blocks                Wiiai # HBAR_IAJK_aaaa
      execute list_to_blocks                Wiibj # HBAR_IAJK_aabb
      execute list_to_blocks                Wjjai # HBAR_IAJK_bbaa
      execute list_to_blocks                Wjjbj # HBAR_IAJK_bbbb
#
      execute list_to_blocks                Wiaai # HBAR_AJIB_aaaa
      execute list_to_blocks                Wjbbj # HBAR_AJIB_bbbb
      execute list_to_blocks                Wiabj # HBAR_AJIB_aabb
      execute list_to_blocks                Wjbai # HBAR_AJIB_BBAA
      execute list_to_blocks                Wiibb # HBAR_AJIB_iibb
      execute list_to_blocks                Wjjaa # HBAR_AJIB_jjaa
#
      execute list_to_blocks                Waaai # HBAR_ABCI_aaaa
      execute list_to_blocks                Wbbbj # HBAR_ABCI_bbbb
      execute list_to_blocks                Waabj # HBAR_ABCI_aabb
      execute list_to_blocks                Wbbai # HBAR_ABCI_bbaa
#
      execute server_barrier
      execute read_list_to_blocks
      execute server_barrier
#
      ENDPROC READ_DATA
#     -----------------

      PROC CREATE_ARRAYS
#     --------------------
#
      CREATE R1A
      CREATE R1B
      CREATE HR1A
      CREATE HR1B
      CREATE R1A_GUESS
      CREATE R1B_GUESS
      CREATE DDII
      CREATE DDJJ
      CREATE DDAA
      CREATE DDBB
      CREATE RAIXI
      CREATE RBJXJ
      CREATE RAIXJ
      CREATE RBJXI
      CREATE RI
      CREATE RJ
      CREATE INIT_RVEC_AA
      CREATE INIT_RVEC_BB
      CREATE R1A_HIST
      CREATE R1B_HIST
      CREATE HR1A_HIST
      CREATE HR1B_HIST
      CREATE R2aa_a
      CREATE R2bb_b
      CREATE R2aa_b
      CREATE R2bb_a
      CREATE HR2aa_a
      CREATE HR2bb_b
      CREATE HR2aa_b
      CREATE HR2bb_a
      CREATE Y1a
      CREATE Y1b
      CREATE Y1a_PICKED
      CREATE Y1b_PICKED
      CREATE Y2aa_a_PICKED
      CREATE Y2bb_b_PICKED
      CREATE Y2aa_b_PICKED
      CREATE Y2bb_a_PICKED
      CREATE HY1a_PICKED
      CREATE HY1b_PICKED
      CREATE HY2aa_a_PICKED
      CREATE HY2bb_b_PICKED
      CREATE HY2aa_b_PICKED
      CREATE HY2bb_a_PICKED
      CREATE RES1a
      CREATE RES1b
      CREATE RES2aa_a
      CREATE RES2bb_b
      CREATE RES2aa_b
      CREATE RES2bb_a
      CREATE CORR_VECa
      CREATE CORR_VECb
      CREATE CORR_VECaa_a
      CREATE CORR_VECbb_b
      CREATE CORR_VECaa_b
      CREATE CORR_VECbb_a
      CREATE ORTHO_COEF
      CREATE R1a_INTMD
      CREATE R1b_INTMD
      CREATE R2aa_a_INTMD
      CREATE R2bb_b_INTMD
      CREATE R2aa_b_INTMD
      CREATE R2bb_a_INTMD

      EXECUTE SIP_BARRIER 
#
      ENDPROC CREATE_ARRAYS
#     --------------------

      PROC FORM_INITIAL_GUESS
#     -----------------------
#
#  The Initial guess is form by fully solving the eigenvalue problem 
#   Hbar(i,k)R(k) =ER(i,p) (p=1,..n; n<= no. of occupied)
#
      DO i 
         DO i1
            IP_INIT_HAA(i,i1) = 0.0
         ENDDO i1
      ENDDO i

      DO j
         DO j1
            IP_INIT_HBB(j,j1) = 0.0
         ENDDO j1
      ENDDO j
      
      DO Ndim
         DO i
            VEC_AA(i,Ndim) = 0.0
         ENDDO i
      ENDDO Ndim

      DO Ndim
         Do j
            VEC_BB(j,Ndim) = 0.0
         ENDDO j
      ENDDO Ndim

      DO i
         DO i1
            GET Uii(i,i1)
            Tii(i,i1)  = Uii(i,i1)
            Tii(i,i1) *= -1.0
            IP_INIT_HAA(i,i1) = Tii(i,i1)
         ENDDO i1
      ENDDO i
#bgn_debug
#      execute get_my_rank rank
#      suma=0.0
#      tmpa=0.0
#      counter=0.0
#      pardo i, i1
#         GET  Uii(i,i1)
#         tmp  = Uii(i,i1) * Uii(i,i1)
#         tmpa += tmp
#      endpardo i, i1
#      execute sip_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma 
#end_debug

      DO j
         DO j1
            GET Ujj(j,j1)
            Tjj(j,j1)  = Ujj(j,j1)
            Tjj(j,j1) *= -1.0
            IP_INIT_HBB(j,j1) = Tjj(j,j1)
         ENDDO j1
      ENDDO j
      EXECUTE SIP_BARRIER
    
      EXECUTE FORM_GUESS IP_INIT_HAA  VEC_AA
      EXECUTE FORM_GUESS IP_INIT_HBB  VEC_BB

      EXECUTE SIP_BARRIER
#
# Extract the first p vectors, where p is the number of requested
# roots
      
      EXECUTE EXTRACT_SUBSET VEC_AA  RVEC_AA_INTMD
      EXECUTE EXTRACT_SUBSET VEC_BB  RVEC_BB_INTMD

      ExECUTE SIP_BARRIER 

      ENDPROC FORM_INITIAL_GUESS
#     --------------------------

      PROC PREP_IP_GUESS
#     ------------------

      DO NROOTS

            DO i
               TiN(i,NROOTS) = RVEC_AA_INTMD(i,NROOTS)
               PUT INIT_RVEC_AA(i,NROOTS) = TiN(i,NROOTS) 
            ENDDO i

            DO j
               TjN(j,NROOTS) = RVEC_BB_INTMD(j,NROOTS)
               PUT INIT_RVEC_BB(j,NROOTS) =  TjN(j,NROOTS)
            ENDDO j

      ENDDO NROOTS

      EXECUTE SIP_BARRIER

#bgn_debug
#      execute get_my_rank rank
#      if rank == 0.0
#      suma=0.0
#      tmpa=0.0
#      counter=0.0
#      do mroots
#         counter += 1.0
#         if counter == myroot
#         do i
#            GET  INIT_RVEC_AA(i,mroots) 
#            Ti(i) = INIT_RVEC_AA(i,mroots)
#            tmp  = Ti(i) * Ti(i)
#            tmpa += tmp
#         enddo i
#         endif 
#      enddo mroots
#      endif 
#      execute print_scalar tmpa
#end_debug

      COUNTER = 0
      DO MROOTS
          
         COUNTER += 1
         IF COUNTER == MYROOT 

            DO i
               GET INIT_RVEC_AA(i,mroots) 
               Ti(i) = INIT_RVEC_AA(i,mroots) 
               PUT R1a_guess(i) =  Ti(i)
            ENDDO i

            DO j
               GET INIT_RVEC_BB(j,mroots) 
               Tj(j) = INIT_RVEC_BB(j,mroots) 
               PUT R1b_guess(j) =  Tj(j)
            ENDDO j

          ENDIF

      ENDDO MROOTS

      EXECUTE SIP_BARRIER 
#bgn_debug
#      tmpa = 0.0
#      do i
#         get R1a_guess(i)
#         Ti(i) = R1a_guess(i)
#         tmp  = Ti(i) * Ti(i)
#         tmpa += tmp
#      enddo i
#      execute print_scalar tmpa
#end_debug
#
      PARDO i, kk1

            Tikk(i,kk1) = 0.0
            GET  R1a_guess(i)
            Ti(i) = R1a_guess(i)
            EXECUTE ADDROOTINDEX  Ti Tikk
            PUT R1a_intmd(i,kk1) += Tikk(i,kk1)

      ENDPARDO i, kk1
#bgn_debug
#      execute sip_barrier 
#      tmpa = 0.0
#      do kk1
#      do i
#         get R1a(i,kk1)
#         Tix(i,kk1) = R1a(i,kk1)  
#         tmp  = Tix(i,kk1) * Tix(i,kk1)
#         tmpa += tmp
#      enddo i
#      enddo kk1
#      execute print_scalar tmpa
#end_debug
      
      PARDO j, kk1

            Tjkk(j,kk1) = 0.0
            GET  R1b_guess(j)
            Tj(j) = R1b_guess(j)
            EXECUTE ADDROOTINDEX  Tj Tjkk
            PUT R1b_Intmd(j,kk1) += Tjkk(j,kk1)

      ENDPARDO j, kk1
      
      PARDO i, i1, kk1, a
         Taiki(a,i,kk1,i1) = 0.0
         PUT R2aa_a(a,i,kk1,i1) = Taiki(a,i,kk1,i1)
      ENDPARDO i, i1, kk1, a

      PARDO j, j1, kk1, b
         Tbjkj(b,j,kk1,j1) = 0.0
         PUT R2bb_b(b,j,kk1,j1) = Tbjkj(b,j,kk1,j1)
      ENDPARDO j, j1, kk1, b

      PARDO a, i, kk1, j
         Taikj(a,i,kk1,j) = 0.0
         PUT R2aa_b(a,i,kk1,j) = Taikj(a,i,kk1,j)
      ENDPARDO a,i, kk1, j

      PARDO j, i, kk1, b
         Tbjki(b,j,kk1,i) = 0.0
         PUT R2bb_a(b,j,kk1,i) = Tbjki(b,j,kk1,i)
      ENDPARDO j, i, kk1, b

      EXECUTE SERVER_BARRIER 
 
      SUMA = 0.0
      SUMB = 0.0
      TMPA = 0.0
      TMPB = 0.0
      PARDO i, kk1

            GET  R1a_intmd(i,kk1) 
            Tikk(i,kk1) = R1a_intmd(i,kk1)
            TMP   = Tikk(i,kk1) * Tikk(i,kk1) 
            TMPA += TMP
      ENDPARDO i, kk1

      PARDO j, kk1

            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1) =  R1b_intmd(j,kk1) 
            TMP   = Tjkk(j,kk1) * Tjkk(j,kk1)
            TMPB += TMP
      ENDPARDO j, kk1

      EXECUTE SIP_BARRIER 
      COLLECTIVE  SUMA += TMPA
      COLLECTIVE  SUMB += TMPB
      SUMAB  = SUMA
      SUMAB += SUMB

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB 
      NORM_R = SUMAB 

      PARDO i, kk1
            GET  R1a_intmd(i,kk1)
            Tikk(i,kk1)  = R1a_intmd(i,kk1)
            Tikk(i,kk1) *= INV_SQRT_NORM_R
            PUT R1a(i,kk1)  = Tikk(i,kk1) 
      ENDPARDO i, kk1

      PARDO j, kk1
            GET  R1b_intmd(j,kk1)
            Tjkk(j,kk1)  =  R1b_intmd(j,kk1)
            Tjkk(j,kk1) *= INV_SQRT_NORM_R
            PUT R1b(j,kk1) = Tjkk(j,kk1) 
      ENDPARDO j, kk1
      EXECUTE SIP_BARRIER 

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,kk1
#         get r1a(i,kk1) 
#         Tmp = r1a(i,kk1) * r1a(i,kk1) 
#         tmpa += tmp
#      endpardo i,kk1
#      pardo j,kk1
#         get r1b(j,kk1) 
#         tmp = r1b(j,kk1) * r1b(j,kk1) 
#         tmpb += tmp
#      endpardo j,kk1
#      execute server_barrier 
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier 
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug

      ENDPROC PREP_IP_GUESS
#     ---------------------

      PROC FORM_12HHP_DIAG
#     --------------------
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#
           GET              Uii(i1,i)
           Sii(i1,i)      = Uii(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET              Ujj(j1,j)
        Sjj(j1,j)      = Ujj(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1
#
# -----prepare f_aa diagonal = DDaa
#
     PARDO a, a1
#
           GET              Uaa(a,a1)
           Saa(a,a1)      = Uaa(a,a1)
           taa(a,a1)      = Uaa(a,a1)
           execute return_diagonal Saa Sdaa
           taa(a,a1)      = Sdaa(a,a1)
           put DDaa(a,a1) = taa(a,a1)
#
     ENDPARDO a, a1
#
#
# -----prepare f_bb diagonal = DDbb
#
     PARDO b, b1
#
        GET              Ubb(b,b1)
        Sbb(b,b1)      = Ubb(b,b1)
        execute return_diagonal Sbb Sdbb
        tbb(b,b1)      = Sdbb(b,b1)
        put DDbb(b,b1) = tbb(b,b1)
#
     ENDPARDO b, b1
#
     execute sip_barrier
#
     PARDO i
        DO kk1
#
           tis(i,kk1)=0.0
#
           do i1
#
              get          DDii(i1,i)
              t1is(i1,kk1) = 1.0
              tii(i,i1)  = DDii(i1,i)
#
              t2is(i,kk1)  = tii(i,i1)*t1is(i1,kk1)
              tis(i,kk1)  += t2is(i,kk1)
#
           enddo i1
#
           PUT Ri(i,kk1) += tis(i,kk1)
#
        ENDDO kk1
     ENDPARDO i
#
     PARDO j
        DO kk1
#
           tjs(j,kk1)=0.0
#
           do j1
#
              get          DDjj(j1,j)
              t1js(j1,kk1) = 1.0
              tjj(j,j1)  = DDjj(j1,j)
#
              t2js(j,kk1)  = tjj(j,j1)*t1js(j1,kk1)
              tjs(j,kk1)  += t2js(j,kk1)
#
           enddo j1
           PUT Rj(j,kk1) += tjs(j,kk1)
#
        ENDDO kk1
     ENDPARDO j
#
     PARDO a, i, i1
        DO kk1
#
           taixi(a,i,kk1,i1) = 0.0
#
           do i2
#
              GET                   DDii(i2,i1)
              tiaix(i2,a,i,kk1)   = 1.0
              tii(i1,i2)          = DDii(i2,i1)
#
              t1aixi(a,i,kk1,i1)  = tiaix(i2,a,i,kk1)*tii(i1,i2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo i2
#
           do i2
#
              GET                   DDii(i2,i)
              tiaix(i2,a,i1,kk1)  = 1.0
              tii(i,i2)           = DDii(i2,i)
#
              t1aixi(a,i,kk1,i1)  = tiaix(i2,a,i1,kk1)*tii(i,i2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo i2
#
           do a2
#
              GET                   DDaa(a2,a)
              t2aixi(a2,i,kk1,i1)  =-1.0
              taa(a,a2)           = DDaa(a2,a)
#
              t1aixi(a,i,kk1,i1)  = t2aixi(a2,i,kk1,i1)*taa(a,a2)
              taixi(a,i,kk1,i1)  += t1aixi(a,i,kk1,i1)
#
           enddo a2
#
           PUT Raixi(a,i,kk1,i1) += taixi(a,i,kk1,i1)
#
        ENDDO kk1
     ENDPARDO a, i, i1

     PARDO b, j, j1
        DO kk1
#
           tbjxj(b,j,kk1,j1) = 0.0
#
           do j2
#
              GET                   DDjj(j2,j1)
              tjbjx(j2,b,j,kk1)   = 1.0
              tjj(j1,j2)          = DDjj(j2,j1)
#
              t1bjxj(b,j,kk1,j1)  = tjbjx(j2,b,j,kk1)*tjj(j1,j2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo j2
#
           do j2
#
              GET                   DDjj(j2,j)
              tjbjx(j2,b,j1,kk1)  = 1.0
              tjj(j,j2)           = DDjj(j2,j)
#
              t1bjxj(b,j,kk1,j1)  = tjbjx(j2,b,j1,kk1)*tjj(j,j2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo j2
#
           do b2
#
              GET                   DDbb(b2,b)
              t2bjxj(b2,j,kk1,j1)  =-1.0
              tbb(b,b2)           = DDbb(b2,b)
#
              t1bjxj(b,j,kk1,j1)  = t2bjxj(b2,j,kk1,j1)*tbb(b,b2)
              tbjxj(b,j,kk1,j1)  += t1bjxj(b,j,kk1,j1)
#
           enddo b2
#
           PUT Rbjxj(b,j,kk1,j1) += tbjxj(b,j,kk1,j1)
#
        ENDDO kk1
     ENDPARDO b, j, j1

     PARDO a, i, j1
        DO kk1
#
           taixj(a,i,kk1,j1) = 0.0
#
           do j2
#
              GET                   DDjj(j2,j1)
              tjaix(j2,a,i,kk1)   = 1.0
              tjj(j1,j2)          = DDjj(j2,j1)
#
              t1aixj(a,i,kk1,j1)  = tjaix(j2,a,i,kk1)*tjj(j1,j2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo j2
#
           do i2
#
              GET                   DDii(i2,i)
              tiajx(i2,a,j1,kk1)  = 1.0
              tii(i,i2)           = DDii(i2,i)
#
              t1aixj(a,i,kk1,j1)  = tiajx(i2,a,j1,kk1)*tii(i,i2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo i2
#
           do a2
#
              GET                   DDaa(a2,a)
              t2aixj(a2,i,kk1,j1)  =-1.0
              taa(a,a2)           = DDaa(a2,a)
#
              t1aixj(a,i,kk1,j1)  = t2aixj(a2,i,kk1,j1)*taa(a,a2)
              taixj(a,i,kk1,j1)  += t1aixj(a,i,kk1,j1)
#
           enddo a2
#
           PUT Raixj(a,i,kk1,j1) += taixj(a,i,kk1,j1)
#
        ENDDO kk1
     ENDPARDO a, i, j1

     PARDO b, j, i1
        DO kk1
#
           tbjxi(b,j,kk1,i1) = 0.0
#
           do i2
#
              GET                   DDii(i2,i1)
              tibjx(i2,b,j,kk1)   = 1.0
              tii(i1,i2)          = DDii(i2,i1)
#
              t1bjxi(b,j,kk1,i1)  = tibjx(i2,b,j,kk1)*tii(i1,i2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo i2
#
           do j2
#
              GET                   DDjj(j2,j)
              tjbix(j2,b,i1,kk1)  = 1.0
              tjj(j,j2)           = DDjj(j2,j)
#
              t1bjxi(b,j,kk1,i1)  = tjbix(j2,b,i1,kk1)*tjj(j,j2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo j2
#
           do b2
#
              GET                   DDbb(b2,b)
              t2bjxi(b2,j,kk1,i1)  =-1.0
              tbb(b,b2)           = DDbb(b2,b)
#
              t1bjxi(b,j,kk1,i1)  = t2bjxi(b2,j,kk1,i1)*tbb(b,b2)
              tbjxi(b,j,kk1,i1)  += t1bjxi(b,j,kk1,i1)
#
           enddo b2
#
           PUT Rbjxi(b,j,kk1,i1) += tbjxi(b,j,kk1,i1)
#
        ENDDO kk1
     ENDPARDO b, j, i1

     PARDO a, kk1, i, i1
#
           taixi(a,i,kk1,i1) = 0.0
#
           do i2
           do i3
#
              request                  Wiiii(i,i2,i1,i3) i
              tiiii(i,i2,i1,i3)      = Wiiii(i,i2,i1,i3)
              execute return_diagonal4 Tiiii
              t1aixi(a,i2,kk1,i3)    = 1.0
              t2aixi(a,i,kk1,i1)     = Tiiii(i,i2,i1,i3)*t1aixi(a,i2,kk1,i3)
              taixi(a,i,kk1,i1)     += t2aixi(a,i,kk1,i1)
#
           enddo i3
           enddo i2
#
           PUT Raixi(a,i,kk1,i1) += taixi(a,i,kk1,i1)
#
     ENDPARDO a, kk1, i, i1
#
     PARDO b, kk1, j, j1
#
           tbjxj(b,j,kk1,j1) = 0.0
#
           do j2
           do j3
#
              request                  Wjjjj(j,j2,j1,j3) j
              tjjjj(j,j2,j1,j3)      = Wjjjj(j,j2,j1,j3)
              execute return_diagonal4 Tjjjj
              t1bjxj(b,j2,kk1,j3)    = 1.0
              t2bjxj(b,j,kk1,j1)     = Tjjjj(j,j2,j1,j3)*t1bjxj(b,j2,kk1,j3)
              tbjxj(b,j,kk1,j1)     += t2bjxj(b,j,kk1,j1)
#
           enddo j3
           enddo j2
#
           PUT Rbjxj(b,j,kk1,j1) += tbjxj(b,j,kk1,j1)
#
     ENDPARDO b, kk1, j, j1
#
    PARDO a, kk1, i, j1
#
           taixj(a,i,kk1,j1) = 0.0
#
           do i2
           do j3
#
              request                  Wiijj(i,i2,j1,j3) i
              tiijj(i,i2,j1,j3)      = Wiijj(i,i2,j1,j3)
              execute return_diagonal4 Tiijj
              t1aixj(a,i2,kk1,j3)    = 1.0
              t2aixj(a,i,kk1,j1)     = Tiijj(i,i2,j1,j3)*t1aixj(a,i2,kk1,j3)
              taixj(a,i,kk1,j1)     += t2aixj(a,i,kk1,j1)
#
           enddo j3
           enddo i2
#
           PUT Raixj(a,i,kk1,j1) += taixj(a,i,kk1,j1)
#
     ENDPARDO a, kk1, i, j1
#
     PARDO b, kk1, j, i1
#
           tbjxi(b,j,kk1,i1) = 0.0
#
           do j2
           do i3
#
              request                  Wiijj(i1,i3,j,j2) j
              tjjii(j,j2,i1,i3)      = Wiijj(i1,i3,j,j2)
              execute return_diagonal4 Tjjii
              t1bjxi(b,j2,kk1,i3)    = 1.0
              t2bjxi(b,j,kk1,i1)     = Tjjii(j,j2,i1,i3)*t1bjxi(b,j2,kk1,i3)
              tbjxi(b,j,kk1,i1)     += t2bjxi(b,j,kk1,i1)
#
           enddo i3
           enddo j2
#
           PUT Rbjxi(b,j,kk1,i1) += tbjxi(b,j,kk1,i1)
#
     ENDPARDO b, kk1, j, i1

    PARDO a, kk1, i, i1
#
           taixi(a,i,kk1,i1) = 0.0
#
           do a2
           do i3
#
              request                  Wiaai(i1,a,a2,i3) a
              taaii(a,a2,i1,i3)      = Wiaai(i1,a,a2,i3)
              execute return_diagonal4 Taaii
              t1iaxi(i,a2,kk1,i3)    = 1.0
              t2aixi(a,i,kk1,i1)     = Taaii(a,a2,i1,i3)*t1iaxi(i,a2,kk1,i3)
              taixi(a,i,kk1,i1)     += t2aixi(a,i,kk1,i1)
#
           enddo i3
           enddo a2
#
           t3aixi(a,i1,kk1,i)  = taixi(a,i,kk1,i1)

           PUT Raixi(a,i,kk1,i1) += taixi(a,i,kk1,i1)
           PUT Raixi(a,i1,kk1,i) += t3aixi(a,i1,kk1,i) 

#
     ENDPARDO a, kk1, i, i1
#
     PARDO b, kk1, j, j1
#
           tbjxj(b,j,kk1,j1) = 0.0
#
           do b2
           do j3
#
              request                  Wjbbj(j1,b,b2,j3) b
              tbbjj(b,b2,j1,j3)      = Wjbbj(j1,b,b2,j3)
              execute return_diagonal4 Tbbjj
              t1jbxj(j,b2,kk1,j3)    = 1.0
              t2bjxj(b,j,kk1,j1)     = Tbbjj(b,b2,j1,j3)*t1jbxj(j,b2,kk1,j3)
              tbjxj(b,j,kk1,j1)     += t2bjxj(b,j,kk1,j1)
#
           enddo j3
           enddo b2

           t3bjxj(b,j,kk1,j1) = tbjxj(b,j,kk1,j1)
#
           PUT Rbjxj(b,j,kk1,j1) += tbjxj(b,j,kk1,j1)
           PUT Rbjxj(b,j,kk1,j1) += t3bjxj(b,j,kk1,j1)
#
     ENDPARDO b, kk1, j, j1
#
     PARDO a, kk1, i, j1
#
           taixj(a,i,kk1,j1) = 0.0
#
#
           do a1
           do i1
#
              request                  Wiaai(i1,a1,a,i) a
              taaii(a,a1,i,i1)       = Wiaai(i1,a1,a,i)
              execute return_diagonal4 Taaii
              t1aixj(a1,i1,kk1,j1)    = 1.0
              t2aixj(a,i,kk1,j1)      = Taaii(a,a1,i,i1)*t1aixj(a1,i1,kk1,j1)
              taixj(a,i,kk1,j1)      += t2aixj(a,i,kk1,j1)
#
           enddo i1
           enddo a1
#
           PUT Raixj(a,i,kk1,j1) += taixj(a,i,kk1,j1)
#
     ENDPARDO a, kk1, i, j1
#
     PARDO b, kk1, j, i1
#
           tbjxi(b,j,kk1,i1) = 0.0
#
           do b1
           do j1
#
              request                  Wjbbj(j1,b1,b,j) b
              tbbjj(b,b1,j,j1)       = Wjbbj(j1,b1,b,j)
              execute return_diagonal4 Tbbjj
              t1bjxi(b1,j1,kk1,i1)    = 1.0
              t2bjxi(b,j,kk1,i1)      = Tbbjj(b,b1,j,j1)*t1bjxi(b1,j1,kk1,i1)
              tbjxi(b,j,kk1,i1)      += t2bjxi(b,j,kk1,i1)
#
           enddo j1
           enddo b1
#
           PUT Rbjxi(b,j,kk1,i1) += tbjxi(b,j,kk1,i1)
#
     ENDPARDO b, kk1, j, i1
#
# extra terms 
#
     PARDO a, kk1, i, j
#
           taixj(a,i,kk1,j) = 0.0

           do a1
           do j1
#
              request                  Wjjaa(j1,j,a,a1) j1
              taajj(a,a1,j,j1)       = Wjjaa(j1,j,a,a1)
              execute return_diagonal4 Taajj

              t1aixj(a1,i,kk1,j1)    = 1.0
              t2aixj(a,i,kk1,j)      = Taajj(a,a1,j,j1)*t1aixj(a1,i,kk1,j1)
              taixj(a,i,kk1,j)      += t2aixj(a,i,kk1,j)
#
           enddo j1
           enddo a1
#
           PUT Raixj(a,i,kk1,j) += taixj(a,i,kk1,j)
#
     ENDPARDO a, kk1, i, j

     PARDO b, kk1, j, i
#
           tbjxi(b,j,kk1,i) = 0.0
#
           do b1
           do i1
#
              request                  Wiibb(i1,i,b,b1) i1
              tbbii(b,b1,i,i1)        =  Wiibb(i1,i,b,b1)
              execute return_diagonal4 Tbbii
              t1bjxi(b1,j,kk1,i1)    = 1.0
              t2bjxi(b,j,kk1,i)      = Tbbii(b,b1,i,i1)*t1bjxi(b1,j,kk1,i1)
              tbjxi(b,j,kk1,i)      += t2bjxi(b,j,kk1,i)
#
           enddo i1
           enddo b1
#
           PUT Rbjxi(b,j,kk1,i) += tbjxi(b,j,kk1,i)
#
     ENDPARDO b, kk1, j, i

     execute sip_barrier

#bgn_debug
