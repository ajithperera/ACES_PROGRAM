                        SIAL GS_ORTHO_EA
#                       ----------------
      index jj1      = 1, 1
      index kk1      = 1, 1

      Index Ndim     = 1, 20
      Index Nroots   = 1, 12
      Index Mroots   = 1, 12
      Index Kroots   = 1, 12
      Index Jroots   = 1, 12

      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
#
      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt
#
      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
#
      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

#     CCSD amplitudes
#     ---------------
#
      distributed t1a(a,i)
      distributed t1b(b,j)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)

      distributed La1a(i,a)
      distributed La1b(j,b)
      served L2aa(i,a,i1,a1)
      served L2bb(j,b,j1,b1)
      served L2ab(i,a,j,b)

#
#     Transformed integrals
#     ---------------------
#
      served VSpipi(p,i,p1,i1)
      served VSqjqj(q,j,q1,j1)
      served Vpiqj(p,i,q,j)
      served VSaaai(a,a1,a2,i)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)

#
#     HBAR
#     ----
#
      distributed Uaa(a,a1)
      distributed Ubb(b,b1)
      distributed Uii(i1,i)
      distributed Ujj(j1,j)
      distributed Uia(i,a)
      distributed Ujb(j,b)
      served Wiiii(i,i1,i2,i3)
      served Wjjjj(j,j1,j2,j3)
      served Wiijj(i,i1,j,j1)
#
      served Waaia(a,a1,i,a2)
      served Wbbjb(b,b1,j,b2)
      served Waajb(a,a1,j,b2)
      served Wbbia(b,b1,i,a2)
#
      served Wiiia(i1,i,i2,a)
      served Wjjjb(j1,j,j2,b)
      served Wiijb(i1,i,j2,b)
      served Wjjia(j1,j,i2,a)
#
      served Wiiai(i,i1,a,i2)
      served Wiibj(i,i1,b,j)
      served Wjjai(j,j1,a,i)
      served Wjjbj(j,j1,b,j2)
#
      served Wiaai(i1,a1,a,i)
      served Wjbbj(j1,b1,b,j)
      served Wiabj(i,a,b,j)
      served Wjbai(j,b,a,i)
      served Wiibb(i1,i,b,b1)
      served Wjjaa(j1,j,a,a1)
#
      served Waaai(a,a1,a2,i)
      served Wbbbj(b,b1,b2,j)
      served Waabj(a,a1,b,j)
      served Wbbai(b,b1,a,i)
#
      served Waiaa(a,a1,i,a2)
      served Wbjbb(b,b1,j,b2)
      served Waibb(a,a1,j,b2)
      served Wbjaa(b,b1,i,a2)

      served Waiia(a,i,i1,a1)
      served Wbjjb(b,j,j1,b1)
      served Waijb(a,i,j,b)
      served Wbjia(b,j,i,a)


      Distributed REA(MROOTS,KK1)
      Distributed ORTHO_COEF_RL(Nroots,Mroots)
      Distributed ORTHO_COEF_R(Nroots,Mroots)

      distributed R1a_VECS(a,kk1,MROOTS)
      distributed R1b_VECS(b,kk1,MROOTS)
      distributed L1a_VECS(a,kk1,MROOTS)
      distributed L1b_VECS(b,kk1,MROOTS)
   
      Distributed L1a_intmd(a,kk1,Nroots)
      Distributed R1a_intmd(a,kk1,Nroots)
      Distributed R1a_nrml(a,kk1,Nroots)
      Distributed L1a_nrml(a,kk1,Nroots)

      Distributed R2a_aa_active(a,kk1,a1,i)
      Distributed R2a_bb_active(a,kk1,b,j)
      Distributed R2b_aa_active(b,kk1,a,i)

      Distributed R1a_active(a,kk1)
      Distributed R1a_tmp0(a,kk1)
      Distributed R1a_tmp1(a,kk1)

      Distributed R2a_aa_tmp0(a,kk1,a1,i1)
      Distributed R2a_bb_tmp0(a,kk1,b,j)
      Distributed R2a_aa_tmp1(a,kk1,a1,i1)
      Distributed R2a_bb_tmp1(a,kk1,b,j)

      Served L2a_aa_VECS(a,kk1,a1,i1,MROOTS)
      Served L2b_bb_VECS(b,kk1,b1,i1,MROOTS)
      Served L2a_bb_VECS(a,kk1,b,j,MROOTS)
      Served L2b_aa_VECS(b,kk1,a,i,MROOTS)

      Served R2a_aa_vecs(a,kk1,a1,i,Nroots)
      Served R2b_bb_vecs(b,kk1,b1,i,Nroots)
      Served R2a_bb_vecs(a,kk1,b,j,Nroots)
      Served R2b_aa_vecs(b,kk1,a,i,Nroots)

      Served R2a_aa_nrml(a,kk1,a1,i,Nroots)
      Served R2a_bb_nrml(a,kk1,b,j,Nroots)
      Served R2b_aa_nrml(b,kk1,a,i,Nroots)

      Served L2a_aa_nrml(a,kk1,a1,i1,MROOTS)
      Served L2a_bb_nrml(a,kk1,b,j,MROOTS)
      Served L2b_aa_nrml(b,kk1,a,i,MROOTS)

      Temp Taa(a,a1)
      Temp Tbb(b,b1)
      Temp TaN(a,NROOTS)
      Temp TbN(b,NROOTS)
      Temp Takk(a,kk1)
      Temp T1akk(a,kk1)
      Temp T2akk(a,kk1)
      Temp Tbkk(b,kk1)
      Temp T1bkk(b,kk1)
      Temp T2bkk(b,kk1)
      Temp Taxaa(a,kk1,a1,i)
      Temp Tbxbb(b,kk1,b1,j)
      Temp Taxbb(a,kk1,b,j)
      Temp Tbxaa(b,kk1,a,i)
      Temp T1axaa(a,kk1,a1,i)
      Temp T2axaa(a,kk1,a1,i)
      Temp T1bxbb(b,kk1,b1,j)
      Temp T2bxbb(b,kk1,b1,j)
      Temp T1axbb(a,kk1,b,j)
      Temp T2axbb(a,kk1,b,j)
      Temp T1bxaa(b,kk1,a,i)
      Temp T2bxaa(b,kk1,a,i)
      Temp Tax(a,kk1)
      Temp T1ax(a,kk1)
      Temp Tbx(b,kk1)
      Temp T1bx(b,kk1)
      Temp Taxai(a,kk1,a1,i)
      Temp Taiai(a2,i1,a1,i)
      Temp Tbjai(b2,j1,a1,i)
      Temp T1axai(a1,kk1,a,i)
      Temp Tix(i,kk1)
      Temp Tjx(j,kk1)
      Temp Tbxbj(b,kk1,b1,j)
      Temp Tbjbj(b2,j1,b1,j)

      Temp Txx_rl(NROOTS,MROOTS)

      Static ETEMP_RL(MROOTS,NROOTS)
      Static OVLP_CHECK(MROOTS,NROOTS)

      Scalar Mcount
      Scalar Ncount 
      Scalar Jcount 
      Scalar Kcount 
      Scalar tmp
      Scalar tmpa
      Scalar tmpb
      Scalar suma
      Scalar sumb
      Scalar sumab
      Scalar Sumaaa
      Scalar Sumbbb
      Scalar Sumaab
      Scalar Sumbba
      Scalar One
      Scalar Zero 
      Scalar HC_A
      Scalar HCAA_A
      Scalar HCAA_B
      Scalar HC_BBA
      Scalar SUMAA_A
      Scalar SUMAA_B
      Scalar SUMAB_B
      Scalar SUM_R
      Scalar A_VALUE
      Scalar CY_A
      Scalar CY_B
      Scalar CY_AB
      Scalar Eig_value
      Scalar NORM_PREV_C
      Scalar EXPONENT
      Scalar FACT
      Scalar INV_SQRT_NORM_ORTGC
      Scalar NORM_NEW_ORTGC
      Scalar INV_SQRT_NORM_R
      Scalar INV_NORM 
      Scalar NORM_GHG
      Scalar RANK
      Scalar SQRT_OVERLAP
      Scalar Target_roots 
      Scalar Two
      Scalar Limit 
      Scalar Mone 
      Scalar Half 

      PROC CREATE_ARRAYS  
#     ------------------
      CREATE REA
      CREATE R1A_VECS
      CREATE R1A_ACTIVE
      CREATE R2A_AA_ACTIVE
      CREATE R2A_BB_ACTIVE
      CREATE R1A_TMP0
      CREATE R1A_TMP1
      CREATE R2A_AA_TMP0
      CREATE R2A_BB_TMP0
      CREATE R2A_AA_TMP1
      CREATE R2A_BB_TMP1
      CREATE L1A_VECS
      CREATE ORTHO_COEF_RL
      CREATE ORTHO_COEF_R
      CREATE L1A_INTMD 
      CREATE R1A_INTMD 

      CREATE T1A
      CREATE T1B
      CREATE LA1A
      CREATE LA1B
      CREATE R1B_VECS
      CREATE L1B_VECS
      CREATE R1A_NRML 
      CREATE L1A_NRML 
      execute sip_barrier 

      ENDPROC CREATE_ARRAYS  
#     ---------------------

      PROC READ_DATA
#     --------------
      execute server_barrier 
#      execute list_to_blocks                REA 

      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb

      execute list_to_blocks                la1a
      execute list_to_blocks                la1b
      execute list_to_blocks                L2aa
      execute list_to_blocks                L2ab
      execute list_to_blocks                L2bb

      execute list_to_blocks                R1a_vecs
      execute list_to_blocks                R1b_vecs
      execute list_to_blocks                R2a_aa_vecs
      execute list_to_blocks                R2b_bb_vecs
      execute list_to_blocks                R2a_bb_vecs
      execute list_to_blocks                R2b_aa_vecs

      execute list_to_blocks                L1a_vecs
      execute list_to_blocks                L1b_vecs
      execute list_to_blocks                L2a_aa_vecs
      execute list_to_blocks                L2b_bb_vecs
      execute list_to_blocks                L2a_bb_vecs
      execute list_to_blocks                L2b_aa_vecs

      execute read_list_to_blocks
      execute server_barrier
#
      ENDPROC READ_DATA
#     -----------------

      PROC FORM_ORTHO_COEFS_R
#     ----------------------

     DO KROOTS
        DO JROOTS
           TXX_RL(JROOTS,KROOTS) = 0.0
           PUT ORTHO_COEF_R(JROOTS,KROOTS) = TXX_RL(JROOTS,KROOTS)
        ENDDO JROOTS
     ENDDO KROOTS
     EXECUTE SIP_BARRIER

     LIMIT  = NCOUNT 
     LIMIT += MONE

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE

        IF KCOUNT > LIMIT 
           EXIT
        ENDIF

        execute print_scalar kcount 

        PARDO a, kk1
            GET R1A_VECS(a,kk1,KROOTS)
            GET R1A_AcTIVE(a,kk1)

            Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
            T1akk(a,kk1)  = R1A_AcTIVE(a,kk1)
            TMP   = Takk(a,kk1) * T1akk(a,kk1)
            TMP         *= TWO
            Txx_RL(KROOTS,KROOTS)         = TMP
            PUT ORTHO_COEF_R(KROOTS,KROOTS) += Txx_RL(KROOTS,KROOTS)
 
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
            GET R2a_aa_ACTIVE(a,kk1,a1,i) 

            Taxaa(a,kk1,a1,i)  =  R2a_aa_VECS(a,kk1,a1,i,KROOTS)
            T1axaa(a,kk1,a1,i) =   R2a_aa_ACTIVE(a,kk1,a1,i)
            TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
            TMP    *= TWO
            Txx_RL(KROOTS,KROOTS)         = TMP
            PUT ORTHO_COEF_R(KROOTS,KROOTS) += Txx_RL(KROOTS,KROOTS)

        ENDPARDO a, a1, kk1, i

        PARDO a, b, kk1, j
            REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
            GET R2a_bb_ACTIVE(a,kk1,b,j) 

            Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
            T1axbb(a,kk1,b,j) = R2a_bb_ACTIVE(a,kk1,b,j)

            TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
            TMP     *= TWO
            Txx_RL(KROOTS,KROOTS)         = TMP
            PUT ORTHO_COEF_R(KROOTS,KROOTS) += Txx_RL(KROOTS,KROOTS)

         ENDPARDO a, b, kk1, j

     ENDDO KROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_ORTHO_COEFS_R
#    --------------------------

     PROC GRAHM_SCHMIDT
#    ------------------

    PARDO a, kk1
           GET R1A_ACTIVE(a,kk1)
           Takk(a,kk1)   = R1A_ACTIVE(a,kk1)

           KCOUNT = ZERO 
           DO KROOTS
              NCOUNT += ONE

              IF KCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF

              GET R1A_VECS(a,kk1,KROOTS)
              GET ORTHO_COEF_R(KROOTS,KROOTS)

              T1akk(a,kk1)  = R1A_VECS(a,kk1,KROOTS)
              Txx_RL(KROOTS,KROOTS) =  ORTHO_COEF_R(KROOTS,KROOTS)

              EXECUTE RETURN_SVAL Txx_RL FACT

              T1akk(a,kk1) *= FACT
              T1akk(a,kk1) *= -1.0
              Takk(a,kk1)  += T1akk(a,kk1)

           ENDDO KROOTS

           PUT R1a_TMP0(a,kk1) = Takk(a,kk1)

     ENDPARDO a, kk1

     PARDO a, a1, kk1, i
           GET R2a_aa_ACTIVE(a,kk1,a1,i)
           Taxaa(a,kk1,a1,i)  = R2a_aa_ACTIVE(a,kk1,a1,i)

          KCOUNT = 0.0
          DO KROOTS 
             KCOUNT += 1.0
             IF KCOUNT > TARGET_ROOTS
                EXIT
             ENDIF

             REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
             GET ORTHO_COEF_R(KROOTS,KROOTS)

             T1axaa(a,kk1,a1,i) = R2a_aa_VECS(a,kk1,a1,i,KROOTS)
             Txx_RL(KROOTS,KROOTS) = ORTHO_COEF_R(KROOTS,KROOTS)

             EXECUTE RETURN_SVAL Txx_RL FACT

             T1axaa(a,kk1,a1,i)  *= FACT
             T1axaa(a,kk1,a1,i)  *= -1.0
             Taxaa(a,kk1,a1,i)   += T1axaa(a,kk1,a1,i)

           ENDDO KROOTS

           PUT R2a_aa_TMP0(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO a, b, kk1, j
           GET R2a_bb_ACTIVE(a,kk1,b,j)
           Taxbb(a,kk1,b,j)  =  R2a_bb_ACTIVE(a,kk1,b,j)

           KCOUNT = 0.0
           DO KROOTS 

              KCOUNT += 1.0
              IF NCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF

              REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
              GET ORTHO_COEF_R(KROOTS,KROOTS)

              T1axbb(a,kk1,b,j) = R2a_bb_VECS(a,kk1,b,j,KROOTS)
              Txx_RL(KROOTS,KROOTS) = ORTHO_COEF_R(KROOTS,KROOTS)

              EXECUTE RETURN_SVAL Txx_RL FACT

              T1axbb(a,kk1,b,j) *= FACT
              T1axbb(a,kk1,b,j) *= -1.0
              Taxbb(a,kk1,b,j)  += T1axbb(a,kk1,b,j)

           ENDDO KROOTS

          PUT R2a_bb_TMP0(a,kk1,b,j) = Taxbb(a,kk1,b,j)  

     ENDPARDO a, b, kk1, j

     EXECUTE SERVER_BARRIER

     ENDPROC GRAHM_SCHMIDT
#    --------------------

     PROC NORM_INTMD
#    ---------------
     SUMA    = ZERO
     SUMAA_A = ZERO
     SUMAA_B = ZERO
     HC_A    = ZERO
     HCAA_A  = ZERO
     HCAA_B  = ZERO

     PARDO a, kk1
         GET R1A_TMP0(a,kk1)
         Takk(a,kk1)   = R1A_TMP0(a,kk1)
         TMP   = Takk(a,kk1) * Takk(a,kk1)
         TMP  *= TWO
         SUMA += TMP
     ENDPARDO a, kk1

     PARDO a, a1, kk1, i
         GET R2a_aa_TMP0(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) = R2a_aa_TMP0(a,kk1,a1,i)
         TMP      = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
         TMP     *= TWO
         SUMAA_A += TMP
     ENDPARDO a, a1, kk1, i

     PARDO a, b, kk1, j
         GET R2a_bb_TMP0(a,kk1,b,j) 

         Taxbb(a,kk1,b,j)  = R2a_bb_TMP0(a,kk1,b,j)
         TMP     = Taxbb(a,kk1,b,j) * Taxbb(a,kk1,b,j)
         SUMAA_B += TMP
     ENDPARDO a, b, kk1, j

     EXECUTE SERVER_BARRIER

     COLLECTIVE HC_A   += SUMA
     COLLECTIVE HCAA_A += SUMAA_A
     COLLECTIVE HCAA_B += SUMAA_B

     A_VALUE  = HC_A
     A_VALUE += HCAA_A
     A_VALUE += HCAA_B

     EXPONENT = HALF
     EXECUTE NORM_FAC A_VALUE EXPONENT
     INV_NORM = A_VALUE

     PARDO a, kk1
         GET R1A_TMP0(a,kk1)
         Takk(a,kk1)  = R1A_TMP0(a,kk1)
         Takk(a,kk1) *= INV_NORM
         PUT R1A_TMP1(a,kk1) = Takk(a,kk1)
     ENDPARDO a, kk1

     PARDO a, a1, kk1, i
         GET R2a_aa_TMP0(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i)  = R2a_aa_TMP0(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) *= INV_NORM
         PUT R2a_aa_TMP1(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
     ENDPARDO a, a1, kk1, i

     PARDO a, b, kk1, j
         GET R2a_bb_TMP0(a,kk1,b,j)
         Taxbb(a,kk1,b,j)  = R2a_bb_TMP0(a,kk1,b,j)
         Taxbb(a,kk1,b,j) *= INV_NORM
         PUT R2a_bb_TMP1(a,kk1,b,j) = Taxbb(a,kk1,b,j)
     ENDPARDO a, b, kk1, j

     EXECUTE SERVER_BARRIER 

     ENDPROC NORM_INTMD
#    ------------------

     PROC COPY_ACTIVE
#    -----------------

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

         IF KCOUNT == NCOUNT

         PARDO a, kk1
             GET R1A_TMP1(a,kk1)
             Takk(a,kk1)  = R1A_TMP1(a,kk1)
             PUT R1A_VECS(a,kk1,KROOTS) = Takk(a,kk1)
         ENDPARDO a, kk1
    
         PARDO a, a1, kk1, i
             GET R2a_aa_TMP1(a,kk1,a1,i)
             Taxaa(a,kk1,a1,i)  = R2a_aa_TMP1(a,kk1,a1,i)
             PUT R2a_aa_VECS(a,kk1,a1,i,KROOTS) = Taxaa(a,kk1,a1,i)
         ENDPARDO a, a1, kk1, i

         PARDO a, b, kk1, j
             GET R2a_bb_TMP1(a,kk1,b,j)
             Taxbb(a,kk1,b,j)  = R2a_bb_TMP1(a,kk1,b,j)
             PUT R2a_bb_VECS(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
         ENDPARDO a, b, kk1, j

         ENDIF 
     ENDDO KROOTS
     
     EXECUTE SERVER_BARRIER

     ENDPROC COPY_ACTIVE
#    -------------------

     PROC EXTRACT_R
#    --------------
   
     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 

        IF KCOUNT == NCOUNT 

        PARDO a, kk1
           GET R1A_VECS(a,kk1,KROOTS)
           Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
           PUT R1A_ACTIVE(a,kk1) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST R2a_aa_NRML(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = R2a_aa_NRML(a,kk1,a1,i,KROOTS)
            PREPARE R2a_aa_ACTIVE(a,kk1,a1,i) =  Taxaa(a,kk1,a1,i)
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
           PREPARE R2a_bb_ACTIVE(a,kk1,b,j) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

       ENDIF 

     ENDDO KROOTS 

     EXECUTE SERVER_BARRIER 

     ENDPROC EXTRACT_R
#    -----------------

     PROC FORM_NORM_R
#    -----------------

     DO KROOTS
        DO JROOTS
           TXX_RL(JROOTS,KROOTS) = 0.0
           PUT ORTHO_COEF_R(JROOTS,KROOTS) = TXX_RL(JROOTS,KROOTS)
        ENDDO JROOTS
     ENDDO KROOTS

     EXECUTE SIP_BARRIER

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE

        IF KCOUNT >  TARGET_ROOTS
           EXIT
        ENDIF
        JCOUNT = ZERO

        DO JROOTS
           JCOUNT += ONE
           IF JCOUNT >  TARGET_ROOTS
              EXIT
           ENDIF

           IF KCOUNT == JCOUNT 

           PARDO a, kk1

               GET R1A_VECS(a,kk1,KROOTS)
               GET R1A_VECS(a,kk1,KROOTS)

               Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
               T1akk(a,kk1)  = R1A_VECS(a,kk1,JROOTS)

               TMP          = Takk(a,kk1) * Takk(a,kk1) 
               TMP         *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)
           ENDPARDO a, kk1

           PARDO a, a1, kk1, i
 
               REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
               REQUEST R2a_aa_VECS(a,kk1,a1,i,JROOTS) i

               Taxaa(a,kk1,a1,i)  =  R2a_aa_VECS(a,kk1,a1,i,KROOTS)
               T1axaa(a,kk1,a1,i) =  R2a_aa_VECS(a,kk1,a1,i,JROOTS)
               TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
               TMP     *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)

           ENDPARDO a, a1, kk1, i

           PARDO a, b, kk1, j

               REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
               REQUEST R2a_bb_VECS(a,kk1,b,j,JROOTS) j

               Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
               T1axbb(a,kk1,b,j) = R2a_bb_VECS(a,kk1,b,j,JROOTS)
               TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
               TMP     *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)

           ENDPARDO a, b, kk1, j
           ENDIF 

        ENDDO JROOTS
     ENDDO KROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_NORM_R
#    -------------------

     PROC NORMALIZE_R
#    ----------------

     KCOUNT = ZERO
     DO KROOTS 
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 

        GET  ORTHO_COEF_R(KROOTS,KROOTS)
        Txx_RL(KROOTS,KROOTS) = ORTHO_COEF_R(KROOTS,KROOTS)
        EXECUTE RETURN_SVAL Txx_RL FACT
#bgn_debug
#        execute print_scalar FACT
#end_debug
        EXPONENT = HALF 
        EXECUTE NORM_FAC FACT EXPONENT 
        INV_NORM = FACT

        PARDO a, kk1
            GET R1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)  *= INV_NORM 
            PUT R1A_NRML(a,kk1,KROOTS) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = R2a_aa_VECS(a,kk1,a1,i,KROOTS)
            Taxaa(a,kk1,a1,i) *= INV_NORM
            PREPARE R2a_aa_NRML(a,kk1,a1,i,KROOTS) = Taxaa(a,kk1,a1,i)
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = R2a_bb_NRML(a,kk1,b,j,KROOTS)
           Taxbb(a,kk1,b,j) *= INV_NORM
           PREPARE R2a_bb_NRML(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

     ENDDO KROOTS 

     EXECUTE SERVER_BARRIER 

     ENDPROC NORMALIZE_R
#    -------------------

     PROC PHASE_FIX
#    ----------------

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        GET  ORTHO_COEF_R(KROOTS,KROOTS)
        Txx_RL(KROOTS,KROOTS) = ORTHO_COEF_R(KROOTS,KROOTS)
        EXECUTE RETURN_SVAL Txx_RL FACT
#bgn_debug
        execute print_scalar FACT
#end_debug
        IF FACT < ZERO 

        PARDO a, kk1
            GET L1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)   = L1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)  *= MONE
            PUT R1A_NRML(a,kk1,KROOTS) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST L2a_aa_VECS(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = L2a_aa_VECS(a,kk1,a1,i,KROOTS)
            Taxaa(a,kk1,a1,i) *= MONE 
            PREPARE R2a_aa_NRML(a,kk1,a1,i,KROOTS) = Taxaa(a,kk1,a1,i)
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST L2a_bb_VECS(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = L2a_bb_VECS(a,kk1,b,j,KROOTS)
           Taxbb(a,kk1,b,j) *= MONE 
           PREPARE R2a_bb_NRML(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

       ELSE

       PARDO a, kk1
           GET L1A_VECS(a,kk1,KROOTS)
           Takk(a,kk1)   = L1A_VECS(a,kk1,KROOTS)
           PUT R1A_NRML(a,kk1,KROOTS) = Takk(a,kk1)
       ENDPARDO a, kk1

       PARDO a, a1, kk1, i
           REQUEST L2a_aa_VECS(a,kk1,a1,i,KROOTS) i
           Taxaa(a,kk1,a1,i)  = L2a_aa_VECS(a,kk1,a1,i,KROOTS)
           PREPARE R2a_aa_NRML(a,kk1,a1,i,KROOTS) = Taxaa(a,kk1,a1,i)
      ENDPARDO a, a1, kk1, i

      PARDO a, b, kk1, j
          REQUEST L2a_bb_VECS(a,kk1,b,j,KROOTS) j
          Taxbb(a,kk1,b,j)  = L2a_bb_VECS(a,kk1,b,j,KROOTS)
          PREPARE R2a_bb_NRML(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
      ENDPARDO a, b, kk1, j

      ENDIF 

     ENDDO KROOTS
     EXECUTE SERVER_BARRIER

     ENDPROC PHASE_FIX
#    -----------------
     
     PROC COPY_R
#    -----------

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

       PARDO a, kk1
           GET R1A_NRML(a,kk1,KROOTS)
           Takk(a,kk1)   = R1A_NRML(a,kk1,KROOTS)
           PUT R1A_VECS(a,kk1,KROOTS) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST R2a_aa_NRML(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = R2a_aa_NRML(a,kk1,a1,i,KROOTS)
            PREPARE R2a_aa_VECS(a,kk1,a1,i,KROOTS) =  Taxaa(a,kk1,a1,i)
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST R2a_bb_NRML(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = R2a_bb_NRML(a,kk1,b,j,KROOTS)
           PREPARE R2a_bb_VECS(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

     ENDDO KROOTS

     EXECUTE SERVER_BARRIER 

     ENDPROC COPY_R
#    --------------

     PROC FORM_NORM_RL
#    -----------------

     DO KROOTS
        DO JROOTS
           TXX_RL(JROOTS,KROOTS) = 0.0
           PUT ORTHO_COEF_R(JROOTS,KROOTS) = TXX_RL(JROOTS,KROOTS)
        ENDDO JROOTS
     ENDDO KROOTS

     EXECUTE SIP_BARRIER

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE

        IF KCOUNT >  TARGET_ROOTS
           EXIT
        ENDIF
        JCOUNT = ZERO

        DO JROOTS
           JCOUNT += ONE
           IF JCOUNT >  TARGET_ROOTS
              EXIT
           ENDIF

           IF KCOUNT == JCOUNT
           PARDO a, kk1

               GET R1A_VECS(a,kk1,KROOTS)
               GET L1A_VECS(a,kk1,KROOTS)

               Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
               T1akk(a,kk1)  = L1A_VECS(a,kk1,JROOTS)

               TMP          = Takk(a,kk1) * Takk(a,kk1)
               TMP         *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)
           ENDPARDO a, kk1

           PARDO a, a1, kk1, i

               REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
               REQUEST L2a_aa_VECS(a,kk1,a1,i,JROOTS) i

               Taxaa(a,kk1,a1,i)  =  R2a_aa_VECS(a,kk1,a1,i,KROOTS)
               T1axaa(a,kk1,a1,i) =  L2a_aa_VECS(a,kk1,a1,i,JROOTS)
               TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
               TMP     *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)

           ENDPARDO a, a1, kk1, i

           PARDO a, b, kk1, j

               REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
               REQUEST L2a_bb_VECS(a,kk1,b,j,JROOTS) j

               Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
               T1axbb(a,kk1,b,j) = L2a_bb_VECS(a,kk1,b,j,JROOTS)
               TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
               TMP     *= TWO
               Txx_RL(JROOTS,KROOTS)         = TMP
               PUT ORTHO_COEF_R(JROOTS,KROOTS) += Txx_RL(JROOTS,KROOTS)

           ENDPARDO a, b, kk1, j

           ENDIF

        ENDDO JROOTS
     ENDDO KROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_NORM_RL
#    --------------------

     PROC NORMALIZE_RL
#    -----------------

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        GET  ORTHO_COEF_R(KROOTS,KROOTS)
        Txx_RL(KROOTS,KROOTS) = ORTHO_COEF_R(KROOTS,KROOTS)
        EXECUTE RETURN_SVAL Txx_RL FACT
#bgn_debug
        execute print_scalar FACT
#end_debug
        INV_NORM = 1.0/FACT

        PARDO a, kk1
            GET L1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)   = L1A_VECS(a,kk1,KROOTS)
            Takk(a,kk1)  *= INV_NORM
            PUT L1A_NRML(a,kk1,KROOTS) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST L2a_aa_VECS(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = L2a_aa_VECS(a,kk1,a1,i,KROOTS)
            Taxaa(a,kk1,a1,i) *= INV_NORM
            PREPARE L2a_aa_NRML(a,kk1,a1,i,KROOTS) = Taxaa(a,kk1,a1,i) 
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST L2a_bb_VECS(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = L2a_bb_VECS(a,kk1,b,j,KROOTS)
           Taxbb(a,kk1,b,j) *= INV_NORM
           PREPARE L2a_bb_NRML(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

     ENDDO KROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC NORMALIZE_RL
#    --------------------

     PROC COPY_RL
#    ------------

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        PARDO a, kk1
           GET L1A_NRML(a,kk1,KROOTS)
           Takk(a,kk1)   = L1A_NRML(a,kk1,KROOTS)
           PUT L1A_VECS(a,kk1,KROOTS) = Takk(a,kk1)
        ENDPARDO a, kk1

        PARDO a, a1, kk1, i
            REQUEST L2a_aa_NRML(a,kk1,a1,i,KROOTS) i
            Taxaa(a,kk1,a1,i)  = L2a_aa_NRML(a,kk1,a1,i,KROOTS)
            PREPARE L2a_aa_VECS(a,kk1,a1,i,KROOTS) =  Taxaa(a,kk1,a1,i)
       ENDPARDO a, a1, kk1, i

       PARDO a, b, kk1, j
           REQUEST L2a_bb_NRML(a,kk1,b,j,KROOTS) j
           Taxbb(a,kk1,b,j)  = L2a_bb_NRML(a,kk1,b,j,KROOTS)
           PREPARE R2a_bb_VECS(a,kk1,b,j,KROOTS) = Taxbb(a,kk1,b,j)
       ENDPARDO a, b, kk1, j

     ENDDO KROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC COPY_RL
#    ---------------

     PROC ORTHO_R 
#    ------------

     NCOUNT = ONE 
     DO NROOTS
        NCOUNT += ONE
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 
        CALL EXTRACT_R 
        CALL FORM_ORTHO_COEFS_R 
        CALL GRAHM_SCHMIDT
        CALL NORM_INTMD 
        CALL COPY_ACTIVE 
     ENDDO NROOTS

     ENDPROC ORTHO_R 
#    ---------------
     PROC PHASE_FIX_RL
#    ----------------

     CALL FORM_NORM_RL
     CALL PHASE_FIX 
     CALL COPY_RL

     ENDPROC PHASE_FIX_RL
#    --------------------

     PROC RENORM_R 
#    -------------

     CALL FORM_NORM_R 
     CALL NORMALIZE_R 
     CALL COPY_R

     ENDPROC RENORM_R 
#    ----------------

     PROC RENORM_RL
#    --------------

     CALL FORM_NORM_RL
     CALL NORMALIZE_RL
     CALL COPY_RL

     ENDPROC RENORM_RL
#    ----------------

     PROC ORTHO_CHECK
#    ----------------
     DO KROOTS
        DO JROOTS
           OVLP_CHECK(JROOTS,KROOTS) = 0.0
        ENDDO JROOTS
     ENDDO KROOTS

     KCOUNT = ZERO 
     DO KROOTS 
        KCOUNT += ONE 
        IF KCOUNT > TARGET_ROOTS
           EXIT 
        ENDIF

        JCOUNT = ZERO
        DO JROOTS 
           JCOUNT += ONE 
           IF JCOUNT > TARGET_ROOTS
              EXIT 
           ENDIF

           SUMA    = ZERO
           SUMAA_A = ZERO
           SUMAA_B = ZERO
           HC_A    = ZERO
           HCAA_A  = ZERO
           HCAA_B  = ZERO 

           PARDO a, kk1
               GET R1A_VECS(a,kk1,KROOTS)
               GET R1A_VECS(a,kk1,KROOTS)

               Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
               T1akk(a,kk1)  = R1A_VECS(a,kk1,JROOTS)
               TMP   = Takk(a,kk1) * T1akk(a,kk1)
               TMP  *= TWO
               SUMA += TMP

           ENDPARDO a, kk1

           PARDO a, a1, kk1, i
               REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
               REQUEST R2a_aa_VECS(a,kk1,a1,i,JROOTS) i

               Taxaa(a,kk1,a1,i)  =  R2a_aa_VECS(a,kk1,a1,i,KROOTS)
               T1axaa(a,kk1,a1,i) =  R2a_aa_VECS(a,kk1,a1,i,JROOTS)
               TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
               TMP    *= TWO
               SUMAA_A += TMP
 
           ENDPARDO a, a1, kk1, i

           PARDO a, b, kk1, j
               REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
               REQUEST R2a_bb_VECS(a,kk1,b,j,JROOTS) j

               Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
               T1axbb(a,kk1,b,j) = R2a_bb_VECS(a,kk1,b,j,KROOTS)

               TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
               SUMAA_B += TMP

          ENDPARDO a, b, kk1, j

          COLLECTIVE HC_A   += SUMA
          COLLECTIVE HCAA_A += SUMAA_A
          COLLECTIVE HCAA_B += SUMAA_B

          A_VALUE  = HC_A
          A_VALUE += HCAA_A
          A_VALUE += HCAA_B

          OVLP_CHECK(JROOTS,KROOTS) = A_VALUE

         ENDDO JROOTS 
     ENDDO  KROOTS 

     execute print_static OVLP_CHECK  TARGET_ROOTS 

     ENDPROC ORTHO_CHECK
#    -------------------

     PROC ORTHO_CHECK_RL
#    -------------------
     DO KROOTS
        DO JROOTS
           OVLP_CHECK(JROOTS,KROOTS) = 0.0
        ENDDO JROOTS
     ENDDO KROOTS

     KCOUNT = ZERO
     DO KROOTS
        KCOUNT += ONE
        IF KCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        JCOUNT = ZERO
        DO JROOTS
           JCOUNT += ONE
           IF JCOUNT > TARGET_ROOTS
              EXIT
           ENDIF

           SUMA    = ZERO
           SUMAA_A = ZERO
           SUMAA_B = ZERO
           HC_A    = ZERO
           HCAA_A  = ZERO
           HCAA_B  = ZERO

           PARDO a, kk1
               GET R1A_VECS(a,kk1,KROOTS)
               GET L1A_VECS(a,kk1,KROOTS)

               Takk(a,kk1)   = R1A_VECS(a,kk1,KROOTS)
               T1akk(a,kk1)  = L1A_VECS(a,kk1,JROOTS)
               TMP   = Takk(a,kk1) * T1akk(a,kk1)
               TMP  *= TWO
               SUMA += TMP

           ENDPARDO a, kk1

           PARDO a, a1, kk1, i
               REQUEST R2a_aa_VECS(a,kk1,a1,i,KROOTS) i
               REQUEST L2a_aa_VECS(a,kk1,a1,i,JROOTS) i

               Taxaa(a,kk1,a1,i)  =  R2a_aa_VECS(a,kk1,a1,i,KROOTS)
               T1axaa(a,kk1,a1,i) =  L2a_aa_VECS(a,kk1,a1,i,JROOTS)
               TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
               TMP    *= TWO
               SUMAA_A += TMP

           ENDPARDO a, a1, kk1, i

           PARDO a, b, kk1, j
               REQUEST R2a_bb_VECS(a,kk1,b,j,KROOTS) j
               REQUEST R2a_bb_VECS(a,kk1,b,j,JROOTS) j

               Taxbb(a,kk1,b,j)  = R2a_bb_VECS(a,kk1,b,j,KROOTS)
               T1axbb(a,kk1,b,j) = L2a_bb_VECS(a,kk1,b,j,JROOTS)

               TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
               SUMAA_B += TMP

          ENDPARDO a, b, kk1, j

          COLLECTIVE HC_A   += SUMA
          COLLECTIVE HCAA_A += SUMAA_A
          COLLECTIVE HCAA_B += SUMAA_B

          A_VALUE  = HC_A
          A_VALUE += HCAA_A
          A_VALUE += HCAA_B

          OVLP_CHECK(JROOTS,KROOTS) = A_VALUE

         ENDDO JROOTS
     ENDDO  KROOTS

     execute print_static OVLP_CHECK  TARGET_ROOTS

     ENDPROC ORTHO_CHECK_RL
#    ----------------------
#     
# Main program ara

      ZERO = 0.0
      ONE  = 1.0
      TWO  = 2.0
      MONE = -1.0
      HALF = 0.50 
 
      DO JROOTS
      DO KROOTS
        ETEMP_RL(KROOTS,JROOTS) = ZERO 
      ENDDO  KROOTS
      ENDDO  JROOTS

      TARGET_ROOTS = IP_ROOTS 

      CALL CREATE_ARRAYS 
      CALL READ_DATA

#bgn_debug
#      CALL ORTHO_CHECK
#end_debug

      CALL RENORM_R  
#bgn_debug
#      CALL ORTHO_CHECK
#end_debug

      CALL ORTHO_R 
      CALL PHASE_FIX_RL 

#bgn_debug
      CALL ORTHO_CHECK_RL
#end_debug

      CALL RENORM_RL

#bgn_debug
      CALL ORTHO_CHECK
      CALL ORTHO_CHECK_RL
#end_debug

                        ENDSIAL GS_ORTHO_EA
#                       -------------------
