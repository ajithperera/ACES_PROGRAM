# Main program ara

      ZERO = 0.0
      ONE  = 1.0
      TWO  = 2.0
      MONE = -1.0
      HALF = 0.50 
 
      DO JROOTS
      DO KROOTS
        ETEMP_RL(KROOTS,JROOTS) = ZERO 
      ENDDO  KROOTS
      ENDDO  JROOTS

      TARGET_ROOTS = IP_ROOTS 

      CALL CREATE_ARRAYS 
      CALL READ_DATA

#bgn_debug
