#end_debug

      CALL RENORM_R  
#bgn_debug
      CALL ORTHO_CHECK
#end_debug

      CALL ORTHO_R 

#bgn_debug
      CALL ORTHO_CHECK
#end_debug

#      CALL PHASE_FIX_RL 
#      CALL RENORM_RL
#bgn_debug
#      CALL ORTHO_CHECK
#end_debug

