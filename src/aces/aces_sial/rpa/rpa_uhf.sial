      PROC FORM_INITIAL_GUESS
#     -----------------------

      DO MAX_NO_ROOTS
         PARDO A, I
             INIT_RVEC_AA(A,I,MAX_NO_ROOTS) = 0.0
             DIAGA(a,i)                     = 0.0
         ENDPARDO A, I
      ENDDO MAX_NO_ROOTS 

      DO MAX_NO_ROOTS
         PARDO B, J
             INIT_RVEC_BB(B,J,MAX_NO_ROOTS) = 1.0
             DIAGB(b,j)                     = 0.0
         ENDPARDO B, J
      ENDDO MAX_NO_ROOTS 

      DO a
      DO i
         GET R1DA(a,i)
         Tai(a,i)   = R1DA(a,i)
         DIAGA(a,i) = Tai(a,i)
      ENDDO i
      ENDDO a

     DO b
     DO j
        GET R1DB(b,j)
        Tbj(b,j)   = R1DB(b,j)
        DIAGB(b,j) = Tbj(b,j)
     ENDDO j
     ENDDO b

     EXECUTE SIP_BARRIER

     EXECUTE FORM_RPA_GUESS DIAGA INIT_RVEC_AA
     EXECUTE FORM_RPA_GUESS DIAGB INIT_RVEC_AA


     ENDPROC FORM_INITIAL_GUESS
#    --------------------------

     PROC MOVE_GUESS_2CURRENT
#    -------------------------

      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_AA MYROOT
      IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF
      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_BB MYROOT
      IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF

     RCOUNT = 0.0
     DO MAX_NO_ROOTS
        RCOUNT += ONE

        IF RCOUNT > ONE
           EXIT
        ENDIF 

        PARDO A, I

              TAIP_R(A,I) =  INIT_RVEC_AA(A,I,MAX_NO_ROOTS)
              TAIM_L(A,I) =  INIT_RVEC_AA(A,I,MAX_NO_ROOTS)
  
              PUT R1A_MO_P_INTMD_R(A,I) = TAIP_R(A,I)
              PUT R1A_MO_M_INTMD_L(A,I) = TAIM_L(A,I)

        ENDPARDO A, I

        PARDO B, J

              TBJP_R(B,J) =  INIT_RVEC_BB(B,J,MAX_NO_ROOTS)
              TBJM_L(B,J) =  INIT_RVEC_BB(B,J,MAX_NO_ROOTS)

              PUT R1B_MO_P_INTMD_R(B,J) = TBJP_R(B,J)
              PUT R1B_MO_M_INTMD_L(B,J) = TBJM_L(B,J)

        ENDPARDO B, J


     ENDDO MAX_NO_ROOTS

     execute sip_barrier

     NORM_INTMD_P_R_A = 0.0
     NORM_INTMD_M_L_A = 0.0
     NORM_INTMD_P_R_B = 0.0
     NORM_INTMD_M_L_B = 0.0
     NORMA_P_R = 0.0
     NORMA_M_L = 0.0

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I) 
         GET R1A_MO_M_INTMD_L(A,I) 

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I) 

         TMP = TAIP_R(A,I) * TAIP_R(A,I)
         NORM_INTMD_P_R_A += TMP 
 
         TMP = TAIM_L(A,I) * TAIM_L(A,I)
         NORM_INTMD_M_L_A += TMP 

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J) 
         GET R1B_MO_M_INTMD_L(B,J) 

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)
  
         TMP = TBJP_R(B,J) * TBJP_R(B,J)  
         NORM_INTMD_P_R_B += TMP 

         TMP = TBJM_L(B,J) * TBJM_L(B,J)  
         NORM_INTMD_M_L_B += TMP 

     ENDPARDO B, J

     execute sip_barrier
     COLLECTIVE NORMA_P_R_A += NORM_INTMD_P_R_A
     COLLECTIVE NORMA_M_L_A += NORM_INTMD_M_L_A
     COLLECTIVE NORMA_P_R_B += NORM_INTMD_P_R_B
     COLLECTIVE NORMA_M_L_B += NORM_INTMD_M_L_B

     NORMA_P_R  = NORMA_P_R_A
     NORMA_P_R += NORMA_P_R_B 

     NORMA_M_L  = NORMA_M_L_A
     NORMA_M_L += NORMA_M_L_B

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORMA_P_R EXPONENT
     EXECUTE NORM_FAC NORMA_M_L EXPONENT
     INV_SQRT_NORM_PR = NORMA_P_R
     INV_SQRT_NORM_ML = NORMA_M_L

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I)
         GET R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I)*= INV_SQRT_NORM_PR
         TAIM_L(A,I)*= INV_SQRT_NORM_ML

         PUT  R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
         PUT  R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J)
         GET R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) *= INV_SQRT_NORM_PR
         TBJM_L(B,J) *= INV_SQRT_NORM_PR

         PUT  R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
         PUT  R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO B, J
     execute sip_barrier

     ENDPROC MOVE_GUESS_2CURRENT
#    ---------------------------

     PROC MOVE_HISTORY_2CURRENT
#    -------------------------

     MCOUNT = 0.0
     DO MINDEX20
        MCOUNT += 1.0

        IF MCOUNT == ITER_COUNT

        PARDO A, I

              GET R1A_MO_P_HIST_R(A,I,MINDEX20)
              GET R1A_MO_M_HIST_L(A,I,MINDEX20)

              TAIP_R(A,I) =  R1A_MO_P_HIST_R(A,I,MINDEX20)
              TAIM_L(A,I) =  R1A_MO_M_HIST_L(A,I,MINDEX20)
  
              PUT R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
              PUT R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

        ENDPARDO A, I

        PARDO B, J
              GET R1B_MO_P_HIST_R(B,J,MINDEX20)
              GET R1B_MO_M_HIST_L(B,J,MINDEX20)

              TBJP_R(B,J) =  R1B_MO_P_HIST_R(B,J,MINDEX20)
              TBJM_L(B,J) =  R1B_MO_M_HIST_L(B,J,MINDEX20)

              PUT R1B_MO_P_CURRENT_R(B,J) = TBJP_R(B,J)
              PUT R1B_MO_M_CURRENT_L(B,J) = TBJM_L(B,J)
        ENDPARDO B, J

        ENDIF 
     ENDDO MINDEX20

     execute sip_barrier

     ENDPROC MOVE_HISTORY_2CURRENT
#    -----------------------------

     PROC SAVE_C_VECTORS
#    --------------------

     MCOUNT = 0.0
     DO MINDEX20

        MCOUNT  += 1.0
        IF MCOUNT == ITER_COUNT

        PARDO A, I

           GET R1A_MO_P_CURRENT_R(A,I)
           GET R1A_MO_M_CURRENT_L(A,I)

           TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I)
           TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I)

           PUT R1A_MO_P_HIST_R(A,I,MINDEX20) = TAIP_R(A,I)
           PUT R1A_MO_M_HIST_L(A,I,MINDEX20) = TAIM_L(A,I)

        ENDPARDO A, I
       
        PARDO B, J

           GET R1B_MO_P_CURRENT_R(B,J)
           GET R1B_MO_M_CURRENT_L(B,J)

           TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J)
           TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J)

           PUT R1B_MO_P_HIST_R(B,J,MINDEX20) = TBJP_R(B,J)
           PUT R1B_MO_M_HIST_L(B,J,MINDEX20) = TBJM_L(B,J)

        ENDPARDO B, J
        ENDIF

     ENDDO MINDEX20

     execute sip_barrier

    ENDPROC SAVE_C_VECTORS
#   -----------------------

     PROC FORM_MO_FOCK
#    -----------------

     DO I
     DO I1
        TII(I1,I) = FOCK_A(I1,I) 
        PUT FOCK_A_OO(I1,I) = TII(I1,I)
     ENDDO I1
     ENDDO I

     DO A
     DO A1
        TAA(A1,A)   = FOCK_A(A1,A)
        PUT FOCK_A_VV(A1,A) = TAA(A1,A)
     ENDDO A1
     ENDDO A

     DO J
     DO J1
        TJJ(J1,J)   = FOCK_B(J1,J)
        PUT FOCK_B_OO(J1,J) = TJJ(J1,J)
     ENDDO J1
     ENDDO J

     DO B
     DO B1
        TBB(B1,B)   = FOCK_B(B1,B)
        PUT FOCK_B_VV(B1,B) = TBB(B1,B)
     ENDDO B1
     ENDDO B
     execute sip_barrier 

     ENDPROC FORM_MO_FOCK
#    --------------------

     PROC FORM_FOCK_CONTRIBUTION
#    ---------------------------

     PARDO A, I

           TAIP_R(A,I) = 0.0
           TAIM_L(A,I) = 0.0

           DO I1

              GET R1A_MO_P_CURRENT_R(A,I1)
              GET R1A_MO_M_CURRENT_L(A,I1)
  
              TAIP_R(A,I1) = R1A_MO_P_CURRENT_R(A,I1)
              TAIM_L(A,I1) = R1A_MO_M_CURRENT_L(A,I1)

              GET FOCK_A_OO(I1,I)
              TII(I1,I) = FOCK_A_OO(I1,I)

              TAI_P(A,I) = TAIP_R(A,I1) * TII(I1,I)
              TAI_M(A,I) = TAIM_L(A,I1) * TII(I1,I)
     
              TAIP_R(A,I) += TAI_P(A,I)
              TAIM_L(A,I) += TAI_M(A,I)

           ENDDO I1

           DO A1

              GET R1A_MO_P_CURRENT_R(A1,I)
              GET R1A_MO_M_CURRENT_L(A1,I)
  
              TAIP_R(A1,I) = R1A_MO_P_CURRENT_R(A1,I)
              TAIM_L(A1,I) = R1A_MO_M_CURRENT_L(A1,I)

              GET FOCK_A_VV(A1,A)
              TAA(A1,A) = FOCK_A_VV(A1,A)

              TAI_P(A,I) = TAIP_R(A1,I) * TAA(A1,A)
              TAI_M(A,I) = TAIM_L(A1,I) * TAA(A1,A)
    
              TAIP_R(A,I) += TAI_P(A,I)
              TAIM_L(A,I) += TAI_M(A,I)

           ENDDO A1

           PUT HR1A_MO_P_CURRENT_R(A,I) += TAIP_R(A,I)
           PUT HR1A_MO_M_CURRENT_L(A,I) += TAIM_L(A,I)

     ENDPARDO A, I

     PARDO B, J

           TBJP_R(B,J) = 0.0
           TBJM_L(B,J) = 0.0

           DO J1

              GET R1B_MO_P_CURRENT_R(B,J1)
              GET R1B_MO_M_CURRENT_L(B,J1)
 
              TBJP_R(B,J1) = R1B_MO_P_CURRENT_R(B,J1)
              TBJM_L(B,J1) = R1B_MO_M_CURRENT_L(B,J1)

              GET FOCK_B_OO(J1,J)
              TJJ(J1,J) = FOCK_B_OO(J1,J)

              TBJ_P(B,J) = TBJP_R(B,J1) * TJJ(J1,J)
              TBJ_M(B,J) = TBJM_L(B,J1) * TJJ(J1,J)
    
              TBJP_R(B,J) += TBJ_P(B,J)
              TBJM_L(B,J) += TBJ_M(B,J)

           ENDDO J1

           DO B1

              GET R1B_MO_P_CURRENT_R(B1,J)
              GET R1B_MO_M_CURRENT_L(B1,J)
 
              TBJP_R(B1,J) = R1B_MO_P_CURRENT_R(B1,J)
              TBJM_L(B1,J) = R1B_MO_M_CURRENT_L(B1,J)

              GET FOCK_B_VV(B1,B)
              TBB(B1,B) = FOCK_B_VV(B1,B)

              TBJ_P(B,J) = TBJP_R(B1,J) * TBB(B1,B)
              TBJ_M(B,J) = TBJM_L(B1,J) * TBB(B1,B)
   
              TBJP_R(B,J) += TBJ_P(B,J)
              TBJM_L(B,J) += TBJ_M(B,J)

           ENDDO B1

           PUT HR1B_MO_P_CURRENT_R(B,J) += TBJP_R(B,J)
           PUT HR1B_MO_M_CURRENT_L(B,J) += TBJM_L(B,J)

     ENDPARDO B, J

     execute sip_barrier 

     ENDPROC FORM_FOCK_CONTRIBUTION
#    ---------------------------

     PROC FORM_AO_R1AB
#    -----------------

      PARDO MU, NU

        TXXP(MU,NU) = 0.0
        TXXM(MU,NU) = 0.0

        DO I

           TXIP(MU,I) = 0.0
           TXIM(MU,I) = 0.0

           DO A

              GET R1A_MO_P_CURRENT_R(A,I)
              GET R1A_MO_M_CURRENT_L(A,I)
  
              TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I)
              TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I)

              TXIP_T(MU,I) = TAIP_R(A,I) * CA(MU,A)
              TXIM_T(MU,I) = TAIM_L(A,I) * CA(MU,A)

              TXIP(MU,I)  += TXIP_T(MU,I)
              TXIM(MU,I)  += TXIM_T(MU,I)

           ENDDO A

           TXXP_T(MU,NU) = TXIP(MU,I) * CA(NU,I)
           TXXM_T(MU,NU) = TXIM(MU,I) * CA(NU,I)

           TXXP(MU,NU)  += TXXP_T(MU,NU)
           TXXM(MU,NU)  += TXXM_T(MU,NU)

        ENDDO I

        PUT R1A_AO_P_CURRENT_R(MU,NU) =  TXXP(MU,NU)
        PUT R1A_AO_M_CURRENT_L(MU,NU) =  TXXM(MU,NU)

      ENDPARDO MU, NU

      PARDO MU, NU
 
       TXXP(MU,NU) = 0.0
       TXXM(MU,NU) = 0.0

        DO J

           TXJP(MU,J) = 0.0
           TXJM(MU,J) = 0.0

           DO B

              GET R1B_MO_P_CURRENT_R(B,J)
              GET R1B_MO_M_CURRENT_L(B,J)

              TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J)
              TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J)

              TXJP_T(MU,J) = TBJP_R(B,J) * CB(MU,B)
              TXJM_T(MU,J) = TBJM_L(B,J) * CB(MU,B)

              TXJP(MU,J)  += TXJP_T(MU,J)
              TXJM(MU,J)  += TXJM_T(MU,J)

           ENDDO B

           TXXP_T(MU,NU) = TXJP(MU,J) * CB(NU,J)
           TXXM_T(MU,NU) = TXjM(MU,J) * CB(NU,J)

           TXXP(MU,NU)  += TXXP_T(MU,NU)
           TXXM(MU,NU)  += TXXM_T(MU,NU)

        ENDDO J

        PUT  R1B_AO_P_CURRENT_R(MU,NU) =  TXXP(MU,NU)
        PUT  R1B_AO_M_CURRENT_L(MU,NU) =  TXXM(MU,NU)

      ENDPARDO MU, NU

      execute sip_barrier 

     ENDPROC FORM_AO_R1AB
#    --------------------

    PROC FORM_AO_APLUSB_AMINUSB
#   ---------------------------

     PARDO MU, NU, LAMBDA, SIGMA

        TXXXX(MU,NU,LAMBDA,SIGMA) = 0.0

        PREPARE APBXXXX(MU,NU,LAMBDA,SIGMA) = TXXXX(MU,NU,LAMBDA,SIGMA)
        PREPARE AMBXXXX(MU,NU,LAMBDA,SIGMA) = TXXXX(MU,NU,LAMBDA,SIGMA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SERVER_BARRIER

     PARDO MU, NU, LAMBDA, SIGMA

         COMPUTE_INTEGRALS AOINT_CU(MU,LAMBDA,NU,SIGMA)
         COMPUTE_INTEGRALS AOINT_EX(MU,SIGMA,NU,LAMBDA)

         CXXXX(MU,LAMBDA,NU,SIGMA)   = AOINT_CU(MU,LAMBDA,NU,SIGMA)
         EXXXX(MU,SIGMA,NU,LAMBDA)   = AOINT_EX(MU,SIGMA,NU,LAMBDA)
         CP1XXXX(MU,NU,LAMBDA,SIGMA) = CXXXX(MU,LAMBDA,NU,SIGMA)
         EP1XXXX(MU,NU,LAMBDA,SIGMA) = EXXXX(MU,SIGMA,NU,LAMBDA)
              
         TXXXX(MU,NU,LAMBDA,SIGMA)  = CP1XXXX(MU,NU,LAMBDA,SIGMA)
         TXXXX(MU,NU,LAMBDA,SIGMA) -= EP1XXXX(MU,NU,LAMBDA,SIGMA)

         PREPARE AXXXX(MU,NU,LAMBDA,SIGMA) = TXXXX(MU,NU,LAMBDA,SIGMA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     PARDO MU, NU, LAMBDA, SIGMA

         COMPUTE_INTEGRALS AOINT_CU(MU,NU,LAMBDA,SIGMA)
         COMPUTE_INTEGRALS AOINT_EX(MU,SIGMA,NU,LAMBDA)

         CXXXX(MU,NU,LAMBDA,SIGMA)   = AOINT_CU(MU,NU,LAMBDA,SIGMA)
         EXXXX(MU,SIGMA,NU,LAMBDA)   = AOINT_EX(MU,SIGMA,NU,LAMBDA)
         EP1XXXX(MU,NU,SIGMA,LAMBDA) = EXXXX(MU,SIGMA,NU,LAMBDA)

         TXXXX(MU,NU,SIGMA,LAMBDA)  = CP1XXXX(MU,NU,SIGMA,LAMBDA)
         TXXXX(MU,NU,SIGMA,LAMBDA) -= EP1XXXX(MU,NU,SIGMA,LAMBDA)

         PREPARE BXXXX(MU,NU,LAMBDA,SIGMA) = BXXXX(MU,NU,SIGMA,LAMBDA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SERVER_BARRIER 

     PARDO MU, NU, LAMBDA, SIGMA
     
         REQUEST AXXXX(MU,NU,LAMBDA,SIGMA) SIGMA
         REQUEST BXXXX(MU,NU,LAMBDA,SIGMA) SIGMA

         CXXXX(MU,NU,LAMBDA,SIGMA) = AXXXX(MU,NU,LAMBDA,SIGMA) 
         EXXXX(MU,NU,LAMBDA,SIGMA) = BXXXX(MU,NU,LAMBDA,SIGMA) 

         TMXXXX(MU,NU,LAMBDA,SIGMA)  = CXXXX(MU,NU,LAMBDA,SIGMA)
         TMXXXX(MU,NU,LAMBDA,SIGMA) -= EXXXX(MU,NU,LAMBDA,SIGMA)
         TPXXXX(MU,NU,LAMBDA,SIGMA)  = CXXXX(MU,NU,LAMBDA,SIGMA)
         TPXXXX(MU,NU,LAMBDA,SIGMA) += EXXXX(MU,NU,LAMBDA,SIGMA)

         PREPARE AMBXXXX(MU,NU,LAMBDA,SIGMA)  = TMXXXX(MU,NU,SIGMA,LAMBDA)
         PREPARE APBXXXX(MU,NU,LAMBDA,SIGMA)  = TPXXXX(MU,NU,SIGMA,LAMBDA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_AO_APLUSB_AMINUSB
#    ------------------------------

     PROC HC_MULTIPLY
#    ----------------

     PARDO MU, NU, LAMBDA, SIGMA

           GET R1A_AO_P_CURRENT_R(MU,NU) 
           GET R1A_AO_M_CURRENT_L(MU,NU)
           GET R1B_AO_P_CURRENT_R(MU,NU)
           GET R1B_AO_M_CURRENT_L(MU,NU) 

           TAXXP(MU,NU) = R1A_AO_P_CURRENT_R(MU,NU)
           TAXXM(MU,NU) = R1A_AO_M_CURRENT_L(MU,NU)
           TBXXP(MU,NU) = R1B_AO_P_CURRENT_R(MU,NU)
           TBXXM(MU,NU) = R1B_AO_M_CURRENT_L(MU,NU)

           REQUEST APBXXXX(MU,NU,LAMBDA,SIGMA) SIGMA 
           REQUEST AMBXXXX(MU,NU,LAMBDA,SIGMA) SIGMA 

           TPXXXX(MU,NU,LAMBDA,SIGMA) = APBXXXX(MU,NU,LAMBDA,SIGMA)
           TMXXXX(MU,NU,LAMBDA,SIGMA) = AMBXXXX(MU,NU,LAMBDA,SIGMA)

           TAPXX_INT(LAMBDA,SIGMA)  = TAXXP(MU,NU) * TPXXXX(MU,NU,LAMBDA,SIGMA)
           TAPXX(LAMBDA,SIGMA)     += TAPXX_INT(LAMBDA,SIGMA)

           TBPXX_INT(LAMBDA,SIGMA)  = TBXXP(MU,NU) * TPXXXX(MU,NU,LAMBDA,SIGMA)
           TBPXX(LAMBDA,SIGMA)     += TBPXX_INT(LAMBDA,SIGMA)

           TAMXX_INT(LAMBDA,SIGMA)  = TAXXM(MU,NU) * TMXXXX(MU,NU,LAMBDA,SIGMA)
           TAMXX(LAMBDA,SIGMA)     += TAMXX_INT(LAMBDA,SIGMA)

           TBMXX_INT(LAMBDA,SIGMA)  = TBXXM(MU,NU) * TMXXXX(MU,NU,LAMBDA,SIGMA)
           TBMXX(LAMBDA,SIGMA)     += TBMXX_INT(LAMBDA,SIGMA)

           PUT HR1A_AO_P_CURRENT_R(LAMBDA,SIGMA) = TAPXX(LAMBDA,SIGMA) 
           PUT HR1A_AO_M_CURRENT_L(LAMBDA,SIGMA) = TAMXX(LAMBDA,SIGMA)
           PUT HR1B_AO_P_CURRENT_R(LAMBDA,SIGMA) = TBPXX(LAMBDA,SIGMA)
           PUT HR1B_AO_M_CURRENT_L(LAMBDA,SIGMA) = TBMXX(LAMBDA,SIGMA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SIP_BARRIER
         
     ENDPROC HC_MULTIPLY
#    -------------------

     PROC FORM_MO_R1AB
#    -----------------

     PARDO MU, NU

            GET HR1A_AO_P_CURRENT_R(NU,MU)
            GET HR1A_AO_M_CURRENT_L(NU,MU)

            TXXP(NU,MU) = HR1A_AO_P_CURRENT_R(NU,MU)
            TXXM(NU,MU) = HR1A_AO_M_CURRENT_L(NU,MU)

            DO A

               TXAP(NU,A) = TXXP(NU,MU) * CA(MU,A)
               TXAM(NU,A) = TXXP(NU,MU) * CA(MU,A)
                
               DO I

                  TAIP_R(A,I) = TXAP(NU,A) * CA(NU,I)
                  TAIM_L(A,I) = TXAM(NU,A) * CA(NU,I)

                  PUT HR1A_MO_P_CURRENT_R(A,I) += TAIP_R(A,I)
                  PUT HR1A_MO_M_CURRENT_L(A,I) += TAIM_L(A,I)

               ENDDO I

            ENDDO A

     ENDPARDO MU, NU

     PARDO MU, NU

            GET R1B_AO_P_CURRENT_R(NU,MU)
            GET R1B_AO_M_CURRENT_L(NU,MU)

            TXXP(NU,MU) = R1B_AO_P_CURRENT_R(NU,MU)
            TXXM(NU,MU) = R1B_AO_M_CURRENT_L(NU,MU)

            DO B

               TXBP(NU,B) = TXXP(NU,MU) * CB(MU,B)
               TXBM(NU,B) = TXXP(NU,MU) * CB(MU,B)

               DO J

                  TBJP_R(B,J) = TXBP(NU,B) * CB(NU,J)
                  TBJM_L(B,J) = TXBM(NU,B) * CB(NU,J)

                  PUT HR1B_MO_P_CURRENT_R(B,J) += TBJP_R(B,J)
                  PUT HR1B_MO_M_CURRENT_L(B,J) += TBJM_L(B,J)

               ENDDO J

            ENDDO B

     ENDPARDO MU, NU
     execute sip_barrier 

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get HR1A_MO_P_CURRENT_R(A,I)
        get HR1A_MO_M_CURRENT_L(A,I)
        tmp   = HR1A_MO_P_CURRENT_R(A,I) * HR1A_MO_P_CURRENT_R(A,I)
        sumap += tmp
        tmp   = HR1A_MO_M_CURRENT_L(A,I) * HR1A_MO_M_CURRENT_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
      
        get HR1B_MO_P_CURRENT_R(B,J)
        get HR1B_MO_M_CURRENT_L(B,J)
        tmp = HR1B_MO_P_CURRENT_R(B,J) * HR1B_MO_P_CURRENT_r(B,J)
        sumbp += tmp
        tmp = HR1B_MO_M_CURRENT_L(B,J) * HR1B_MO_P_CURRENT_r(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC FORM_MO_R1AB
#    --------------------

     PROC DIRECT_AO_HC_MULT
#    ----------------------

     CALL FORM_AO_R1AB

     CALL FORM_AO_APLUSB_AMINUSB
     
     CALL HC_MULTIPLY

     CALL FORM_FOCK_CONTRIBUTION

     CALL FORM_MO_R1AB

     ENDPROC DIRECT_AO_HC_MULT
#    ----------------------

     PROC SAVE_HC_VECTORS
#    --------------------

     MCOUNT = 0.0
     DO MINDEX20
        MCOUNT  += 1.0

        IF MCOUNT == ITER_COUNT

           PARDO A, I

               GET R1A_MO_P_CURRENT_R(A,I)
               GET R1A_MO_M_CURRENT_L(A,I)

               TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I)
               TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I)

               PUT R1A_MO_P_HIST_R(A,I,MINDEX20) = TAIP_R(A,I)
               PUT R1A_MO_M_HIST_L(A,I,MINDEX20) = TAIM_L(A,I)

           ENDPARDO A, I

           PARDO B, J

               GET R1B_MO_P_CURRENT_R(B,J)
               GET R1B_MO_M_CURRENT_L(B,J)

               TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J)
               TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J)

               PUT R1B_MO_P_HIST_R(B,J,MINDEX20) = TBJP_R(B,J)
               PUT R1B_MO_M_HIST_L(B,J,MINDEX20) = TBJM_L(B,J)

           ENDPARDO B, J

        ENDIF

     ENDDO MINDEX20
     execute sip_barrier

    ENDPROC SAVE_HC_VECTORS
#   -----------------------

     PROC CONSTRUCT_A_MATRIX
#    -----------------------

     IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        SUMP_A = 0.0
        SUMM_A = 0.0
        SUMP_B = 0.0
        SUMM_B = 0.0
        HC_A_P = 0.0
        HC_A_M = 0.0

        MCOUNT = 0.0
        DO MINDEX20
           MCOUNT += 1.0
           
           NCOUNT = 0.0
           DO NINDEX20
              NCOUNT += 1.0

              IF MCOUNT == ITER_COUNT

                 PARDO A, I
                     GET HR1A_MO_P_CURRENT_R(A,I)
                     GET HR1A_MO_M_CURRENT_L(A,I)

                     TAIP_R(A,I) = HR1A_MO_P_CURRENT_R(A,I)
                     TAIM_L(A,I) = HR1A_MO_M_CURRENT_L(A,I)

                     TMP        = TAIP_R(A,I) * TAIP_R(A,I)
                     SUMP_A    += TMP

                     TMP         = TAIM_L(A,I) * TAIM_L(A,I)
                     SUMM_A     += TMP

                 ENDPARDO A, I

                 PARDO B, J
                     GET HR1B_MO_P_CURRENT_R(B,J)
                     GET HR1B_MO_M_CURRENT_L(B,J)

                     TBJP_R(B,J) = HR1B_MO_P_CURRENT_R(B,J)
                     TBJM_L(B,J) = HR1B_MO_M_CURRENT_L(B,J)

                     TMP       = TBJP_R(B,J) * TBJP_R(B,J)
                     SUMP_B   += TMP

                     TMP       = TBJM_L(B,J) * TBJM_L(B,J)
                     SUMM_B   += TMP
                 ENDPARDO B, J

                 EXECUTE SERVER_BARRIER 
                 COLLECTIVE HC_A_P += SUMP_A
                 COLLECTIVE HC_A_P += SUMP_A
                 COLLECTIVE HC_B_M += SUMM_A
                 COLLECTIVE HC_B_M += SUMM_B

              ENDIF 

           ENDDO NINDEX20

        ENDDO MINDEX20

        SUMP  = HC_A_P
        SUMM  = HC_B_M

        MCOUNT = 0.0
        NCOUNT = 0.0

        DO MINDEX20
        MCOUNT += 1.0
        IF MCOUNT == 1.0

           DO NINDEX20
              NCOUNT += 1.0

              IF NCOUNT == 1.0

                 B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                 B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM

              ENDIF

          ENDDO NINDEX20
        ENDIF

       ENDDO MINDEX20
       execute sip_barrier 

     ENDIF 

# Build  A(i,j) i=j  first

     MCOUNT = 0.0
     DO MINDEX20
        MCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

        IF MCOUNT  == ITER_COUNT 

           NCOUNT = 0.0
           DO NINDEX20
              NCOUNT += 1.0

              SUMP_A = 0.0
              SUMM_A = 0.0
              SUMP_B = 0.0
              SUMM_B = 0.0
              HC_A_P = 0.0
              HC_A_M = 0.0
               
              IF MCOUNT == NCOUNT 
  
                 PARDO A, I
                     GET HR1A_MO_P_CURRENT_R(A,I)
                     GET HR1A_MO_M_CURRENT_L(A,I)

                     TAIP_R(A,I) = HR1A_MO_P_CURRENT_R(A,I)
                     TAIM_L(A,I) = HR1A_MO_M_CURRENT_L(A,I)

                     TMP       = TAIP_R(A,I)  * TAIP_R(A,I)
                     SUMP_A    += TMP

                     TMP       = TAIM_L(A,I)  * TAIM_L(A,I)
                     SUMM_B     += TMP

                ENDPARDO A, I

                PARDO B, J
                    GET HR1B_MO_P_CURRENT_R(B,J)
                    GET HR1B_MO_M_CURRENT_L(B,J)

                    TBJP_R(B,J) = HR1B_MO_P_CURRENT_R(B,J)
                    TBJM_L(B,J) = HR1B_MO_M_CURRENT_L(B,J)

                    TMP       = TBJP_R(B,J)  * TBJP_R(B,J)
                    SUMP_B     += TMP

                    TMP       = TBJM_L(B,J)  * TBJM_L(B,J)
                    SUMM_B     += TMP
                ENDPARDO B, J

                EXECUTE SERVER_BARRIER 
                COLLECTIVE HC_A_P += SUMP_A
                COLLECTIVE HC_A_M += SUMM_A
                COLLECTIVE HC_B_P += SUMP_B
                COLLECTIVE HC_B_M += SUMM_B

                SUMP  = HC_A_P
                SUMP += HC_B_P
                SUMM  = HC_A_M
                SUMM += HC_B_M

                KCOUNT = 0.0
                DO KINDEX20
                   KCOUNT += 1.0
                   IF KCOUNT  == NCOUNT

                      LCOUNT = 0.0
                      DO LINDEX20
                         LCOUNT += 1.0
  
                         IF LCOUNT == MCOUNT

                            B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                            B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM

                         ENDIF
                      ENDDO LINDEX20
                   ENDIF
                ENDDO KINDEX20
             ENDIF
  
           ENDDO NINDEX20
        ENDIF
    
     ENDDO MINDEX20

# Build  A(i,j) i<j  now.

     NCOUNT = 0.0
     DO NINDEX20
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

        MCOUNT = 0.0
        DO MINDEX20
           MCOUNT += 1.0

           IF MCOUNT >= NCOUNT
              EXIT
           ENDIF

           IF MCOUNT == ITER_COUNT
              IF NCOUNT == ITER_COUNT
                 EXIT
              ENDIF
           ENDIF

           SUMP_A = 0.0
           SUMM_A = 0.0
           SUMP_B = 0.0
           SUMM_B = 0.0
           HC_A_P = 0.0
           HC_A_M = 0.0

           PARDO A, I
               GET R1A_MO_P_HIST_R(A,I,MINDEX20)
               GET R1A_MO_M_HIST_L(A,I,MINDEX20)

               TAIP_R(A,I) = R1A_MO_P_HIST_R(A,I,MINDEX20)
               TAIM_L(A,I) = R1A_MO_M_HIST_L(A,I,MINDEX20)

               GET HR1A_MO_P_CURRENT_R(A,I)
               GET HR1A_MO_M_CURRENT_L(A,I)

               T1AIP_R(A,I) = HR1A_MO_P_CURRENT_R(A,I)
               T1AIM_L(A,I) = HR1A_MO_M_CURRENT_L(A,I)

               TMP       = TAIP_R(A,I) * T1AIP_R(A,I)
               SUMP_A     += TMP

               TMP       = TAIM_L(A,I) * T1AIM_L(A,I)
               SUMM_A     += TMP

           ENDPARDO A, I

           PARDO B, J
                GET R1B_MO_P_HIST_R(B,J,MINDEX20)
                GET R1B_MO_M_HIST_L(B,J,MINDEX20)

                TBJP_R(B,J) = R1B_MO_P_HIST_R(B,J,MINDEX20)
                TBJM_L(B,J) = R1B_MO_M_HIST_L(B,J,MINDEX20)

                 GET HR1B_MO_P_CURRENT_R(B,J)
                 GET HR1B_MO_M_CURRENT_L(B,J)

                 T1BJP_R(B,J) = HR1B_MO_P_CURRENT_R(B,J)
                 T1BJM_L(B,J) = HR1B_MO_M_CURRENT_L(B,J)

                 TMP       = TBJP_R(B,J) * T1BJP_R(B,J)
                 SUMP_B     += TMP

                 TMP       = TBJM_L(B,J) * T1BJM_L(B,J)
                 SUMM_B     += TMP
           ENDPARDO B, J

           EXECUTE SERVER_BARRIER
           COLLECTIVE HC_A_P += SUMP_A
           COLLECTIVE HC_A_M += SUMM_A
           COLLECTIVE HC_B_P += SUMP_B
           COLLECTIVE HC_B_M += SUMM_B

           SUMP  = HC_A_P
           SUMP += HC_B_P
           SUMM  = HC_A_M
           SUMM += HC_B_M

           KCOUNT = 0.0
           DO KINDEX20
              KCOUNT += 1.0
              IF KCOUNT  == NCOUNT

                  LCOUNT = 0.0
                  DO LINDEX20
                     LCOUNT += 1.0

                     IF LCOUNT == MCOUNT
                         B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                         B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM
                      ENDIF
                  ENDDO LINDEX20
               ENDIF

           ENDDO KINDEX20

        ENDDO MINDEX20
     ENDDO NINDEX20

#bgn_debug
    sumap = 0.0
    sumam = 0.0
    do MINDEX20
    do NINDEX20
       tmp = B_A_MATRIX_P(NINDEX20,MINDEX20) * B_A_MATRIX_P(NINDEX20,MINDEX20)
       sumap += tmp
       tmp = B_A_MATRIX_M(NINDEX20,MINDEX20) * B_A_MATRIX_M(NINDEX20,MINDEX20)
       sumam += tmp
    enddo NINDEX20
    enddo MINDEX20
    execute print_scalar sumap
    execute print_scalar sumam
#end_debug

     ENDPROC CONSTRUCT_A_MATRIX
#    ------------------------

   PROC REORDER_A_EIGS
#    -------------------

     DO MINDEX20
        DO NINDEX20
           IF MINDEX20  == NINDEX20

	      TXX(MINDEX20,MINDEX20) = B_A_MATRIX_P(MINDEX20,MINDEX20)
	      EXECUTE RETURN_SVAL TXX EIG_VALUE
	      B_DIAGS_P(MINDEX20)    = EIG_VALUE

	      TXX(MINDEX20,MINDEX20) = B_A_MATRIX_M(MINDEX20,MINDEX20)
	      EXECUTE RETURN_SVAL TXX EIG_VALUE
	      B_DIAGS_M(MINDEX20)    = EIG_VALUE
           ENDIF
         ENDDO NINDEX20
     ENDDO MINDEX20

     EXECUTE PROCESS_EIGS B_DIAGS_P EIG_VECS_P_R
     EXECUTE PROCESS_EIGS B_DIAGS_M EIG_VECS_M_L

     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC DIAG_A_MATRIX
#    ------------------

# For RPA we only need the right eigen-vectors  only. As a result, 
# the ACES III SIP format is good enough. The ACES IV
# format is now allowing both left and right vectors transfered to the
# SIAL code. 

# A_MATRIX_P and  A_MATRIX_M are very small (maximum order is 
# is currently set to maximum subspace dimension 20. Both arrays
# must be static. 

     EXECUTE XGEEV  B_A_MATRIX_P  EIG_VECS_P_R
     EXECUTE XGEEV  B_A_MATRIX_M  EIG_VECS_M_L

     execute sip_barrier

     ENDPROC DIAG_A_MATRIX
#    ---------------------
# 
# This is a critical step in Davidson algorithm. The new set of vectors are 
# formed from the eigenvectors of the subspace matrix and the original vectors 
# that is used to built the small matrix. Prciesely speaking, 
# A (N,N) = C^(t) H C^(t), the Eigenvectors of A are b(N,N). 
# the new vectors are fromed by  C_new(m,n) = Sum{i} b(i,k) * C_i(m,n) 
# (C_new_k= b(1,k) * C1 + b(2,k) * C2 + ....)(k=1,..N))
#

      PROC FORM_NEW_VECTORS 
#     ---------------------
       PARDO A, I 

           NCOUNT = 0.0
           DO NINDEX20 
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              MCOUNT = 0.0
              DO MINDEX20 
                 MCOUNT += 1.0

                 IF MCOUNT >  ITER_COUNT
                    EXIT
                 ENDIF

                 TMNP_R(MINDEX20,NINDEX20) = EIG_VECS_P_R(MINDEX20,NINDEX20) 
                 TMNM_L(MINDEX20,NINDEX20) = EIG_VECS_M_L(MINDEX20,NINDEX20)

                 GET R1A_MO_P_HIST_R(A,I,MINDEX20)
                 GET R1A_MO_M_HIST_L(A,I,MINDEX20)

                 T2AP_R(A,I,MINDEX20) = R1A_MO_P_HIST_R(A,I,MINDEX20)
                 T2AM_L(A,I,MINDEX20) = R1A_MO_M_HIST_L(A,I,MINDEX20)

                 T3AP_R(A,I,NINDEX20) = T2AP_R(A,I,MINDEX20) * TMNP_R(MINDEX20,NINDEX20)
                 T3AM_L(A,I,NINDEX20) = T2AM_L(A,I,MINDEX20) * TMNM_L(MINDEX20,NINDEX20)
 
                 PUT Y1P_A_R(A,I,NINDEX20) += T3AP_R(A,I,NINDEX20)
                 PUT Y1M_A_L(A,I,NINDEX20) += T3AM_L(A,I,NINDEX20)

              ENDDO MINDEX20

           ENDDO NINDEX20

       ENDPARDO A, I 

       PARDO B, J

           NCOUNT      = 0.0
           DO NINDEX20
              NCOUNT += 1.0

                IF NCOUNT > ITER_COUNT
                   EXIT
                ENDIF 

                MCOUNT = 0.0
                DO MINDEX20
                   MCOUNT += 1.0

                   IF MCOUNT > ITER_COUNT
                      EXIT
                   ENDIF 

                   TMNP_R(MINDEX20,NINDEX20) = EIG_VECS_P_R(MINDEX20,NINDEX20)
                   TMNM_L(MINDEX20,NINDEX20) = EIG_VECS_M_L(MINDEX20,NINDEX20)

                   GET R1B_MO_P_HIST_R(B,J,MINDEX20)
                   GET R1B_MO_M_HIST_L(B,J,MINDEX20)

                   T2BP_R(B,J,MINDEX20) = R1B_MO_P_HIST_R(B,J,MINDEX20)
                   T2BM_L(B,J,MINDEX20) = R1B_MO_M_HIST_L(B,J,MINDEX20)

                   T3BP_R(B,J,NINDEX20) = T2BP_R(B,J,MINDEX20) * TMNP_R(MINDEX20,NINDEX20)
                   T3BM_L(B,J,NINDEX20) = T2BM_L(B,J,MINDEX20) * TMNM_L(MINDEX20,NINDEX20)
 
                   PUT Y1P_B_R(B,J,NINDEX20) += T3BP_R(B,J,NINDEX20)
                   PUT Y1M_B_L(B,J,NINDEX20) += T3BM_L(B,J,NINDEX20)

                ENDDO MINDEX20

           ENDDO  NINDEX20
 
       ENDPARDO B, J

       execute sip_barrier

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     ncount = 0.0
     do a
     do i
        do nindex20 
        ncount += 1.0
        if ncount == iter_count 
        get Y1P_A_R(A,I,nindex20)
        get Y1M_A_L(A,I,nindex20)
        tmp   = Y1P_A_R(A,I,nindex20) * Y1P_A_R(A,I,nindex20)
        sumap += tmp
        tmp   = Y1M_A_L(A,I,nindex20) * Y1M_A_L(A,I,nindex20)
        sumam += tmp
        endif 
        enddo nindex20
     enddo i
     enddo a
     ncount=0.0
     do b
     do j
        do nindex20
        ncount += 1.0
        if ncount == iter_count
        get Y1P_B_R(B,J,nindex20)
        get Y1M_B_L(B,J,nindex20)
        tmp = Y1P_B_R(B,J,nindex20) * Y1P_B_R(B,J,nindex20)
        sumbp += tmp
        tmp = Y1M_B_L(B,J,nindex20) * Y1M_B_L(B,J,nindex20)
        sumbm += tmp
        endif 
        enddo nindex20
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug


      ENDPROC FORM_NEW_VECTORS 
#     ------------------------

      PROC FORM_NEW_HBAR_Y_VECTORS 
#     ---------------------------
       PARDO A, I 

           NCOUNT = 0.0
           DO NINDEX20 
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              MCOUNT = 0.0
              DO MINDEX20 
                 MCOUNT += 1.0

                 IF MCOUNT >  ITER_COUNT
                    EXIT
                 ENDIF

                 TMNP_R(MINDEX20,NINDEX20) = EIG_VECS_P_R(MINDEX20,NINDEX20) 
                 TMNM_L(MINDEX20,NINDEX20) = EIG_VECS_M_L(MINDEX20,NINDEX20)

                 GET HR1A_MO_P_HIST_R(A,I,MINDEX20)
                 GET HR1A_MO_M_HIST_L(A,I,MINDEX20)

                 T2AP_R(A,I,MINDEX20) = HR1A_MO_P_HIST_R(A,I,MINDEX20)
                 T2AM_L(A,I,MINDEX20) = HR1A_MO_M_HIST_L(A,I,MINDEX20)

                 T3AP_R(A,I,NINDEX20) = T2AP_R(A,I,MINDEX20) * TMNP_R(MINDEX20,NINDEX20)
                 T3AM_L(A,I,NINDEX20) = T2AM_L(A,I,MINDEX20) * TMNM_L(MINDEX20,NINDEX20)
 
                 PUT HY1P_A_R(A,I,NINDEX20) += T3AP_R(A,I,NINDEX20)
                 PUT HY1M_A_L(A,I,NINDEX20) += T3AM_L(A,I,NINDEX20)

              ENDDO MINDEX20

           ENDDO NINDEX20

       ENDPARDO A, I 

       PARDO B, J

           NCOUNT      = 0.0
           DO NINDEX20
              NCOUNT += 1.0

                IF NCOUNT > ITER_COUNT
                   EXIT
                ENDIF 

                MCOUNT = 0.0
                DO MINDEX20
                   MCOUNT += 1.0

                   IF MCOUNT > ITER_COUNT
                      EXIT
                   ENDIF 

                   TMNP_R(MINDEX20,NINDEX20) = EIG_VECS_P_R(MINDEX20,NINDEX20)
                   TMNM_L(MINDEX20,NINDEX20) = EIG_VECS_M_L(MINDEX20,NINDEX20)

                   GET HR1B_MO_P_HIST_R(B,J,MINDEX20)
                   GET HR1B_MO_M_HIST_L(B,J,MINDEX20)

                   T2BP_R(B,J,MINDEX20) = HR1B_MO_P_HIST_R(B,J,MINDEX20)
                   T2BM_L(B,J,MINDEX20) = HR1B_MO_M_HIST_L(B,J,MINDEX20)

                   T3BP_R(B,J,NINDEX20) = T2BP_R(B,J,MINDEX20) * TMNP_R(MINDEX20,NINDEX20)
                   T3BM_L(B,J,NINDEX20) = T2BM_L(B,J,MINDEX20) * TMNM_L(MINDEX20,NINDEX20)
 
                   PUT HY1P_B_R(B,J,NINDEX20) += T3BP_R(B,J,NINDEX20)
                   PUT HY1M_B_L(B,J,NINDEX20) += T3BM_L(B,J,NINDEX20)

                ENDDO MINDEX20

           ENDDO  NINDEX20
 
       ENDPARDO B, J

       execute sip_barrier

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     ncount = 0.0
     do a
     do i
        do nindex20 
        ncount += 1.0
        if ncount == iter_count 
        get HY1P_A_R(A,I,nindex20)
        get HY1M_A_L(A,I,nindex20)
        tmp   = HY1P_A_R(A,I,nindex20) * HY1P_A_R(A,I,nindex20)
        sumap += tmp
        tmp   = HY1M_A_L(A,I,nindex20) * HY1M_A_L(A,I,nindex20)
        sumam += tmp
        endif 
        enddo nindex20
     enddo i
     enddo a
     ncount=0.0
     do b
     do j
        do nindex20
        ncount += 1.0
        if ncount == iter_count
        get HY1P_B_R(B,J,nindex20)
        get HY1M_B_L(B,J,nindex20)
        tmp = HY1P_B_R(B,J,nindex20) * HY1P_B_R(B,J,nindex20)
        sumbp += tmp
        tmp = HY1M_B_L(B,J,nindex20) * HY1M_B_L(B,J,nindex20)
        sumbm += tmp
        endif 
        enddo nindex20
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC FORM_NEW_HBAR_Y_VECTORS 
#    -------------------------------

     PROC SELECT_HBAR_Y_VECTOR_TOGO
#    ------------------------------

     IF ITER_COUNT == ONE

        NCOUNT = 0.0
      
       DO MINDEX20
         NCOUNT += ONE
         IF NCOUNT > ONE
            EXIT
         ENDIF 

         PARDO A, I 

              GET R1A_MO_P_NEW_R(A,I,MINDEX20)
              GET R1A_MO_M_NEW_L(A,I,MINDEX20)

              GET HR1A_MO_P_NEW_R(A,I,MINDEX20)
              GET HR1A_MO_M_NEW_L(A,I,MINDEX20)

              TAP_R(A,I) = R1A_MO_P_NEW_R(A,I,MINDEX20)
              TAM_L(A,I) = R1A_MO_M_NEW_L(A,I,MINDEX20)

              T1AP_R(A,I) = HR1A_MO_P_NEW_R(A,I,MINDEX20)
              T1AM_L(A,I) = HR1A_MO_M_NEW_L(A,I,MINDEX20)

              PUT R1A_MO_P_PICKED_R(A,I) = TAP_R(A,I)
              PUT R1A_MO_M_PICKED_L(A,I) = TAM_L(A,I)

              PUT HR1A_MO_P_PICKED_R(A,I) = T1AP_R(A,I)
              PUT HR1A_MO_M_PICKED_L(A,I) = T1AM_L(A,I)

         ENDPARDO A, I 

       ENDDO MINDEX20

       NCOUNT = 0.0
       DO MINDEX20
          NCOUNT += 1.0
          IF NCOUNT > ONE
             EXIT
          ENDIF 

          PARDO B, J

              GET R1B_MO_P_NEW_R(B,J,MINDEX20)
              GET R1B_MO_M_NEW_L(B,J,MINDEX20)

              GET HR1B_MO_P_NEW_R(B,J,MINDEX20)
              GET HR1B_MO_M_NEW_L(B,J,MINDEX20)

              TBP_R(B,J) = R1B_MO_P_NEW_R(B,J,MINDEX20)
              TBM_L(B,J) = R1B_MO_M_NEW_L(B,J,MINDEX20)

              T1BP_R(B,J) = HR1B_MO_P_NEW_R(B,J,MINDEX20)
              T1BM_L(B,J) = HR1B_MO_M_NEW_L(B,J,MINDEX20)

              PUT R1B_MO_P_PICKED_R(B,J) = TBP_R(B,J)
              PUT R1B_MO_M_PICKED_L(B,J) = TBM_L(B,J)

              PUT HR1B_MO_P_PICKED_R(B,J) = T1BP_R(B,J)
              PUT HR1B_MO_M_PICKED_L(B,J) = T1BM_L(B,J)

          ENDPARDO B, J

       ENDDO MINDEX20
       execute sip_barrier 

    ELSE

        DO NINDEX20
           NCOUNT += 1.0
                    
           IF NCOUNT > ONE
              EXIT
           ENDIF 

           MCOUNT = 0.0
           DO MINDEX20
              MCOUNT += 1.0
              IF NCOUNT > ITER_COUNT 
                 EXIT
              ENDIF 
          
              PARDO A, I
                  GET  HR1A_MO_P_HIST_R(A,I,NINDEX20)
                  GET  HR1A_MO_M_HIST_L(A,I,NINDEX20)

                  GET  HY1P_A_R(A,I,MINDEX20)
                  GET  HY1M_A_L(A,I,MINDEX20)

                  TAP_R(A,I) = HR1A_MO_P_HIST_R(A,I,NINDEX20)
                  TAM_L(A,I) = HR1A_MO_M_HIST_L(A,I,NINDEX20)

                  T1AP_R(A,I) = HY1P_A_R(A,I,MINDEX20)
                  T1AM_L(A,I) = HY1M_A_L(A,I,MINDEX20)

                  TMP = TAP_R(A,I) * TAP_R(A,I)
                  OVLPA_P_R_INTMD += TMP

                  TMP = TAM_L(A,I) * TAM_L(A,I)
                  OVLPA_M_L_INTMD += TMP

              ENDPARDO A, I

              EXECUTE SIP_BARRIER 
              COLLECTIVE OVLPA_P_R += OVLPA_P_R_INTMD 
              COLLECTIVE OVLPA_M_L += OVLPA_M_L_INTMD

              PARDO B,J 
                  GET  HR1B_MO_P_HIST_R(B,J,NINDEX20)
                  GET  HR1B_MO_M_HIST_L(B,J,NINDEX20)

                  GET  HY1P_B_R(B,J,NINDEX20)
                  GET  HY1M_B_L(B,J,NINDEX20)

                  TBP_R(B,J) = HR1B_MO_P_HIST_R(B,J,NINDEX20)
                  TBM_L(B,J) = HR1B_MO_M_HIST_L(B,J,NINDEX20)

                  T1BP_R(B,J) = HY1P_B_R(B,J,MINDEX20)
                  T1BM_L(B,J) = HY1M_B_L(B,J,MINDEX20)

                  TMP = TBP_R(B,J) * TBP_R(B,J)
                  OVLPB_P_R_INTMD += TMP

                  TMP = TBM_L(B,J) * TBM_L(B,J)
                  OVLPB_M_L_INTMD += TMP

              ENDPARDO B, J

              EXECUTE SIP_BARRIER 
              COLLECTIVE OVLPB_P_R += OVLPB_P_R_INTMD 
              COLLECTIVE OVLPB_M_L += OVLPB_M_L_INTMD

              OVLPAB_P_R  = OVLPA_P_R
              OVLPAB_P_R += OVLPB_P_R
              OVLPAB_M_L  = OVLPA_M_L
              OVLPAB_M_L += OVLPB_M_L

              KCOUNT = 0.0
                  DO KINDEX20
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT
                        OVLPAB_HISTORY_P_R(KINDEX20) = OVLPAB_P_R
                        OVLPAB_HISTORY_M_L(KINDEX20) = OVLPAB_M_L
                     ENDIF
                  ENDDO KINDEX20
 
           ENDDO MINDEX20
        ENDDO NINDEX20

     ENDIF 

     execute sip_barrier 
#
# This SIPs returns the index corresponding to the maximum value 
# in the first static array. The return scalar gives the pointer
# to vector that has the maximum overlap with the guess. 
# 

     OVLPAB_P_MAX_R = 0.0
     OVLPAB_M_MAX_L = 0.0
   
     EXECUTE REPORT_MAXIMUM OVLPAB_HISTORY_P_R OVLPAB_P_MAX_R
     EXECUTE REPORT_MAXIMUM OVLPAB_HISTORY_M_L OVLPAB_M_MAX_L
#
# Get vectors corresponding to the maximum overlap and put them
# in the distributed arrrays labelled as _PICKED_ and return.
#
     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0

        IF MCOUNT == OVLPAB_P_MAX_R
           PARDO A, I

               GET HY1P_A_R(A,I,MINDEX20)
               TAP_R(A,I)  = HY1P_A_R(A,I,MINDEX20)
               PUT HR1A_MO_P_PICKED_R(A,I)  =  TAP_R(A,I)

           ENDPARDO A, I
        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0

        IF MCOUNT == OVLPAB_M_MAX_L 

           PARDO A, I
               GET HY1M_A_L(A,I,MINDEX20)
               TAM_L(A,I)  = HY1M_A_L(A,I,MINDEX20)

               PUT HR1A_MO_M_PICKED_L(A,I)  = TAM_L(A,I)
           ENDPARDO A, I

        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0
        IF MCOUNT == OVLPAB_P_MAX_R
           PARDO B, J
               GET HY1P_B_R(B,J,MINDEX20)
               TBP_R(B,J)  = HY1P_B_R(B,J,MINDEX20)
               PUT HR1B_MO_P_PICKED_R(B,J)  = TBP_R(B,J)
           ENDPARDO B, J

        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0
        IF MCOUNT == OVLPAB_M_MAX_L
           PARDO B, J
                GET HY1M_B_L(B,J,MINDEX20)
                TBM_L(B,J)  = HY1M_B_L(B,J,MINDEX20)
                PUT HR1B_MO_M_PICKED_L(B,J)  = TBM_L(B,J)
           ENDPARDO B, J
        ENDIF 

     ENDDO MINDEX20

     execute sip_barrier 

#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     do a
     do i
        get HR1A_MO_P_PICKED_R(A,I)
        get HR1A_MO_M_PICKED_L(A,I)
        tmp   = HR1A_MO_P_PICKED_R(A,I) * HR1A_MO_P_PICKED_R(A,I)
        sumap += tmp
        tmp   = HR1A_MO_M_PICKED_L(A,I) * HR1A_MO_M_PICKED_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get HR1B_MO_P_PICKED_R(B,J)
        get HR1B_MO_M_PICKED_L(B,J)
        tmp = HR1B_MO_P_PICKED_R(B,J) * HR1B_MO_P_PICKED_R(B,J)
        sumbp += tmp
        tmp = HR1B_MO_M_PICKED_L(B,J) * HR1B_MO_M_PICKED_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC SELECT_HBAR_Y_VECTOR_TOGO
#    ---------------------------------

     PROC SELECT_VECTOR_TOGO
#    -----------------------

     IF ITER_COUNT == ONE

        NCOUNT = 0.0
      
       DO MINDEX20
         NCOUNT += ONE
         IF NCOUNT > ONE
            EXIT
         ENDIF 

         PARDO A, I 

              GET R1A_MO_P_NEW_R(A,I,MINDEX20)
              GET R1A_MO_M_NEW_L(A,I,MINDEX20)

              GET HR1A_MO_P_NEW_R(A,I,MINDEX20)
              GET HR1A_MO_M_NEW_L(A,I,MINDEX20)

              TAP_R(A,I) = R1A_MO_P_NEW_R(A,I,MINDEX20)
              TAM_L(A,I) = R1A_MO_M_NEW_L(A,I,MINDEX20)

              T1AP_R(A,I) = HR1A_MO_P_NEW_R(A,I,MINDEX20)
              T1AM_L(A,I) = HR1A_MO_M_NEW_L(A,I,MINDEX20)

              PUT R1A_MO_P_PICKED_R(A,I) = TAP_R(A,I)
              PUT R1A_MO_M_PICKED_L(A,I) = TAM_L(A,I)

              PUT HR1A_MO_P_PICKED_R(A,I) = T1AP_R(A,I)
              PUT HR1A_MO_M_PICKED_L(A,I) = T1AM_L(A,I)

         ENDPARDO A, I 

       ENDDO MINDEX20

       NCOUNT = 0.0
       DO MINDEX20
          NCOUNT += 1.0
          IF NCOUNT > ONE
             EXIT
          ENDIF 

          PARDO B, J

              GET R1B_MO_P_NEW_R(B,J,MINDEX20)
              GET R1B_MO_M_NEW_L(B,J,MINDEX20)

              GET HR1B_MO_P_NEW_R(B,J,MINDEX20)
              GET HR1B_MO_M_NEW_L(B,J,MINDEX20)

              TBP_R(B,J) = R1B_MO_P_NEW_R(B,J,MINDEX20)
              TBM_L(B,J) = R1B_MO_M_NEW_L(B,J,MINDEX20)

              T1BP_R(B,J) = HR1B_MO_P_NEW_R(B,J,MINDEX20)
              T1BM_L(B,J) = HR1B_MO_M_NEW_L(B,J,MINDEX20)

              PUT R1B_MO_P_PICKED_R(B,J) = TBP_R(B,J)
              PUT R1B_MO_M_PICKED_L(B,J) = TBM_L(B,J)

              PUT HR1B_MO_P_PICKED_R(B,J) = T1BP_R(B,J)
              PUT HR1B_MO_M_PICKED_L(B,J) = T1BM_L(B,J)

          ENDPARDO B, J

       ENDDO MINDEX20
       execute sip_barrier 

    ELSE

        DO NINDEX20
           NCOUNT += 1.0
                    
           IF NCOUNT > ONE
              EXIT
           ENDIF 

           MCOUNT = 0.0
           DO MINDEX20
              MCOUNT += 1.0
              IF NCOUNT > ITER_COUNT 
                 EXIT
              ENDIF 
          
              PARDO A, I
                  GET  R1A_MO_P_HIST_R(A,I,NINDEX20)
                  GET  R1A_MO_M_HIST_L(A,I,NINDEX20)

                  GET  Y1P_A_R(A,I,MINDEX20)
                  GET  Y1M_A_L(A,I,MINDEX20)

                  TAP_R(A,I) = R1A_MO_P_HIST_R(A,I,NINDEX20)
                  TAM_L(A,I) = R1A_MO_M_HIST_L(A,I,NINDEX20)

                  T1AP_R(A,I) = Y1P_A_R(A,I,MINDEX20)
                  T1AM_L(A,I) = Y1M_A_L(A,I,MINDEX20)

                  TMP = TAP_R(A,I) * TAP_R(A,I)
                  OVLPA_P_R_INTMD += TMP

                  TMP = TAM_L(A,I) * TAM_L(A,I)
                  OVLPA_M_L_INTMD += TMP

              ENDPARDO A, I

              EXECUTE SIP_BARRIER 
              COLLECTIVE OVLPA_P_R += OVLPA_P_R_INTMD 
              COLLECTIVE OVLPA_M_L += OVLPA_M_L_INTMD

              PARDO B,J 
                  GET  R1B_MO_P_HIST_R(B,J,NINDEX20)
                  GET  R1B_MO_M_HIST_L(B,J,NINDEX20)

                  GET  Y1P_B_R(B,J,NINDEX20)
                  GET  Y1M_B_L(B,J,NINDEX20)

                  TBP_R(B,J) = R1B_MO_P_HIST_R(B,J,NINDEX20)
                  TBM_L(B,J) = R1B_MO_M_HIST_L(B,J,NINDEX20)

                  T1BP_R(B,J) = Y1P_B_R(B,J,MINDEX20)
                  T1BM_L(B,J) = Y1M_B_L(B,J,MINDEX20)

                  TMP = TBP_R(B,J) * TBP_R(B,J)
                  OVLPB_P_R_INTMD += TMP

                  TMP = TBM_L(B,J) * TBM_L(B,J)
                  OVLPB_M_L_INTMD += TMP

              ENDPARDO B, J

              EXECUTE SIP_BARRIER 
              COLLECTIVE OVLPB_P_R += OVLPB_P_R_INTMD 
              COLLECTIVE OVLPB_M_L += OVLPB_M_L_INTMD

              OVLPAB_P_R  = OVLPA_P_R
              OVLPAB_P_R += OVLPB_P_R
              OVLPAB_M_L  = OVLPA_M_L
              OVLPAB_M_L += OVLPB_M_L

              KCOUNT = 0.0
                  DO KINDEX20
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT
                        OVLPAB_HISTORY_P_R(KINDEX20) = OVLPAB_P_R
                        OVLPAB_HISTORY_M_L(KINDEX20) = OVLPAB_M_L
                     ENDIF
                  ENDDO KINDEX20
 
           ENDDO MINDEX20
        ENDDO NINDEX20

     ENDIF 

     execute sip_barrier 
#
# This SIPs returns the index corresponding to the maximum value 
# in the first static array. The return scalar gives the pointer
# to vector that has the maximum overlap with the guess. 
# 

     OVLPAB_P_MAX_R = 0.0
     OVLPAB_M_MAX_L = 0.0
   
     EXECUTE REPORT_MAXIMUM OVLPAB_HISTORY_P_R OVLPAB_P_MAX_R
     EXECUTE REPORT_MAXIMUM OVLPAB_HISTORY_M_L OVLPAB_M_MAX_L
#
# Get vectors corresponding to the maximum overlap and put them
# in the distributed arrrays labelled as _PICKED_ and return.
#
     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0

        IF MCOUNT == OVLPAB_P_MAX_R
           PARDO A, I

               GET Y1P_A_R(A,I,MINDEX20)
               GET R1A_MO_P_NEW_R(A,I,MINDEX20)

               TAP_R(A,I)  = Y1P_A_R(A,I,MINDEX20)
               T1AP_R(A,I) = R1A_MO_P_NEW_R(A,I,MINDEX20)

               PUT R1A_MO_P_PICKED_R(A,I)  =  TAP_R(A,I)
           ENDPARDO A, I
        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0

        IF MCOUNT == OVLPAB_M_MAX_L 

           PARDO A, I
               GET Y1M_A_L(A,I,MINDEX20)
               GET R1A_MO_M_NEW_L(A,I,MINDEX20)

               TAM_L(A,I)  = Y1M_A_L(A,I,MINDEX20)
               T1AM_L(A,I) = R1A_MO_M_NEW_L(A,I,MINDEX20)

               PUT R1A_MO_M_PICKED_L(A,I)  = TAM_L(A,I)
           ENDPARDO A, I

        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0
        IF MCOUNT == OVLPAB_P_MAX_R
           PARDO B, J
               GET Y1P_B_R(B,J,MINDEX20)
               GET R1B_MO_P_NEW_R(B,J,MINDEX20)

               TBP_R(B,J)  = Y1P_B_R(B,J,MINDEX20)
               T1BP_R(B,J) = R1B_MO_P_NEW_R(B,J,MINDEX20)

               PUT R1B_MO_P_PICKED_R(B,J)  = TBP_R(B,J)
           ENDPARDO B, J

        ENDIF 
     ENDDO MINDEX20 

     MCOUNT = 0.0
     DO MINDEX20 
        MCOUNT += 1.0
        IF MCOUNT == OVLPAB_M_MAX_L
           PARDO B, J
                GET Y1M_B_L(B,J,MINDEX20)
                GET R1B_MO_M_NEW_L(B,J,MINDEX20)

                TBM_L(B,J)  = Y1M_B_L(B,J,MINDEX20)
                T1BM_L(B,J) = R1B_MO_M_NEW_L(B,J,MINDEX20)

                PUT R1B_MO_M_PICKED_L(B,J)  = TBM_L(B,J)
           ENDPARDO B, J
        ENDIF 

     ENDDO MINDEX20

     execute sip_barrier 

#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     do a
     do i
        get R1A_MO_P_PICKED_R(A,I)
        get R1A_MO_M_PICKED_L(A,I)
        tmp   = R1A_MO_P_PICKED_R(A,I) * R1A_MO_P_PICKED_R(A,I)
        sumap += tmp
        tmp   = R1A_MO_M_PICKED_L(A,I) * R1A_MO_M_PICKED_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get R1B_MO_P_PICKED_R(B,J)
        get R1B_MO_M_PICKED_L(B,J)
        tmp = R1B_MO_P_PICKED_R(B,J) * R1B_MO_P_PICKED_R(B,J)
        sumbp += tmp
        tmp = R1B_MO_M_PICKED_L(B,J) * R1B_MO_M_PICKED_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC SELECT_VECTOR_TOGO
#    --------------------------

     PROC  FORM_HBAR_Y_VECS 
#    ----------------------

     PARDO A, I
         GET R1A_MO_P_PICKED_R(A,I)
         GET R1A_MO_M_PICKED_L(A,I)

         TAP_R(A,I)  = R1A_MO_P_PICKED_R(A,I)
         TAM_L(A,I)  = R1A_MO_M_PICKED_L(A,I)

         PUT R1A_MO_P_CURRENT_R(A,I)  =  TAP_R(A,I)
         PUT R1A_MO_M_CURRENT_L(A,I)  =  TAM_L(A,I)
     ENDPARDO A, I

    PARDO B, J 
         GET R1B_MO_P_PICKED_R(B,J)
         GET R1B_MO_M_PICKED_L(B,J)

         TBP_R(B,J)  = R1B_MO_P_PICKED_R(B,J)
         TBM_L(B,J)  = R1B_MO_M_PICKED_L(B,J)

         PUT R1B_MO_P_CURRENT_R(B,J)  =  TBP_R(B,J)
         PUT R1B_MO_M_CURRENT_L(B,J)  =  TBM_L(B,J)
     ENDPARDO B, J

     EXECUTE SIP_BARRIER 

     CALL DIRECT_AO_HC_MULT 

    PARDO A, I
         GET HR1A_MO_P_CURRENT_R(A,I)
         GET HR1A_MO_M_CURRENT_L(A,I)

         TAP_R(A,I)  = R1A_MO_P_CURRENT_R(A,I)
         TAM_L(A,I)  = R1A_MO_M_CURRENT_L(A,I)

         PUT HR1A_MO_P_PICKED_R(A,I)  =  TAP_R(A,I)
         PUT HR1A_MO_M_PICKED_L(A,I)  =  TAM_L(A,I)
     ENDPARDO A, I

    PARDO B, J
         GET HR1B_MO_P_CURRENT_R(B,J)
         GET HR1B_MO_M_CURRENT_L(B,J)

         TBP_R(B,J)  = HR1B_MO_P_CURRENT_R(B,J)
         TBM_L(B,J)  = HR1B_MO_M_CURRENT_L(B,J)

         PUT R1B_MO_P_PICKED_R(B,J)  =  TBP_R(B,J)
         PUT R1B_MO_M_PICKED_L(B,J)  =  TBM_L(B,J)
     ENDPARDO B, J

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_HBAR_Y_VECS 
#    -------------------------

     PROC FORM_RESIDUAL_VECTOR
#    -------------------------
# 
      EXECUTE RETURN_SELECTED B_DIAGS_P  IMAX_P
      EXECUTE RETURN_SELECTED B_DIAGS_M  IMAX_M

      OMEGA_P   = IMAX_P
      OMEGA_M   = IMAX_M
      MOMEGA_P  = OMEGA_P 
      MOMEGA_M  = OMEGA_M
      MOMEGA_P *= -1.0
      MOMEGA_M *= -1.0

       PARDO A, I

             GET R1A_MO_P_PICKED_R(A,I)
             GET R1A_MO_M_PICKED_L(A,I)

             GET HR1A_MO_P_PICKED_R(A,I)
             GET HR1A_MO_M_PICKED_L(A,I)

             TAIP_R(A,I) = R1A_MO_P_PICKED_R(A,I)
             TAIM_L(A,I) = R1A_MO_M_PICKED_L(A,I)

             TAIP_R(A,I) *= MOMEGA_P
             TAIM_L(A,I) *= MOMEGA_M

             T1AIP_R(A,I) = HR1A_MO_P_PICKED_R(A,I)
             T1AIM_L(A,I) = HR1A_MO_M_PICKED_L(A,I)
  
             T1AIP_R(A,I) += TAIP_R(A,I)
             T1AIM_L(A,I) += TAIM_L(A,I)

             PUT RESIDUEA_P_VEC_R(A,I) = T1AIP_R(A,I) 
             PUT RESIDUEA_M_VEC_L(A,I) = T1AIM_L(A,I) 

       ENDPARDO A, I

       PARDO B, J

             GET R1B_MO_P_PICKED_R(B,J)
             GET R1B_MO_M_PICKED_L(B,J)

             GET HR1B_MO_P_PICKED_R(B,J)
             GET HR1B_MO_M_PICKED_L(B,J)

             TBJP_R(B,J) = R1B_MO_P_PICKED_R(B,J)
             TBJM_L(B,J) = R1B_MO_M_PICKED_L(B,J)

             TBJP_R(B,J) *= MOMEGA_P
             TBJM_L(B,J) *= MOMEGA_M

             T1BJP_R(B,J) = HR1B_MO_P_PICKED_R(B,J)
             T1BJM_L(B,J) = HR1B_MO_M_PICKED_L(B,J)
 
             T1BJP_R(B,J) += TBJP_R(B,J)
             T1BJM_L(B,J) += TBJM_L(B,J)

             PUT RESIDUEB_P_VEC_R(B,J) = T1BJP_R(B,J)
             PUT RESIDUEB_M_VEC_L(B,J) = T1BJM_L(B,J)

       ENDPARDO B, J

       execute sip_barrier 

# Checking the norm of the residual vector.

       NORM_INTMD_P_R = 0.0
       NORM_INTMD_M_L = 0.0
       NORMA_P_R = 0.0
       NORMA_M_L = 0.0

       PARDO A, I

             GET RESIDUEA_P_VEC_R(A,I)
             GET RESIDUEA_M_VEC_L(A,I)
             
             TAP_R(A,I) = RESIDUEA_P_VEC_R(A,I)
             TAM_L(A,I) = RESIDUEA_M_VEC_L(A,I)

             TMP = TAP_R(A,I) * TAP_R(A,I)
             NORM_INTMD_P_R += TMP

             TMP = TAM_L(A,I) * TAM_L(A,I)
             NORM_INTMD_M_L += TMP

       ENDPARDO A, I
       
       execute sip_barrier 
       
       COLLECTIVE NORMA_P_R += NORM_INTMD_P_R
       COLLECTIVE NORMA_M_L += NORM_INTMD_M_L

       NORM_INTMD_P_R = 0.0
       NORM_INTMD_M_L = 0.0
       NORMB_P_R = 0.0
       NORMB_M_L = 0.0

       PARDO B, J

             GET RESIDUEB_P_VEC_R(B,J)
             GET RESIDUEB_M_VEC_L(B,J)

             TBP_R(B,J) = RESIDUEB_P_VEC_R(B,J)
             TBM_L(B,J) = RESIDUEB_M_VEC_L(B,J)

             TMP = TBP_R(B,J) * TBP_R(B,J)
             NORM_INTMD_P_R += TMP

             TMP = TBM_L(B,J) * TBM_L(B,J)
             NORM_INTMD_M_L += TMP

       ENDPARDO B, J

       execute sip_barrier

       COLLECTIVE NORMB_P_R += NORM_INTMD_P_R
       COLLECTIVE NORMB_M_L += NORM_INTMD_M_L

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get RESIDUEA_P_VEC_R(A,I)
        get RESIDUEA_M_VEC_L(A,I)
        tmp   = RESIDUEA_P_VEC_R(A,I) * RESIDUEA_P_VEC_R(A,I)
        sumap += tmp
        tmp   = RESIDUEA_M_VEC_L(A,I) *  RESIDUEA_M_VEC_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get RESIDUEB_P_VEC_R(B,J)
        get RESIDUEB_M_VEC_L(B,J)
        tmp = RESIDUEB_P_VEC_R(B,J) *  RESIDUEB_P_VEC_R(B,J)
        sumbp += tmp
        tmp = RESIDUEB_M_VEC_L(B,J) *  RESIDUEB_M_VEC_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug


      ENDPROC FORM_RESIDUAL_VECTOR
#     ----------------------------

      PROC FORM_CORRECTION_VECTOR
#     ---------------------------

       PARDO A, I

             GET RESIDUEA_P_VEC_R(A,I)
             GET RESIDUEA_M_VEC_L(A,I)

             GET H_A_DIAGONAL(A,I)

             TAIP_R(A,I) = RESIDUEA_P_VEC_R(A,I)
             TAIM_L(A,I) = RESIDUEA_M_VEC_L(A,I)

             TAIP_R(A,I) *= OMEGA_P
             TAIM_L(A,I) *= OMEGA_M

             T1AI(A,I)   =  H_A_DIAGONAL(A,I)
             T1AI(A,I)  *=  -1.0

             T1AIP_R(A,I) = OMEGA_P
             T1AIM_L(A,I) = OMEGA_M

             T1AIP_R(A,I) += T1AI(A,I)
             T1AIM_L(A,I) += T1AI(A,I)

             EXECUTE APPLY_DEN2 TAIP_R T1AIP_R
             EXECUTE APPLY_DEN2 TAIM_L T1AIM_L

             T2AIP_R(A,I) = TAIP_R(A,I)
             T2AIM_L(A,I) = TAIM_L(A,I)

             PUT CORR_VECA_INTMD_P_R(A,I) = TAIP_R(A,I)
             PUT CORR_VECA_INTMD_M_L(A,I) = TAIM_L(A,I)

       ENDPARDO A, I

       PARDO B, J

             GET RESIDUEB_P_VEC_R(B,J)
             GET RESIDUEB_M_VEC_L(B,J)

             GET H_B_DIAGONAL(B,J)

             TBJP_R(B,J) = RESIDUEB_P_VEC_R(B,J)
             TBJM_L(B,J) = RESIDUEB_M_VEC_L(B,J)

             TBJP_R(B,J) *= OMEGA_P
             TBJM_L(B,J) *= OMEGA_M

             T1BJ(B,J)   =  H_B_DIAGONAL(B,J)
             T1BJ(B,J)  *=  -1.0

             T1BJP_R(B,J) = OMEGA_P
             T1BJM_L(B,J) = OMEGA_M

             T1BJP_R(B,J) += T1BJ(B,J)
             T1BJM_L(B,J) += T1BJ(B,J)

             EXECUTE APPLY_DEN2 TBJP_R T1BJP_R
             EXECUTE APPLY_DEN2 TBJM_L T1BJM_L

             T2BJP_R(B,J) = TBJP_R(B,J)
             T2BJM_L(B,J) = TBJM_L(B,J)

             PUT CORR_VECB_INTMD_P_R(B,J) = TBJP_R(B,J)
             PUT CORR_VECB_INTMD_M_L(B,J) = TBJM_L(B,J)

       ENDPARDO B, J

       execute sip_barrier
#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get CORR_VECA_INTMD_P_R(A,I)
        get CORR_VECA_INTMD_M_L(A,I)
        tmp   = CORR_VECA_INTMD_P_R(A,I) * CORR_VECA_INTMD_P_R(A,I)
        sumap += tmp
        tmp   = CORR_VECA_INTMD_M_L(A,I) * CORR_VECA_INTMD_M_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get CORR_VECB_INTMD_P_R(B,J)
        get CORR_VECB_INTMD_M_L(B,J)
        tmp = CORR_VECB_INTMD_P_R(B,J) *  CORR_VECB_INTMD_P_R(B,J)
        sumbp += tmp
        tmp = CORR_VECB_INTMD_M_L(B,J) *  CORR_VECB_INTMD_M_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug


      ENDPROC FORM_CORRECTION_VECTOR
#     ------------------------------

      PROC FORM_BIORTHOGANAL_VECS
#     ---------------------------

       NORMA_INTMD_P_R_NEW = 0.0
       NORMA_INTMD_M_L_NEW = 0.0
       NORMA_P_R_NEW = 0.0
       NORMA_M_L_NEW = 0.0

       NORMB_INTMD_P_R_NEW = 0.0
       NORMB_INTMD_M_L_NEW = 0.0
       NORMB_P_R_NEW = 0.0
       NORMB_M_L_NEW = 0.0

       MCOUNT = 0.0
       DO MINDEX20

          MCOUNT += 1.0
          IF MCOUNT > ITER_COUNT
             EXIT
          ENDIF 

          PARDO A, I

             GET CORR_VECA_INTMD_P_R(A,I)
             GET CORR_VECA_INTMD_M_L(A,I)

             TAP_R(A,I) = CORR_VECA_INTMD_P_R(A,I)
             TAM_L(A,I) = CORR_VECA_INTMD_M_L(A,I)

             GET R1A_MO_P_HIST_R(A,I,MINDEX20)
             GET R1A_MO_M_HIST_L(A,I,MINDEX20)

             T1AP_R(A,I) = R1A_MO_P_HIST_R(A,I,MINDEX20)
             T1AM_L(A,I) = R1A_MO_M_HIST_L(A,I,MINDEX20)

             TMP  = T1AP_R(A,I) * TAP_R(A,I)
             PUT ORTHO_COEFSA_P_RL(MINDEX20,MINDEX20) += TMP

             TMP = T1AM_L(A,I) * TAM_L(A,I)
             PUT ORTHO_COEFSA_M_RL(MINDEX20,MINDEX20) += TMP

          ENDPARDO A, I

          PARDO B, J 

             GET CORR_VECB_INTMD_P_R(B,J)
             GET CORR_VECB_INTMD_M_L(B,J)

             TBP_R(B,J) = CORR_VECB_INTMD_P_R(B,J)
             TBM_L(B,J) = CORR_VECB_INTMD_M_L(B,J)

             GET R1B_MO_P_HIST_R(B,J,MINDEX20)
             GET R1B_MO_M_HIST_L(B,J,MINDEX20)

             T1BP_R(B,J) = R1B_MO_P_HIST_R(B,J,MINDEX20)
             T1BM_L(B,J) = R1B_MO_M_HIST_L(B,J,MINDEX20)

             TMP  = T1BM_L(B,J) * TBP_R(B,J)
             PUT ORTHO_COEFSB_P_RL(MINDEX20,MINDEX20) += TMP

             TMP = T1BP_R(B,J) * TBM_L(B,J)
             PUT ORTHO_COEFSB_M_RL(MINDEX20,MINDEX20) += TMP

          ENDPARDO B, J

       ENDDO MINDEX20

       execute sip_barrier

       PARDO A, I

           GET CORR_VECA_INTMD_P_R(A,I)
           GET CORR_VECA_INTMD_M_L(A,I)

           TAP_R(A,I) = CORR_VECA_INTMD_P_R(A,I)
           TAM_L(A,I) = CORR_VECA_INTMD_M_L(A,I)

           TAP_R(A,I) *= NORMA_P_R_NEW
           TAM_L(A,I) *= NORMA_M_L_NEW

           MCOUNT = 0
           DO MINDEX20
              MCOUNT += ONE
              IF MCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET  ORTHO_COEFSA_P_RL(MINDEX20,MINDEX20)
              GET  ORTHO_COEFSA_M_RL(MINDEX20,MINDEX20)

              TNORM_P_R(MINDEX20,MINDEX20) = ORTHO_COEFSA_P_RL(MINDEX20,MINDEX20)
              TNORM_M_L(MINDEX20,MINDEX20) = ORTHO_COEFSA_M_RL(MINDEX20,MINDEX20)
              EXECUTE RETURN_SVAL TNORM_P_R RLP_NORM
              EXECUTE RETURN_SVAL TNORM_M_L RLM_NORM

              GET R1A_MO_P_HIST_R(A,I,MINDEX20)
              GET R1A_MO_M_HIST_L(A,I,MINDEX20)

              T1AP_R(A,I) = R1A_MO_P_HIST_R(A,I,MINDEX20)
              T1AM_L(A,I) = R1A_MO_M_HIST_L(A,I,MINDEX20)

              T1AP_R(A,I) *= RLP_NORM
              T1AM_L(A,I) *= RLM_NORM
              T1AP_R(A,I) *= -1.0
              T1AM_L(A,I) *= -1.0

              TAP_R(A,I) += T1AP_R(A,I)
              TAM_L(A,I) += T1AM_L(A,I)

           ENDDO MINDEX20

           PUT R1A_MO_P_INTMD_R(A,I) = TAP_R(A,I)
           PUT R1A_MO_M_INTMD_L(A,I) = TAM_L(A,I)

       ENDPARDO A, I

       PARDO B, J

           GET CORR_VECB_INTMD_P_R(B,J)
           GET CORR_VECB_INTMD_M_L(B,J)

           TBP_R(B,J) = CORR_VECB_INTMD_P_R(B,J)
           TBM_L(B,J) = CORR_VECB_INTMD_M_L(B,J)

           TBP_R(B,J) *= NORMB_P_R_NEW
           TBM_L(B,J) *= NORMB_M_L_NEW

           MCOUNT = 0
           DO MINDEX20
              MCOUNT += ONE
              IF MCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

             GET  ORTHO_COEFSB_P_RL(MINDEX20,MINDEX20)
             GET  ORTHO_COEFSB_M_RL(MINDEX20,MINDEX20)

             TNORM_P_R(MINDEX20,MINDEX20) = ORTHO_COEFSB_P_RL(MINDEX20,MINDEX20)
             TNORM_M_L(MINDEX20,MINDEX20) = ORTHO_COEFSB_M_RL(MINDEX20,MINDEX20)

             EXECUTE RETURN_SVAL TNORM_P_R RLP_NORM
             EXECUTE RETURN_SVAL TNORM_M_L RLM_NORM

             GET R1B_MO_P_HIST_R(B,J,MINDEX20)
             GET R1B_MO_M_HIST_L(B,J,MINDEX20)

             T1BP_R(B,J) = R1B_MO_P_HIST_R(B,J,MINDEX20)
             T1BM_L(B,J) = R1B_MO_M_HIST_L(B,J,MINDEX20)
 
             T1BP_R(B,J) *= RLP_NORM
             T1BM_L(B,J) *= RLM_NORM
             T1BP_R(B,J) *= -1.0
             T1BM_L(B,J) *= -1.0

             TBP_R(B,J) += T1BP_R(B,J)
             TBM_L(B,J) += T1BM_L(B,J)

           ENDDO MINDEX20

           PUT R1B_MO_P_INTMD_R(B,J) = TBP_R(B,J)
           PUT R1B_MO_M_INTMD_L(B,J) = TBM_L(B,J)

       ENDPARDO B, J

       execute sip_barrier

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get R1A_MO_P_CURRENT_R(A,I)
        get R1A_MO_M_CURRENT_L(A,I)
        tmp   = R1A_MO_P_CURRENT_R(A,I) * R1A_MO_P_CURRENT_R(A,I)
        sumap += tmp
        tmp   = R1A_MO_M_CURRENT_L(A,I) * R1A_MO_M_CURRENT_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get R1B_MO_P_CURRENT_R(B,J)
        get R1B_MO_M_CURRENT_L(B,J)
        tmp = R1B_MO_P_CURRENT_R(B,J) * R1B_MO_P_CURRENT_R(B,J)
        sumbp += tmp
        tmp = R1B_MO_M_CURRENT_L(B,J) * R1B_MO_M_CURRENT_L(B,J) 
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug
       ENDPROC FORM_BIORTHOGANAL_VECS
#      ------------------------------

     PROC RESCALE_NEW_VECS
#    ---------------------

     NORM_INTMD_P_R_A = 0.0
     NORM_INTMD_M_L_A = 0.0
     NORM_INTMD_P_R_B = 0.0
     NORM_INTMD_M_L_B = 0.0
     NORMA_P_R = 0.0
     NORMA_M_L = 0.0

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I) 
         GET R1A_MO_M_INTMD_L(A,I) 

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I) 

         TMP = TAIP_R(A,I) * TAIP_R(A,I)
         NORM_INTMD_P_R_A += TMP 
 
         TMP = TAIM_L(A,I) * TAIM_L(A,I)
         NORM_INTMD_M_L_A += TMP 

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J) 
         GET R1B_MO_M_INTMD_L(B,J) 

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)
  
         TMP = TBJP_R(B,J) * TBJP_R(B,J)  
         NORM_INTMD_P_R_B += TMP 

         TMP = TBJM_L(B,J) * TBJM_L(B,J)  
         NORM_INTMD_P_R_B += TMP 

     ENDPARDO B, J

     execute sip_barrier
     COLLECTIVE NORMA_P_R_A += NORM_INTMD_P_R_A
     COLLECTIVE NORMA_M_L_A += NORM_INTMD_M_L_A
     COLLECTIVE NORMA_P_R_B += NORM_INTMD_P_R_B
     COLLECTIVE NORMA_M_L_B += NORM_INTMD_M_L_B

     NORMA_P_R  = NORMA_P_R_A
     NORMA_P_R += NORMA_P_R_B 

     NORMA_M_L  = NORMA_M_L_A
     NORMA_M_L += NORMA_M_L_B

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORMA_P_R EXPONENT
     EXECUTE NORM_FAC NORMA_M_L EXPONENT
     INV_SQRT_NORM_PR = NORMA_P_R
     INV_SQRT_NORM_ML = NORMA_M_L

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I)
         GET R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I)*= INV_SQRT_NORM_PR
         TAIM_L(A,I)*= INV_SQRT_NORM_ML

         PUT  R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
         PUT  R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J)
         GET R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) *= INV_SQRT_NORM_PR
         TBJM_L(B,J) *= INV_SQRT_NORM_PR

         PUT  R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
         PUT  R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO B, J
     execute sip_barrier

     ENDPROC RESCALE_NEW_VECS
#    ------------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX20
        OVLPAB_HISTORY_P_R(MINDEX20) = 0.0
        OVLPAB_HISTORY_M_L(MINDEX20) = 0.0
        DO NINDEX20
           TS(MINDEX20,NINDEX20) = 0.0
           B_A_MATRIX_P(MINDEX20,NINDEX20)   = TS(MINDEX20,NINDEX20)
           B_A_MATRIX_M(MINDEX20,NINDEX20)   = TS(MINDEX20,NINDEX20)
           PUT ORTHO_COEFSA_P_RL(MINDEX20,NINDEX20) = TS(MINDEX20,NINDEX20)
           PUT ORTHO_COEFSA_M_RL(MINDEX20,NINDEX20) = TS(MINDEX20,NINDEX20)
           PUT ORTHO_COEFSB_P_RL(MINDEX20,NINDEX20) = TS(MINDEX20,NINDEX20)
           PUT ORTHO_COEFSB_M_RL(MINDEX20,NINDEX20) = TS(MINDEX20,NINDEX20)
        ENDDO NINDEX20
     ENDDO MINDEX20

     DO NINDEX20
       PARDO A, I
           TAP_R(A,I) = 0.0
           TAM_L(A,I) = 0.0
           PUT Y1P_A_R(A,I,NINDEX20) = TAP_R(A,I)
           PUT Y1M_A_L(A,I,NINDEX20) = TAM_L(A,I)
       ENDPARDO A, I
       PARDO B, J
           TBP_R(B,J) = 0.0
           TBM_L(B,J) = 0.0
           PUT Y1P_B_R(B,J,NINDEX20) = TBP_R(B,J)
           PUT Y1M_B_L(B,J,NINDEX20) = TBM_L(B,J)
       ENDPARDO  B, J
     ENDDO NINDEX20

     EXECUTE SIP_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC FORM_FOCK_DIAGS
#    --------------------
#
# -----prepare f_ii diagonal = Sdii
#
     PARDO i, i1
      WHERE i==i1
#
           tii(i1,i)      = fock_a(i1,i)
           execute return_diagonal4 tii
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1

# -----prepare f_aa diagonal = DDaa

     PARDO a, a1
      WHERE a==a1

           taa(a,a1)      = fock_a(a,a1)
           execute return_diagonal4 taa
           put DDaa(a,a1) = taa(a,a1)
#
     ENDPARDO a, a1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
      WHERE j==j1
#
        tjj(j1,j)      = fock_b(j1,j)
        execute return_diagonal4 tjj
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1

# -----prepare f_bb diagonal = DDbb

     PARDO b, b1
      WHERE b==b1
#
        tbb(b,b1)      = fock_b(b,b1)
        execute return_diagonal4 tbb
        put DDbb(b,b1) = tbb(b,b1)
#
     ENDPARDO b, b1

     execute sip_barrier
#
# ---------compute T(a,i)=F(a,a)-f(i,i)
#
     PARDO a, i
#
           tai(a,i) = 0.0
#
           do a1
#
              get         DDaa(a,a1)
              tia(i,a1) = 1.0
              taa(a1,a) = DDaa(a,a1)
#
              t2ai(a,i) = tia(i,a1)*taa(a1,a)
              tai(a,i) += t2ai(a,i)
#
           enddo a1
#
           do i1
#
              get         DDii(i1,i)
              t2ia(i1,a)= 1.0
              tii(i,i1) = DDii(i1,i)
#
              t2ai(a,i) = tii(i,i1)*t2ia(i1,a)
              t2ai(a,i)*= -1.0
              tai(a,i) += t2ai(a,i)
#
           enddo i1
#
           PUT R1DA(a,i)+=tai(a,i)
#
     ENDPARDO a, i

# ---------compute T(b,j)=F(b,b)-f(j,j)
#
     PARDO b, j
#
           tbj(b,j)=0.0
#
           do b1
#
              get         DDbb(b,b1)
              tjb(j,b1) = 1.0
              tbb(b1,b) = DDbb(b,b1)
              t2bj(b,j) = tjb(j,b1)*tbb(b1,b)
              tbj(b,j) += t2bj(b,j)
#
           enddo b1
#
           do j1
#
              get         DDjj(j1,j)
              t2jb(j1,b)= 1.0
              tjj(j,j1) = DDjj(j1,j)
              t2bj(b,j) = tjj(j,j1)*t2jb(j1,b)
              t2bj(b,j)*= -1.0
              tbj(b,j) += t2bj(b,j)
#
           enddo j1
#
           PUT R1DB(b,j)+= tbj(b,j)
#
     ENDPARDO b, j
#
     execute sip_barrier

     ENDPROC FORM_FOCK_DIAGS
#    -----------------------

     PROC CREATE_ARRAYS
#    ------------------

       CREATE R1A_MO_P_START_R
       CREATE R1A_MO_M_START_L
       cREATE R1B_MO_P_START_R
       CREATE R1B_MO_M_START_L
       CREATE R1A_MO_P_CURRENT_R
       CREATE R1A_MO_M_CURRENT_L
       CREATE R1B_MO_P_CURRENT_R
       CREATE R1B_MO_M_CURRENT_L
       CREATE R1A_AO_P_CURRENT_R
       CREATE R1A_AO_M_CURRENT_L
       CREATE R1B_AO_P_CURRENT_R
       CREATE R1B_AO_M_CURRENT_L
       CREATE HR1A_AO_P_CURRENT_R
       CREATE HR1A_AO_M_CURRENT_L
       CREATE HR1B_AO_P_CURRENT_R
       CREATE HR1B_AO_M_CURRENT_L
       CREATE HR1A_MO_P_CURRENT_R
