       DELETE HR1A_MO_M_NEW_L
       DELETE HR1B_MO_P_NEW_R
       DELETE HR1B_MO_M_NEW_L
       DELETE R1A_MO_P_PICKED_R
       DELETE R1A_MO_M_PICKED_L
