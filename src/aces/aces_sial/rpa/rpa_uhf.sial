       DELETE R1B_MO_M_START_L
       DELETE R1A_MO_P_CURRENT_R
       DELETE R1A_MO_M_CURRENT_L
       DELETE R1B_MO_P_CURRENT_R
       DELETE R1B_MO_M_CURRENT_L
       DELETE R1A_AO_P_CURRENT_R
       DELETE R1A_AO_M_CURRENT_L
       DELETE R1B_AO_P_CURRENT_R
       DELETE R1B_AO_M_CURRENT_L
       DELETE HR1A_AO_P_CURRENT_R
       DELETE HR1A_AO_M_CURRENT_L
       DELETE HR1B_AO_P_CURRENT_R
       DELETE HR1B_AO_M_CURRENT_L
