      SCALAR A_VALUE_M

      SCALAR MAX_SUBSP_DIM 

      PROC FORM_INITIAL_GUESS
#     -----------------------

      DO MAX_NO_ROOTS
         PARDO A, I
             INIT_RVEC_AA(A,I,MAX_NO_ROOTS) = 0.0
             DIAGA(a,i)                     = 0.0
         ENDPARDO A, I
      ENDDO MAX_NO_ROOTS 

      DO MAX_NO_ROOTS
         PARDO B, J
             INIT_RVEC_BB(B,J,MAX_NO_ROOTS) = 0.0
             DIAGB(b,j)                     = 0.0
         ENDPARDO B, J
      ENDDO MAX_NO_ROOTS 

      DO a
      DO i
         GET R1DA(a,i)
         Tai(a,i)   = R1DA(a,i)
         DIAGA(a,i) = Tai(a,i)
      ENDDO i
      ENDDO a

     DO b
     DO j
        GET R1DB(b,j)
        Tbj(b,j)   = R1DB(b,j)
        DIAGB(b,j) = Tbj(b,j)
     ENDDO j
     ENDDO b

     EXECUTE SIP_BARRIER

     EXECUTE FORM_RPA_GUESS DIAGA INIT_RVEC_AA
     EXECUTE FORM_RPA_GUESS DIAGB INIT_RVEC_BB


     ENDPROC FORM_INITIAL_GUESS
#    --------------------------

     PROC MOVE_GUESS_2CURRENT
#    -------------------------

      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_AA MYROOT
      IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF
      EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_BB MYROOT
      IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF

     RCOUNT = 0.0
     DO MAX_NO_ROOTS
        RCOUNT += ONE

        IF RCOUNT > ONE
           EXIT
        ENDIF 

        PARDO A, I

            TAIP_R(A,I) =  INIT_RVEC_AA(A,I,MAX_NO_ROOTS)
            TAIM_L(A,I) =  INIT_RVEC_AA(A,I,MAX_NO_ROOTS)
  
            PUT R1A_MO_P_INTMD_R(A,I) = TAIP_R(A,I)
            PUT R1A_MO_M_INTMD_L(A,I) = TAIM_L(A,I)

            PUT INIT_AVEC_R(A,I) = TAIP_R(A,I)
            PUT INIT_AVEC_L(A,I) = TAIM_L(A,I)

        ENDPARDO A, I

        PARDO B, J

            TBJP_R(B,J) =  INIT_RVEC_BB(B,J,MAX_NO_ROOTS)
            TBJM_L(B,J) =  INIT_RVEC_BB(B,J,MAX_NO_ROOTS)

            PUT R1B_MO_P_INTMD_R(B,J) = TBJP_R(B,J)
            PUT R1B_MO_M_INTMD_L(B,J) = TBJM_L(B,J)

            PUT INIT_BVEC_R(B,J) = TBJP_R(B,J)
            PUT INIT_BVEC_L(B,J) = TBJM_L(B,J)

        ENDPARDO B, J


     ENDDO MAX_NO_ROOTS

     EXECUTE SIP_BARRIER 

#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get R1A_MO_P_INTMD_R(A,I)
        get R1A_MO_M_INTMD_L(A,I)
        tmp   = R1A_MO_P_INTMD_R(A,I) * R1A_MO_P_INTMD_R(A,I)
        sumap += tmp
        tmp   = R1A_MO_M_INTMD_L(A,I) * R1A_MO_M_INTMD_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get R1B_MO_P_INTMD_R(B,J)
        get R1B_MO_M_INTMD_L(B,J)
        tmp = R1B_MO_P_INTMD_R(B,J) * R1B_MO_P_INTMD_R(B,J)
        sumbp += tmp
        tmp = R1B_MO_M_INTMD_L(B,J) * R1B_MO_M_INTMD_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     NORM_INTMD_P_R_A = 0.0
     NORM_INTMD_M_L_A = 0.0
     NORM_INTMD_P_R_B = 0.0
     NORM_INTMD_M_L_B = 0.0
     NORMA_P_R = 0.0
     NORMA_M_L = 0.0

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I) 
         GET R1A_MO_M_INTMD_L(A,I) 

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I) 

         TMP = TAIP_R(A,I) * TAIP_R(A,I)
         NORM_INTMD_P_R_A += TMP 
 
         TMP = TAIM_L(A,I) * TAIM_L(A,I)
         NORM_INTMD_M_L_A += TMP 

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J) 
         GET R1B_MO_M_INTMD_L(B,J) 

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)
  
         TMP = TBJP_R(B,J) * TBJP_R(B,J)  
         NORM_INTMD_P_R_B += TMP 

         TMP = TBJM_L(B,J) * TBJM_L(B,J)  
         NORM_INTMD_M_L_B += TMP 

     ENDPARDO B, J

     execute sip_barrier
     COLLECTIVE NORMA_P_R_A += NORM_INTMD_P_R_A
     COLLECTIVE NORMA_M_L_A += NORM_INTMD_M_L_A
     COLLECTIVE NORMA_P_R_B += NORM_INTMD_P_R_B
     COLLECTIVE NORMA_M_L_B += NORM_INTMD_M_L_B

     NORMA_P_R  = NORMA_P_R_A
     NORMA_P_R += NORMA_P_R_B 

     NORMA_M_L  = NORMA_M_L_A
     NORMA_M_L += NORMA_M_L_B

     EXPONENT = HALF 
     EXECUTE NORM_FAC NORMA_P_R EXPONENT
     EXECUTE NORM_FAC NORMA_M_L EXPONENT
     INV_SQRT_NORM_PR = NORMA_P_R
     INV_SQRT_NORM_ML = NORMA_M_L

     PARDO A, I

         GET R1A_MO_P_INTMD_R(A,I)
         GET R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I) = R1A_MO_P_INTMD_R(A,I)
         TAIM_L(A,I) = R1A_MO_M_INTMD_L(A,I)

         TAIP_R(A,I)*= INV_SQRT_NORM_PR
         TAIM_L(A,I)*= INV_SQRT_NORM_ML

         PUT  R1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
         PUT  R1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO A, I

     PARDO B, J

         GET R1B_MO_P_INTMD_R(B,J)
         GET R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) = R1B_MO_P_INTMD_R(B,J)
         TBJM_L(B,J) = R1B_MO_M_INTMD_L(B,J)

         TBJP_R(B,J) *= INV_SQRT_NORM_PR
         TBJM_L(B,J) *= INV_SQRT_NORM_ML

         PUT  R1B_MO_P_CURRENT_R(B,J) = TBJP_R(B,J)
         PUT  R1B_MO_M_CURRENT_L(B,J) = TBJM_L(B,J)

     ENDPARDO B, J
     EXECUTE SIP_BARRIER 
#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get R1A_MO_P_CURRENT_R(A,I)
        get R1A_MO_M_CURRENT_L(A,I)
        tmp   = R1A_MO_P_CURRENT_R(A,I) * R1A_MO_P_CURRENT_R(A,I)
        sumap += tmp
        tmp   = R1A_MO_M_CURRENT_L(A,I) * R1A_MO_M_CURRENT_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get R1B_MO_P_CURRENT_R(B,J)
        get R1B_MO_M_CURRENT_L(B,J)
        tmp = R1B_MO_P_CURRENT_R(B,J) * R1B_MO_P_CURRENT_R(B,J)
        sumbp += tmp
        tmp = R1B_MO_M_CURRENT_L(B,J) * R1B_MO_M_CURRENT_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC MOVE_GUESS_2CURRENT
#    ---------------------------

     PROC SAVE_C_VECTORS
#    --------------------

     MCOUNT = ZERO
     DO MINDEX20

        MCOUNT  += ONE
        IF MCOUNT == ITER_COUNT

        PARDO A, I

           GET R1A_MO_P_CURRENT_R(A,I)
           GET R1A_MO_M_CURRENT_L(A,I)

           TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I)
           TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I)

           TAIP_RX(A,I,MINDEX20) = TAIP_R(A,I)
           TAIM_LX(A,I,MINDEX20) = TAIM_L(A,I)

           PUT R1A_MO_P_HIST_R(A,I,MINDEX20) = TAIP_RX(A,I,MINDEX20)
           PUT R1A_MO_M_HIST_L(A,I,MINDEX20) = TAIM_LX(A,I,MINDEX20)

        ENDPARDO A, I
       
        PARDO B, J

           GET R1B_MO_P_CURRENT_R(B,J)
           GET R1B_MO_M_CURRENT_L(B,J)

           TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J)
           TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J)

            TBJP_RX(B,J,MINDEX20) = TBJP_R(B,J)
            TBJM_LX(B,J,MINDEX20) = TBJM_L(B,J)

           PUT R1B_MO_P_HIST_R(B,J,MINDEX20) = TBJP_RX(B,J,MINDEX20)
           PUT R1B_MO_M_HIST_L(B,J,MINDEX20) = TBJM_LX(B,J,MINDEX20) 

        ENDPARDO B, J
        ENDIF

     ENDDO MINDEX20

     EXECUTE SIP_BARRIER 

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     ncount = 0.0
     do mindex20
     ncount += 1.0
     if ncount > iter_count
        exit
     endif 
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get R1A_MO_P_HIST_R(A,I,MINDEX20)
        get R1A_MO_M_HIST_L(A,I,MINDEX20)
        tmp   = R1A_MO_P_HIST_R(A,I,MINDEX20) * R1A_MO_P_HIST_R(A,I,MINDEX20)
        sumap += tmp
        tmp   = R1A_MO_M_HIST_L(A,I,MINDEX20) * R1A_MO_M_HIST_L(A,I,MINDEX20)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
        get R1B_MO_P_HIST_R(B,J,MINDEX20)
        get R1B_MO_M_HIST_L(B,J,MINDEX20)
        tmp = R1B_MO_P_HIST_R(B,J,MINDEX20) * R1B_MO_P_HIST_R(B,J,MINDEX20)
        sumbp += tmp
        tmp = R1B_MO_M_HIST_L(B,J,MINDEX20) * R1B_MO_M_HIST_L(B,J,MINDEX20)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     enddo mindex20
     endif
#end_debug


    ENDPROC SAVE_C_VECTORS
#   -----------------------

     PROC FORM_FOCK_CONTRIBUTION
#    ---------------------------

     PARDO A, I,

         TAI_R(A,I) = 0.0
         TAI_L(A,I) = 0.0

         DO I1

            GET R1A_MO_P_CURRENT_R(A,I1)
            GET R1A_MO_M_CURRENT_L(A,I1)

            TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I1) * FOCK_A(I1,I)
            TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I1) * FOCK_A(I1,I)

            TAI_R(A,I) -= TAIP_R(A,I)
            TAI_L(A,I) -= TAIM_L(A,I)

         ENDDO I1

         DO A1

            GET R1A_MO_P_CURRENT_R(A1,I)
            GET R1A_MO_M_CURRENT_L(A1,I)

            TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A1,I) * FOCK_A(A,A1)
            TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A1,I) * FOCK_A(A,A1)

            TAI_R(A,I) += TAIP_R(A,I)
            TAI_L(A,I) += TAIM_L(A,I)

          ENDDO A1

          PUT HR1A_MO_P_CURRENT_R(A,I) += TAI_R(A,I)
          PUT HR1A_MO_M_CURRENT_L(A,I) += TAI_L(A,I)

     ENDPARDO A, I

     PARDO B, J

         TBJ_R(B,J) = 0.0
         TBJ_L(B,J) = 0.0

         DO J1

            GET R1B_MO_P_CURRENT_R(B,J1)
            GET R1B_MO_M_CURRENT_L(B,J1)
   
            TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J1) * FOCK_B(J1,J)
            TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J1) * FOCK_B(J1,J)

            TBJ_R(B,J) -= TBJP_R(B,J)
            TBJ_L(B,J) -= TBJM_L(B,J)

         ENDDO J1

         DO B1

            GET R1B_MO_P_CURRENT_R(B1,J)
            GET R1B_MO_M_CURRENT_L(B1,J)
  
            TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B1,J) * FOCK_B(B1,B)
            TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B1,J) * FOCK_B(B1,B)

            TBJ_R(B,J) -= TBJP_R(B,J)
            TBJ_L(B,J) -= TBJM_L(B,J)

         ENDDO B1

         PUT HR1B_MO_P_CURRENT_R(B,J) += TBJ_R(B,J)
         PUT HR1B_MO_M_CURRENT_L(B,J) += TBJ_L(B,J)

     ENDPARDO B, J

     EXECUTE SIP_BARRIER 

#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get HR1A_MO_P_CURRENT_R(A,I)
        get HR1A_MO_M_CURRENT_L(A,I)
#        execute dump_amp HR1A_MO_P_CURRENT_R(A,I)
#        execute dump_amp HR1A_MO_M_CURRENT_L(A,I)

        tmp   = HR1A_MO_P_CURRENT_R(A,I) * HR1A_MO_P_CURRENT_R(A,I)
        sumap += tmp
        tmp   = HR1A_MO_M_CURRENT_L(A,I) * HR1A_MO_M_CURRENT_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j

        get HR1B_MO_P_CURRENT_R(B,J)
        get HR1B_MO_M_CURRENT_L(B,J)
        tmp = HR1B_MO_P_CURRENT_R(B,J) * HR1B_MO_P_CURRENT_R(B,J)
        sumbp += tmp
        tmp = HR1B_MO_M_CURRENT_L(B,J) * HR1B_MO_M_CURRENT_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC FORM_FOCK_CONTRIBUTION
#    ---------------------------

     PROC FORM_AO_R1AB
#    -----------------

      PARDO A, I

          GET R1A_MO_P_CURRENT_R(A,I)
          GET R1A_MO_M_CURRENT_L(A,I)

          TAIP_R(A,I) = R1A_MO_P_CURRENT_R(A,I)
          TAIM_L(A,I) = R1A_MO_M_CURRENT_L(A,I)

          DO MU

             TXIP_T(MU,I) = TAIP_R(A,I) * CA(MU,A)
             TXIM_T(MU,I) = TAIM_L(A,I) * CA(MU,A)

             DO NU

                TXXP_T(MU,NU) = TXIP_T(MU,I) * CA(NU,I)
                TXXM_T(MU,NU) = TXIM_T(MU,I) * CA(NU,I)

                PUT R1A_AO_P_CURRENT_R(MU,NU) +=  TXXP_T(MU,NU)
                PUT R1A_AO_M_CURRENT_L(MU,NU) +=  TXXM_T(MU,NU)

             ENDDO NU
          ENDDO MU 

      ENDPARDO A, I

      PARDO B, J

          GET R1B_MO_P_CURRENT_R(B,J)
          GET R1B_MO_M_CURRENT_L(B,J)

          TBJP_R(B,J) = R1B_MO_P_CURRENT_R(B,J)
          TBJM_L(B,J) = R1B_MO_M_CURRENT_L(B,J)

          DO MU

            TXJP_T(MU,J) = TBJP_R(B,J) * CB(MU,B)
            TXJM_T(MU,J) = TBJM_L(B,J) * CB(MU,B)

            DO NU

               TXXP_T(MU,NU) = TXJP_T(MU,J) * CB(NU,J)
               TXXM_T(MU,NU) = TXjM_T(MU,J) * CB(NU,J)

               PUT R1B_AO_P_CURRENT_R(MU,NU) =  TXXP_T(MU,NU)
               PUT R1B_AO_M_CURRENT_L(MU,NU) =  TXXM_T(MU,NU)

            ENDDO NU
          ENDDO MU

      ENDPARDO B, J

      EXECUTE SIP_BARRIER 

#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do mu
     do nu
        get R1A_AO_P_CURRENT_R(mu,nu)
        get R1A_AO_M_CURRENT_L(mu,nu)
        tmp   = R1A_AO_P_CURRENT_R(mu,nu) * R1A_AO_M_CURRENT_L(mu,nu)
        sumap += tmp
        tmp   = R1A_AO_M_CURRENT_L(mu,nu) * R1A_AO_M_CURRENT_L(mu,nu)
        sumam += tmp
     enddo nu
     enddo mu
     do mu
     do nu

        get R1B_AO_P_CURRENT_R(mu,nu)
        get R1B_AO_M_CURRENT_L(mu,nu)
        tmp = R1B_AO_P_CURRENT_R(mu,nu) * R1B_AO_P_CURRENT_r(mu,nu)
        sumbp += tmp
        tmp = R1B_AO_M_CURRENT_L(mu,nu) * R1B_AO_P_CURRENT_r(mu,nu)
        sumbm += tmp
     enddo nu
     enddo mu
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC FORM_AO_R1AB
#    --------------------

     PROC GET_2INTS
#    --------------
     PARDO MU, NU, LAMBDA, SIGMA

        COMPUTE_INTEGRALS AOINT(MU,LAMBDA,NU,SIGMA)
        PREPARE SAOINT(MU,LAMBDA,NU,SIGMA) = AOINT(MU,LAMBDA,NU,SIGMA)

     ENDPARDO MU, NU, LAMBDA, SIGMA
     EXECUTE SERVER_BARRIER 
   
     ENDPROC GET_2INTS
#    -----------------

     PROC HC_MULTIPLY
#    ----------------
#  (A+B)(ai,bj)  R+_old(b,J)  = R+_new(a,i)
#  (A-B)(ai,bj)  R-_old(b,J)  = R__new(a,i)

#  All possible spin-combinations are included.

     PARDO MU, NU, LAMBDA, SIGMA

         TAPXX(MU,LAMBDA) = 0.0
         TAMXX(MU,LAMBDA) = 0.0
         TBPXX(MU,LAMBDA) = 0.0
         TBMXX(MU,LAMBDA) = 0.0

         REQUEST SAOINT(MU,LAMBDA,NU,SIGMA) SIGMA
         REQUEST SAOINT(MU,SIGMA,LAMBDA,NU) SIGMA
         REQUEST SAOINT(MU,SIGMA,NU,LAMBDA) SIGMA
 
         TC0XXXX(MU,LAMBDA,NU,SIGMA) = SAOINT(MU,LAMBDA,NU,SIGMA)
         TE1XXXX(MU,SIGMA,LAMBDA,NU) = SAOINT(MU,SIGMA,LAMBDA,NU)
         TE2XXXX(MU,SIGMA,NU,LAMBDA) = SAOINT(MU,SIGMA,NU,LAMBDA) 

         GET R1A_AO_P_CURRENT_R(NU,SIGMA)
         GET R1B_AO_P_CURRENT_R(NU,SIGMA)  

         GET R1A_AO_M_CURRENT_L(NU,SIGMA)
         GET R1B_AO_M_CURRENT_L(NU,SIGMA)

         TAXXP(NU,SIGMA) = R1A_AO_P_CURRENT_R(NU,SIGMA)
         TBXXP(NU,SIGMA) = R1B_AO_P_CURRENT_R(NU,SIGMA)

         TAXXM(NU,SIGMA) = R1A_AO_M_CURRENT_L(NU,SIGMA)
         TBXXM(NU,SIGMA) = R1B_AO_M_CURRENT_L(NU,SIGMA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TAPXX_INT(MU,LAMBDA) *= 4.0
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TAPXX_INT(MU,LAMBDA) *= -1.0
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TE2XXXX(MU,SIGMA,NU,LAMBDA)
         TAPXX_INT(MU,LAMBDA) *= -1.0
         TAPXX(MU,LAMBDA)     += TAPXX(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TBPXX_INT(MU,LAMBDA) *= 4.0
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TBPXX_INT(MU,LAMBDA) *= -1.0
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TE2XXXX(MU,SIGMA,NU,LAMBDA)
         TBPXX_INT(MU,LAMBDA) *= -1.0
         TBPXX(MU,LAMBDA)     += TBPXX(MU,LAMBDA)

         PUT HR1A_AO_P_CURRENT_R(MU,LAMBDA) += TAPXX(MU,LAMBDA) 
         PUT HR1B_AO_P_CURRENT_R(MU,LAMBDA) += TBPXX(MU,LAMBDA)

         TAMXX_INT(MU,LAMBDA)  = TAXXM(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TAMXX_INT(MU,LAMBDA) *= -1.0
         TAMXX(MU,LAMBDA)     += TAMXX_INT(MU,LAMBDA)

         TAMXX_INT(MU,LAMBDA)  = TAXXM(NU,SIGMA) * TE2XXXX(MU,SIGMA,NU,LAMBDA)
         TAMXX(MU,LAMBDA)     += TAMXX(MU,LAMBDA)

         TBMXX_INT(MU,LAMBDA)  = TBXXM(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TBMXX_INT(MU,LAMBDA) *= -1.0
         TBMXX(MU,LAMBDA)     += TBMXX_INT(MU,LAMBDA)

         TBMXX_INT(MU,LAMBDA)  = TBXXM(NU,SIGMA) * TE2XXXX(MU,SIGMA,NU,LAMBDA)
         TBMXX(MU,SIGMA)      += TBMXX(MU,SIGMA)

         PUT HR1A_AO_M_CURRENT_L(MU,LAMBDA) += TAMXX(MU,LAMBDA)
         PUT HR1B_AO_M_CURRENT_L(MU,LAMBDA) += TBMXX(MU,LAMBDA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SIP_BARRIER
#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do mu
     do nu
        get HR1A_AO_P_CURRENT_R(mu,nu)
        get HR1A_AO_M_CURRENT_L(mu,nu)
        tmp   = HR1A_AO_P_CURRENT_R(mu,nu) * HR1A_AO_P_CURRENT_R(mu,nu)
        sumap += tmp
        tmp   = HR1A_AO_M_CURRENT_L(mu,nu) * HR1A_AO_M_CURRENT_L(mu,nu)
        sumam += tmp
     enddo nu
     enddo mu
     do mu
     do nu
        get HR1B_AO_P_CURRENT_R(mu,nu)
        get HR1B_AO_M_CURRENT_L(mu,nu)
        tmp = HR1B_AO_P_CURRENT_R(mu,nu) * HR1B_AO_P_CURRENT_R(mu,nu)
        sumbp += tmp
        tmp = HR1B_AO_M_CURRENT_L(mu,nu) * HR1B_AO_M_CURRENT_L(mu,nu)
        sumbm += tmp
     enddo nu
     enddo mu
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug
         
     ENDPROC HC_MULTIPLY
#    -------------------


     PROC HC_MULTIPLY_CIS
#    --------------------
#  (A+B)(ai,bj)  R+_old(b,J)  = R+_new(a,i)
#  (A-B)(ai,bj)  R-_old(b,J)  = R__new(a,i)

#  All possible spin-combinations are included.

     PARDO MU, NU, LAMBDA, SIGMA

         TAPXX(MU,LAMBDA) = 0.0
         TAMXX(MU,LAMBDA) = 0.0
         TBPXX(MU,LAMBDA) = 0.0
         TBMXX(MU,LAMBDA) = 0.0

         REQUEST SAOINT(MU,LAMBDA,NU,SIGMA) SIGMA
         REQUEST SAOINT(MU,SIGMA,LAMBDA,NU) SIGMA
         REQUEST SAOINT(MU,SIGMA,NU,LAMBDA) SIGMA
 
         TC0XXXX(MU,LAMBDA,NU,SIGMA) = SAOINT(MU,LAMBDA,NU,SIGMA)
         TE1XXXX(MU,SIGMA,LAMBDA,NU) = SAOINT(MU,SIGMA,LAMBDA,NU)
         TE2XXXX(MU,SIGMA,NU,LAMBDA) = SAOINT(MU,SIGMA,NU,LAMBDA) 

         GET R1A_AO_P_CURRENT_R(NU,SIGMA)
         GET R1B_AO_P_CURRENT_R(NU,SIGMA)  

         GET R1A_AO_M_CURRENT_L(NU,SIGMA)
         GET R1B_AO_M_CURRENT_L(NU,SIGMA)

         TAXXP(NU,SIGMA) = R1A_AO_P_CURRENT_R(NU,SIGMA)
         TBXXP(NU,SIGMA) = R1B_AO_P_CURRENT_R(NU,SIGMA)

         TAXXM(NU,SIGMA) = R1A_AO_M_CURRENT_L(NU,SIGMA)
         TBXXM(NU,SIGMA) = R1B_AO_M_CURRENT_L(NU,SIGMA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TAPXX_INT(MU,LAMBDA) *= 2.0
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TAPXX_INT(MU,LAMBDA)  = TAXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TAPXX_INT(MU,LAMBDA) *= -1.0
         TAPXX(MU,LAMBDA)     += TAPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TC0XXXX(MU,LAMBDA,NU,SIGMA)
         TBPXX_INT(MU,LAMBDA) *= 2.0
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         TBPXX_INT(MU,LAMBDA)  = TBXXP(NU,SIGMA) * TE1XXXX(MU,SIGMA,LAMBDA,NU)
         TBPXX_INT(MU,LAMBDA) *= -1.0
         TBPXX(MU,LAMBDA)     += TBPXX_INT(MU,LAMBDA)

         PUT HR1A_AO_P_CURRENT_R(MU,LAMBDA) += TAPXX(MU,LAMBDA) 
         PUT HR1B_AO_P_CURRENT_R(MU,LAMBDA) += TBPXX(MU,LAMBDA)

         PUT HR1A_AO_M_CURRENT_L(MU,LAMBDA) += TAPXX(MU,LAMBDA)
         PUT HR1B_AO_M_CURRENT_L(MU,LAMBDA) += TBPXX(MU,LAMBDA)

     ENDPARDO MU, NU, LAMBDA, SIGMA

     EXECUTE SIP_BARRIER
#bgn_debug
     execute get_my_rank rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do mu
     do nu
        get HR1A_AO_P_CURRENT_R(mu,nu)
        get HR1A_AO_M_CURRENT_L(mu,nu)
        tmp   = HR1A_AO_P_CURRENT_R(mu,nu) * HR1A_AO_P_CURRENT_R(mu,nu)
        sumap += tmp
        tmp   = HR1A_AO_M_CURRENT_L(mu,nu) * HR1A_AO_M_CURRENT_L(mu,nu)
        sumam += tmp
     enddo nu
     enddo mu
     do mu
     do nu
        get HR1B_AO_P_CURRENT_R(mu,nu)
        get HR1B_AO_M_CURRENT_L(mu,nu)
        tmp = HR1B_AO_P_CURRENT_R(mu,nu) * HR1B_AO_P_CURRENT_R(mu,nu)
        sumbp += tmp
        tmp = HR1B_AO_M_CURRENT_L(mu,nu) * HR1B_AO_M_CURRENT_L(mu,nu)
        sumbm += tmp
     enddo nu
     enddo mu
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug
         
     ENDPROC HC_MULTIPLY_CIS
#    ----------------------

     PROC FORM_MO_R1AB
#    -----------------

     PARDO MU, NU

         GET HR1A_AO_P_CURRENT_R(NU,MU)
         GET HR1A_AO_M_CURRENT_L(NU,MU)

         TXXP(NU,MU) = HR1A_AO_P_CURRENT_R(NU,MU)
         TXXM(NU,MU) = HR1A_AO_M_CURRENT_L(NU,MU)

         DO A

            TXAP(NU,A) = TXXP(NU,MU) * CA(MU,A)
            TXAM(NU,A) = TXXM(NU,MU) * CA(MU,A)
              
            DO I

               TAIP_R(A,I) = TXAP(NU,A) * CA(NU,I)
               TAIM_L(A,I) = TXAM(NU,A) * CA(NU,I)

               PUT HR1A_MO_P_CURRENT_R(A,I) += TAIP_R(A,I)
               PUT HR1A_MO_M_CURRENT_L(A,I) += TAIM_L(A,I)

            ENDDO I

         ENDDO A

     ENDPARDO MU, NU

     PARDO MU, NU

         GET HR1B_AO_P_CURRENT_R(NU,MU)
         GET HR1B_AO_M_CURRENT_L(NU,MU)

         TXXP(NU,MU) = HR1B_AO_P_CURRENT_R(NU,MU)
         TXXM(NU,MU) = HR1B_AO_M_CURRENT_L(NU,MU)

         DO B

            TXBP(NU,B) = TXXP(NU,MU) * CB(MU,B)
            TXBM(NU,B) = TXXM(NU,MU) * CB(MU,B)

            DO J

               TBJP_R(B,J) = TXBP(NU,B) * CB(NU,J)
               TBJM_L(B,J) = TXBM(NU,B) * CB(NU,J)

               PUT HR1B_MO_P_CURRENT_R(B,J) += TBJP_R(B,J)
               PUT HR1B_MO_M_CURRENT_L(B,J) += TBJM_L(B,J)

             ENDDO J

         ENDDO B

     ENDPARDO MU, NU

     EXECUTE SIP_BARRIER 
   
#bgn_debug
     execute get_my_rank rank
     execute print_scalar rank
     if rank == 0.0
     sumap = 0.0
     sumam = 0.0
     sumbp = 0.0
     sumbm = 0.0
     do a
     do i
        get HR1A_MO_P_CURRENT_R(A,I)
        get HR1A_MO_M_CURRENT_L(A,I)

        tmp   = HR1A_MO_P_CURRENT_R(A,I) * HR1A_MO_P_CURRENT_R(A,I)
        sumap += tmp
        tmp   = HR1A_MO_M_CURRENT_L(A,I) * HR1A_MO_M_CURRENT_L(A,I)
        sumam += tmp
     enddo i
     enddo a
     do b
     do j
      
        get HR1B_MO_P_CURRENT_R(B,J)
        get HR1B_MO_M_CURRENT_L(B,J)
        tmp = HR1B_MO_P_CURRENT_R(B,J) * HR1B_MO_P_CURRENT_R(B,J)
        sumbp += tmp
        tmp = HR1B_MO_M_CURRENT_L(B,J) * HR1B_MO_M_CURRENT_L(B,J)
        sumbm += tmp
     enddo j
     enddo b
     execute print_scalar  sumap
     execute print_scalar  sumam
     execute print_scalar  sumbp
     execute print_scalar  sumbm
     endif
#end_debug

     ENDPROC FORM_MO_R1AB
#    --------------------

     PROC DIRECT_AO_HC_MULT
#    ----------------------

     PARDO A, I

        TAIP_R(A,I) = 0.0
        TAIM_L(A,I) = 0.0

        PUT HR1A_MO_P_CURRENT_R(A,I) = TAIP_R(A,I)
        PUT HR1A_MO_M_CURRENT_L(A,I) = TAIM_L(A,I)

     ENDPARDO A, I

     PARDO B, J

        TBJP_R(B,J) = 0.0
        TBJM_L(B,J) = 0.0

        PUT HR1B_MO_P_CURRENT_R(B,J) = TBJP_R(B,J)
        PUT HR1B_MO_M_CURRENT_L(B,J) = TBJM_L(B,J)

     ENDPARDO B, J

     PARDO mu, nu

          TXXP_T(MU,NU) = 0.0
          TXXM_T(MU,NU) = 0.0

          PUT R1A_AO_P_CURRENT_R(MU,NU) =  TXXP_T(MU,NU)
          PUT R1A_AO_M_CURRENT_L(MU,NU) =  TXXM_T(MU,NU)
          PUT R1A_AO_P_CURRENT_R(MU,NU) =  TXXP_T(MU,NU)
          PUT R1A_AO_M_CURRENT_L(MU,NU) =  TXXM_T(MU,NU)

      ENDPARDO mu, nu
      EXECUTE SIP_BARRIER

     CALL FORM_AO_R1AB
     
     CALL HC_MULTIPLY_CIS

     CALL FORM_FOCK_CONTRIBUTION

     CALL FORM_MO_R1AB

     ENDPROC DIRECT_AO_HC_MULT
#    ----------------------

     PROC SAVE_HC_VECTORS
#    --------------------

     MCOUNT = ZERO
     DO MINDEX20

        MCOUNT  += ONE
        IF MCOUNT == ITER_COUNT

        PARDO A, I

           GET HR1A_MO_P_CURRENT_R(A,I)
           GET HR1A_MO_M_CURRENT_L(A,I)

           TAIP_R(A,I) = HR1A_MO_P_CURRENT_R(A,I)
           TAIM_L(A,I) = HR1A_MO_M_CURRENT_L(A,I)

           TAIP_RX(A,I,MINDEX20) = TAIP_R(A,I)
           TAIM_LX(A,I,MINDEX20) = TAIM_L(A,I)

           PUT HR1A_MO_P_HIST_R(A,I,MINDEX20) = TAIP_RX(A,I,MINDEX20)
           PUT HR1A_MO_M_HIST_L(A,I,MINDEX20) = TAIM_LX(A,I,MINDEX20)

        ENDPARDO A, I

        PARDO B, J

           GET HR1B_MO_P_CURRENT_R(B,J)
           GET HR1B_MO_M_CURRENT_L(B,J)

           TBJP_R(B,J) = HR1B_MO_P_CURRENT_R(B,J)
           TBJM_L(B,J) = HR1B_MO_M_CURRENT_L(B,J)

           TBJP_RX(B,J,MINDEX20) = TBJP_R(B,J)
           TBJM_LX(B,J,MINDEX20) = TBJM_L(B,J)

           PUT HR1B_MO_P_HIST_R(B,J,MINDEX20) = TBJP_RX(B,J,MINDEX20)
           PUT HR1B_MO_M_HIST_L(B,J,MINDEX20) = TBJM_LX(B,J,MINDEX20)

        ENDPARDO B, J
        ENDIF

     ENDDO MINDEX20

     EXECUTE SIP_BARRIER

    ENDPROC SAVE_HC_VECTORS
#   -----------------------

     PROC FORM_A_MATRIX_11
#    ---------------------

# Build A(1,1) for the first iteraion

        SUMP_A = 0.0
        SUMM_A = 0.0
        SUMP_B = 0.0
        SUMM_B = 0.0
        HC_A_P = 0.0
        HC_B_P = 0.0
        HC_A_M = 0.0
        HC_B_M = 0.0

        MCOUNT = 0.0
        DO MINDEX20
           MCOUNT += 1.0
           
           IF MCOUNT == ITER_COUNT
           NCOUNT = 0.0
           DO NINDEX20
              NCOUNT += 1.0

              IF NCOUNT == ITER_COUNT 

                 PARDO A, I
                     GET R1A_MO_P_HIST_R(A,I,NINDEX20)
                     GET HR1A_MO_P_HIST_R(A,I,MINDEX20)

                     GET R1A_MO_M_HIST_L(A,I,NINDEX20)
                     GET HR1A_MO_M_HIST_L(A,I,MINDEX20)

                     T1AIP_R(A,I) = R1A_MO_P_HIST_R(A,I,NINDEX20)
                     TAIP_R(A,I)  = HR1A_MO_P_HIST_R(A,I,MINDEX20)

                     TAIM_L(A,I)  = HR1A_MO_M_HIST_L(A,I,MINDEX20)
                     T1AIM_L(A,I) = R1A_MO_M_HIST_L(A,I,NINDEX20)

                     TMP        = TAIP_R(A,I) * T1AIP_R(A,I)
                     SUMP_A    += TMP

                     TMP        = TAIM_L(A,I) * T1AIM_L(A,I)
                     SUMM_A    += TMP
                 ENDPARDO A, I

                 PARDO B, J
                     GET R1B_MO_P_HIST_R(B,J,NINDEX20)
                     GET HR1B_MO_P_HIST_R(B,J,MINDEX20)

                     GET R1B_MO_M_HIST_L(B,J,NINDEX20)
                     GET HR1B_MO_M_HIST_L(B,J,MINDEX20)

                     TBJP_R(B,J)  = HR1B_MO_P_HIST_R(B,J,MINDEX20)
                     T1BJP_R(B,J) = R1B_MO_P_HIST_R(B,J,NINDEX20)

                     TBJM_L(B,J)  = HR1B_MO_M_HIST_L(B,J,MINDEX20)
                     T1BJM_L(B,J) = R1B_MO_M_HIST_L(B,J,NINDEX20)

                     TMP       = TBJP_R(B,J) * T1BJP_R(B,J)
                     SUMP_B   += TMP

                     TMP       = TBJM_L(B,J) * T1BJM_L(B,J)
                     SUMM_B   += TMP
                 ENDPARDO B, J

                 EXECUTE SIP_BARRIER 
                 COLLECTIVE HC_A_P += SUMP_A
                 COLLECTIVE HC_B_P += SUMP_B
                 COLLECTIVE HC_A_M += SUMM_A
                 COLLECTIVE HC_B_M += SUMM_B

              ENDIF 

           ENDDO NINDEX20
           ENDIF 

        ENDDO MINDEX20

        SUMP  = HC_A_P
        SUMP += HC_B_P
        SUMM  = HC_A_M
        SUMM += HC_B_M
#bgn_debug
     execute print_scalar sump
     execute print_scalar summ
#end_debug

        MCOUNT = 0.0
        NCOUNT = 0.0

        DO MINDEX20
        MCOUNT += 1.0
        IF MCOUNT == 1.0

           DO NINDEX20
              NCOUNT += 1.0

              IF NCOUNT == 1.0

                 B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                 B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM

              ENDIF

          ENDDO NINDEX20
        ENDIF

       ENDDO MINDEX20
       
       EXECUTE SIP_BARRIER 

       A_VALUE_P = SUMP
       A_VALUE_M = SUMM

     ENDPROC FORM_A_MATRIX_11
#    ------------------------

     PROC FORM_A_MATRIX_II
#    ---------------------

# Build  A(i,j) i=j  first

     MCOUNT = ZERO
     DO MINDEX20
        MCOUNT += ONE
        IF MCOUNT > ITER_COUNT
           EXIT
        ENDIF

        IF MCOUNT  == ITER_COUNT 

           NCOUNT = ZERO
           DO NINDEX20
              NCOUNT += ONE

              SUMP_A = ZERO
              SUMM_A = ZERO
              SUMP_B = ZERO
              SUMM_B = ZERO
              HC_A_P = ZERO
              HC_A_M = ZERO
              HC_B_P = ZERO
              HC_B_M = ZERO
               
              IF MCOUNT == NCOUNT 
                 PARDO A, I
                     GET R1A_MO_P_HIST_R(A,I,MINDEX20)
                     GET R1A_MO_M_HIST_L(A,I,MINDEX20)
   
                     TAIP_R(A,I) = R1A_MO_P_HIST_R(A,I,MINDEX20)
                     TAIM_L(A,I) = R1A_MO_M_HIST_L(A,I,MINDEX20)
   
                     GET HR1A_MO_P_HIST_R(A,I,NINDEX20)
                     GET HR1A_MO_M_HIST_L(A,I,NINDEX20)
   
                     T1AIP_R(A,I) = HR1A_MO_P_HIST_R(A,I,NINDEX20)
                     T1AIM_L(A,I) = HR1A_MO_M_HIST_L(A,I,NINDEX20)
   
                     TMP       = TAIP_R(A,I) * T1AIP_R(A,I)
                     SUMP_A   += TMP
      
                     TMP       = TAIM_L(A,I) * T1AIM_L(A,I)
                     SUMM_A   += TMP
                  ENDPARDO A, I

                  PARDO B, J
                      GET R1B_MO_P_HIST_R(B,J,MINDEX20)
                      GET R1B_MO_M_HIST_L(B,J,MINDEX20)
 
                      TBJP_R(B,J) = R1B_MO_P_HIST_R(B,J,MINDEX20)
                      TBJM_L(B,J) = R1B_MO_M_HIST_L(B,J,MINDEX20)
  
                      GET HR1B_MO_P_HIST_R(B,J,NINDEX20)
                      GET HR1B_MO_M_HIST_L(B,J,NINDEX20)

                      T1BJP_R(B,J) = HR1B_MO_P_HIST_R(B,J,NINDEX20)
                      T1BJM_L(B,J) = HR1B_MO_M_HIST_L(B,J,NINDEX20)
   
                      TMP       = TBJP_R(B,J) * T1BJP_R(B,J)
                      SUMP_B   += TMP

                      TMP       = TBJM_L(B,J) * T1BJM_L(B,J)
                      SUMM_B   += TMP
                 ENDPARDO B, J


                 EXECUTE SIP_BARRIER 
                 COLLECTIVE HC_A_P += SUMP_A
                 COLLECTIVE HC_A_M += SUMM_A
                 COLLECTIVE HC_B_P += SUMP_B
                 COLLECTIVE HC_B_M += SUMM_B

                 SUMP  = HC_A_P
                 SUMP += HC_B_P
                 SUMM  = HC_A_M
                 SUMM += HC_B_M
#bgn_debug
     execute print_scalar sump
     execute print_scalar summ
#end_debug
                 KCOUNT = ZERO
                 DO KINDEX20
                   KCOUNT += ONE
                    IF KCOUNT  == NCOUNT
 
                       LCOUNT = ZERO
                       DO LINDEX20
                          LCOUNT += ONE
   
                          IF LCOUNT == MCOUNT
 
                             B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                             B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM
 
                          ENDIF
                       ENDDO LINDEX20
                    ENDIF
                 ENDDO KINDEX20
              ENDIF
     
            ENDDO NINDEX20
         ENDIF
    
     ENDDO MINDEX20

     ENDPROC FORM_A_MATRIX_II
#    ------------------------

     PROC FORM_A_MATRIX_IJ
#    ---------------------
# Build  A(i,j) i<j  now.

     NCOUNT = ZERO
     DO NINDEX20
        NCOUNT += ONE
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

        MCOUNT = ZERO 
        DO MINDEX20
           MCOUNT += ONE

           IF MCOUNT > NCOUNT
              EXIT
           ENDIF

           IF MCOUNT == ITER_COUNT
              IF NCOUNT == ITER_COUNT
                 EXIT
              ENDIF
           ENDIF

           SUMP_A = ZERO
           SUMM_A = ZERO
           SUMP_B = ZERO
           SUMM_B = ZERO
           HC_A_P = ZERO
           HC_A_M = ZERO
           HC_B_P = ZERO
           HC_B_M = ZERO

           PARDO A, I
               GET R1A_MO_P_HIST_R(A,I,MINDEX20)
               GET R1A_MO_M_HIST_L(A,I,MINDEX20)

               TAIP_R(A,I) = R1A_MO_P_HIST_R(A,I,MINDEX20)
               TAIM_L(A,I) = R1A_MO_M_HIST_L(A,I,MINDEX20)

               GET HR1A_MO_P_HIST_R(A,I,NINDEX20)
               GET HR1A_MO_M_HIST_L(A,I,NINDEX20)

               T1AIP_R(A,I) = HR1A_MO_P_HIST_R(A,I,NINDEX20)
               T1AIM_L(A,I) = HR1A_MO_M_HIST_L(A,I,NINDEX20)

               TMP       = TAIP_R(A,I) * T1AIP_R(A,I)
               SUMP_A   += TMP

               TMP       = TAIM_L(A,I) * T1AIM_L(A,I)
               SUMM_A   += TMP
           ENDPARDO A, I

           PARDO B, J
                GET R1B_MO_P_HIST_R(B,J,MINDEX20)
                GET R1B_MO_M_HIST_L(B,J,MINDEX20)

                TBJP_R(B,J) = R1B_MO_P_HIST_R(B,J,MINDEX20)
                TBJM_L(B,J) = R1B_MO_M_HIST_L(B,J,MINDEX20)

                GET HR1B_MO_P_HIST_R(B,J,NINDEX20)
                GET HR1B_MO_M_HIST_L(B,J,NINDEX20)

                T1BJP_R(B,J) = HR1B_MO_P_HIST_R(B,J,NINDEX20)
                T1BJM_L(B,J) = HR1B_MO_M_HIST_L(B,J,NINDEX20)

                TMP       = TBJP_R(B,J) * T1BJP_R(B,J)
                SUMP_B   += TMP

                TMP       = TBJM_L(B,J) * T1BJM_L(B,J)
                SUMM_B   += TMP
           ENDPARDO B, J

           EXECUTE SERVER_BARRIER
           COLLECTIVE HC_A_P += SUMP_A
           COLLECTIVE HC_A_M += SUMM_A
           COLLECTIVE HC_B_P += SUMP_B
           COLLECTIVE HC_B_M += SUMM_B

           SUMP  = HC_A_P
           SUMP += HC_B_P
           SUMM  = HC_A_M
           SUMM += HC_B_M

           KCOUNT = ZERO
           DO KINDEX20
              KCOUNT += ONE
              IF KCOUNT  == NCOUNT

                  LCOUNT = ZERO
                  DO LINDEX20
                     LCOUNT += ONE

                     IF LCOUNT == MCOUNT
                         B_A_MATRIX_P(MINDEX20,NINDEX20) = SUMP
                         B_A_MATRIX_M(MINDEX20,NINDEX20) = SUMM
                      ENDIF
                  ENDDO LINDEX20
               ENDIF

           ENDDO KINDEX20

        ENDDO MINDEX20
     ENDDO NINDEX20

     ENDPROC FORM_A_MATRIX_IJ
#    ------------------------

     PROC FORM_A_MATRIX_JI
#    ---------------------

# Now A(I,J)  i > j

     NCOUNT = ZERO
     DO NINDEX20
        NCOUNT += ONE
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

        MCOUNT = ZERO
        DO MINDEX20
           MCOUNT += ONE

           IF MCOUNT >= NCOUNT
              EXIT
           ENDIF

           IF MCOUNT == ITER_COUNT
              IF NCOUNT == ITER_COUNT
                 EXIT
             ENDIF
           ENDIF

           SUMP_A = ZERO
           SUMM_A = ZERO
           SUMP_B = ZERO
           SUMM_B = ZERO
           HC_A_P = ZERO
           HC_A_M = ZERO
           HC_B_P = ZERO
           HC_B_M = ZERO

           PARDO A, I
               GET R1A_MO_P_HIST_R(A,I,NINDEX20)
               GET R1A_MO_M_HIST_L(A,I,NINDEX20)

               TAIP_R(A,I) = R1A_MO_P_HIST_R(A,I,NINDEX20)
               TAIM_L(A,I) = R1A_MO_M_HIST_L(A,I,NINDEX20)

               GET HR1A_MO_P_HIST_R(A,I,MINDEX20)
               GET HR1A_MO_M_HIST_L(A,I,MINDEX20)

               T1AIP_R(A,I) = HR1A_MO_P_HIST_R(A,I,MINDEX20)
               T1AIM_L(A,I) = HR1A_MO_M_HIST_L(A,I,MINDEX20)

               TMP       = TAIP_R(A,I) * T1AIP_R(A,I)
               SUMP_A   += TMP

               TMP       = TAIM_L(A,I) * T1AIM_L(A,I)
               SUMM_A   += TMP
           ENDPARDO A, I

           PARDO B, J
                GET R1B_MO_P_HIST_R(B,J,NINDEX20)
                GET R1B_MO_M_HIST_L(B,J,NINDEX20)

                TBJP_R(B,J) = R1B_MO_P_HIST_R(B,J,NINDEX20)
                TBJM_L(B,J) = R1B_MO_M_HIST_L(B,J,NINDEX20)

                GET HR1B_MO_P_HIST_R(B,J,MINDEX20)
                GET HR1B_MO_M_HIST_L(B,J,MINDEX20)

                T1BJP_R(B,J) = HR1B_MO_P_HIST_R(B,J,MINDEX20)
                T1BJM_L(B,J) = HR1B_MO_M_HIST_L(B,J,MINDEX20)

                TMP        = TBJP_R(B,J) * T1BJP_R(B,J)
                SUMP_B   += TMP

                TMP       = TBJM_L(B,J) * T1BJM_L(B,J)
                SUMM_B   += TMP
           ENDPARDO B, J

           EXECUTE SERVER_BARRIER
           COLLECTIVE HC_A_P += SUMP_A
           COLLECTIVE HC_A_M += SUMM_A
           COLLECTIVE HC_B_P += SUMP_B
           COLLECTIVE HC_B_M += SUMM_B

           SUMP  = HC_A_P
           SUMP += HC_B_P
           SUMM  = HC_A_M
           SUMM += HC_B_M

           KCOUNT = ZERO
           DO KINDEX20
              KCOUNT += ONE
              IF KCOUNT  == NCOUNT

                  LCOUNT = ZERO
                  DO LINDEX20
                     LCOUNT += ONE

                     IF LCOUNT == MCOUNT
                         B_A_MATRIX_P(NINDEX20,MINDEX20) = SUMP
                         B_A_MATRIX_M(NINDEX20,MINDEX20) = SUMM
                      ENDIF
                  ENDDO LINDEX20
               ENDIF

           ENDDO KINDEX20

        ENDDO MINDEX20
     ENDDO NINDEX20

     ENDPROC FORM_A_MATRIX_JI
#    ------------------------

#bgn_debug
#    sumap = 0.0
#    sumam = 0.0
#    do MINDEX20
#    do NINDEX20
#       tmp = B_A_MATRIX_P(NINDEX20,MINDEX20) * B_A_MATRIX_P(NINDEX20,MINDEX20)
#       sumap += tmp
#       tmp = B_A_MATRIX_M(NINDEX20,MINDEX20) * B_A_MATRIX_M(NINDEX20,MINDEX20)
#       sumam += tmp
#    enddo NINDEX20
#    enddo MINDEX20
