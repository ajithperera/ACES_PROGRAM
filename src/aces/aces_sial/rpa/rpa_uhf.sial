       DELETE CORR_VECB_INTMD_P_R
       DELETE CORR_VECB_INTMD_M_L
       DELETE ORTHO_COEFSA_P_RL
       DELETE ORTHO_COEFSA_M_RL
       DELETE ORTHO_COEFSB_P_RL
       DELETE ORTHO_COEFSB_M_RL
       DELETE R1A_MO_P_INTMD_R
       DELETE R1A_MO_M_INTMD_L
       DELETE R1B_MO_P_INTMD_R
       DELETE R1B_MO_M_INTMD_L
       DELETE Y1P_A_R
       DELETE Y1M_A_L
       DELETE Y1P_B_R
       DELETE Y1M_B_L
       DELETE HY1P_A_R
       DELETE HY1M_A_L
       DELETE HY1P_B_R
       DELETE HY1M_B_L

       EXECUTE SIP_BARRIER 

       ENDPROC DELETE_ARRAYS
#      ---------------------

#     BEGIN MAIN PROGRAM
#     -----------------
#
# Read the maximum number of roots and the convergence threshold from
# input.

       TARGET_ROOTS   = EOM_ROOTS
       RPA_THRES      = CIS_TOL 
       RPA_MAXCYC     = EE_MAXCYC
       RHF_UHF        = REFERENCE 
 
       MULT  = 0.0
       ZERO  = 0.0
       ONE   = 1.0
       TWO   = 2.0
       THREE = 3.0
       HALF  = 0.5

       SINGLET = ZERO
       TRIPLET = ZERO
       EXACT_HY= ONE 

       MAX_SUBSP_DIM = RPA_MAXCYC

#bgn_debug
      EXECUTE  PRINT_SCALAR  RPA_MAXCYC
      EXECUTE  PRINT_SCALAR  RHF_UHF
      EXECUTE  PRINT_SCALAR  RPA_THRES
#end_debug
#  
       CALL CREATE_ARRAYS 
       CALL FORM_FOCK_DIAGS 
       CALL GET_2INTS 

       COUNT_NO_ROOTS = 0.0

       DO SPN_MULT

          MULT  += 1.0

          IF MULT  > RHF_UHF
             EXIT
          ENDIF

          IF MULT == ONE
             SINGLET = ONE
             TRIPLET = ZERO
          ELSE
             SINGLET = ZERO
             TRIPLET = ONE
          ENDIF
#bgn_debug
          execute print_scalar mult
#end_debug

        DO MAX_NO_ROOTS

          COUNT_NO_ROOTS += 1.0

          IF COUNT_NO_ROOTS > TARGET_ROOTS
             EXIT
          ENDIF 

          MYROOT = COUNT_NO_ROOTS
          CALL FORM_INITIAL_GUESS
          CALL MOVE_GUESS_2CURRENT

          ITER_COUNT = 0.0
          DO SUBSP_DIM

             CALL SET_TO_ZERO

             ITER_COUNT  += 1.0
#bgn_debug
             execute print_scalar iter_count 
#end_debug

             IF ITER_COUNT > MAX_SUBSP_DIM
                EXIT
             ENDIF

# Lets denote the eigenvalue problem we are trying to solve as
# H C = E C and {c_1, c_2, c_3...} expansion vector for a given
# root.

             CALL SAVE_C_VECTORS
#bgn_debug
             call c_check
#end_debug

# The vector-matrix product in the following step  is really the time
# consuming step in this. The Direct AO based alogrithm implemented
# here is described in several papers: G. B. Bacskay,
# Chemical Physics,61,385,1981 and J. Olsen and co-workers,
# Chemical Physics,119,297,1988.

             CALL DIRECT_AO_HC_MULT

             CALL SAVE_HC_VECTORS

#  A(i,j) = <R_i | H | R_j>, where R_i, i=1,2,3... are the sub-space
# vectors. The diagonalization of the sub-space matrix A gives a
# set of vectors of the dimension of the sub-space matrix (N=1,2..)
# that can be used to form a set of N vectors. One of them will be
# chosen to built the correction vector.
#
            CALL CONSTRUCT_A_MATRIX
#bgn_debug
            execute print_static B_A_MATRIX_P ITER_COUNT
            execute print_static B_A_MATRIX_M ITER_COUNT
#end_debug

            CALL DIAG_A_MATRIX
#bgn_debug
            execute print_static B_A_MATRIX_P ITER_COUNT
            execute print_static B_A_MATRIX_M ITER_COUNT
#end_debug

# The FORM_NEW_VECTORS and SELECT_VECTOR_TOGO do two things. The first one
# will form the set of new vectors using the formula
# C_k (m,n) = A_k(1,1)*R_1 + A_k(2,1)*R_2 +... Following that We will
# have C_k  k=1,.., N where N is curent dimension of
# the sub-space). We select a vector from them based on the criteria
# on the maximum overlap criteria with the starting guess vector.
            
            IF ITER_COUNT != ONE

               CALL REORDER_A_EIGS

               IF EXACT_HY == ONE

                  CALL FORM_NEW_VECTORS
                  CALL SELECT_VECTOR_TOGO
                  CALL FORM_HBAR_Y_VECS

               ELSE

                  CALL FORM_NEW_HBAR_Y_VECTORS
                  CALL SELECT_HBAR_Y_VECTOR_TOGO

               ENDIF 
            ENDIF 

            CALL FORM_RESIDUAL_VECTOR

            CALL FORM_CORRECTION_VECTOR

            CALL FORM_BIORTHOGANAL_VECS
    
            CALL RESCALE_NEW_VECS 

          ENDDO SUBSP_DIM

       ENDDO MAX_NO_ROOTS

      ENDDO SPN_MULT

                          ENDSIAL DIRECT_RPA_UHF
#                         ----------------------

