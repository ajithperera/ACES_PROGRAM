       CREATE HR1B_MO_P_CURRENT_R
       CREATE HR1B_MO_M_CURRENT_L
       CREATE R1A_MO_P_HIST_R
       CREATE R1A_MO_M_HIST_L
       CREATE R1B_MO_P_HIST_R
       CREATE R1B_MO_M_HIST_L
       CREATE HR1A_MO_P_HIST_R
       CREATE HR1A_MO_M_HIST_L
       CREATE HR1B_MO_P_HIST_R
       CREATE HR1B_MO_M_HIST_L
       CREATE R1A_MO_P_NEW_R
       CREATE R1A_MO_M_NEW_L
       CREATE R1B_MO_P_NEW_R
       CREATE R1B_MO_M_NEW_L
       CREATE HR1A_MO_P_NEW_R
       CREATE HR1A_MO_M_NEW_L
       CREATE HR1B_MO_P_NEW_R
       CREATE HR1B_MO_M_NEW_L
       CREATE R1A_MO_P_PICKED_R
       CREATE R1A_MO_M_PICKED_L
       CREATE R1B_MO_P_PICKED_R
       CREATE R1B_MO_M_PICKED_L
       CREATE HR1A_MO_P_PICKED_R
       CREATE HR1A_MO_M_PICKED_L
       CREATE HR1B_MO_P_PICKED_R
       CREATE HR1B_MO_M_PICKED_L
       CREATE RESIDUEA_P_VEC_R
       CREATE RESIDUEA_M_VEC_L
