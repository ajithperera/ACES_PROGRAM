#      pardo a,b,i1,a1
#            request d2_abaa(a,b,i1,a1) a1
#            tmp = d2_abaa(a,b,i1,a1) * d2_abaa(a,b,i1,a1)
#            tmpa+= tmp
#      endpardo a,b,i1,a1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo a,b,j1,b1
#            request d2_abbb(a,b,j1,b1) b1
#            tmp = d2_abbb(a,b,j1,b1) * d2_abbb(a,b,j1,b1)
