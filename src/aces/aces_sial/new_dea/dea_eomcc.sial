     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF  

           PARDO a, b1

                 GET R1_AB_HIST(a,b1,NINDEX50)
                 GET CORR_VEC_AB(a,b1)
                 
                 Tab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)
                 T1ab(a,b1) = CORR_VEC_AB(a,b1)
                 TMP          = Tab(a,b1) * T1ab(a,b1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 
                 
           ENDPARDO a, b1

           PARDO a, b, i1, a1

                 REQUEST R2_ABAA_HIST(a,b,i1,a1,NINDEX50) a
                 REQUEST CORR_VEC_ABAA(a,b,i1,a1) a1

                 Tabia(a,b,i1,a1)  = R2_ABAA_HIST(a,b,i1,a1,NINDEX50)
                 T1abia(a,b,i1,a1) = CORR_VEC_ABAA(a,b,i1,a1)

                 TMP     = Tabia(a,b,i1,a1) * T1abia(a,b,i1,a1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO a, b, i1, a1

           PARDO a, b, j1, b1

                 REQUEST R2_ABBB_HIST(a,b,j1,b1,NINDEX50) j1
                 REQUEST CORR_VEC_ABBB(a,b,j1,b1) b1

                 Tabjb(a,b,j1,b1)  = R2_ABBB_HIST(a,b,j1,b1,NINDEX50)
                 T1abjb(a,b,j1,b1) = CORR_VEC_ABBB(a,b,j1,b1)
                        
                 TMP     = Tabjb(a,b,j1,b1) * T1abjb(a,b,j1,b1) 

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO a, b, j1, b1

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT 
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     C_A    = 0.0
     C_AAA  = 0.0
     C_BBB  = 0.0

     PARDO a, b1
           GET CORR_VEC_AB(a,b1)
           Tab(a,b1)   = CORR_VEC_AB(a,b1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
   
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET R1_AB_HIST(a,b1,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ab(a,b1) *= FACT
              T1ab(a,b1) *= -1.0
              Tab(a,b1)  += T1ab(a,b1)

           ENDDO NINDEX50

           PUT R1_AB_INTMD(a,b1) = Tab(a,b1)

           TMP    = Tab(a,b1) * Tab(a,b1)
           SUMA  += TMP
                 
     ENDPARDO a, b1

     PARDO a, b, i1, a1
          REQUEST CORR_VEC_ABAA(a,b,i1,a1) a1
          Tabia(a,b,i1,a1)  = CORR_VEC_ABAA(a,b,i1,a1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2_ABAA_HIST(a,b,i1,a1,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1abia(a,b,i1,a1) = R2_ABAA_HIST(a,b,i1,a1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                 
             EXECUTE RETURN_SVAL Txx FACT

             T1abia(a,b,i1,a1)  *= FACT
             T1abia(a,b,i1,a1)  *= -1.0
             Tabia(a,b,i1,a1)   += T1abia(a,b,i1,a1)

           ENDDO NINDEX50

           PREPARE R2_ABAA_intmd(a,b,i1,a1) = Tabia(a,b,i1,a1)

           TMP  =  Tabia(a,b,i1,a1) * Tabia(a,b,i1,a1)
           SUMAAA  += TMP

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

           REQUEST CORR_VEC_ABBB(a,b,j1,b1) b1
           Tabjb(a,b,j1,b1)  = CORR_VEC_ABBB(a,b,j1,b1)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2_ABBB_HIST(a,b,j1,b1,NINDEX50) j1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1abjb(a,b,j1,b1) = R2_ABBB_HIST(a,b,j1,b1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT
                 
             T1abjb(a,b,j1,b1) *= FACT
             T1abjb(a,b,j1,b1) *= -1.0
             Tabjb(a,b,j1,b1)  += T1abjb(a,b,j1,b1)

           ENDDO NINDEX50
                
          PREPARE R2_ABBB_intmd(a,b,j1,b1) = Tabjb(a,b,j1,b1)

          TMP = Tabjb(a,b,j1,b1) * Tabjb(a,b,j1,b1)
          SUMBBB += TMP
                 
     ENDPARDO a, b, j1,  b1

     EXECUTE SERVER_BARRIER 
     COLLECTIVE   C_A   += SUMA 
     COLLECTIVE   C_AAA += SUMAAA
     COLLECTIVE   C_BBB += SUMBBB

     EXECUTE SIP_BARRIER 

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_AAA
     NORM_NEW_ORTGC += C_BBB

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------
    
     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT 

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     HC_A    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0

     PARDO a, b1

            GET  R1_AB_intmd(a,b1)
            Tab(a,b1) = R1_AB_intmd(a,b1)
            TMP   = Tab(a,b1) * Tab(a,b1)
            HC_A += TMP

      ENDPARDO a, b1

      PARDO a, b, i1, a1

              REQUEST R2_ABAA_intmd(a,b,i1,a1) a1
              Tabia(a,b,i1,a1) = R2_ABAA_intmd(a,b,i1,a1)

              TMP   = Tabia(a,b,i1,a1) * Tabia(a,b,i1,a1)
              HC_AAA += TMP

      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1

              REQUEST R2_ABBB_intmd(a,b,j1,b1) b1
              Tabjb(a,b,j1,b1) = R2_ABBB_intmd(a,b,j1,b1)

              TMP   = Tabjb(a,b,j1,b1) * Tabjb(a,b,j1,b1)
              HC_BBB +=  TMP
              
     ENDPARDO a, b, j1, b1

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB

     SUM_R  = SUMA
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT
     
     EXECUTE SIP_BARRIER 
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     PARDO a, b1
           GET R1_AB_intmd(a,b1)

           Tab(a,b1)  = R1_AB_intmd(a,b1)
           Tab(a,b1) *= INV_SQRT_NORM_ORTGC

           PUT R1_AB(a,b1) =  Tab(a,b1)
     ENDPARDO a, b1

    PARDO a, b, i1, a1
         
         REQUEST R2_ABAA_intmd(a,b,i1,a1) a1

         Tabia(a,b,i1,a1)  = R2_ABAA_intmd(a,b,i1,a1)
         Tabia(a,b,i1,a1) *= INV_SQRT_NORM_ORTGC

         PREPARE R2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

         REQUEST R2_ABBB_intmd(a,b,j1,b1) b1

         Tabjb(a,b,j1,b1)  = R2_ABBB_intmd(a,b,j1,b1)
         Tabjb(a,b,j1,b1) *= INV_SQRT_NORM_ORTGC

         PREPARE R2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1) 

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo a,b1
#         get r1_ab(a,b1)
#         tmp = r1_ab(a,b1) * r1_ab(a,b1)
#         tmpa += tmp
#      endpardo a,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab  = suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,i1,a1
#            get R2_abaa(a,b,i1,a1) 
#            tmp = R2_abaa(a,b,i1,a1) * R2_abaa(a,b,i1,a1)
#            tmpa += tmp
#      endpardo a,b,i1,a1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,j1,b1
#            get R2_abbb(a,b,j1,b1) 
#            tmp = R2_abbb(a,b,j1,b1) * R2_abbb(a,b,j1,b1)
#            tmpa+= tmp
#      endpardo a,b,j1,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug
     ENDPROC RESCALE_NEW_C
#    ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50)  = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)   = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50 

     PARDO a, b1
           tab(a,b1)      = 0.0
           PUT Y1_AB(a,b1,NINDEX50)  = tab(a,b1)
           PUT HY1_AB(a,b1,NINDEX50) = tab(a,b1)
           PUT R1_AB_intmd(a,b1) = tab(a,b1)
     ENDPARDO a, b1

     PARDO a, b, i1, a1
         tabia(a,b,i1,a1) = 0.0
         PREPARE Y2_ABAA(a,b,i1,a1,NINDEX50)  = tabia(a,b,i1,a1)
         PREPARE HY2_ABAA(a,b,i1,a1,NINDEX50) = tabia(a,b,i1,a1)
         PREPARE R2_ABAA_intmd(a,b,i1,a1) = tabia(a,b,i1,a1)
     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1
         tabjb(a,b,j1,b1)       = 0.0
         PREPARE Y2_ABBB(a,b,j1,b1,NINDEX50)  = tabjb(a,b,j1,b1)
         PREPARE HY2_ABBB(a,b,j1,b1,NINDEX50) = tabjb(a,b,j1,b1)
         PREPARE R2_ABBB_intmd(a,b,j1,b1) = tabjb(a,b,j1,b1)
     ENDPARDO a, b, j1, b1

     ENDDO NINDEX50 

     EXECUTE  SERVER_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC REORDER_A_EIGS
#    -------------------
     
     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE 
              A_DIAGS(MINDEX50)      = EIG_VALUE 
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS 
     
     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO a, b1

                            GET R1_AB_HIST(a,b1,NINDEX50)
                            GET R1_AB_HIST(a,b1,MINDEX50)

                            Tab(a,b1)   = R1_AB_HIST(a,b1,NINDEX50)
                            T1ab(a,b1)  = R1_AB_HIST(a,b1,MINDEX50)

                            TMP   = Tab(a,b1) * T1ab(a,b1)
                            SUMA += TMP

                     ENDPARDO a, b1

                     PARDO a, b, i1, a1

                           REQUEST R2_ABAA_HIST(a,b,i1,a1,NINDEX50) a
                           REQUEST R2_ABAA_HIST(a,b,i1,a1,MINDEX50) a

                           Tabia(a,b,i1,a1)  = R2_ABAA_HIST(a,b,i1,a1,NINDEX50)
                           T1abia(a,b,i1,a1) = R2_ABAA_HIST(a,b,i1,a1,MINDEX50)

                           TMP     = Tabia(a,b,i1,a1) * T1abia(a,b,i1,a1)
                           SUMAAA += TMP
                
                     ENDPARDO a, b, i1, a1

                     PARDO a, b, j1, b1
                           REQUEST R2_ABBB_HIST(a,b,j1,b1,NINDEX50) b
                           REQUEST R2_ABBB_HIST(a,b,j1,b1,MINDEX50)  b

                           Tabjb(a,b,j1,b1)  = R2_ABBB_HIST(a,b,j1,b1,NINDEX50)
                           T1abjb(a,b,j1,b1) = R2_ABBB_HIST(a,b,j1,b1,MINDEX50)
                        
                           TMP     = Tabjb(a,b,j1,b1) * T1abjb(a,b,j1,b1)
                           SUMBBB += TMP

                     ENDPARDO a, b, j1, b1
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

#bgn_debug
#     execute print_static etemp  iter_count 
#end_debug

     ENDPROC C_CHECK
#    ---------------

     PROC HBAR_ABCD
#   --------------- 

     PARDO mu, nu, lambda, sigma
            compute_integrals aoint(mu,nu,lambda,sigma)
            DO a
               txxxa(mu,nu,lambda,a) = aoint(mu,nu,lambda,sigma)*ca(sigma,a)
               PREPARE Vxxxa(mu,nu,lambda,a) +=  txxxa(mu,nu,lambda,a)
            ENDDO a
      ENDPARDO mu, nu, lambda, sigma
      execute server_barrier

      PARDO mu, nu, lambda, a
            REQUEST Vxxxa(mu,nu,lambda,a) a
            DO a1
               txxaa(mu,nu,a1,a) = Vxxxa(mu,nu,lambda,a)*ca(lambda,a1)
               PREPARE Vxxaa(mu,nu,a1,a) += txxaa(mu,nu,a1,a)
            ENDDO a1
      ENDPARDO mu, nu, lambda, a
      execute server_barrier
      destroy Vxxxa

      PARDO mu, nu, a1, a
            REQUEST Vxxaa(mu,nu,a1,a) a
            DO a2
               txaaa(mu,a2,a1,a) = Vxxaa(mu,nu,a1,a)*ca(nu,a2)
               PREPARE Vxaaa(mu,a2,a1,a) += txaaa(mu,a2,a1,a)
            ENDDO a2
      ENDPARDO mu, nu, a1, a
      execute server_barrier
      destroy Vxxaa

      PARDO mu, a2, a1, a
            REQUEST Vxaaa(mu,a2,a1,a) a
            DO a3
               taaaa(a3,a2,a1,a) = Vxaaa(mu,a2,a1,a)*ca(mu,a3)
               PREPARE HBAR_aabb(a3,a2,a1,a) += taaaa(a3,a2,a1,a)
            ENDDO a3
      ENDPARDO mu, a2, a1, a
      execute server_barrier
      destroy Vxaaa
#
#     (alpha,alpha,beta,beta) spin component.
#     ---------------------------------------
#
      PARDO a, b2, a1, b3
#
            tppqq(a,a1,b2,b3) = 0.0
#
            DO j
#
               REQUEST              Vaabj(a1,a,b3,j) j
               GET                  t1b(b2,j)
#
               t1ppqq(a,a1,b2,b3) = Vaabj(a1,a,b3,j)*t1b(b2,j)
               tppqq(a,a1,b2,b3) -= t1ppqq(a,a1,b2,b3)
#
            ENDDO j
#
            DO i
#
               REQUEST              Vbbai(b3,b2,a1,i) i
               GET                  t1a(a,i)
#
               t1ppqq(a,a1,b2,b3) = Vbbai(b3,b2,a1,i)*t1a(a,i)
               tppqq(a,a1,b2,b3) -= t1ppqq(a,a1,b2,b3)
#
            ENDDO i
#
            DO i
            DO j1
#
               REQUEST               T2ab(a,i,b2,j1) j1
               REQUEST               Vpiqj(a1,i,b3,j1) j1
               GET                   t1a(a,i)
               GET                   t1b(b2,j1)
#
               t1ppqq(a,i,b2,j1)    = T2ab(a,i,b2,j1)
               t2ppqq(a,i,b2,j1)   = t1a(a,i)^t1b(b2,j1)
               t1ppqq(a,i,b2,j1)   += t2ppqq(a,i,b2,j1)
#
               t3ppqq(a,a1,b2,b3)  = t1ppqq(a,i,b2,j1)*Vpiqj(a1,i,b3,j1)
               tppqq(a,a1,b2,b3)  += t3ppqq(a,a1,b2,b3)
#
            ENDDO j1
            ENDDO i
#
            PREPARE HBAR_aabb(a,a1,b2,b3) += tppqq(a,a1,b2,b3)
      ENDPARDO a, b2, a1, b3
#
#     done (alpha,alpha,beta,beta) spin component.
#     --------------------------------------------
#
     EXECUTE SERVER_BARRIER 

     ENDPROC HBAR_ABCD
#    -----------------

     PROC FORM_TAU
#    -------------

     PARDO a, i, b, j
         GET T1a(a,i)
         GET T1b(b,j)
         REQUEST T2ab(a,i,b,j) j
         Taibj(a,i,b,j)  = T1a(a,i)^T1b(b,j)
         Taibj(a,i,b,j) += T2ab(a,i,b,j)

         PREPARE Tau_ab(a,i,b,j) = Taibj(a,i,b,j)
     ENDPARDO a, i, b, j
    
     PARDO a, i, a1, i1
         GET T1a(a,i)
         GET T1a(a1,i1)
         GET T1a(a,i1)
         GET T1a(a1,i)
         REQUEST T2aa(a,i,a1,i1) i1

         Tai(a,i)   = T1a(a,i)
         T1ai(a,i1) = T1a(a,i1)
         T1aiai(a,i,a1,i1) = Tai(a,i)^T1a(a1,i1)
         T2aiai(a,i,a1,i1) = T1ai(a,i1)^T1a(a1,i)
         T1aiai(a,i,a1,i1)-= T2aiai(a,i,a1,i1)

         T1aiai(a,i,a1,i1) += T2aa(a,i,a1,i1)
         PREPARE Tau_aa(a,i,a1,i1) = T1aiai(a,i,a1,i1)

     ENDPARDO a, i, a1, i1
     EXECUTE SERVER_BARRIER 

     ENDPROC FORM_TAU
#    ----------------

#     BEGIN MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO = 0.0
     ONE  = 1.0
     HALF = 0.5
     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC
     EXACT_HY     = ZERO 
     NO_AO_LADDER = ZERO
#
      CALL READ_DATA
      CALL CREATE_ARRAYS 

      IF NO_AO_LADDER == ONE
         CALL HBAR_ABCD 
      ELSE 
         CALL FORM_TAU
      ENDIF 

# The default denominator is 1-particle part and can be switched to Hbar

     CALL FORM_13P1H_DIAG
     IF EOM_DENOM == ONE
        CALL FORM_23P1H_DIAG
     ENDIF

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC

#bgn_debug
         execute print_scalar eom_thres 
         execute print_scalar eom_denom
         execute print_scalar eom_maxcyc
#end_debug

      MULT = ZERO 
      DO SPN_MULT

        MULT  += 1.0

        IF MULT == ONE
           SINGLET = ONE
           TRIPLET = ZERO
        ELSE
           SINGLET = ZERO
           TRIPLET = ONE
        ENDIF

        ROOT_COUNT = ZERO 

        DO NROOTS

           ROOT_COUNT += 1.0
           IF ROOT_COUNT > TARGET_ROOTS
              EXIT
           ENDIF
#bgn_debug
#        execute print_scalar SINGLET 
#        execute print_scalar TRIPLET 
#        execute print_scalar ROOT_COUNT
#end_debug

           MYROOT = ROOT_COUNT 
           CALL PREP_DEA_GUESS 
      
           ITER_COUNT = 0.0

           DO SUBSP_DIM

              CALL SET_TO_ZERO

              ITER_COUNT += 1.0
#bgn_debug
        execute print_scalar ITER_COUNT
#end_debug
              IF ITER_COUNT > MAX_SUBSP_DIM 
                 EXIT
              ENDIF 

              CALL SAVE_C_VECTORS 
#bgn_debug
#            call c_check 
#end_debug
              CALL HR_MULT
              CALL FORM_ABBB
    
              CALL SAVE_HC_VECTORS 

              IF ITER_COUNT == 1.0
                 CALL FORM_A_MATRIX_11
              ELSE
                CALL FORM_A_MATRIX_IJ
                CALL FORM_A_MATRIX_JI
                CALL FORM_A_MATRIX_II
              ENDIF 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
            EXECUTE XGEEV A_MATRIX DVECTORS 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
             IF ITER_COUNT != 1.0
                CALL REORDER_A_EIGS
             ENDIF 
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal. 
#
             IF ITER_COUNT == 1.0
                CALL FORM_NEWVECS_ITR1
             ELSE

                IF EXACT_HY == ONE
                   CALL FORM_NEWVECS 
                   CALL SELECT_VECS
                   CALL FORM_SELECTED_Y
                   CALL FORM_HBAR_Y_VECS
                ELSE
                    CALL FORM_NEWVECS
                    CALL SELECT_VECS
                    CALL FORM_SELECTED_Y
                    CALL FORM_NEW_HBAR_Y_VECS
                    CALL SELECT_HBAR_Y_VEC_TOGO
                ENDIF 

                CALL FORM_RESIDUAL_VEC

                CALL CHECK_CONVERGENCE
                IF ITER_COUNT > ONE
                   EDIFF = E_OLD - OMEGA
                ENDIF
                E_OLD = OMEGA
                EDIFF *=EDIFF
                EXECUTE SQUARE_ROOT EDIFF HALF
#bgn_debug
      execute print_scalar RESIDUAL_NORM
      execute print_scalar OMEGA
      execute print_scalar EDIFF 
#end_debug
                IF RESIDUAL_NORM  < EOM_THRES
                  EXIT
                ELSE

                   CALL FORM_CORRECTION_VEC

                   CALL DRIVE_ORTHO
                
                   CALL RESCALE_NEW_C

                ENDIF 

             ENDIF 

           ENDDO SUBSP_DIM

           EXECUTE SERVER_BARRIER 
#bgn_debug
#      execute print_scalar OMEGA 
#end_debug

           ITER_COUNT += -1.0
           IF ITER_COUNT == MAX_SUBSP_DIM
              IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means
#
                OMEGA = 0.0
              ENDIF 
           ENDIF 

           IF SINGLET == ONE
              DO IONE
              MCOUNT = 0.0
              DO MROOTS
                 MCOUNT += 1.0
                 IF MCOUNT == ROOT_COUNT
                    DEA_S(MROOTS,IONE) = OMEGA
                    TEE(MROOTS,IONE)   = DEA_S(MROOTS,IONE)
                    PUT DEA_ENER_S(MROOTS,IONE) = TEE(MROOTS,IONE)
                 ENDIF
              ENDDO MROOTS
              ENDDO IONE
           ENDIF 
           
           IF TRIPLET == ONE
              DO IONE
              MCOUNT = 0.0
              DO MROOTS
                 MCOUNT += 1.0
                 IF MCOUNT == ROOT_COUNT
                    DEA_T(MROOTS,IONE) = OMEGA
                    TEE(MROOTS,IONE)   = DEA_T(MROOTS,IONE)
                    PUT DEA_ENER_T(MROOTS,IONE) = TEE(MROOTS,IONE)
                 ENDIF 
              ENDDO MROOTS
              ENDDO IONE
            ENDIF 

         ENDDO NROOTS 
         EXECUTE SERVER_BARRIER 
#bgn_debug
      ROOT_COUNT -= 1.0
      IF SINGLET == ONE
      execute print_static DEA_S ROOT_COUNT 
      ENDIF 
      IF TRIPLET == ONE
      execute print_static DEA_T ROOT_COUNT 
      ENDIF 
#end_debug
      ENDDO SPN_MULT

      PRINT_FLAG = 41.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG DEA_S
      PRINT_FLAG = 42.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG DEA_T
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO WARNING DUMMY

                           ENDSIAL DEA_EOMCCSD
#                          -------------------


