     PROC SELECT_HBAR_Y_VEC_TOGO
#    ---------------------------
     PARDO a, b1
         GET Y1_AB_PICKED(a,b1)
         Tab(a,b1) = Y1_AB_PICKED(a,b1)
         PUT R1_AB(a,b1) =  Tab(a,b1)
     ENDPARDO a, b1

     PARDO a, b, i1, a1
         REQUEST Y2_ABAA_picked(a,b,i1,a1)  a1
         Tabia(a,b,i1,a1) = Y2_ABAA_picked(a,b,i1,a1)
         PREPARE R2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)
     ENDPARDO a, b, i1, a1

     PARdO a, b, j1, b1
         REQUEST Y2_ABBB_picked(a,b,j1,b1) b1
         Tabjb(a,b,j1,b1) = Y2_ABBB_picked(a,b,j1,b1)
         PREPARE R2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1)
     ENDPARDO a, b, j1, b1

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b1

                 GET HY1_AB(a,b1,NINDEX50)
                 Tab(a,b1) = HY1_AB(a,b1,NINDEX50)
                 PUT HY1_AB_PICKED(a,b1) = Tab(a,b1)

           ENDPARDO a, b1
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, i1, a1

                 REQUEST HY2_ABAA(a,b,i1,a1,NINDEX50) a
                 Tabia(a,b,i1,a1) = HY2_ABAA(a,b,i1,a1,NINDEX50)
                 PREPARE HY2_ABAA_picked(a,b,i1,a1) = Tabia(a,b,i1,a1)

           ENDPARDO a, b, i1, a1

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, j1, b1

                 REQUEST HY2_ABBB(a,b,j1,b1,NINDEX50) j1
                 Tabjb(a,b,j1,b1) = HY2_ABBB(a,b,j1,b1,NINDEX50)
                 PREPARE HY2_ABBB_picked(a,b,j1,b1) = Tabjb(a,b,j1,b1)

           ENDPARDO a, b, j1, b1

        ENDIF
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

     ENDPROC SELECT_HBAR_Y_VEC_TOGO
#    ------------------------------

     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO a, b1
         GET Y1_AB_PICKED(a,b1)
         Tab(a,b1) = Y1_AB_PICKED(a,b1)
         PUT R1_AB(a,b1) =  Tab(a,b1)
      ENDPARDO a, b1

      PARDO a, b, i1, a1
         REQUEST Y2_ABAA_picked(a,b,i1,a1)  a1
         Tabia(a,b,i1,a1) = Y2_ABAA_picked(a,b,i1,a1) 
         PREPARE R2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)
      ENDPARDO a, b, i1, a1

      PARdO a, b, j1, b1
         REQUEST Y2_ABBB_picked(a,b,j1,b1) b1
         Tabjb(a,b,j1,b1) = Y2_ABBB_picked(a,b,j1,b1)
         PREPARE R2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1)
      ENDPARDO a, b, j1, b1

      EXECUTE SERVER_BARRIER 

      CALL HR_MULT
      CALL FORM_ABBB

      PARDO a, b1
            GET HR1_AB(a,b1)
            Tab(a,b1) = HR1_AB(a,b1)
            PUT HY1_AB_picked(a,b1) =  Tab(a,b1)
      ENDPARDO a, b1

      PARDO a, b, i1, a1
         REQUEST HR2_ABAA(a,b,i1,a1) a1 
         Tabia(a,b,i1,a1) = HR2_ABAA(a,b,i1,a1)
         PREPARE HY2_ABAA_picked(a,b,i1,a1) = Tabia(a,b,i1,a1)
      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1
         REQUEST HR2_ABBB(a,b,j1,b1) b1
         Tabjb(a,b,j1,b1) =  HR2_ABBB(a,b,j1,b1)
         PREPARE HY2_ABBB_picked(a,b,j1,b1) = Tabjb(a,b,j1,b1)
      ENDPARDO a, b, j1, b1

      EXECUTE SERVER_BARRIER 

