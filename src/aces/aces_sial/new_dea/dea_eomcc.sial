                        SIAL DEA_EOMCCSD
#                       ---------------

      index kiter    = 1, cc_iter
      index Ione     = 1, 1
      index Spn_mult = 1, 2

      Index Ndim     = 1, 100
      Index Nroots   = 1, 12
      Index Mroots   = 1, 12
      Index Subsp_dim= 1, 50
      Index Nindex50 = 1, 50
      Index Mindex50 = 1, 50
      Index Kindex50 = 1, 50
      Index Lindex50 = 1, 50
#
      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#
      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
#
      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt
#
      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
#
      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

#     CCSD amplitudes
#     ---------------
#
      distributed t1a(a,i)
      distributed t1b(b,j)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)
#
#     Transformed integrals
#     ---------------------
#
      served VSpipi(p,i,p1,i1)
      served VSqjqj(q,j,q1,j1)
      served Vpiqj(p,i,q,j)
      served VSaaai(a,a1,a2,i)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)
      served Vxxxa(mu,nu,lambda,a)
      served Vxxaa(mu,nu,a,a1)
      served Vxaaa(mu,a2,a1,a)
      served Vxbxa(mu,b,lambda,a)
#
#     HBAR
#     ----
#
      distributed HBAR_AA(a,a1)
      distributed HBAR_BB(b,b1)
      distributed HBAR_II(i1,i)
      distributed HBAR_JJ(j1,j)
      distributed HBAR_IA(i,a1)
      distributed HBAR_JB(j,b1)

      distributed DDaa(a,a1)
      distributed DDii(i,i1)
      distributed DDia(i,a1)
      distributed DDbb(b,b1)
      distributed DDjj(j,j1)

      distributed D1_AB(a,b1)
      Served D2_ABAA(a,b,i1,a1)
      Served D2_ABBB(a,b,j1,b1)

      served HBAR_aaaa(a,a1,a2,a3)
      served HBAR_bbbb(b,b1,b2,b3)
      served HBAR_aabb(a,a1,b,b1)
#
      served HBAR_iiii(i,i1,i2,i3)
      served HBAR_jjjj(j,j1,j2,j3)
      served HBAR_iijj(i,i1,j,j1)
#
      served HBAR_AIBC_aaaa(a,a1,i,a2)
      served HBAR_AIBC_bbbb(b,b1,j,b2)
      served HBAR_AIBC_aabb(a,a1,j,b2)
      served HBAR_AIBC_bbaa(b,b1,i,a2)
#
      served HBAR_JKIA_aaaa(i1,i,i2,a1)
      served HBAR_JKIA_bbbb(j1,j,j2,b1)
      served HBAR_JKIA_aabb(i1,i,j2,b1)
      served HBAR_JKIA_bbaa(j1,j,i2,a1)
#
      served HBAR_IAJK_aaaa(i,i1,a,i2)
      served HBAR_IAJK_aabb(i,i1,b,j)
      served HBAR_IAJK_bbaa(j,j1,a,i)
      served HBAR_IAJK_bbbb(j,j1,b,j2)
#
      served HBAR_AJIB_aaaa(i1,a1,a,i)
      served HBAR_AJIB_bbbb(j1,b1,b,j)
      served HBAR_AJIB_aabb(i,a,b,j)
      served HBAR_AJIB_BBAA(j,b,a,i)
      served HBAR_AJIB_iibb(i1,i,b,b1)
      served HBAR_AJIB_jjaa(j1,j,a,a1)
#
      served HBAR_ABCI_aaaa(a,a1,a2,i)
      served HBAR_ABCI_bbbb(b,b1,b2,j)
      served HBAR_ABCI_aabb(a,a1,b,j)
      served HBAR_ABCI_bbaa(b,b1,a,i)

      Served Tau_ab(a,i,b,j)
      Served Tau_aa(a,i,a1,i1)
#
      Distributed R1_AB(a,b1)
      Distributed R1_AB_guess(a,b1)
      Distributed R1_AB_INTMD(a,b1)
      Distributed R1_AB_HIST(a,b,subsp_dim)

      Distributed Y1_AB(a,b,subsp_dim)
      Distributed HY1_AB(a,b,subsp_dim)

      Distributed Y1_AB_picked(a,b1)

      Distributed HY1_AB_picked(a,b1)

      Distributed RES1_AB(a,b1)

      Distributed HR1_AB(a,b1)
      Distributed AOHR1_AB(a,b1)
      Distributed HR1_AB_ASYM(a,b1)

      Distributed CORR_VEC_AB(a,b1)

      Distributed HR1_AB_HIST(a,b,subsp_dim)

      Distributed Xbi(b,i)
      Distributed Xaj(a,j)
      
      SERVED HR2_ABAA(a,b,i1,a1)
      SERVED HR2_ABBB(a,b,j1,b1)
      SERVED R2_ABAA(a,b,i1,a1)
      SERVED R2_ABBB(a,b,j1,b1)

      SERVED R2_ABAA_HIST(a,b,i1,a,subsp_dim)
      SERVED R2_ABBB_HIST(a,b,j1,b,subsp_dim)

      SERVED HR2_ABAA_HIST(a,b,i1,a,subsp_dim)
      SERVED HR2_ABBB_HIST(a,b,j1,b,subsp_dim)

      SERVED Y2_ABAA(a,b,i1,a,subsp_dim)
      SERVED Y2_ABBB(a,b,j1,a,subsp_dim)

      SERVED HY2_ABAA(a,b,i1,a,subsp_dim)
      SERVED HY2_ABBB(a,b,j1,a,subsp_dim)
 
      SERVED Y2_ABAA_picked(a,b,i1,a1)
      SERVED Y2_ABBB_picked(a,b,i1,a1)

      SERVED HY2_ABAA_picked(a,b,i1,a1)
      SERVED HY2_ABBB_picked(a,b,j1,b1)

      SERVED RES2_ABAA(a,b,i1,a1)
      SERVED RES2_ABBB(a,b,j1,b1)

      SERVED CORR_VEC_ABAA(a,b,i1,a1)
      SERVED CORR_VEC_ABBB(a,b,j1,b1)

      SERVED R2_ABAA_INTMD(a,b,i1,a1)
      SERVED R2_ABBB_INTMD(a,b,j1,b1)

      Distributed ORTHO_COEF(NINDEX50,MINDEX50)
      Distributed DEA_ENER_S(MROOTS,IONE)
      Distributed DEA_ENER_T(MROOTS,IONE)

      Distributed TAO_AB(mu,lambda)
      Distributed T1AO_AB(lambda,b)
      Distributed T2AO_AB(lambda,Sigma)
      Distributed TTTax(a,mu)
      Distributed Nij(i,j)
      Distributed Nai_ab(a,j)

      Served TAO_aa(lambda,i,sigma,i1)
      Served TAO_bb(lambda,j,sigma,j1)
      Served T1AO_aa(lambda,i,a,i1)
      Served T1AO_bb(lambda,j,b,j1)
      Served T2AO_aa(lambda,i,sigma,i1)
      Served T2AO_bb(lambda,j,sigma,j1)
      Served T2AO_xbia(lambda,b,i,a1)
      Served T2AO_abix(a,b,i,lambda)
      Served T2AO_axjb(a,lambda,j,b1)
      Served T2AO_abjx(a,b,j,lambda)
      Served T2AO_axia(a,lambda,i,a1)

      Served T2AO_xxia(mu,nu,i,a1)
      Served T2AO_axix(a,mu,i,nu)
      Served T2AO_xbix(mu,b,i,nu)
      Served T2AO_axjx(a,mu,j,nu)
      Served T2AO_xbjx(mu,b,j,nu)
      Served T2AO_xxjb(mu,nu,j,b1)

      Served T2IAO_xxia(lambda,sigma,i,a1)
      Served T2IAO_axix(a,sigma,i,lambda)
      Served T2IAO_xbix(lambda,b,i,sigma)
      Served T2IAO_axjx(a,lambda,j,sigma)
      Served T2IAO_xbjx(sigma,b,j,lambda)
      Served T2IAO_xxjb(sigma,lambda,j,b1)

      Served tttaxia(a,nu,i,a)
      Served tttabix(a,b,i,nu)
      Served tttaxjb(a,nu,j,b1)
      Served tttxbjb(mu,b,j,b1)
   

      Served Nijia(i,j,i1,a)
      Served Nai_abia1(a,j,i,a1)
      Served Nai_abia2(a,j,i,a1)

      Served Nibii(i,b,i1,i2)
      Served Najii(a,j,i,i1)
      Served Nai_abii1(a,b,i,i1)
      Served Nai_abii2(a,b,i,i1)
      Served Nai_ibia1(i,b,i1,a1)
      Served Nai_ibia2(i,b,i1,a1)
 
#     Temporary arrays
#     ---------------
#
      Temp Tee(mroots,ione)
      Temp Tab(a,b1)
      Temp Tba(b,a)
      Temp T1ba(b,a)
      Temp T1ab(a,b1)

      Temp Tmpaj(a,j)
      Temp Tmpbi(b,i)
      Temp Tji(j,i)
      Temp Tpp(p,p1)
      Temp tij(i,j)
      distributed Nai_ba(b,i)
      temp tai_ab(a,j)
      temp tai_ba(b,i)

      Temp Tabia(a,b,i1,a1)
      Temp T1abia(a,b,i1,a1)
      Temp T2abia(a,b,i1,a1)
      Temp Tabjb(a,b,j1,b1) 
      Temp Tiijj(i,i2,j,j2)
      Temp T22ia(j2,i2)
      Temp T1abjb(a,b,j1,b1)
      Temp T2abjb(a,b,j1,b1)
      Temp Taabb(a,a2,b,b2)
      Temp Taxia(a,nu,i,a)
      Temp Taxib(a,nu,i,b)
      Temp T1axia(a,nu,i,a)
      Temp T2axia(a,nu,i,a)
      Temp Tmpijib(i2,j1,i,b1) 
      Temp Tmpib(i,b1) 
      Temp Tmpja(j,a1)
      Temp tijia(i,j,i1,a1)
      Temp tajii(a,j,i,i1)
      Temp tai_abia(a,j,i,a1)
      Temp tai_abii(a,b,i,i1)
      Temp tai_ibia(i,b,i1,a1)
      Temp tab2ia(a,b,i1,a1)
      Temp tibii(i,b,i2,i1)
      Temp t1ibii(i,b,i2,i1)
      Temp taibj(a,i,b,j)
      Temp taiai(a,i,a1,i)
      Temp t1aiai(a,i,a1,i)
      Temp t2aiai(a,i,a1,i)

      Temp Tqppq(q1,p1,p,q)
      Temp T1qppq(q1,p1,p,q)
      Temp Tpqpq(p,q,p1,q1)
      Temp T1pqpq(p,q,p1,q1)
      Temp Tpppp(p,p1,p2,p3)
      Temp T1pppp(p,p1,p2,p3)
      Temp T2pppp(p,p1,p2,p3)
      Temp T3pppp(p,p1,p2,p3)
      Temp T4pppp(p,p1,p2,p3)
      Temp Tqqqq(q,q1,q2,q3)
      Temp T1qqqq(q,q1,q2,q3)
      Temp T2qqqq(q,q1,q2,q3)
      Temp T3qqqq(q,q1,q2,q3)
      Temp T4qqqq(q,q1,q2,q3)
      Temp Tmpaabi(a2,a3,b,i) 
      Temp Tmpabai(a,b,a1,i)
      Temp tppqq(p,p1,q,q1)
      Temp T1ppqq(p,p1,q,q1)
      Temp T2ppqq(p,p1,q,q1)
      Temp T3ppqq(p,p1,q,q1)
      Temp T2qqpp(q,q1,p,p1)
      Temp T3qqpp(q,q1,p,p1)
#
      Temp TiN(i,NROOTS)
      Temp TjN(j,NROOTS)
      Temp Tii(i,i1)
      Temp Tjj(j,j1)

      Temp Tax(a,mu)
      Temp T1ax(a,mu)
      Temp Txxxx(mu,nu,lambda,sigma)
      Temp Txbxa(mu,b,lambda,a)
      Temp Yab(mu,nu)
      Temp T1xx(mu,lambda)
      Temp Zaa(lambda,i,a1,i1)
      Temp Zbb(lambda,j,b,j1)
      Temp Zab(lambda,b)
      Temp Txb(lambda,b)
      Temp ZZaa(lambda,i,sigma,i1)
      Temp ZZ1aa(lambda,i,sigma,i1)
      Temp ZZbb(lambda,j,sigma,j1)
      Temp ZZ1bb(lambda,j,sigma,j1)
      Temp ZZab(lambda,sigma)
      Temp tmpaaii(a,a1,i,i1)
      Temp tmpajii1(a,j,i,i1)
      Temp tmpabia(a1,b1,i,a)
      temp tmpabjb(a,b,j,b1)
      Temp tmpijia(i,j,i1,a)
      Temp tmpabaj(a2,b,a,j)
      Temp tmpibai(i1,b,a,i)
      Temp Tmpabij(a,b,i,j)
      Temp tmpabbi(a,b,b1,i)

      Temp Zxbia(lambda,b,i,a1)
      Temp Zaxia(a,lambda,i,a1)
      Temp Txbia(lambda,b,i,a1)
      Temp Zaxjb(a,lambda,j,b1)
      Temp Taxjb(a,lambda,j,b1)
      Temp Zabjx(a,b,j,lambda)
      Temp Tabjx(a,b,j,lambda)
      Temp ZZaxjx(a,lambda,j,sigma)
      Temp Taxjx(a,sigma,j,lambda)
      Temp ZZxbjx(sigma,b,j,lambda)
      Temp Txbjx(sigma,b,j,lambda)
      Temp ZZxxjb(sigma,lambda,j,b1)
      Temp Txxjb(sigma,lambda,j,b1)
      Temp T1axjx(a,mu,j,nu)
      Temp Z1axjx(a,mu,j,nu)
      Temp T1xbjx(mu,b,j,nu)
      Temp Z1xbjx(mu,b,j,nu)
      Temp T1xxjb(mu,nu,j,b1)
      Temp Z1xxjb(mu,nu,j,b1)
      Temp T1axjb(a,nu,j,b1)
      Temp Txbjb(mu,b,j,b1)
      Temp T1xbjb(mu,b,j,b1)
      Temp T1axib(a,nu,i,b)
      Temp T1abix(a,b,i,nu)
      Temp tmpiaaj(i,a1,a,j)
      Temp tmpbiai(b,i,a,i1)
      Temp tmpiaja(i,a,j,a1)
      Temp tmpaaai(a1,a2,a,i1)
      Temp tmpabib(a2,b1,i1,b)
      Temp tmpaaia(a2,a1,i1,a)
      Temp tmpbiaa(b,i,a1,a2)
      Temp tmpbiii(b,i,i1,i2)
      Temp t3abia(a,b,i,a1)
      Temp t4abia(a,b,i,a1)
   
      Temp Zabix(a,b,i,lambda)
      Temp Tabix(a,b,i,lambda)

      Temp Zxxia(lambda,sigma,i,a1)
      Temp Txxia(lambda,sigma,i,a1)

      Temp ZZxxia(lambda,sigma,i,a1)
      Temp ZZaxix(a,sigma,i,lambda)
      Temp Taxix(a,sigma,i,lambda)

      Temp ZZxbix(lambda,b,i,sigma)
      Temp Txbix(lambda,b,i,sigma)

      Temp Ixxxx(lambda,mu,sigma,nu)
      Temp I1xxxx(lambda,mu,sigma,nu)
      Temp T1xxia(mu,nu,i,a1)
      Temp Z1xxia(mu,nu,i,a1)
      Temp T1axix(a,mu,i,nu)
      Temp Z1axix(a,mu,i,nu)

      Temp T1xbix(mu,b,i,nu)
      Temp T2xbix(mu,b,i,nu)
      Temp Z1xbix(mu,b,i,nu)


      Temp Tip(i,nroots)
      Temp Tjp(j,nroots)

      Temp TS(MINDEX50,NINDEX50)
      Temp Tabs(a,b1,MINDEX50)
      Temp T1abs(a,b1,NINDEX50)
      Temp Tabias(a,b,i1,a,subsp_dim)
      Temp T1abias(a,b,i1,a,subsp_dim)
      Temp Tabjbs(a,b,j1,b,subsp_dim)
      Temp T1abjbs(a,b,j1,b,subsp_dim)
      
      Temp Aoint(mu,nu,lambda,sigma)
      Temp Txxxa(mu,nu,lambda,a)
      Temp Txxaa(mu,nu,a,a1)
      Temp Txaaa(mu,a2,a1,a)
      Temp Taaaa(a3,a2,a1,a)     

      Temp Taa(a,a1)
      Temp T1aa(a,a1)
      Temp T22aa(a,b)
      Temp Tbb(b,b1)
      Temp T1bb(b,b1)
      Temp T2ab1(a,b)
      Temp Txx(NINDEX50,NINDEX50)
      Temp Taajj(a,a1,j,j1)
      Temp Tbbii(b,b1,i,i1)
      temp Tai(a,i)
      temp T1ai(a,i)
      temp Tbj(b,j)

#     Static arrays
#     -------------
#
      Static IP_INIT_HAA(i,i1)
      Static IP_INIT_HBB(j,j1)
      Static VEC_AA(i,Ndim)
      Static VEC_BB(j,Ndim)
      Static RVEC_AA_INTMD(i,Nroots)
      Static RVEC_BB_INTMD(j,Nroots)
      Static A_MATRIX(mindex50,nindex50)
      Static A_DIAGS(MINDEX50)
      Static DVECTORS(mindex50,nindex50)
      Static OVERLAP_R(Nindex50)
      Static Sii(i,i1)
      Static Sdii(i,i1)
      Static Saa(a,a1)
      Static Sdaa(a,a1)
      Static Sjj(j,j1)
      Static Sdjj(j,j1)
      Static Sbb(b,b1)
      Static Sdbb(b,b1)
      Static ETEMP(mindex50,nindex50)
      Static DEA_S(MROOTS,IONE)
      Static DEA_T(MROOTS,IONE)
      Static DUMMY(Ione,Ione)
      Static INIT_RVEC_AB(a,b1)

#     Scalar arrays
#     -------------
#     
      Scalar ROOT_COUNT
      Scalar TARGET_ROOTS
      Scalar EOM_THRES
      Scalar MYROOT 
      Scalar COUNTER 
      Scalar tmp
      Scalar tmpa
      Scalar tmpb
      Scalar suma
      Scalar sumb 
      Scalar sumab
      Scalar Sumaaa
      Scalar Sumbbb
      Scalar Sumaab
      Scalar Sumbba
      Scalar MAX_SUBSP_DIM
      Scalar Iter_count 
      Scalar Count 
      Scalar Ncount 
      Scalar Mcount 
      Scalar Kcount 
      Scalar Lcount 
      Scalar HC_A
      Scalar HC_B
      Scalar HC_AAA
      Scalar HC_BBB
      Scalar HC_AAB
      Scalar HC_BBA
