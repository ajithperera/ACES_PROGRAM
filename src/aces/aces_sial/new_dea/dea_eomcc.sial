#      suma=0.0
#      pardo a,b1
#         get CORR_VEC_ab(a,b1)
#         tmp =  CORR_VEC_ab(a,b1) *  CORR_VEC_ab(a,b1)
#         tmpa += tmp
#      endpardo a,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,i1,a1
#            request CORR_VEC_abaa(a,b,i1,a1) a1
#            tmp =  CORR_VEC_abaa(a,b,i1,a1) *  CORR_VEC_abaa(a,b,i1,a1)
#            tmpa += tmp
#      endpardo a,b,i1,a1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,j1,b1
#            request CORR_VEC_abbb(a,b,j1,b1) b1
#            tmp = CORR_VEC_abbb(a,b,j1,b1) * CORR_VEC_abbb(a,b,j1,b1)
#            tmpa+= tmp
#      endpardo a,b,j1,b1
#      execute sip_barrier
