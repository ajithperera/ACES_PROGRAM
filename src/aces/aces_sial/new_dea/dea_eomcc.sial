     PROC FORM_RESIDUAL_VEC
#    ----------------------

      EXECUTE RETURN_SELECTED A_DIAGS IMAX 
      OMEGA   = IMAX
      OMEGAM  = OMEGA
      OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug

     PARDO a, b1
           GET HY1_AB_picked(a,b1)
           GET Y1_AB_picked(a,b1)

           Tab(a,b1)   = HY1_AB_picked(a,b1)
           T1ab(a,b1)  = Y1_AB_picked(a,b1)
           T1ab(a,b1) *= Omegam
           Tab(a,b1)  +=  T1ab(a,b1) 
           PUT RES1_AB(a,b1) =  Tab(a,b1)
     ENDPARDO a, b1

     PARDO a, b, i1, a1

         REQUEST HY2_ABAA_picked(a,b,i1,a1) a1
         REQUEST Y2_ABAA_picked(a,b,i1,a1)  a1
         Tabia(a,b,i1,a1)   = HY2_ABAA_picked(a,b,i1,a1)
         T1abia(a,b,i1,a1)  = Y2_ABAA_picked(a,b,i1,a1)
         T1abia(a,b,i1,a1) *= Omegam
         Tabia(a,b,i1,a1)  += T1abia(a,b,i1,a1)
         PREPARE RES2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

         REQUEST HY2_ABBB_picked(a,b,j1,b1) b1
         REQUEST Y2_ABBB_picked(a,b,j1,b1)  b1
         Tabjb(a,b,j1,b1)   = HY2_ABBB_picked(a,b,j1,b1)
         T1abjb(a,b,j1,b1)  = Y2_ABBB_picked(a,b,j1,b1)
         T1abjb(a,b,j1,b1) *= Omegam
         Tabjb(a,b,j1,b1)  += T1abjb(a,b,j1,b1)
         PREPARE RES2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1)

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER
