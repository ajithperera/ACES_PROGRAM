                       T1abjbs(a,b,j1,b1,NINDEX50) = Tabjbs(a,b,j1,b1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE HY2_ABBB(a,b,j1,b1,NINDEX50) += T1abjbs(a,b,j1,b1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER 

     ENDPROC FORM_NEW_HBAR_Y_VECS
