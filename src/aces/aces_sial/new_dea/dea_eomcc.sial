# -----------------------------------------------------------

      PROC READ_DATA
#     --------------
#
      create t1a
      create t1b
      create HBAR_AA
      create HBAR_BB
      create HBAR_II
      create HBAR_JJ
      create HBAR_IA
      create HBAR_JB

      execute sip_barrier
      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vbbii
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
#
      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb
#
      execute list_to_blocks                HBAR_AA
      execute list_to_blocks                HBAR_BB
      execute list_to_blocks                HBAR_II
      execute list_to_blocks                HBAR_JJ
      execute list_to_blocks                HBAR_IA
      execute list_to_blocks                HBAR_JB
#
      execute list_to_blocks                HBAR_IIII
      execute list_to_blocks                HBAR_JJJJ
      execute list_to_blocks                HBAR_IIJJ
#
      execute list_to_blocks                HBAR_AIBC_aaaa
      execute list_to_blocks                HBAR_AIBC_bbbb
      execute list_to_blocks                HBAR_AIBC_aabb
      execute list_to_blocks                HBAR_AIBC_bbaa
#
      execute list_to_blocks                HBAR_JKIA_aaaa
      execute list_to_blocks                HBAR_JKIA_bbbb
      execute list_to_blocks                HBAR_JKIA_aabb
      execute list_to_blocks                HBAR_JKIA_bbaa
#
      execute list_to_blocks                HBAR_IAJK_aaaa
      execute list_to_blocks                HBAR_IAJK_aabb
      execute list_to_blocks                HBAR_IAJK_bbaa
      execute list_to_blocks                HBAR_IAJK_bbbb
#
      execute list_to_blocks                HBAR_AJIB_aaaa
      execute list_to_blocks                HBAR_AJIB_bbbb
      execute list_to_blocks                HBAR_AJIB_aabb
      execute list_to_blocks                HBAR_AJIB_BBAA
      execute list_to_blocks                HBAR_AJIB_iibb
      execute list_to_blocks                HBAR_AJIB_jjaa
#
      execute list_to_blocks                HBAR_ABCI_aaaa
      execute list_to_blocks                HBAR_ABCI_bbbb
      execute list_to_blocks                HBAR_ABCI_aabb
      execute list_to_blocks                HBAR_ABCI_bbaa
#
      execute server_barrier
      execute read_list_to_blocks
      execute server_barrier
#
      ENDPROC READ_DATA
#     -----------------

      PROC CREATE_ARRAYS
#     --------------------

      CREATE R1_AB
      CREATE HR1_AB_ASYM
      CREATE HR1_AB
      CREATE AOHR1_AB
      CREATE DDII
      CREATE DDJJ
      CREATE DDAA
      CREATE DDBB
      CREATE D1_AB
      CREATE R1_AB_HIST
      CREATE HR1_AB_HIST
      CREATE Y1_AB
      CREATE HY1_AB
      CREATE Y1_AB_PICKED
      CREATE HY1_AB_PICKED
      CREATE RES1_AB
      CREATE XBI
      CREATE XAJ
      CREATE CORR_VEC_AB
      CREATE ORTHO_COEF
      CREATE R1_AB_INTMD
      CREATE DEA_ENER_S
      CREATE DEA_ENER_T
      CREATE TAO_AB
      CREATE T1AO_AB
      CREATE T2AO_AB
      CREATE TTTAX
      CREATE NAI_AB
      CREATE NAI_BA
      CREATE NIJ

      EXECUTE SIP_BARRIER 

      ENDPROC CREATE_ARRAYS
#     --------------------

      PROC PREP_DEA_GUESS
#     -------------------

      DO NROOTS
         PARDO a, b1
             INIT_RVEC_AB(a,b1) = 0.0
         ENDPARDO a, b1
      ENDDO NROOTS

      IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF

      EXECUTE FORM_DEA_GUESS INIT_RVEC_AB MYROOT

#bgn_debug
#      execute print_scalar myroot 
#end_debug

      PARDO a, b1
          Tab(a,b1) = INIT_RVEC_AB(a,b1)
          PUT R1_AB_INTMD(a,b1) =  Tab(a,b1)
      ENDPARDO a, b1

      EXECUTE SIP_BARRIER

#bgn_debug
#      tmpa = 0.0
#      pardo a, b1
#         get R1_ab_intmd(a,b1)
#         Tab(a,b1) = R1_ab_intmd(a,b1)
#         tmp  =  Tab(a,b1) * T1ab(a,b1)
#         tmpa += tmp
#      endpardo a, b1
#      execute sip_barrier
#      collective suma+=tmpa
#      execute print_scalar suma
#end_debug
#
      
      PARDO a, b, i1, a1
         Tabia(a,b,i1,a1) = 0.0
         PREPARE R2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)
      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1
         Tabjb(a,b,j1,b1) = 0.0
         PREPARE R2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1)
      ENDPARDO a, b, j1, b1

      EXECUTE SERVER_BARRIER 
 
      SUMA = 0.0
      TMPA = 0.0
      PARDO a, b1

            GET  R1_AB_intmd(a,b1) 
            Tab(a,b1) = R1_AB_intmd(a,b1)
            TMP   = Tab(a,b1) * Tab(a,b1)
            TMPA += TMP
      ENDPARDO a, b1

      EXECUTE SIP_BARRIER 
      COLLECTIVE  SUMA += TMPA

      SUMAB  = SUMA

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB 
      NORM_R = SUMAB 

      PARDO a, b1
            GET  R1_AB_intmd(a,b1)
            Tab(a,b1)  = R1_AB_intmd(a,b1)
            Tab(a,b1) *= INV_SQRT_NORM_R
            PUT R1_AB(a,b1)  = Tab(a,b1) 
      ENDPARDO a, b1

      EXECUTE SIP_BARRIER 

#bgn_debug
#      tmpa=0.0
#      suma=0.0
#      pardo a,b1
#         get r1_ab(a,b1) 
#         Tmp = r1_ab(a,b1) * r1_ab(a,b1)
#         tmpa += tmp
#      endpardo a,b1
#      execute server_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

      ENDPROC PREP_DEA_GUESS
#     ----------------------

      PROC FORM_23P1H_DIAG
#     --------------------

     PARDO a, a1

            GET              HBAR_aa(a1,a)
            Saa(a1,a)      = HBAR_aa(a1,a)
            execute return_diagonal Saa Sdaa
            taa(a1,a)      = Sdaa(a1,a)
            put DDaa(a1,a) = taa(a1,a)

     ENDPARDO a, a1

     PARDO b, b1

            GET              HBAR_bb(b1,b)
            Sbb(b1,b)      = HBAR_aa(b1,b)
            execute return_diagonal Sbb Sdbb
            tbb(b1,b)      = Sdbb(b1,b)
            put DDbb(b1,b) = taa(b1,b)

     ENDPARDO b, b1

     execute sip_barrier

     PARDO b, a
#
            taa(a,b)=0.0
#
            do a2
#
               get          DDaa(a,a2)
               t1aa(a2,b) = 1.0
#
               t22aa(a,b) = DDaa(a,a2)*t1aa(a2,b)
               taa(a,b)  += t22aa(a,b)
#
            enddo a2
#
           do b2
#
               get           DDaa(b,b2)
               t22aa(b2,a) = 1.0
#
               t1aa(a,b)   = DDaa(b,b2)*t22aa(b2,a)
               taa(a,b)   += t1aa(a,b)
#
            enddo b2
#
            do a2
            do b2
#
               request             HBAR_aabb(a,a2,b,b2) b2
               Taabb(a,a2,b,b2)  = HBAR_aabb(a,a2,b,b2)
               execute return_diagonal4 Taabb
               t22aa(b2,a2)      = 1.0
               t1aa(a,b)         = Taabb(a,a2,b,b2)*t22aa(b2,a2)
               taa(a,b)         += t1aa(a,b)
#
           enddo b2
           enddo a2
#
            PUT D1_AB(a,b) = taa(a,b)
     ENDPARDO b, a

     PARDO a, b, a1, i
            tabia(a,b,i,a1) = 0.0

            DO i1
               GET                 HBAR_ii(i1,i)
               tpp(i1,i)         = HBAR_ii(i1,i)
               execute return_diagonal4 tpp
               t2abia(a,b,i1,a1) = -1.0
               t1abia(a,b,i,a1)  = t2abia(a,b,i1,a1)*tpp(i1,i)
               tabia(a,b,i,a1)  += t1abia(a,b,i,a1)
            ENDDO i1

            DO a2
               GET                 HBAR_aa(a1,a2)
               tpp(a1,a2)        = HBAR_aa(a1,a2)
               execute return_diagonal4 tpp
               t2abia(a,b,i,a2) = 1.0
               t1abia(a,b,i,a1) = t2abia(a,b,i,a2)*tpp(a1,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2


            DO a2
               GET                HBAR_aa(a,a2)
               tpp(a,a2)        = HBAR_aa(a,a2)
               execute return_diagonal4 tpp
               t2abia(a2,b,i,a1) = 1.0
               t1abia(a,b,i,a1) = t2abia(a2,b,i,a1)*tpp(a,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2

            DO a2
               GET                HBAR_aa(b,a2)
               tpp(b,a2)        = HBAR_aa(b,a2)
               execute return_diagonal4 tpp
               t2abia(a,a2,i,a1) = 1.0
               t1abia(a,b,i,a1) = t2abia(a,a2,i,a1)*tpp(b,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2

           DO a2
               where a  == a2
            DO a3
               where b  == a3
               REQUEST             HBAR_aabb(a,a2,b,a3) a
               tpppp(a,a2,b,a3)  = HBAR_aabb(a,a2,b,a3)
               execute return_diagonal4 tpppp
               t2abia(a2,a3,i,a1) = 1.0
               t1abia(a,b,i,a1) = tpppp(a,a2,b,a3)*t2abia(a2,a3,i,a1)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a3
            ENDDO a2

            DO a2
               where b  == a2
            DO a3
               where a1 == a3
               REQUEST             HBAR_aabb(a1,a3,b,a2) b
               tpppp(a1,a3,b,a2) = HBAR_aabb(a1,a3,b,a2)
               execute return_diagonal4 tpppp
               t2abia(a,a2,i,a3) = 1.0
               t1abia(a,b,i,a1)  = t2abia(a,a2,i,a3)*tpppp(a1,a3,b,a2)
               tabia(a,b,i,a1)  += t1abia(a,b,i,a1)
            ENDDO a3
            ENDDO a2

            DO a2
               where a == a2
            DO a3
               where a1 == a3
               REQUEST              HBAR_aabb(a,a2,a1,a3) a
               tpppp(a,a2,a1,a3)  = HBAR_aabb(a,a2,a1,a3)
               execute return_diagonal4 tpppp
               t2pppp(i,a3,b,a2)  = 1.0
               t1pppp(a,b,a1,i)   = tpppp(a,a2,a1,a3)*t2pppp(i,a3,b,a2)
               t1abia(a,b,i,a1)   = t1pppp(a,b,a1,i)
               tabia(a,b,i,a1)   += t1abia(a,b,i,a1)
            ENDDO a3
            ENDDO a2

            PREPARE D2_ABAA(a,b,i,a1) += tabia(a,b,i,a1)
            PREPARE D2_ABBB(a,b,i,a1) += tabia(a,b,i,a1)
      ENDPARDO a, b, a1, i 

      PARDO a, b1, a1, i1
          t1pppp(a,b1,i1,a1)  = 1.0
          DO b
             where b == b1
          DO i
             where i == i1
             REQUEST                  HBAR_ajib_iibb(i1,i,b,b1) b
             tpppp(i1,i,b,b1)       = HBAR_ajib_iibb(i1,i,b,b1)
             execute return_diagonal4 tpppp

            t1abia(a,b,i,a1)              = t1pppp(a,b1,i1,a1)*tpppp(i1,i,b,b1)

            PREPARE D2_ABAA(a,b,i,a1) += tabia(a,b,i,a1)
            PREPARE D2_ABBB(a,b,i,a1) += tabia(a,b,i,a1)
          ENDDO i
          ENDDO b
    ENDPARDO a, b1, a1,i1

    execute server_barrier

    ENDPROC FORM_23P1H_DIAG
#   -----------------------

    PROC FORM_13P1H_DIAG
#   -------------------

     PARDO a, a1

            GET              HBAR_aa(a1,a)
            Saa(a1,a)      = HBAR_aa(a1,a)
            execute return_diagonal Saa Sdaa
            taa(a1,a)      = Sdaa(a1,a)
            put DDaa(a1,a) = taa(a1,a)

     ENDPARDO a, a1

     PARDO b, b1

            GET              HBAR_bb(b1,b)
            Sbb(b1,b)      = HBAR_aa(b1,b)
            execute return_diagonal Sbb Sdbb
            tbb(b1,b)      = Sdbb(b1,b)
            put DDbb(b1,b) = tbb(b1,b)

     ENDPARDO b, b1

     execute sip_barrier

     PARDO b, a
#
            taa(a,b)=0.0
#
            do a2
#
               get          DDaa(a,a2)
               t1aa(a2,b) = 1.0
#
               t22aa(a,b) = DDaa(a,a2)*t1aa(a2,b)
               taa(a,b)  += t22aa(a,b)
#
            enddo a2
#
           do b2
#
               get           DDaa(b,b2)
               t22aa(b2,a) = 1.0
#
               t1aa(a,b)   = DDaa(b,b2)*t22aa(b2,a)
               taa(a,b)   += t1aa(a,b)
#
            enddo b2

            PUT D1_AB(a,b) = taa(a,b)
     ENDPARDO b, a

     PARDO a, b, a1, i
            tabia(a,b,i,a1) = 0.0

            DO i1
               GET                 HBAR_ii(i1,i)
               tpp(i1,i)         = HBAR_ii(i1,i)
               execute return_diagonal4 tpp
               t2abia(a,b,i1,a1) = -1.0
               t1abia(a,b,i,a1)  = t2abia(a,b,i1,a1)*tpp(i1,i)
               tabia(a,b,i,a1)  += t1abia(a,b,i,a1)
            ENDDO i1

            DO a2
               GET                 HBAR_aa(a1,a2)
               tpp(a1,a2)        = HBAR_aa(a1,a2)
               execute return_diagonal4 tpp
               t2abia(a,b,i,a2) = 1.0
               t1abia(a,b,i,a1) = t2abia(a,b,i,a2)*tpp(a1,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2


            DO a2
               GET                HBAR_aa(a,a2)
               tpp(a,a2)        = HBAR_aa(a,a2)
               execute return_diagonal4 tpp
               t2abia(a2,b,i,a1) = 1.0
               t1abia(a,b,i,a1) = t2abia(a2,b,i,a1)*tpp(a,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2

            DO a2
               GET                HBAR_aa(b,a2)
               tpp(b,a2)        = HBAR_aa(b,a2)
               execute return_diagonal4 tpp
               t2abia(a,a2,i,a1) = 1.0
               t1abia(a,b,i,a1) = t2abia(a,a2,i,a1)*tpp(b,a2)
               tabia(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a2

            PREPARE D2_ABAA(a,b,i,a1) += tabia(a,b,i,a1)
            PREPARE D2_ABBB(a,b,i,a1) += tabia(a,b,i,a1)

    ENDPARDO a, b, a1,i

    execute server_barrier

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,b1
#            get d1_ab(a,b1)
#            tmp = d1_ab(a,b1) *  d1_ab(a,b1)
#            tmpa+= tmp
#      endpardo a, b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
