     PROC FORM_NEWVECS
#    ------------------
     PARDO a, b1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1_AB_HIST(a,b1,MINDEX50)
                       Tabs(a,b1,MINDEX50)  = R1_AB_HIST(a,b1,MINDEX50)
                       T1abs(a,b1,NINDEX50) = Tabs(a,b1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1_AB(a,b1,NINDEX50) += T1abs(a,b1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b1

     PARDO a, b, i1, a1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2_ABAA_HIST(a,b,i1,a1,MINDEX50)  a

                       Tabias(a,b,i1,a1,MINDEX50) = R2_ABAA_HIST(a,b,i1,a1,MINDEX50)
                       T1abias(a,b,i1,a1,NINDEX50) = Tabias(a,b,i1,a1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2_ABAA(a,b,i1,a1,NINDEX50) += T1abias(a,b,i1,a1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2_ABBB_HIST(a,b,j1,b1,MINDEX50)  j1

                       Tabjbs(a,b,j1,b1,MINDEX50) = R2_ABBB_HIST(a,b,j1,b1,MINDEX50)
                       T1abjbs(a,b,j1,b1,NINDEX50) = Tabjbs(a,b,j1,b1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2_ABBB(a,b,j1,b1,NINDEX50) += T1abjbs(a,b,j1,b1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER 

     ENDPROC FORM_NEWVECS
#    ---------------------

