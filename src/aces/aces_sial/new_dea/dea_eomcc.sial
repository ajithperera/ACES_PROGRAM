#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
  
     ENDPROC FORM_RESIDUAL_VEC
#    -----------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     HC_A   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0

     PARDO a, b1

           GET RES1_AB(a,b1)

           Tab(a,b1)   = RES1_AB(a,b1)

           TMP   = Tab(a,b1) * Tab(a,b1)
           SUMA += TMP

     ENDPARDO a, b1

     PARDO a, b, i1, a1

           REQUEST RES2_ABAA(a,b,i1,a1) a1

           Tabia(a,b,i1,a1)  = RES2_ABAA(a,b,i1,a1)

           TMP     = Tabia(a,b,i1,a1) * Tabia(a,b,i1,a1)
           SUMAAA += TMP
                
     ENDPARDO a, b, i1, a1
   
     PARDO a, b, j1, b1
           REQUEST RES2_ABBB(a,b,j1,b1) b1

           Tabjb(a,b,j1,b1)  = RES2_ABBB(a,b,j1,b1)
                     
           TMP     = Tabjb(a,b,j1,b1) * Tabjb(a,b,j1,b1)
           SUMBBB += TMP

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A   += SUMA
     COLLECTIVE HC_AAA += SUMAAA
     COLLECTIVE HC_BBB += SUMBBB

     A_VALUE  = HC_A
     A_VALUE += HC_AAA
     A_VALUE += HC_BBB

     EXECUTE SIP_BARRIER

     HALF = 0.5
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------

     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     PARDO a, b1
           GET RES1_AB(a,b1)
           GET D1_AB(a,b1)

           Tab(a,b1)   = D1_AB(a,b1)
           T1ab(a,b1)  = RES1_AB(a,b1)

           Tab(a,b1)  *= -1.0
           T2ab1(a,b1)  = Omega
           Tab(a,b1)  += T2ab1(a,b1)

           EXECUTE APPLY_DEN2_NOR  T1ab Tab

           PUT CORR_VEC_AB(a,b1) =  T1ab(a,b1)

     ENDPARDO a, b1

     PARDO a, b, i1, a1
         REQUEST RES2_ABAA(a,b,i1,a1) a1
         REQUEST D2_ABAA(a,b,i1,a1) a1

         Tabia(a,b,i1,a1)  = D2_ABAA(a,b,i1,a1)
         T1abia(a,b,i1,a1) = RES2_ABAA(a,b,i1,a1)

         Tabia(a,b,i1,a1) *= -1.0
         T2abia(a,b,i1,a1) = Omega
         Tabia(a,b,i1,a1)  += T2abia(a,b,i1,a1)

         EXECUTE APPLY_DEN4 T1abia Tabia
             
         PREPARE CORR_VEC_ABAA(a,b,i1,a1) = T1abia(a,b,i1,a1)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

         REQUEST RES2_ABBB(a,b,j1,b1) b1
         REQUEST D2_ABBB(a,b,j1,b1) b1

         Tabjb(a,b,j1,b1)  = D2_ABBB(a,b,j1,b1)
         T1abjb(a,b,j1,b1) = RES2_ABBB(a,b,j1,b1)

         Tabjb(a,b,j1,b1)  *= -1.0
         T2abjb(a,b,j1,b1)  = Omega
         Tabjb(a,b,j1,b1)  += T2abjb(a,b,j1,b1)

         EXECUTE APPLY_DEN4 T1abjb Tabjb

         PREPARE CORR_VEC_ABBB(a,b,j1,b1) = T1abjb(a,b,j1,b1)

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER

#bgn_debug
