    PROC THREE_BODY_INTMD
#   ---------------------
# Three body intermediate X(a,m) = R(Ef)*Hbar(An,Ef) + R(Ae,{fn,FN})*V(m{Nn},e{Ff})# - R(Eb,{fn,FN})*V(M{Nn},E{Ff}) - R(Ce,{fn,FN})*V(m{Nn},e{Ef})
#
     PARDO a1, b1, a, j

            REQUEST       HBAR_AIBC_aabb(a,a1,j,b1) j
            GET           R1_AB(a1,b1)
            tmpaj(a,j)  = HBAR_AIBC_aabb(a,a1,j,b1)*R1_AB(a1,b1)
            PUT Xaj(a,j) += tmpaj(a,j)

     ENDPARDO a1, b1, a, j

     PARDO a, b1, i1, a1

            REQUEST R2_ABAA(a,b1,i1,a1) a1

            DO j
               REQUEST        Vpiqj(a1,i1,b1,j) j
               tmpaj(a,j)   = R2_ABAA(a,b1,i1,a1)*Vpiqj(a1,i1,b1,j)
               PUT Xaj(a,j) += tmpaj(a,j)
            ENDDO j

     ENDPARDO a, b1, i1, a1

     PARDO a, b, b1, j1

            REQUEST R2_ABBB(b,a,j1,b1) b1

            DO j
               REQUEST         VSqjqj(b,j,b1,j1) j1
               tmpaj(a,j)   =  R2_ABBB(b,a,j1,b1)*VSqjqj(b,j,b1,j1)
               tmpaj(a,j)  *=  0.5
               PUT Xaj(a,j) += tmpaj(a,j)
            ENDDO j

     ENDPARDO a, b, b1, j1

     PARDO b, i, b1, a1

            REQUEST      HBAR_AIBC_bbaa(b,b1,i,a1) a1
            GET          R1_AB(a1,b1)
            tmpbi(b,i)  = HBAR_AIBC_bbaa(b,b1,i,a1)*R1_AB(a1,b1)
            PUT Xbi(b,i) += tmpbi(b,i)

     ENDPARDO b, i, b1, a1

     PARDO a1, b, b1, j1

             REQUEST R2_ABBB(b,a1,j1,b1) b1

             DO i
                REQUEST      Vpiqj(a1,i,b1,j1) j1
                Tmpbi(b,i) = R2_ABBB(b,a1,j1,b1)*Vpiqj(a1,i,b1,j1)
                PUT Xbi(b,i) += tmpbi(b,i)
             ENDDO i

     ENDPARDO a1, b, b1, j1

     PARDO a1, b, a2, i1

           REQUEST R2_ABAA(a1,b,i1,a2) a2

            DO i
               REQUEST       VSpipi(a1,i,a2,i1) i1
               tmpbi(b,i) =  R2_ABAA(a1,b,i1,a2)*VSpipi(a1,i,a2,i1)
               tmpbi(b,i) *=  0.5
               PUT Xbi(b,i) += tmpbi(b,i)
            ENDDO i
     ENDPARDO a1, b, a2, i1

     execute sip_barrier 

    ENDPROC THREE_BODY_INTMD
#   ------------------------

    PROC AOLADDER_R1_AB
#   -------------------
#
#    Form Half back transformed cluster arrays
#    -----------------------------------------
#
     PARDO b, lambda

         Zab(lambda,b) = 0.0
#
             do a
#
             get             R1_AB(a,b)
#
             Txb(lambda,b) = R1_AB(a,b)*ca(lambda,a)
             Zab(lambda,b) += Txb(lambda,b)
#
             enddo a
#
          PUT T1AO_ab(lambda,b) = Zab(lambda,b)
#
     ENDPARDO b, lambda
#
     execute sip_barrier
#
     PARDO lambda, sigma
#
       ZZab(lambda,sigma)  = 0.0

       PUT T2AO_ab(lambda,sigma) = ZZab(lambda,sigma)
#
           DO b
              get                 T1AO_ab(lambda,b)
              T1xx(lambda,sigma) = T1AO_ab(lambda,b)*ca(sigma,b)
              ZZab(lambda,sigma) += T1xx(lambda,sigma)
           ENDDO b
#
       PUT TAO_ab(lambda,sigma) = ZZab(lambda,sigma)
#
     ENDPARDO lambda, sigma

     execute sip_barrier
#
#     Contract AOINT with half back transformed Amplitudes
#    ----------------------------------------------------
#
     PARDO mu, nu, lambda, sigma
#
           compute_integrals           aoint(lambda,mu,sigma,nu)
           txxxx(lambda,mu,sigma,nu) = aoint(lambda,mu,sigma,nu)
#
           get                       TAO_ab(lambda,sigma)
           Yab(mu,nu)              = txxxx(lambda,mu,sigma,nu)*TAO_ab(lambda,sigma)
           put T2AO_ab(mu,nu) += Yab(mu,nu)
#
     ENDPARDO mu, nu, lambda, sigma
#
     execute sip_barrier
#
#    Perform final transformation
#    ----------------------------

     PARDO a, nu
#
       Tax(a,nu) = 0.0
#
          do mu
#
              get T2AO_ab(mu,nu)
              T1ax(a,nu) = T2AO_ab(mu,nu)*ca(mu,a)
              Tax(a,nu)+=T1ax(a,nu)
#
          enddo mu
#
       put tttax(a,nu) = Tax(a,nu)
#
     ENDPARDO a, nu
#
     execute sip_barrier
#
     PARDO a, b, mu
#
              get tttax(a,mu)
              tab(a,b)=tttax(a,mu)*ca(mu,b)
              put AOHR1_AB(a,b)+=tab(a,b)
     ENDPARDO a, b, mu
#
     execute sip_barrier

     Pardo a, b
         Get AOHR1_AB(a,b) 
         Tab(a,b)  = AOHR1_AB(a,b)
         Tab(a,b) *= 0.5
         Put HR1_AB(a,b) += Tab(a,b)

         Get AOHR1_AB(b,a) 
         Tab(b,a)  = AOHR1_AB(b,a)
         T1ab(a,b) = Tab(b,a)
         T1ab(a,b) *= 0.5
         Put HR1_AB(a,b) += T1ab(a,b) 

     Endpardo a, b

     execute sip_barrier

    ENDPROC AOLADDER_R1_AB
#   ----------------------

    PROC AOLADDER_R2_ABAA
#   ---------------------

#    Form Half back transformed cluster arrays: Compute S(Ef,KC)*V(Ab,Ef)
#    ----------------------------------------
#
# DO S(E,f,K,C) -> S(lambda,sigma,K,C)
# First  S(lambda,sigma,A,A)
#
#
     PARDO b, lambda, i, a1
#
         Zxbia(lambda,b,i,a1) = 0.0
#
             do a
#
             REQUEST                R2_ABAA(a,b,i,a1) a1
             Txbia(lambda,b,i,a1) = R2_ABAA(a,b,i,a1)*ca(lambda,a)
             Zxbia(lambda,b,i,a1) += Txbia(lambda,b,i,a1)

             enddo a
#
          PREPARE T2AO_xbia(lambda,b,i,a1)= Zxbia(lambda,b,i,a1)
#
     ENDPARDO b, lambda, i, a1

     PARDO a, lambda, i, a1
#
         Zaxia(a,lambda,i,a1) = 0.0
#
             do b
#
             REQUEST                R2_ABAA(a,b,i,a1) a1
             Taxia(a,lambda,i,a1) = R2_ABAA(a,b,i,a1)*ca(lambda,b)
             Zaxia(a,lambda,i,a1) += Taxia(a,lambda,i,a1)

             enddo b
#
          PREPARE T2AO_axia(a,lambda,i,a1)= Zaxia(a,lambda,i,a1)
#
     ENDPARDO a, lambda, i, a1

     PARDO b, lambda, i, a
#
         Zabix(a,b,i,lambda) = 0.0

#
             do a1
#
             REQUEST               R2_ABAA(a,b,i,a1) a1
             Tabix(a,b,i,lambda) = R2_ABAA(a,b,i,a1)*ca(lambda,a1)
             Zabix(a,b,i,lambda) += Tabix(a,b,i,lambda)

             enddo a1
#
          PREPARE T2AO_abix(a,b,i,lambda) = Zabix(a,b,i,lambda)
#
     ENDPARDO b, lambda, i, a

     execute server_barrier
#
     PARDO lambda, sigma, i, a1
#
       ZZxxia(lambda,sigma,i,a1) = 0.0
#
           DO b

              REQUEST                      T2AO_xbia(lambda,b,i,a1) a1
              Txxia(lambda,sigma,i,a1)   = T2AO_xbia(lambda,b,i,a1)*ca(sigma,b)
              ZZxxia(lambda,sigma,i,a1) += Txxia(lambda,sigma,i,a1)

           ENDDO b

       PREPARE T2IAO_xxia(lambda,sigma,i,a1) = ZZxxia(lambda,sigma,i,a1)
#
     ENDPARDO lambda, sigma, i, a1


     PARDO lambda, sigma, i, a
#
       ZZaxix(a,sigma,i,lambda) = 0.0
#
           DO b

              REQUEST                     T2AO_abix(a,b,i,lambda) lambda
              Taxix(a,sigma,i,lambda)  =  T2AO_abix(a,b,i,lambda)*ca(sigma,b)
              ZZaxix(a,sigma,i,lambda) += Taxix(a,sigma,i,lambda)

           ENDDO b

       PREPARE T2IAO_axix(a,sigma,i,lambda) = ZZaxix(a,sigma,i,lambda)
#
     ENDPARDO lambda, sigma, i, a

#
# Now S(lambda,sigma,A,B)
#
     PARDO lambda, sigma, i, b
#
       ZZxbix(lambda,b,i,sigma) = 0.0
#
           DO a

              REQUEST                     T2AO_xbia(lambda,b,i,a) a
              Txbix(lambda,b,i,sigma)   = T2AO_xbia(lambda,b,i,a)*Ca(sigma,a)
              ZZxbix(lambda,b,i,sigma) += Txbix(lambda,b,i,sigma)

              REQUEST                     T2AO_abix(a,b,i,sigma) sigma
              Txbix(lambda,b,i,sigma)   = T2AO_abix(a,b,i,sigma)*Ca(lambda,a)
              ZZxbix(lambda,b,i,sigma) += Txbix(lambda,b,i,sigma) 

           ENDDO a
#
       PREPARE T2IAO_xbix(lambda,b,i,sigma) = ZZxbix(lambda,b,i,sigma)

     ENDPARDO lambda, sigma, i, b
#
     execute server_barrier

# Contract AOINT with half back transformed Amplitudes
# Form S(lamda,sigma,i,a)W(mu,nu,lambda,sigma) = Taa(mu,nu)
# Form S(lamda,sigma,i,b)W(mu,nu,lambda,sigma) = Tab(mu,nu)
#    ----------------------------------------------------
#
     PARDO mu, nu, lambda, sigma
#
           compute_integrals            aoint(lambda,mu,sigma,nu)
           Ixxxx(lambda,mu,sigma,nu)   = aoint(lambda,mu,sigma,nu)
           I1xxxx(lambda,sigma,mu,nu)  = Ixxxx(lambda,mu,sigma,nu)
#
           DO i
              DO a1
                 REQUEST                         T2IAO_xxia(lambda,sigma,i,a1) a1
                 T1xxia(mu,nu,i,a1)            = T2IAO_xxia(lambda,sigma,i,a1)*I1xxxx(lambda,sigma,mu,nu)
                 Z1xxia(mu,nu,i,a1)            = T1xxia(mu,nu,i,a1)
                 PREPARE T2AO_xxia(mu,nu,i,a1) += Z1xxia(mu,nu,i,a1)
              ENDDO a1
           ENDDO i

           DO i
              DO a
                 REQUEST                        T2IAO_axix(a,lambda,i,sigma) sigma
                 T1axix(a,mu,i,nu)            = T2IAO_axix(a,lambda,i,sigma)*I1xxxx(lambda,sigma,mu,nu)
                 Z1axix(a,mu,i,nu)            = T1axix(a,mu,i,nu)
                 PREPARE T2AO_axix(a,mu,i,nu) += Z1axix(a,mu,i,nu)
              ENDDO a
           ENDDO i

           DO i
              DO b
                 REQUEST                        T2IAO_xbix(lambda,b,i,sigma) b
                 T1xbix(mu,b,i,nu)            = T2IAO_xbix(lambda,b,i,sigma)*I1xxxx(lambda,sigma,mu,nu)
                 Z1xbix(mu,b,i,nu)            = T1xbix(mu,b,i,nu)
                 PREPARE T2AO_xbix(mu,b,i,nu) += Z1xbix(mu,b,i,nu)
              ENDDO b
           ENDDO i

     ENDPARDO mu, nu, lambda, sigma
#
     execute server_barrier
#
#
# Perform final transformation: T(mu,nu,i,a) -> T(a,b,i,a) and
# T(mu,nu,i,b)  -> T(a,b,i,a)
#
     PARDO a, nu, i, a1
#
       Taxia(a,nu,i,a1) = 0.0
#
          do mu
#
              REQUEST              T2AO_xxia(mu,nu,i,a1) a1
              T1axia(a,nu,i,a1) =  T2AO_xxia(mu,nu,i,a1)*Ca(mu,a)
              Taxia(a,nu,i,a1)  += T1axia(a,nu,i,a1)
          enddo mu
#
       PREPARE tttaxia(a,nu,i,a1) = Taxia(a,nu,i,a1)
#
     ENDPARDO a, nu, i, a1

     PARDO a, mu, i, a1
#
       Taxia(a,mu,i,a1) = 0.0
#
          do nu
#
              REQUEST              T2AO_axix(a,mu,i,nu) nu
              T1axia(a,mu,i,a1) =  T2AO_axix(a,mu,i,nu)*Ca(nu,a1)
              Taxia(a,mu,i,a1)  += T1axia(a,mu,i,a1)
          enddo nu
#
       PREPARE tttaxia(a,mu,i,a1) += Taxia(a,mu,i,a1)
#
     ENDPARDO a, mu, i, a1
#
     PARDO a, nu, i, b
#
          Tabix(a,b,i,nu) = 0.0
#
          do mu
#
              REQUEST             T2AO_xbix(mu,b,i,nu) nu

              T1xbix(mu,b,i,nu) = T2AO_xbix(mu,b,i,nu)
              T1abix(a,b,i,nu)  = T1xbix(mu,b,i,nu)*Ca(mu,a)
              Tabix(a,b,i,nu)  += T1abix(a,b,i,nu)
          enddo mu
#
       PREPARE tttabix(a,b,i,nu) = Tabix(a,b,i,nu)

     ENDPARDO a, nu, i, b

     execute server_barrier
#
     PARDO a, a1, b, i

             Tabia(a,b,i,a1)  = 0.0

             DO mu

                REQUEST             Tttaxia(a,mu,i,a1) a1
                T1abia(a,b,i,a1)  = Tttaxia(a,mu,i,a1)*ca(mu,b)
                Tabia(a,b,i,a1)  += T1abia(a,b,i,a1)

             ENDDO mu

             PREPARE HR2_ABAA(a,b,i,a1) += Tabia(a,b,i,a1)
             
     ENDPARDO a, a1, b, i

     PARDO a, b, a1, i

            Tabia(a,b,i,a1) = 0.0

             DO mu
                REQUEST             tttabix(a,b,i,mu) mu
                T1abia(a,b,i,a1)  = tttabix(a,b,i,mu)*ca(mu,a1)
                Tabia(a,b,i,a1)  += T1abia(a,b,i,a1)
             ENDDO mu

             Tabia(a,b,i,a1)  *= 0.5
             PREPARE HR2_ABAA(a,b,i,a1) += Tabia(a,b,i,a1)

     ENDPARDO a, b, a1, i

     execute server_barrier
#
     ENDPROC AOLADDER_R2_ABAA
#    ------------------------
#
     PROC HBARDIR_R1
#    ---------------
#
     PARDO i, j
#
        tij(i,j)=0.0
        put Nij(i,j)=tij(i,j)
#
     ENDPARDO i, j
#
     PARDO a, j
#
        tai_ab(a,j)=0.0
        put Nai_ab(a,j)=tai_ab(a,j)
#
     ENDPARDO a, j
#
     PARDO b, i
#
        tai_ba(b,i)=0.0
        put Nai_ba(b,i)=tai_ba(b,i)
#
     ENDPARDO b, i
#
     execute sip_barrier
#
     PARDO a, b
#
        get R1_AB(a,b)
#
           do i
           do j
              request         Vpiqj(a,i,b,j) j
              tij(i,j)      = Vpiqj(a,i,b,j)*R1_AB(a,b)
              put Nij(i,j) += tij(i,j)
           enddo j
           enddo i
#
     ENDPARDO a, b
#
     PARDO i, a, b, b1
#
        request            Vbbai(b,b1,a,i) i
        get                R1_AB(a,b1)
#
        tai_ba(b,i)     =  Vbbai(b,b1,a,i)*R1_AB(a,b1)
        put Nai_ba(b,i) += tai_ba(b,i)
#
     ENDPARDO i, a, b, b1
#
     PARDO j, b, a, a1
#
        request            Vaabj(a,a1,b,j) j
        get                R1_AB(a1,b)
#
        tai_ab(a,j)      = Vaabj(a,a1,b,j)*R1_AB(a1,b)
        Put Nai_ab(a,j) +=  tai_ab(a,j)

     ENDPARDO j, b, a, a1

     execute sip_barrier

     PARDO a, b
        DO i 
           Get Nai_ba(b,i) 
           Get T1a(a,i)
            
           Tab(a,b) = Nai_ba(b,i) * T1a(a,i)
           Tab(a,b) *= -1.0
           Put AOHR1_AB(a,b) += Tab(a,b)
        ENDDO i

        DO j 
           Get Nai_ab(a,j)
           Get T1b(b,j)
     
           Tab(a,b) = Nai_ab(a,j) * T1b(b,j)
           Tab(a,b) *= -1.0
           Put AOHR1_AB(a,b) += Tab(a,b) 
        ENDDO j

        DO i
        DO j
           Get Nij(i,j)
           Request Tau_ab(a,i,b,j) j
           Taibj(a,i,b,j) = Tau_ab(a,i,b,j)

            Tab(a,b)  = Tau_ab(a,i,b,j) * Nij(i,j)
            Put AOHR1_AB(a,b) += Tab(a,b) 
        ENDDO j
        ENDDO i
             
     ENDPARDO a, b
     execute sip_barrier
#
     ENDPROC HBARDIR_R1
#    -----------------

     PROC HBARDIR_R2
#     -------------
# Form S(e,f,k,c)*V(am,ef) + S(e,f,k,c)V(mn,ef)
#
     PARDO i, j, i1, a
#
        tijia(i,j,i1,a)=0.0
        PREPARE Nijia(i,j,i1,a)=tijia(i,j,i1,a)
#
     ENDPARDO i, j, i1, a
#
     PARDO i, i1, i2, b
#
        tibii(i,b,i1,i2)=0.0
        PREPARE Nibii(i,b,i1,i2)=tibii(i,b,i1,i2)
#
     ENDPARDO i, i1, i2, b

     PARDO a, i, j, i1
#
        tajii(a,j,i,i1) = 0.0
        PREPARE Najii(a,j,i,i1) = tajii(a,j,i,i1)
#
     ENDPARDO a, i, j, i1
#
     PARDO a, j, i, a1
#
        tai_abia(a,j,i,a1)=0.0
        PREPARE Nai_abia1(a,j,i,a1)=tai_abia(a,j,i,a1)
        PREPARE Nai_abia2(a,j,i,a1)=tai_abia(a,j,i,a1)
#
     ENDPARDO a, j, i, a1
#
     PARDO a, b, i, i1
#
        tai_abii(a,b,i,i1)=0.0
        PREPARE Nai_abii1(a,b,i,i1)=tai_abii(a,b,i,i1)
        PREPARE Nai_abii2(a,b,i,i1)=tai_abii(a,b,i,i1)
#
     ENDPARDO a, b, i, i1

     PARDO b, i, i1, a
#
        tai_ibia(i,b,i1,a)=0.0
        PREPARE Nai_ibia1(i,b,i1,a)=tai_ibia(i,b,i1,a)
        PREPARE Nai_ibia2(i,b,i1,a)=tai_ibia(i,b,i1,a)
#
     ENDPARDO b, i, i1, a
     execute server_barrier
#
# AA(1): S(a1,b,i,a2)*V(a2,a1,i1,i2)
#
     PARDO a1, b, i, a2
#
        REQUEST R2_ABAA(a1,b,i,a2) a2
#
           do i1
           do i2
              REQUEST                      VSpipi(a1,i1,a2,i2) i2
              tmpaaii(a1,a2,i1,i2)       = VSpipi(a1,i1,a2,i2)
              tibii(i1,b,i,i2)           = tmpaaii(a1,a2,i1,i2) * R2_ABAA(a1,b,i,a2)
              PREPARE Nibii(i1,b,i,i2)   += tibii(i1,b,i,i2)
           enddo i2
           enddo i1
#
     ENDPARDO a1, b, i, a2

#
# AB(2): S(a,b,i1,a)*V(a,b,i,j)
#
     PARDO a, b, i1, a1
#
        REQUEST R2_ABAA(a,b,i1,a1) a1
#
           do i
           do j
              REQUEST                      Vpiqj(a,i,b,j) j
              tmpabij(a,b,i,j)           = Vpiqj(a,i,b,j)
              tijia(i,j,i1,a1)           = tmpabij(a,b,i,j)*R2_ABAA(a,b,i1,a1)
              PREPARE Nijia(i,j,i1,a1)  += tijia(i,j,i1,a1)
           enddo j
           enddo i
#
     ENDPARDO a, b, i1, a1
#
# AB(3) S(a,b1,i,a1)*V(a1,i1,b1,j);

     PARDO i1, a1, b1, j
#
        REQUEST Vpiqj(a1,i1,b1,j) j
        tmpabij(a1,b1,i1,j)      = Vpiqj(a1,i1,b1,j)

        DO i
        DO a
           REQUEST                    R2_ABAA(a,b1,i,a1) a1
           tmpabia(a1,b1,i,a)       = R2_ABAA(a,b1,i,a1)
           tmpijia(i1,j,i,a)        = tmpabij(a1,b1,i1,j)*tmpabia(a1,b1,i,a)
           tajii(a,j,i,i1)          = tmpijia(i1,j,i,a)
           PREPARE Najii(a,j,i,i1) += tajii(a,j,i,i1)
        ENDDO a
        ENDDO i

     ENDPARDO i1, a1, b1, j
#
# AB(1) S(a2,b,i,a1)V(a2,b,a,j)
#
     PARDO j, b, a, a2
#
        request Vaabj(a2,a,b,j) j
        tmpabaj(a2,b,a,j)           = Vaabj(a2,a,b,j)

        DO i
        DO a1
           REQUEST                        R2_ABAA(a2,b,i,a1) a1
           tmpiaaj(i,a1,a,j)            = R2_ABAA(a2,b,i,a1)*tmpabaj(a2,b,a,j)
           tai_abia(a,j,i,a1)           = tmpiaaj(i,a1,a,j)
           PREPARE Nai_abia1(a,j,i,a1) += tai_abia(a,j,i,a1)
        ENDDO a1
        ENDDO i
#
     ENDPARDO j, b, a, a2
#
#AB(2) S(a,b,i,a2)V(a2,a1,b,j)

     PARDO j, b, a1, a2
#
        request Vaabj(a2,a1,b,j) j
        tmpabaj(a2,b,a1,j)           = Vaabj(a2,a1,b,j)

        DO i
        DO a
           REQUEST                        R2_ABAA(a,b,i,a2) a2
           tmpabia(a2,b,i,a)            = R2_ABAA(a,b,i,a2)
           tmpiaaj(i,a,a1,j)            = tmpabia(a2,b,i,a)*tmpabaj(a2,b,a1,j)
           tai_abia(a,j,i,a1)           = tmpiaaj(i,a,a1,j)
           PREPARE Nai_abia2(a,j,i,a1) += tai_abia(a,j,i,a1)
        ENDDO a
        ENDDO i
#
     ENDPARDO j, b, a1, a2
#
# AB(3) S(a,b1,i,a1)V(b1,b,a1,i)
#
     PARDO b1, b, a1, i1
#
        REQUEST Vbbai(b1,b,a1,i1) i1

        DO i
        DO a
           REQUEST                         R2_ABAA(a,b1,i,a1) a1
           tai_abii(a,b,i,i1)            = R2_ABAA(a,b1,i,a1)*Vbbai(b1,b,a1,i1)
           PREPARE Nai_abii1(a,b,i,i1)  += tai_abii(a,b,i,i1)
        ENDDO a
        ENDDO i
#
     ENDPARDO b1, b, a1, i1
#
# AA(4) S(a1,b,i,a2)V(a1,a,a2,i1)
#
     PARDO a1, a2, a, i1

        REQUEST VSaaai(a1,a,a2,i1) i1
        tmpaaai(a1,a2,a,i1)           = VSaaai(a1,a,a2,i1)
        DO i
        Do b
           REQUEST                         R2_ABAA(a1,b,i,a2) a2
           tmpbiaa(b,i,a1,a2)            = R2_ABAA(a1,b,i,a2)
           tmpbiai(b,i,a,i1)             = tmpbiaa(b,i,a1,a2)*tmpaaai(a1,a2,a,i1)
           tai_abii(a,b,i,i1)            = tmpbiai(b,i,a,i1)
           PREPARE Nai_abii2(a,b,i,i1)  += tai_abii(a,b,i,i1)
        ENDDO b
        ENDDO i

     ENDPARDO a1, a2, a, i1
#
# AB(5) S(a2,b1,i,a1)V(a2,b1,i1,b)
#
     PARDO b1, b, a2, i1

        REQUEST Vbbai(b1,b,a2,i1) i1

        DO i
        DO a1
           REQUEST                          R2_ABAA(a2,b1,i,a1) a1
           tmpabib(a2,b1,i1,b)            = Vbbai(b1,b,a2,i1)
           tai_ibia(i1,b,i,a1)            = R2_ABAA(a2,b1,i,a1)*tmpabib(a2,b1,i1,b)
           PREPARE Nai_ibia1(i1,b,i,a1)  += tai_ibia(i1,b,i,a1)
        ENDDO a1
        ENDDO i

     ENDPARDO b1, b, a2, i1
#
# AA(6) S(a1,b,i,a2)V(a1,a2,i1,a)
#
     PARDO a1, a, a2, i1

        REQUEST VSaaai(a1,a,a2,i1) i1

        DO i
        DO b
           REQUEST                         R2_ABAA(a1,b,i,a2) a2
           tmpaaia(a2,a1,i1,a)           = VSaaai(a1,a,a2,i1)
           tai_ibia(i1,b,i,a)            = R2_ABAA(a1,b,i,a2)*tmpaaia(a2,a1,i1,a)
           PREPARE Nai_ibia2(i1,b,i,a)  += tai_ibia(i1,b,i,a)
        ENDDO b
        ENDDO i

     ENDPARDO  a1, a, a2, i1

     Execute server_barrier 

     PARDO a, b, a1, i
        T2abia(a1,b,i,a) = 0.0
        DO i1
        DO j
           REQUEST Nijia(i1,j,i,a) a
           REQUEST Tau_ab(a1,i1,b,j) j
           Tijia(i1,j,i,a) = Nijia(i1,j,i,a)
           Taibj(a1,i1,b,j)= Tau_ab(a1,i1,b,j)

           T1abia(a1,b,i,a) = Taibj(a1,i1,b,j) * Tijia(i1,j,i,a)
           PREPARE HR2_ABAA(a1,b,i,a) += T1abia(a1,b,i,a)
           T2abia(a1,b,i,a) += T1abia(a1,b,i,a)
        ENDDO j
        ENDDO i1
#
## The first factor (0.5) looks OK. But I am not 100% sure why 0.25. However,
## 0.25 (instead of 0.5) is needed to match with HBAR_ABCD route.
#
        DO i1
        DO i2
           REQUEST Nibii(i1,b,i,i2) i2
           REQUEST Nibii(i2,b,i,i1) i1
           REQUEST Tau_aa(a1,i1,a,i2) i2

           Tibii(i1,b,i,i2)  = Nibii(i1,b,i,i2)
           T1ibii(i1,b,i,i2) = Nibii(i2,b,i,i1)
           Tibii(i1,b,i,i2) -= T1ibii(i1,b,i,i2)
           Tibii(i1,b,i,i2) *= 0.5

           Taiai(a1,i1,a,i2) = Tau_aa(a1,i1,a,i2)

           T1abia(a1,b,i,a)  = Taiai(a1,i1,a,i2) *  Tibii(i1,b,i,i2) 
           T1abia(a1,b,i,a) *= 0.25

           PREPARE HR2_ABAA(a1,b,i,a) += T1abia(a1,b,i,a)
        ENDDO i2
        ENDDO i1

        DO i1
        DO j
           REQUEST Najii(a1,j,i,i1) i
           REQUEST Tau_ab(a,i1,b,j) j
           Tajii(a1,j,i,i1) = Najii(a1,j,i,i1)
           Taibj(a,i1,b,j)  = Tau_ab(a,i1,b,j)

           T1abia(a1,b,i,a)  = Tajii(a1,j,i,i1) *  Taibj(a,i1,b,j)
           PREPARE HR2_ABAA(a1,b,i,a) += T1abia(a1,b,i,a)
        ENDDO j
        ENDDO i1

        DO j
           GET T1b(b,j)
           REQUEST Nai_abia1(a1,j,i,a) a

           Tai_abia(a1,j,i,a) = Nai_abia1(a1,j,i,a)
           Tbj(b,j)           = T1b(b,j)
           T1abia(a1,b,i,a)   = Tbj(b,j) *  Tai_abia(a1,j,i,a)
           T1abia(a1,b,i,a)  *= -1.0
           PREPARE HR2_ABAA(a1,b,i,a) += T1abia(a1,b,i,a)

           REQUEST Nai_abia2(a1,j,i,a) a
           Tai_abia(a1,j,i,a) = Nai_abia2(a1,j,i,a)
           T1abia(a1,b,i,a)   = Tbj(b,j) *  Tai_abia(a1,j,i,a)
           T1abia(a1,b,i,a)  *= -1.0
           PREPARE HR2_ABAA(a1,b,i,a) += T1abia(a1,b,i,a)

        ENDDO j

        DO i1
           GET T1a(a1,i1)
           GET T1a(a,i1)
           REQUEST Nai_abii1(a,b,i,i1) i1

           Tai_abii(a,b,i,i1) =  Nai_abii1(a,b,i,i1)
           Tai(a1,i1)         =  T1a(a1,i1)
           T1ai(a,i1)         =  T1a(a,i1)

           T1abia(a,b,i,a1)  = Tai(a1,i1) * Tai_abii(a,b,i,i1)
           T1abia(a,b,i,a1) *= -1.0
           PREPARE HR2_ABAA(a,b,i,a1) += T1abia(a,b,i,a1)

           REQUEST Nai_abii2(a,b,i,i1) i1
           Tai_abii(a,b,i,i1) = Nai_abii2(a,b,i,i1)
           T1abia(a,b,i,a1)   = Tai(a1,i1) * Tai_abii(a,b,i,i1)
           T1abia(a,b,i,a1)  *= -0.5
           PREPARE HR2_ABAA(a,b,i,a1) += T1abia(a,b,i,a1)
        
           REQUEST Nai_ibia1(i1,b,i,a1) a1
           Tai_ibia(i1,b,i,a1) = Nai_ibia1(i1,b,i,a1)
           T1abia(a,b,i,a1)    = T1ai(a,i1) * Tai_ibia(i1,b,i,a1)
           T1abia(a,b,i,a1)   *= -1.0
           PREPARE HR2_ABAA(a,b,i,a1) += T1abia(a,b,i,a1)

           REQUEST  Nai_ibia2(i1,b,i,a1) a1
           Tai_ibia(i1,b,i,a1) = Nai_ibia2(i1,b,i,a1)
           T1abia(a,b,i,a1)    = T1ai(a,i1) * Tai_ibia(i1,b,i,a1)
           T1abia(a,b,i,a1)   *= 0.5
           PREPARE HR2_ABAA(a,b,i,a1) +=  T1abia(a,b,i,a1)
        ENDDO i1
           
     ENDPARDO a, b, a1, i

     EXECUTE SERVER_BARRIER 

     ENDPROC HBARDIR_R2
#    ------------------
      PROC FORM_R1AB
#     --------------

# 1/2 r^{ef} Hbar^{ab}_{ef}

      IF NO_AO_LADDER == ONE 

      PARDO a, b, a1, b1
            REQUEST          HBAR_aabb(a,a1,b,b1) a
            GET              R1_AB(a1,b1)
            tab(a,b)       = HBAR_aabb(a,a1,b,b1)*R1_AB(a1,b1)
            tab(a,b)      *= 0.5
            PUT HR1_AB(a,b) += tab(a,b)
      ENDPARDO a, b, a1, b1

      PARDO a, b, a1, b1
            REQUEST          HBAR_aabb(b,b1,a,a1) a
            GET              R1_AB(b1,a1)
            tab(a,b)       = HBAR_aabb(b,b1,a,a1)*R1_AB(b1,a1)
            tab(a,b)      *= 0.5
            PUT HR1_AB(a,b) += tab(a,b)
      ENDPARDO a, b, a1, b1

      ENDIF 

      PARDO a, b, b1

            GET                   R1_AB(a,b1)
            GET                   HBAR_bb(b,b1)
            tab(a,b)            = R1_AB(a,b1)*HBAR_bb(b,b1)
            PUT HR1_AB(a,b) += tab(a,b)

      ENDPARDO a, b, b1

      PARDO a, b, a1

            GET              R1_AB(a1,b)
            GET              HBAR_aa(a,a1)
            tab(a,b)       = R1_AB(a1,b)*HBAR_aa(a,a1)
            PUT HR1_AB(a,b) += tab(a,b)

      ENDPARDO a, b, a1
#
      PARDO a, b1, a1, i1

            REQUEST             R2_ABAA(a,b1,i1,a1) a1

            DO b
               REQUEST          HBAR_AIBC_bbaa(b,b1,i1,a1) i1
               tab(a,b)       = R2_ABAA(a,b1,i1,a1)*HBAR_AIBC_bbaa(b,b1,i1,a1)
               PUT HR1_AB(a,b) += tab(a,b)
           ENDDO b

    ENDPARDO a, b1, a1, i1

    PARDO b1, a, b2, j1

            REQUEST             R2_ABBB(b1,a,j1,b2) b2

            DO b
               REQUEST          HBAR_AIBC_bbbb(b,b1,j1,b2) j1
               tab(a,b)       = R2_ABBB(b1,a,j1,b2)*HBAR_AIBC_bbbb(b,b1,j1,b2)
               tab(a,b)      *= 0.5
               PUT HR1_AB(a,b) += tab(a,b)
            ENDDO b

     ENDPARDO  b1, a, b2, j1


     PARDO b, a1, a2, i1

            REQUEST             R2_ABAA(a1,b,i1,a2) a2

            DO a
               REQUEST          HBAR_AIBC_aaaa(a,a1,i1,a2) i1
               tab(a,b)       = R2_ABAA(a1,b,i1,a2)*HBAR_AIBC_aaaa(a,a1,i1,a2)
               tab(a,b)      *= 0.5
               PUT HR1_AB(a,b) += tab(a,b)
            ENDDO a

     ENDPARDO  b, a1, a2 i1

     PARDO a1, b, b1, j1

            REQUEST             R2_ABBB(b,a1,j1,b1) b1

            DO a
               REQUesT          HBAR_AIBC_aabb(a,a1,j1,b1) j1
               tab(a,b)       = R2_ABBB(b,a1,j1,b1)*HBAR_AIBC_aabb(a,a1,j1,b1)
               PUT HR1_AB(a,b) += tab(a,b)
            ENDDO a

     ENDPARDO a1, b, b1, j1

     PARDO a, b, i1, a1

            REQUEST          R2_ABAA(a,b,i1,a1) a1
            GET              HBAR_ia(i1,a1)
            tab(a,b)       = R2_ABAA(a,b,i1,a1)*HBAR_ia(i1,a1)
            PUT HR1_AB(a,b) += tab(a,b)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

            REQUEST          R2_ABBB(b,a,j1,b1) b1
            GET              HBAR_jb(j1, b1)
            tab(a,b)       = R2_ABBB(b,a,j1,b1)*HBAR_jb(j1, b1)
            PUT HR1_AB(a,b) += tab(a,b)

     ENDPARDO a, b, j1, b1

     execute sip_barrier 
     
     ENDPROC FORM_R1AB
#    -----------------

     PROC FORM_R2AB
#    --------------

#
# P(a/bc) S(a,e)*Hbar(bc,ei)
#
      PARDO b, a1, b1, i
            REQUEST  HBAR_ABCI_bbaa(b,b1,a1,i) i

            DO a
               GET                          R1_AB(a,b1)
               t1abia(a,b,i,a1)           = R1_AB(a,b1)*HBAR_ABCI_bbaa(b,b1,a1,i)
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a

      ENDPARDO b, a1, b1, i

      PARDO b, a, b1, i
            REQUEST HBAR_ABCI_bbaa(b,b1,a,i) i

            DO a1
               GET                          R1_AB(a1,b1)
               t1abia(a,b,i,a1)           = R1_AB(a1,b1)*HBAR_ABCI_bbaa(b,b1,a,i)
               t1abia(a,b,i,a1)          *= -1.0
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a1
      ENDPARDO b, a, b1, i
#
      PARDO a, a1, a2, i
            REQUEST HBAR_ABCI_aaaa(a,a2,a1,i) i

            DO b
               GET                          R1_AB(a2,b)
               t1abia(a,b,i,a1)           = R1_AB(a2,b)*HBAR_ABCI_aaaa(a,a2,a1,i)
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
             ENDDO b

      ENDPARDO a, a1, a2, i
#
# To debug ladder term, use precomputed Hbar(ef,ab).
#
# P(a/b,c)  S(e,f,i,c)*Hbar(ef,ab)
#
     IF NO_AO_LADDER == ONE 

     PARDO a2, b1, a, b
           REQUEST                            Hbar_aabb(a,a2,b,b1) b1

           DO i
              DO a1
                 REQUEST                      R2_ABAA(a2,b1,i,a1) a1
                 t1abia(a,b,i,a1)           = Hbar_aabb(a,a2,b,b1)*R2_ABAA(a2,b1,i,a1)
                 PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
               ENDDO a1
           ENDDO i

    ENDPARDO a2, b1, a, b
#
    PARDO a1, a2, a3, a

           REQUEST              Hbar_aabb(a,a2,a1,a3) a1
           REQUEST              Hbar_aabb(a,a3,a1,a2) a1
           tpppp(a2,a3,a,a1)  = Hbar_aabb(a,a2,a1,a3)
           t1pppp(a2,a3,a,a1) = Hbar_aabb(a,a3,a1,a2)
           tpppp(a2,a3,a,a1) -= t1pppp(a2,a3,a,a1)
           tpppp(a2,a3,a,a1) *= 0.5

           DO i
              DO b
                 REQUEST                      R2_ABAA(a2,b,i,a3) a3
                 tmpaabi(a2,a3,b,i)         = R2_ABAA(a2,b,i,a3)
                 t1abia(a,b,i,a1)           = tpppp(a2,a3,a,a1)*tmpaabi(a2,a3,b,i)
                  PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
               ENDDO b
           eNDDO i

    ENDPARDO a1, a2, a3, a
#
    PARDO a2, b1, a1, b
           REQUEST                            Hbar_aabb(a1,a2,b,b1) b1

           DO i
              DO a
                 REQUEST                      R2_ABAA(a,b1,i,a2) a2
                 t1abia(a,b,i,a1)           = Hbar_aabb(a1,a2,b,b1)*R2_ABAA(a,b1,i,a2)
                 PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
               ENDDO a
           ENDDO i

    ENDPARDO a2, b1, a1, b

    ENDIF 
#
# P(a/bc) S(e,b,c,i)*Hbar(e,a)
#
     PARDO a, b, a2, i
           REQUEST R2_ABAA(a,b,i,a2) a

           DO a1
              GET                          HBAR_aa(a1,a2)
              t1abia(a,b,i,a1)           = R2_ABAA(a,b,i,a2)*HBAR_aa(a1,a2)
              PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
           ENDDO a1

     ENDPARDO a, b, a2, i

     PARDO a2, b, a1, i
           REQUEST                         R2_ABAA(a2,b,i,a1) a1

           DO a
              GET                          HBAR_AA(a,a2)
              t1abia(a,b,i,a1)           = R2_ABAA(a2,b,i,a1)*HBAR_AA(a,a2)
              PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
           ENDDO a

     ENDPARDO a2, b, a1, i

     PARDO a, b1, a1, i
           REQUEST                         R2_ABAA(a,b1,i,a1) a1

           DO b
              GET                          HBAR_BB(b,b1)
              t1abia(a,b,i,a1)           = R2_ABAA(a,b1,i,a1)*HBAR_BB(b,b1)
              PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
           ENDDO b
     ENDPARDO a, b1, a1, i

#
# S(a,b,m,c)*Hbar(m,i)
#
     PARDO a, b, i1, a1
           REQUEST               R2_ABAA(a,b,i1,a1) a1

           DO i
              GET                 HBAR_II(i1,i)
              t1abia(a,b,i,a1) =  R2_ABAA(a,b,i1,a1)*HBAR_II(i1,i)
              t1abia(a,b,i,a1) *= -1.0
              PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
           ENDDO i

     ENDPARDO a, b, i1, a1
#
#
# P(a/b;b/c) S(a,e,m,c)*Hbar(bm,ei)
#
# All 5 terms sign is changed from - to + account for Hbar.
#
     PARDO a, b, a2, i1
           REQUEST                 R2_ABAA(a,b,i1,a2) a2

           DO a1
              DO i
                 REQUEST            HBAR_AJIB_aaaa(i1,a2,a1,i) i
                 tmpabai(a,b,a1,i) = R2_ABAA(a,b,i1,a2)*HBAR_AJIB_aaaa(i1,a2,a1,i)
                 t1abia(a,b,i,a1)  = tmpabai(a,b,a1,i)
                 PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
               ENDDO i
           ENDDO a1
     ENDPARDO a, b, a2, i1
#
     PARDO a1, b, a2, i1
           REQUEST                 R2_ABAA(a1,b,i1,a2) a2

           DO a
              DO i
                 REQUEST            HBAR_AJIB_aaaa(i1,a2,a,i) i
                 tmpabai(a1,b,a,i) = R2_ABAA(a1,b,i1,a2)*HBAR_AJIB_aaaa(i1,a2,a,i)
                 t1abia(a,b,i,a1)  = tmpabai(a1,b,a,i)
                 t1abia(a,b,i,a1) *= -1.0
                 PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
               ENDDO i
           ENDDO a
     ENDPARDO a1, b, a2, i1
     PARDO a, b, j1, b1
           REQUEST                R2_ABBB(b,a,j1,b1) b1

           DO a1
              DO i
                  REQUEST             HBAR_AJIB_bbaa(j1,b1,a1,i) i
                  tmpabai(a,b,a1,i) = R2_ABBB(b,a,j1,b1)*HBAR_AJIB_bbaa(j1,b1,a1,i)
                  t1abia(a,b,i,a1)  = tmpabai(a,b,a1,i)
                  PREPARE  HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
              ENDDO i
           ENDDO a1

     ENDPARDO a, b, j1, b1

     PARDO a1, b, j1, b1
           REQUEST                R2_ABBB(b,a1,j1,b1) b1

           DO a
              DO i
                  REQUEST             HBAR_AJIB_bbaa(j1,b1,a,i) i
                  tmpabai(a,b,a1,i) = R2_ABBB(b,a1,j1,b1)*HBAR_AJIB_bbaa(j1,b1,a,i)
                  t1abia(a,b,i,a1)  = tmpabai(a,b,a1,i)
                  t1abia(a,b,i,a1) *= -1.0
                  PREPARE  HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
              ENDDO i
           ENDDO a

     ENDPARDO a1, b, j1, b1

    PARDO a, b1, a1, i1
          REQUEST R2_ABAA(a,b1,i1,a1) a
          DO b
          DO i
             REQUEST HBAR_ajib_iibb(i1,i,b,b1) b
             t1abia(a,b,i,a1) = R2_ABAA(a,b1,i1,a1)*HBAR_ajib_iibb(i1,i,b,b1)
            # note sign change due to HBAR  t1abia(a,b,i,a1)*= -1.0
             PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
          ENDDO i
          ENDDO b
    ENDPARDO a, b1, a1,i1
#
# Three body terms computed via XAJ intermediate: R(a,b,i,c) =
# Xaj(a,j)*T2(bc,ij) + Xbi(b,i1)*2(ac,i,i1)
#
      PARDO a1, b, j1, i

            REQUEST T2ab(a1,i,b,j1) j1

            DO a
               GET                          Xaj(a,j1)
               t1abia(a,b,i,a1)           = T2ab(a1,i,b,j1)*Xaj(a,j1)
               t1abia(a,b,i,a1)          *= -1.0
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a

      ENDPARDO a1, b, j1, i
#
      PARDO a, b, j1, i

            REQUEST T2ab(a,i,b,j1) j1

            DO a1
               GET                          Xaj(a1,j1)
               t1abia(a,b,i,a1)           = T2ab(a,i,b,j1)*Xaj(a1,j1)
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO a1

      ENDPARDO a, b, j1, i

      PARDO a, a1, i, i2

            REQUEST T2aa(a,i2,a1,i) i

            DO b
               GET                          Xbi(b,i2)
               t1abia(a,b,i,a1)           = T2aa(a,i2,a1,i)*Xbi(b,i2)
               t1abia(a,b,i,a1)          *= -1.0
               PREPARE HR2_ABAA(a,b,i,a1) += t1abia(a,b,i,a1)
            ENDDO b

      ENDPARDO a, a1, i, i2

     execute server_barrier 

     ENDPROC FORM_R2AB
#    -----------------

      PROC INIT_AOL_ARRAYS
#     --------------------
      PARDO mu, nu
          T1xx(mu,nu) = 0.0
          PUT T2AO_ab(mu,nu) = T1xx(mu,nu)
      ENDPARDO mu, nu

      PARDO mu, nu
          Do i 
          DO a
             Z1xxia(mu,nu,i,a) = 0.0
             Z1axix(a,mu,i,nu) = 0.0
             PREPARE T2AO_xxia(mu,nu,i,a) = Z1xxia(mu,nu,i,a) 
             PREPARE T2AO_axix(a,mu,i,nu) = Z1axix(a,mu,i,nu)
           ENDDO a

           DO b
              Z1xbix(mu,b,i,nu) = 0.0
              PREPARE T2AO_xbix(mu,b,i,nu) = Z1xbix(mu,b,i,nu) 
           ENDDO b
           ENDDO i
      ENDPARDO mu, nu
      EXECUTE SERVER_BARRIER 

      ENDPROC INIT_AOL_ARRAYS
#     --------------------
           
      PROC HR_MULT
#     ------------

# Zero out HR arrays
# ------------------
#   
      PARDO a, b1
          tab(a,b1)      = 0.0
          PUT HR1_AB(a,b1)   = tab(a,b1)
          PUT AOHR1_AB(a,b1) = tab(a,b1)
      ENDPARDO a, b1

      PARDO b, i
          tmpbi(b,i) = 0.0
          PUT Xbi(b,i) = tmpbi(b,i)
      ENDPARDO b, i

      PARDO a, j
          tmpaj(a,j) = 0.0
          PUT Xaj(a,j) = tmpaj(a,j)
      ENDPARDO a, j

      PARDO a, b, i1, a1
          tabia(a,b,i1,a1)       = 0.0
          PREPARE HR2_ABAA(a,b,i1,a1) = tabia(a,b,i1,a1)
      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1
          tabjb(a,b,j1,b1)       = 0.0
          PREPARE HR2_ABBB(a,b,j1,b1) = tabjb(a,b,j1,b1)
      ENDPARDO a, b, j1, b1

      execute server_barrier 

      CALL THREE_BODY_INTMD
      CALL FORM_R1AB
      CALL FORM_R2AB

      IF NO_AO_LADDER == ZERO
         CALL INIT_AOL_ARRAYS 
         CALL HBARDIR_R1
         CALL HBARDIR_R2 
         CALL AOLADDER_R1_AB
         CALL AOLADDER_R2_ABAA
      ENDIF 

      ENDPROC HR_MULT
#     ---------------

      PROC FORM_ABBB
#      --------------

      IF SINGLET == ONE

         PARDO a, b, j1, b1
             REQUEST HR2_ABAA(a,b,j1,b1) b1
             Tabia(a,b,j1,b1) = HR2_ABAA(a,b,j1,b1)
             PREPARE HR2_ABBB(a,b,j1,b1) = Tabia(a,b,j1,b1)
         ENDPARDO a, b, j1, b1
               
      ENDIF 

      IF TRIPLET == ONE

         PARDO a, b1

             GET HR1_AB(a,b1) 
             tab(a,b1) = HR1_AB(a,b1)

             If a < b1
                t1ab(b1,a)  = tab(a,b1)
                t1ab(b1,a) *= -1.0
                PUT HR1_AB_ASYM(a,b1) = tab(a,b1)
                PUT HR1_AB_ASYM(b1,a) = t1ab(b1,a)
             Endif

             If a == b1
                execute symm_force_ij tab 
                PUT HR1_AB_ASYM(a,b1) = tab(a,b1)
             Endif 
           
         ENDPARDO a, b1

         EXECUTE SIP_BARRIER 

         PARDO a, b1

             GET HR1_AB_ASYM(a,b1) 
             tab(a,b1) = HR1_AB_ASYM(a,b1)
             PUT HR1_AB(a,b1)  = tab(a,b1)

         ENDPARDO a, b1

         PARDO a, b, j1, b1
             REQUEST HR2_ABAA(a,b,j1,b1) b1
             Tabia(a,b,j1,b1) = HR2_ABAA(a,b,j1,b1)
             Tabia(a,b,j1,b1)*= -1.0
             PREPARE HR2_ABBB(a,b,j1,b1) = Tabia(a,b,j1,b1)
         ENDPARDO a, b, j1, b1

      ENDIF
      EXECUTE SERVER_BARRIER 

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,b1
#            get hr1_ab(a,b1)
#            tmp = hr1_ab(a,b1) * hr1_ab(a,b1)
#            tmpa+= tmp
#      endpardo a,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,i1,a1
#            request hr2_abaa(a,b,i1,a1) a1
#            tmp = hr2_abaa(a,b,i1,a1) * hr2_abaa(a,b,i1,a1)
#            tmpa+= tmp
#      endpardo a,b,i1,a1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo a,b,j1,b1
#            request hr2_abbb(a,b,j1,b1) b1
#            tmp = hr2_abbb(a,b,j1,b1) * hr2_abbb(a,b,j1,b1)
#            tmpa+= tmp
#      endpardo a,b,j1,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
              
      ENDPROC FORM_ABBB
#     -----------------

      PROC sAVE_C_VECTORS 
#     ------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0
         
         IF NCOUNT == ITER_COUNT

            PARDO a, b1
                  GET R1_AB(a,b1) 
                  Tab(a,b1) = R1_AB(a,b1)
                  PUT R1_AB_HIST(a,b1,NINDEX50) = Tab(a,b1)
            ENDPARDO a, b1

            PARDO a, b, i1, a1

                REQUEST R2_ABAA(a,b,i1,a1) a1
                Tabia(a,b,i1,a1) =  R2_ABAA(a,b,i1,a1)
                PREPARE R2_ABAA_HIST(a,b,i1,a1,NINDEX50) = Tabia(a,b,i1,a1)

            ENDPARDO a, b, i1, a1

            PARDO a, b, j1, b1

                REQUEST R2_ABBB(a,b,j1,b1) b1
                Tabjb(a,b,j1,b1) = R2_ABBB(a,b,j1,b1)
                PREPARE R2_ABBB_HIST(a,b,j1,b1,NINDEX50) =  Tabjb(a,b,j1,b1)

            ENDPARDO a, b, j1, b1

         ENDIF 

      ENDDO NINDEX50 

      EXECUTE SERVER_BARRIER 

      ENDPROC SAVE_C_VECTORS 
#     ---------------------

      PROC SAVE_HC_VECTORS
#     --------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            PARDO a, b1
                  GET HR1_AB(a,b1)
                  Tab(a,b1) = HR1_AB(a,b1)
                  PUT HR1_AB_HIST(a,b1,NINDEX50) = Tab(a,b1)
            ENDPARDO a, b1

            PARDO a, b, i1, a1

                REQUEST HR2_ABAA(a,b,i1,a1) a1
                Tabia(a,b,i1,a1) =  HR2_ABAA(a,b,i1,a1)
                PREPARE HR2_ABAA_HIST(a,b,i1,a1,NINDEX50) = Tabia(a,b,i1,a1)

            ENDPARDO a, b, i1, a1

            PARDO a, b, j1, b1

                REQUEST HR2_ABBB(a,b,j1,b1) b1
                Tabjb(a,b,j1,b1) = HR2_ABBB(a,b,j1,b1)
                PREPARE HR2_ABBB_HIST(a,b,j1,b1,NINDEX50) =  Tabjb(a,b,j1,b1)

            ENDPARDO a, b, j1, b1

         ENDIF

      ENDDO NINDEX50

      EXECUTE SERVER_BARRIER

     ENDPROC SAVE_HC_VECTORS
#    -----------------------

     PROC FORM_A_MATRIX_11
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

     IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50 
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50 
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT 

                    PARDO a, b1

                          GET HR1_AB_HIST(a,b1,NINDEX50)
                          GET R1_AB_HIST(a,b1,MINDEX50) 

                          Tab(a,b1)   = HR1_AB_HIST(a,b1,NINDEX50)
                          T1ab(a,b1)  = R1_AB_HIST(a,b1,MINDEX50)

                          TMP   = Tab(a,b1) * T1ab(a,b1)
                          SUMA += TMP

                    ENDPARDO a, b1

                    EXECUTE SERVER_BARRIER 
                    COLLECTIVE HC_A += SUMA

                 ENDIF

              ENDDO MINDEX50 
           ENDIF

        ENDDO NINDEX50

      ENDIF 
#
# In iteration one there are no contributions from R1AAA, R1BBB.. since
# those are zero at the start. Note that HR1AAA are non-zero but the 
# overlap is still zero.
         
     A_VALUE  = HC_A
#bgn_debug
#     execute print_scalar A_value 
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50 
               MCOUNT += 1.0
               IF MCOUNT == 1.0
  
                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF 
             ENDDO MINDEX50
         ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC FORM_A_MATRIX_11
#    -------------------------

     PROC FORM_A_MATRIX_IJ
#    ----------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO a, b1

                            GET HR1_AB_HIST(a,b1,NINDEX50)
                            GET R1_AB_HIST(a,b1,MINDEX50)

                            Tab(a,b1)   = HR1_AB_HIST(a,b1,NINDEX50)
                            T1ab(a,b1)  = R1_AB_HIST(a,b1,MINDEX50)

                            TMP   = Tab(a,b1) * T1ab(a,b1)
                            SUMA += TMP

                     ENDPARDO a, b1

                     PARDO a, b, i1, a1

                           REQUEST HR2_ABAA_HIST(a,b,i1,a1,NINDEX50) a
                           REQUEST R2_ABAA_HIST(a,b,i1,a1,MINDEX50) a

                           Tabia(a,b,i1,a1)  = HR2_ABAA_HIST(a,b,i1,a1,NINDEX50)
                           T1abia(a,b,i1,a1) = R2_ABAA_HIST(a,b,i1,a1,MINDEX50)

                           TMP     =  Tabia(a,b,i1,a1) * T1abia(a,b,i1,a1)
                           SUMAAA += TMP
                
                     ENDPARDO a, b, i1, a1

                     PARDO a, b, j1, b1

                           REQUEST HR2_ABBB_HIST(a,b,j1,b1,NINDEX50) b
                           REQUEST R2_ABBB_HIST(a,b,j1,b1,MINDEX50)  b

                           Tabjb(a,b,j1,b1)  = HR2_ABBB_HIST(a,b,j1,b1,NINDEX50)
                           T1abjb(a,b,j1,b1) = R2_ABBB_HIST(a,b,j1,b1,MINDEX50)
                        
                           TMP     = Tabjb(a,b,j1,b1) * T1abjb(a,b,j1,b1) 
                           SUMBBB += TMP

                     ENDPARDO a, b, j1, b1

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------

     PROC FORM_A_MATRIX_JI
#    ----------------------

# Built A_jk where k=1, ..j-1, <(HC_k)_j | C_k>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT >= NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO a, b1

                            GET HR1_AB_HIST(a,b1,MINDEX50)
                            GET R1_AB_HIST(a,b1,NINDEX50)

                            Tab(a,b1)   = HR1_AB_HIST(a,b1,MINDEX50)
                            T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)

                            TMP   = Tab(a,b1) * T1ab(a,b1)
                            SUMA += TMP

                     ENDPARDO a, b1

                     PARDO a, b, i1, a1

                           REQUEST HR2_ABAA_HIST(a,b,i1,a1,MINDEX50) a
                           REQUEST R2_ABAA_HIST(a,b,i1,a1,NINDEX50)  a

                           Tabia(a,b,i1,a1)  = HR2_ABAA_HIST(a,b,i1,a1,MINDEX50)
                           T1abia(a,b,i1,a1) = R2_ABAA_HIST(a,b,i1,a1,NINDEX50)

                           TMP     = Tabia(a,b,i1,a1) * T1abia(a,b,i1,a1)
                           SUMAAA += TMP
                
                     ENDPARDO a, b, i1, a1

                     PARDO a, b, j1, b1

                           REQUEST HR2_ABBB_HIST(a,b,j1,b1,MINDEX50) b
                           REQUEST R2_ABBB_HIST(a,b,j1,b1,NINDEX50)  b

                           Tabjb(a,b,j1,b1)  = HR2_ABBB_HIST(a,b,j1,b1,MINDEX50)
                           T1abjb(a,b,j1,b1) = R2_ABBB_HIST(a,b,j1,b1,NINDEX50)
                        
                           TMP     = Tabjb(a,b,j1,b1) * T1abjb(a,b,j1,b1)
                           SUMBBB += TMP

                     ENDPARDO a, b, j1, b1

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------

     PROC  FORM_A_MATRIX_II
#    ----------------------

     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     HC_A   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0
                 IF NCOUNT == MCOUNT

                    PARDO a, b1

                            GET HR1_AB_HIST(a,b1,MINDEX50)
                            GET R1_AB_HIST(a,b1,NINDEX50)

                            Tab(a,b1)   = HR1_AB_HIST(a,b1,MINDEX50)
                            T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)

                            TMP   = Tab(a,b1) * T1ab(a,b1)
                            SUMA += TMP

                     ENDPARDO a, b1

                     PARDO a, b, i1, a1

                           REQUEST HR2_ABAA_HIST(a,b,i1,a1,MINDEX50) a
                           REQUEST R2_ABAA_HIST(a,b,i1,a1,NINDEX50)  a

                           Tabia(a,b,i1,a1)  = HR2_ABAA_HIST(a,b,i1,a1,MINDEX50)
                           T1abia(a,b,i1,a1) = R2_ABAA_HIST(a,b,i1,a1,NINDEX50)

                           TMP     = Tabia(a,b,i1,a1) * T1abia(a,b,i1,a1)
                           SUMAAA += TMP

                     ENDPARDO a, b, i1, a1

                     PARDO a, b, j1, b1

                           REQUEST HR2_ABBB_HIST(a,b,j1,b1,MINDEX50) b
                           REQUEST R2_ABBB_HIST(a,b,j1,b1,NINDEX50)  b

                           Tabjb(a,b,j1,b1)  = HR2_ABBB_HIST(a,b,j1,b1,MINDEX50)
                           T1abjb(a,b,j1,b1) = R2_ABBB_HIST(a,b,j1,b1,NINDEX50)

                           TMP     = Tabjb(a,b,j1,b1) * T1abjb(a,b,j1,b1)
                           SUMBBB += TMP

                     ENDPARDO a, b, j1, b1
 
                   EXECUTE SERVER_BARRIER
                   COLLECTIVE HC_A   += SUMA
                   COLLECTIVE HC_AAA += SUMAAA
                   COLLECTIVE HC_BBB += SUMBBB

                   A_VALUE  = HC_A
                   A_VALUE += HC_AAA
                   A_VALUE += HC_BBB

                   KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50
                ENDIF 
              ENDDO NINDEX50 
       ENDIF 

     ENDDO MINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_II
#    -------------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE 
     OMEGA0M  = A_VALUE 
     OMEGA0M *= -1.0
#bgn_debug
#     execute print_scalar OMEGA0M
#end_debug

# First the residual vector for iteration 1
     
     PARDO a, b1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1_AB_HIST(a,b1,NINDEX50)
              GET R1_AB_HIST(a,b1,NINDEX50)

              Tab(a,b1)   = HR1_AB_HIST(a,b1,NINDEX50)
              T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)
              T1ab(a,b1) *= OMEGA0M
              Tab(a,b1)  += T1ab(a,b1)
 
              PUT RES1_AB(a,b1) = Tab(a,b1)

           ENDDO NINDEX50
     ENDPARDO a, b1

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO a, b, i1, a1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2_ABAA_HIST(a,b,i1,a1,NINDEX50) a

              Tabia(a,b,i1,a1)  = HR2_ABAA_HIST(a,b,i1,a1,NINDEX50)
              PREPARE RES2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1)

           ENDDO NINDEX50
     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2_ABBB_HIST(a,b,j1,b1,NINDEX50) b

              Tabia(a,b,j1,b1)  = HR2_ABBB_HIST(a,b,j1,b1,NINDEX50)
              PREPARE RES2_ABBB(a,b,j1,b1) = Tabia(a,b,j1,b1)

           ENDDO NINDEX50
     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER 

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,b1
#            get res1_ab(a,b1)
#            tmp = res1_ab(a,b1) * res1_ab(a,b1)
#            tmpa+= tmp
#      endpardo a,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

# Now the correction vector for iteration 1

     PARDO a, b1
           GET RES1_AB(a,b1)
           GET D1_AB(a,b1)

           Tab(a,b1)   = D1_AB(a,b1)
           T1ab(a,b1)  = RES1_AB(a,b1)

           Tab(a,b1)  *= -1.0
           T2ab1(a,b1) = OMEGA0
           Tab(a,b1)  += T2ab1(a,b1)

           EXECUTE APPLY_DEN2_NOR  T1ab Tab

           PUT CORR_VEC_AB(a,b1) =  T1ab(a,b1)
     ENDPARDO a, b1

    PARDO a, b, i1, a1
         REQUEST RES2_ABAA(a,b,i1,a1) a1
         REQUEST D2_ABAA(a,b,i1,a1) a1

         Tabia(a,b,i1,a1)  = D2_ABAA(a,b,i1,a1)
         T1abia(a,b,i1,a1) = RES2_ABAA(a,b,i1,a1)

         Tabia(a,b,i1,a1) *= -1.0
         T2abia(a,b,i1,a1) = OMEGA0
         Tabia(a,b,i1,a1)  += T2abia(a,b,i1,a1)

         EXECUTE APPLY_DEN4 T1abia Tabia
             
         PREPARE CORR_VEC_ABAA(a,b,i1,a1) = T1abia(a,b,i1,a1)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1
         REQUEST RES2_ABBB(a,b,j1,b1) b1
         REQUEST  D2_ABBB(a,b,j1,b1) b1

         Tabjb(a,b,j1,b1)  = D2_ABBB(a,b,j1,b1)
         T1abjb(a,b,j1,b1) =  RES2_ABBB(a,b,j1,b1)

         Tabjb(a,b,j1,b1)  *= -1.0
         T2abjb(a,b,j1,b1)  = OMEGA0
         Tabjb(a,b,j1,b1)  += T2abjb(a,b,j1,b1)

         EXECUTE APPLY_DEN4 T1abjb Tabjb

         PREPARE CORR_VEC_ABBB(a,b,j1,b1) = T1abjb(a,b,j1,b1)

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER
#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,b1
#            get corr_vec_ab(a,b1)
#            tmp =corr_vec_ab(a,b1) * corr_vec_ab(a,b1)
#            tmpa+= tmp
#      endpardo a,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     HC_A   = 0.0

     PARDO a, b1
           GET CORR_VEC_AB(a,b1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(a,b1,NINDEX50)

              Tab(a,b1)   = CORR_VEC_AB(a,b1) 
              T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)
              TMP   = Tab(a,b1) * T1ab(a,b1) 
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO a, b1

     EXECUTE SIP_BARRIER
     COLLECTIVE  HC_A += SUMA
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO a, b1

           GET CORR_VEC_AB(a,b1)
           Tab(a,b1) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(a,b1,NINDEX50)

              Tab(a,b1)   = CORR_VEC_AB(a,b1) 
              T1ab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50)
              T1ab(a,b1) *= NORM_GHG
              T1ab(a,b1) *= -1.0
              Tab(a,b1)  += T1ab(a,b1)

           ENDDO NINDEX50

          PUT R1_AB_intmd(a,b1) = Tab(a,b1)
     ENDPARDO a, b1

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO a, b, i1, a1

           REQUEST CORR_VEC_ABAA(a,b,i1,a1) a1

           Tabia(a,b,i1,a1)  = CORR_VEC_ABAA(a,b,i1,a1)
           PREPARE R2_ABAA_intmd(a,b,i1,a1) = Tabia(a,b,i1,a1)

     ENDPARDO a, b, i1, a1

     PARDO a, b, j1, b1

           REQUEST CORR_VEC_ABBB(a,b,j1,b1) b1

           Tabjb(a,b,j1,b1)  = CORR_VEC_ABBB(a,b,j1,b1)
           PREPARE R2_ABBB_intmd(a,b,j1,b1) = Tabjb(a,b,j1,b1)

     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER 

# Final normalization 

     SUMA    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     HC_A    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0

     PARDO a, b1

            GET  R1_AB_intmd(a,b1)
            Tab(a,b1) = R1_AB_intmd(a,b1)
            TMP   = Tab(a,b1) * Tab(a,b1)
            HC_A += TMP

      ENDPARDO a, b1

      PARDO a, b, i1, a1

              REQUEST R2_ABAA_intmd(a,b,i1,a1) a1
              Tabia(a,b,i1,a1) = R2_ABAA_intmd(a,b,i1,a1)

              TMP   = Tabia(a,b,i1,a1) * Tabia(a,b,i1,a1)
              HC_AAA += TMP

      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1

              REQUEST R2_ABBB_intmd(a,b,j1,b1) b1
              Tabjb(a,b,j1,b1) = R2_ABBB_intmd(a,b,j1,b1)

              TMP   = Tabjb(a,b,j1,b1) * Tabjb(a,b,j1,b1)
              HC_BBB +=  TMP
              
     ENDPARDO a, b, j1, b1

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB

     SUM_R  = SUMA
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     PARDO a, b1

            GET  R1_AB_intmd(a,b1)
            Tab(a,b1) = R1_AB_intmd(a,b1)
            Tab(a,b1) *= INV_SQRT_NORM_R
            PUT R1_AB(a,b1) = Tab(a,b1) 

      ENDPARDO a, b1

      PARDO a, b, i1, a1

              REQUEST R2_ABAA_intmd(a,b,i1,a1) a1
              Tabia(a,b,i1,a1)  = R2_ABAA_intmd(a,b,i1,a1)
              Tabia(a,b,i1,a1) *= INV_SQRT_NORM_R
              PREPARE R2_ABAA(a,b,i1,a1) = Tabia(a,b,i1,a1) 

      ENDPARDO a, b, i1, a1

      PARDO a, b, j1, b1

              REQUEST R2_ABBB_intmd(a,b,j1,b1) b1
              Tabjb(a,b,j1,b1)  = R2_ABBB_intmd(a,b,j1,b1)
              Tabjb(a,b,j1,b1) *= INV_SQRT_NORM_R
              PREPARE R2_ABBB(a,b,j1,b1) = Tabjb(a,b,j1,b1)
              
     ENDPARDO a, b, j1, b1

     EXECUTE SERVER_BARRIER

#bgn_debug
