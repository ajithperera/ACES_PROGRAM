     PROC SELECT_VECS
#    ----------------

     NCOUNT = 0.0

     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT  > 1.0
           EXIT
        ENDIF 

           MCOUNT = 0.0
           DO MINDEX50
              MCOUNT += 1.0
              IF MCOUNT >  ITER_COUNT
                 EXIT
              ENDIF

     	         SUMA   = 0.0
                 CY_A   = 0.0

                 PARDO a, b1

                       GET R1_AB_HIST(a,b1,NINDEX50)
                       GET Y1_AB(a,b1,MINDEX50)

                       Tab(a,b1)  = R1_AB_HIST(a,b1,NINDEX50) 
                       T1ab(a,b1) = Y1_AB(a,b1,MINDEX50) 
               
                       TMP   = Tab(a,b1) * T1ab(a,b1)
                       SUMA +=  TMP
                       
                  ENDPARDO a, b1

                  EXECUTE SIP_BARRIER
                  COLLECTIVE CY_A += SUMA
                       
                  CY_AB  = CY_A

                  KCOUNT = 0.0 
                  DO KINDEX50 
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT 
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF 

                  ENDDO KINDEX50 

           ENDDO  MINDEX50

#        ENDIF

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
#bgn_debug
#     execute print_scalar imax 
#end_debug

     ENDPROC SELECT_VECS
#    -------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b1
 
                 GET Y1_AB(a,b1,NINDEX50) 
                 Tab(a,b1) = Y1_AB(a,b1,NINDEX50)
                 PUT Y1_AB_PICKED(a,b1) = Tab(a,b1)

           ENDPARDO a, b1
        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, i1, a1

                 REQUEST Y2_ABAA(a,b,i1,a1,NINDEX50) a
                 Tabia(a,b,i1,a1) = Y2_ABAA(a,b,i1,a1,NINDEX50) 
                 PREPARE Y2_ABAA_picked(a,b,i1,a1) = Tabia(a,b,i1,a1)

           ENDPARDO a, b, i1, a1

        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, j1, b1

                 REQUEST Y2_ABBB(a,b,j1,b1,NINDEX50) j1
                 Tabjb(a,b,j1,b1) = Y2_ABBB(a,b,j1,b1,NINDEX50)
                 PREPARE Y2_ABBB_picked(a,b,j1,b1) = Tabjb(a,b,j1,b1)

