#            get  R2a_aa(a,kk1,a1,i)
#            tmp = R2a_aa(a,kk1,a1,i) * R2a_aa(a,kk1,a1,i)
#            tmpa += tmp
#      endpardo a,a1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,b,j, kk1
#            get  R2b_bb(b,kk1,b,j)
#            tmp = R2b_bb(b,kk1,b,j) * R2b_bb(b,kk1,b,j)
#            tmpa+= tmp
#      endpardo b,b,j, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,j,kk1
#            get R2a_bb(a,kk1,b,j)
#            tmp = R2a_bb(a,kk1,b,j) * R2a_bb(a,kk1,b,j)
#            tmpa+= tmp
#      endpardo a,b,j,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa=0.0
#      suma=0.0
#      pardo b,a,i,kk1
#            get R2b_aa(b,kk1,a,i)
#            tmp = R2b_aa(b,kk1,a,i) * R2b_aa(b,kk1,a,i)
#            tmpa+= tmp
#      endpardo b,a,i,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug

     ENDPROC RESCALE_NEW_C
#    ---------------------

    PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF

#                 IF MCOUNT == ITER_COUNT
#                    IF NCOUNT == ITER_COUNT
#                       EXIT
#                    ENDIF
#                ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO a, kk1

                            GET R1A_HIST(a,kk1,NINDEX50)
                            GET R1A_HIST(a,kk1,MINDEX50)

                            Takk(a,kk1)   = R1A_HIST(a,kk1,NINDEX50)
                            T1akk(a,kk1)  = R1A_HIST(a,kk1,MINDEX50)

                            TMP   = Takk(a,kk1) * T1akk(a,kk1)
                            SUMA += TMP

                     ENDPARDO a, kk1

                     PARDO b, kk1

                           GET R1B_HIST(b,kk1,NINDEX50)
                           GET R1B_HIST(b,kk1,MINDEX50)

                           Tbkk(b,kk1)  = R1B_HIST(b,kk1,NINDEX50)
                           T1bkk(b,kk1) = R1B_HIST(b,kk1,MINDEX50)

                            TMP   = Tbkk(b,kk1) * T1bkk(b,kk1)
                            SUMB += TMP

                     ENDPARDO b, kk1

                     PARDO a, a1, kk1, i

                           REQUEST R2a_aa_HIST(a,kk1,a1,i,NINDEX50) i
                           REQUEST R2a_aa_HIST(a,kk1,a1,i,MINDEX50) i

                           Taxaa(a,kk1,a1,i)  = R2a_aa_HIST(a,kk1,a1,i,NINDEX50)
                           T1axaa(a,kk1,a1,i) = R2a_aa_HIST(a,kk1,a1,i,MINDEX50)

                           TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
                           SUMAAA += TMP

                     ENDPARDO a, a1, kk1, i

                     PARDO b, b1, kk1, j
                           REQUEST R2b_bb_HIST(b,kk1,b1,j,NINDEX50) j
                           REQUEST R2b_bb_HIST(b,kk1,b1,j,MINDEX50) j

                           Tbxbb(b,kk1,b1,j)  = R2b_bb_HIST(b,kk1,b1,j,NINDEX50)
                           T1bxbb(b,kk1,b1,j) = R2b_bb_HIST(b,kk1,b1,j,MINDEX50)

                           TMP     = Tbxbb(b,kk1,b1,j) * T1bxbb(b,kk1,b1,j)
                           SUMBBB += TMP

                     ENDPARDO b, b1, kk1, j

                     PARDO a, b, kk1, j
                           REQUEST R2a_bb_HIST(a,kk1,b,j,NINDEX50) j
                           REQUEST R2a_bb_HIST(a,kk1,b,j,MINDEX50)  j

                           Taxbb(a,kk1,b,j)  = R2a_bb_HIST(a,kk1,b,j,NINDEX50)
                           T1axbb(a,kk1,b,j) = R2a_bb_HIST(a,kk1,b,j,MINDEX50)

                           TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
                           SUMAAB += TMP

                     ENDPARDO a, b, kk1, j

                     PARDO b, a, kk1, i
                           REQUEST R2b_aa_HIST(b,kk1,a,i,NINDEX50) i
                           REQUEST R2b_aa_HIST(b,kk1,a,i,MINDEX50)  i

                           Tbxaa(b,kk1,a,i)  = R2b_aa_HIST(b,kk1,a,i,NINDEX50)
                           T1bxaa(b,kk1,a,i) = R2b_aa_HIST(b,kk1,a,i,MINDEX50)

                           TMP   = Tbxaa(b,kk1,a,i) * T1bxaa(b,kk1,a,i)
                           SUMBBA += TMP

                     ENDPARDO b, a, kk1, i

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     execute print_static etemp  iter_count

     ENDPROC C_CHECK
#    ---------------

   PROC INIT_TO_ZERO
#    -----------------

     NCOUNT = ZERO
     DO NINDEX50

     NCOUNT +=1.0

     IF NCOUNT <= NREDUCE

     PARDO a
        DO kk1
           tax(a,kk1)      = 0.0
           PUT Y1a_TRUNCT(a,kk1,NINDEX50)  = tax(a,kk1)
        ENDDO kk1
     ENDPARDO a

     PARDO b
        DO kk1
           tbx(b,kk1)      = 0.0
           PUT Y1b_TRUNCT(b,kk1,NINDEX50)  = tbx(b,kk1)
       ENDDO kk1
     ENDPARDO b

     PARDO i, a, a1
           DO kk1
              taxaa(a,kk1,a1,i)       = 0.0
              PREPARE Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50)  = taxaa(a,kk1,a1,i)
           ENDDO kk1
     ENDPARDO i, a, a1

     PARDO b, b1, j
           DO kk1
              tbxbb(b,kk1,b1,j)       = 0.0
              PREPARE Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50)  = tbxbb(b,kk1,b1,j)
           ENDDO kk1
     ENDPARDO b, b1, j

     PARDO  a, b, j
           DO kk1
              taxbb(a,kk1,b,j)       = 0.0
              PREPARE Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50)  = taxbb(a,kk1,b,j)
           ENDDO kk1
     ENDPARDO a, b, j

     PARDO b, a, i
           DO kk1
              tbxaa(b,kk1,a,i)       = 0.0
              PREPARE Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50)  = tbxaa(b,kk1,a,i)
           ENDDO kk1
     ENDPARDO b, a, i
     ENDIF 

     ENDDO NINDEX50

     EXECUTE  SERVER_BARRIER

     ENDPROC INIT_TO_ZERO
#    -------------------

     PROC TRANSFORM_C
#    ----------------
   PARDO a, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1A_HIST(a,kk1,MINDEX50)
                       Taxs(a,kk1,MINDEX50)  = R1A_HIST(a,kk1,MINDEX50)
                       T1axs(a,kk1,NINDEX50) = Taxs(a,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(a,kk1,NINDEX50) += T1axs(a,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, kk1
     PARDO b, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET R1B_HIST(b,kk1,MINDEX50)
                       Tbxs(b,kk1,MINDEX50)  = R1B_HIST(b,kk1,MINDEX50)
                       T1bxs(b,kk1,NINDEX50) = Tbxs(b,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B_TRUNCT(b,kk1,NINDEX50) += T1bxs(b,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  b, kk1

     PARDO a, a1, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2a_aa_HIST(a,kk1,a1,i,MINDEX50)  i

                       Taxaas(a,kk1,a1,i,MINDEX50) = R2a_aa_HIST(a,kk1,a1,i,MINDEX50)
                       T1axaas(a,kk1,a1,i,NINDEX50) = Taxaas(a,kk1,a1,i,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50) += T1axaas(a,kk1,a1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2b_bb_HIST(b,kk1,b1,j,MINDEX50)  j

                       Tbxbbs(b,kk1,b1,j,MINDEX50) = R2b_bb_HIST(b,kk1,b1,j,MINDEX50)
                       T1bxbbs(b,kk1,b1,j,NINDEX50) = Tbxbbs(b,kk1,b1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50) += T1bxbbs(b,kk1,b1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2a_bb_HIST(a,kk1,b,j,MINDEX50) j

                       Taxbbs(a,kk1,b,j,MINDEX50) = R2a_bb_HIST(a,kk1,b,j,MINDEX50)
                       T1axbbs(a,kk1,b,j,NINDEX50) = Taxbbs(a,kk1,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50) += T1axbbs(a,kk1,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, kk1, j
     PARDO b, a, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2b_aa_HIST(b,kk1,a,i,MINDEX50) i

                       Tbxaas(b,kk1,a,i,MINDEX50) = R2b_aa_HIST(b,kk1,a,i,MINDEX50)
                       T1bxaas(b,kk1,a,i,NINDEX50) = Tbxaas(b,kk1,a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50) += T1bxaas(b,kk1,a,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER

     ENDPROC TRANSFORM_C
#    -------------------

     PROC TRANSFORM_HC
#    -----------------

     PARDO a, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET HR1A_HIST(a,kk1,MINDEX50)
                       Taxs(a,kk1,MINDEX50)  = HR1A_HIST(a,kk1,MINDEX50)
                       T1axs(a,kk1,NINDEX50) = Taxs(a,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(a,kk1,NINDEX50) += T1axs(a,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, kk1

     PARDO b, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET HR1B_HIST(b,kk1,MINDEX50)
                       Tbxs(b,kk1,MINDEX50)  = HR1B_HIST(b,kk1,MINDEX50)
                       T1bxs(b,kk1,NINDEX50) = Tbxs(b,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B_TRUNCT(b,kk1,NINDEX50) += T1bxs(b,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  b, kk1

     PARDO a, a1, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2a_aa_HIST(a,kk1,a1,i,MINDEX50)  i

                       Taxaas(a,kk1,a1,i,MINDEX50) = HR2a_aa_HIST(a,kk1,a1,i,MINDEX50)
                       T1axaas(a,kk1,a1,i,NINDEX50) = Taxaas(a,kk1,a1,i,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50) += T1axaas(a,kk1,a1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2b_bb_HIST(b,kk1,b1,j,MINDEX50)  j

                       Tbxbbs(b,kk1,b1,j,MINDEX50) = HR2b_bb_HIST(b,kk1,b1,j,MINDEX50)
                       T1bxbbs(b,kk1,b1,j,NINDEX50) = Tbxbbs(b,kk1,b1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50) += T1bxbbs(b,kk1,b1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2a_bb_HIST(a,kk1,b,j,MINDEX50) j

                       Taxbbs(a,kk1,b,j,MINDEX50) = HR2a_bb_HIST(a,kk1,b,j,MINDEX50)
                       T1axbbs(a,kk1,b,j,NINDEX50) = Taxbbs(a,kk1,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50) += T1axbbs(a,kk1,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST HR2b_aa_HIST(b,kk1,a,i,MINDEX50) i

                       Tbxaas(b,kk1,a,i,MINDEX50) = HR2b_aa_HIST(b,kk1,a,i,MINDEX50)
                       T1bxaas(b,kk1,a,i,NINDEX50) = Tbxaas(b,kk1,a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50) += T1bxaas(b,kk1,a,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER

     ENDPROC TRANSFORM_HC
#    --------------------

     PROC COPY_NORM_C
#    ----------------

     NCOUNT = 0.0
     DO NINDEX50
     NCOUNT += 1.0

     IF NCOUNT <= NREDUCE 
     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0

     PARDO a, kk1
            GET  Y1a_TRUNCT(a,kk1,NINDEX50)
            Takk(a,kk1) = Y1a_TRUNCT(a,kk1,NINDEX50)
            TMP   = Takk(a,kk1) * Takk(a,kk1)
            HC_A += TMP
      ENDPARDO a, kk1

      PARDO b, kk1
            GET  Y1b_TRUNCT(b,kk1,NINDEX50)
            Tbkk(b,kk1) =  Y1b_TRUNCT(b,kk1,NINDEX50)
            TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
            HC_B += TMP
      ENDPARDO b, kk1

      PARDO a, a1, kk1, i
              REQUEST Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50) i
              Taxaa(a,kk1,a1,i) = Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50)
              TMP   = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
              HC_AAA += TMP
      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j
              REQUEST Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50) j
              Tbxbb(b,kk1,b1,j) = Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50)
              TMP   = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
              HC_BBB +=  TMP
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
              REQUEST Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50) j
              Taxbb(a,kk1,b,j) = Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50)
              TMP   = Taxbb(a,kk1,b,j) * Taxbb(a,kk1,b,j)
              HC_AAB +=  TMP
     ENDPARDO a, b, kk1, j

     PARDO b, kk1, a, i

              REQUEST Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50) i
              Tbxaa(b,kk1,a,i) = Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50)
              TMP = Tbxaa(b,kk1,a,i) * Tbxaa(b,kk1,a,i)
              HC_BBA +=  TMP
     ENDPARDO b, kk1, a, i

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT

     EXECUTE SIP_BARRIER

     DO kk1
        DO a
           GET Y1a_TRUNCT(a,kk1,NINDEX50)
           Takk(a,kk1)  = Y1a_TRUNCT(a,kk1,NINDEX50)
           Takk(a,kk1) *= INV_SQRT_NORM_ORTGC
           PUT R1a_HIST(a,kk1,NINDEX50) =  Takk(a,kk1)
         ENDDO a
     ENDDO kk1

     DO kk1
         DO b
            GET Y1b_TRUNCT(b,kk1,NINDEX50)
            Tbkk(b,kk1)  = Y1b_TRUNCT(b,kk1,NINDEX50)
            Tbkk(b,kk1) *= INV_SQRT_NORM_ORTGC
            PUT R1b_HIST(b,kk1,NINDEX50) =  Tbkk(b,kk1)
         ENDDO b
     ENDDO kk1

    PARDO a, a1, kk1, i
         REQUEST Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50) i
         Taxaa(a,kk1,a1,i)  = Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50)
         Taxaa(a,kk1,a1,i) *= INV_SQRT_NORM_ORTGC
         PREPARE R2a_aa_HIST(a,kk1,a1,i,NINDEX50) = Taxaa(a,kk1,a1,i)
     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j
         REQUEST Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50) j
         Tbxbb(b,kk1,b1,j)  = Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50)
         Tbxbb(b,kk1,b1,j) *= INV_SQRT_NORM_ORTGC
         PREPARE R2b_bb_HIST(b,kk1,b1,j,NINDEX50) = Tbxbb(b,kk1,b1,j)
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
        REQUEST Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50) j
        Taxbb(a,kk1,b,j)  =  Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50)
        Taxbb(a,kk1,b,j) *= INV_SQRT_NORM_ORTGC
        PREPARE R2a_bb_HIST(a,kk1,b,j,NINDEX50) = Taxbb(a,kk1,b,j)
     ENDPARDO a, b, kk1, j

     PARDO b, kk1, a, i
        REQUEST Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50) i
        Tbxaa(b,kk1,a,i)  = Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50)
        Tbxaa(b,kk1,a,i) *= INV_SQRT_NORM_ORTGC
        PREPARE R2b_aa_HIST(b,kk1,a,i,NINDEX50) = Tbxaa(b,kk1,a,i)
     ENDPARDO b, kk1, a, i

     ENDIF 
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

     ENDPROC COPY_NORM_C
#    -------------------

     PROC COPY_HC
#    ------------

     NCOUNT = 0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT <= NREDUCE 

        DO kk1
           DO a
              GET Y1a_TRUNCT(a,kk1,NINDEX50)
              Takk(a,kk1)  = Y1a_TRUNCT(a,kk1,NINDEX50)
              PUT HR1a_HIST(a,kk1,NINDEX50) =  Takk(a,kk1)
            ENDDO a
        ENDDO kk1

        DO kk1
            DO b
               GET Y1b_TRUNCT(b,kk1,NINDEX50)
               Tbkk(b,kk1)  = Y1b_TRUNCT(b,kk1,NINDEX50)
               PUT HR1b_HIST(b,kk1,NINDEX50) =  Tbkk(b,kk1)
            ENDDO b
        ENDDO kk1

        PARDO a, a1, kk1, i
            REQUEST Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50) i
            Taxaa(a,kk1,a1,i)  = Y2a_aa_TRUNCT(a,kk1,a1,i,NINDEX50)
            PREPARE HR2a_aa_HIST(a,kk1,a1,i,NINDEX50) = Taxaa(a,kk1,a1,i)
        ENDPARDO a, a1, kk1, i

        PARDO b, b1, kk1, j
             REQUEST Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50) j
             Tbxbb(b,kk1,b1,j)  = Y2b_bb_TRUNCT(b,kk1,b1,j,NINDEX50)
             PREPARE HR2b_bb_HIST(b,kk1,b1,j,NINDEX50) = Tbxbb(b,kk1,b1,j)
         ENDPARDO b, b1, kk1, j

         PARDO a, b, kk1, j
            REQUEST Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50) j
            Taxbb(a,kk1,b,j)  =  Y2a_bb_TRUNCT(a,kk1,b,j,NINDEX50)
            PREPARE HR2a_bb_HIST(a,kk1,b,j,NINDEX50) = Taxbb(a,kk1,b,j)
         ENDPARDO a, b, kk1, j

         PARDO b, kk1, a, i
             REQUEST Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50) i
             Tbxaa(b,kk1,a,i)  = Y2b_aa_TRUNCT(b,kk1,a,i,NINDEX50)
             PREPARE HR2b_aa_HIST(b,kk1,a,i,NINDEX50) = Tbxaa(b,kk1,a,i)
         ENDPARDO b, kk1, a, i

       ENDIF 
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER 

     ENDPROC COPY_HC
#    ---------------

    PROC ORTHO_NEW_ROOT
#   -------------------
# If we wants to use the exsisting sub-space for the next root, we
# need to orthogonalize the new guess vector to the exsisting subspace.
# Lets use the exsisting arrays and the Schmidt routines.

    PARDO a, kk1
        GET R1A(a,kk1)
        Takk(a,kk1) = R1A(a,kk1)
        PUT CORR_VECa(a,kk1) = Takk(a,kk1)
    ENDPARDO a, kk1

    PARDO b, kk1
        GET R1B(b,kk1)
        Tbkk(b,kk1) = R1B(b,kk1)
        PUT  CORR_VECb(b,kk1) =  Tbkk(b,kk1)
    ENDPARDO b, kk1

    PARDO a, a1, kk1, i
        Taxaa(a,kk1,a1,i) = 0.0
        PUT CORR_VECa_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
    ENDPARDO a, a1, kk1, i

    PARDO b, b1, kk1, j
        Tbxbb(b,kk1,b1,j) = 0.0
        PUT CORR_VECb_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)
    ENDPARDO b, b1, kk1, j

    PARDO a, kk1, b, j
        Taxbb(a,kk1,b,j) = 0.0
        PUT CORR_VECa_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)
    ENDPARDO a, kk1, b, j

    PARDO b, a, kk1, i
        Tbxaa(b,kk1,a,i)  = 0.0
        PUT CORR_VECb_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)
    ENDPARDO b, a, kk1, i

    EXECUTE SIP_BARRIER

    CALL DRIVE_ORTHO

    CALL RESCALE_NEW_C

    ENDPROC ORTHO_NEW_ROOT
#   ----------------------

     PROC INIT_DESTN_ARRAYS
#    ----------------------

     DO MROOTS 
     PARDO i, a, a1, kk1
         taxaa(a,kk1,a1,i) = 0.0
         PREPARE R2a_aa_VECS(a,kk1,a1,i,MROOTS) = taxaa(a,kk1,a1,i)
     ENDPARDO i, a, a1, kk1

     PARDO b, b1, j, kk1
         tbxbb(b,kk1,b1,j) = 0.0
         PREPARE R2b_bb_VECS(b,kk1,b1,j,MROOTS) = tbxbb(b,kk1,b1,j)
     ENDPARDO b, b1, j, kk1

     PARDO  a, b, j, kk1
         taxbb(a,kk1,b,j) = 0.0
         PREPARE R2a_bb_VECS(a,kk1,b,j,MROOTS) = taxbb(a,kk1,b,j)
     ENDPARDO a, b, j, kk1

     PARDO b, a, i, kk1
         tbxaa(b,kk1,a,i) = 0.0
         PREPARE R2b_aa_VECS(b,kk1,a,i,MROOTS) = tbxaa(b,kk1,a,i)
     ENDPARDO b, a, i, kk1
     ENDDO MROOTS 

     EXECUTE SERVER_BARRIER

     ENDPROC INIT_DESTN_ARRAYS
#    ----------------------

     PROC INIT_AUX_STATIC_ARRAYS
#    -----------------------

      DO MINDEX50
      DO NINDEX50 
         ETEMP(NINDEX50,MINDEX50)    = ZERO
      ENDDO NINDEX50
      ENDDO MINDEX50

      DO NINDEX50 
        A_DIAGS(NINDEX50)          = ZERO
        OVERLAP_R(NINDEX50)        = ZERO
      ENDDO NINDEX50 

      DO KK1
      DO MROOTS 
         PSEUDO_ROOTS(MROOTS,KK1) = ZERO
         EOM_EAS(MROOTS,KK1)      = ZERO
         DUMMY(KK1,KK1)           = ZERO
      ENDDO MROOTS 
      ENDDO KK1

      DO a
      DO NROOTS
          RVEC_AA_INTMD(a,NROOTS) = ZERO
      ENDDO NROOTS
      ENDDO a

      dO b
      DO NROOTS
         RVEC_BB_INTMD(b,NROOTS) = ZERO
      ENDDO NROOTS
      ENDDO b 
 
      EXECUTE SIP_BARRIER 

     ENDPROC INIT_AUX_STATIC_ARRAYS
#    --------------------------

     PROC SET_EOM_INCLUDE
#    --------------------

     EXECUTE SET_ACES3_VARS ITER_COUNT FORT
     EXECUTE SET_ACES3_VARS ROOT_COUNT FIFT

     ENDPROC SET_EOM_INCLUDE
#    -----------------------

     PROC TRUNCATE
#    -------------
# Reduce the subspace dimension.

     EXECUTE SERVER_BARRIER  
     IF EOM_MAXCYC < TWELVE
        NREDUCE  = EOM_MAXCYC
        NREDUCE -= THREE
     ELSE
        NREDUCE = TWELVE
     ENDIF
     NFULL  = ITER_COUNT

     EXECUTE SET_ACES3_VARS NREDUCE TEN
     EXECUTE SET_ACES3_VARS NFULL   ELV
     EXECUTE SET_ACES3_VARS OMEGA   TWL

     EXECUTE TRUNCATE_EOM_SUBSPACE A_DIAGS DVECTORS
#bgn_debug
#     execute print_static A_DIAGS NREDUCE
#     execute print_static DVECTORS NFULL
#end_debug

     IF TRNC_COUNT > ONE
        CALL INIT_TO_ZERO
     ENDIF
     CALL TRANSFORM_C
     CALL COPY_NORM_C
     CALL INIT_TO_ZERO
     CALL TRANSFORM_HC
     CALL COPY_HC

     ENDPROC TRUNCATE
#    ----------------

#     MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO     = 0.0
     ONE      = 1.0
     TEN      = 10.0
     ELV      = 11.0
     TWELVE   = 12.0
     THRTEN   = 13.0
     TWL      = TWELVE
     NINETEEN = 19.0
     MONE     = -1.0
     THREE    = 3.0
     FORT     = 14.0
     FIFT     = 15.0

     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC
     EXACT_HY     = ZERO
     MAX_OVLP     = ONE
     MIN_ENEG     = ZERO
     LOCK_THRES   = 0.001
     FIRST_VEC    = ONE
     PREVS_VEC    = ZERO
     LEFT         = ZERO
     RIGHT        = ZERO
     FRESH_SBSP   = ONE
     VERY_SMALL   = EOM_THRES

# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
      CALL READ_DATA
      CALL CREATE_ARRAYS
      CALL INIT_DESTN_ARRAYS
      CALL INIT_AUX_STATIC_ARRAYS

      EXECUTE SET_ACES3_VARS RIGHT LEFT 

# The default denominator is 1P-Hbar and can be switched to Hbar

      IF EOM_DENOM == ONE 
         CALL FORM_12PPH_DIAG
      ELSE 
         CALL FORM_1PPH_DIAG
      ENDIF 

      CALL FORM_INITIAL_GUESS

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC

      ROOT_COUNT = ZERO
      ITER_COUNT = ZERO
      TRNC_COUNT = ZERO

      DO NROOTS

         ROOT_COUNT += ONE
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF

#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug

         MYROOT = ROOT_COUNT
         CALL PREP_EA_GUESS

         CALL KEEP_GUESS_VECS

         LOCK       = ZERO
         IDEGEN     = ZERO 
         IF FRESH_SBSP != ONE
            IF ROOT_COUNT != ONE
               CALL ORTHO_NEW_ROOT
               E_OLD      = OMEGA
            ENDIF
         ENDIF

         IF FRESH_SBSP == ONE
            ITER_COUNT = ZERO
         ENDIF
         SBSP_COUNT = ZERO

         DO EOM_CYCLE

            CALL SET_TO_ZERO

            ITER_COUNT += ONE
            SBSP_COUNT += ONE

            CALL SET_EOM_INCLUDE 
#bgn_debug
        execute print_scalar ITER_COUNT
        execute print_scalar SBSP_COUNT
#end_debug
            IF SBSP_COUNT > MAX_SUBSP_DIM
               EXIT
            ENDIF

            CALL SAVE_C_VECTORS
#bgn_debug
#            call c_check
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS

            IF ITER_COUNT == 1.0
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
           IF ITER_COUNT != 1.0
              CALL REORDER_A_EIGS
           ENDIF
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal.
#
           IF ITER_COUNT == 1.0
              CALL FORM_NEWVECS_ITR1
           ELSE

              IF EXACT_HY == ONE
                 CALL FORM_NEWVECS

                 IF MAX_OVLP == ONE
                    IF FIRST_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF
                 CALL FORM_SELECTED_Y
                 CALL FORM_HBAR_Y_VECS
              ELSE
                 CALL FORM_NEWVECS

                 IF MAX_OVLP == ONE
                    IF FIRST_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF
                 CALL FORM_SELECTED_Y
                 CALL FORM_NEW_HBAR_Y_VECS
                 CALL SELECT_HBAR_Y_VEC_TOGO
              ENDIF 
 
              CALL FORM_RESIDUAL_VEC
              CALL CHECK_CONVERGENCE

              IF ITER_COUNT > ONE 
                 EDIFF = E_OLD - OMEGA
              ENDIF
              E_OLD = OMEGA
              EDIFF *=EDIFF
              EXECUTE SQUARE_ROOT EDIFF HALF
#bgn_debug
      execute print_scalar RESIDUAL_NORM
      execute print_scalar OMEGA
      execute print_scalar EDIFF
#end_debug
              IF LOCK == ZERO 
              IF EDIFF < LOCK_THRES
                 IF IDEGEN == ONE
                    LOCK = ZERO
                 ELSE
                    LOCK = ONE
                 ENDIF 
              ENDIF 
              ENDIF 

              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ELSE
                CALL FORM_CORRECTION_VEC
                CALL DRIVE_ORTHO
                CALL RESCALE_NEW_C
              ENDIF 

# The subspace truncation. When the iteration count goes above
# 19 and still have not converged, then select 12 vectors closest
# to the eigenvalue of interest and start Davidson procedure
# from iteration 13 again.

              IF ITER_COUNT > NINETEEN

                 TRNC_COUNT += ONE
                 CALL TRUNCATE
                 ITER_COUNT  = TWL

              ENDIF
           ENDIF

         EXECUTE SERVER_BARRIER 

         ENDDO EOM_CYCLE 

         SBSP_COUNT += MONE 
         IF SBSP_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in specified number 
# of cycles.
# Lets set energy to zero and inform the user whart that means

            DO KK1
            MCOUNT = ZERO
            DO MROOTS
               MCOUNT += ONE
               IF MCOUNT == ROOT_COUNT
                  PSEUDO_ROOTS(MROOTS,KK1) = OMEGA
               ENDIF
            ENDDO MROOTS
            ENDDO KK1

            IF FRESH_SBSP != ONE
              CALL SAVE_C_VECTORS
              OMEGA_KEEP= OMEGA
            ENDIF
            OMEGA = 0.0

            ENDIF

          ENDIF

#bgn_debug
#      execute print_scalar OMEGA
#end_debug

         DO kk1
            MCOUNT = 0.0
            DO MROOTS
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  EOM_EAS(MROOTS,KK1) = OMEGA
                  IF OMEGA != ZERO
                     PSEUDO_ROOTS(MROOTS,KK1) = OMEGA
                  ENDIF
               ENDIF
            ENDDO MROOTS
         ENDDO kk1

         MCOUNT = ZERO
         DO MROOTS
            MCOUNT += ONE
            IF MCOUNT == ROOT_COUNT
            PARDO kk1, a
                  GET R1a(a,kk1)
                  Takk(a,kk1) = R1a(a,kk1)
                  PUT R1a_VECS(a,kk1,MROOTS) =  Takk(a,kk1)
            ENDPARDO kk1,a

            PARDO kk1, b
                  GET HR1b(b,kk1)
                  Tbkk(b,kk1) = HR1b(b,kk1)
                  PUT R1b_VECS(b,kk1,MROOTS) =  Tbkk(b,kk1)
            ENDPARDO kk1, b

            PARDO a, a1, kk1, i
               GET R2a_aa(a,kk1,a1,i)
               Taxaa(a,kk1,a1,i) = R2a_aa(a,kk1,a1,i)
               PREPARE R2a_aa_VECS(a,kk1,a1,i,MROOTS) = Taxaa(a,kk1,a1,i)
            ENDPARDO a, a1, kk1, i

            PARDO b, b1, kk1, j
               GET R2b_bb(b,kk1,b1,j)
               Tbxbb(b,kk1,b1,j) =  R2b_bb(b,kk1,b1,j)
               PREPARE R2b_bb_VECS(b,kk1,b1,j,MROOTS) = Tbxbb(b,kk1,b1,j)
            ENDPARDO b, b1, kk1, j

            PARDO a,b,kk1,j
               GET R2a_bb(a,kk1,b,j)
               Taxbb(a,kk1,b,j) = R2a_bb(a,kk1,b,j)
               PREPARE R2a_bb_VECS(a,kk1,b,j,MROOTS) = Taxbb(a,kk1,b,j)
            ENDPARDO a, b, kk1, j

            PARDO b, a, kk1, i
               GET R2b_aa(b,kk1,a,i)
               Tbxaa(b,kk1,a,i) =  R2b_aa(b,kk1,a,i)
               PREPARE R2b_aa_VECS(b,kk1,a,i,MROOTS) = Tbxaa(b,kk1,a,i)
            ENDPARDO b, a, kk1, i
            ENDIF 

            ENDDO MROOTS
            IF FRESH_SBSP != ONE
               OMEGA = OMEGA_KEEP
            ENDIF

      ENDDO NROOTS

      EXECUTE SERVER_BARRIER

      SIXONE = 61.0
      EXECUTE PRINT_REL_INFO SIXONE EOM_EAS
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO WARNING DUMMY 
#bgn_debug
      ROOT_COUNT -= 1.0
      execute print_static EOM_EAS ROOT_COUNT
#end_debug

      execute server_barrier
      execute blocks_to_list                VSpipi(p,i,p1,i1)
      execute blocks_to_list                Vaaii
      execute blocks_to_list                Viaai
      execute blocks_to_list                VSaaai
      execute blocks_to_list                VSqjqj(q,j,q1,j1)
      execute blocks_to_list                Vbbjj
      execute blocks_to_list                Vjbbj
      execute blocks_to_list                VSbbbj
      execute blocks_to_list                Vbbii
      execute blocks_to_list                Vjbii
      execute blocks_to_list                Vbbai
      execute blocks_to_list                Vpiqj(p,i,q,j)
      execute blocks_to_list                Viabj
      execute blocks_to_list                Vaabj
      execute blocks_to_list                Vaajj

      execute blocks_to_list                t1a
      execute blocks_to_list                t1b
      execute blocks_to_list                T2aa
      execute blocks_to_list                T2ab
      execute blocks_to_list                T2bb

      execute blocks_to_list                l1a
      execute blocks_to_list                l1b
      execute blocks_to_list                L2aa
      execute blocks_to_list                L2ab
      execute blocks_to_list                L2bb

      execute blocks_to_list                R1a_vecs
      execute blocks_to_list                R1b_vecs
      execute blocks_to_list                R2a_aa_vecs
      execute blocks_to_list                R2b_bb_vecs
      execute blocks_to_list                R2a_bb_vecs
      execute blocks_to_list                R2b_aa_vecs

      execute blocks_to_list                Uaa
      execute blocks_to_list                Ubb
      execute blocks_to_list                Uii
      execute blocks_to_list                Ujj
      execute blocks_to_list                Uia
      execute blocks_to_list                Ujb

      execute blocks_to_list                Wiiii
      execute blocks_to_list                Wjjjj
      execute blocks_to_list                Wiijj

      execute blocks_to_list                Waiaa # HBAR_AIBC_aaaa
      execute blocks_to_list                Wbjbb # HBAR_AIBC_bbbb
      execute blocks_to_list                Waibb # HBAR_AIBC_aabb
      execute blocks_to_list                Wbjaa # HBAR_AIBC_bbaa

      execute blocks_to_list                Wiiia # HBAR_JKIA_aaaa
      execute blocks_to_list                Wjjjb # HBAR_JKIA_bbbb
      execute blocks_to_list                Wiijb # HBAR_JKIA_aabb
      execute blocks_to_list                Wjjia # HBAR_JKIA_bbaa

      execute blocks_to_list                Wiiai # HBAR_IAJK_aaaa
      execute blocks_to_list                Wiibj # HBAR_IAJK_aabb
      execute blocks_to_list                Wjjai # HBAR_IAJK_bbaa
      execute blocks_to_list                Wjjbj # HBAR_IAJK_bbbb

      execute blocks_to_list                Wiaai # HBAR_AJIB_aaaa
      execute blocks_to_list                Wjbbj # HBAR_AJIB_bbbb
      execute blocks_to_list                Wiabj # HBAR_AJIB_aabb
      execute blocks_to_list                Wjbai # HBAR_AJIB_BBAA
      execute blocks_to_list                Wiibb # HBAR_AJIB_iibb
      execute blocks_to_list                Wjjaa # HBAR_AJIB_jjaa

      execute blocks_to_list                Waaai # HBAR_ABCI_aaaa
      execute blocks_to_list                Wbbbj # HBAR_ABCI_bbbb
      execute blocks_to_list                Waabj # HBAR_ABCI_aabb
      execute blocks_to_list                Wbbai # HBAR_ABCI_bbaa

      execute write_blocks_to_list
      execute server_barrier

                           ENDSIAL REA_UHF_EOMCCSD
