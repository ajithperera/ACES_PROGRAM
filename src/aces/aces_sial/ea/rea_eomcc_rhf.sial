                        SIAL REA_UHF_EOMCCSD
#                       --------------------
# -----------------------------------------------------------

      index kiter    = 1, cc_iter
      index jj1      = 1, 1
      index kk1      = 1, 1

      Index Ndim     = 1, 20
      Index Nroots   = 1, 12
      Index Mroots   = 1, 12
      Index Subsp_dim= 1, 20
      Index Nindex50 = 1, 20
      Index Mindex50 = 1, 20
      Index Kindex50 = 1, 20
      Index Lindex50 = 1, 20
      Index Eom_cycle= 1, 150
#
      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#
      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
#
      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt
#
      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
#
      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt
#
#     CCSD amplitudes
#     ---------------
#
      distributed t1a(a,i)
      distributed t1b(b,j)
      distributed l1a(i,a)
      distributed l1b(j,b)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)
      served L2aa(i,a,i1,a1)
      served L2bb(j,b,j1,b1)
      served L2ab(i,a,j,b)
#
#     Transformed integrals
#     ---------------------
#
      served VSpipi(p,i,p1,i1)
      served VSqjqj(q,j,q1,j1)
      served Vpiqj(p,i,q,j)
      served VSaaai(a,a1,a2,i)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)
#
#     HBAR
      distributed Uaa(a,a1)
      distributed Ubb(b,b1)
      distributed Uii(i1,i)
      distributed Ujj(j1,j)
      distributed Uia(i,a)
      distributed Ujb(j,b)
      distributed DDaa(a,a1)
      distributed DDii(i,i1)
      distributed DDia(i,a)
      distributed DDbb(b,b1)
      distributed DDjj(j,j1)
      distributed Ra_aa(a,kk1,a1,i)
      distributed Rb_bb(b,kk1,b1,j)
      distributed Ra_bb(a,kk1,b,j)
      distributed Rb_aa(b,kk1,a,i)
      distributed Ra(a,kk1)
      distributed Rb(b,kk1)

      distributed Raixi(a,i,kk1,i1)
      distributed Rbjxj(b,j,kk1,j1)
      distributed Raixj(a,i,kk1,j1)
      distributed Rbjxi(b,j,kk1,i1)
     
      distributed CORR_VECa(a,kk1)
      distributed CORR_VECb(b,kk1)

      distributed CORR_VECa_aa(a,kk1,a1,i)
      distributed CORR_VECb_bb(b,kk1,b1,j)
      distributed CORR_VECa_bb(a,kk1,b,j)
      distributed CORR_VECb_aa(b,kk1,a,i)

      served Wiiii(i,i1,i2,i3)
      served Wjjjj(j,j1,j2,j3)
      served Wiijj(i,i1,j,j1)
#
      served Waaia(a,a1,i,a2)
      served Wbbjb(b,b1,j,b2)
      served Waajb(a,a1,j,b2)
      served Wbbia(b,b1,i,a2)
#
      served Wiiia(i1,i,i2,a)
      served Wjjjb(j1,j,j2,b)
      served Wiijb(i1,i,j2,b)
      served Wjjia(j1,j,i2,a)
#
      served Wiiai(i,i1,a,i2)
      served Wiibj(i,i1,b,j)
      served Wjjai(j,j1,a,i)
      served Wjjbj(j,j1,b,j2)
#
      served Wiaai(i1,a1,a,i)
      served Wjbbj(j1,b1,b,j)
      served Wiabj(i,a,b,j)
      served Wjbai(j,b,a,i)
      served Wiibb(i1,i,b,b1)
      served Wjjaa(j1,j,a,a1)
#
      served Waaai(a,a1,a2,i)
      served Wbbbj(b,b1,b2,j)
      served Waabj(a,a1,b,j)
      served Wbbai(b,b1,a,i)
#
      served Waiaa(a,a1,i,a2) 
      served Wbjbb(b,b1,j,b2)
      served Waibb(a,a1,j,b2) 
      served Wbjaa(b,b1,i,a2) 
#
      served Wiaii(i,i1,a,i2)
      served Wiajj(i,j,b,j1)
      served Wjbii(j,i,b,i1)
      served Wjbjj(j,j1,b,j2)

      served Waiia(a,i,i1,a1)
      served Wbjjb(b,j,j1,b1)
      served Waijb(a,i,j,b)
      served Wbjia(b,j,i,a)

#     Distributed arrays 
#     ------------------

      distributed R1a(a,kk1)
      distributed R1b(b,kk1)
      distributed R1a_VECS(a,kk1,MROOTS)
      distributed R1b_VECS(b,kk1,MROOTS)
      distributed R2a_aa(a,kk1,a1,i1)
      distributed R2a_bb(a,kk1,b,j)
      distributed R2b_bb(b,kk1,b1,j1)
      distributed R2b_aa(b,kk1,a,i)
      distributed INIT_RVEC_AA(a,Nroots)
      distributed INIT_RVEC_BB(b,Nroots)
      distributed HR1a(a,kk1)
      distributed HR1b(b,kk1)
      distributed HR2a_aa(a,kk1,a1,i1)
      distributed HR2a_bb(a,kk1,b,j)
      distributed HR2b_bb(b,kk1,b1,j1)
      distributed HR2b_aa(b,kk1,a,i)
      distributed R1a_guess(a)
      distributed R1b_guess(b)
      distributed R1a_intmd(a,kk1)
      distributed R1b_intmd(b,kk1)
      distributed Iix(i,kk1)
      distributed Ijx(j,kk1)
      distributed CS2x_aa(mu,kk1,a,i)
      distributed CS2x_bb(mu,kk1,b,j)
      distributed CS2x_xa(mu,kk1,nu,i)
      distributed CS2x_xb(mu,kk1,nu,j)
      distributed S2x_xa(lambda,kk1,sigma,i)
      distributed S2x_xb(lambda,kk1,sigma,j)
      distributed S2x_aa(mu,kk1,a1,i)
      distributed S2x_bb(mu,kk1,b1,j)
      distributed CG2x_aa(mu,kk1,a,i)
      distributed CG2x_bb(mu,kk1,b,j)
      distributed CG2x_xa(mu,kk1,nu,i)
      distributed CG2x_xb(mu,kk1,nu,j)
      distributed G2x_xa(lambda,kk1,sigma,i)
      distributed G2x_xb(lambda,kk1,sigma,j)
      distributed G2x_aa(mu,kk1,a1,i)
      distributed G2x_bb(mu,kk1,b1,j)
      distributed Xixii(i,kk1,i1,i2)
      distributed Xjxjj(j,kk1,j1,j2)
      distributed Xjxii(j,kk1,i1,i2)
      distributed Xixjj(i,kk1,j1,j2)
      Distributed Y1a(a,kk1,subsp_dim)
      Distributed Y1b(b,kk1,subsp_dim)
      Distributed Y1a_TRUNCT(a,kk1,subsp_dim)
      Distributed Y1b_TRUNCT(b,kk1,subsp_dim)
      Distributed HY1a(a,kk1,subsp_dim)
      Distributed HY1b(b,kk1,subsp_dim)
      Distributed Y1a_picked(a,kk1)
      Distributed Y1b_picked(b,kk1)
      Distributed HY1a_picked(a,kk1)
      Distributed HY1b_picked(b,kk1)
      Distributed RES1a(a,kk1)
      Distributed RES1b(b,kk1)
      Distributed RES2a_aa(a,kk1,a1,i1)
      Distributed RES2b_bb(b,kk1,b1,j)
      Distributed RES2a_bb(a,kk1,b,j)
      Distributed RES2b_aa(b,kk1,a,i)
      Distributed ORTHO_COEF(mindex50,nindex50)
      Distributed INITIAL_R1A(a,kk1)
      Distributed INITIAL_R1B(b,kk1)

      Distributed R2a_aa_intmd(a,kk1,a1,i1)
      Distributed R2a_bb_intmd(a,kk1,b,j)
      Distributed R2b_bb_intmd(b,kk1,b1,j1)
      Distributed R2b_aa_intmd(b,kk1,a,i)

      Distributed R1a_HIST(a,kk1,SUBSP_DIM)
      Distributed R1b_HIST(b,kk1,SUBSP_DIM)

      Distributed HR1a_HIST(a,kk1,SUBSP_DIM)
      Distributed HR1b_HIST(b,kk1,SUBSP_DIM)

      Served Y2a_aa(a,kk1,a1,i,subsp_dim)
      Served Y2b_bb(b,kk1,b1,j,subsp_dim)
      Served Y2a_bb(a,kk1,b,j,subsp_dim)
      Served Y2b_aa(b,kk1,a,i,subsp_dim)

      Served Y2a_aa_TRUNCT(a,kk1,a1,i,subsp_dim)
      Served Y2b_bb_TRUNCT(b,kk1,b1,j,subsp_dim)
      Served Y2a_bb_TRUNCT(a,kk1,b,j,subsp_dim)
      Served Y2b_aa_TRUNCT(b,kk1,a,i,subsp_dim)

      Served HY2a_aa(a,kk1,a1,i,subsp_dim)
      Served HY2b_bb(b,kk1,b1,j,subsp_dim)
      Served HY2a_bb(a,kk1,b,j,subsp_dim)
      Served HY2b_aa(b,kk1,a,i,subsp_dim)

      Distributed Y2a_aa_picked(a,kk1,a1,i)
      Distributed Y2b_bb_picked(b,kk1,b1,j)
      Distributed Y2a_bb_picked(a,kk1,b,j)
      Distributed Y2b_aa_picked(b,kk1,a,i)

      Distributed HY2a_aa_picked(a,kk1,a1,i)
      Distributed HY2b_bb_picked(b,kk1,b1,j)
      Distributed HY2a_bb_picked(a,kk1,b,j)
      Distributed HY2b_aa_picked(b,kk1,a,i)

      Served R2a_aa_HIST(a,kk1,a1,i1,SUBSP_DIM)
      Served R2a_bb_HIST(a,kk1,b,j,SUBSP_DIM)
      Served R2b_bb_HIST(b,kk1,b1,j1,SUBSP_DIM)
      Served R2b_aa_HIST(b,kk1,a,i,SUBSP_DIM)

      Served R2a_aa_VECS(a,kk1,a1,i1,MROOTS)
      Served R2a_bb_VECS(a,kk1,b,j,MROOTS)
      Served R2b_bb_VECS(b,kk1,b1,j1,MROOTS)
      Served R2b_aa_VECS(b,kk1,a,i,MROOTS)

      Served HR2a_aa_HIST(a,kk1,a1,i1,SUBSP_DIM)
      Served HR2a_bb_HIST(a,kk1,b,j,SUBSP_DIM)
      Served HR2b_bb_HIST(b,kk1,b1,j1,SUBSP_DIM)
      Served HR2b_aa_HIST(b,kk1,a,i,SUBSP_DIM)

#     Static arrays
#     -------------
#
      Static Sii(i,i1)
      Static Sdii(i,i1)
      Static Saa(a,a1)
      Static Sdaa(a,a1)
      Static Sia(i,a)
      Static Sdia(i,a)
      Static Sjj(j,j1)
      Static Sdjj(j,j1)
      Static Sbb(b,b1)
      Static Sdbb(b,b1)
      Static EA_INIT_HAA(a,a1)
      Static EA_INIT_HBB(b,b1)
      Static VEC_AA(a,Ndim)
      Static VEC_BB(b,Ndim)
      Static RVEC_AA_INTMD(a,Nroots)
      Static RVEC_BB_INTMD(b,Nroots)
      Static A_MATRIX(mindex50,nindex50)
      Static A_DIAGS(MINDEX50)
      Static DVECTORS(mindex50,nindex50)
      Static PSEUDO_ROOTS(NROOTS,kk1)
      Static OVERLAP_R(Nindex50)
      Static ETEMP(NINDEX50,MINDEX50)
      Static EOM_EAS(MROOTS,KK1)
      Static DDaa_s(a,a1)
      Static DUMMY(kk1,kk1)
      
#     Temp arrays
#     -----------
#
      Temp aoint(mu,lambda,nu,sigma)
      Temp Taa(a,a1)
      Temp Tbb(b,b1)
      Temp TaN(a,NROOTS)
      Temp TbN(b,NROOTS)
      Temp Takk(a,kk1)
      Temp T1akk(a,kk1)
      Temp T2akk(a,kk1)
      Temp Tbkk(b,kk1)
      Temp T1bkk(b,kk1)
      Temp T2bkk(b,kk1)
      Temp Ta(a) 
      Temp Tb(b) 
      Temp Taxaa(a,kk1,a1,i)
      Temp Tbxbb(b,kk1,b1,j) 
      Temp Taxbb(a,kk1,b,j)
      Temp Tbxaa(b,kk1,a,i)
      Temp T1axaa(a,kk1,a1,i)
      Temp T2axaa(a,kk1,a1,i)
      Temp T1bxbb(b,kk1,b1,j) 
      Temp T2bxbb(b,kk1,b1,j) 
      Temp T1axbb(a,kk1,b,j)
      Temp T2axbb(a,kk1,b,j)
      Temp T1bxaa(b,kk1,a,i)
      Temp T2bxaa(b,kk1,a,i)
      Temp Tax(a,kk1)
      Temp T1ax(a,kk1)
      Temp Tbx(b,kk1)
      Temp T1bx(b,kk1)
      Temp Taxai(a,kk1,a1,i)
      Temp Taiai(a2,i1,a1,i)
      Temp Tbjai(b2,j1,a1,i) 
      Temp T1axai(a1,kk1,a,i)
      Temp Tix(i,kk1)
      Temp Tjx(j,kk1)
      Temp Tbxbj(b,kk1,b1,j)
      Temp Tbjbj(b2,j1,b1,j)
      Temp Taibj(a2,i1,b1,j)
      Temp T1bxbj(b,kk1,b1,j)
      Temp Tmxmi(mu,kk1,nu,i)
      Temp Tmxmj(mu,kk1,nu,j)
      Temp Tmxai(mu,kk1,a,i)  
      Temp Tmxbj(mu,kk1,b,j)
      Temp Taai(a1,kk1,a,i)
      Temp Taxbj(a1,kk1,b,j)
      Temp Tbxai(b1,kk1,a,i) 
      Temp Tixii(i,kk1,i1,i2)
      Temp Tjxjj(j,kk1,j1,j2) 
      Temp Tjxii(j1,kk1,i1,i)
      Temp Tpp(a2,i1)
      Temp T1pp(a2,i)
      Temp Tmai(mu,kk1,a1,i) 
      Temp T2pppp(p,p1,p2,p3)
      Temp T3pppp(p,p1,p2,p3)
      Temp T4pppp(p,p1,p2,p3)
      Temp Tppqq(p,p1,q,q1)
      Temp T1ppqq(p,p1,q,q1)
      Temp T2ppqq(p,p1,q,q1)
      Temp T3ppqq(p,p1,q,q1)
      Temp Tqqpp(q,q1,p,p1)
      Temp T1qqpp(q,q1,p,p1)
      Temp T2qqpp(q,q1,p,p1)
      Temp T3qqpp(q,q1,p,p1)
      Temp T4qqpp(q,q1,p,p1)
      Temp T2qqqq(q,q1,q2,q3)
      Temp T3qqqq(q,q1,q2,q3)
      Temp T4qqqq(q,q1,q2,q3)
      Temp tixjj(i,kk1,j1,j2)
      Temp t1ixjj(i,kk1,j1,j2)
      Temp Tqppq(q1,p1,p,q)
      Temp T1qppq(q1,p1,p,q)
      Temp Tpqpq(p,q,p1,q1)
      Temp T1pqpq(p,q,p1,q1)
      Temp Tpppp(p,p1,p2,p3)
      Temp T1pppp(p,p1,p2,p3)
      Temp Tqqqq(q,q1,q2,q3)
      Temp T1qqqq(q,q1,q2,q3)
      Temp Tqpqp(j1,a,b2,i1)
      Temp Taaii(a2,a1,i1,i)
      Temp Tqq(b2,j1) 
      Temp T1qq(b2,j) 
      Temp Tbbjj(b2,b1,j1,j) 
      Temp Tii(i,i1)
      Temp T1ii(i,i1)
      Temp T1jj(j,j1)
      Temp Tjj(j,j1)
      Temp Tas(a,kk1)
      Temp T1as(a,kk1)
      Temp T2as(a,kk1)
      Temp Tbs(b,kk1)
      Temp T1bs(b,kk1)
      Temp T2bs(b,kk1)
      Temp Txx(MINDEX50,MINDEX50)
      Temp TS(MINDEX50,NINDEX50)
      Temp Taxs(a,kk1,MINDEX50)
      Temp T1axs(a,kk1,MINDEX50)
      Temp Tbxs(b,kk1,MINDEX50)
      Temp T1bxs(b,kk1,MINDEX50)
      Temp Taxaas(a,kk1,a1,i,MINDEX50)
      Temp T1axaas(a,kk1,a1,i,MINDEX50)
      Temp Tbxbbs(b,kk1,b1,j,MINDEX50)
      Temp T1bxbbs(b,kk1,b1,j,MINDEX50)
      Temp Taxbbs(a,kk1,b,j,MINDEX50)
      Temp T1axbbs(a,kk1,b,j,MINDEX50)
      Temp Tbxaas(b,kk1,a,i,MINDEX50)
      Temp T1bxaas(b,kk1,a,i,MINDEX50)
      Temp Tbbaa(j1,j,a,a1)
      Temp Taabb(a,a1,j1,j)
      Temp T1bbaa(b,b1,i,i1)
      Temp T1aabb(i1,i,b,b1)

#     Scalar arrays
#     -------------
#
      Scalar ROOT_COUNT
      Scalar TARGET_ROOTS
      Scalar EOM_THRES
      Scalar MYROOT
      Scalar COUNTER
      Scalar tmp
      Scalar tmpa
      Scalar tmpb
      Scalar suma
      Scalar sumb
      Scalar sumab
      Scalar Sumaaa
      Scalar Sumbbb
      Scalar Sumaab
      Scalar Sumbba
      Scalar MAX_SUBSP_DIM
      Scalar Iter_count
      Scalar Count
      Scalar Ncount
      Scalar Mcount
      Scalar Kcount
      Scalar Lcount
      Scalar HC_A
      Scalar HC_B
      Scalar HC_AAA
      Scalar HC_BBB
      Scalar HC_AAB
      Scalar HC_BBA
      Scalar SUMAA_A
      Scalar SUMBB_B
      Scalar SUMAA_B
      Scalar SUMBB_A
      Scalar SUM_R
      Scalar C_A
      Scalar C_B
      Scalar C_AAA
      Scalar C_BBB
      Scalar C_AAB
      Scalar C_BBA
      Scalar A_VALUE
      Scalar CY_A
      Scalar CY_B
      Scalar CY_AB
      Scalar IMAX
      Scalar Omega
      Scalar Omegam
      Scalar Eig_value
      Scalar NORM_PREV_C
      Scalar EXPONENT
      Scalar FACT
      Scalar INV_SQRT_NORM_ORTGC
      Scalar NORM_NEW_ORTGC
      Scalar INV_SQRT_NORM_R
      Scalar NORM_R
      Scalar NORM_GHG
      Scalar NORM_OF_CORRECTION
      Scalar RANK
      Scalar RESIDUAL_NORM
      Scalar SQRT_OVERLAP
      Scalar OMEGA0
      Scalar OMEGA0M
      Scalar HALF
      Scalar PRINT_FLAG
      Scalar T0
      Scalar root
      Scalar Zero 
      Scalar One 
      Scalar EOM_GUESSA
      Scalar EOM_DENOM
      Scalar EOM_MAXCYC
      Scalar sixone
      Scalar Warning 
      Scalar EXACT_HY
      Scalar E_OLD
      Scalar EDIFF
      Scalar NINETEEN
      Scalar TWELVE
      Scalar THREE
      Scalar TEN
      Scalar ELV
      Scalar TWL
      Scalar NREDUCE
      Scalar NFULL
      Scalar THRTEN
      Scalar TRNC_COUNT
      Scalar MAX_OVLP
      Scalar MIN_ENEG
      Scalar CURRENT
      Scalar MONE
      Scalar LOCK
      Scalar LOCK_THRES
      Scalar IMAX_KEEP
      Scalar SBSP_COUNT 
      Scalar FORT
      Scalar FIFT
      Scalar FIRST_VEC
      Scalar PREVS_VEC
      Scalar FOLLOW
      Scalar LEFT
      Scalar RIGHT 
      SCALAR OMEGA_KEEP
      SCALAR FRESH_SBSP
      SCALAR VERY_SMALL
      SCALAR IDEGEN
      SCALAR DIFF
      SCALAR OMEGA_00
  
      PROC READ_DATA
#     --------------
#
      create t1a
      create t1b
      create l1a
      create l1b
      create Uaa
      create Ubb
      create Uii
      create Ujj
      create Uia
      create Ujb
#
      execute server_barrier
      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vbbii
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj

      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb

      execute list_to_blocks                l1a
      execute list_to_blocks                l1b
      execute list_to_blocks                L2aa
      execute list_to_blocks                L2ab
      execute list_to_blocks                L2bb

      execute list_to_blocks                Uaa
      execute list_to_blocks                Ubb
      execute list_to_blocks                Uii
      execute list_to_blocks                Ujj
      execute list_to_blocks                Uia
      execute list_to_blocks                Ujb

      execute list_to_blocks                Wiiii
      execute list_to_blocks                Wjjjj
      execute list_to_blocks                Wiijj

      execute list_to_blocks                Waiaa # HBAR_AIBC_aaaa
      execute list_to_blocks                Wbjbb # HBAR_AIBC_bbbb
      execute list_to_blocks                Waibb # HBAR_AIBC_aabb
      execute list_to_blocks                Wbjaa # HBAR_AIBC_bbaa

      execute list_to_blocks                Wiiia # HBAR_JKIA_aaaa
      execute list_to_blocks                Wjjjb # HBAR_JKIA_bbbb
      execute list_to_blocks                Wiijb # HBAR_JKIA_aabb
      execute list_to_blocks                Wjjia # HBAR_JKIA_bbaa

      execute list_to_blocks                Wiiai # HBAR_IAJK_aaaa
      execute list_to_blocks                Wiibj # HBAR_IAJK_aabb
      execute list_to_blocks                Wjjai # HBAR_IAJK_bbaa
      execute list_to_blocks                Wjjbj # HBAR_IAJK_bbbb

      execute list_to_blocks                Wiaai # HBAR_AJIB_aaaa
      execute list_to_blocks                Wjbbj # HBAR_AJIB_bbbb
      execute list_to_blocks                Wiabj # HBAR_AJIB_aabb
      execute list_to_blocks                Wjbai # HBAR_AJIB_BBAA
      execute list_to_blocks                Wiibb # HBAR_AJIB_iibb
      execute list_to_blocks                Wjjaa # HBAR_AJIB_jjaa

      execute list_to_blocks                Waaai # HBAR_ABCI_aaaa
      execute list_to_blocks                Wbbbj # HBAR_ABCI_bbbb
      execute list_to_blocks                Waabj # HBAR_ABCI_aabb
      execute list_to_blocks                Wbbai # HBAR_ABCI_bbaa

      execute read_list_to_blocks
      execute server_barrier
#
      ENDPROC READ_DATA
#     -----------------

      PROC CREATE_ARRAYS
#     --------------------

      CREATE R1A
      CREATE R1B
      CREATE R1A_VECS
      CREATE R1B_VECS
      CREATE HR1A
      CREATE HR1B
      CREATE R1A_GUESS
      CREATE R1B_GUESS
      CREATE INIT_RVEC_AA
      CREATE INIT_RVEC_BB
      CREATE R1A_HIST
      CREATE R1B_HIST
      CREATE HR1A_HIST
      CREATE HR1B_HIST
      CREATE R2a_aa
      CREATE R2b_bb
      CREATE R2a_bb
      CREATE R2b_aa
      CREATE HR2a_aa
      CREATE HR2b_bb
      CREATE HR2a_bb
      CREATE HR2b_aa
      CREATE Y1a
      CREATE Y1b
      CREATE Y1a_TRUNCT
      CREATE Y1b_TRUNCT
      CREATE HY1a
      CREATE HY1b
      CREATE Y1a_PICKED
      CREATE Y1b_PICKED
      CREATE Y2a_aa_PICKED
      CREATE Y2b_bb_PICKED
      CREATE Y2a_bb_PICKED
      CREATE Y2b_aa_PICKED
      CREATE HY1a_PICKED
      CREATE HY1b_PICKED
      CREATE HY2a_aa_PICKED
      CREATE HY2b_bb_PICKED
      CREATE HY2a_bb_PICKED
      CREATE HY2b_aa_PICKED
      CREATE RES1a
      CREATE RES1b
      CREATE RES2a_aa
      CREATE RES2b_bb
      CREATE RES2a_bb
      CREATE RES2b_aa
      CREATE CORR_VECa
      CREATE CORR_VECb
      CREATE CORR_VECa_aa
      CREATE CORR_VECb_bb
      CREATE CORR_VECa_bb
      CREATE CORR_VECb_aa
      CREATE ORTHO_COEF
      CREATE R1a_INTMD
      CREATE R1b_INTMD
      CREATE R2a_aa_INTMD
      CREATE R2b_bb_INTMD
      CREATE R2a_bb_INTMD
      CREATE R2b_aa_INTMD
      CREATE INITIAL_R1A 
      CREATE INITIAL_R1B

      EXECUTE SIP_BARRIER
#
      ENDPROC CREATE_ARRAYS
#     --------------------

      PROC FORM_INITIAL_GUESS
#     -----------------------
#
#  The Initial guess is form by fully solving the eigenvalue problem
#   Hbar(i,k)R(k) =ER(i,p) (p=1,..n; n<= no. of occupied)

      DO a
      DO a1
         EA_INIT_HAA(a,a1) = 0.0
      ENDDO a1
      ENDDO a

      DO b
      DO b1
         EA_INIT_HBB(b,b1) = 0.0
      ENDDO b1
      ENDDO b

      DO Ndim
      DO a
         VEC_AA(a,Ndim) = 0.0
      ENDDO a
      ENDDO Ndim

      DO Ndim
      Do b
         VEC_BB(b,Ndim) = 0.0
      ENDDO b
      ENDDO Ndim
#
      DO a
         DO a1
            GET Uaa(a,a1)
            Taa(a,a1)  = Uaa(a,a1)
            EA_INIT_HAA(a,a1) = Taa(a,a1)
         ENDDO a1
      ENDDO a

      DO b
         DO b1
            GET Ubb(b,b1)
            Tbb(b,b1)  = Ubb(b,b1)
            EA_INIT_HBB(b,b1) = Tbb(b,b1)
         ENDDO b1
      ENDDO b 
      EXECUTE SIP_BARRIER
#bgn_debug
#      suma = 0.0
#      tmpa = 0.0
#      pardo a, a1
#         get  Uaa(a,a1)
#         tmp  = Uaa(a,a1) * Uaa(a,a1)
#         tmpa += tmp
#      endpardo a,a1
#      execute server_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      if rank==0.0
#      t0 = 20.0
#      execute print_static EA_INIT_HAA t0
#      endif
#end_debug

      EXECUTE FORM_GUESS_R EA_INIT_HAA  VEC_AA
      EXECUTE FORM_GUESS_R EA_INIT_HBB  VEC_BB

      EXECUTE SIP_BARRIER
#
# Extract the first p vectors, where p is the number of requested
# roots

      EXECUTE EXTRACT_SUBSET VEC_AA  RVEC_AA_INTMD
      EXECUTE EXTRACT_SUBSET VEC_BB  RVEC_BB_INTMD

      ExECUTE SIP_BARRIER

      ENDPROC FORM_INITIAL_GUESS
#     --------------------------

      PROC PREP_EA_GUESS
#     ------------------

      COUNTER = 0
      DO NROOTS

         COUNTER += 1
         IF COUNTER == MYROOT
            DO a
               TaN(a,NROOTS) = RVEC_AA_INTMD(a,NROOTS)
               PUT INIT_RVEC_AA(a,NROOTS) = TaN(a,NROOTS)
            ENDDO a

            DO b
               TbN(b,NROOTS) = RVEC_BB_INTMD(b,NROOTS)
               PUT INIT_RVEC_BB(b,NROOTS) =  TbN(b,NROOTS)
            ENDDO b
         ENDIF 

      ENDDO NROOTS

      EXECUTE SIP_BARRIER

#bgn_debug
#      execute get_my_rank rank
#      if rank == 0.0
#      suma=0.0
#      tmpa=0.0
#      counter=0.0
#      do nroots
#         counter += 1.0
#         if counter == myroot
#         do a
#            GET  INIT_RVEC_AA(a,nroots)
#            Ta(a) = INIT_RVEC_AA(a,nroots)
#            tmp  = Ta(a) * Ta(a)
#            tmpa += tmp
#         enddo a
#         endif
#      enddo nroots
#      endif
#      execute print_scalar tmpa
#end_debug
      COUNTER = 0
      DO NROOTS

         COUNTER += 1
         IF COUNTER == MYROOT

            DO a
               GET INIT_RVEC_AA(a,nroots)
               Ta(a) = INIT_RVEC_AA(a,nroots)
               PUT R1a_guess(a) =  Ta(a)
            ENDDO a

            DO b
               GET INIT_RVEC_BB(b,nroots)
               Tb(b) = INIT_RVEC_BB(b,nroots)
               PUT R1b_guess(b) =  Tb(b)
            ENDDO b

          ENDIF

      ENDDO NROOTS

      EXECUTE SIP_BARRIER
#bgn_debug
#      tmpa = 0.0
#      do a
#         get R1a_guess(a)
#         Ta(a) = R1a_guess(a)
#         tmp  = Ta(a) * Ta(a)
#         tmpa += tmp
#      enddo a
#      execute print_scalar tmpa
#end_debug
#
      PARDO a, kk1

            Takk(a,kk1) = 0.0
            GET  R1a_guess(a)
            Ta(a) = R1a_guess(a)
            EXECUTE ADDROOTINDEX  Ta Takk
            PUT R1a_intmd(a,kk1) += Takk(a,kk1)

      ENDPARDO a, kk1

#bgn_debug
      execute sip_barrier
      tmpa = 0.0
      do kk1
      do a
         get R1a_intmd(a,kk1)
         Tax(a,kk1) = R1a_intmd(a,kk1)
         tmp  = Tax(a,kk1) * Tax(a,kk1)
         tmpa += tmp
      enddo a
      enddo kk1
      execute print_scalar tmpa
#end_debug

      PARDO b, kk1

            Tbkk(b,kk1) = 0.0
            GET  R1b_guess(b)
            Tb(b) = R1b_guess(b)
            EXECUTE ADDROOTINDEX  Tb Tbkk
            PUT R1b_Intmd(b,kk1) += Tbkk(b,kk1)

      ENDPARDO b, kk1

      PARDO a, a1, kk1, i
         Taxaa(a,kk1,a1,i) = 0.0
         PUT R2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j
         Tbxbb(b,kk1,b1,j) = 0.0
         PUT R2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)
      ENDPARDO b, b1, kk1, j

      PARDO a, kk1, b, j
         Taxbb(a,kk1,b,j) = 0.0
         PUT R2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)
      ENDPARDO a, kk1, b, j

      PARDO b, kk1, a, i 
         Tbxaa(b,kk1,a,i) = 0.0
         PUT R2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i) 
      ENDPARDO b, kk1, a, i

      EXECUTE SERVER_BARRIER

      SUMA = 0.0
      SUMB = 0.0
      TMPA = 0.0
      TMPB = 0.0
      PARDO a, kk1

            GET  R1a_intmd(a,kk1)
            Takk(a,kk1) = R1a_intmd(a,kk1)
            TMP   = Takk(a,kk1) * Takk(a,kk1)
            TMPA += TMP
      ENDPARDO a, kk1

      PARDO b, kk1

            GET  R1b_intmd(b,kk1)
            Tbkk(b,kk1) =  R1b_intmd(b,kk1)
            TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
            TMPB += TMP
      ENDPARDO b, kk1

      EXECUTE SIP_BARRIER
      COLLECTIVE  SUMA += TMPA
      COLLECTIVE  SUMB += TMPB
      EXECUTE SIP_BARRIER
      SUMAB  = SUMA
      SUMAB += SUMB

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB
      NORM_R = SUMAB

      PARDO a, kk1
            GET  R1a_intmd(a,kk1)
            Takk(a,kk1)  = R1a_intmd(a,kk1)
            Takk(a,kk1) *= INV_SQRT_NORM_R
            PUT R1a(a,kk1)  = Takk(a,kk1)
      ENDPARDO a, kk1

      PARDO b, kk1
            GET  R1b_intmd(b,kk1)
            Tbkk(b,kk1)  =  R1b_intmd(b,kk1)
            Tbkk(b,kk1) *= INV_SQRT_NORM_R
            PUT R1b(b,kk1) = Tbkk(b,kk1)
      ENDPARDO b, kk1
      EXECUTE SIP_BARRIER

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo a,kk1
#         get r1a(a,kk1)
#         Tmp = r1a(a,kk1) * r1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      pardo b,kk1
#         get r1b(b,kk1)
#         tmp = r1b(b,kk1) * r1b(b,kk1)
#         tmpb += tmp
#      endpardo b,kk1
#      execute server_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute sip_barrier
#      execute print_scalar suma
#      execute print_scalar sumb
#end_debug

      ENDPROC PREP_EA_GUESS
#     ---------------------

      PROC HR_MULT
#     ------------

      PARDO a
         DO kk1
            tax(a,kk1) = 0.0
            put HR1a(a,kk1) = tax(a,kk1)
         ENDDO kk1
      ENDPARDO a
#
      PARDO b
         DO kk1
            tbx(b,kk1) = 0.0
            put HR1b(b,kk1) = tbx(b,kk1)
         ENDDO kk1
      ENDPARDO b
#
      PARDO a, a1, i
         DO kk1
            taxaa(a,kk1,a1,i) = 0.0
            put HR2a_aa(a,kk1,a1,i)   = taxaa(a,kk1,a1,i)
         ENDDO kk1
      ENDPARDO a, a1, i
#
      PARDO a, b, j
         DO kk1
            taxbb(a,kk1,b,j) = 0.0
            put HR2a_bb(a,kk1,b,j) = taxbb(a,kk1,b,j)
         ENDDO kk1
      ENDPARDO a, b, j
#
      PARDO b, b1, j
         DO kk1
            tbxbb(b,kk1,b1,j) = 0.0
            put HR2b_bb(b,kk1,b1,j)   = tbxbb(b,kk1,b1,j)
         ENDDO kk1
      ENDPARDO b, b1, j
#
      PARDO b, a, i
         DO kk1
            tbxaa(b,kk1,a,i) = 0.0
            put HR2b_aa(b,kk1,a,i) = tbxaa(b,kk1,a,i)
         ENDDO kk1
      ENDPARDO b, a, i
#
      create Iix
      create Ijx
      execute sip_barrier

#
#     (HR)(a)
#     -------
#
      PARDO a, a1
            DO kk1
               GET          Uaa(a,a1)
               GET          R1a(a1,kk1)
               tax(a,kk1) = Uaa(a,a1)*R1a(a1,kk1)
               PUT HR1a(a,kk1) += tax(a,kk1)
            ENDDO kk1
      ENDPARDO a, a1

#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      execute sip_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
#
      PARDO a, i, a1
            DO kk1
               GET                R2a_aa(a,kk1,a1,i)
               GET                Uia(i,a1)
               tax(a,kk1)       = R2a_aa(a,kk1,a1,i)*Uia(i,a1)
               PUT HR1a(a,kk1) += tax(a,kk1)
            ENDDO kk1
      ENDPARDO a, i, a1

#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
#
      PARDO a, j, b
            DO kk1
               GET                R2a_bb(a,kk1,b,j)
               GET                Ujb(j,b)
               tax(a,kk1)       = R2a_bb(a,kk1,b,j)*Ujb(j,b)
               PUT HR1a(a,kk1) += tax(a,kk1)
            ENDDO kk1
      ENDPARDO a, j, b

#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
      PARDO a, a1, i, a2
            DO kk1
               REQUEST            Waiaa(a,a1,i,a2) a
               GET                R2a_aa(a1,kk1,a2,i)
               tax(a,kk1)       = Waiaa(a,a1,i,a2)*R2a_aa(a1,kk1,a2,i)
               tax(a,kk1)      *= 0.5
               PUT HR1a(a,kk1) += tax(a,kk1)
            ENDDO kk1
      ENDPARDO a, a1, i, a2

#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      execute sip_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
      PARDO a, a1, j, b
            DO kk1
               REQUEST            Waibb(a,a1,j,b) a
               GET                R2a_bb(a1,kk1,b,j)
               tax(a,kk1)       = Waibb(a,a1,j,b)*R2a_bb(a1,kk1,b,j)
               PUT HR1a(a,kk1) += tax(a,kk1)
            ENDDO kk1
      ENDPARDO a, a1, j, b

#bgn_debug
#      execute sip_barrier 
#      tmpa=0.0
#      suma=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
#
#     (HR)(b)
#     -------
#
      PARDO b, b1
            DO kk1
               GET          Ubb(b,b1)
               GET          R1b(b1,kk1)
              tbx(b,kk1) = Ubb(b,b1)*R1b(b1,kk1)
               PUT HR1b(b,kk1) += tbx(b,kk1)
            ENDDO kk1
      ENDPARDO b, b1
#bgn_debug
#      execute sip_barrier
#      tmpa=0.0
#      suma=0.0
#      pardo b,kk1
#         get hr1b(b,kk1)
#         tmp =  hr1b(b,kk1) *  hr1b(b,kk1)
#         tmpa += tmp
#      endpardo b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

#
      PARDO b, j, b1
            DO kk1
               GET                R2b_bb(b,kk1,b1,j)
               GET                Ujb(j,b1)
               tbx(b,kk1)       = R2b_bb(b,kk1,b1,j)*Ujb(j,b1)
               PUT HR1b(b,kk1) += tbx(b,kk1)
            ENDDO kk1
      ENDPARDO b, j, b1
#
      PARDO b, i, a
            DO kk1
               GET                R2b_aa(b,kk1,a,i)
               GET                Uia(i,a)
               tbx(b,kk1)       = R2b_aa(b,kk1,a,i)*Uia(i,a)
               PUT HR1b(b,kk1) += tbx(b,kk1)
            ENDDO kk1
      ENDPARDO b, i, a
#
      PARDO b, b1, j, b2
            DO kk1
               REQUEST            Wbjbb(b,b1,j,b2) b
               GET                R2b_bb(b1,kk1,b2,j)
               tbx(b,kk1)       = Wbjbb(b,b1,j,b2)*R2b_bb(b1,kk1,b2,j)
              tbx(b,kk1)      *= 0.5
               PUT HR1b(b,kk1) += tbx(b,kk1)
            ENDDO kk1
      ENDPARDO b, b1, j, b2

      PARDO b, b1, i, a
            DO kk1
               REQUEST            Wbjaa(b,b1,i,a) b
               GET                R2b_aa(b1,kk1,a,i)
               tbx(b,kk1)       = Wbjaa(b,b1,i,a)*R2b_aa(b1,kk1,a,i)
              PUT HR1b(b,kk1) += tbx(b,kk1)
            ENDDO kk1
      ENDPARDO b, b1, i, a
#
#     (HR)(a,ai)
#     ----------
#
      PARDO a, a1, a2, i
            DO kk1
               REQUEST                    Waaai(a,a2,a1,i) a
               GET                        R1a(a2,kk1)
               taxai(a,kk1,a1,i)        = Waaai(a,a2,a1,i)*R1a(a2,kk1)
               PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, a2, i

      PARDO a, a1, a2, i
            DO kk1
               GET                        R2a_aa(a2,kk1,a1,i)
               GET                        Uaa(a,a2)
               taxai(a,kk1,a1,i)        = R2a_aa(a2,kk1,a1,i)*Uaa(a,a2)
               PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, a2, i
#
      PARDO a, a1, a2, i
            DO kk1
               GET                        R2a_aa(a,kk1,a2,i)
               GET                        Uaa(a1,a2)
               taxai(a,kk1,a1,i)        = R2a_aa(a,kk1,a2,i)*Uaa(a1,a2)
               PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, a2, i
#
      PARDO a, a1, i1, i
            DO kk1
               GET                        R2a_aa(a,kk1,a1,i1)
               GET                        Uii(i1,i)
               taxai(a,kk1,a1,i)        = R2a_aa(a,kk1,a1,i1)*Uii(i1,i)
               taxai(a,kk1,a1,i)       *= -1.0
               PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, i1, i

      PARDO a1, i1, a2, i
            DO kk1
               REQUEST              Wiaai(i1,a2,a1,i) i1
               taiai(a2,i1,a1,i) =  Wiaai(i1,a2,a1,i)
               DO a
                  GET                        R2a_aa(a,kk1,a2,i1)
                  taxai(a,kk1,a1,i)        = R2a_aa(a,kk1,a2,i1)*taiai(a2,i1,a1,i)
                  PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)

                  t1axai(a1,kk1,a,i)       = taxai(a,kk1,a1,i)
                  t1axai(a1,kk1,a,i)      *= -1.0
                  PUT HR2a_aa(a1,kk1,a,i) += t1axai(a1,kk1,a,i)
               ENDDO a
            ENDDO kk1
      ENDPARDO a1, i1, a2, i
#
      PARDO a1, j1, b2, i
            DO kk1
               REQUEST              Wjbai(j1,b2,a1,i) j1
               tbjai(b2,j1,a1,i)  = Wjbai(j1,b2,a1,i)
               DO a
                  GET                        R2a_bb(a,kk1,b2,j1)
                  taxai(a,kk1,a1,i)        = R2a_bb(a,kk1,b2,j1)*tbjai(b2,j1,a1,i)
                  PUT HR2a_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)

                  t1axai(a1,kk1,a,i)       = taxai(a,kk1,a1,i)
                  t1axai(a1,kk1,a,i)      *= -1.0
                  PUT HR2a_aa(a1,kk1,a,i) += t1axai(a1,kk1,a,i)
               ENDDO a
            ENDDO kk1
      ENDPARDO a1, j1, b2, i
#
      PARDO i, i1, a, a1
            DO kk1
               REQUEST           VSpipi(a,i,a1,i1) a
               GET               R2a_aa(a,kk1,a1,i1)
               tix(i,kk1)      = VSpipi(a,i,a1,i1)*R2a_aa(a,kk1,a1,i1)
               tix(i,kk1)     *= 0.5
               PUT Iix(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, i1, a, a1

      PARDO i, j1, a, b1
            DO kk1
               REQUEST           Vpiqj(a,i,b1,j1) a
               GET               R2a_bb(a,kk1,b1,j1)
               tix(i,kk1)      = Vpiqj(a,i,b1,j1)*R2a_bb(a,kk1,b1,j1)
               PUT Iix(i,kk1) += tix(i,kk1)
            ENDDO kk1
      ENDPARDO i, j1, a, b1
#
      PARDO j, j1, b, b1
            DO kk1
               REQUEST           VSqjqj(b,j,b1,j1) b
               GET               R2b_bb(b,kk1,b1,j1)
               tjx(j,kk1)      = VSqjqj(b,j,b1,j1)*R2b_bb(b,kk1,b1,j1)
               tjx(j,kk1)     *= 0.5
               PUT Ijx(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, j1, b, b1
#
      PARDO j, i1, b, a1
            DO kk1
               REQUEST           Vpiqj(a1,i1,b,j) b
               GET               R2b_aa(b,kk1,a1,i1)
               tjx(j,kk1)      = Vpiqj(a1,i1,b,j)*R2b_aa(b,kk1,a1,i1)
               PUT Ijx(j,kk1) += tjx(j,kk1)
            ENDDO kk1
      ENDPARDO j, i1, b, a1
#
      execute sip_barrier
#
      PARDO a, a1, i1, i
            DO kk1
               REQUEST                    T2aa(a,i1,a1,i) a
               GET                        Iix(i1,kk1)
               taxaa(a,kk1,a1,i)        = T2aa(a,i1,a1,i)*Iix(i1,kk1)
               taxaa(a,kk1,a1,i)       *= -1.0
               PUT HR2a_aa(a,kk1,a1,i) += taxaa(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, i1, i
#
#     (HS)(b,bj)
#     ----------
#
      PARDO b, b1, b2, j
            DO kk1
               REQUEST                    Wbbbj(b,b2,b1,j) b
               GET                        R1b(b2,kk1)
               tbxbj(b,kk1,b1,j)        = Wbbbj(b,b2,b1,j)*R1b(b2,kk1)
               PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, b2, j
#
      PARDO b, b1, b2, j
            DO kk1
               GET                        R2b_bb(b2,kk1,b1,j)
               GET                        Ubb(b,b2)
               tbxbj(b,kk1,b1,j)        = R2b_bb(b2,kk1,b1,j)*Ubb(b,b2)
               PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, b2, j
#
      PARDO b, b1, b2, j
            DO kk1
               GET                        R2b_bb(b,kk1,b2,j)
               GET                        Ubb(b1,b2)
               tbxbj(b,kk1,b1,j)        = R2b_bb(b,kk1,b2,j)*Ubb(b1,b2)
               PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, b2, j
#
      PARDO b, b1, j1, j
            DO kk1
               GET                        R2b_bb(b,kk1,b1,j1)
               GET                        Ujj(j1,j)
               tbxbj(b,kk1,b1,j)        = R2b_bb(b,kk1,b1,j1)*Ujj(j1,j)
               tbxbj(b,kk1,b1,j)       *= -1.0
               PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, j1, j

      PARDO b1, j1, b2, j
            DO kk1
               REQUEST              Wjbbj(j1,b2,b1,j) j1
               tbjbj(b2,j1,b1,j) =  Wjbbj(j1,b2,b1,j)
               DO b
                  GET                        R2b_bb(b,kk1,b2,j1)
                  tbxbj(b,kk1,b1,j)        = R2b_bb(b,kk1,b2,j1)*tbjbj(b2,j1,b1,j)
                  PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)

                  t1bxbj(b1,kk1,b,j)       = tbxbj(b,kk1,b1,j)
                  t1bxbj(b1,kk1,b,j)      *= -1.0
                  PUT HR2b_bb(b1,kk1,b,j) += t1bxbj(b1,kk1,b,j)
               ENDDO b
            ENDDO kk1
      ENDPARDO b1, j1, b2, j
#
      PARDO b1, i1, a2, j
            DO kk1
               REQUEST              Wiabj(i1,a2,b1,j) i1
               taibj(a2,i1,b1,j)  = Wiabj(i1,a2,b1,j)
               DO b
                  GET                        R2b_aa(b,kk1,a2,i1)
                  tbxbj(b,kk1,b1,j)        = R2b_aa(b,kk1,a2,i1)*taibj(a2,i1,b1,j)
                  PUT HR2b_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)

                  t1bxbj(b1,kk1,b,j)       = tbxbj(b,kk1,b1,j)
                  t1bxbj(b1,kk1,b,j)      *= -1.0
                  PUT HR2b_bb(b1,kk1,b,j) += t1bxbj(b1,kk1,b,j)
               ENDDO b
            ENDDO kk1
      ENDPARDO b1, i1, a2, j
#
      PARDO b, b1, j1, j
            DO kk1
               REQUEST                    T2bb(b,j1,b1,j) b
               GET                        Ijx(j1,kk1)
               tbxbb(b,kk1,b1,j)        = T2bb(b,j1,b1,j)*Ijx(j1,kk1)
               tbxbb(b,kk1,b1,j)       *= -1.0
               PUT HR2b_bb(b,kk1,b1,j) += tbxbb(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, j1, j

#     (HS)(a,BJ)
#     ----------
#
      PARDO a, b, a1, j
            DO kk1
               REQUEST                   Waabj(a,a1,b,j) a
               GET                       R1a(a1,kk1)
               taxbb(a,kk1,b,j)        = Waabj(a,a1,b,j)*R1a(a1,kk1)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, a1, j
#
      PARDO a, b, a1, j
            DO kk1
               GET                       R2a_bb(a1,kk1,b,j)
               GET                       Uaa(a,a1)
               taxbb(a,kk1,b,j)        = R2a_bb(a1,kk1,b,j)*Uaa(a,a1)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, a1, j
#
      PARDO a, b1, j, b
            DO kk1
               GET                       R2a_bb(a,kk1,b1,j)
               GET                       Ubb(b,b1)
               taxbb(a,kk1,b,j)        = R2a_bb(a,kk1,b1,j)*Ubb(b,b1)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b1, j, b
#
      PARDO a, b, j1, j
            DO kk1
               GET                       R2a_bb(a,kk1,b,j1)
               GET                       Ujj(j1,j)
               taxbb(a,kk1,b,j)        = R2a_bb(a,kk1,b,j1)*Ujj(j1,j)
               taxbb(a,kk1,b,j)       *= -1.0
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, j1, j

      PARDO b1, j1, b, j
            REQUEST Wjbbj(j1,b1,b,j) j1
            DO a
            DO kk1
               GET                       R2a_bb(a,kk1,b1,j1)
               taxbb(a,kk1,b,j)        = R2a_bb(a,kk1,b1,j1)*Wjbbj(j1,b1,b,j)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
            ENDDO a
      ENDPARDO b1, j1, b, j
#
      PARDO a1, i1, b, j
            REQUEST Wiabj(i1,a1,b,j) i1
            DO a
            DO kk1
               GET                       R2a_aa(a,kk1,a1,i1)
               taxbb(a,kk1,b,j)        = R2a_aa(a,kk1,a1,i1)*Wiabj(i1,a1,b,j)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
            ENDDO a
      ENDPARDO a1, i1, b, j
#
      PARDO a, j1, a1, j
            REQUEST            Wjjaa(j1,j,a,a1) a
            tppqq(a,a1,j1,j) = Wjjaa(j1,j,a,a1)
            DO b
            DO kk1
               GET                       R2a_bb(a1,kk1,b,j1)
               taxbb(a,kk1,b,j)        = tppqq(a,a1,j1,j)*R2a_bb(a1,kk1,b,j1)
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
            ENDDO b
      ENDPARDO a, j1, a1, j
#
      PARDO a, b, i, j
            DO kk1
               REQUEST                   T2ab(a,i,b,j) a
               GET                       Iix(i,kk1)
               taxbb(a,kk1,b,j)        = T2ab(a,i,b,j)*Iix(i,kk1)
               taxbb(a,kk1,b,j)       *= -1.0
               PUT HR2a_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, i, j
#
#     (HS)(B,ai)
#     ----------
#
      PARDO b, a, b1, i
            DO kk1
               REQUEST                   Wbbai(b,b1,a,i) b
               GET                       R1b(b1,kk1)
               tbxaa(b,kk1,a,i)        = Wbbai(b,b1,a,i)*R1b(b1,kk1)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a, b1, i
#
      PARDO b, a, b1, i
            DO kk1
               GET                       R2b_aa(b1,kk1,a,i)
               GET                       Ubb(b,b1)
               tbxaa(b,kk1,a,i)        = R2b_aa(b1,kk1,a,i)*Ubb(b,b1)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a, b1, i
#
      PARDO b, a1, i, a
            DO kk1
               GET                       R2b_aa(b,kk1,a1,i)
               GET                       Uaa(a,a1)
               tbxaa(b,kk1,a,i)        = R2b_aa(b,kk1,a1,i)*Uaa(a,a1)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a1, i, a
#
      PARDO b, a, i1, i
            DO kk1
               GET                       R2b_aa(b,kk1,a,i1)
               GET                       Uii(i1,i)
               tbxaa(b,kk1,a,i)        = R2b_aa(b,kk1,a,i1)*Uii(i1,i)
               tbxaa(b,kk1,a,i)       *= -1.0
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a, i1, i
#
      PARDO a1, i1, a, i
            REQUEST Wiaai(i1,a1,a,i) i1
            DO b
            DO kk1
               GET                       R2b_aa(b,kk1,a1,i1)
               tbxaa(b,kk1,a,i)        = R2b_aa(b,kk1,a1,i1)*Wiaai(i1,a1,a,i)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
            ENDDO b
      ENDPARDO a1, i1, a, i
#
      PARDO b1, j1, a, i
            REQUEST Wjbai(j1,b1,a,i) j1
            DO b
            DO kk1
               GET                       R2b_bb(b,kk1,b1,j1)
               tbxaa(b,kk1,a,i)        = R2b_bb(b,kk1,b1,j1)*Wjbai(j1,b1,a,i)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
            ENDDO b
      ENDPARDO b1, j1, a, i
#
      PARDO b, i1, b1, i
            REQUEST            Wiibb(i1,i,b,b1) b
            tqqpp(b,b1,i1,i) = Wiibb(i1,i,b,b1)
            DO a
            DO kk1
               GET                       R2b_aa(b1,kk1,a,i1)
               tbxaa(b,kk1,a,i)        = tqqpp(b,b1,i1,i)*R2b_aa(b1,kk1,a,i1)
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
            ENDDO a
      ENDPARDO b, i1, b1, i
#
      PARDO a, b, i, j
            DO kk1
               REQUEST                   T2ab(a,i,b,j) a
               GET                       Ijx(j,kk1)
               tbxaa(b,kk1,a,i)        = T2ab(a,i,b,j)*Ijx(j,kk1)
               tbxaa(b,kk1,a,i)       *= -1.0
               PUT HR2b_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO a, b, i, j
#
# Direct contribution
# -------------------
#
#    Backtransform R2a_aa and R2a_bb
#    R2a_aa(a,kk1,a1,i) -> R2Xa_aa(mu,kk1,nu,i)
#    R2a_bb(a,kk1,b1,j) -> R2Xa_bb(mu,kk1,nu,j)
#    R2b_aa(b,kk1,a1,i) -> G2Xb_aa(mu,kk1,nu,i)
#    R2b_bb(b,kk1,b1,j) -> G2Xb_bb(mu,kk1,nu,j)
#    ------------------------------------------
#
     create S2x_aa
     create S2x_bb
     create G2x_aa
     create G2x_bb
     execute sip_barrier
#
     PARDO a, a1, i
           DO kk1
              GET                  R2a_aa(a,kk1,a1,i)
              GET                  R2a_aa(a1,kk1,a,i)
              taxai(a,kk1,a1,i)  = R2a_aa(a,kk1,a1,i)
              t1axai(a,kk1,a1,i) = R2a_aa(a1,kk1,a,i)
              taxai(a,kk1,a1,i) -= t1axai(a,kk1,a1,i)
              DO mu
                 tmxai(mu,kk1,a1,i)       = taxai(a,kk1,a1,i)*ca(mu,a)
                 PUT S2x_aa(mu,kk1,a1,i) += tmxai(mu,kk1,a1,i)
              ENDDO mu
           ENDDO kk1
     ENDPARDO a, a1, i
#
     PARDO a, b1, j
           DO kk1
              GET R2a_bb(a,kk1,b1,j)
              DO mu
                 tmxbj(mu,kk1,b1,j)       = R2a_bb(a,kk1,b1,j)*ca(mu,a)
                 PUT S2x_bb(mu,kk1,b1,j) += tmxbj(mu,kk1,b1,j)
              ENDDO mu
           ENDDO kk1
     ENDPARDO a, b1, j

     PARDO b, a1, i
           DO kk1
              GET R2b_aa(b,kk1,a1,i)
              DO mu
                 tmxai(mu,kk1,a1,i)       = R2b_aa(b,kk1,a1,i)*ca(mu,b)
                 PUT G2x_aa(mu,kk1,a1,i) += tmxai(mu,kk1,a1,i)
              ENDDO mu
           ENDDO kk1
     ENDPARDO b, a1, i
#
     PARDO b, b1, j
           DO kk1
              GET                  R2b_bb(b,kk1,b1,j)
              GET                  R2b_bb(b1,kk1,b,j)
              tbxbj(b,kk1,b1,j)  = R2b_bb(b,kk1,b1,j)
              t1bxbj(b,kk1,b1,j) = R2b_bb(b1,kk1,b,j)
              tbxbj(b,kk1,b1,j) -= t1bxbj(b,kk1,b1,j)
              DO mu
                 tmxbj(mu,kk1,b1,j)       = tbxbj(b,kk1,b1,j)*ca(mu,b)
                 PUT G2x_bb(mu,kk1,b1,j) += tmxbj(mu,kk1,b1,j)
              ENDDO mu
           ENDDO kk1
     ENDPARDO b, b1, j
#
     create S2x_xa
     create S2x_xb
     create G2x_xa
     create G2x_xb
     execute sip_barrier
#
     PARDO mu, a1, i
           DO kk1
              GET S2x_aa(mu,kk1,a1,i)
              DO nu
                 tmxmi(mu,kk1,nu,i)       = S2x_aa(mu,kk1,a1,i)*ca(nu,a1)
                 PUT S2x_xa(mu,kk1,nu,i) += tmxmi(mu,kk1,nu,i)
              ENDDO nu
           ENDDO kk1
     ENDPARDO mu, a1, i
#
     PARDO mu, b1, j
           DO kk1
              GET S2x_bb(mu,kk1,b1,j)
              DO nu
                 tmxmj(mu,kk1,nu,j)       = S2x_bb(mu,kk1,b1,j)*ca(nu,b1)
                 PUT S2x_xb(mu,kk1,nu,j) += tmxmj(mu,kk1,nu,j)
              ENDDO nu
           ENDDO kk1
     ENDPARDO mu, b1, j

     PARDO mu, a1, i
           DO kk1
              GET G2x_aa(mu,kk1,a1,i)
              DO nu
                 tmxmi(mu,kk1,nu,i)       = G2x_aa(mu,kk1,a1,i)*ca(nu,a1)
                 PUT G2x_xa(mu,kk1,nu,i) += tmxmi(mu,kk1,nu,i)
              ENDDO nu
           ENDDO kk1
     ENDPARDO mu, a1, i
#
     PARDO mu, b1, j
           DO kk1
              GET G2x_bb(mu,kk1,b1,j)
              DO nu
                 tmxmj(mu,kk1,nu,j)       = G2x_bb(mu,kk1,b1,j)*ca(nu,b1)
                 PUT G2x_xb(mu,kk1,nu,j) += tmxmj(mu,kk1,nu,j)
              ENDDO nu
           ENDDO kk1
     ENDPARDO mu, b1, j
#
     create CS2x_xa
     create CS2x_xb
     create CG2x_xa
     create CG2x_xb
     execute sip_barrier
     delete S2x_aa
     delete S2x_bb
     delete G2x_aa
     delete G2x_bb

# Contraction with integrals
#
     PARDO mu, nu, lambda, sigma
#
              compute_integrals aoint(mu,lambda,nu,sigma)
#
              DO i
              DO kk1
#
                 GET                         S2x_xa(lambda,kk1,sigma,i)
                 tmxmi(mu,kk1,nu,i)        = aoint(mu,lambda,nu,sigma)*S2x_xa(lambda,kk1,sigma,i)
                 PUT CS2x_xa(mu,kk1,nu,i) += tmxmi(mu,kk1,nu,i)
#
              ENDDO kk1
              ENDDO i
#
              DO j
              DO kk1
#
                 GET                         S2x_xb(lambda,kk1,sigma,j)
                 tmxmj(mu,kk1,nu,j)        = aoint(mu,lambda,nu,sigma)*S2x_xb(lambda,kk1,sigma,j)
                 PUT CS2x_xb(mu,kk1,nu,j) += tmxmj(mu,kk1,nu,j)
#
              ENDDO kk1
              ENDDO j
#
              DO i
              DO kk1
#
                 GET                         G2x_xa(lambda,kk1,sigma,i)
                 tmxmi(mu,kk1,nu,i)        = aoint(mu,lambda,nu,sigma)*G2x_xa(lambda,kk1,sigma,i)
                 PUT CG2x_xa(mu,kk1,nu,i) += tmxmi(mu,kk1,nu,i)
#
              ENDDO kk1
              ENDDO i
#
              DO j
              DO kk1
#
                 GET                         G2x_xb(lambda,kk1,sigma,j)
                 tmxmj(mu,kk1,nu,j)        = aoint(mu,lambda,nu,sigma)*G2x_xb(lambda,kk1,sigma,j)
                 PUT CG2x_xb(mu,kk1,nu,j) += tmxmj(mu,kk1,nu,j)
#
              ENDDO kk1
              ENDDO j
#
     ENDPARDO mu, nu, lambda, sigma
#
     create CS2x_aa
     create CS2x_bb
     create CG2x_aa
     create CG2x_bb
     execute sip_barrier
     delete S2x_xa
     delete S2x_xb
     delete G2x_xa
     delete G2x_xb
#
     PARDO mu, nu, i
           DO kk1
              GET CS2x_xa(mu,kk1,nu,i)
              DO a
                 tmxai(mu,kk1,a,i)        = CS2x_xa(mu,kk1,nu,i)*ca(nu,a)
                 PUT CS2x_aa(mu,kk1,a,i) += tmxai(mu,kk1,a,i)
              ENDDO a
           ENDDO kk1
     ENDPARDO mu, nu, i

     PARDO mu, nu, j
           DO kk1
              GET CS2x_xb(mu,kk1,nu,j)
              DO b
                 tmxbj(mu,kk1,b,j)        = CS2x_xb(mu,kk1,nu,j)*ca(nu,b)
                 PUT CS2x_bb(mu,kk1,b,j) += tmxbj(mu,kk1,b,j)
              ENDDO b
           ENDDO kk1
     ENDPARDO mu, nu, j
#
     PARDO mu, nu, i
           DO kk1
              GET CG2x_xa(mu,kk1,nu,i)
              DO a
                 tmxai(mu,kk1,a,i)        = CG2x_xa(mu,kk1,nu,i)*ca(nu,a)
                 PUT CG2x_aa(mu,kk1,a,i) += tmxai(mu,kk1,a,i)
              ENDDO a
           ENDDO kk1
     ENDPARDO mu, nu, i
#
     PARDO mu, nu, j
           DO kk1
              GET CG2x_xb(mu,kk1,nu,j)
              DO b
                 tmxbj(mu,kk1,b,j)        = CG2x_xb(mu,kk1,nu,j)*ca(nu,b)
                 PUT CG2x_bb(mu,kk1,b,j) += tmxbj(mu,kk1,b,j)
              ENDDO b
           ENDDO kk1
     ENDPARDO mu, nu, j
#
     execute sip_barrier
     delete CS2x_xa
     delete CS2x_xb
     delete CG2x_xa
     delete CG2x_xb

     PARDO mu, a, i
           DO kk1
              GET CS2x_aa(mu,kk1,a,i)
              DO a1 
                 taxai(a1,kk1,a,i)        = CS2x_aa(mu,kk1,a,i)*ca(mu,a1)
                 taxai(a1,kk1,a,i)       *= 0.5
                 PUT HR2a_aa(a1,kk1,a,i) += taxai(a1,kk1,a,i)
              ENDDO a1
           ENDDO kk1
     ENDPARDO mu, a, i
#
     PARDO mu, b, j
           DO kk1
              GET CS2x_bb(mu,kk1,b,j)
              DO a1 
                 taxbj(a1,kk1,b,j)        = CS2x_bb(mu,kk1,b,j)*ca(mu,a1)
                 PUT HR2a_bb(a1,kk1,b,j) += taxbj(a1,kk1,b,j)
              ENDDO a1
           ENDDO kk1
     ENDPARDO mu, b, j
#
     PARDO mu, a, i
           DO kk1
              GET CG2x_aa(mu,kk1,a,i)
              DO b1 
                 tbxai(b1,kk1,a,i)        = CG2x_aa(mu,kk1,a,i)*ca(mu,b1)
                 PUT HR2b_aa(b1,kk1,a,i) += tbxai(b1,kk1,a,i)
              ENDDO b1
           ENDDO kk1
     ENDPARDO mu, a, i
#
     PARDO mu, b, j
           DO kk1
              GET CG2x_bb(mu,kk1,b,j)
              DO b1 
                 tbxbj(b1,kk1,b,j)        = CG2x_bb(mu,kk1,b,j)*ca(mu,b1)
                 tbxbj(b1,kk1,b,j)       *= 0.5
                 PUT HR2b_bb(b1,kk1,b,j) += tbxbj(b1,kk1,b,j)
              ENDDO b1
           ENDDO kk1
     ENDPARDO mu, b, j
#
# Finish with W-V part
# --------------------
#
      create Xixii
      create Xjxjj
      create Xixjj
      create Xjxii
      execute sip_barrier
#
      PARDO a1, a3, i, i1
            REQUEST VSpipi(a1,i,a3,i1) i
            DO i2
            DO kk1
               GET                       R2a_aa(a1,kk1,a3,i2)
               tixii(i,kk1,i1,i2)      = R2a_aa(a1,kk1,a3,i2)*VSpipi(a1,i,a3,i1) 
               PUT Xixii(i,kk1,i1,i2) += tixii(i,kk1,i1,i2)
            ENDDO kk1
            ENDDO i2
      ENDPARDO a1, a3, i, i1
#
      PARDO b1, b3, j, j1
            REQUEST VSqjqj(b1,j,b3,j1) j
            DO j2
            DO kk1
               GET                       R2b_bb(b1,kk1,b3,j2)
               tjxjj(j,kk1,j1,j2)      = R2b_bb(b1,kk1,b3,j2)*VSqjqj(b1,j,b3,j1) 
               PUT Xjxjj(j,kk1,j1,j2) += tjxjj(j,kk1,j1,j2)
            ENDDO kk1
            ENDDO j2
      ENDPARDO b1, b3, j, j1

      PARDO a1, b3, i1, j1
            REQUEST              Vpiqj(a1,i1,b3,j1) a1
            tppqq(i1,a1,b3,j1) = Vpiqj(a1,i1,b3,j1)
            DO j
            DO kk1
               GET                       R2a_bb(a1,kk1,b3,j)
               tixjj(i1,kk1,j1,j)      = R2a_bb(a1,kk1,b3,j)*Vpiqj(a1,i1,b3,j1)  
               PUT Xixjj(i1,kk1,j1,j) += tixjj(i1,kk1,j1,j)
            ENDDO kk1
            ENDDO j
            tqqpp(b3,j1,a1,i1) = Vpiqj(a1,i1,b3,j1)
            DO i
            DO kk1
               GET                       R2b_aa(b3,kk1,a1,i)
               tjxii(j1,kk1,i1,i)      = R2b_aa(b3,kk1,a1,i)*tqqpp(b3,j1,a1,i1)  
               PUT Xjxii(j1,kk1,i1,i) += tjxii(j1,kk1,i1,i)
            ENDDO kk1
            ENDDO i
      ENDPARDO a1, b3, i1, j1
#
      execute sip_barrier

#
      PARDO a, a2, i, i1
#
            REQUEST               T2aa(a,i,a2,i1) i1
            GET                   t1a(a,i)
            GET                   t1a(a2,i1)
            GET                   t1a(a,i1)
            GET                   t1a(a2,i)
#
            tpp(a2,i1)          = t1a(a2,i1)
            t1pp(a2,i)          = t1a(a2,i)
#
            t1pppp(a,i,a2,i1)   = T2aa(a,i,a2,i1)
            t2pppp(a,i,a2,i1)   = t1a(a,i)^tpp(a2,i1)
            t3pppp(a,i,a2,i1)   = t1a(a,i1)^t1pp(a2,i)
            t1pppp(a,i,a2,i1)  += t2pppp(a,i,a2,i1)
            t1pppp(a,i,a2,i1)  -= t3pppp(a,i,a2,i1)
            t1pppp(a,i,a2,i1)  *= 0.25
#
            DO i2
            DO kk1
               GET                         Xixii(i,kk1,i1,i2)
               taxai(a,kk1,a2,i2)        = t1pppp(a,i,a2,i1)*Xixii(i,kk1,i1,i2)  
               PUT HR2a_aa(a,kk1,a2,i2) += taxai(a,kk1,a2,i2)
            ENDDO kk1
            ENDDO i2
#
      ENDPARDO a, a2, i, i1

      PARDO b, b2, j, j1
#
            REQUEST               T2bb(b,j,b2,j1) j1
            GET                   t1b(b,j)
            GET                   t1b(b2,j1)
            GET                   t1b(b,j1)
            GET                   t1b(b2,j)
#
            tqq(b2,j1)          = t1b(b2,j1)
            t1qq(b2,j)          = t1b(b2,j)
#
            t1qqqq(b,j,b2,j1)   = T2bb(b,j,b2,j1)
            t2qqqq(b,j,b2,j1)   = t1b(b,j)^tqq(b2,j1)
            t3qqqq(b,j,b2,j1)   = t1b(b,j1)^t1qq(b2,j)
            t1qqqq(b,j,b2,j1)  += t2qqqq(b,j,b2,j1)
            t1qqqq(b,j,b2,j1)  -= t3qqqq(b,j,b2,j1)
            t1qqqq(b,j,b2,j1)  *= 0.25
#
            DO j2
            DO kk1
               GET                         Xjxjj(j,kk1,j1,j2)
               tbxbj(b,kk1,b2,j2)        = t1qqqq(b,j,b2,j1)*Xjxjj(j,kk1,j1,j2) 
               PUT HR2b_bb(b,kk1,b2,j2) += tbxbj(b,kk1,b2,j2)
            ENDDO kk1
            ENDDO j2
#
      ENDPARDO b, b2, j, j1

      PARDO a, b2, i1, j1
#
            REQUEST               T2ab(a,i1,b2,j1) j1
            GET                   t1a(a,i1)
            GET                   t1b(b2,j1)
#
            t1ppqq(a,i1,b2,j1)   = T2ab(a,i1,b2,j1)
            t2ppqq(a,i1,b2,j1)   = t1a(a,i1)^t1b(b2,j1)
            t1ppqq(a,i1,b2,j1)  += t2ppqq(a,i1,b2,j1)
#
            tqpqp(j1,a,b2,i1) = t1ppqq(a,i1,b2,j1)
            DO j
            DO kk1
               GET                        Xixjj(i1,kk1,j1,j)
               taxbj(a,kk1,b2,j)        = t1ppqq(a,i1,b2,j1)*Xixjj(i1,kk1,j1,j)
               PUT HR2a_bb(a,kk1,b2,j) += taxbj(a,kk1,b2,j)
            ENDDO kk1
            ENDDO j
#
            tqppq(b2,i1,a,j1) = t1ppqq(a,i1,b2,j1)
            DO i
            DO kk1
               GET                        Xjxii(j1,kk1,i1,i)
               tbxai(b2,kk1,a,i)        = tqppq(b2,i1,a,j1)*Xjxii(j1,kk1,i1,i)
               PUT HR2b_aa(b2,kk1,a,i) += tbxai(b2,kk1,a,i)
            ENDDO kk1
            ENDDO i
#
      ENDPARDO a, b2, i1, j1

      PARDO a, a2, a1, a3
#
            tpppp(a,a1,a2,a3) = 0.0
#
            DO i
               REQUEST              VSaaai(a1,a,a3,i) i
               GET                  t1a(a2,i)
               t1pppp(a,a1,a2,a3) = VSaaai(a1,a,a3,i)*t1a(a2,i)
               tpppp(a,a1,a2,a3) -= t1pppp(a,a1,a2,a3)
            ENDDO i
#
            DO i
               REQUEST              VSaaai(a1,a2,a3,i) i
               GET                  t1a(a,i)
               t1pppp(a,a1,a2,a3) = VSaaai(a1,a2,a3,i)*t1a(a,i)
               tpppp(a,a1,a2,a3) += t1pppp(a,a1,a2,a3)
            ENDDO i
#
            DO i
            DO kk1
               GET                        R2a_aa(a1,kk1,a3,i)
               taxai(a,kk1,a2,i)        = tpppp(a,a1,a2,a3)*R2a_aa(a1,kk1,a3,i)
               taxai(a,kk1,a2,i)       *= 0.5
               PUT HR2a_aa(a,kk1,a2,i) += taxai(a,kk1,a2,i)
            ENDDO kk1
            ENDDO i
#
      ENDPARDO a, a2, a1, a3

      PARDO a, b2, a1, b3
#
            tppqq(a,a1,b2,b3) = 0.0
#
            DO j
               REQUEST              Vaabj(a1,a,b3,j) j
               GET                  t1b(b2,j)
               t1ppqq(a,a1,b2,b3) = Vaabj(a1,a,b3,j)*t1b(b2,j)
               tppqq(a,a1,b2,b3) -= t1ppqq(a,a1,b2,b3)
            ENDDO j
#
            DO i
               REQUEST              Vbbai(b3,b2,a1,i) i
               GET                  t1a(a,i)
               t1ppqq(a,a1,b2,b3) = Vbbai(b3,b2,a1,i)*t1a(a,i)
               tppqq(a,a1,b2,b3) -= t1ppqq(a,a1,b2,b3)
            ENDDO i
#
            DO j
            DO kk1
               GET                        R2a_bb(a1,kk1,b3,j)
               taxbj(a,kk1,b2,j)        = tppqq(a,a1,b2,b3)*R2a_bb(a1,kk1,b3,j)
               PUT HR2a_bb(a,kk1,b2,j) += taxbj(a,kk1,b2,j)
            ENDDO kk1
            ENDDO j
#
            DO i
            DO kk1
               GET                        R2b_aa(b3,kk1,a1,i)
               tbxai(b2,kk1,a,i)        = tppqq(a,a1,b2,b3)*R2b_aa(b3,kk1,a1,i)
               PUT HR2b_aa(b2,kk1,a,i) += tbxai(b2,kk1,a,i)
            ENDDO kk1
            ENDDO i
#
      ENDPARDO a, b2, a1, b3

      PARDO b, b2, b1, b3
#
            tqqqq(b,b1,b2,b3) = 0.0
#
            DO j
               REQUEST              VSbbbj(b1,b,b3,j) j
               GET                  t1b(b2,j)
               t1qqqq(b,b1,b2,b3) = VSbbbj(b1,b,b3,j)*t1b(b2,j)
               tqqqq(b,b1,b2,b3) -= t1qqqq(b,b1,b2,b3)
            ENDDO j
#
            DO j
               REQUEST              VSbbbj(b1,b2,b3,j) j
               GET                  t1b(b,j)
               t1qqqq(b,b1,b2,b3) = VSbbbj(b1,b2,b3,j)*t1b(b,j)
               tqqqq(b,b1,b2,b3) += t1qqqq(b,b1,b2,b3)
            ENDDO j
#
            DO j
            DO kk1
               GET                        R2b_bb(b1,kk1,b3,j)
               tbxbj(b,kk1,b2,j)        = tqqqq(b,b1,b2,b3)*R2b_bb(b1,kk1,b3,j)
               tbxbj(b,kk1,b2,j)       *= 0.5
               PUT HR2b_bb(b,kk1,b2,j) += tbxbj(b,kk1,b2,j)
            ENDDO kk1
            ENDDO j
#
      ENDPARDO b, b2, b1, b3
#
      execute sip_barrier
#
      delete Iix
      delete Ijx
      delete CS2x_aa
      delete CS2x_bb
      delete CG2x_aa
      delete CG2x_bb
#
      delete Xixii
      delete Xjxjj
      delete Xixjj
      delete Xjxii

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo a,kk1
#         get hr1a(a,kk1)
#         tmp =  hr1a(a,kk1) *  hr1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      pardo b,kk1
#         get hr1b(b,kk1)
#         tmp = hr1b(b,kk1) * hr1b(b,kk1)
#         tmpb += tmp
#      endpardo b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute print_scalar suma
#      execute print_scalar sumb
#      sumab  = suma
#      sumab += sumb
#      tmpa =0.0
#      suma =0.0
#      pardo a,a1,kk1,i
#            get  hR2a_aa(a,kk1,a1,i)
#            tmp = hR2a_aa(a,kk1,a1,i) * hR2a_aa(a,kk1,a1,i)
#            tmpa += tmp
#      endpardo a,a1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,b1,j, kk1
#            get  hR2b_bb(b,kk1,b1,j)
#            tmp = hR2b_bb(b,kk1,b1,j) * hR2b_bb(b,kk1,b1,j)
#            tmpa+= tmp
#      endpardo b,b1,j, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,b,j,kk1
#            get hR2a_bb(a,kk1,b,j)
#            tmp = hR2a_bb(a,kk1,b,j) * hR2a_bb(a,kk1,b,j)
#            tmpa+= tmp
#      endpardo a,b,j,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
