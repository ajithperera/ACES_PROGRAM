     PROC KEEP_GUESS_VECS
#    --------------------
      PARDO a, kk1
          GET  R1a(a,kk1)
          Takk(a,kk1)  = R1a(a,kk1)
          PUT INITIAL_R1A(a,kk1) = Takk(a,kk1)
      ENDPARDO a, kk1

      PARDO b, kk1
          GET  R1b(b,kk1)
          Tbkk(b,kk1)  =  R1b(b,kk1)
          PUT INITIAL_R1b(b,kk1) = Tbkk(b,kk1)
      ENDPARDO b, kk1

     EXECUTE SIP_BARRIER

     ENDPROC KEEP_GUESS_VECS
#    -----------------------

     PROC SELECT_VECS_MAX_OVLP1
#    --------------------------

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT >  ITER_COUNT
           EXIT
        ENDIF

        SUMA   = 0.0
        SUMB   = 0.0
        CY_A   = 0.0
        CY_B   = 0.0

        PARDO a, kk1

            GET INITIAL_R1A(a,kk1)
            GET Y1a(a,kk1,MINDEX50)

            Takk(a,kk1)  = INITIAL_R1A(a,kk1)
            T1akk(a,kk1) = Y1a(a,kk1,MINDEX50)

            TMP   =  Takk(a,kk1) * T1akk(a,kk1)
            SUMA +=  TMP

        ENDPARDO a, kk1

        PARDO b, kk1

              GET INITIAL_R1B(b,kk1)
              GET Y1b(b,kk1,MINDEX50)

              Tbkk(b,kk1)  = INITIAL_R1B(b,kk1)
              T1bkk(b,kk1) = Y1b(b,kk1,MINDEX50)

             TMP     =  Tbkk(b,kk1) * T1bkk(b,kk1)
             SUMB   +=  TMP

        ENDPARDO b, kk1

        EXECUTE SIP_BARRIER
        COLLECTIVE CY_A += SUMA
        COLLECTIVE CY_B += SUMB

        CY_AB  = CY_A
        CY_AB += CY_B

        KCOUNT = 0.0
        DO KINDEX50
           KCOUNT += 1.0

        IF KCOUNT == MCOUNT
           OVERLAP_R(MINDEX50) = CY_AB
        ENDIF
        ENDDO KINDEX50

     ENDDO  MINDEX50

     EXECUTE SIP_BARRIER
     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
     ELSE
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
     ENDIF

#bgn_debug
#     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP1
#    -----------------------------

     PROC SELECT_VECS_MAX_OVLP2
#    --------------------------

     IF PREVS_VEC == ONE
        FOLLOW = ITER_COUNT
        FOLLOW -= ONE
     ENDIF
#bgn_debug
#     execute print_scalar follow 
#end_debug 

     NCOUNT=0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT != FOLLOW
           EXIT
        ENDIF

         MCOUNT = 0.0
         DO MINDEX50
            MCOUNT += 1.0
            IF MCOUNT >  ITER_COUNT
               EXIT
            ENDIF

                 SUMA   = 0.0
                 SUMB   = 0.0
                 CY_A   = 0.0
                 CY_B   = 0.0

                 PARDO a, kk1

                       GET R1A_HIST(a,kk1,NINDEX50)
                       GET Y1a(a,kk1,MINDEX50)

                       Takk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
                       T1akk(a,kk1) = Y1a(a,kk1,MINDEX50)

                       TMP   =  Takk(a,kk1) * T1akk(a,kk1)
                       SUMA +=  TMP

                  ENDPARDO a, kk1

                  PARDO b, kk1

                       GET R1b_HIST(b,kk1,NINDEX50)
                       GET Y1b(b,kk1,MINDEX50)

                       Tbkk(b,kk1)  = R1b_HIST(b,kk1,NINDEX50)
                       T1bkk(b,kk1) = Y1b(b,kk1,MINDEX50)

                       TMP    =  Tbkk(b,kk1) * T1bkk(b,kk1)
                       SUMB   +=  TMP

                  ENDPARDO b, kk1

                  EXECUTE SIP_BARRIER 
                  COLLECTIVE CY_A += SUMA
                  COLLECTIVE CY_B += SUMB

                  CY_AB  = CY_A
                  CY_AB += CY_B

                  KCOUNT = 0.0
                  DO KINDEX50
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF

                  ENDDO KINDEX50

           ENDDO  MINDEX50

#        ENDIF

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
     ELSE
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
     ENDIF

#bgn_debug
#     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP2
#    -----------------------------

     PROC SELECT_VECS_MIN_ENEG
#    -------------------------

     IF ROOT_COUNT == ONE

# Always pick the closest eigenvalue to the starting eigenvalue 

        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS A_DIAGS 
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX 
        IF IMAX_KEEP ==  ZERO
           IMAX = ONE
        ENDIF 

      ELSE

# Find the root from the subspace that is not too close to the
# roots that have already been found.

        IF LOCK != ONE
           EXECUTE FIND_MIN_ENEG A_DIAGS PSEUDO_ROOTS
           EXECUTE SET_ACES3_VARS IMAX MONE
           IMAX_KEEP = IMAX
        ELSE
           EXECUTE SET_ACES3_VARS OMEGA THRTEN
           EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
           EXECUTE SET_ACES3_VARS IMAX MONE
           IMAX_KEEP = IMAX 
        ENDIF 
      ENDIF

#bgn_debug
#     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MIN_ENEG
#    ----------------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, kk1

                 GET Y1a(a,kk1,NINDEX50)
                 Takk(a,kk1) = Y1a(a,kk1,NINDEX50)
                 PUT Y1a_PICKED(a,kk1) = Takk(a,kk1)

           ENDPARDO a, kk1
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, kk1

                 GET Y1b(b,kk1,NINDEX50)
                 Tbkk(b,kk1) = Y1b(b,kk1,NINDEX50)
                 PUT Y1b_PICKED(b,kk1) = Tbkk(b,kk1)

           ENDPARDO b, kk1
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, a1, kk1, i

                 REQUEST Y2a_aa(a,kk1,a1,i,NINDEX50) i
                 Taxaa(a,kk1,a1,i) = Y2a_aa(a,kk1,a1,i,NINDEX50)
                 PUT Y2a_aa_picked(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

           ENDPARDO a, a1, kk1, i

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, b1, kk1, j

                 REQUEST Y2b_bb(b,kk1,b1,j,NINDEX50) j
                 Tbxbb(b,kk1,b1,j) = Y2b_bb(b,kk1,b1,j,NINDEX50)
                 PUT Y2b_bb_picked(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

           ENDPARDO b, b1, kk1, j

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, kk1, j

                 REQUEST Y2a_bb(a,kk1,b,j,NINDEX50) j
                 Taxbb(a,kk1,b,j) = Y2a_bb(a,kk1,b,j,NINDEX50)
                 PUT Y2a_bb_picked(a,kk1,b,j) = Taxbb(a,kk1,b,j)

           ENDPARDO a, b, kk1, j

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, a, kk1, i

                 REQUEST Y2b_aa(b,kk1,a,i,NINDEX50) i
                 Tbxaa(b,kk1,a,i) = Y2b_aa(b,kk1,a,i,NINDEX50)
                 PUT Y2b_aa_picked(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

           ENDPARDO b, a, kk1, i

        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
