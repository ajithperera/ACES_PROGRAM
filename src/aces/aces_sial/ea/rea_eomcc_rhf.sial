     PROC SELECT_HBAR_Y_VEC_TOGO
#    ---------------------------
     PARDO kk1, a
         GET Y1a_PICKED(a,kk1)
         Takk(a,kk1) = Y1a_PICKED(a,kk1)
         PUT R1a(a,kk1) =  Takk(a,kk1)
     ENDPARDO kk1, a

     PARDO kk1, b
         GET Y1b_PICKED(b,kk1)
         Tbkk(b,kk1) = Y1b_PICKED(b,kk1)
         PUT R1b(b,kk1) =  Tbkk(b,kk1)
     ENDPARDO kk1, b

     PARDO a, a1, kk1, i
         GET Y2a_aa_picked(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) = Y2a_aa_picked(a,kk1,a1,i)
         PUT R2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
     ENDPARDO a, a1, kk1, i

     PARdO b, b1, kk1, j
         GET Y2b_bb_picked(b,kk1,b1,j)
         Tbxbb(b,kk1,b1,j) = Y2b_bb_picked(b,kk1,b1,j)
         PUT R2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
         GET Y2a_bb_picked(a,kk1,b,j)
         Taxbb(a,kk1,b,j) = Y2a_bb_picked(a,kk1,b,j)
         PUT R2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)
     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i
         GET Y2b_aa_picked(b,kk1,a,i)
         Tbxaa(b,kk1,a,i) =  Y2b_aa_picked(b,kk1,a,i)
         PUT R2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)
     ENDPARDO b, a, kk1, i

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, kk1

                 GET HY1a(a,kk1,NINDEX50)
                 Takk(a,kk1) = HY1a(a,kk1,NINDEX50)
                 PUT HY1a_PICKED(a,kk1) = Takk(a,kk1)

           ENDPARDO a, kk1
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, kk1

                 GET HY1b(b,kk1,NINDEX50)
                 Tbkk(b,kk1) = HY1b(b,kk1,NINDEX50)
                 PUT HY1b_PICKED(b,kk1) = Tbkk(b,kk1)

           ENDPARDO b, kk1
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, a1, kk1, i

                 REQUEST HY2a_aa(a,kk1,a1,i,NINDEX50) i
                 Taxaa(a,kk1,a1,i) = HY2a_aa(a,kk1,a1,i,NINDEX50)
                 PUT HY2a_aa_picked(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

           ENDPARDO a, a1, kk1, i

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, b1, kk1, j

                 REQUEST HY2b_bb(b,kk1,b1,j,NINDEX50) j
                 Tbxbb(b,kk1,b1,j) = HY2b_bb(b,kk1,b1,j,NINDEX50)
                 PUT HY2b_bb_picked(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

           ENDPARDO b, b1, kk1, j

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO a, b, kk1, j

                 REQUEST HY2a_bb(a,kk1,b,j,NINDEX50) j
                 Taxbb(a,kk1,b,j) = HY2a_bb(a,kk1,b,j,NINDEX50)
                 PUT HY2a_bb_picked(a,kk1,b,j) = Taxbb(a,kk1,b,j)

           ENDPARDO a, b, kk1, j

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO b, a, kk1, i

                 REQUEST HY2b_aa(b,kk1,a,i,NINDEX50) i
                 Tbxaa(b,kk1,a,i) = HY2b_aa(b,kk1,a,i,NINDEX50)
                 PUT HY2b_aa_picked(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

           ENDPARDO b, a, kk1, i

        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC SELECT_HBAR_Y_VEC_TOGO
#    ------------------------------

     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO kk1, a
         GET Y1a_PICKED(a,kk1)
         Takk(a,kk1) = Y1a_PICKED(a,kk1)
         PUT R1a(a,kk1) =  Takk(a,kk1)
      ENDPARDO kk1, a

      PARDO kk1, b
         GET Y1b_PICKED(b,kk1)
         Tbkk(b,kk1) = Y1b_PICKED(b,kk1)
         PUT R1b(b,kk1) =  Tbkk(b,kk1)
      ENDPARDO kk1, b

      PARDO a, a1, kk1, i
         GET Y2a_aa_picked(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) = Y2a_aa_picked(a,kk1,a1,i)
         PUT R2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
      ENDPARDO a, a1, kk1, i

      PARdO b, b1, kk1, j
         GET Y2b_bb_picked(b,kk1,b1,j)
         Tbxbb(b,kk1,b1,j) = Y2b_bb_picked(b,kk1,b1,j)
         PUT R2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)
      ENDPARDO b, b1, kk1, j

      PARDO a, b, kk1, j
         GET Y2a_bb_picked(a,kk1,b,j)
         Taxbb(a,kk1,b,j) = Y2a_bb_picked(a,kk1,b,j)
         PUT R2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)
      ENDPARDO a, b, kk1, j

      PARDO b, a, kk1, i
         GET Y2b_aa_picked(b,kk1,a,i)
         Tbxaa(b,kk1,a,i) =  Y2b_aa_picked(b,kk1,a,i)
         PUT R2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)
      ENDPARDO b, a, kk1, i

      EXECUTE SIP_BARRIER

      CALL HR_MULT

      PARDO kk1, a
            GET HR1a(a,kk1)
            Takk(a,kk1) = HR1a(a,kk1)
            PUT HY1a_picked(a,kk1) =  Takk(a,kk1)
      ENDPARDO kk1,a

      PARDO kk1, b
            GET HR1b(b,kk1)
            Tbkk(b,kk1) = HR1b(b,kk1)
            PUT HY1b_picked(b,kk1) =  Tbkk(b,kk1)
      ENDPARDO kk1, b

      PARDO a, a1, kk1, i
         GET HR2a_aa(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) = HR2a_aa(a,kk1,a1,i)
         PUT HY2a_aa_picked(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j
         GET HR2b_bb(b,kk1,b1,j)
         Tbxbb(b,kk1,b1,j) =  HR2b_bb(b,kk1,b1,j)
         PUT HY2b_bb_picked(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)
      ENDPARDO b, b1, kk1, j

      PARDO a,b,kk1,j
         GET HR2a_bb(a,kk1,b,j)
         Taxbb(a,kk1,b,j) = HR2a_bb(a,kk1,b,j)
         PUT HY2a_bb_picked(a,kk1,b,j) = Taxbb(a,kk1,b,j)
      ENDPARDO a, b, kk1, j

      PARDO b, a, kk1, i
         GET HR2b_aa(b,kk1,a,i)
         Tbxaa(b,kk1,a,i) =  HR2b_aa(b,kk1,a,i)
         PUT HY2b_aa_picked(b,kk1,a,i) = Tbxaa(b,kk1,a,i)
      ENDPARDO b, a, kk1, i

      EXECUTE SIP_BARRIER

#bgn_debug
