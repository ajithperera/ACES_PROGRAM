    PROC MAKE_ORTHO_COEFS
#    ---------------------

     DO MINDEX50
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE SIP_BARRIER

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

           PARDO a, kk1

                 GET R1A_HIST(a,kk1,NINDEX50)
                 GET CORR_VECa(a,kk1)

                 Takk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
                 T1akk(a,kk1) = CORR_VECa(a,kk1)
                 TMP          = Takk(a,kk1) *  T1akk(a,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO a, kk1

           PARDO b, kk1

                 GET R1B_HIST(b,kk1,NINDEX50)
                 GET CORR_VECb(b,kk1)

                 Tbkk(b,kk1)  = R1B_HIST(b,kk1,NINDEX50)
                 T1bkk(b,kk1) = CORR_VECb(b,kk1)
                 TMP          = Tbkk(b,kk1) *  T1bkk(b,kk1)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO b, kk1

           PARDO a, a1, kk1, i

                 REQUEST R2a_aa_HIST(a,kk1,a1,i,NINDEX50) i
                 GET CORR_VECa_aa(a,kk1,a1,i)

                 Taxaa(a,kk1,a1,i)  = R2a_aa_HIST(a,kk1,a1,i,NINDEX50)
                 T1axaa(a,kk1,a1,i) = CORR_VECa_aa(a,kk1,a1,i)

                 TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO a, a1, kk1, i

           PARDO b, b1, kk1, j

                 REQUEST R2b_bb_HIST(b,kk1,b1,j,NINDEX50) j
                 GET CORR_VECb_bb(b,kk1,b1,j)

                 Tbxbb(b,kk1,b1,j)  = R2b_bb_HIST(b,kk1,b1,j,NINDEX50)
                 T1bxbb(b,kk1,b1,j) = CORR_VECb_bb(b,kk1,b1,j)

                 TMP     = Tbxbb(b,kk1,b1,j) *  T1bxbb(b,kk1,b1,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO b, b1, kk1, j

           PARDO a, b, kk1, j

                 REQUEST R2a_bb_HIST(a,kk1,b,j,NINDEX50) j
                 GET CORR_VECa_bb(a,kk1,b,j)

                 Taxbb(a,kk1,b,j)  = R2a_bb_HIST(a,kk1,b,j,NINDEX50)
                 T1axbb(a,kk1,b,j) = CORR_VECa_bb(a,kk1,b,j)

                 TMP     = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO a, b, kk1, j

           PARDO b, a, kk1, i

                 REQUEST R2b_aa_HIST(b,kk1,a,i,NINDEX50) i
                 GET CORR_VECb_aa(b,kk1,a,i)

                 Tbxaa(b,kk1,a,i)  = R2b_aa_HIST(b,kk1,a,i,NINDEX50)
                 T1bxaa(b,kk1,a,i) = CORR_VECb_aa(b,kk1,a,i)

                 TMP   = Tbxaa(b,kk1,a,i) * T1bxaa(b,kk1,a,i)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50)

           ENDPARDO b, a, kk1, i

#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------


     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     C_A    = 0.0
     C_B    = 0.0
     C_AAA  = 0.0
     C_BBB  = 0.0
     C_AAB  = 0.0
     C_BBA  = 0.0

     PARDO a, kk1
           GET CORR_VECa(a,kk1)
           Takk(a,kk1)   = CORR_VECa(a,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
 
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              GET R1A_HIST(a,kk1,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1akk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1akk(a,kk1) *= FACT
              T1akk(a,kk1) *= -1.0
              Takk(a,kk1)  += T1akk(a,kk1)

           ENDDO NINDEX50

           PUT R1a_INTMD(a,kk1) = Takk(a,kk1)

           TMP    = Takk(a,kk1) * Takk(a,kk1)
           SUMA  += TMP

     ENDPARDO a, kk1

     PARDO b, kk1
          GET CORR_VECb(b,kk1)
          Tbkk(b,kk1)  = CORR_VECb(b,kk1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             GET R1B_HIST(b,kk1,NINDEX50)
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bkk(b,kk1) = R1B_HIST(b,kk1,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1bkk(b,kk1) *= FACT
             T1bkk(b,kk1) *= -1.0
             Tbkk(b,kk1)  += T1bkk(b,kk1)

          ENDDO NINDEX50

          PUT R1b_INTMD(b,kk1) = Tbkk(b,kk1)

          TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
          SUMB += TMP

     ENDPARDO b, kk1

     PARDO a, a1, kk1, i
          GET CORR_VECa_aa(a,kk1,a1,i)
          Taxaa(a,kk1,a1,i)  = CORR_VECa_aa(a,kk1,a1,i)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST R2a_aa_HIST(a,kk1,a1,i,NINDEX50) i
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1axaa(a,kk1,a1,i) = R2a_aa_HIST(a,kk1,a1,i,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1axaa(a,kk1,a1,i)  *= FACT
             T1axaa(a,kk1,a1,i)  *= -1.0
             Taxaa(a,kk1,a1,i)   += T1axaa(a,kk1,a1,i)

           ENDDO NINDEX50

           PUT R2a_aa_intmd(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

           TMP  =  Taxaa(a,kk1,a1,i) *  Taxaa(a,kk1,a1,i)
           SUMAAA  += TMP

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           GET CORR_VECb_bb(b,kk1,b1,j)
           Tbxbb(b,kk1,b1,j)  = CORR_VECb_bb(b,kk1,b1,j)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST R2b_bb_HIST(b,kk1,b1,j,NINDEX50) j
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bxbb(b,kk1,b1,j) = R2b_bb_HIST(b,kk1,b1,j,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1bxbb(b,kk1,b1,j) *= FACT
             T1bxbb(b,kk1,b1,j) *= -1.0
             Tbxbb(b,kk1,b1,j) += T1bxbb(b,kk1,b1,j)

           ENDDO NINDEX50

          PUT R2b_bb_intmd(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

          TMP = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
          SUMBBB += TMP

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
           GET CORR_VECa_bb(a,kk1,b,j)
           Taxbb(a,kk1,b,j)  = CORR_VECa_bb(a,kk1,b,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              REQUEST R2a_bb_HIST(a,kk1,b,j,NINDEX50) j
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1axbb(a,kk1,b,j) = R2a_bb_HIST(a,kk1,b,j,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1axbb(a,kk1,b,j) *= FACT
              T1axbb(a,kk1,b,j) *= -1.0
              Taxbb(a,kk1,b,j)  += T1axbb(a,kk1,b,j)

          ENDDO NINDEX50

          PUT R2a_bb_intmd(a,kk1,b,j) = Taxbb(a,kk1,b,j)

          TMP =  Taxbb(a,kk1,b,j) *  Taxbb(a,kk1,b,j)
          SUMAAB += TMP

     ENDPARDO  a, b, kk1, j

     PARDO b, a, kk1, i
           GET CORR_VECb_aa(b,kk1,a,i)
           Tbxaa(b,kk1,a,i)  = CORR_VECb_aa(b,kk1,a,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST R2b_aa_HIST(b,kk1,a,i,NINDEX50) i
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bxaa(b,kk1,a,i) = R2b_aa_HIST(b,kk1,a,i,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL Txx FACT

             T1bxaa(b,kk1,a,i) *= FACT
             T1bxaa(b,kk1,a,i) *= -1.0
             Tbxaa(b,kk1,a,i)  += T1bxaa(b,kk1,a,i)

          ENDDO NINDEX50

          PUT R2b_aa_intmd(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

          TMP = Tbxaa(b,kk1,a,i) * Tbxaa(b,kk1,a,i)
          SUMBBA += TMP

     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_A   += SUMA
     COLLECTIVE   C_B   += SUMB
     COLLECTIVE   C_AAA += SUMAAA
     COLLECTIVE   C_BBB += SUMBBB
     COLLECTIVE   C_AAB += SUMAAB
     COLLECTIVE   C_BBA += SUMBBA

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_B
     NORM_NEW_ORTGC += C_AAA
     NORM_NEW_ORTGC += C_BBB
     NORM_NEW_ORTGC += C_AAB
     NORM_NEW_ORTGC += C_BBA

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------

     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0

     PARDO a, kk1

            GET  R1a_intmd(a,kk1)
            Takk(a,kk1) = R1a_intmd(a,kk1)
            TMP   = Takk(a,kk1) * Takk(a,kk1)
            HC_A += TMP

      ENDPARDO a, kk1

      PARDO b, kk1

            GET  R1b_intmd(b,kk1)
            Tbkk(b,kk1) =  R1b_intmd(b,kk1)
            TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
            HC_B += TMP

      ENDPARDO b, kk1

      PARDO a, a1, kk1, i

              GET R2a_aa_intmd(a,kk1,a1,i)
              Taxaa(a,kk1,a1,i) = R2a_aa_intmd(a,kk1,a1,i)

              TMP   = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
              HC_AAA += TMP

      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j

              GET R2b_bb_intmd(b,kk1,b1,j)
              Tbxbb(b,kk1,b1,j) = R2b_bb_intmd(b,kk1,b1,j)

              TMP   = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
              HC_BBB +=  TMP

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

              GET R2a_bb_intmd(a,kk1,b,j)
              Taxbb(a,kk1,b,j) = R2a_bb_intmd(a,kk1,b,j)

              TMP   = Taxbb(a,kk1,b,j) * Taxbb(a,kk1,b,j)
              HC_AAB +=  TMP

     ENDPARDO a, b, kk1, j

     PARDO b, kk1, a, i

              GET R2b_aa_intmd(b,kk1,a,i)
              Tbxaa(b,kk1,a,i) = R2b_aa_intmd(b,kk1,a,i)

              TMP = Tbxaa(b,kk1,a,i) * Tbxaa(b,kk1,a,i)
              HC_BBA +=  TMP

     ENDPARDO b, kk1, a, i

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT

     EXECUTE SIP_BARRIER
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#end_debug

     DO kk1
        DO a
           GET R1a_intmd(a,kk1)

           Takk(a,kk1)  = R1a_intmd(a,kk1)
           Takk(a,kk1) *= INV_SQRT_NORM_ORTGC

           PUT R1a(a,kk1) =  Takk(a,kk1)

         ENDDO a
     ENDDO kk1

     DO kk1
         DO b
            GET R1b_intmd(b,kk1)

            Tbkk(b,kk1)  = R1b_intmd(b,kk1)
            Tbkk(b,kk1) *= INV_SQRT_NORM_ORTGC

            PUT R1b(b,kk1) =  Tbkk(b,kk1)

         ENDDO b
     ENDDO kk1

    PARDO a, a1, kk1, i

         GET R2a_aa_intmd(a,kk1,a1,i)

         Taxaa(a,kk1,a1,i)  = R2a_aa_intmd(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i) *= INV_SQRT_NORM_ORTGC

         PUT R2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

         GET R2b_bb_intmd(b,kk1,b1,j)

         Tbxbb(b,kk1,b1,j)  = R2b_bb_intmd(b,kk1,b1,j)
         Tbxbb(b,kk1,b1,j) *= INV_SQRT_NORM_ORTGC

         PUT R2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

        GET R2a_bb_intmd(a,kk1,b,j)

        Taxbb(a,kk1,b,j)  =  R2a_bb_intmd(a,kk1,b,j)
        Taxbb(a,kk1,b,j) *= INV_SQRT_NORM_ORTGC

        PUT R2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)

     ENDPARDO a, b, kk1, j

     PARDO b, kk1, a, i

        GET R2b_aa_intmd(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)  = R2b_aa_intmd(b,kk1,a,i)
        Tbxaa(b,kk1,a,i) *= INV_SQRT_NORM_ORTGC

        PUT R2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

     ENDPARDO b, kk1, a, i

     EXECUTE SIP_BARRIER

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo a,kk1
#         get r1a(a,kk1)
#         tmp =  r1a(a,kk1) *  r1a(a,kk1)
#         tmpa += tmp
#      endpardo a,kk1
#      pardo b,kk1
#         get r1b(b,kk1)
#         tmp = r1b(b,kk1) * r1b(b,kk1)
#         tmpb += tmp
#      endpardo b,kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute print_scalar suma
#      execute print_scalar sumb
#      sumab  = suma
#      sumab += sumb
#      tmpa =0.0
#      suma =0.0
