#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,b1,j, kk1
#            get Rb_bb(b,kk1,b1,j)
#            tmp = Rb_bb(b,kk1,b1,j) * Rb_bb(b,kk1,b1,j)
#            tmpa+= tmp
#      endpardo b,b1,j, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
