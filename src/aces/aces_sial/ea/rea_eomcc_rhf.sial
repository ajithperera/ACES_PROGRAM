     PROC FORM_NEWVECS
#    -----------------

    PARDO a, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1A_HIST(a,kk1,MINDEX50)
                       Taxs(a,kk1,MINDEX50)  = R1A_HIST(a,kk1,MINDEX50)
                       T1axs(a,kk1,NINDEX50) = Taxs(a,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A(a,kk1,NINDEX50) += T1axs(a,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, kk1

     PARDO b, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       GET R1B_HIST(b,kk1,MINDEX50)
                       Tbxs(b,kk1,MINDEX50)  = R1B_HIST(b,kk1,MINDEX50)
                       T1bxs(b,kk1,NINDEX50) = Tbxs(b,kk1,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B(b,kk1,NINDEX50) += T1bxs(b,kk1,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO  b, kk1

     PARDO a, a1, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2a_aa_HIST(a,kk1,a1,i,MINDEX50)  i

                       Taxaas(a,kk1,a1,i,MINDEX50) = R2a_aa_HIST(a,kk1,a1,i,MINDEX50)
                       T1axaas(a,kk1,a1,i,NINDEX50) = Taxaas(a,kk1,a1,i,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2a_aa(a,kk1,a1,i,NINDEX50) += T1axaas(a,kk1,a1,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2b_bb_HIST(b,kk1,b1,j,MINDEX50)  j

                       Tbxbbs(b,kk1,b1,j,MINDEX50) = R2b_bb_HIST(b,kk1,b1,j,MINDEX50)
                       T1bxbbs(b,kk1,b1,j,NINDEX50) = Tbxbbs(b,kk1,b1,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_bb(b,kk1,b1,j,NINDEX50) += T1bxbbs(b,kk1,b1,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2a_bb_HIST(a,kk1,b,j,MINDEX50) j

                       Taxbbs(a,kk1,b,j,MINDEX50) = R2a_bb_HIST(a,kk1,b,j,MINDEX50)
                       T1axbbs(a,kk1,b,j,NINDEX50) = Taxbbs(a,kk1,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2a_bb(a,kk1,b,j,NINDEX50) += T1axbbs(a,kk1,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2b_aa_HIST(b,kk1,a,i,MINDEX50) i

                       Tbxaas(b,kk1,a,i,MINDEX50) = R2b_aa_HIST(b,kk1,a,i,MINDEX50)
                       T1bxaas(b,kk1,a,i,NINDEX50) = Tbxaas(b,kk1,a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2b_aa(b,kk1,a,i,NINDEX50) += T1bxaas(b,kk1,a,i,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER

