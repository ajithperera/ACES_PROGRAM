     PROC FORM_RESIDUAL_VEC
#    ----------------------

      EXECUTE RETURN_SELECTED A_DIAGS IMAX
      OMEGA   = IMAX
      OMEGAM  = OMEGA
      OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug

     DO kk1
        DO a
           GET HY1a_picked(a,kk1)
           GET Y1a_picked(a,kk1)

           Takk(a,kk1)   = HY1a_picked(a,kk1)
           T1akk(a,kk1)  = Y1a_picked(a,kk1)
           T1akk(a,kk1) *= Omegam
           Takk(a,kk1)  +=  T1akk(a,kk1)
           PUT RES1a(a,kk1) =  Takk(a,kk1)
         ENDDO a
     ENDDO kk1

     DO kk1
         DO b
            GET HY1b_picked(b,kk1)
            GET Y1b_picked(b,kk1)
            Tbkk(b,kk1)   = HY1b_picked(b,kk1)
            T1bkk(b,kk1)  = Y1b_picked(b,kk1)
            T1bkk(b,kk1) *= Omegam
            Tbkk(b,kk1)  += T1bkk(b,kk1)
            PUT RES1b(b,kk1) =  Tbkk(b,kk1)
         ENDDO b
     ENDDO kk1

     PARDO a, a1, kk1, i

         GET HY2a_aa_picked(a,kk1,a1,i)
         GET Y2a_aa_picked(a,kk1,a1,i)
         Taxaa(a,kk1,a1,i)   = HY2a_aa_picked(a,kk1,a1,i)
         T1axaa(a,kk1,a1,i)  = Y2a_aa_picked(a,kk1,a1,i)
         T1axaa(a,kk1,a1,i) *= Omegam
         Taxaa(a,kk1,a1,i)  += T1axaa(a,kk1,a1,i)
         PUT RES2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

         GET HY2b_bb_picked(b,kk1,b1,j)
         GET Y2b_bb_picked(b,kk1,b1,j)
         Tbxbb(b,kk1,b1,j)   = HY2b_bb_picked(b,kk1,b1,j)
         T1bxbb(b,kk1,b1,j) = Y2b_bb_picked(b,kk1,b1,j)
         T1bxbb(b,kk1,b1,j) *= Omegam
         Tbxbb(b,kk1,b1,j)  += T1bxbb(b,kk1,b1,j)
         PUT RES2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a,b,kk1,j
        GET HY2a_bb_picked(a,kk1,b,j)
        GET Y2a_bb_picked(a,kk1,b,j)

        Taxbb(a,kk1,b,j)   = HY2a_bb_picked(a,kk1,b,j)
        T1axbb(a,kk1,b,j)  = Y2a_bb_picked(a,kk1,b,j)
        T1axbb(a,kk1,b,j) *= Omegam
        Taxbb(a,kk1,b,j)  += T1axbb(a,kk1,b,j)
        PUT RES2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i
        GET HY2b_aa_picked(b,kk1,a,i)
        GET Y2b_aa_picked(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)   = HY2b_aa_picked(b,kk1,a,i)
        T1bxaa(b,kk1,a,i)  = Y2b_aa_picked(b,kk1,a,i)
        T1bxaa(b,kk1,a,i) *= Omegam
        Tbxaa(b,kk1,a,i)  += T1bxaa(b,kk1,a,i)
        PUT RES2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

     ENDPARDO b, a, kk1, i

     EXECUTE SIP_BARRIER
#bgn_debug
