#      pardo a,kk1,b,j
#            get Ra_bb(a,kk1,b,j)
#            tmp =  Ra_bb(a,kk1,b,j) * Ra_bb(a,kk1,b,j)
#            tmpa+= tmp
#      endpardo a,kk1,b,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo b,a,i,kk1
#            get Rb_aa(b,kk1,a,i)
#            tmp = Rb_aa(b,kk1,a,i) * Rb_aa(b,kk1,a,i)
#            tmpa+= tmp
#      endpardo b, a, i, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     ENDPROC FORM_1PPH_DIAG
#    ----------------------

      PROC FORM_12PPH_DIAG
#     --------------------

     create DDii
     create DDjj
     create DDaa
     create DDbb
     create Ra_aa
     create Rb_bb
     create Ra_bb
     create Rb_aa
     create Ra
     create Rb
     execute sip_barrier
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#   
           GET              Uii(i1,i)
           Sii(i1,i)      = Uii(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET              Ujj(j1,j)
        Sjj(j1,j)      = Ujj(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1
#
# -----prepare f_aa diagonal = DDaa
#
     PARDO a, a1
#
           GET              Uaa(a,a1)
           Saa(a,a1)      = Uaa(a,a1)
           taa(a,a1)      = Uaa(a,a1)
           execute return_diagonal Saa Sdaa
           taa(a,a1)      = Sdaa(a,a1)
           put DDaa(a,a1) = taa(a,a1)
#
     ENDPARDO a, a1
#
# -----prepare f_bb diagonal = DDbb
#
     PARDO b, b1
#
        GET              Ubb(b,b1)
        Sbb(b,b1)      = Ubb(b,b1)
        execute return_diagonal Sbb Sdbb
        tbb(b,b1)      = Sdbb(b,b1)
        put DDbb(b,b1) = tbb(b,b1)
#
     ENDPARDO b, b1
#
     execute sip_barrier
#
#     Ra 
#     -------
#
     PARDO a
        DO kk1
#
           tas(a,kk1)=0.0
#
           do a1
#
              get          DDaa(a1,a)
              t1as(a1,kk1) = 1.0
              taa(a,a1)  = DDaa(a1,a)
#
              t2as(a,kk1)  = taa(a,a1)*t1as(a1,kk1)
              tas(a,kk1)  -= t2as(a,kk1)
#
           enddo a1
#
           PUT Ra(a,kk1) += tas(a,kk1)
#
        ENDDO kk1
     ENDPARDO a
#
#
#     Rb 
#     -------
#
     PARDO b
        DO kk1
#
           tbs(b,kk1)=0.0
#
           do b1
#
              get          DDbb(b1,b)
              t1bs(b1,kk1) = 1.0
              tbb(b,b1)  = DDbb(b1,b)
#
              t2bs(b,kk1)  = tbb(b,b1)*t1bs(b1,kk1)
              tbs(b,kk1)  -= t2bs(b,kk1)
#
           enddo b1
#
           PUT Rb(b,kk1) += tbs(b,kk1)
#
        ENDDO kk1
     ENDPARDO b
#
#     (R)(a,ai)
#     ----------
#
      PARDO a, a1, a2, i
            DO kk1
               GET                      DDaa(a,a2)
               t1axai(a2,kk1,a1,i)    = 1.0
               taxai(a,kk1,a1,i)      = t1axai(a2,kk1,a1,i)*DDaa(a,a2)
               PUT Ra_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, a2, i
#
      PARDO a, a1, a2, i
            DO kk1
               GET                      DDaa(a1,a2)
               t1axai(a,kk1,a2,i)     = 1.0
               taxai(a,kk1,a1,i)      = t1axai(a,kk1,a2,i)*DDaa(a1,a2)
               PUT Ra_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, a2, i
#
     PARDO a, a1, i1, i
            DO kk1
               GET                      DDii(i1,i)
               t1axai(a,kk1,a1,i1)    = 1.0
               taxai(a,kk1,a1,i)      = t1axai(a,kk1,a1,i1)*DDii(i1,i)
               taxai(a,kk1,a1,i)     *= -1.0
               PUT Ra_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)
            ENDDO kk1
      ENDPARDO a, a1, i1, i
#
      PARDO a1, i1, a2, i
            DO kk1
               REQUEST              Wiaai(i1,a2,a1,i) i1
               Taaii(a2,a1,i1,i) =  Wiaai(i1,a2,a1,i)
               execute return_diagonal4 Taaii
               DO a
                  t1axai(a,kk1,a2,i1)    = 1.0
                  taxai(a,kk1,a1,i)      = t1axai(a,kk1,a2,i1)*Taaii(a2,a1,i1,i)
                  taxai(a,kk1,a1,i)     *= 0.25

                  PUT Ra_aa(a,kk1,a1,i) += taxai(a,kk1,a1,i)

                  t1axai(a1,kk1,a,i)     = taxai(a,kk1,a1,i)
#                  t1axai(a1,kk1,a,i)    *= -1.0
                  PUT Ra_aa(a1,kk1,a,i) += t1axai(a1,kk1,a,i)
               ENDDO a
            ENDDO kk1
      ENDPARDO a1, i1, a2, i
#
#     (R)(b,bi)
#     ----------
#
      PARDO b, b1, b2, j
            DO kk1
               GET                      DDbb(b,b2)
               t1bxbj(b2,kk1,b1,j)    = 1.0
               tbxbj(b,kk1,b1,j)      = t1bxbj(b2,kk1,b1,j)*DDbb(b,b2)
               PUT Rb_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, b2, j
#
      PARDO b, b1, b2, j
            DO kk1
               GET                      DDbb(b1,b2)
               t1bxbj(b,kk1,b2,j)     = 1.0
               tbxbj(b,kk1,b1,j)      = t1bxbj(b,kk1,b2,j)*DDbb(b1,b2)
               PUT Rb_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, b2, j
#
      PARDO b, b1, j1, j
            DO kk1
               GET                      DDjj(j1,j)
               t1bxbj(b,kk1,b1,j1)    = 1.0
               tbxbj(b,kk1,b1,j)      = t1bxbj(b,kk1,b1,j1)*DDjj(j1,j)
               tbxbj(b,kk1,b1,j)     *= -1.0
               PUT Rb_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)
            ENDDO kk1
      ENDPARDO b, b1, j1, j
#
      PARDO b1, j1, b2, j
            DO kk1
               REQUEST              Wjbbj(j1,b2,b1,j) j1
               Tbbjj(b2,b1,j1,j) =  Wjbbj(j1,b2,b1,j)
               execute return_diagonal4 Tbbjj
               DO b
                  t1bxbj(b,kk1,b2,j1)    = 1.0
                  tbxbj(b,kk1,b1,j)      = t1bxbj(b,kk1,b2,j1)*Tbbjj(b2,b1,j1,j) 
                  tbxbj(b,kk1,b1,j)     *= 0.25
                  PUT Rb_bb(b,kk1,b1,j) += tbxbj(b,kk1,b1,j)

                  t1bxbj(b1,kk1,b,j)     = tbxbj(b,kk1,b1,j)
#                  t1bxbj(b1,kk1,b,j)    *= -1.0
                  PUT Rb_bb(b1,kk1,b,j) += t1bxbj(b1,kk1,b,j)
               ENDDO b
            ENDDO kk1
      ENDPARDO b1, j1, b2, j
#
#     (HS)(a,BJ)
#     ----------
#
      PARDO a, b, a1, j
            DO kk1
               GET                       DDaa(a,a1)
               T1axbb(a1,kk1,b,j)      = 1.0
               taxbb(a,kk1,b,j)        = T1axbb(a1,kk1,b,j)*DDaa(a,a1)
               PUT Ra_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, a1, j
#
      PARDO a, b1, j, b
            DO kk1
               GET                       DDbb(b,b1)
               T1axbb(a,kk1,b1,j)      = 1.0
               taxbb(a,kk1,b,j)        = T1axbb(a,kk1,b1,j)*DDbb(b,b1)
               PUT Ra_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b1, j, b
#
      PARDO a, b, j1, j
            DO kk1
               GET                       DDjj(j1,j)
               T1axbb(a,kk1,b,j1)      = 1.0
               taxbb(a,kk1,b,j)        = T1axbb(a,kk1,b,j1)*DDjj(j1,j)
               taxbb(a,kk1,b,j)       *= -1.0
               PUT Ra_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
      ENDPARDO a, b, j1, j
#
      PARDO b1, j1, b, j
            REQUEST                  Wjbbj(j1,b1,b,j) j1
            Tbbjj(b,b1,j,j1)       = Wjbbj(j1,b1,b,j)
            execute return_diagonal4 Tbbjj
            Tbjbj(b1,j1,b,j)        = Tbbjj(b,b1,j,j1)
            DO a
            DO kk1
               T1axbb(a,kk1,b1,j1)   = 1.0
               taxbb(a,kk1,b,j)      = T1axbb(a,kk1,b1,j1)*Tbjbj(b1,j1,b,j)
               PUT Ra_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
            ENDDO a
      ENDPARDO b1, j1, b, j
#
      PARDO a, j1, a1, j
            REQUEST                  Wjjaa(j1,j,a,a1) a
            tppqq(a,a1,j1,j)       = Wjjaa(j1,j,a,a1)
            execute return_diagonal4 Tppqq
            DO b
            DO kk1
               T1axbb(a1,kk1,b,j1)   = 1.0
               taxbb(a,kk1,b,j)      = tppqq(a,a1,j1,j)*T1axbb(a1,kk1,b,j1)
               PUT Ra_bb(a,kk1,b,j) += taxbb(a,kk1,b,j)
            ENDDO kk1
            ENDDO b
      ENDPARDO a, j1, a1, j
#
#     (HS)(B,ai)
#     ----------
#
      PARDO b, a, b1, i
            DO kk1
               GET                       DDbb(b,b1)
               T1bxaa(b1,kk1,a,i)      = 1.0
               tbxaa(b,kk1,a,i)        = T1bxaa(b1,kk1,a,i)*DDbb(b,b1)
               PUT Rb_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a, b1, i
#
      PARDO b, a1, i, a
            DO kk1
               GET                       DDaa(a,a1)
               T1bxaa(b,kk1,a1,i)      = 1.0
               tbxaa(b,kk1,a,i)        = T1bxaa(b,kk1,a1,i)*DDaa(a,a1)
               PUT Rb_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a1, i, a
#
      PARDO b, a, i1, i
            DO kk1
               GET                       DDii(i1,i)
               T1bxaa(b,kk1,a,i1)      = 1.0
               tbxaa(b,kk1,a,i)        = T1bxaa(b,kk1,a,i1)*DDii(i1,i)
               tbxaa(b,kk1,a,i)       *= -1.0
               PUT Rb_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
      ENDPARDO b, a, i1, i
#
      PARDO a1, i1, a, i
            REQUEST Wiaai(i1,a1,a,i) i1
            tpppp(a,a1,i,i1) = Wiaai(i1,a1,a,i)
            execute return_diagonal4 tpppp
            t1pppp(a1,i1,a,i) = tpppp(a,a1,i,i1)
            DO b
            DO kk1
               T1bxaa(b,kk1,a1,i1)   = 1.0
               tbxaa(b,kk1,a,i)      = T1bxaa(b,kk1,a1,i1)*t1pppp(a1,i1,a,i)
               PUT Rb_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
            ENDDO b
      ENDPARDO a1, i1, a, i
#
      PARDO b, i1, b1, i
            REQUEST            Wiibb(i1,i,b,b1) b
            tqqpp(b,b1,i1,i) = Wiibb(i1,i,b,b1)
            execute return_diagonal4 tqqpp
            DO a
            DO kk1
               T1bxaa(b1,kk1,a,i1)     = 1.0
               tbxaa(b,kk1,a,i)        = tqqpp(b,b1,i1,i)*T1bxaa(b1,kk1,a,i1)
               PUT Rb_aa(b,kk1,a,i) += tbxaa(b,kk1,a,i)
            ENDDO kk1
            ENDDO a
      ENDPARDO b, i1, b1, i

     execute sip_barrier
#
     delete DDii
     delete DDjj
     delete DDaa
     delete DDbb

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,a1,kk1,i
#            get  Ra_aa(a,kk1,a1,i)
#            tmp = Ra_aa(a,kk1,a1,i) * Ra_aa(a,kk1,a1,i)  
#            tmpa += tmp
#      endpardo a,a1,kk1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,b1,j, kk1
#            get Rb_bb(b,kk1,b1,j)
#            tmp = Rb_bb(b,kk1,b1,j) * Rb_bb(b,kk1,b1,j)
#            tmpa+= tmp
#      endpardo b,b1,j, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,kk1,b,j
#            get Ra_bb(a,kk1,b,j)
#            tmp =  Ra_bb(a,kk1,b,j) * Ra_bb(a,kk1,b,j)
#            tmpa+= tmp
#      endpardo a,kk1,b,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo b,a,i,kk1
#            get Rb_aa(b,kk1,a,i)
#            tmp = Rb_aa(b,kk1,a,i) * Rb_aa(b,kk1,a,i)
#            tmpa+= tmp
#      endpardo b, a, i, kk1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     ENDPROC FORM_12PPH_DIAG
#    -----------------------

    PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        DO NINDEX50
           A_MATRIX(MINDEX50,NINDEX50) = 0.0
           DVECTORS(MINDEX50,NINDEX50) = 0.0
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50

     PARDO a
        DO kk1
           tax(a,kk1)      = 0.0
           PUT Y1a(a,kk1,NINDEX50)  = tax(a,kk1)
           PUT HY1a(a,kk1,NINDEX50) = tax(a,kk1)
           PUT R1a_intmd(a,kk1) = tax(a,kk1)
        ENDDO kk1
     ENDPARDO a

     PARDO b
        DO kk1
           tbx(b,kk1)      = 0.0
           PUT Y1b(b,kk1,NINDEX50)  = tbx(b,kk1)
           PUT HY1b(b,kk1,NINDEX50) = tbx(b,kk1)
           PUT R1b_intmd(b,kk1) =  tbx(b,kk1)
       ENDDO kk1
     ENDPARDO b

     PARDO i, a, a1
           DO kk1
              taxaa(a,kk1,a1,i)       = 0.0
              PREPARE Y2a_aa(a,kk1,a1,i,NINDEX50)  = taxaa(a,kk1,a1,i)
              PREPARE HY2a_aa(a,kk1,a1,i,NINDEX50) = taxaa(a,kk1,a1,i)
              PUT R2a_aa_intmd(a,kk1,a1,i) = taxaa(a,kk1,a1,i)
           ENDDO kk1
     ENDPARDO i, a, a1

     PARDO b, b1, j
           DO kk1
              tbxbb(b,kk1,b1,j)       = 0.0
              PREPARE Y2b_bb(b,kk1,b1,j,NINDEX50)  = tbxbb(b,kk1,b1,j)
              PREPARE HY2b_bb(b,kk1,b1,j,NINDEX50) = tbxbb(b,kk1,b1,j)
              PUT R2b_bb_intmd(b,kk1,b1,j) = tbxbb(b,kk1,b1,j)
           ENDDO kk1
     ENDPARDO b, b1, j

     PARDO  a, b, j
           DO kk1
              taxbb(a,kk1,b,j)       = 0.0
              PREPARE Y2a_bb(a,kk1,b,j,NINDEX50)  = taxbb(a,kk1,b,j)
              PREPARE HY2a_bb(a,kk1,b,j,NINDEX50) = taxbb(a,kk1,b,j)
              PUT R2a_bb_intmd(a,kk1,b,j) = taxbb(a,kk1,b,j)
           ENDDO kk1
     ENDPARDO a, b, j

     PARDO b, a, i
           DO kk1
              tbxaa(b,kk1,a,i)       = 0.0
              PREPARE Y2b_aa(b,kk1,a,i,NINDEX50)  = tbxaa(b,kk1,a,i)
              PREPARE HY2b_aa(b,kk1,a,i,NINDEX50) = tbxaa(b,kk1,a,i)
              PUT R2b_aa_intmd(b,kk1,a,i) = tbxaa(b,kk1,a,i)
           ENDDO kk1
     ENDPARDO b, a, i

     ENDDO NINDEX50

     EXECUTE  SERVER_BARRIER

     ENDPROC SET_TO_ZERO
#    -------------------

      PROC SAVE_C_VECTORS
#     -------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            DO kk1
            DO a
               GET R1A(a,kk1)
               Tax(a,kk1) = R1A(a,kk1)
               PUT R1A_HIST(a,Kk1,NINDEX50) = Tax(a,kk1)
            ENDDO a
            ENDDO kk1

            DO kk1
            DO b
               GET R1B(b,kk1)
               Tbx(b,kk1) = R1B(b,kk1)
               PUT R1B_HIST(b,Kk1,NINDEX50) = Tbx(b,kk1)
            ENDDO b
            ENDDO kk1

            PARDO a, a1, kk1, i
                GET R2a_aa(a,kk1,a1,i)
                Taxaa(a,kk1,a1,i) =  R2a_aa(a,kk1,a1,i)
                PREPARE R2a_aa_HIST(a,kk1,a1,i,NINDEX50) = Taxaa(a,kk1,a1,i) 
            ENDPARDO a, a1, kk1, i

            PARDO b, b1, kk1, j
                GET R2b_bb(b,kk1,b1,j)
                Tbxbb(b,kk1,b1,j) = R2b_bb(b,kk1,b1,j)
                PREPARE R2b_bb_HIST(b,kk1,b1,j,NINDEX50) = Tbxbb(b,kk1,b1,j)
            ENDPARDO b, b1, kk1, j

            PARDO a, b, kk1, j
                GET R2a_bb(a,kk1,b,j)
                Taxbb(a,kk1,b,j) = R2a_bb(a,kk1,b,j)
                PREPARE R2a_bb_HIST(a,kk1,b,j,NINDEX50) = Taxbb(a,kk1,b,j)
            ENDPARDO a, b, kk1, j

            PARDO b, a, kk1, i
                GET R2b_aa(b,kk1,a,i)
                Tbxaa(b,kk1,a,i) = R2b_aa(b,kk1,a,i)
               PREPARE R2b_aa_HIST(b,kk1,a,i,NINDEX50) = Tbxaa(b,kk1,a,i) 
            ENDPARDO   b, a, kk1, i

         ENDIF
      ENDDO NINDEX50
      EXECUTE SERVER_BARRIER

#bgn_debug
#      suma=0.0
#      tmpa=0.0
#      counter=0.0
#      root=1.0
#      do NINDEX50
#         counter += 1.0
#         if counter == root
#         pardo a, kk1
#            GET  R1A_HIST(a,kk1,NINDEX50)
#            Tax(a,kk1) = R1A_HIST(a,kk1,NINDEX50)
#            tmp  = Tax(a,kk1) * Tax(a,kk1)
#            tmpa += tmp
#         endpardo a, kk1
#         endif
#      enddo NINDEX50
#      execute sip_barrier
#      collective suma+=tmpa
#      execute print_scalar tmpa
#end_debug


      ENDPROC SAVE_C_VECTORS
#     ---------------------

      PROC SAVE_HC_VECTORS
#     -------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            DO kk1
            DO a
               GET HR1A(a,kk1)
               Tax(a,kk1) = HR1A(a,kk1)
               PUT HR1A_HIST(a,Kk1,NINDEX50) = Tax(a,kk1)
            ENDDO a
            ENDDO kk1

            DO kk1
            DO b
               GET HR1B(b,kk1)
               Tbx(b,kk1) = HR1B(b,kk1)
               PUT HR1B_HIST(b,Kk1,NINDEX50) = Tbx(b,kk1)
            ENDDO b
            ENDDO kk1

            PARDO a, a1, kk1, i
                GET HR2a_aa(a,kk1,a1,i)
                Taxaa(a,kk1,a1,i) =  HR2a_aa(a,kk1,a1,i)
                PREPARE HR2a_aa_HIST(a,kk1,a1,i,NINDEX50) = Taxaa(a,kk1,a1,i) 
            ENDPARDO a, a1, kk1, i

            PARDO b, b1, kk1, j
                GET HR2b_bb(b,kk1,b1,j)
                Tbxbb(b,kk1,b1,j) = HR2b_bb(b,kk1,b1,j)
                PREPARE HR2b_bb_HIST(b,kk1,b1,j,NINDEX50) = Tbxbb(b,kk1,b1,j)
            ENDPARDO b, b1, kk1, j

            PARDO a, b, kk1, j
                GET HR2a_bb(a,kk1,b,j)
                Taxbb(a,kk1,b,j) = HR2a_bb(a,kk1,b,j)
                PREPARE HR2a_bb_HIST(a,kk1,b,j,NINDEX50) = Taxbb(a,kk1,b,j)
            ENDPARDO a, b, kk1, j

            PARDO b, a, kk1, i
                GET HR2b_aa(b,kk1,a,i)
                Tbxaa(b,kk1,a,i) = HR2b_aa(b,kk1,a,i)
                PREPARE HR2b_aa_HIST(b,kk1,a,i,NINDEX50) = Tbxaa(b,kk1,a,i) 
            ENDPARDO   b, a, kk1, i
         ENDIF
      ENDDO NINDEX50
      EXECUTE SERVER_BARRIER
#bgn_debug
#      suma=0.0
#      tmpa=0.0
#      counter=0.0
#      root=1.0
#      do NINDEX50
#         counter += 1.0
#         if counter == root
#         pardo a, kk1
#            GET  hR1A_HIST(a,kk1,NINDEX50)
#            Tax(a,kk1) = hR1A_HIST(a,kk1,NINDEX50)
#            tmp  = Tax(a,kk1) * Tax(a,kk1)
#            tmpa += tmp
#         endpardo a, kk1
#         endif
#      enddo NINDEX50
#      execute sip_barrier
#      collective suma+=tmpa
#      execute print_scalar tmpa
#end_debug

      ENDPROC SAVE_HC_VECTORS
#     ---------------------

     PROC FORM_A_MATRIX_11
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      ncount = 0.0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo a,kk1
#         get hr1a_hist(a,kk1,nindex50)
#         tmp = hr1a_hist(a,kk1,nindex50) * hr1a_hist(a,kk1,nindex50)
#         tmpa += tmp
#      endpardo a,kk1
#      pardo b,kk1
#         get hr1b_hist(b,kk1,nindex50)
#         tmp = hr1b_hist(b,kk1,nindex50) * hr1b_hist(b,kk1,nindex50)
#         tmpb += tmp
#      endpardo b,kk1
#      endif
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute print_scalar suma
#      execute print_scalar sumb
#      tmpa =0.0
#      suma =0.0
#      ncount = 0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo a,a1,kk1,i
#            request hR2a_aa_hist(a,kk1,a1,i,nindex50) i
#            Taxaa(a,kk1,a1,i) =  hR2a_aa_hist(a,kk1,a1,i,nindex50)
#            tmp = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
#            tmpa += tmp
#      endpardo a,a1,kk1,i
#      endif
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      ncount = 0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo b,b1,j,kk1
#            request  hR2b_bb_hist(b,kk1,b1,j,nindex50) j
#            Tbxbb(b,kk1,b1,j) = hR2b_bb_hist(b,kk1,b1,j,nindex50)
#            tmp = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
#            tmpa+= tmp
#      endpardo b,b1,j,kk1
#      endif
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

    IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT

                    PARDO a, kk1

                          GET HR1A_HIST(a,kk1,NINDEX50)
                          GET R1A_HIST(a,kk1,MINDEX50)

                          Takk(a,kk1)   = HR1A_HIST(a,kk1,NINDEX50)
                          T1akk(a,kk1)  = R1A_HIST(a,kk1,MINDEX50)

                          TMP   = Takk(a,kk1) *  T1akk(a,kk1)
                          SUMA += TMP

                    ENDPARDO a, kk1

                    PARDO b, kk1

                          GET HR1B_HIST(b,kk1,NINDEX50)
                          GET R1B_HIST(b,kk1,MINDEX50)

                          Tbkk(b,kk1)   = HR1B_HIST(b,kk1,NINDEX50)
                          T1bkk(b,kk1)  = R1B_HIST(b,kk1,MINDEX50)

                          TMP   = Tbkk(b,kk1) *  T1bkk(b,kk1)
                          SUMB += TMP

                    ENDPARDO b, kk1

                    EXECUTE SERVER_BARRIER
                    COLLECTIVE HC_A += SUMA
                    COLLECTIVE HC_B += SUMB

                 ENDIF

              ENDDO MINDEX50
           ENDIF

        ENDDO NINDEX50

      ENDIF
#
# In iteration one there are no contributions from R1AAA, R1BBB.. since
# those are zero at the start. Note that HR1AAA are non-zero but the
# overlap is still zero.

     A_VALUE  = HC_A
     A_VALUE += HC_B
#bgn_debug
#     execute print_scalar A_value
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50
               MCOUNT += 1.0
               IF MCOUNT == 1.0

                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF
             ENDDO MINDEX50

        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC FORM_A_MATRIX_11
#    -------------------------

    PROC FORM_A_MATRIX_IJ
#    ----------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF

                 IF MCOUNT == ITER_COUNT
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF
                 ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0

                     PARDO a, kk1

                            GET HR1A_HIST(a,kk1,NINDEX50)
                            GET R1A_HIST(a,kk1,MINDEX50)

                            Takk(a,kk1)   = HR1A_HIST(a,kk1,NINDEX50)
                            T1akk(a,kk1)  = R1A_HIST(a,kk1,MINDEX50)

                            TMP   = Takk(a,kk1) *  T1akk(a,kk1)
                            SUMA += TMP
                    
                     ENDPARDO a, kk1

                     PARDO b, kk1

                           GET HR1B_HIST(b,kk1,NINDEX50)
                           GET R1B_HIST(b,kk1,MINDEX50)

                           Tbkk(b,kk1)  = HR1B_HIST(b,kk1,NINDEX50)
                           T1bkk(b,kk1) = R1B_HIST(b,kk1,MINDEX50)

                            TMP   = Tbkk(b,kk1) *  T1bkk(b,kk1)
                            SUMB += TMP

                     ENDPARDO b, kk1

                     PARDO a, a1, kk1,i 

                           REQUEST HR2a_aa_HIST(a,kk1,a1,i,NINDEX50) i
                           REQUEST R2a_aa_HIST(a,kk1,a1,i,MINDEX50)  i

                           Taxaa(a,kk1,a1,i)  = HR2a_aa_HIST(a,kk1,a1,i,NINDEX50)
                           T1axaa(a,kk1,a1,i) = R2a_aa_HIST(a,kk1,a1,i,MINDEX50)

                           TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
                           SUMAAA += TMP

                     ENDPARDO a, a1, kk1, i

                     PARDO b, b1, kk1, j
                           REQUEST HR2b_bb_HIST(b,kk1,b1,j,NINDEX50) j
                           REQUEST R2b_bb_HIST(b,kk1,b1,j,MINDEX50)  j

                           Tbxbb(b,kk1,b1,j)  = HR2b_bb_HIST(b,kk1,b1,j,NINDEX50)
                           T1bxbb(b,kk1,b1,j) = R2b_bb_HIST(b,kk1,b1,j,MINDEX50)

                           TMP     = Tbxbb(b,kk1,b1,j) * T1bxbb(b,kk1,b1,j)
                           SUMBBB += TMP

                     ENDPARDO b, b1, kk1, j

                     PARDO b, a, kk1, i
                           REQUEST HR2b_aa_HIST(b,kk1,a,i,NINDEX50) i
                           REQUEST R2b_aa_HIST(b,kk1,a,i,MINDEX50)  i

                           Tbxaa(b,kk1,a,i)  = HR2b_aa_HIST(b,kk1,a,i,NINDEX50)
                           T1bxaa(b,kk1,a,i) = R2b_aa_HIST(b,kk1,a,i,MINDEX50)

                           TMP     = Tbxaa(b,kk1,a,i) * T1bxaa(b,kk1,a,i)
                           SUMAAB += TMP

                     ENDPARDO b, a, kk1, i

                     PARDO j, a, kk1, b
                           REQUEST HR2a_bb_HIST(a,kk1,b,j,NINDEX50) j
                           REQUEST R2a_bb_HIST(a,kk1,b,j,MINDEX50) j

                           Taxbb(a,kk1,b,j)  = HR2a_bb_HIST(a,kk1,b,j,NINDEX50)
                           T1axbb(a,kk1,b,j) = R2a_bb_HIST(a,kk1,b,j,MINDEX50)

                           TMP   = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
                           SUMBBA += TMP
   
                     ENDPARDO j, a, kk1, b

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE 

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------
     PROC FORM_A_MATRIX_JI
#    ----------------------

# Built A_jk where k=1, ..j-1, <(HC_k)_j | C_k>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT >= NCOUNT
                    EXIT
                 ENDIF

                 IF MCOUNT == ITER_COUNT
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF
                 ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    SUMAAB = 0.0
                    SUMBBA = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0
                    HC_AAB = 0.0
                    HC_BBA = 0.0
                    PARDO a, kk1

                            GET HR1A_HIST(a,kk1,MINDEX50)
                            GET R1A_HIST(a,kk1,NINDEX50)

                            Takk(a,kk1)   = HR1A_HIST(a,kk1,MINDEX50)
                            T1akk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)

                            TMP   = Takk(a,kk1) *  T1akk(a,kk1)
                            SUMA += TMP

                     ENDPARDO a, kk1

                     PARDO b, kk1

                           GET HR1B_HIST(b,kk1,MINDEX50)
                           GET R1B_HIST(b,kk1,NINDEX50)

                           Tbkk(b,kk1)  = HR1B_HIST(b,kk1,MINDEX50)
                           T1bkk(b,kk1) = R1B_HIST(b,kk1,NINDEX50)

                            TMP   = Tbkk(b,kk1) *  T1bkk(b,kk1)
                            SUMB += TMP

                     ENDPARDO b, kk1

                     PARDO a, a1, kk1,i

                           REQUEST HR2a_aa_HIST(a,kk1,a1,i,MINDEX50) i
                           REQUEST R2a_aa_HIST(a,kk1,a1,i,NINDEX50)  i

                           Taxaa(a,kk1,a1,i)  = HR2a_aa_HIST(a,kk1,a1,i,MINDEX50)
                           T1axaa(a,kk1,a1,i) = R2a_aa_HIST(a,kk1,a1,i,NINDEX50)

                           TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
                           SUMAAA += TMP

                     ENDPARDO a, a1, kk1, i

                     PARDO b, b1, kk1, j
                           REQUEST HR2b_bb_HIST(b,kk1,b1,j,MINDEX50) j
                           REQUEST R2b_bb_HIST(b,kk1,b1,j,NINDEX50)  j

                           Tbxbb(b,kk1,b1,j)  = HR2b_bb_HIST(b,kk1,b1,j,MINDEX50)
                           T1bxbb(b,kk1,b1,j) = R2b_bb_HIST(b,kk1,b1,j,NINDEX50)

                           TMP     = Tbxbb(b,kk1,b1,j) * T1bxbb(b,kk1,b1,j)
                           SUMBBB += TMP

                     ENDPARDO b, b1, kk1, j

                     PARDO b, a, kk1, i
                           REQUEST HR2b_aa_HIST(b,kk1,a,i,MINDEX50) i
                           REQUEST R2b_aa_HIST(b,kk1,a,i,NINDEX50)  i

                           Tbxaa(b,kk1,a,i)  = HR2b_aa_HIST(b,kk1,a,i,MINDEX50)
                           T1bxaa(b,kk1,a,i) = R2b_aa_HIST(b,kk1,a,i,NINDEX50)

                           TMP     = Tbxaa(b,kk1,a,i) * T1bxaa(b,kk1,a,i)
                           SUMAAB += TMP

                     ENDPARDO b, a, kk1, i

                     PARDO j, a, kk1, b
                           REQUEST HR2a_bb_HIST(a,kk1,b,j,MINDEX50) j
                           REQUEST R2a_bb_HIST(a,kk1,b,j,NINDEX50) j

                           Taxbb(a,kk1,b,j)  = HR2a_bb_HIST(a,kk1,b,j,MINDEX50)
                           T1axbb(a,kk1,b,j) = R2a_bb_HIST(a,kk1,b,j,NINDEX50)

                           TMP   = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
                           SUMBBA += TMP

                     ENDPARDO j, a, kk1, b

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_AAB += SUMAAB
                     COLLECTIVE HC_BBA += SUMBBA

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------                    

     PROC FORM_A_MATRIX_II
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0
     HC_AAB = 0.0
     HC_BBA = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0
                 IF NCOUNT == MCOUNT

                    PARDO a, kk1

                            GET HR1A_HIST(a,kk1,NINDEX50)
                            GET R1A_HIST(a,kk1,MINDEX50)

                            Takk(a,kk1)   = HR1A_HIST(a,kk1,NINDEX50)
                            T1akk(a,kk1)  = R1A_HIST(a,kk1,MINDEX50)

                            TMP   = Takk(a,kk1) *  T1akk(a,kk1)
                            SUMA += TMP

                     ENDPARDO a, kk1

                     PARDO b, kk1

                           GET HR1B_HIST(b,kk1,NINDEX50)
                           GET R1B_HIST(b,kk1,MINDEX50)

                           Tbkk(b,kk1)  = HR1B_HIST(b,kk1,NINDEX50)
                           T1bkk(b,kk1) = R1B_HIST(b,kk1,MINDEX50)

                            TMP   = Tbkk(b,kk1) *  T1bkk(b,kk1)
                            SUMB += TMP

                     ENDPARDO b, kk1

                     PARDO a, a1, kk1,i

                           REQUEST HR2a_aa_HIST(a,kk1,a1,i,NINDEX50) i
                           REQUEST R2a_aa_HIST(a,kk1,a1,i,MINDEX50)  i

                           Taxaa(a,kk1,a1,i)  = HR2a_aa_HIST(a,kk1,a1,i,NINDEX50)
                           T1axaa(a,kk1,a1,i) = R2a_aa_HIST(a,kk1,a1,i,MINDEX50)

                           TMP     = Taxaa(a,kk1,a1,i) * T1axaa(a,kk1,a1,i)
                           SUMAAA += TMP

                     ENDPARDO a, a1, kk1, i

                     PARDO b, b1, kk1, j
                           REQUEST HR2b_bb_HIST(b,kk1,b1,j,NINDEX50) j
                           REQUEST R2b_bb_HIST(b,kk1,b1,j,MINDEX50)  j

                           Tbxbb(b,kk1,b1,j)  = HR2b_bb_HIST(b,kk1,b1,j,NINDEX50)
                           T1bxbb(b,kk1,b1,j) = R2b_bb_HIST(b,kk1,b1,j,MINDEX50)

                           TMP     = Tbxbb(b,kk1,b1,j) * T1bxbb(b,kk1,b1,j)
                           SUMBBB += TMP

                     ENDPARDO b, b1, kk1, j

                     PARDO b, a, kk1, i
                           REQUEST HR2b_aa_HIST(b,kk1,a,i,NINDEX50) i
                           REQUEST R2b_aa_HIST(b,kk1,a,i,MINDEX50)  i

                           Tbxaa(b,kk1,a,i)  = HR2b_aa_HIST(b,kk1,a,i,NINDEX50)
                           T1bxaa(b,kk1,a,i) = R2b_aa_HIST(b,kk1,a,i,MINDEX50)

                           TMP     = Tbxaa(b,kk1,a,i) * T1bxaa(b,kk1,a,i)
                           SUMAAB += TMP

                     ENDPARDO b, a, kk1, i

                     PARDO j, a, kk1, b
                           REQUEST HR2a_bb_HIST(a,kk1,b,j,NINDEX50) j
                           REQUEST R2a_bb_HIST(a,kk1,b,j,MINDEX50) j

                           Taxbb(a,kk1,b,j)  = HR2a_bb_HIST(a,kk1,b,j,NINDEX50)
                           T1axbb(a,kk1,b,j) = R2a_bb_HIST(a,kk1,b,j,MINDEX50)

                           TMP   = Taxbb(a,kk1,b,j) * T1axbb(a,kk1,b,j)
                           SUMBBA += TMP
  
                     ENDPARDO j, a, kk1, b

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_B   += SUMB
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB
                     COLLECTIVE HC_BBA += SUMBBA
                     COLLECTIVE HC_AAB += SUMAAB

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
                     A_VALUE += HC_AAB
                     A_VALUE += HC_BBA
  
                     KCOUNT = 0.0
                       DO KINDEX50
                           KCOUNT += 1.0
                           IF KCOUNT  == NCOUNT
  
                              LCOUNT = 0.0
                              DO LINDEX50
                                 LCOUNT += 1.0
                                 IF LCOUNT == MCOUNT
  
                                    A_MATRIX(NINDEX50,MINDEX50) = A_VALUE
  
                                 ENDIF
                              ENDDO LINDEX50
                           ENDIF
                       ENDDO KINDEX50
                  ENDIF
                ENDDO NINDEX50
         ENDIF

     ENDDO MINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_A_MATRIX_II
#    -------------------------

     PROC REORDER_A_EIGS
#    -------------------

     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE
              A_DIAGS(MINDEX50)      = EIG_VALUE
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS

     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE
     OMEGA0M  = A_VALUE
     OMEGA0M *= -1.0
     E_OLD    = OMEGA0 

     IF ROOT_COUNT > ONE
        DIFF  = OMEGA0
        DIFF -= OMEGA_00
        IF DIFF < VERY_SMALL
           IDEGEN = ONE
        ENDIF
        OMEGA_00 = OMEGA0
     ELSE
        OMEGA_00 = OMEGA0
     ENDIF

#bgn_debug
#     execute print_scalar OMEGA0M
#     execute print_scalar IDEGEN
#end_debug

# First the residual vector for iteration 1
    
     PARDO a, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1A_HIST(a,kk1,NINDEX50)
              GET R1A_HIST(a,kk1,NINDEX50)

              Tax(a,kk1)   = HR1A_HIST(a,kk1,NINDEX50)
              T1ax(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
              T1ax(a,kk1) *= OMEGA0M
              Tax(a,kk1)  += T1ax(a,kk1)

              PUT RES1a(a,kk1) = Tax(a,kk1)

           ENDDO NINDEX50
     ENDPARDO a, kk1

   PARDO b, kk1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1B_HIST(b,kk1,NINDEX50)
              GET R1B_HIST(b,kk1,NINDEX50)

              Tbx(b,kk1)   = HR1B_HIST(b,kk1,NINDEX50)
              T1bx(b,kk1)  = R1B_HIST(b,kk1,NINDEX50)
              T1bx(b,kk1) *= OMEGA0M
              Tbx(b,kk1)  += T1bx(b,kk1)

              PUT RES1b(b,kk1) = Tbx(b,kk1)

           ENDDO NINDEX50
     ENDPARDO  b, kk1

# R2a_aa_HIST, R2b_bb_HIST, R2a_bb_HIST and R2b_aa_HIST is zero.

     PARDO a, a1, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST HR2a_aa_HIST(a,kk1,a1,i,NINDEX50)  i

              Taxaa(a,kk1,a1,i)  = HR2a_aa_HIST(a,kk1,a1,i,NINDEX50)
              PUT RES2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

           ENDDO NINDEX50
     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST HR2b_bb_HIST(b,kk1,b1,j,NINDEX50)  j

              Tbxbb(b,kk1,b1,j)  = HR2b_bb_HIST(b,kk1,b1,j,NINDEX50)
              PUT RES2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

           ENDDO NINDEX50
     ENDPARDO b, b1, kk1, j

     PARDO a, kk1, b, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST HR2a_bb_HIST(a,kk1,b,j,NINDEX50) j

              Taxbb(a,kk1,b,j)  = HR2a_bb_HIST(a,kk1,b,j,NINDEX50)
              PUT RES2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)

           ENDDO NINDEX50
     ENDPARDO a, kk1, b, j

     PARDO b, a, kk1, i

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST HR2b_aa_HIST(b,kk1,a,i,NINDEX50) i

              Tbxaa(b,kk1,a,i)  = HR2b_aa_HIST(b,kk1,a,i,NINDEX50)
              PUT RES2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

           ENDDO NINDEX50
     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER

# Now the correction vector for iteration 1

     DO kk1
        DO a
           GET RES1a(a,kk1)
           GET Ra(a,kk1)

           Takk(a,kk1)   = Ra(a,kk1)
           T1akk(a,kk1)  = RES1a(a,kk1)

           Takk(a,kk1)  *= -1.0
           T2akk(a,kk1)  = OMEGA0
           Takk(a,kk1)  += T2akk(a,kk1)

           EXECUTE APPLY_DEN2_NOR  T1akk Takk

           PUT CORR_VECa(a,kk1) =  T1akk(a,kk1)

         ENDDO a
     ENDDO kk1

     DO kk1
         DO b
            GET RES1b(b,kk1)
            GET Rb(b,kk1)

            Tbkk(b,kk1)   = Rb(b,kk1)
            T1bkk(b,kk1)  = RES1b(b,kk1)

            Tbkk(b,kk1)  *= -1.0
            T2bkk(b,kk1)  = OMEGA0
            Tbkk(b,kk1)  += T2bkk(b,kk1)

            EXECUTE APPLY_DEN2_NOR  T1bkk Tbkk

            PUT CORR_VECb(b,kk1) =  T1bkk(b,kk1)

         ENDDO b
     ENDDO kk1

     PARDO a, a1, kk1, i
         GET RES2a_aa(a,kk1,a1,i)
         GET Ra_aa(a,kk1,a1,i)

         Taxaa(a,kk1,a1,i)  = Ra_aa(a,kk1,a1,i)
         T1axaa(a,kk1,a1,i) = RES2a_aa(a,kk1,a1,i)

         Taxaa(a,kk1,a1,i) *= -1.0
         T2axaa(a,kk1,a1,i) = OMEGA0
         Taxaa(a,kk1,a1,i)  += T2axaa(a,kk1,a1,i)

         EXECUTE APPLY_DEN4 T1axaa Taxaa

         PUT CORR_VECa_aa(a,kk1,a1,i) = T1axaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j
         GET RES2b_bb(b,kk1,b1,j)
         GET Rb_bb(b,kk1,b1,j)

         Tbxbb(b,kk1,b1,j)  = Rb_bb(b,kk1,b1,j)
         T1bxbb(b,kk1,b1,j) = RES2b_bb(b,kk1,b1,j)

         Tbxbb(b,kk1,b1,j)  *= -1.0
         T2bxbb(b,kk1,b1,j)  = OMEGA0
         Tbxbb(b,kk1,b1,j)  += T2bxbb(b,kk1,b1,j)

         EXECUTE APPLY_DEN4 T1bxbb Tbxbb

         PUT CORR_VECb_bb(b,kk1,b1,j) = T1bxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
        GET RES2a_bb(a,kk1,b,j)
        GET Ra_bb(a,kk1,b,j)

        Taxbb(a,kk1,b,j)   = Ra_bb(a,kk1,b,j)
        T1axbb(a,kk1,b,j)  = RES2a_bb(a,kk1,b,j)

        Taxbb(a,kk1,b,j)  *= -1.0
        T2axbb(a,kk1,b,j)  = OMEGA0
        Taxbb(a,kk1,b,j) += T2axbb(a,kk1,b,j)

        EXECUTE APPLY_DEN4 T1axbb Taxbb

        PUT CORR_VECa_bb(a,kk1,b,j) = T1axbb(a,kk1,b,j) 

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i
        GET RES2b_aa(b,kk1,a,i)
        GET Rb_aa(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)   = Rb_aa(b,kk1,a,i)
        T1bxaa(b,kk1,a,i)  = RES2b_aa(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)  *= -1.0
        T2bxaa(b,kk1,a,i)  = OMEGA0
        Tbxaa(b,kk1,a,i)  += T2bxaa(b,kk1,a,i)

        EXECUTE APPLY_DEN4 T1bxaa Tbxaa

        PUT CORR_VECb_aa(b,kk1,a,i) = T1bxaa(b,kk1,a,i)

     ENDPARDO b, a, kk1, i

     EXECUTE SIP_BARRIER

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

     PARDO a, kk1
           GET CORR_VECa(a,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1A_HIST(a,kk1,NINDEX50)

              Takk(a,kk1)   = CORR_VECa(a,kk1)
              T1akk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
              TMP   = Takk(a,kk1) * T1akk(a,kk1)
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO a, kk1

     PARDO b, kk1

           GET CORR_VECb(b,kk1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1B_HIST(b,kk1,NINDEX50)

              Tbkk(b,kk1)   = CORR_VECb(b,kk1)
              T1bkk(b,kk1)  = R1B_HIST(b,kk1,NINDEX50)
              TMP  = Tbkk(b,kk1) * T1bkk(b,kk1)
              SUMB += TMP

           ENDDO NINDEX50
     ENDPARDO  b, kk1

     EXECUTE SIP_BARRIER
     COLLECTIVE  HC_A += SUMA
     COLLECTIVE  HC_B += SUMB
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
     NORM_GHG += HC_B
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO a, kk1

           GET CORR_VECa(a,kk1)
           Takk(a,kk1) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1A_HIST(a,kk1,NINDEX50)

              Takk(a,kk1)   = CORR_VECa(a,kk1)
              T1akk(a,kk1)  = R1A_HIST(a,kk1,NINDEX50)
              T1akk(a,kk1) *= NORM_GHG
              T1akk(a,kk1) *= -1.0
              Takk(a,kk1)  += T1akk(a,kk1)

           ENDDO NINDEX50

          PUT R1a_intmd(a,kk1) = Takk(a,kk1)
     ENDPARDO a, kk1

     PARDO b, kk1

           GET CORR_VECb(b,kk1)
           Tbkk(b,kk1) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1B_HIST(b,kk1,NINDEX50)

              Tbkk(b,kk1)   = CORR_VECb(b,kk1)
              T1bkk(b,kk1)  = R1B_HIST(b,kk1,NINDEX50)
              T1bkk(b,kk1) *= NORM_GHG
              T1bkk(b,kk1) *= -1.0
              Tbkk(b,kk1)  += T1bkk(b,kk1)

           ENDDO NINDEX50

           PUT R1b_intmd(b,kk1) = Tbkk(b,kk1)
     ENDPARDO  b, kk1

# R2a_aa_HIST, R2b_bb_HIST, R2b_aa_HIST and R2a_bb_HIST is zero.

     PARDO a, a1, kk1, i

           GET CORR_VECa_aa(a,kk1,a1,i)

           Taxaa(a,kk1,a1,i)  = CORR_VECa_aa(a,kk1,a1,i)
           PUT R2a_aa_intmd(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j

           GET CORR_VECb_bb(b,kk1,b1,j)

           Tbxbb(b,kk1,b1,j)  = CORR_VECb_bb(b,kk1,b1,j)
           PUT R2b_bb_intmd(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

           GET CORR_VECa_bb(a,kk1,b,j)

           Taxbb(a,kk1,b,j)  = CORR_VECa_bb(a,kk1,b,j)
           PUT R2a_bb_intmd(a,kk1,b,j) = Taxbb(a,kk1,b,j)

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i

           GET CORR_VECb_aa(b,kk1,a,i)

           Tbxaa(b,kk1,a,i)  = CORR_VECb_aa(b,kk1,a,i)
           PUT R2b_aa_intmd(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

     ENDPARDO b, a, kk1, i

     EXECUTE SIP_BARRIER

# Final normalization

     SUMA    = 0.0
     SUMB    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     SUMAA_B = 0.0
     SUMBB_A = 0.0
     HC_A    = 0.0
     HC_B    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0
     HC_AAB  = 0.0
     HC_BBA  = 0.0
     TMPA    = 0.0
     TMPB    = 0.0

     PARDO a, kk1

            GET  R1a_intmd(a,kk1)
            Takk(a,kk1) = R1a_intmd(a,kk1)
            TMP   = Takk(a,kk1) * Takk(a,kk1)
            HC_A += TMP

      ENDPARDO a, kk1


      PARDO b, kk1

            GET R1b_intmd(b,kk1)
            Tbkk(b,kk1) =  R1b_intmd(b,kk1)
            TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
            HC_B += TMP

      ENDPARDO b, kk1

      PARDO a, a1, kk1, i

              GET R2a_aa_intmd(a,kk1,a1,i)
              Taxaa(a,kk1,a1,i) = R2a_aa_intmd(a,kk1,a1,i)

              TMP   = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
              HC_AAA += TMP

      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j

              GET R2b_bb_intmd(b,kk1,b1,j)
              Tbxbb(b,kk1,b1,j) = R2b_bb_intmd(b,kk1,b1,j)

              TMP   = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
              HC_BBB +=  TMP

     ENDPARDO b, b1, kk1, j

     EXECUTE SIP_BARRIER

     PARDO a, b, kk1, j

              GET R2a_bb_intmd(a,kk1,b,j)
              Taxbb(a,kk1,b,j) = R2a_bb_intmd(a,kk1,b,j)

              TMP   = Taxbb(a,kk1,b,j) * Taxbb(a,kk1,b,j)
              HC_BBA +=  TMP

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i

              GET R2b_aa_intmd(b,kk1,a,i)
              Tbxaa(b,kk1,a,i) = R2b_aa_intmd(b,kk1,a,i)

              TMP = Tbxaa(b,kk1,a,i) * Tbxaa(b,kk1,a,i) 
              HC_AAB +=  TMP

     ENDPARDO b, a, kk1, i

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMB    += HC_B
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB
     COLLECTIVE  SUMAA_B += HC_AAB
     COLLECTIVE  SUMBB_A += HC_BBA

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
     SUM_R += SUMAA_B
     SUM_R += SUMBB_A
#bgn_debug
#     execute print_scalar SUM_R
#end_denug
     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     PARDO a, kk1

            GET  R1a_intmd(a,kk1)
            Takk(a,kk1) = R1a_intmd(a,kk1)
            Takk(a,kk1) *= INV_SQRT_NORM_R
            PUT R1a(a,kk1) = Takk(a,kk1)

      ENDPARDO a, kk1

      PARDO b, kk1

            GET  R1b_intmd(b,kk1)
            Tbkk(b,kk1)  =  R1b_intmd(b,kk1)
            Tbkk(b,kk1) *=  INV_SQRT_NORM_R
            PUT  R1b(b,kk1) = Tbkk(b,kk1)

      ENDPARDO b, kk1

      EXECUTE SIP_BARRIER

      PARDO a, a1, kk1, i

              GET R2a_aa_intmd(a,kk1,a1,i)
              Taxaa(a,kk1,a1,i)  = R2a_aa_intmd(a,kk1,a1,i)
              Taxaa(a,kk1,a1,i) *= INV_SQRT_NORM_R
              PUT R2a_aa(a,kk1,a1,i) = Taxaa(a,kk1,a1,i)
      ENDPARDO a, a1, kk1, i

      PARDO b, b1, kk1, j

              GET R2b_bb_intmd(b,kk1,b1,j)
              Tbxbb(b,kk1,b1,j)  = R2b_bb_intmd(b,kk1,b1,j)
              Tbxbb(b,kk1,b1,j) *= INV_SQRT_NORM_R
              PUT R2b_bb(b,kk1,b1,j) = Tbxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j

              GET R2a_bb_intmd(a,kk1,b,j)
              Taxbb(a,kk1,b,j)  = R2a_bb_intmd(a,kk1,b,j)
              Taxbb(a,kk1,b,j) *= INV_SQRT_NORM_R
              PUT R2a_bb(a,kk1,b,j) = Taxbb(a,kk1,b,j)

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i

              GET R2b_aa_intmd(b,kk1,a,i)
              Tbxaa(b,kk1,a,i)  = R2b_aa_intmd(b,kk1,a,i)
              Tbxaa(b,kk1,a,i) *= INV_SQRT_NORM_R
              PUT R2b_aa(b,kk1,a,i) = Tbxaa(b,kk1,a,i)

     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER
#bgn_debug
#      sumab=0.0
#      tmpa=0.0
