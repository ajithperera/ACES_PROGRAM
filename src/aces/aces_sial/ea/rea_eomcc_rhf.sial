#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab+=suma
#      execute print_scalar sumab
#end_debug

     ENDPROC FORM_RESIDUAL_VEC
#    -----------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     SUMAAB = 0.0
     SUMBBA = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0
     HC_AAB = 0.0
     HC_BBA = 0.0

     PARDO a, kk1

           GET RES1a(a,kk1)

           Takk(a,kk1)   = RES1a(a,kk1)

           TMP   = Takk(a,kk1) * Takk(a,kk1)
           SUMA += TMP

     ENDPARDO a, kk1

     PARDO b, kk1

           GET RES1b(b,kk1)

           Tbkk(b,kk1)  = RES1b(b,kk1)

           TMP   = Tbkk(b,kk1) * Tbkk(b,kk1)
           SUMB += TMP

     ENDPARDO b, kk1

     PARDO a, a1, kk1, i

           GET RES2a_aa(a,kk1,a1,i)

           Taxaa(a,kk1,a1,i)  = RES2a_aa(a,kk1,a1,i)

           TMP     = Taxaa(a,kk1,a1,i) * Taxaa(a,kk1,a1,i)
           SUMAAA += TMP

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j
           GET RES2b_bb(b,kk1,b1,j)

           Tbxbb(b,kk1,b1,j)  = RES2b_bb(b,kk1,b1,j)

           TMP     = Tbxbb(b,kk1,b1,j) * Tbxbb(b,kk1,b1,j)
           SUMBBB += TMP

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
           GET RES2a_bb(a,kk1,b,j)

           Taxbb(a,kk1,b,j)  = RES2a_bb(a,kk1,b,j)

           TMP     = Taxbb(a,kk1,b,j) * Taxbb(a,kk1,b,j)
           SUMAAB += TMP

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i
           GET RES2b_aa(b,kk1,a,i)

           Tbxaa(b,kk1,a,i)  = RES2b_aa(b,kk1,a,i)

           TMP   = Tbxaa(b,kk1,a,i) * Tbxaa(b,kk1,a,i)
           SUMBBA += TMP

     ENDPARDO b, a, kk1, i

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A += SUMA
     COLLECTIVE HC_B += SUMB
     COLLECTIVE HC_AAA += SUMAAA
     COLLECTIVE HC_BBB += SUMBBB
     COLLECTIVE HC_AAB += SUMAAB
     COLLECTIVE HC_BBA += SUMBBA

     A_VALUE  = HC_A
     A_VALUE += HC_B
     A_VALUE += HC_AAA
     A_VALUE += HC_BBB
     A_VALUE += HC_AAB
     A_VALUE += HC_BBA

     EXECUTE SIP_BARRIER
#bgn_debug
#     execute print_scalar A_value 
#end_debug

     HALF = 0.5
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------
    PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

    DO kk1
        DO a
           GET RES1a(a,kk1)
           GET Ra(a,kk1)

           Takk(a,kk1)   = Ra(a,kk1)
           T1akk(a,kk1)  = RES1a(a,kk1)

           Takk(a,kk1)  *= -1.0
           T2akk(a,kk1)  = OMEGA
           Takk(a,kk1)  += T2akk(a,kk1)

           EXECUTE APPLY_DEN2_NOR  T1akk Takk

           PUT CORR_VECa(a,kk1) =  T1akk(a,kk1)

         ENDDO a
     ENDDO kk1

     DO kk1
         DO b
            GET RES1b(b,kk1)
            GET Rb(b,kk1)

            Tbkk(b,kk1)   = Rb(b,kk1)
            T1bkk(b,kk1)  = RES1b(b,kk1)

            Tbkk(b,kk1)  *= -1.0
            T2bkk(b,kk1)  = OMEGA
            Tbkk(b,kk1)  += T2bkk(b,kk1)

            EXECUTE APPLY_DEN2_NOR  T1bkk Tbkk

            PUT CORR_VECb(b,kk1) =  T1bkk(b,kk1)

         ENDDO b
     ENDDO kk1

     PARDO a, a1, kk1, i
         GET RES2a_aa(a,kk1,a1,i)
         GET Ra_aa(a,kk1,a1,i)

         Taxaa(a,kk1,a1,i)  = Ra_aa(a,kk1,a1,i)
         T1axaa(a,kk1,a1,i) = RES2a_aa(a,kk1,a1,i)

         Taxaa(a,kk1,a1,i) *= -1.0
         T2axaa(a,kk1,a1,i) = OMEGA
         Taxaa(a,kk1,a1,i)  += T2axaa(a,kk1,a1,i)

         EXECUTE APPLY_DEN4 T1axaa Taxaa

         PUT CORR_VECa_aa(a,kk1,a1,i) = T1axaa(a,kk1,a1,i)

     ENDPARDO a, a1, kk1, i

     PARDO b, b1, kk1, j
         GET RES2b_bb(b,kk1,b1,j)
         GET Rb_bb(b,kk1,b1,j)

         Tbxbb(b,kk1,b1,j)  = Rb_bb(b,kk1,b1,j)
         T1bxbb(b,kk1,b1,j) = RES2b_bb(b,kk1,b1,j)

         Tbxbb(b,kk1,b1,j)  *= -1.0
         T2bxbb(b,kk1,b1,j)  = OMEGA
         Tbxbb(b,kk1,b1,j)  += T2bxbb(b,kk1,b1,j)

         EXECUTE APPLY_DEN4 T1bxbb Tbxbb

         PUT CORR_VECb_bb(b,kk1,b1,j) = T1bxbb(b,kk1,b1,j)

     ENDPARDO b, b1, kk1, j

     PARDO a, b, kk1, j
        GET RES2a_bb(a,kk1,b,j)
        GET Ra_bb(a,kk1,b,j)

        Taxbb(a,kk1,b,j)   = Ra_bb(a,kk1,b,j)
        T1axbb(a,kk1,b,j)  = RES2a_bb(a,kk1,b,j)

        Taxbb(a,kk1,b,j)  *= -1.0
        T2axbb(a,kk1,b,j)  = OMEGA
        Taxbb(a,kk1,b,j) += T2axbb(a,kk1,b,j)

        EXECUTE APPLY_DEN4 T1axbb Taxbb

        PUT CORR_VECa_bb(a,kk1,b,j) = T1axbb(a,kk1,b,j)

     ENDPARDO a, b, kk1, j

     PARDO b, a, kk1, i
        GET RES2b_aa(b,kk1,a,i)
        GET Rb_aa(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)   = Rb_aa(b,kk1,a,i)
        T1bxaa(b,kk1,a,i)  = RES2b_aa(b,kk1,a,i)

        Tbxaa(b,kk1,a,i)  *= -1.0
        T2bxaa(b,kk1,a,i)  = OMEGA
        Tbxaa(b,kk1,a,i)  += T2bxaa(b,kk1,a,i)

        EXECUTE APPLY_DEN4 T1bxaa Tbxaa

        PUT CORR_VECb_aa(b,kk1,a,i) = T1bxaa(b,kk1,a,i)

     ENDPARDO b, a, kk1, i

     EXECUTE SIP_BARRIER

#bgn_debug
