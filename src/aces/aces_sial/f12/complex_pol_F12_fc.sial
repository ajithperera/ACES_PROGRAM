#--------------------------------------------------
#--------------------------------------------------
      PROC DQ345_IM
#     -------------

      create qtl1_x_im
      create qtl1_y_im
      create qtl1_z_im
      create qtl2_x_im
      create qtl2_y_im
      create qtl2_z_im

      create qtl3_x_im
      create qtl3_y_im
      create qtl3_z_im
      create qtl4_x_im
      create qtl4_y_im
      create qtl4_z_im
      create qtl5_x_im
      create qtl5_y_im
      create qtl5_z_im

      create qtl51_x_im
      create qtl51_y_im
      create qtl51_z_im
#----------Zero out arrays--------------------------------|

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl1_x_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl1_y_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl1_z_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl2_x_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl2_y_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl2_z_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier
#------------------------------------------
      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl3_x_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl3_y_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl3_z_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl4_x_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl4_y_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl4_z_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier
#-------------------------

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl5_x_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl5_y_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl5_z_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier
#----------------------------

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl51_x_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl51_y_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl51_z_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier


#---------Auxiliary intermediates-------------------------|

#--------------------------------------------------

      PARDO a,b,i
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#---------------------------------------
      REQUEST l1a_old(i,b) i
      tl1a_old(i,b) = l1a_old(i,b)
      REQUEST t1a_x_im(a,i) i
      tt1a_x(a,i) = t1a_x_im(a,i)
      tmp_int4(a,b) = tt1a_x(a,i)*tl1a_old(i,b)
      PUT qtl1_x_im(a,b) += tmp_int4(a,b)
      endif
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#---------------------------------------
      REQUEST l1a_old(i,b) i
      tl1a_old(i,b) = l1a_old(i,b)
      REQUEST t1a_y_im(a,i) i
      tt1a_y(a,i) = t1a_y_im(a,i)
      tmp_int4(a,b) = tt1a_y(a,i)*tl1a_old(i,b)
      PUT qtl1_y_im(a,b) += tmp_int4(a,b)
      endif  
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#---------------------------------------
      REQUEST l1a_old(i,b) i
      tl1a_old(i,b) = l1a_old(i,b)
      REQUEST t1a_z_im(a,i) i
      tt1a_z(a,i) = t1a_z_im(a,i)
      tmp_int4(a,b) = tt1a_z(a,i)*tl1a_old(i,b)
      PUT qtl1_z_im(a,b) += tmp_int4(a,b)
      endif
      ENDPARDO a,b,i
      execute sip_barrier
#--------------------------------------------------

      PARDO i,j,a
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST l1a_old(j,a) j
      tl1a_old(j,a) = l1a_old(j,a)
      REQUEST t1a_x_im(a,i) i
      tt1a_x(a,i) = t1a_x_im(a,i)
      tmp_int5(i,j) = tt1a_x(a,i)*tl1a_old(j,a)
      PUT qtl2_x_im(i,j) += tmp_int5(i,j)
      endif
      endif
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST l1a_old(j,a) j
      tl1a_old(j,a) = l1a_old(j,a)
      REQUEST t1a_y_im(a,i) i
      tt1a_y(a,i) = t1a_y_im(a,i)
