      PROC DQ8 
#     --------


#-------------Zero out intermediate arrays-----------
      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xx_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xy_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xz_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_yy_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_yz_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_zz_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier
#----------------------------------------------------
      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xx_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xy_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_xz_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_yy_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_yz_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T1_zz_ab_im(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier
#----------------------------------------------------



#----Intermediates with cluster amlitudes: T(a,i,b,j)+t(a,i)*t(b,j)----|
      PARDO a,i,a1,i1
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(i1)   = wOccA_frag(i1)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      REQUEST T2old_aa(a,i,a1,i1) a
      GET t1a_old(a,i)  
      GET t1a_old(a1,i1)
      GET t1a_old(a,i1)
      GET t1a_old(a1,i)
      t2_aa(a,i,a1,i1) = T2old_aa(a,i,a1,i1)
      taix(a,i) = t1a_old(a,i)
      taix1(a1,i1) = t1a_old(a1,i1)
      taix2(a,i1) = t1a_old(a,i1)
      taix3(a1,i) = t1a_old(a1,i)
      tt_aa(a,i,a1,i1) = taix(a,i)^taix1(a1,i1)
      tt1_aa(a,i1,a1,i) = taix2(a,i1)^taix3(a1,i)
      tt2_aa(a,i,a1,i1) = tt1_aa(a,i1,a1,i)
      tt_aa(a,i,a1,i1) -= tt2_aa(a,i,a1,i1)
      t2_aa(a,i,a1,i1) += tt_aa(a,i,a1,i1)
      t2_aa(a,i,a1,i1) *= 0.5
      PREPARE Tau_aa(a,i,a1,i1) = t2_aa(a,i,a1,i1)
      endif
      endif
      ENDPARDO a,i,a1,i1
      execute server_barrier
#------------------------------------------------------------|
      PARDO a,i,b,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
