      if l2 == two
#---------------------------------------
      GET qtl6_z_im(a,i)
      GET qtl9_z_im(a,i)
      tmpval = qtl6_z_im(a,i)*qtl9_z_im(a,i)
      tmpval *= -4.0
      PROP_zz_aux += tmpval
      endif   
      ENDPARDO i,a
