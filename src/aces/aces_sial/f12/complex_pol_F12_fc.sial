      if l3 == two
#----------------------------------------
      REQUEST t1a_x(a,k) a
      REQUEST qtl16_z(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_z(k,i,b,j)*t1a_x(a,k)
      intt2t2(a,i,b,j) *= -0.5
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST t1a_z(a,k) a
      REQUEST qtl16_x(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_x(k,i,b,j)*t1a_z(a,k)
      intt2t2(a,i,b,j) *= -0.5
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j) 
      endif
      ENDDO k
#------------Permutations----------------------------------
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0

      PREPARE INTT1T2_xz(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xz(b,i,a,j) += intt1t1_p1(b,i,a,j)
      endif
      endif   
      ENDPARDO a,i,b,j
      execute server_barrier
#-------------yy-component------------------------------
      PARDO a,i,b,j
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
