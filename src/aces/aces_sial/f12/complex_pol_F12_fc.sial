      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_y_im(b,j) j
      T2_y(b,j) = t1a_y_im(b,j)
      REQUEST Vpiqj(a,j,b,i) a
      tmp_int6(a,i) = Vpiqj(a,j,b,i)*T2_y(b,j)
      PUT qtl9_y_im(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
