#--------Step 3 - contribution to polarizabilities--------|
      PROP_xx_aux = 0.0

      PARDO i,a
#-------------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-------------------------------------------
      GET int6_xx_im(i,a)
