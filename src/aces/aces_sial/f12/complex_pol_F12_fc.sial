      if l3 == two
#-----------------------------------------
      REQUEST int4_yy(b,j,d,i) b
      tmp_int2(b,j,d,i) = int4_yy(b,j,d,i)
      REQUEST L2old_ab(i,b,j,d) i
      tL2old_ab(i,b,j,d) = L2old_ab(i,b,j,d)
      tmpval = tL2old_ab(i,b,j,d)*tmp_int2(b,j,d,i)
      tmpval *= -2.0
      PROP_yy_aux += tmpval
      endif
      endif
      ENDPARDO i,b,j,d
      execute server_barrier

      collective PROP_yy_4_2 += PROP_yy_aux

      PROP_yy_aux = 0.0

      PARDO j,a,b,k
#-----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST int5_yy(a,j,b,k) a
      tmp_int2(a,j,b,k) = int5_yy(a,j,b,k)
      REQUEST L2old_ab(j,a,k,b) j
      tL2old_ab(j,a,k,b) = L2old_ab(j,a,k,b)
      tmpval = tL2old_ab(j,a,k,b)*tmp_int2(a,j,b,k)
      tmpval *= -4.0
      PROP_yy_aux += tmpval
      endif
      endif
      ENDPARDO j,a,b,k
      execute server_barrier

      collective PROP_yy_4_3 += PROP_yy_aux

      PROP_yy_aux = 0.0

      PARDO j,a,b,k
#------------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST int5_yy(b,j,a,k) a
      tmp_int2(b,j,a,k) = int5_yy(b,j,a,k)
      REQUEST L2old_ab(j,a,k,b) j
      tL2old_ab(j,a,k,b) = L2old_ab(j,a,k,b)
      tmpval = tL2old_ab(j,a,k,b)*tmp_int2(b,j,a,k)
      tmpval *= 2.0
      PROP_yy_aux += tmpval
      endif
      endif
      ENDPARDO j,a,b,k
      execute server_barrier

      collective PROP_yy_4_4 += PROP_yy_aux
#-------------yz-component-----------------------|
