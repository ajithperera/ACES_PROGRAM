#--------Step 3 - contribution to polarizabilities--------|
      PROP_xx_aux = 0.0

      PARDO i,a 
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      GET int6_xx(i,a)
      tmp_int(i,a) = int6_xx(i,a)
      REQUEST l1a_old(i,a) i
      tl1a_old(i,a) = l1a_old(i,a) 
      tmpval = tl1a_old(i,a)*tmp_int(i,a)
      tmpval *= 2.0  
      PROP_xx_aux += tmpval
      endif        
      ENDPARDO i,a
      execute server_barrier 

      collective PROP_xx_5_1 += PROP_xx_aux

      PROP_xy_aux = 0.0

