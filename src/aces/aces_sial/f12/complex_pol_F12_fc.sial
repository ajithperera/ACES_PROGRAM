      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      intt2t2(a,i,b,j) = 0.0
      intt2t2_p(b,j,a,i) = 0.0
      DO k
#-----------------------------------------
      xi2(k)   = wOccA_frag(k)
