      PROC DQ8_f12
#     ------------

#--------------------------
      PROP_xx_f12_1 = 0.0
      PROP_xx_f12_2 = 0.0

      PROP_xy_f12_1 = 0.0
      PROP_xy_f12_2 = 0.0

      PROP_xz_f12_1 = 0.0
      PROP_xz_f12_2 = 0.0

      PROP_yy_f12_1 = 0.0
      PROP_yy_f12_2 = 0.0

      PROP_yz_f12_1 = 0.0
      PROP_yz_f12_2 = 0.0

      PROP_zz_f12_1 = 0.0
      PROP_zz_f12_2 = 0.0
#--------------------------
#
#--------xx component-----------------------
      PROP_xx_aux = 0.0

      PARDO a,i,b,j
#-------------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-------------------------------------------
      REQUEST T2_1(a,i,b,j) i
      REQUEST qi1_xx(a,i,b,j) i
      tmpval = T2_1(a,i,b,j)*qi1_xx(a,i,b,j)
      tmpval *= 2.0
      PROP_xx_aux += tmpval 
      endif
      endif
      ENDPARDO a,i,b,j
      execute server_barrier 

      collective PROP_xx_f12_1 += PROP_xx_aux 

      PROP_xx_aux = 0.0

      PARDO a,i,b,j
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-------------------------------------------
      REQUEST T2_1(a,i,b,j) i
      REQUEST qi1_xx(a,j,b,i) i
      tmpval = T2_1(a,i,b,j)*qi1_xx(a,j,b,i)
      tmpval *= -1.0
      PROP_xx_aux += tmpval
      endif
      endif
      ENDPARDO a,i,b,j
      execute server_barrier

      collective PROP_xx_f12_2 += PROP_xx_aux
#--------xy component-----------------------
      PROP_xy_aux = 0.0

      PARDO a,i,b,j
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

