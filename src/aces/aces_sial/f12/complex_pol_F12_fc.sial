#----------Contributions itself----------------------------

#------------diagram dq24-----------------------------

#------------alpha-alpha part-------------------------

#-------------xx-component----------------------------
      PARDO i,a,j,b
#-------------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-------------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(a,j,b,i) = 0.0
      DO k
#-------------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#-------------------------------------------
      REQUEST T2aa_x(a,k,b,j) k
      GET qtl10_x(k,i)
      intt2t2(a,i,b,j) = T2aa_x(a,k,b,j)*qtl10_x(k,i)
      intt2t2(a,i,b,j) *= -2.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      endif
      ENDDO k
#----------Permutations----------------------  
      intt1t1_p(a,j,b,i) = intt1t1(a,i,b,j)
      intt1t1_p(a,j,b,i) *= -1.0
      PREPARE INTT1T2_xx(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xx(a,j,b,i) += intt1t1_p(a,j,b,i)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier
