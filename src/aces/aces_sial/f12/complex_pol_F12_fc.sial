      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
       intt1t1(a,i,b,j) = 0.0
       intt1t1_p1(b,i,a,j) = 0.0
       DO d
       GET qtl23_yy_im(a,d)
       REQUEST T2old_aa(d,i,b,j) d
       intt2t2(a,i,b,j) =  T2old_aa(d,i,b,j)*qtl23_yy_im(a,d)
       intt2t2(a,i,b,j) *= -1.0
       intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
       ENDDO d
#-----------Permutations---------------------
       intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
       intt1t1_p1(b,i,a,j) *= -1.0

       PREPARE INTT1T1_yy_im(a,i,b,j) += intt1t1(a,i,b,j)
       PREPARE INTT1T1_yy_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
       endif
       endif 
       ENDPARDO i,j,a,b
       execute server_barrier
#--------------yz--------------------------------
       PARDO i,j,a,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
       intt1t1(a,i,b,j) = 0.0
       intt1t1_p1(b,i,a,j) = 0.0
       DO d
       GET qtl23_yz_im(a,d)
       REQUEST T2old_aa(d,i,b,j) d
       intt2t2(a,i,b,j) =  T2old_aa(d,i,b,j)*qtl23_yz_im(a,d)
       intt2t2(a,i,b,j) *= -1.0
       intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
       ENDDO d
#-----------Permutations---------------------
       intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
       intt1t1_p1(b,i,a,j) *= -1.0
     
       PREPARE INTT1T1_yz_im(a,i,b,j) += intt1t1(a,i,b,j)
       PREPARE INTT1T1_yz_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
       endif
       endif
       ENDPARDO i,j,a,b
       execute server_barrier
#--------------zz--------------------------------
       PARDO i,j,a,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
       intt1t1(a,i,b,j) = 0.0
       intt1t1_p1(b,i,a,j) = 0.0
       DO d
       GET qtl23_zz_im(a,d)
       REQUEST T2old_aa(d,i,b,j) d
       intt2t2(a,i,b,j) =  T2old_aa(d,i,b,j)*qtl23_zz_im(a,d)
       intt2t2(a,i,b,j) *= -1.0
       intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
       ENDDO d
#-----------Permutations---------------------
       intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
       intt1t1_p1(b,i,a,j) *= -1.0

       PREPARE INTT1T1_zz_im(a,i,b,j) += intt1t1(a,i,b,j)
       PREPARE INTT1T1_zz_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
       endif
       endif
       ENDPARDO i,j,a,b
       execute server_barrier

#----------alpha-beta part----------------------

#--------------xx--------------------------------
       PARDO i,j,a,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
       intt1t1(a,i,b,j) = 0.0
       DO d
       GET qtl23_xx_im(a,d)
       REQUEST T2old_ab(d,i,b,j) d
       intt2t2(a,i,b,j) =  T2old_ab(d,i,b,j)*qtl23_xx_im(a,d)
       intt2t2(a,i,b,j) *= -2.0
       intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
       ENDDO d
       PREPARE INTT1T1_xx_ab_im(a,i,b,j) += intt1t1(a,i,b,j)
       endif
       endif 
       ENDPARDO i,j,a,b
       execute server_barrier
#--------------xy--------------------------------
       PARDO i,j,a,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
       intt1t1(a,i,b,j) = 0.0
