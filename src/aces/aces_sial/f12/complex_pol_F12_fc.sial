      PROC DQ2425_IM
#     --------------  

      create qtl10_x_im
      create qtl10_y_im
      create qtl10_z_im

      create qtl11_x_im
      create qtl11_y_im
      create qtl11_z_im
#------------Zero out intermediates--------------------------
      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl11_x_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl11_y_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl11_z_im(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier
#----------------------------
      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl10_x_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl10_y_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl10_z_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier
#----------Build the intermediates-------------------------

#------------------x-component---------------------
      PARDO i,j,k,a
#------------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two

      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#------------------------------------------
      REQUEST Wiiia(i,j,k,a) i
      REQUEST t1a_x_im(a,k) a
      tmp_int5(i,j) = Wiiia(i,j,k,a)*t1a_x_im(a,k)
      PUT qtl10_x_im(i,j) += tmp_int5(i,j)
      endif
      endif
      endif 
      ENDPARDO i,j,k,a
      execute sip_barrier

      PARDO i,j,k,a
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two

      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#------------------------------------------
      REQUEST Wiijb(i,j,k,a) i
      REQUEST t1a_x_im(a,k) a
      tmp_int5(i,j) = Wiijb(i,j,k,a)*t1a_x_im(a,k)
      PUT qtl10_x_im(i,j) += tmp_int5(i,j)
      endif
      endif
      endif 
      ENDPARDO i,j,k,a
      execute sip_barrier
#------------------y-component---------------------
      PARDO i,j,k,a
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two

      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#------------------------------------------
      REQUEST Wiiia(i,j,k,a) i
