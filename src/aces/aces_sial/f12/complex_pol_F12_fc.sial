      REQUEST Vpiqj(a,i,b,j) a
      REQUEST qi1_yy_im(a,i,b,j) a
      tmpval = Vpiqj(a,i,b,j)*qi1_yy_im(a,i,b,j)
      PROP_yy_aux += tmpval
      endif
      endif 
      ENDPARDO a,i,b,j
      execute server_barrier

      collective PROP_yy_10_2_im += PROP_yy_aux
#--------------yz------------------------------------
