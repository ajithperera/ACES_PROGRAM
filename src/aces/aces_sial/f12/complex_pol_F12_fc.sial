      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_y(b,j) j
      T2_y(b,j) = t1a_y(b,j)
      REQUEST Vpiqj(a,j,b,i) a
      tmp_int6(a,i) = Vpiqj(a,j,b,i)*T2_y(b,j)
      PUT qtl9_y(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_z(b,j) j
      T2_z(b,j) = t1a_z(b,j)
      REQUEST Vpiqj(a,j,b,i) a
      tmp_int6(a,i) = Vpiqj(a,j,b,i)*T2_z(b,j)
      PUT qtl9_z(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier
#-------------------------------------------------------|
#      Contribution to polarizabilities                 |      
#-------------------------------------------------------| 

      PROP_xx_6_1 = 0.0
      PROP_xx_6_2 = 0.0
