      PROC DQ911_IM
#     -------------
#
#----------------------------------------------------------
#----------------------------------------------------------

#-----------------alpha-alpha contribution--------------

#---------------xx-component-------------------------------
      PARDO i,j,a,b
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(a,j,b,i) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      intt1t1_p2(b,j,a,i) = 0.0
      DO k
#-----------------------------------------
      xi3(k)   = wOccA_frag(k)
      execute return_sval xi3 l4
      if l4 == two
#-----------------------------------------
      DO d
      REQUEST qi1_xx_im(d,i,a,k) a
      REQUEST Wiaai(k,d,b,j) j
      intt2t2(a,i,b,j) = qi1_xx_im(d,i,a,k)*Wiaai(k,d,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d
      endif
      ENDDO k
#----------Permutations----------------------  
      intt1t1_p(a,j,b,i) = intt1t1(a,i,b,j)
      intt1t1_p(a,j,b,i) *= -1.0
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0
      intt1t1_p2(b,j,a,i) = intt1t1(a,i,b,j)
#--------------------------------------------
      PREPARE INTT1T1_xx_im(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T1_xx_im(a,j,b,i) += intt1t1_p(a,j,b,i)
      PREPARE INTT1T1_xx_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
      PREPARE INTT1T1_xx_im(b,j,a,i) += intt1t1_p2(b,j,a,i)

      endif
      endif  
      ENDPARDO i,j,a,b
      execute server_barrier
#---------------xy-component-------------------------------

      PARDO i,j,a,b
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(a,j,b,i) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      intt1t1_p2(b,j,a,i) = 0.0
      DO k
#-----------------------------------------
      xi3(k)   = wOccA_frag(k)
      execute return_sval xi3 l4
      if l4 == two
#-----------------------------------------
      DO d
      REQUEST qi1_xy_im(d,i,a,k) a
      REQUEST Wiaai(k,d,b,j) j
      intt2t2(a,i,b,j) = qi1_xy_im(d,i,a,k)*Wiaai(k,d,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d
      endif
      ENDDO k
#----------Permutations----------------------  
      intt1t1_p(a,j,b,i) = intt1t1(a,i,b,j)
      intt1t1_p(a,j,b,i) *= -1.0
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0
      intt1t1_p2(b,j,a,i) = intt1t1(a,i,b,j)
#--------------------------------------------
      PREPARE INTT1T1_xy_im(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T1_xy_im(a,j,b,i) += intt1t1_p(a,j,b,i)
      PREPARE INTT1T1_xy_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
      PREPARE INTT1T1_xy_im(b,j,a,i) += intt1t1_p2(b,j,a,i)

      endif
      endif  
      ENDPARDO i,j,a,b
