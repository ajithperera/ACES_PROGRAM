      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST int4_yy(b,i,d,j) b
      tmp_int2(b,i,d,j) = int4_yy(b,i,d,j)
      REQUEST L2old_ab(i,b,j,d) i
      tL2old_ab(i,b,j,d) = L2old_ab(i,b,j,d)
      tmpval = tL2old_ab(i,b,j,d)*tmp_int2(b,i,d,j)
      tmpval *= 4.0
      PROP_yy_aux += tmpval
      endif
      endif
      ENDPARDO i,b,j,d
      execute server_barrier

      collective PROP_yy_4_1 += PROP_yy_aux

      PROP_yy_aux = 0.0

      PARDO i,b,j,d
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
