#------------------------------------------------

      PROC SUMM_DOUBLES
#     ----------------
      quad_doubles_xx = 0.0
      quad_doubles_xy = 0.0
      quad_doubles_xz = 0.0
      quad_doubles_yy = 0.0
      quad_doubles_yz = 0.0
      quad_doubles_zz = 0.0

      quad_doubles_xx_im = 0.0
      quad_doubles_xy_im = 0.0
      quad_doubles_xz_im = 0.0
      quad_doubles_yy_im = 0.0
      quad_doubles_yz_im = 0.0
      quad_doubles_zz_im = 0.0
#-------xx-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_xx += PROP_xx_9_1
      quad_doubles_xx += PROP_xx_9_2
      quad_doubles_xx += PROP_xx_7_1
      quad_doubles_xx += PROP_xx_7_2
      quad_doubles_xx += PROP_xx_8_1
      quad_doubles_xx += PROP_xx_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_xx_im += PROP_xx_9_1_im
      quad_doubles_xx_im += PROP_xx_9_2_im
      quad_doubles_xx_im += PROP_xx_7_1_im
      quad_doubles_xx_im += PROP_xx_7_2_im
      quad_doubles_xx_im += PROP_xx_8_1_im
      quad_doubles_xx_im += PROP_xx_8_2_im
#-------xy-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_xy += PROP_xy_9_1
      quad_doubles_xy += PROP_xy_9_2
      quad_doubles_xy += PROP_xy_7_1
      quad_doubles_xy += PROP_xy_7_2
      quad_doubles_xy += PROP_xy_8_1
      quad_doubles_xy += PROP_xy_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_xy_im += PROP_xy_9_1_im
      quad_doubles_xy_im += PROP_xy_9_2_im
      quad_doubles_xy_im += PROP_xy_7_1_im
      quad_doubles_xy_im += PROP_xy_7_2_im
      quad_doubles_xy_im += PROP_xy_8_1_im
      quad_doubles_xy_im += PROP_xy_8_2_im
#-------xz-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_xz += PROP_xz_9_1
      quad_doubles_xz += PROP_xz_9_2
      quad_doubles_xz += PROP_xz_7_1
      quad_doubles_xz += PROP_xz_7_2
      quad_doubles_xz += PROP_xz_8_1
      quad_doubles_xz += PROP_xz_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_xz_im += PROP_xz_9_1_im
      quad_doubles_xz_im += PROP_xz_9_2_im
      quad_doubles_xz_im += PROP_xz_7_1_im
      quad_doubles_xz_im += PROP_xz_7_2_im
      quad_doubles_xz_im += PROP_xz_8_1_im
      quad_doubles_xz_im += PROP_xz_8_2_im
#-------yy-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_yy += PROP_yy_9_1
      quad_doubles_yy += PROP_yy_9_2
      quad_doubles_yy += PROP_yy_7_1
      quad_doubles_yy += PROP_yy_7_2
      quad_doubles_yy += PROP_yy_8_1
      quad_doubles_yy += PROP_yy_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_yy_im += PROP_yy_9_1_im
      quad_doubles_yy_im += PROP_yy_9_2_im
      quad_doubles_yy_im += PROP_yy_7_1_im
      quad_doubles_yy_im += PROP_yy_7_2_im
      quad_doubles_yy_im += PROP_yy_8_1_im
      quad_doubles_yy_im += PROP_yy_8_2_im

#-------yz-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_yz += PROP_yz_9_1
      quad_doubles_yz += PROP_yz_9_2
      quad_doubles_yz += PROP_yz_7_1
      quad_doubles_yz += PROP_yz_7_2
      quad_doubles_yz += PROP_yz_8_1
      quad_doubles_yz += PROP_yz_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_yz_im += PROP_yz_9_1_im
      quad_doubles_yz_im += PROP_yz_9_2_im
      quad_doubles_yz_im += PROP_yz_7_1_im
      quad_doubles_yz_im += PROP_yz_7_2_im
      quad_doubles_yz_im += PROP_yz_8_1_im
      quad_doubles_yz_im += PROP_yz_8_2_im
#-------zz-component------------------------------

#-----------Real parts----------------------------
      quad_doubles_zz += PROP_zz_9_1
      quad_doubles_zz += PROP_zz_9_2
      quad_doubles_zz += PROP_zz_7_1
      quad_doubles_zz += PROP_zz_7_2
      quad_doubles_zz += PROP_zz_8_1
      quad_doubles_zz += PROP_zz_8_2
#-----------Imaginary parts-----------------------
      quad_doubles_zz_im += PROP_zz_9_1_im
      quad_doubles_zz_im += PROP_zz_9_2_im
      quad_doubles_zz_im += PROP_zz_7_1_im
      quad_doubles_zz_im += PROP_zz_7_2_im
      quad_doubles_zz_im += PROP_zz_8_1_im
      quad_doubles_zz_im += PROP_zz_8_2_im
#-------------------------------------------------

      ENDPROC SUMM_DOUBLES
#     --------------------


#----------------------------------------------------------
#----------------------------------------------------------

      PROC SCFPOL
#     -----------

#------------------------------
      PROP_xx_scf = 0.0
      PROP_xy_scf = 0.0
      PROP_xz_scf = 0.0
      PROP_yy_scf = 0.0
      PROP_yz_scf = 0.0
      PROP_zz_scf = 0.0
#--------------------------------------------
      PROP_xx_aux = 0.0

      PARDO i,a 
      GET Hbar_derv_x_ai(a,i)
      T2_x(a,i) = Hbar_derv_x_ai(a,i) 
      tmp_int6(a,i) = Hbar_derv_x_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_xx_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xx_scf += PROP_xx_aux
#--------------------------------------------
      PROP_xy_aux = 0.0

      PARDO i,a
      GET Hbar_derv_x_ai(a,i)
      T2_x(a,i) = Hbar_derv_x_ai(a,i)
      GET Hbar_derv_y_ai(a,i)
      tmp_int6(a,i) = Hbar_derv_y_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_xy_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xy_scf += PROP_xy_aux
#--------------------------------------------
      PROP_xz_aux = 0.0

      PARDO i,a
      GET Hbar_derv_x_ai(a,i)
      T2_x(a,i) = Hbar_derv_x_ai(a,i)
      GET Hbar_derv_z_ai(a,i) 
      tmp_int6(a,i) = Hbar_derv_z_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_xz_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xz_scf += PROP_xz_aux
#--------------------------------------------
      PROP_yy_aux = 0.0

      PARDO i,a
      GET Hbar_derv_y_ai(a,i)
      T2_x(a,i) = Hbar_derv_y_ai(a,i)
      tmp_int6(a,i) = Hbar_derv_y_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_yy_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_yy_scf += PROP_yy_aux
#--------------------------------------------
      PROP_yz_aux = 0.0

      PARDO i,a
      GET Hbar_derv_y_ai(a,i)
      T2_x(a,i) = Hbar_derv_y_ai(a,i)
      GET Hbar_derv_z_ai(a,i) 
      tmp_int6(a,i) = Hbar_derv_z_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_yz_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_yz_scf += PROP_yz_aux

#--------------------------------------------
      PROP_zz_aux = 0.0
      
      PARDO i,a
      GET Hbar_derv_z_ai(a,i)
      T2_x(a,i) = Hbar_derv_z_ai(a,i)
      tmp_int6(a,i) = Hbar_derv_z_ai(a,i)
      execute energy_denominator tmp_int6
      tmpval = tmp_int6(a,i)*T2_x(a,i)
      tmpval *= 4.0
      PROP_zz_aux += tmpval
      ENDPARDO i,a

      execute server_barrier

      collective PROP_zz_scf += PROP_zz_aux

#--------------------------------------------
#      execute print_scalar PROP_xx_scf  
#      execute print_scalar PROP_yy_scf
#      execute print_scalar PROP_zz_scf

#-------------------------------------------
      ENDPROC SCFPOL
#     --------------

#---------------------------------------------------------|
#              Begin main program                         |
#---------------------------------------------------------|

#---------------------------------------------------------|
#   Set up fragments for frozen-core calculations         |
#---------------------------------------------------------|

      CALL SET_FRAG

#---------------------------------------------------------|
#           Check if F12 calculation is requested         |
#---------------------------------------------------------|
#      F12CALC = 0.0
#      execute f12info F12CALC
       execute print_scalar F12CALC
#      execute eomeaf12info EAEOMF12CALC
#      IF F12CALC == 0.0
#      EAEOMF12CALC = 1.0
#      ENDIF
#---------------------------------------------------------


      two = 2.0

#---------------------------------------------------------|
#   Read necessary elements of Hbar, integrals, lambda    |
#      amplitudes, and amplitude derivatives              |
#---------------------------------------------------------|
      CALL READ_DATA
#---------------------------------------------------------|
# Calculation of dipole moment integrals and construction |
#    of  Hbar(i) = exp(-T) * dH/dE(i) * exp(T)            |
#---------------------------------------------------------|
      CALL HBAR_DER
#---------------------------------------------------------|
#       Calculation of linear terms:                      |
#      <0|(1+Lambda)[Hbar(i),T(j)]|0> +                   |
#    + <0|(1+Lambda)[Hbar(j),T(i)]|0>                     |
#---------------------------------------------------------|
      CALL LIN_TERMS        

#---------------------------------------------------------|
#---------------------------------------------------------|
#       Calculation of quadratic terms:                   |
#       <0|(1+Lambda)[[Hbar,T(i)],T(j)]|0>                |
#---------------------------------------------------------|
#---------------------------------------------------------|


#---------------------------------------------------------|
#     <0|L1*[[Hbar,T(i)],T(j)]|0> contribution            |
#---------------------------------------------------------|

#===========| Real parts |================================|

#----------diagrams dq1 and dq2---------------------------|
       CALL DQ12 
#----------diagrams dq3,dq4 and dq5-----------------------|
       CALL DQ345
#----------diagram dq6------------------------------------|
       CALL DQ6
#===========| Imaginary part |============================|

#----------diagrams dq1 and dq2---------------------------|
       CALL DQ12_IM
#----------diagrams dq3,dq4 and dq5-----------------------|
       CALL DQ345_IM 
#----------diagram dq6------------------------------------|
       CALL DQ6_IM 
#----------summing up singles contributions---------------|
       CALL SUMM_SINGLES 
       CALL SUMM_SINGLES_IM
#=========================================================|
#=========================================================|

#---------------------------------------------------------|
#     <0|L2*[[Hbar,T2(i)],T2(j)]|0> contribution          |
#---------------------------------------------------------|

#-------Construction of auxilary intermediates------------|
       CALL AUXINTERMT2
       CALL AUXINTERMT2_IM 
#-------Construction of main intermediates----------------|      
       CALL INTERMT2T2
       CALL INTERMT2T2_IM  
#-------Contractions with L2------------------------------|
       CALL L2T2T2
       CALL L2T2T2_IM 
#=========================================================|
#=========================================================|

#---------------------------------------------------------|
#     <0|L2*[[Hbar,T1(i)],T1(j)]|0> contribution          |
#---------------------------------------------------------|

#===========| Real parts |================================|

#----------diagram dq7 contribution-----------------------|
       CALL DQ7
#----------diagrams dq9 and dq11 contribution-------------|
       CALL DQ911
#------diffucult term - diagram dq8-----------------------|
       CALL DQ8
#-------F12 correction - diagram dq8.f12------------------|
#       IF F12CALC == 1.0  
#       CALL DQ8_f12
#       ENDIF
#------Three-body terms-----------------------------------|
       CALL THREE_BODY
#-------Contractions with L2------------------------------|
       CALL L2T1T1

#===========| Imaginary part |============================|

#----------diagram dq7 contribution-----------------------|
       CALL DQ7_IM
#----------diagrams dq9 and dq11 contribution-------------|
       CALL DQ911_IM
#------diffucult term - diagram dq8-----------------------|
#        This part is done in DQ8 procedure               | 
#---------------------------------------------------------|

#------Three-body terms-----------------------------------|        
       CALL THREE_BODY_IM
#-------Contractions with L2------------------------------|
       CALL L2T1T1_IM
#---------------------------------------------------------|
#=========================================================|
#=========================================================|


#---------------------------------------------------------|
#     <0|L2*[[Hbar,T1(i)],T2(j)]|0> contribution          |
#---------------------------------------------------------|


#===========| Real parts |================================|
#----------diagrams dq18 and dq19 contribution------------|
       CALL DQ1819 
#----------diagrams dq24 and dq25 contribution------------|
       CALL DQ2425
#----------diagrams dq12 and dq13 contribution------------|
       CALL DQ1213
#----------diagrams dq15 and dq16 contribution------------|
       CALL DQ1516 

#-------Contractions with L2------------------------------|
       CALL L2T1T2

#===========| Imaginary part |============================|
#----------diagrams dq18 and dq19 contribution------------|
       CALL DQ1819_IM
#----------diagrams dq24 and dq25 contribution------------|
       CALL DQ2425_IM
#----------diagrams dq12 and dq13 contribution------------|
       CALL DQ1213_IM
#----------diagrams dq15 and dq16 contribution------------|
       CALL DQ1516_IM

#-------Contractions with L2------------------------------|
       CALL L2T1T2_IM
#=========================================================|

#----------summing up doubles contributions---------------|
       CALL SUMM_DOUBLES

#---------------------------------------------------------|
#  Easy term: <0|[[Hbar,T1(i)],T1(j)]|0> contribution     |
#---------------------------------------------------------|

#===========| Real part |=================================|
       CALL HT1T1
#===========| Imaginary part |============================|
       CALL HT1T1_IM

#---------------------------------------------------------|
#     Calculate SCF contribution to polarizabilities      | 
#---------------------------------------------------------|

#       CALL SCFPOL

#---------Print out polarizabilities----------------------|

#---------Add simple contribution------------------------|

#      execute print_scalar quad_simple_xx
#      execute print_scalar quad_simple_yy
#      execute print_scalar quad_simple_zz

      PROP_xx += quad_simple_xx
      PROP_xy += quad_simple_xy
      PROP_xz += quad_simple_xz
      PROP_yy += quad_simple_yy
      PROP_yz += quad_simple_yz
      PROP_zz += quad_simple_zz

#---------Add imaginary simple contribution---------------|

      PROP_xx += quad_simple_xx_im
      PROP_xy += quad_simple_xy_im
      PROP_xz += quad_simple_xz_im
      PROP_yy += quad_simple_yy_im
      PROP_yz += quad_simple_yz_im
      PROP_zz += quad_simple_zz_im

#---------Add singles contribution------------------------|  
      PROP_xx += quad_singles_xx
      PROP_xy += quad_singles_xy
      PROP_xz += quad_singles_xz
      PROP_yy += quad_singles_yy
      PROP_yz += quad_singles_yz
      PROP_zz += quad_singles_zz

#---------Add imaginary singles contribution--------------|
      PROP_xx += quad_singles_xx_im
      PROP_xy += quad_singles_xy_im
      PROP_xz += quad_singles_xz_im
      PROP_yy += quad_singles_yy_im
      PROP_yz += quad_singles_yz_im
      PROP_zz += quad_singles_zz_im


#---------Add doubles contributions-----------------------|

      PROP_xx += quad_doubles_xx
      PROP_xy += quad_doubles_xy
      PROP_xz += quad_doubles_xz
      PROP_yy += quad_doubles_yy
      PROP_yz += quad_doubles_yz
      PROP_zz += quad_doubles_zz
#---------Add imaginary doubles contribution--------------|
      PROP_xx += quad_doubles_xx_im
      PROP_xy += quad_doubles_xy_im
      PROP_xz += quad_doubles_xz_im
      PROP_yy += quad_doubles_yy_im
      PROP_yz += quad_doubles_yz_im
      PROP_zz += quad_doubles_zz_im



#------------------------------------------
#      execute print_scalar quad_singles_xx
#      execute print_scalar quad_singles_yy
#      execute print_scalar quad_singles_zz

      execute print_scalar quad_doubles_xx_im
      execute print_scalar quad_doubles_yy_im
      execute print_scalar quad_doubles_zz_im
#------------------------------------------

#--------Add f12 corrections------------------------------|
#      IF F12CALC == 1.0  

      PROP_xx += PROP_xx_f12_1 
      PROP_xx += PROP_xx_f12_2 

      PROP_xy += PROP_xy_f12_1 
      PROP_xy += PROP_xy_f12_2 

      PROP_xz += PROP_xz_f12_1 
      PROP_xz += PROP_xz_f12_2 

      PROP_yy += PROP_yy_f12_1 
      PROP_yy += PROP_yy_f12_2 

      PROP_yz += PROP_yz_f12_1 
      PROP_yz += PROP_yz_f12_2 

      PROP_zz += PROP_zz_f12_1 
      PROP_zz += PROP_zz_f12_2 
#------------------------------

      PROP_xx += PROP_xx_f12_3
      PROP_xx += PROP_xx_f12_4

#     execute print_scalar PROP_xx_f12_3
#     execute print_scalar PROP_xx_f12_4

      PROP_xy += PROP_xy_f12_3_1
      PROP_xy += PROP_xy_f12_4_1

      PROP_xy += PROP_xy_f12_3_2
      PROP_xy += PROP_xy_f12_4_2

      PROP_xz += PROP_xz_f12_3_1
      PROP_xz += PROP_xz_f12_4_1

      PROP_xz += PROP_xz_f12_3_2
      PROP_xz += PROP_xz_f12_4_2

      PROP_yy += PROP_yy_f12_3
      PROP_yy += PROP_yy_f12_4

      PROP_yz += PROP_yz_f12_3_1
      PROP_yz += PROP_yz_f12_4_1

      PROP_yz += PROP_yz_f12_3_2
      PROP_yz += PROP_yz_f12_4_2

      PROP_zz += PROP_zz_f12_3
      PROP_zz += PROP_zz_f12_4
#-------------------------------
      PROP_xx += PROP_xx_f12_5
      PROP_xx += PROP_xx_f12_6

#      execute print_scalar PROP_xx_f12_6
#      execute print_scalar PROP_xx_f12_6
      
      PROP_xy += PROP_xy_f12_5
      PROP_xy += PROP_xy_f12_6

      PROP_xz += PROP_xz_f12_5
      PROP_xz += PROP_xz_f12_6

      PROP_yy += PROP_yy_f12_5
      PROP_yy += PROP_yy_f12_6

      PROP_yz += PROP_yz_f12_5
      PROP_yz += PROP_yz_f12_6

      PROP_zz += PROP_zz_f12_5
      PROP_zz += PROP_zz_f12_6
#-------------------------------

#      ENDIF


      execute server_barrier
#---------------------------------------------------------|

      execute print_scalar PROP_xx
      execute print_scalar PROP_xy
      execute print_scalar PROP_xz
      execute print_scalar PROP_yy
      execute print_scalar PROP_yz
      execute print_scalar PROP_zz

#-------Print out information to summary.out file----------|

      printnumber = 44.0 

