      served qtl16_z(i,j,a,k) 

      served qtl17_x(i,j,a,k)
      served qtl17_y(i,j,a,k)
      served qtl17_z(i,j,a,k)

      served qtl18_x(b,d,a,k)
      served qtl18_y(b,d,a,k)
      served qtl18_z(b,d,a,k)

      served qtl19_x(b,d,a,k)
      served qtl19_y(b,d,a,k)
      served qtl19_z(b,d,a,k)

      served qtl20_x(a,b,i,j)
