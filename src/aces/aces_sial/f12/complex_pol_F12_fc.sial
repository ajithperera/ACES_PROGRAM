#-----------------------------------------------------------------

#-----Step 1 - transformation of T1-derivatives to AO basis-------

#-------------First transformation--------------------------------
#
#----------xx------------------------

      PARDO mu,i,b,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      tmp_pppp3(mu,i,b,j) = 0.0
      DO a
      REQUEST qi1_xx(a,i,b,j) b
      tmp_pppp4(mu,i,b,j) = qi1_xx(a,i,b,j)*ca(mu,a)
      tmp_pppp3(mu,i,b,j) += tmp_pppp4(mu,i,b,j)
      ENDDO a
      PREPARE int_pppp2_xx(mu,i,b,j) += tmp_pppp3(mu,i,b,j)
      endif
      endif
      ENDPARDO mu,i,b,j
      execute server_barrier
#---------------------------
      PARDO mu,i,b,j
#---------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      tmp_pppp3(mu,i,b,j) = 0.0
      DO a
      REQUEST qi1_xx_im(a,i,b,j) b
      tmp_pppp4(mu,i,b,j) = qi1_xx_im(a,i,b,j)*ca(mu,a)
      tmp_pppp3(mu,i,b,j) += tmp_pppp4(mu,i,b,j)
      ENDDO a
      PREPARE int_pppp2_xx_im(mu,i,b,j) += tmp_pppp3(mu,i,b,j)
      endif
      endif
      ENDPARDO mu,i,b,j
      execute server_barrier  

#----------xy------------------------

      PARDO mu,i,b,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      tmp_pppp3(mu,i,b,j) = 0.0
