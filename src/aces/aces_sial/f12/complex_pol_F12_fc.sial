      ENDPROC DQ12
#     ------------

#---------------------------------------------------------|
#---------------------------------------------------------|
      PROC DQ12_IM
#     ------------  

#-----Step 1 - t_x_ia * t_x1_ia intermediates-------------|

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,i) i
      REQUEST t1a_x_im(b,j) j
      tt1a_x(a,i) = t1a_x_im(a,i)
      T2_x(b,j) = t1a_x_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_x(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_xx_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_y_im(a,i) i
      REQUEST t1a_y_im(b,j) j
      tt1a_y(a,i) = t1a_y_im(a,i)
      T2_y(b,j) = t1a_y_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_y(a,i)^T2_y(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_yy_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_z_im(a,i) i
      REQUEST t1a_z_im(b,j) j
      tt1a_z(a,i) = t1a_z_im(a,i)
      T2_z(b,j) = t1a_z_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_z(a,i)^T2_z(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_zz_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,i) i
      REQUEST t1a_y_im(b,j) j
      tt1a_x(a,i) = t1a_x_im(a,i)
      T2_y(b,j) = t1a_y_im(b,j)
      REQUEST t1a_y_im(a,i) i
      REQUEST t1a_x_im(b,j) j
      tt1a_y(a,i) = t1a_y_im(a,i)
      T2_x(b,j) = t1a_x_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_y(b,j)
      tmp_int3(a,i,b,j) = tt1a_y(a,i)^T2_x(b,j)
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_xy_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif 
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,i) i
      REQUEST t1a_z_im(b,j) j
      tt1a_x(a,i) = t1a_x_im(a,i)
      T2_z(b,j) = t1a_z_im(b,j)
      REQUEST t1a_z_im(a,i) i
      REQUEST t1a_x_im(b,j) j
      tt1a_z(a,i) = t1a_z_im(a,i)
      T2_x(b,j) = t1a_x_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_z(b,j)
      tmp_int3(a,i,b,j) = tt1a_z(a,i)^T2_x(b,j)
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_xz_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_y_im(a,i) i
      REQUEST t1a_z_im(b,j) j
      tt1a_y(a,i) = t1a_y_im(a,i)
      T2_z(b,j) = t1a_z_im(b,j)
      REQUEST t1a_z_im(a,i) i
      REQUEST t1a_y_im(b,j) j
      tt1a_z(a,i) = t1a_z_im(a,i)
      T2_y(b,j) = t1a_y_im(b,j)
      tmp_int2(a,i,b,j) = tt1a_y(a,i)^T2_z(b,j)
      tmp_int3(a,i,b,j) = tt1a_z(a,i)^T2_y(b,j)
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_yz_im(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier
