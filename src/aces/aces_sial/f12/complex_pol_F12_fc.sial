#----------Zero out intermediates-----------------
      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl22_xx_im(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j
      tmp_int5(i,j) = 0.0
      PUT qtl22_xy_im(i,j) = tmp_int5(i,j)
