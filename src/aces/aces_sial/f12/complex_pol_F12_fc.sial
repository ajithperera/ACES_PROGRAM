#----------------------------------------
      REQUEST Wiiia(k,i,j,b) i
      REQUEST t1a_x(a,k) a
      intt2t2(a,i,b,j) = Wiiia(k,i,j,b)*t1a_x(a,k)
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      endif 
      ENDDO k
