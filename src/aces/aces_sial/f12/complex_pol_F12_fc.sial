      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      REQUEST int_pppp3_xx(lambda,i,sigma,j) i 
      tmp_pppp5(mu,i,nu,j) =  int_pppp3_xx(lambda,i,sigma,j)*aoint(mu,lambda,nu,sigma)
      PREPARE int_pppp4_xx(mu,i,nu,j) += tmp_pppp5(mu,i,nu,j)
      endif
      endif
      ENDDO j
      ENDDO i
