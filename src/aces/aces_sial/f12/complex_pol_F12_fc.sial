#-----Step 2 - contraction with <mu nu|lambda sigma>--------

#----------------alpha-alpha part---------------------------      

      PARDO mu,nu,lambda,sigma 

         compute_integrals aoint(mu,lambda,nu,sigma)
         compute_integrals aoint1(mu,sigma,nu,lambda)
         aoint2(mu,lambda,nu,sigma) = aoint1(mu,sigma,nu,lambda)
         aoint(mu,lambda,nu,sigma) -= aoint2(mu,lambda,nu,sigma)

#----------xx------------------------
      DO i
      DO j 
#------------------------------------------
      xi(i)   = wOccA_frag(i)
