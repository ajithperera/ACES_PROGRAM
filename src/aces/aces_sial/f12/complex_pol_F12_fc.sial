#-------------Summing up contributions---------------

      quad_simple_xx_im = 0.0
      quad_simple_xy_im = 0.0
      quad_simple_xz_im = 0.0
      quad_simple_yy_im = 0.0
      quad_simple_yz_im = 0.0
      quad_simple_zz_im = 0.0

