      PREPARE Hbar_derv_y_abci(a,b,d,i) = tHbar_derv_abci(a,b,d,i)
      endif 
      ENDPARDO a,b,d,i
      execute server_barrier

      PARDO a,b,d,i
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two
#-----------------------------------------
      t1Hbar_derv_abci(a,b,d,i) = 0.0
        DO j
#-----------------------------------------
      xi2(j)   = wOccA_frag(j)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
        REQUEST T2old_ab(a,j,d,i) a
        tT2old_ab(a,j,d,i) = T2old_ab(a,j,d,i)
        GET dip_pq_y(b,j)
        T2_y(b,j) = dip_pq_y(b,j)
        tHbar_derv_abci(a,b,d,i) = tT2old_ab(a,j,d,i)*T2_y(b,j)
        tHbar_derv_abci(a,b,d,i) *= -1.0
        t1Hbar_derv_abci(a,b,d,i) += tHbar_derv_abci(a,b,d,i)
        endif
        ENDDO j
        PREPARE Hbar_derv_y_abci(a,b,d,i) += t1Hbar_derv_abci(a,b,d,i)
        endif
      ENDPARDO a,b,d,i
      execute server_barrier
#-----------------z-component---------------
      PARDO a,b,d,i
#------------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two
#-----------------------------------------
      tHbar_derv_abci(a,b,d,i) = 0.0
      PREPARE Hbar_derv_z_abci(a,b,d,i) = tHbar_derv_abci(a,b,d,i)
      endif 
      ENDPARDO a,b,d,i
      execute server_barrier

      PARDO a,b,d,i
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two
#-----------------------------------------
      t1Hbar_derv_abci(a,b,d,i) = 0.0
        DO j
#-----------------------------------------
      xi2(j)   = wOccA_frag(j)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
        REQUEST T2old_ab(a,j,d,i) a
        tT2old_ab(a,j,d,i) = T2old_ab(a,j,d,i)
        GET dip_pq_z(b,j)
        T2_z(b,j) = dip_pq_z(b,j)
        tHbar_derv_abci(a,b,d,i) = tT2old_ab(a,j,d,i)*T2_z(b,j)
        tHbar_derv_abci(a,b,d,i) *= -1.0
        t1Hbar_derv_abci(a,b,d,i) += tHbar_derv_abci(a,b,d,i)
        endif
        ENDDO j
        PREPARE Hbar_derv_z_abci(a,b,d,i) += t1Hbar_derv_abci(a,b,d,i)
        endif
      ENDPARDO a,b,d,i
      execute server_barrier
#-------------------------------------------
      ENDPROC HBAR_DER  
#     ----------------

#-----------------------------------------------------------
#-----------------------------------------------------------
      PROC LIN_TERMS
#     --------------   

#-----Zero out scalars--------------------------------------
      PROP_xx = 0.0
      PROP_xy = 0.0
      PROP_xz = 0.0
      PROP_yy = 0.0
      PROP_yz = 0.0
      PROP_zz = 0.0

      PROP_xx_1 = 0.0
      PROP_xy_1_1 = 0.0
      PROP_xy_1_2 = 0.0      
      PROP_xz_1_1 = 0.0
      PROP_xz_1_2 = 0.0
      PROP_yy_1 = 0.0
      PROP_yz_1_1 = 0.0
      PROP_yz_1_2 = 0.0
      PROP_zz_1 = 0.0



#---------------------------------------------------------|
#              Step 1 - easy term:                        |
#    <0|[Hbar(i),T(j)]|0> + <0|[Hbar(j),T(i)]|0>          |
#---------------------------------------------------------|
      
#----------xx component-----------------------------------| 
      PROP_xx_aux = 0.0
 
      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_x(a,i) i
      tt1a_x(a,i) = t1a_x(a,i) 
#      execute dump_amp tt1a_x
      GET Hbar_derv_x_ai(a,i) 
      T2_x(a,i) = Hbar_derv_x_ai(a,i)
      tmpval = T2_x(a,i)*tt1a_x(a,i)
      tmpval *= 4.0
      PROP_xx_aux += tmpval   
      endif 
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xx_1 += PROP_xx_aux 

#----------xy component-----------------------------------|

      PROP_xy_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_x(a,i) i
      tt1a_x(a,i) = t1a_x(a,i)
      GET Hbar_derv_y_ai(a,i)
      T2_y(a,i) = Hbar_derv_y_ai(a,i)
      tmpval = T2_y(a,i)*tt1a_x(a,i)
      tmpval *= 2.0
      PROP_xy_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xy_1_1 += PROP_xy_aux

#--------------------------------------

      PROP_xy_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_y(a,i) i
      tt1a_y(a,i) = t1a_y(a,i)
      GET Hbar_derv_x_ai(a,i)
      T2_x(a,i) = Hbar_derv_x_ai(a,i)
      tmpval = T2_x(a,i)*tt1a_y(a,i)
      tmpval *= 2.0
      PROP_xy_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xy_1_2 += PROP_xy_aux

#----------xz component-----------------------------------|

      PROP_xz_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_x(a,i) i
      tt1a_x(a,i) = t1a_x(a,i)
      GET Hbar_derv_z_ai(a,i)
      T2_z(a,i) = Hbar_derv_z_ai(a,i)
      tmpval = T2_z(a,i)*tt1a_x(a,i)
      tmpval *= 2.0
      PROP_xz_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xz_1_1 += PROP_xz_aux

#--------------------------------------

      PROP_xz_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_z(a,i) i
      tt1a_z(a,i) = t1a_z(a,i)
      GET Hbar_derv_x_ai(a,i)
      T2_x(a,i) = Hbar_derv_x_ai(a,i)
      tmpval = T2_x(a,i)*tt1a_z(a,i)
      tmpval *= 2.0
      PROP_xz_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_xz_1_2 += PROP_xz_aux



#----------yy component-----------------------------------|

      PROP_yy_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_y(a,i) i
      tt1a_y(a,i) = t1a_y(a,i)
#      execute dump_amp tt1a_y
      GET Hbar_derv_y_ai(a,i)
      T2_y(a,i) = Hbar_derv_y_ai(a,i)
      tmpval = T2_y(a,i)*tt1a_y(a,i)
      tmpval *= 4.0
      PROP_yy_aux += tmpval
      endif  
      ENDPARDO i,a

      execute server_barrier

      collective PROP_yy_1 += PROP_yy_aux

#----------yz component-----------------------------------|

      PROP_yz_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_y(a,i) i
      tt1a_y(a,i) = t1a_y(a,i)
      GET Hbar_derv_z_ai(a,i)
      T2_z(a,i) = Hbar_derv_z_ai(a,i)
      tmpval = T2_z(a,i)*tt1a_y(a,i)
      tmpval *= 2.0
      PROP_yz_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_yz_1_1 += PROP_yz_aux

#--------------------------------------

      PROP_yz_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_z(a,i) i
      tt1a_z(a,i) = t1a_z(a,i)
      GET Hbar_derv_y_ai(a,i)
      T2_y(a,i) = Hbar_derv_y_ai(a,i)
      tmpval = T2_y(a,i)*tt1a_z(a,i)
      tmpval *= 2.0
      PROP_yz_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_yz_1_2 += PROP_yz_aux

#----------zz component-----------------------------------|

#      PARDO i,a
#      REQUEST t1a_z(a,i) i
#      tt1a_z(a,i) = t1a_z(a,i)
#      tt1a_z(a,i) *= 2.0
#      execute dump_amp tt1a_z
#      ENDPARDO i,a
#      execute server_barrier  

#      PARDO i,a
#      GET Hbar_derv_z_ai(a,i)
#      T2_z(a,i) = Hbar_derv_z_ai(a,i)
#      execute dump_amp T2_z
#      ENDPARDO i,a
#      execute server_barrier

      PROP_zz_aux = 0.0

      PARDO i,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_z(a,i) i
      tt1a_z(a,i) = t1a_z(a,i)
      GET Hbar_derv_z_ai(a,i)
      T2_z(a,i) = Hbar_derv_z_ai(a,i)
      tmpval = T2_z(a,i)*tt1a_z(a,i)
      tmpval *= 4.0
      PROP_zz_aux += tmpval
      endif
      ENDPARDO i,a

      execute server_barrier

      collective PROP_zz_1 += PROP_zz_aux

      execute print_scalar PROP_xx_1 
      execute print_scalar PROP_yy_1
      execute print_scalar PROP_zz_1
#---------------------------------------------------------|
#              Step 2 - Lambda L1  term:                  |
#    <0|L1*[Hbar(i),T(j)]|0> + <0|L1*[Hbar(j),T(i)]|0>    |
#---------------------------------------------------------|
      create int1_xx
      create int1_xy
      create int1_xz
      create int1_yy
      create int1_yz
      create int1_zz

      create int2_xx
      create int2_xy
      create int2_xz
      create int2_yy
      create int2_yz
      create int2_zz

      create int3_xx
      create int3_xy
      create int3_xz
      create int3_yy
      create int3_yz
      create int3_zz
#----------Zero out intermediates-------------------------|
      PROP_xx_2_1 = 0.0
      PROP_xx_2_2 = 0.0
      PROP_xx_2_3 = 0.0

      PROP_xy_2_1 = 0.0
      PROP_xy_2_2 = 0.0
      PROP_xy_2_3 = 0.0

      PROP_xz_2_1 = 0.0
      PROP_xz_2_2 = 0.0
      PROP_xz_2_3 = 0.0

      PROP_yy_2_1 = 0.0
      PROP_yy_2_2 = 0.0
      PROP_yy_2_3 = 0.0

      PROP_yz_2_1 = 0.0
      PROP_yz_2_2 = 0.0
      PROP_yz_2_3 = 0.0

      PROP_zz_2_1 = 0.0
      PROP_zz_2_2 = 0.0
      PROP_zz_2_3 = 0.0


      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_xx(i,a) = tmp_int(i,a) 
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_xy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier 

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_xz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_yy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_yz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int1_zz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier
#----------------------------------------
      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_xx(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_xy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_xz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_yy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_yz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int2_zz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier
#-----------------------------------------
      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_xx(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_xy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_xz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_yy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_yz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int3_zz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

#----------xx component-----------------------------------|
      PARDO i,a,b 

      REQUEST t1a_x(b,i) i
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      tt1a_x(b,i) = t1a_x(b,i)
      GET Hbar_derv_x_ab(a,b)
      T2_x(a,b) = Hbar_derv_x_ab(a,b)
      tmp_int(i,a) = T2_x(a,b)*tt1a_x(b,i)
      tmp_int(i,a) *= 2.0
      PUT int1_xx(i,a) += tmp_int(i,a)
      endif
      ENDPARDO i,a,b
      execute sip_barrier  

      PARDO i,j,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_x(a,j) j
      tt1a_x(a,j) = t1a_x(a,j)
      GET Hbar_derv_x_ij(i,j)
      T2_x(i,j) = Hbar_derv_x_ij(i,j)
      tmp_int(i,a) = T2_x(i,j)*tt1a_x(a,j)
      tmp_int(i,a) *= 2.0
      PUT int2_xx(i,a) += tmp_int(i,a)
      endif
      endif  
      ENDPARDO i,j,a
      execute sip_barrier
#----------------------------------------------------------
      PARDO i,j,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      GET Hbar_derv_x_ai(b,j)
      T2_x(b,j) = Hbar_derv_x_ai(b,j)
      REQUEST T2ab_x(a,i,b,j) a
      tT2ab_x(a,i,b,j) = T2ab_x(a,i,b,j)      
      tmp_int(i,a) = tT2ab_x(a,i,b,j)*T2_x(b,j) 
      tmp_int(i,a) *= 4.0
      PUT int3_xx(i,a) += tmp_int(i,a)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier 
#---------------Permuted term------------------------------
      PARDO i,j,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      GET Hbar_derv_x_ai(b,j)
      T2_x(b,j) = Hbar_derv_x_ai(b,j)
      REQUEST T2ab_x(a,j,b,i) a
      tT2ab_x(a,j,b,i) = T2ab_x(a,j,b,i)
      tmp_int(i,a) = tT2ab_x(a,j,b,i)*T2_x(b,j)
      tmp_int(i,a) *= -2.0
      PUT int3_xx(i,a) += tmp_int(i,a)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier


#----------xy component-----------------------------------|
      PARDO i,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_x(b,i) i
      tt1a_x(b,i) = t1a_x(b,i)
      GET Hbar_derv_y_ab(a,b)
      T2_y(a,b) = Hbar_derv_y_ab(a,b)
      tmp_int(i,a) = T2_y(a,b)*tt1a_x(b,i)
      PUT int1_xy(i,a) += tmp_int(i,a)
      endif
      ENDPARDO i,a,b
      execute sip_barrier

      PARDO i,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two
#-----------------------------------------
      REQUEST t1a_y(b,i) i
      tt1a_y(b,i) = t1a_y(b,i)
      GET Hbar_derv_x_ab(a,b)
      T2_x(a,b) = Hbar_derv_x_ab(a,b)
      tmp_int(i,a) = T2_x(a,b)*tt1a_y(b,i)
      PUT int1_xy(i,a) += tmp_int(i,a)
      endif
      ENDPARDO i,a,b
      execute sip_barrier
#-----------------------------------------------
      PARDO i,j,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_x(a,j) j
      tt1a_x(a,j) = t1a_x(a,j)
      GET Hbar_derv_y_ij(i,j)
      T2_y(i,j) = Hbar_derv_y_ij(i,j)
      tmp_int(i,a) = T2_y(i,j)*tt1a_x(a,j)
      PUT int2_xy(i,a) += tmp_int(i,a)
      endif
      endif 
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_y(a,j) j
      tt1a_y(a,j) = t1a_y(a,j)
      GET Hbar_derv_x_ij(i,j)
      T2_x(i,j) = Hbar_derv_x_ij(i,j)
      tmp_int(i,a) = T2_x(i,j)*tt1a_y(a,j)
      PUT int2_xy(i,a) += tmp_int(i,a)
      endif
      endif
      ENDPARDO i,j,a
      execute sip_barrier
#-----------------------------------------------
      PARDO i,j,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      GET Hbar_derv_x_ai(b,j)
      T2_x(b,j) = Hbar_derv_x_ai(b,j)
      REQUEST T2ab_y(a,i,b,j) a
      tT2ab_y(a,i,b,j) = T2ab_y(a,i,b,j)
      tmp_int(i,a) = tT2ab_y(a,i,b,j)*T2_x(b,j)
      tmp_int(i,a) *= 2.0
      PUT int3_xy(i,a) += tmp_int(i,a)
      endif
      endif  
      ENDPARDO i,j,a,b
      execute sip_barrier
#------------Permuted term-------------------------
      PARDO i,j,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi3(j)   = wOccA_frag(j)
      execute return_sval xi3 l3
      if l3 == two
#-----------------------------------------
      GET Hbar_derv_x_ai(b,j)
      T2_x(b,j) = Hbar_derv_x_ai(b,j)
      REQUEST T2ab_y(a,j,b,i) a
      tT2ab_y(a,j,b,i) = T2ab_y(a,j,b,i)
      tmp_int(i,a) = tT2ab_y(a,j,b,i)*T2_x(b,j)
      tmp_int(i,a) *= -1.0
      PUT int3_xy(i,a) += tmp_int(i,a)
      endif
      endif
