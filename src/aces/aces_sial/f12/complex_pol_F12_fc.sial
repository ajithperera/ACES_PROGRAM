      execute return_sval xi2 l2
      if l2 == two
#---------------------------------------
      GET qtl7_z_im(a,i)
      GET qtl9_z_im(a,i)
      tmpval = qtl7_z_im(a,i)*qtl9_z_im(a,i)
      tmpval *= 4.0
      PROP_zz_aux += tmpval
      endif
      ENDPARDO i,a
      execute server_barrier

      collective PROP_zz_6_4_im += PROP_zz_aux

