      tmp_int5(i,j) = 0.0
      PUT qtl10_z(i,j) = tmp_int5(i,j)
      ENDPARDO i,j
      execute sip_barrier
#----------Build the intermediates-------------------------
#
#------------------x-component---------------------
      PARDO i,j,k,a
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two

      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#------------------------------------------
      REQUEST Wiiia(i,j,k,a) i
      REQUEST t1a_x(a,k) a       
      tmp_int5(i,j) = Wiiia(i,j,k,a)*t1a_x(a,k)
      PUT qtl10_x(i,j) += tmp_int5(i,j)
      endif
      endif
      endif
      ENDPARDO i,j,k,a 
      execute sip_barrier

