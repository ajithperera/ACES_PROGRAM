#-------------diagram dq12------------------------------

#----------Contributions itself-------------------------

#-----------alpha-alpha components----------------------

#-------------xx-component------------------------------
      PARDO a,i,b,j
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(a,j,b,i) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      intt1t1_p2(b,j,a,i) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      DO d
      REQUEST T2aa_x_im(d,k,b,j) d
      REQUEST qtl12_x_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl12_x_im(a,i,d,k)*T2aa_x_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -2.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST T2ab_x_im(d,k,b,j) d
      REQUEST qtl13_x_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl13_x_im(a,i,d,k)*T2ab_x_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -2.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d
      endif 
      ENDDO k
#-----------Permutations----------------------------------
      intt1t1_p(a,j,b,i) = intt1t1(a,i,b,j)
      intt1t1_p(a,j,b,i) *= -1.0

      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0

      intt1t1_p2(b,j,a,i) = intt1t1(a,i,b,j)

      PREPARE INTT1T2_xx_im(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xx_im(a,j,b,i) += intt1t1_p(a,j,b,i)
      PREPARE INTT1T2_xx_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
      PREPARE INTT1T2_xx_im(b,j,a,i) += intt1t1_p2(b,j,a,i)

      endif
      endif   
      ENDPARDO a,i,b,j
      execute server_barrier
#-------------xy-component------------------------------
      PARDO a,i,b,j
#----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(a,j,b,i) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      intt1t1_p2(b,j,a,i) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      DO d
      REQUEST T2aa_x_im(d,k,b,j) d
      REQUEST qtl12_y_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl12_y_im(a,i,d,k)*T2aa_x_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST T2ab_x_im(d,k,b,j) d
      REQUEST qtl13_y_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl13_y_im(a,i,d,k)*T2ab_x_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST T2aa_y_im(d,k,b,j) d
      REQUEST qtl12_x_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl12_x_im(a,i,d,k)*T2aa_y_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST T2ab_y_im(d,k,b,j) d
      REQUEST qtl13_x_im(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl13_x_im(a,i,d,k)*T2ab_y_im(d,k,b,j)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      ENDDO d
      endif
      ENDDO k
#-----------Permutations----------------------------------
      intt1t1_p(a,j,b,i) = intt1t1(a,i,b,j)
      intt1t1_p(a,j,b,i) *= -1.0

