      intt1t1_p(a,j,b,i) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      intt1t1_p2(b,j,a,i) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      DO d
      REQUEST T2aa_x(d,k,b,j) d
      REQUEST qtl14_x(a,i,d,k) i
      intt2t2(a,i,b,j) = qtl14_x(a,i,d,k)*T2aa_x(d,k,b,j)
      intt2t2(a,i,b,j) *= 2.0
