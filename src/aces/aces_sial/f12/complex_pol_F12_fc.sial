      tmp_int(i,a) = Wiiia(j,i,k,b)*qi1_xx_im(a,j,b,k)
      tmp_int(i,a) *= -1.0
      PUT int6_xx_im(i,a) += tmp_int(i,a)
      endif
      endif
      endif
