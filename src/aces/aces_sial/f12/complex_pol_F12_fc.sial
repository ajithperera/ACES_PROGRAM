      served qtl20_z(a,b,i,j)

      served qtl21_x(a,b,i,j)
      served qtl21_y(a,b,i,j)
      served qtl21_z(a,b,i,j) 
#---------Imaginary parts------------------------

      served qtl12_x_im(a,i,b,j)
      served qtl12_y_im(a,i,b,j)
      served qtl12_z_im(a,i,b,j)

      served qtl13_x_im(a,i,b,j)
      served qtl13_y_im(a,i,b,j)
      served qtl13_z_im(a,i,b,j)

      served qtl14_x_im(a,i,b,j)
