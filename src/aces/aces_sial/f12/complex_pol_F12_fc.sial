      if l3 == two
#-----------------------------------------
      DO d
      REQUEST auxint2_x_im(a,i,d,k) i
      REQUEST T2ab_x_im(d,j,b,k) d
      tT2ab_x(a,i,b,j) = auxint2_x_im(a,i,d,k)*T2ab_x_im(d,j,b,k)
      intt2t2(a,i,b,j) += tT2ab_x(a,i,b,j)
      ENDDO d
