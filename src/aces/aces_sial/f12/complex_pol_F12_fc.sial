      intt2t2(a,i,b,j) = qtl21_z_im(b,d,i,l)*T2ab_z_im(d,j,a,l)
      intt2t2(a,i,b,j) *= -2.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d
