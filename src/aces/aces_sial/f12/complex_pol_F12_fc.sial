       REQUEST T2old_ab(d,i,b,j) d
       intt2t2(a,i,b,j) =  T2old_ab(d,i,b,j)*qtl23_xy_im(a,d)
       intt2t2(a,i,b,j) *= -2.0
       intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
       ENDDO d
       PREPARE INTT1T1_xy_ab_im(a,i,b,j) += intt1t1(a,i,b,j)
