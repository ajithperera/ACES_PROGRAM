      collective PROP_zz_f12_4 += PROP_zz_aux
#-------------------------------------------------

#---------X-containing F12 intermediates---------- 

#--------------Make C-coefficients according to cusp conditions---------------
      PARDO i,j,k,l
      tccusp(i,j,k,l) = 0.0
      execute f12_c_coef tccusp F12_GAMMA
      PREPARE C_coef(i,j,k,l) = tccusp(i,j,k,l)
      ENDPARDO i,j,k,l

      execute server_barrier
#-----------------------------------------------------------------------------

#-----------First set of intermediates----------------------------------------

#-----------Zero out intermedites---------------------------------------------
      PARDO i,j  
      tintx1(i,j) = 0.0
      PREPARE intx1_xx(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier  

      PARDO i,j
      tintx1(i,j) = 0.0
      PREPARE intx1_xy(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier

      PARDO i,j
      tintx1(i,j) = 0.0
      PREPARE intx1_xz(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier

      PARDO i,j
      tintx1(i,j) = 0.0
      PREPARE intx1_yy(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier

      PARDO i,j
      tintx1(i,j) = 0.0
      PREPARE intx1_yz(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier

      PARDO i,j
      tintx1(i,j) = 0.0
      PREPARE intx1_zz(i,j) = tintx1(i,j)
      ENDPARDO i,j
      execute server_barrier

#-----------------------------------------------------------------

#-----------xx-------------------------------
      PARDO i,j,a
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-------------------------------------------
      REQUEST t1a_x(a,j) j
      tt1a_x(a,j) = t1a_x(a,j)
      GET dip_pq_x(a,i)
      T2_x(a,i) = dip_pq_x(a,i)
      tintx1(i,j) = tt1a_x(a,j)*T2_x(a,i) 
      tintx1(i,j) *= 2.0
      PREPARE intx1_xx(i,j) += tintx1(i,j)
      endif
      endif  
      ENDPARDO i,j,a
      execute server_barrier 
#-----------xy-------------------------------
      PARDO i,j,a
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-------------------------------------------
      REQUEST t1a_x(a,j) j
