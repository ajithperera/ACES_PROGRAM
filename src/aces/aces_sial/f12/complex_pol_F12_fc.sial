      execute sip_barrier
#------------Zero out intermediates--------------------------
      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl11_x(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

      PARDO a,b
      tmp_int4(a,b) = 0.0
      PUT qtl11_y(a,b) = tmp_int4(a,b)
      ENDPARDO a,b
      execute sip_barrier

