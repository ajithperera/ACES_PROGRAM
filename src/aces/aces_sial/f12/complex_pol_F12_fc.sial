#--------------------------------------------------------
#--------------------------------------------------------
      PROC DQ6_IM
#     -----------

      create qtl6_x_im
      create qtl6_y_im
      create qtl6_z_im

      create qtl7_x_im
      create qtl7_y_im
      create qtl7_z_im

      create qtl8_x_im
      create qtl8_y_im
      create qtl8_z_im

      create qtl9_x_im
      create qtl9_y_im
      create qtl9_z_im
#--------Zero out arrays----------------------------------|

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_x_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_x_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_x_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_x_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#----------------

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_y_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_y_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_y_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_y_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#----------------
      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_z_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_z_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_z_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_z_im(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#------------------------------------------------

#---------First intermediate-------------------------

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_x_im(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_x_im(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0
      PUT qtl6_x_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_y_im(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_y_im(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0
      PUT qtl6_y_im(a,i) += tmp_int6(a,i)
      endif
      endif   
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_z_im(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_z_im(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0
      PUT qtl6_z_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

#----------Second intermediate-----------------------

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_x_im(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_x_im(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_x_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_y_im(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_y_im(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_y_im(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_z_im(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_z_im(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_z_im(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

#-----------Third intermediate-------------------------


      PARDO i,j,a,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_x_im(b,j) j
      T2_x(b,j) = t1a_x_im(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_x(b,j)
      tmp_int6(a,i) *= 2.0
      PUT qtl8_x_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_y_im(b,j) j
      T2_y(b,j) = t1a_y_im(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_y(b,j)
      tmp_int6(a,i) *= 2.0
      PUT qtl8_y_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_z_im(b,j) j
      T2_z(b,j) = t1a_z_im(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_z(b,j)
      tmp_int6(a,i) *= 2.0
      PUT qtl8_z_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier
#
#-----------Fourth intermediate--------------------------

