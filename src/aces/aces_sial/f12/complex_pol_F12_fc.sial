#--------------------------------------------------------------|
# This code calculate second - order response properties for   |    
#        CCSD(F12) method, according to formula:               |
# d2 E(CCSD(F12))/(dXi dXj) = <0|(1+Lambda)[Hbar(i),T(j)]|0> + |
#            <0|(1+Lambda)[Hbar(j),T(i)]|0> +                  |   
#            <0|(1+Lambda)[[Hbar,T(i)],T(j)]|0>                |
#  Added by Denis Bokhan, Moscow Lomonosov State University,   | 
#                 Moscow, Russian Federation                   | 
#--------------------------------------------------------------|
                       SIAL COMPLEX_POL_F12_fc

#----------------Simple indices--------------------------------|
      index kkk=1,1
      index ind1=1,6
      index   jfrag  = 1, 2 # Nfragments
#--------------------------------------------------------------|
# Indices for molecular orbitals                               |
#--------------------------------------------------------------|
      moaindex i = baocc, eaocc
      moaindex j = baocc, eaocc
      moaindex k = baocc, eaocc
      moaindex l = baocc, eaocc
      moaindex m = baocc, eaocc
      moaindex n = baocc, eaocc

      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc

      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1 = bavirt, eavirt

      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc

      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt

      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt

      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#---------Cluster amplitudes-------------------------------|
      distributed t1a_old(a,i)
      served T2old_aa(a,i,a1,i1)
      served T2old_ab(a,i,b,j)
    
      temp tt1a_old(a,i)
      temp tT2old_aa(a,i,a1,i1)
      temp tT2old_ab(a,i,b,j)
#---------Lambda amplitudes--------------------------------|
     served l1a_old(i,a)
     served L2old_aa(i,a,i1,a1)
     served L2old_ab(i,a,j,b)

     temp tl1a_old(i,a) 
     temp tL2old_aa(i,a,i1,a1)
     temp tL2old_ab(i,a,j,b) 
#---------Cluster amplitude derivatives---------------------|

#------------Real parts-------------
     served t1a_x(a,i)
     served t1a_y(a,i)
     served t1a_z(a,i)

     served T2aa_x(a,i,a1,i1)
     served T2ab_x(a,i,b,j)

     served T2aa_y(a,i,a1,i1)
     served T2ab_y(a,i,b,j)

     served T2aa_z(a,i,a1,i1)
     served T2ab_z(a,i,b,j)
#------------Imaginjary parts-------
     served t1a_x_im(a,i)
     served t1a_y_im(a,i)
     served t1a_z_im(a,i)

     served T2aa_x_im(a,i,a1,i1)
     served T2ab_x_im(a,i,b,j)

     served T2aa_y_im(a,i,a1,i1)
     served T2ab_y_im(a,i,b,j)

     served T2aa_z_im(a,i,a1,i1)
     served T2ab_z_im(a,i,b,j)
#-----------------------------------


     temp tt1a_x(a,i)
     temp tt1a_y(a,i)
     temp tt1a_z(a,i)
     temp tT2aa_x(a,i,a1,i1)
     temp tT2ab_x(a,i,b,j)
     temp tT2aa_y(a,i,a1,i1)
     temp tT2ab_y(a,i,b,j)
     temp tT2aa_z(a,i,a1,i1)
     temp tT2ab_z(a,i,b,j)

     temp T_x(mu,nu)
     temp T_y(mu,nu)
     temp T_z(mu,nu)

     temp T1_x(p,nu)
     temp T1_y(p,nu)
     temp T1_z(p,nu)

     temp T2_x(p,q)
     temp T2_y(p,q)
     temp T2_z(p,q)

     temp aoint(mu,lambda,nu,sigma)
     temp aoint1(mu,lambda,nu,sigma)
     temp aoint2(mu,lambda,nu,sigma)

#--------One-particle elements of Hbar------
      distributed dip_ao_x(mu,nu)
      distributed dip_ao_y(mu,nu)
      distributed dip_ao_z(mu,nu) 

      distributed dip_am_x(p,nu)
      distributed dip_am_y(p,nu)
      distributed dip_am_z(p,nu)

      distributed dip_pq_x(p,q)
      distributed dip_pq_y(p,q)
      distributed dip_pq_z(p,q)

      distributed Uaa(a,a1)
      distributed Ubb(b,b1)
      distributed Uii(i1,i)
      distributed Ujj(j1,j)
      distributed Uia(i,a)
      distributed Ujb(j,b)
#---------Two-particle elements of Hbar-----
      served Wiiii(i,i1,i2,i3)
      served Wjjjj(j,j1,j2,j3)
      served Wiijj(i,i1,j,j1)

      served Waaia(a,a1,i,a2)
      served Wbbjb(b,b1,j,b2)
      served Waajb(a,a1,j,b2)
      served Wbbia(b,b1,i,a2)

      served Wiiia(i1,i,i2,a)
      served Wjjjb(j1,j,j2,b)
      served Wiijb(i1,i,j2,b)
      served Wjjia(j1,j,i2,a)

      served Wiiai(i,i1,a,i2)
      served Wiibj(i,i1,b,j)
      served Wjjai(j,j1,a,i)
      served Wjjbj(j,j1,b,j2)

      served Wiaai(i1,a1,a,i)
      served Wjbbj(j1,b1,b,j)
      served Wiabj(i,a,b,j)
      served Wjbai(j,b,a,i)
      served Wiibb(i1,i,b,b1)
      served Wjjaa(j1,j,a,a1)

      served Waaai(a,a1,a2,i)
      served Wbbbj(b,b1,b2,j)
      served Waabj(a,a1,b,j)
      served Wbbai(b,b1,a,i)

      served Waiaa(a,a1,i,a2) # HBAR_AIBC_aaaa
      served Wbjbb(b,b1,j,b2) # HBAR_AIBC_bbbb
      served Waibb(a,a1,j,b2) # HBAR_AIBC_aabb
      served Wbjaa(b,b1,i,a2) # HBAR_AIBC_bbaa
      served auxint2(a,i,p,j)
      served C_coef(i,j,k,l)
      served CC2(i,j,k,l)
      served cpinterm1(p,a)
      served cpinterm2(p,a)
      served cpinterm4(p,a)

      served Waiia(a,i,i1,a1)
      served Wbjjb(b,j,j1,b1)
      served Waijb(a,i,j,b)
      served Wbjia(b,j,i,a)
      served Hbar_ab_eomea(a,a1)
      served Hbar_ia_eomea(a,i)
      served Hbar_ik_aj_eomea(i,k,a,j)
      served Hbar_ij_ab_eomea(i,j,a,b)
      served Hbar_ai_jb_eomea(a,i,j,b)
      served Hbar_abci_F12(a,a1,i,d)
#-----------Hbar derivatives ------------------------------|
      distributed Hbar_derv_x_ij(i,j)
      distributed Hbar_derv_x_ab(a,b)
      distributed Hbar_derv_x_ia(i,a)
      distributed Hbar_derv_x_ai(a,i)
      served Hbar_derv_x_ijka(i,i1,j,a)
      served Hbar_derv_x_abci(a,b,d,i) 

      distributed Hbar_derv_y_ij(i,j)
      distributed Hbar_derv_y_ab(a,b)
      distributed Hbar_derv_y_ia(i,a)
      distributed Hbar_derv_y_ai(a,i)
      served Hbar_derv_y_ijka(i,i1,j,a)
      served Hbar_derv_y_abci(a,b,d,i)

      distributed Hbar_derv_z_ij(i,j)
      distributed Hbar_derv_z_ab(a,b)
      distributed Hbar_derv_z_ia(i,a)
      distributed Hbar_derv_z_ai(a,i)
      served Hbar_derv_z_ijka(i,i1,j,a)
      served Hbar_derv_z_abci(a,b,d,i)
 
      temp tHbar_derv_ij(i,j)
      temp tHbar_derv_ab(a,b)
      temp tHbar_derv_ia(i,a)
      temp tHbar_derv_ai(a,i)
      temp tHbar_derv_ijka(i,i1,j,a)
      temp tHbar_derv_abci(a,b,d,i)
      temp t1Hbar_derv_ijka(i,j,k,a)
      temp t1Hbar_derv_abci(a,b,d,i)
#-----------Molecular integrals----------------------------|
#      served VSpipi(p1,i,p,i1)
#      served Viaai(i,a1,a,i1)
#      served Vaaii(a,a1,i,i1)
#      served Vaaai(a2,a,a1,i)
#      served VSaaai(a2,a,a1,i)
#      served Vpiqj(p,i,q,j)

      served VSpipi(p1,i,p,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vaaai(a2,a,a1,i)
      served VSaaai(a2,a,a1,i)
      served Vpiqj(p,i,q,j)

      served VSqjqj(q,j,q1,j1)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)


      temp tmp_aaai1(a2,a,a1,i)
      temp tmp_aaai2(a2,a,a1,i)
      temp tmp_aaai3(a2,a,a1,i)
#--------Some intermediates--------------------------------|
      served T2_1(a,i,b,j)      
      served intl2x(i,a,j,b)
      served intl2y(i,a,j,b)
      served intl2z(i,a,j,b)
      served intl2(i,a,j,b)
      temp tintl2(i,a,j,b)
      temp tintl2_1(i,a,j,b)
      temp tintl2_2(i,a,j,b)
      served Xijkl(i,k,j,l)
      served Bx(i,j,k,l)
      served By(i,j,k,l)
      served Bz(i,j,k,l)
      temp tB1(i,j,k,l)
      temp tB2(i,j,k,l)
      temp tB3(i,j,k,l)
      temp tccusp(i,j,k,l)
 
      served intx1_xx(i,j)
      served intx1_xy(i,j) 
      served intx1_xz(i,j)
      served intx1_yy(i,j)
      served intx1_yz(i,j)
      served intx1_zz(i,j)
      temp tintx1(i,j)
      temp tintx2(i,j) 

      served intx2_xx(i,j,k,l)
      served intx2_xy(i,j,k,l)
      served intx2_xz(i,j,k,l)
      served intx2_yy(i,j,k,l)
      served intx2_yz(i,j,k,l)
      served intx2_zz(i,j,k,l)
      temp tintx3(i,j,k,l)
      temp tintx4(i,j,k,l)

      served intx3_xx(i,j,k,l)
      served intx3_xy(i,j,k,l)
      served intx3_xz(i,j,k,l)
      served intx3_yy(i,j,k,l)
      served intx3_yz(i,j,k,l)
      served intx3_zz(i,j,k,l)
      temp tintx5(i,j,k,l)
      temp tintx6(i,j,k,l)


      distributed int1_xx(i,a)
      distributed int1_xy(i,a)
      distributed int1_xz(i,a) 
      distributed int1_yy(i,a)
      distributed int1_yz(i,a)
      distributed int1_zz(i,a) 

      distributed int2_xx(i,a)
      distributed int2_xy(i,a)
      distributed int2_xz(i,a)
      distributed int2_yy(i,a)
      distributed int2_yz(i,a)
      distributed int2_zz(i,a)

      distributed int3_xx(i,a)
      distributed int3_xy(i,a)
      distributed int3_xz(i,a)
      distributed int3_yy(i,a)
      distributed int3_yz(i,a)
      distributed int3_zz(i,a)

      temp tmp_int(i,a)

      served int4_xx(a,i,b,j)
      served int4_xy(a,i,b,j)
      served int4_xz(a,i,b,j)
      served int4_yy(a,i,b,j)
      served int4_yz(a,i,b,j)
      served int4_zz(a,i,b,j)

      served int5_xx(a,i,b,j)
      served int5_xy(a,i,b,j)
      served int5_xz(a,i,b,j)
      served int5_yy(a,i,b,j)
      served int5_yz(a,i,b,j)
      served int5_zz(a,i,b,j)

      temp tmp_int2(a,i,b,j)
      temp tmp_int3(a,i,b,j)

#----------Real parts-------------------
      served qi1_xx(a,i,b,j)
      served qi1_xy(a,i,b,j)
      served qi1_xz(a,i,b,j)
      served qi1_yy(a,i,b,j)
      served qi1_yz(a,i,b,j)
      served qi1_zz(a,i,b,j) 

      served qi2_xx(a,i,b,j)
      served qi2_xy(a,i,b,j)
      served qi2_xz(a,i,b,j)
      served qi2_yy(a,i,b,j)
      served qi2_yz(a,i,b,j)
      served qi2_zz(a,i,b,j)
#----------Imaginary parts--------------
      served qi1_xx_im(a,i,b,j)
      served qi1_xy_im(a,i,b,j)
      served qi1_xz_im(a,i,b,j)
      served qi1_yy_im(a,i,b,j)
      served qi1_yz_im(a,i,b,j)
      served qi1_zz_im(a,i,b,j)

      served qi2_xx_im(a,i,b,j)
      served qi2_xy_im(a,i,b,j)
      served qi2_xz_im(a,i,b,j)
      served qi2_yy_im(a,i,b,j)
      served qi2_yz_im(a,i,b,j)
      served qi2_zz_im(a,i,b,j)
#---------------------------------------

#-----------Real parts------------------
      distributed int6_xx(i,a)
      distributed int6_xy(i,a)
      distributed int6_xz(i,a)
      distributed int6_yy(i,a)
      distributed int6_yz(i,a)
      distributed int6_zz(i,a)

      distributed qtl1_x(a,b)
      distributed qtl1_y(a,b)
      distributed qtl1_z(a,b)  

      temp tmp_int4(a,b)  

      distributed qtl2_x(i,j)
      distributed qtl2_y(i,j)
      distributed qtl2_z(i,j)

      temp tmp_int5(i,j)

      distributed qtl3_x(a,b)
      distributed qtl3_y(a,b)
      distributed qtl3_z(a,b)

#-----------Imaginary parts--------------

      distributed int6_xx_im(i,a)
      distributed int6_xy_im(i,a)
      distributed int6_xz_im(i,a)
      distributed int6_yy_im(i,a)
      distributed int6_yz_im(i,a)
      distributed int6_zz_im(i,a)

      distributed qtl1_x_im(a,b)
      distributed qtl1_y_im(a,b)
      distributed qtl1_z_im(a,b)

      distributed qtl2_x_im(i,j)
      distributed qtl2_y_im(i,j)
      distributed qtl2_z_im(i,j)

      distributed qtl3_x_im(a,b)
      distributed qtl3_y_im(a,b)
      distributed qtl3_z_im(a,b)


#-----------Real parts-------------------
      distributed qtl4_x(i,j)
      distributed qtl4_y(i,j)
      distributed qtl4_z(i,j)
 
      distributed qtl5_x(a,b)
      distributed qtl5_y(a,b)
      distributed qtl5_z(a,b)

      distributed qtl51_x(i,j)
      distributed qtl51_y(i,j)
      distributed qtl51_z(i,j)

      distributed qtl6_x(a,i)
      distributed qtl6_y(a,i)
      distributed qtl6_z(a,i)

      distributed qtl7_x(a,i)
      distributed qtl7_y(a,i)
      distributed qtl7_z(a,i)
 
      distributed qtl8_x(a,i)
      distributed qtl8_y(a,i)
      distributed qtl8_z(a,i)

      distributed qtl9_x(a,i)
      distributed qtl9_y(a,i)
      distributed qtl9_z(a,i)

      distributed qtl10_x(i,j)
      distributed qtl10_y(i,j)
      distributed qtl10_z(i,j)
#-----------Imaginary parts----------------
      distributed qtl4_x_im(i,j)
      distributed qtl4_y_im(i,j)
      distributed qtl4_z_im(i,j)

      distributed qtl5_x_im(a,b)
      distributed qtl5_y_im(a,b)
      distributed qtl5_z_im(a,b)

      distributed qtl51_x_im(i,j)
      distributed qtl51_y_im(i,j)
      distributed qtl51_z_im(i,j)

      distributed qtl6_x_im(a,i)
      distributed qtl6_y_im(a,i)
      distributed qtl6_z_im(a,i)

      distributed qtl7_x_im(a,i)
      distributed qtl7_y_im(a,i)
      distributed qtl7_z_im(a,i)

      distributed qtl8_x_im(a,i)
      distributed qtl8_y_im(a,i)
      distributed qtl8_z_im(a,i)

      distributed qtl9_x_im(a,i)
      distributed qtl9_y_im(a,i)
      distributed qtl9_z_im(a,i)

      distributed qtl10_x_im(i,j)
      distributed qtl10_y_im(i,j)
      distributed qtl10_z_im(i,j)
#------------------------------------------
      distributed qtl11_x(a,b)
      distributed qtl11_y(a,b)
      distributed qtl11_z(a,b)

      distributed qtl22_xx(i,j)
      distributed qtl22_xy(i,j)
      distributed qtl22_xz(i,j)
      distributed qtl22_yy(i,j)
      distributed qtl22_yz(i,j)
      distributed qtl22_zz(i,j)

      distributed qtl23_xx(a,b)
      distributed qtl23_xy(a,b)
      distributed qtl23_xz(a,b)
      distributed qtl23_yy(a,b)
      distributed qtl23_yz(a,b)
      distributed qtl23_zz(a,b)
#-------------------------------------------
      distributed qtl11_x_im(a,b)
      distributed qtl11_y_im(a,b)
      distributed qtl11_z_im(a,b)

      distributed qtl22_xx_im(i,j)
      distributed qtl22_xy_im(i,j)
      distributed qtl22_xz_im(i,j)
      distributed qtl22_yy_im(i,j)
      distributed qtl22_yz_im(i,j)
      distributed qtl22_zz_im(i,j)

      distributed qtl23_xx_im(a,b)
      distributed qtl23_xy_im(a,b)
      distributed qtl23_xz_im(a,b)
      distributed qtl23_yy_im(a,b)
      distributed qtl23_yz_im(a,b)
      distributed qtl23_zz_im(a,b)
#--------------------------------------------

      temp tmp_int6(a,i)


#------------Real parts----------------------
      served qtl12_x(a,i,b,j)
      served qtl12_y(a,i,b,j)  
      served qtl12_z(a,i,b,j)

      served qtl13_x(a,i,b,j)
      served qtl13_y(a,i,b,j)
      served qtl13_z(a,i,b,j)

      served qtl14_x(a,i,b,j)
      served qtl14_y(a,i,b,j)
      served qtl14_z(a,i,b,j)

      served qtl15_x(a,i,b,j)
      served qtl15_y(a,i,b,j)
      served qtl15_z(a,i,b,j) 

      served qtl16_x(i,j,a,k)
