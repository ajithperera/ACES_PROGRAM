      PROC DQ6 
#     --------
      create qtl6_x
      create qtl6_y
      create qtl6_z

      create qtl7_x
      create qtl7_y
      create qtl7_z

      create qtl8_x
      create qtl8_y
      create qtl8_z

      create qtl9_x
      create qtl9_y
      create qtl9_z
#--------Zero out arrays----------------------------------|
      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_x(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier 

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_x(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_x(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_x(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#----------------
      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_y(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_y(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_y(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_y(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#----------------
      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl6_z(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl7_z(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl8_z(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int6(a,i) = 0.0
      PUT qtl9_z(a,i) = tmp_int6(a,i)
      ENDPARDO i,a
      execute sip_barrier
#------------------------------------------------
#
#---------First intermediate-------------------------

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_x(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_x(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0        
      PUT qtl6_x(a,i) += tmp_int6(a,i) 
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_y(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_y(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0
      PUT qtl6_y(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_z(a,i,b,j) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_z(a,i,b,j)*l1a_old(j,b)
      tmp_int6(a,i) *= 2.0
      PUT qtl6_z(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

#----------Second intermediate-----------------------

      PARDO i,j,a,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_x(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_x(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_x(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_y(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_y(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_y(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST T2ab_z(a,j,b,i) a
      REQUEST l1a_old(j,b) j
      tmp_int6(a,i) = T2ab_z(a,j,b,i)*l1a_old(j,b)
      PUT qtl7_z(a,i) += tmp_int6(a,i)
      endif
      endif 
      ENDPARDO i,j,a,b
      execute sip_barrier

#-----------Third intermediate-------------------------

      PARDO i,j,a,b
#----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_x(b,j) j
      T2_x(b,j) = t1a_x(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_x(b,j) 
      tmp_int6(a,i) *= 2.0
      PUT qtl8_x(a,i) += tmp_int6(a,i)    
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier  

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_y(b,j) j
      T2_y(b,j) = t1a_y(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_y(b,j)
      tmp_int6(a,i) *= 2.0
      PUT qtl8_y(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_z(b,j) j
      T2_z(b,j) = t1a_z(b,j)
      REQUEST Vpiqj(a,i,b,j) a
      tmp_int6(a,i) = Vpiqj(a,i,b,j)*T2_z(b,j)
      tmp_int6(a,i) *= 2.0
      PUT qtl8_z(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

#-----------Fourth intermediate--------------------------

      PARDO i,j,a,b
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
      REQUEST t1a_x(b,j) j
      T2_x(b,j) = t1a_x(b,j)
      REQUEST Vpiqj(a,j,b,i) a
      tmp_int6(a,i) = Vpiqj(a,j,b,i)*T2_x(b,j)
      PUT qtl9_x(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
      execute sip_barrier

      PARDO i,j,a,b
#---------------------------------------
