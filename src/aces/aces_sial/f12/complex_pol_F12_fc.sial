#------------------------------------------------------------
#
#-------------diagram dq16------------------------------

#----------Contributions itself-------------------------

#-----------alpha-alpha components----------------------

#-------------xx-component------------------------------
      PARDO a,i,b,j
#----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,k) a
      REQUEST qtl16_x_im(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_x_im(k,i,b,j)*t1a_x_im(a,k)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      endif
      ENDDO k
#-----------Permutations----------------------------------
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0

      PREPARE INTT1T2_xx_im(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xx_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
      endif
      endif   
      ENDPARDO a,i,b,j
      execute server_barrier
#-------------xy-component------------------------------
      PARDO a,i,b,j
#----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,k) a
      REQUEST qtl16_y_im(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_y_im(k,i,b,j)*t1a_x_im(a,k)
      intt2t2(a,i,b,j) *= -0.5
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST t1a_y_im(a,k) a
      REQUEST qtl16_x_im(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_x_im(k,i,b,j)*t1a_y_im(a,k)
      intt2t2(a,i,b,j) *= -0.5
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      endif
      ENDDO k
#-----------Permutations----------------------------------
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0

      PREPARE INTT1T2_xy_im(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xy_im(b,i,a,j) += intt1t1_p1(b,i,a,j)
      endif
      endif 
      ENDPARDO a,i,b,j
      execute server_barrier
#-------------xz-component------------------------------
      PARDO a,i,b,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#----------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p1(b,i,a,j) = 0.0
      DO k
#----------------------------------------
      xi2(k)   = wOccA_frag(k)
      execute return_sval xi2 l3
      if l3 == two
#----------------------------------------
      REQUEST t1a_x_im(a,k) a
      REQUEST qtl16_z_im(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_z_im(k,i,b,j)*t1a_x_im(a,k)
      intt2t2(a,i,b,j) *= -0.5
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)

      REQUEST t1a_z_im(a,k) a
      REQUEST qtl16_x_im(k,i,b,j) k
