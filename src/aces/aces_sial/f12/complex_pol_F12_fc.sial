      served qtl14_z_im(a,i,b,j)

      served qtl15_x_im(a,i,b,j)
      served qtl15_y_im(a,i,b,j)
      served qtl15_z_im(a,i,b,j)

      served qtl16_x_im(i,j,a,k)
      served qtl16_y_im(i,j,a,k)
      served qtl16_z_im(i,j,a,k)

      served qtl17_x_im(i,j,a,k)
      served qtl17_y_im(i,j,a,k)
