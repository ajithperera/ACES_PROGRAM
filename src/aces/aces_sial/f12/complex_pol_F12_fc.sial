      REQUEST Vpiqj(a,j,b,i) a
      tmp_int6(a,i) = Vpiqj(a,j,b,i)*T2_x(b,j)
      PUT qtl9_x_im(a,i) += tmp_int6(a,i)
      endif
      endif
      ENDPARDO i,j,a,b
