      if l3 == two
#----------------------------------------
      REQUEST t1a_y(a,k) a
      REQUEST qtl16_y(k,i,b,j) k
      intt2t2(a,i,b,j) = qtl16_y(k,i,b,j)*t1a_y(a,k)
      intt2t2(a,i,b,j) *= -1.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      endif 
      ENDDO k
#-----------Permutations----------------------------------
      intt1t1_p1(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p1(b,i,a,j) *= -1.0

      PREPARE INTT1T2_yy(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_yy(b,i,a,j) += intt1t1_p1(b,i,a,j)
      endif
      endif
