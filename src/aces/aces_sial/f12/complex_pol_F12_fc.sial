#------------------------------------------------------------
#------------------------------------------------------------

      PROC DQ1819
#     -----------

#----------------Zero out intermediates--------------------

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xx(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xy(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xz(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_yy(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_yz(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_zz(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier
#----------------------------------------------------
      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xx_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xy_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_xz_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_yy_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_yz_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier

      PARDO a,i,b,j
      intt1t1(a,i,b,j) = 0.0
      PREPARE INTT1T2_zz_ab(a,i,b,j) = intt1t1(a,i,b,j)
      ENDPARDO a,i,b,j
      execute server_barrier
#-----------------------------------------------------

#------------diagram dq18-----------------------------

#------------alpha-alpha part-------------------------

#-------------xx-component----------------------------
      PARDO i,a,j,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#------------------------------------------
      intt1t1(a,i,b,j) = 0.0 
      intt1t1_p(b,i,a,j) = 0.0
      DO d
      REQUEST T2aa_x(d,i,b,j) d
      GET qtl5_x(d,a)
      intt2t2(a,i,b,j) = T2aa_x(d,i,b,j)*qtl5_x(d,a)
      intt2t2(a,i,b,j) *= 2.0
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d
#----------Permutations----------------------  
      intt1t1_p(b,i,a,j) = intt1t1(a,i,b,j)
      intt1t1_p(b,i,a,j) *= -1.0
      PREPARE INTT1T2_xx(a,i,b,j) += intt1t1(a,i,b,j)
      PREPARE INTT1T2_xx(b,i,a,j) += intt1t1_p(b,i,a,j) 
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

#-------------xy-component----------------------------
      PARDO i,a,j,b
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#------------------------------------------
      intt1t1(a,i,b,j) = 0.0
      intt1t1_p(b,i,a,j) = 0.0

      DO d
      REQUEST T2aa_x(d,i,b,j) d
      GET qtl5_y(d,a)
      intt2t2(a,i,b,j) = T2aa_x(d,i,b,j)*qtl5_y(d,a)
      intt1t1(a,i,b,j) += intt2t2(a,i,b,j)
      ENDDO d

      DO d
      REQUEST T2aa_y(d,i,b,j) d
      GET qtl5_x(d,a)
