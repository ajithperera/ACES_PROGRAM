       GET Uia(i,a)
       REQUEST t1a_x(a,j) a
       tmp_int5(i,j) = Uia(i,a)*t1a_x(a,j)
       PUT qtl51_x(i,j) += tmp_int5(i,j)
       endif
       endif
       ENDPARDO i,j,a
       execute sip_barrier

       PARDO i,j,a
#---------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#---------------------------------------
       GET Uia(i,a)
       REQUEST t1a_y(a,j) a
       tmp_int5(i,j) = Uia(i,a)*t1a_y(a,j)
       PUT qtl51_y(i,j) += tmp_int5(i,j)
       endif
       endif
       ENDPARDO i,j,a
       execute sip_barrier

       PARDO i,j,a
#---------------------------------------
