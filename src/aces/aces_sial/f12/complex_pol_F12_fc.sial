       scalar nfrags
       scalar icount
       scalar icount1
       scalar i_vstart
       scalar i_vend

       local wOccA_frag(i)

       temp xi(i)
       temp xi1(i)
       temp xi2(i)
       temp xi3(i)
       temp xi4(i)
       temp xi5(i) 

       scalar two  
#-----------------------------------------------------------
#

#-----------------------------------------------------------

      PROC SET_FRAG
#     ------------- 

      nfrags = 2.0
      allocate wOccA_frag(*)

      icount = 0.0

      DO jfrag

         icount   += 1.0

         i_vstart  = icount
         i_vend    = 6.0

         execute print_scalar i_vstart
         execute print_scalar i_vend


         execute frag_index_range i_vstart i_vend

         execute print_scalar i_vstart
         execute print_scalar i_vend

         DO i
            icount1 = 0.0
            do i1
               icount1 += 1.0
               if i == i1
                  exit
               endif
            enddo i1
            if icount1 >= i_vstart
            if icount1 <= i_vend
               wOccA_frag(i) = icount
            endif
            endif
         ENDDO i

      ENDDO jfrag
#-------------------------------------------
      F12CALC = 0.0
      execute f12info F12CALC
      execute eomeaf12info EAEOMF12CALC
      IF F12CALC == 0.0
      EAEOMF12CALC = 1.0
      ENDIF
#------------------------------------------

      ENDPROC SET_FRAG
#     ----------------

#-----------------------------------------------------------
#-----------------------------------------------------------

      PROC READ_DATA
#     --------------
      create t1a_old
      create Uaa
      create Ubb
      create Uii
      create Ujj
      create Uia
      create Ujb
      execute sip_barrier
      execute server_barrier
#----------Integrals----------------------------------------------
#      execute list_to_blocks                VSpipi
#      execute list_to_blocks                Vaaii
#      execute list_to_blocks                Viaai
#      execute list_to_blocks                Vaaai
#      execute list_to_blocks                Vpiqj

      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Vbbii


#----------Cluster amplitudes--------------------------------------
      execute list_to_blocks                t1a_old
      execute list_to_blocks                T2old_aa
      execute list_to_blocks                T2old_ab
#----------Lambda amplitudes--------------------------------------
      execute list_to_blocks                l1a_old
      execute list_to_blocks                L2old_aa
      execute list_to_blocks                L2old_ab
#-----------Cluster amplitudes derivatives------------------------

#------------------Real parts--------------------------
      execute list_to_blocks                 t1a_x
      execute list_to_blocks                 T2aa_x
      execute list_to_blocks                 T2ab_x

      execute list_to_blocks                 t1a_y
      execute list_to_blocks                 T2aa_y
      execute list_to_blocks                 T2ab_y

      execute list_to_blocks                 t1a_z
      execute list_to_blocks                 T2aa_z
      execute list_to_blocks                 T2ab_z
#------------------Imaginary parts---------------------
      execute list_to_blocks                 t1a_x_im
      execute list_to_blocks                 T2aa_x_im
      execute list_to_blocks                 T2ab_x_im

      execute list_to_blocks                 t1a_y_im
      execute list_to_blocks                 T2aa_y_im
      execute list_to_blocks                 T2ab_y_im

      execute list_to_blocks                 t1a_z_im
      execute list_to_blocks                 T2aa_z_im
      execute list_to_blocks                 T2ab_z_im
#------------------------------------------------------

#----------One-paticle Hbar elements------------------------------
      execute list_to_blocks                Uaa
      execute list_to_blocks                Ubb
      execute list_to_blocks                Uii
      execute list_to_blocks                Ujj
      execute list_to_blocks                Uia
      execute list_to_blocks                Ujb
#-----------Two-particle Hbar elements----------------------------
      execute list_to_blocks                Wiiii
      execute list_to_blocks                Wjjjj
      execute list_to_blocks                Wiijj
      execute list_to_blocks                Waiaa # HBAR_AIBC_aaaa
      execute list_to_blocks                Wbjbb # HBAR_AIBC_bbbb
      execute list_to_blocks                Waibb # HBAR_AIBC_aabb
      execute list_to_blocks                Wbjaa # HBAR_AIBC_bbaa
      execute list_to_blocks                Wiiia # HBAR_JKIA_aaaa
      execute list_to_blocks                Wjjjb # HBAR_JKIA_bbbb
      execute list_to_blocks                Wiijb # HBAR_JKIA_aabb
      execute list_to_blocks                Wjjia # HBAR_JKIA_bbaa
      execute list_to_blocks                Wiiai # HBAR_IAJK_aaaa
      execute list_to_blocks                Wiibj # HBAR_IAJK_aabb
      execute list_to_blocks                Wjjai # HBAR_IAJK_bbaa
      execute list_to_blocks                Wjjbj # HBAR_IAJK_bbbb
      execute list_to_blocks                Wiaai # HBAR_AJIB_aaaa
      execute list_to_blocks                Wjbbj # HBAR_AJIB_bbbb
      execute list_to_blocks                Wiabj # HBAR_AJIB_aabb
      execute list_to_blocks                Wjbai # HBAR_AJIB_BBAA
      execute list_to_blocks                Wiibb # HBAR_AJIB_iibb
      execute list_to_blocks                Wjjaa # HBAR_AJIB_jjaa
      execute list_to_blocks                Waaai # HBAR_ABCI_aaaa
      execute list_to_blocks                Wbbbj # HBAR_ABCI_bbbb
      execute list_to_blocks                Waabj # HBAR_ABCI_aabb
      execute list_to_blocks                Wbbai # HBAR_ABCI_bbaa
#      IF EAEOMF12CALC == 1.0
#      execute list_to_blocks                Hbar_ab_eomea
#      execute list_to_blocks                Hbar_ia_eomea
#      execute list_to_blocks                Hbar_ik_aj_eomea
#      execute list_to_blocks                Hbar_ij_ab_eomea
#      execute list_to_blocks                Hbar_ai_jb_eomea
#      execute list_to_blocks                Hbar_abci_F12
#      ENDIF
#      IF F12CALC == 1.0
#      execute list_to_blocks                T2_1
#      execute list_to_blocks                 intl2x
#      execute list_to_blocks                 intl2y
#      execute list_to_blocks                 intl2z
#      execute list_to_blocks                 Xijkl
#      execute list_to_blocks                 Bx
#      execute list_to_blocks                 By
#      execute list_to_blocks                 Bz
#      ENDIF  
#------------------------------------------------------------------

      execute read_list_to_blocks
      execute server_barrier

      ENDPROC READ_DATA
#     ------------------

      PROC HBAR_DER
#     -------------
      create dip_ao_x
      create dip_ao_y
      create dip_ao_z

      create dip_am_x
      create dip_am_y
      create dip_am_z

      create dip_pq_x
      create dip_pq_y
      create dip_pq_z

      execute sip_barrier
#--------Step 1 - calculate AO dipole moment integrals------------------
      PARDO mu,nu
      T_x(mu,nu) = 0.0

      execute return_x T_x

      PUT dip_ao_x(mu,nu) = T_x(mu,nu)
  
      ENDPARDO mu,nu
      execute sip_barrier  
#--------------------------------
      PARDO mu,nu
      T_y(mu,nu) = 0.0

      execute return_y T_y

      PUT dip_ao_y(mu,nu) = T_y(mu,nu)

      ENDPARDO mu,nu
      execute sip_barrier
#--------------------------------
      PARDO mu,nu
      T_z(mu,nu) = 0.0

      execute return_z T_z

      PUT dip_ao_z(mu,nu) = T_z(mu,nu)

      ENDPARDO mu,nu
      execute sip_barrier
#--------------------------------

#--------Step 2 - transform dipole moment integrals to MO basis---------
      PARDO p,nu 
      T1_x(p,nu) = 0.0
      PUT dip_am_x(p,nu) = T1_x(p,nu)
      ENDPARDO p,nu
      execute sip_barrier

      PARDO p,nu
      T1_y(p,nu) = 0.0
      PUT dip_am_y(p,nu) = T1_y(p,nu)
      ENDPARDO p,nu
      execute sip_barrier

      PARDO p,nu
      T1_z(p,nu) = 0.0
      PUT dip_am_z(p,nu) = T1_z(p,nu)
      ENDPARDO p,nu
      execute sip_barrier
#------------------------------------------
#------------------------------------------
      PARDO mu,nu
        GET dip_ao_x(mu,nu)

        T_x(mu,nu) = dip_ao_x(mu,nu)

        DO p    
        T1_x(p,nu) = T_x(mu,nu)*CA(mu,p)
        PUT dip_am_x(p,nu) += T1_x(p,nu)
        ENDDO p 
      ENDPARDO mu,nu
      execute sip_barrier
#------------------------------
      PARDO mu,nu
        GET dip_ao_y(mu,nu)

        T_y(mu,nu) = dip_ao_y(mu,nu)

        DO p
        T1_y(p,nu) = T_y(mu,nu)*CA(mu,p)
        PUT dip_am_y(p,nu) += T1_y(p,nu)
        ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier
#------------------------------
      PARDO mu,nu
        GET dip_ao_z(mu,nu)

        T_z(mu,nu) = dip_ao_z(mu,nu)

        DO p
        T1_z(p,nu) = T_z(mu,nu)*CA(mu,p)
        PUT dip_am_z(p,nu) += T1_z(p,nu)
        ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier

#------------------------------------------
#------------------------------------------
      PARDO p,q
      T2_x(p,q) = 0.0
      PUT dip_pq_x(p,q) = T2_x(p,q)
      ENDPARDO p,q
      execute sip_barrier
#-------------------------------
      PARDO p,q
      T2_y(p,q) = 0.0
      PUT dip_pq_y(p,q) = T2_y(p,q)
      ENDPARDO p,q
      execute sip_barrier
#-------------------------------
      PARDO p,q
      T2_z(p,q) = 0.0
      PUT dip_pq_z(p,q) = T2_z(p,q)
      ENDPARDO p,q
      execute sip_barrier
#------------------------------------------
#------------------------------------------
      PARDO p,nu
        GET dip_am_x(p,nu)

        T1_x(p,nu) = dip_am_x(p,nu)

        DO q   
        T2_x(p,q) = T1_x(p,nu)*CA(nu,q)
        PUT dip_pq_x(p,q) += T2_x(p,q)
        ENDDO q
      ENDPARDO p,nu
      execute sip_barrier
#-------------------------------
      PARDO p,nu
        GET dip_am_y(p,nu)

        T1_y(p,nu) = dip_am_y(p,nu)

        DO q
        T2_y(p,q) = T1_y(p,nu)*CA(nu,q)
        PUT dip_pq_y(p,q) += T2_y(p,q)
        ENDDO q
      ENDPARDO p,nu
      execute sip_barrier
#-------------------------------
      PARDO p,nu
        GET dip_am_z(p,nu)

        T1_z(p,nu) = dip_am_z(p,nu)

        DO q
        T2_z(p,q) = T1_z(p,nu)*CA(nu,q)
        PUT dip_pq_z(p,q) += T2_z(p,q)
        ENDDO q
      ENDPARDO p,nu
      execute sip_barrier


#------------------------------------
     PARDO i,j
     GET dip_pq_y(i,j)
     T2_y(i,j) = dip_pq_y(i,j)
#     execute dump_amp T2_y
     ENDPARDO i,j
     execute sip_barrier 

#--------Step 3 - construction of Hbar derivative matrix elements-------
      create Hbar_derv_x_ij
      create Hbar_derv_x_ab
      create Hbar_derv_x_ia
      create Hbar_derv_x_ai

      create Hbar_derv_y_ij
      create Hbar_derv_y_ab
      create Hbar_derv_y_ia
      create Hbar_derv_y_ai

      create Hbar_derv_z_ij
      create Hbar_derv_z_ab
      create Hbar_derv_z_ia
      create Hbar_derv_z_ai
#--------------------------------

#----------Hbar_derv_ij elements------------

#-----------------x-component---------------
      PARDO i,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_x(i,j) 
      T2_x(i,j) = dip_pq_x(i,j)
      PUT Hbar_derv_x_ij(i,j) = T2_x(i,j) 
      endif 
      endif
      ENDPARDO i,j
      execute sip_barrier 

      PARDO i,j,a 
#------------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_x(j,a)
      T2_x(j,a) = dip_pq_x(j,a)
      GET t1a_old(a,i)       
      tt1a_old(a,i) = t1a_old(a,i)
      tHbar_derv_ij(i,j) = tt1a_old(a,i)*T2_x(j,a)
      PUT Hbar_derv_x_ij(i,j) += tHbar_derv_ij(i,j)
      endif
      endif      
      ENDPARDO i,j,a
      execute sip_barrier 
#-----------------y-component---------------
      PARDO i,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_y(i,j)
      T2_y(i,j) = dip_pq_y(i,j)
      PUT Hbar_derv_y_ij(i,j) = T2_y(i,j)
      endif
      endif 
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j,a
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_y(j,a)
      T2_y(j,a) = dip_pq_y(j,a)
      GET t1a_old(a,i)
      tt1a_old(a,i) = t1a_old(a,i)
      tHbar_derv_ij(i,j) = tt1a_old(a,i)*T2_y(j,a)
      PUT Hbar_derv_y_ij(i,j) += tHbar_derv_ij(i,j)
      endif
      endif
      ENDPARDO i,j,a
      execute sip_barrier
#-----------------z-component---------------
      PARDO i,j
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_z(i,j)
      T2_z(i,j) = dip_pq_z(i,j)
      PUT Hbar_derv_z_ij(i,j) = T2_z(i,j)
      endif
      endif  
      ENDPARDO i,j
      execute sip_barrier

      PARDO i,j,a
#-----------------------------------------
      xi(i)   = wOccA_frag(i)
      execute return_sval xi l1
      if l1 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l2
      if l2 == two
#-----------------------------------------
      GET dip_pq_z(j,a)
      T2_z(j,a) = dip_pq_z(j,a)
      GET t1a_old(a,i)
      tt1a_old(a,i) = t1a_old(a,i)
      tHbar_derv_ij(i,j) = tt1a_old(a,i)*T2_z(j,a)
      PUT Hbar_derv_z_ij(i,j) += tHbar_derv_ij(i,j)
      endif
      endif 
      ENDPARDO i,j,a
      execute sip_barrier
#----------Hbar_derv_ab elements------------

#-----------------x-component---------------
      PARDO a,b
      GET dip_pq_x(a,b)
      T2_x(a,b) = dip_pq_x(a,b)
