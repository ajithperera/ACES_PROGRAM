       GET qtl3_x(b,a) 
       tmpval = qtl1_x(a,b)*qtl3_x(b,a)
       tmpval *= 4.0
       PROP_xx_aux += tmpval  
       ENDPARDO a,b
       execute server_barrier

       collective PROP_xx_5_2 += PROP_xx_aux 

