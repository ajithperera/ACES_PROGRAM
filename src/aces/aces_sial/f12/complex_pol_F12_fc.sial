      collective PROP_zz_4_4 += PROP_zz_aux


#--------------Summing up components----------------------|

      PROP_xx += PROP_xx_1
      PROP_xy += PROP_xy_1_1
      PROP_xy += PROP_xy_1_2
      PROP_xz += PROP_xz_1_1
      PROP_xz += PROP_xz_1_2
      PROP_yy += PROP_yy_1
      PROP_yz += PROP_yz_1_1
      PROP_yz += PROP_yz_1_2
      PROP_zz += PROP_zz_1

#-----------------------------------
      PROP_xx += PROP_xx_2_1
      PROP_xx += PROP_xx_2_2
      PROP_xx += PROP_xx_2_3

      PROP_xy += PROP_xy_2_1
      PROP_xy += PROP_xy_2_2
      PROP_xy += PROP_xy_2_3

      PROP_xz += PROP_xz_2_1
      PROP_xz += PROP_xz_2_2
      PROP_xz += PROP_xz_2_3

      PROP_yy += PROP_yy_2_1
      PROP_yy += PROP_yy_2_2
      PROP_yy += PROP_yy_2_3

      PROP_yz += PROP_yz_2_1
      PROP_yz += PROP_yz_2_2
      PROP_yz += PROP_yz_2_3

      PROP_zz += PROP_zz_2_1
      PROP_zz += PROP_zz_2_2
      PROP_zz += PROP_zz_2_3

      execute server_barrier
#------------------------------------
      PROP_xx += PROP_xx_3_1
      PROP_xx += PROP_xx_3_2

      PROP_xy += PROP_xy_3_1
      PROP_xy += PROP_xy_3_2
      PROP_xy += PROP_xy_3_3
      PROP_xy += PROP_xy_3_4

      PROP_xz += PROP_xz_3_1
      PROP_xz += PROP_xz_3_2
      PROP_xz += PROP_xz_3_3
      PROP_xz += PROP_xz_3_4

      PROP_yy += PROP_yy_3_1
      PROP_yy += PROP_yy_3_2

      PROP_yz += PROP_yz_3_1
      PROP_yz += PROP_yz_3_2
      PROP_yz += PROP_yz_3_3
      PROP_yz += PROP_yz_3_4

      PROP_zz += PROP_zz_3_1
      PROP_zz += PROP_zz_3_2

      execute server_barrier
#------------------------------------
      PROP_xx += PROP_xx_4_1 
      PROP_xx += PROP_xx_4_2 
      PROP_xx += PROP_xx_4_3 
      PROP_xx += PROP_xx_4_4 
      
      PROP_xy += PROP_xy_4_1 
      PROP_xy += PROP_xy_4_2 
      PROP_xy += PROP_xy_4_3 
      PROP_xy += PROP_xy_4_4 
      
      PROP_xz += PROP_xz_4_1 
      PROP_xz += PROP_xz_4_2 
      PROP_xz += PROP_xz_4_3 
      PROP_xz += PROP_xz_4_4 

      PROP_yy += PROP_yy_4_1 
      PROP_yy += PROP_yy_4_2 
      PROP_yy += PROP_yy_4_3 
      PROP_yy += PROP_yy_4_4 
      
      PROP_yz += PROP_yz_4_1 
      PROP_yz += PROP_yz_4_2 
      PROP_yz += PROP_yz_4_3 
      PROP_yz += PROP_yz_4_4 

      PROP_zz += PROP_zz_4_1 
      PROP_zz += PROP_zz_4_2 
      PROP_zz += PROP_zz_4_3 
      PROP_zz += PROP_zz_4_4 


      execute print_scalar PROP_xx
      execute print_scalar PROP_yy
      execute print_scalar PROP_zz  
#---------------------------------------------------------|
#---------------------------------------------------------|
      ENDPROC LIN_TERMS
#     -----------------

      PROC DQ12
#     ---------

#-----Step 1 - t_x_ia * t_x1_ia intermediates-------------|

      PARDO i,a,j,b 
#------------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#----------------------------------------- 
      REQUEST t1a_x(a,i) i
      REQUEST t1a_x(b,j) j
      tt1a_x(a,i) = t1a_x(a,i)
      T2_x(b,j) = t1a_x(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_x(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_xx(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_y(a,i) i
      REQUEST t1a_y(b,j) j
      tt1a_y(a,i) = t1a_y(a,i)
      T2_y(b,j) = t1a_y(b,j)
      tmp_int2(a,i,b,j) = tt1a_y(a,i)^T2_y(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_yy(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif 
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#------------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_z(a,i) i
      REQUEST t1a_z(b,j) j
      tt1a_z(a,i) = t1a_z(a,i)
      T2_z(b,j) = t1a_z(b,j)
      tmp_int2(a,i,b,j) = tt1a_z(a,i)^T2_z(b,j)
      tmp_int2(a,i,b,j) *= 2.0
      PREPARE qi1_zz(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif 
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_x(a,i) i
      REQUEST t1a_y(b,j) j
      tt1a_x(a,i) = t1a_x(a,i)
      T2_y(b,j) = t1a_y(b,j)
      REQUEST t1a_y(a,i) i
      REQUEST t1a_x(b,j) j 
      tt1a_y(a,i) = t1a_y(a,i)
      T2_x(b,j) = t1a_x(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_y(b,j)
      tmp_int3(a,i,b,j) = tt1a_y(a,i)^T2_x(b,j) 
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_xy(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif 
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_x(a,i) i
      REQUEST t1a_z(b,j) j
      tt1a_x(a,i) = t1a_x(a,i)
      T2_z(b,j) = t1a_z(b,j)
      REQUEST t1a_z(a,i) i
      REQUEST t1a_x(b,j) j
      tt1a_z(a,i) = t1a_z(a,i)
      T2_x(b,j) = t1a_x(b,j)
      tmp_int2(a,i,b,j) = tt1a_x(a,i)^T2_z(b,j)
      tmp_int3(a,i,b,j) = tt1a_z(a,i)^T2_x(b,j)
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_xz(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST t1a_y(a,i) i
      REQUEST t1a_z(b,j) j
      tt1a_y(a,i) = t1a_y(a,i)
      T2_z(b,j) = t1a_z(b,j)
      REQUEST t1a_z(a,i) i
      REQUEST t1a_y(b,j) j
      tt1a_z(a,i) = t1a_z(a,i)
      T2_y(b,j) = t1a_y(b,j)
      tmp_int2(a,i,b,j) = tt1a_y(a,i)^T2_z(b,j)
      tmp_int3(a,i,b,j) = tt1a_z(a,i)^T2_y(b,j)
      tmp_int2(a,i,b,j) += tmp_int3(a,i,b,j)
      PREPARE qi1_yz(a,i,b,j) = tmp_int2(a,i,b,j)
      endif
      endif 
      ENDPARDO i,a,j,b
      execute server_barrier


#---------------------------------------------------------|

#----------Step 2 - contraction with Hbar-----------------|
      create int6_xx
      create int6_xy
      create int6_xz
      create int6_yy
      create int6_yz
      create int6_zz

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_xx(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_xy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_xz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_yy(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_yz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier

      PARDO i,a
      tmp_int(i,a) = 0.0
      PUT int6_zz(i,a) = tmp_int(i,a)
      ENDPARDO i,a
      execute sip_barrier
#----------------------------------------

#-------------alpha-alpha components----------------------|

#-------------xx-component--------------------------------|
      PARDO i,j,k,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two

      xi(k)   = wOccA_frag(k)
      execute return_sval xi l4
      if l4 == two
#-----------------------------------------
      REQUEST Wiiia(j,i,k,b) j
      REQUEST qi1_xx(a,j,b,k) j       
      tmp_int(i,a) = Wiiia(j,i,k,b)*qi1_xx(a,j,b,k)
      tmp_int(i,a) *= -1.0
      PUT int6_xx(i,a) += tmp_int(i,a) 
      endif
      endif
      endif  
      ENDPARDO i,j,k,a,b
      execute sip_barrier

      PARDO i,j,a,b,d
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two
#-----------------------------------------
      REQUEST Waiaa(a,b,j,d) d
      REQUEST qi1_xx(b,i,d,j) j
      tmp_int(i,a) = Waiaa(a,b,j,d)*qi1_xx(b,i,d,j)
      PUT int6_xx(i,a) += tmp_int(i,a)
      endif
      endif 
      ENDPARDO i,j,a,b,d
      execute sip_barrier
#-------------xy-component--------------------------------|
      PARDO i,j,k,a,b
#-----------------------------------------
      xi2(i)   = wOccA_frag(i)
      execute return_sval xi2 l2
      if l2 == two

      xi1(j)   = wOccA_frag(j)
      execute return_sval xi1 l3
      if l3 == two

      xi(k)   = wOccA_frag(k)
      execute return_sval xi l4
      if l4 == two
#-----------------------------------------
      REQUEST Wiiia(j,i,k,b) j
      REQUEST qi1_xy(a,j,b,k) j
      tmp_int(i,a) = Wiiia(j,i,k,b)*qi1_xy(a,j,b,k)
