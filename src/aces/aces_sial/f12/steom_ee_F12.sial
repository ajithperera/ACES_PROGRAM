#--------------------------------------------------------------------------|
# This part of code does construction of CIS singlet and triplet matrices  |
# of transformed effective  hamiltonian  G = {exp(S)}^{-1}*Hbar*exp{S}.    |
# After its diagonalization set of STEOM excitation energies is avalable.  |
#  Added by Denis Bokhan, Moscow Lomonosov State University,               | 
#                 Moscow, Russian Federation                               | 
#--------------------------------------------------------------------------|


                       SIAL STEOM_EE_F12


      index  roots  = 1,20
      index  cis = 1,600
      index  cis1 = 1,600
      index kk1 = 1,1
      index   oact = 1, naoccorb
      index   vact = 1, navirtorb
      index   oact1 = 1, naoccorb
      index   vact1 = 1, navirtorb
#--------------------------------------------------------------|
# Indices for molecular orbitals                               |
#--------------------------------------------------------------|
      moaindex i = baocc, eaocc
      moaindex j = baocc, eaocc
      moaindex k = baocc, eaocc
      moaindex l = baocc, eaocc

      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc

      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1 = bavirt, eavirt

      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc

      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt

      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt

      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb

#---Transformed effective Hamiltonian elements--------

      served G_ik(i,k)
      served G_ac(a,b)
      served G_ia(i,a)

      served G_ik_ld(i,k,l,d)
      served G_ac_ld(a,b,l,d)
      served G_ik_jl(i,k,j,l)
      served G_ac_bd(a,a1,b,b1)
      served G_ab_ij(a,b,i,j)
      served G_ai_bj(a,i,b,j)

      temp tmp_G_ik(i,k)
      temp tmp_G_ac(a,b)
      temp tmp_G_ia(i,a)
      temp tmp_G_ik_ld(i,k,l,d)
      temp tmp_G_ac_ld(a,b,l,d)
      temp tmp_G_ik_jl(i,k,j,l)
      temp tmp_G_ac_bd(a,a1,b,b1)
      temp tmp_G_ab_ij(a,b,i,j)
      temp tmp_G_ai_bj(a,i,b,j)
#----------------------------------------------------
      served STEOM_S_EVAL(roots)
      temp tmp_STEOM_S_EVAL(roots)
      served STEOM_T_EVAL(roots)
      temp tmp_STEOM_T_EVAL(roots)
      temp tmp_zzz(cis,cis1)
#-------Singlet and triplet A matrix-----------------

      static A_singlet(cis,cis1)
      static A_triplet(cis,cis1)
#-------Arrays for singlet and triplet roots---------
      static roots_s(roots,kk1)
      static roots_t(roots,kk1)

      served Hbar_ab_eomea(a,a1)
      served Hbar_ia_eomea(a,i)
      served Hbar_ik_aj_eomea(i,k,a,j)
      served Hbar_ij_ab_eomea(i,j,a,b)
      served Hbar_ai_jb_eomea(a,i,j,b)

      temp tmp_Hbar_ab_eomea(a,a1)
      temp tmp_Hbar_ia_eomea(a,i)
      temp tmp_Hbar_ik_aj_eomea(i,k,a,j)
      temp tmp_Hbar_ij_ab_eomea(i,j,a,b)
      temp tmp_Hbar_ai_jb_eomea(a,i,j,b)

#-----------S(+) and S(-) amplitudes----------------
      served S_ij_mb(oact,i,j,b)
      served S_ej_ab(vact,a,b,j)

      temp tmp_S_ij_mb(oact,i,j,b)
      temp tmp_S_ej_ab(vact,a,b,j)
#---------------------------------------------------

      scalar F12CALC
      scalar EAEOMF12CALC
      scalar n_ee_roots
      scalar n_singlet_roots
      scalar n_triplet_roots   
      scalar g_type
      scalar chunk_type
      scalar RL
      scalar cnt
      scalar cnt1
      scalar ncis   
      scalar EVL    
      scalar printnumber

      scalar n_act_occ
      scalar n_act_virt
      scalar cnt_target_roots
      scalar ip_ind
      scalar ea_ind
      scalar cnt_occ
      scalar cnt_virt
      scalar cnt_occ1
      scalar cnt_virt1


       PROC READ_DATA
#      --------------

            execute list_to_blocks      G_ik
            execute list_to_blocks      G_ac
            execute list_to_blocks      G_ia
            execute list_to_blocks      G_ik_ld
#            execute list_to_blocks      G_ac_ld
            execute list_to_blocks      G_ik_jl
#            execute list_to_blocks      G_ac_bd
            execute list_to_blocks      G_ab_ij
            execute list_to_blocks      G_ai_bj(a,i,b,j)
            

            execute read_list_to_blocks
            execute server_barrier

       ENDPROC READ_DATA
#      -----------------


#--------Construct singlet and triplet CI-singles matrices------|
       PROC MAKE_A_MATRIX 
#      -------------------

#--------Initialization of static array-------------------------|

#        cnt = 0.0
        DO cis
#        cnt += 1.0
#        IF cnt > 10.0
#        EXIT
#        ENDIF
#        cnt1 = 0.0
        DO cis1
#        cnt1 += 1.0
#        IF cnt1 > 8.0
#        EXIT
#        ENDIF
        A_singlet(cis,cis1) = 0.0
        A_triplet(cis,cis1) = 0.0 
        ENDDO cis1
        ENDDO cis

        chunk_type = 1.0
        RL = 0.0
        execute eomchunk RL chunk_type
 
         DO i
         DO j
         tmp_G_ik(i,j) = 0.0
         execute steom_cis_matrix tmp_G_ik A_singlet
         execute steom_cis_matrix tmp_G_ik A_triplet
         ENDDO j
         ENDDO i


#--------G_ij - contribution------------------------------------|
 
         chunk_type = 1.0
         RL = 1.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         REQUEST G_ik(i,j) i
         tmp_G_ik(i,j) = G_ik(i,j)
         execute steom_cis_matrix tmp_G_ik A_singlet
         ENDDO j
         ENDDO i
         execute server_barrier

         chunk_type = 2.0
         RL = 1.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         REQUEST G_ik(i,j) i
         tmp_G_ik(i,j) = G_ik(i,j)
         execute steom_cis_matrix tmp_G_ik A_triplet
         ENDDO j
         ENDDO i
         execute server_barrier



#--------G_ab - contribution------------------------------------|

         chunk_type = 1.0
         RL = 2.0
         execute eomchunk RL chunk_type
                  
         DO a
         DO b
         REQUEST G_ac(a,b) a
         tmp_G_ac(a,b) = G_ac(a,b)
         execute steom_cis_matrix tmp_G_ac A_singlet
         ENDDO b
         ENDDO a
         execute server_barrier

         chunk_type = 2.0
         RL = 2.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         REQUEST G_ac(a,b) a
         tmp_G_ac(a,b) = G_ac(a,b)
         execute steom_cis_matrix tmp_G_ac A_triplet
         ENDDO b
         ENDDO a
         execute server_barrier

                  

#------------------G_ai_bj contribitions------------------------|
         
         chunk_type = 1.0
         RL = 3.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         DO i
         DO j
         REQUEST G_ai_bj(a,i,b,j) a
         tmp_G_ai_bj(a,i,b,j) = G_ai_bj(a,i,b,j) 
         execute steom_cis_matrix tmp_G_ai_bj A_singlet
         ENDDO j
         ENDDO i
         ENDDO b
         ENDDO a
         execute server_barrier

#---------------------G_ab_ij contribitions---------------------|

         chunk_type = 1.0
         RL = 4.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         DO i
         DO j
         REQUEST G_ab_ij(a,b,i,j) a
         tmp_G_ab_ij(a,b,i,j) = G_ab_ij(a,b,i,j)
         execute steom_cis_matrix tmp_G_ab_ij A_singlet
         ENDDO j
         ENDDO i
         ENDDO b
         ENDDO a
         execute server_barrier

         chunk_type = 2.0
         RL = 4.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         DO i
         DO j
         REQUEST G_ab_ij(a,b,i,j) a
         tmp_G_ab_ij(a,b,i,j) = G_ab_ij(a,b,i,j)
         execute steom_cis_matrix tmp_G_ab_ij A_triplet
         ENDDO j
         ENDDO i
         ENDDO b
         ENDDO a
         execute server_barrier

#----Diagonalization of singlet and triplet matrices------------

       execute steom_diag A_singlet roots_s
       execute steom_diag A_triplet roots_t


       ENDPROC MAKE_A_MATRIX
#      --------------------- 


#===============================================================|
#                    Main program                               |
#===============================================================|

      F12CALC = 0.0
#      execute f12info F12CALC
#      execute print_scalar F12CALC
#      execute eomeaf12info EAEOMF12CALC
      execute steomroots n_singlet_roots n_triplet_roots

#---------------------------------------------------------------|
#   Get number of active occupied and virtual orbitals          |
#---------------------------------------------------------------|
         execute eomearoots n_act_virt
         execute eomiproots n_act_occ
                
      ip_ind = 0.0
      DO oact
      ip_ind += 1.0
      ENDDO oact

      ip_ind -= n_act_occ
      ip_ind += 1.0

      ea_ind = 0.0
      ea_ind += n_act_virt



#----Read elements of doubly-transformed Hamiltonian G----------|
       CALL READ_DATA
#---------------------------------------------------------------|




#--------Construct singlet and triplet CI-singles matrices------|
#--------------Then diagonalize them----------------------------|
       CALL MAKE_A_MATRIX
#---------------------------------------------------------------|

#---------------------------------------------------------------|
#       Print out eigenvalues to the file                       |
#---------------------------------------------------------------|
        printnumber = 75.0

        chunk_type = 1.0
        RL = 1.0
        execute eomchunk RL chunk_type

        execute print_rel_info printnumber roots_s

        chunk_type = 1.0
        RL = 2.0
        execute eomchunk RL chunk_type

        execute print_rel_info printnumber roots_t






                       ENDSIAL STEOM_EE_F12
