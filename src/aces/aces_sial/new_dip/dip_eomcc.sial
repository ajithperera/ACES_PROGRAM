     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF  

           PARDO i, j

                 GET R1_AB_HIST(i,j,NINDEX50)
                 GET CORR_VEC_AB(i,j)
                 
                 Tij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
                 T1ij(i,j) = CORR_VEC_AB(i,j)
                 TMP          = Tij(i,j) * T1ij(i,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 
                 
           ENDPARDO i, j

           PARDO i, j, i1, a

                 REQUEST R2_ABAA_HIST(i,j,i1,a,NINDEX50) a
                 GET CORR_VEC_ABAA(i,j,i1,a)

                 Tijia(i,j,i1,a)  = R2_ABAA_HIST(i,j,i1,a,NINDEX50)
                 T1ijia(i,j,i1,a) = CORR_VEC_ABAA(i,j,i1,a)

                 TMP     = Tijia(i,j,i1,a) * T1ijia(i,j,i1,a)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, j, i1, a

           PARDO i, j, j1, b

                 REQUEST R2_ABBB_HIST(i,j,j1,b,NINDEX50) j1
                 GET CORR_VEC_ABBB(i,j,j1,b)

                 Tijjb(i,j,j1,b)  = R2_ABBB_HIST(i,j,j1,b,NINDEX50)
                 T1ijjb(i,j,j1,b) = CORR_VEC_ABBB(i,j,j1,b)
                        
                 TMP     = Tijjb(i,j,j1,b) * T1ijjb(i,j,j1,b) 

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 

           ENDPARDO i, j, j1, b

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT 
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     C_A    = 0.0
     C_AAA  = 0.0
     C_BBB  = 0.0

     PARDO i, j
           GET CORR_VEC_AB(i,j)
           Tij(i,j)   = CORR_VEC_AB(i,j)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
   
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET R1_AB_HIST(i,j,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ij(i,j) *= FACT
              T1ij(i,j) *= -1.0
              Tij(i,j)  += T1ij(i,j)

           ENDDO NINDEX50

           PUT R1_AB_INTMD(i,j) = Tij(i,j)

           TMP    = Tij(i,j) * Tij(i,j)
           SUMA  += TMP
                 
     ENDPARDO i, j

     PARDO i, j, i1, a
          GET CORR_VEC_ABAA(i,j,i1,a)
          Tijia(i,j,i1,a)  = CORR_VEC_ABAA(i,j,i1,a)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2_ABAA_HIST(i,j,i1,a,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1ijia(i,j,i1,a) = R2_ABAA_HIST(i,j,i1,a,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 
                 
             EXECUTE RETURN_SVAL Txx FACT

             T1ijia(i,j,i1,a)  *= FACT
             T1ijia(i,j,i1,a)  *= -1.0
             Tijia(i,j,i1,a)   += T1ijia(i,j,i1,a)

           ENDDO NINDEX50

           PUT R2_ABAA_intmd(i,j,i1,a) = Tijia(i,j,i1,a)

           TMP  =  Tijia(i,j,i1,a) * Tijia(i,j,i1,a)
           SUMAAA  += TMP

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

           GET CORR_VEC_ABBB(i,j,j1,b)
           Tijjb(i,j,j1,b)  = CORR_VEC_ABBB(i,j,j1,b)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF 

             REQUEST R2_ABBB_HIST(i,j,j1,b,NINDEX50) j1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1ijjb(i,j,j1,b) = R2_ABBB_HIST(i,j,j1,b,NINDEX50)
             Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50) 

             EXECUTE RETURN_SVAL Txx FACT
                 
             T1ijjb(i,j,j1,b) *= FACT
             T1ijjb(i,j,j1,b) *= -1.0
             Tijjb(i,j,j1,b)  += T1ijjb(i,j,j1,b)

           ENDDO NINDEX50
                
          PUT R2_ABBB_intmd(i,j,j1,b) = Tijjb(i,j,j1,b)

          TMP = Tijjb(i,j,j1,b) * Tijjb(i,j,j1,b)
          SUMBBB += TMP
                 
     ENDPARDO i, j, j1,  b

     EXECUTE SERVER_BARRIER 
     COLLECTIVE   C_A   += SUMA 
     COLLECTIVE   C_AAA += SUMAAA
     COLLECTIVE   C_BBB += SUMBBB

     EXECUTE SIP_BARRIER 

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_AAA
     NORM_NEW_ORTGC += C_BBB

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------
    
     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT 

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     HC_A    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            HC_A += TMP

      ENDPARDO i, j

      PARDO i, j, i1, a

              GET R2_ABAA_intmd(i,j,i1,a) 
              Tijia(i,j,i1,a) = R2_ABAA_intmd(i,j,i1,a)

              TMP   = Tijia(i,j,i1,a) * Tijia(i,j,i1,a)
              HC_AAA += TMP

      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b

              GET R2_ABBB_intmd(i,j,j1,b)
              Tijjb(i,j,j1,b) = R2_ABBB_intmd(i,j,j1,b)

              TMP   = Tijjb(i,j,j1,b) * Tijjb(i,j,j1,b)
              HC_BBB +=  TMP
              
     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB

     SUM_R  = SUMA
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT
     
     EXECUTE SIP_BARRIER 
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     PARDO i, j
           GET R1_AB_intmd(i,j)

           Tij(i,j)  = R1_AB_intmd(i,j)
           Tij(i,j) *= INV_SQRT_NORM_ORTGC

           PUT R1_AB(i,j) =  Tij(i,j)
     ENDPARDO i, j

    PARDO i, j, i1, a
         
         GET R2_ABAA_intmd(i,j,i1,a)

         Tijia(i,j,i1,a)  = R2_ABAA_intmd(i,j,i1,a)
         Tijia(i,j,i1,a) *= INV_SQRT_NORM_ORTGC

         PUT R2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a)

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

         GET R2_ABBB_intmd(i,j,j1,b)

         Tijjb(i,j,j1,b)  = R2_ABBB_intmd(i,j,j1,b)
         Tijjb(i,j,j1,b) *= INV_SQRT_NORM_ORTGC

         PUT R2_ABBB(i,j,j1,b) = Tijjb(i,j,j1,b) 

     ENDPARDO i, j, j1, b

     EXECUTE SERVER_BARRIER

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,j
#         get r1_ab(i,j)
#         tmp = r1_ab(i,j) * r1_ab(i,j)
#         tmpa += tmp
#      endpardo i,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab  = suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,j,i
#            get R2_abaa(i,j,i1,a) 
#            tmp = R2_abaa(i,j,i1,a) * R2_abaa(i,j,i1,a)
#            tmpa += tmp
#      endpardo a,i1,j,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1, i
#            get R2_abbb(i,j,j1,b) 
#            tmp = R2_abbb(i,j,j1,b) * R2_abbb(i,j,j1,b)
#            tmpa+= tmp
#      endpardo b,j,j1, i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug
     ENDPROC RESCALE_NEW_C
#    ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50)  = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)   = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50 

     PARDO i, j
           tij(i,j)      = 0.0
           PUT Y1_AB(i,j,NINDEX50) = tij(i,j)
           PUT R1_AB_intmd(i,j) = tij(i,j)
     ENDPARDO i, j

     PARDO i, j, i1, a
         tijia(i,j,i1,a) = 0.0
         PREPARE Y2_ABAA(i,j,i1,a,NINDEX50) = tijia(i,j,i1,a)
         PUT R2_ABAA_intmd(i,j,i1,a) = tijia(i,j,i1,a)
     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b
         tijjb(i,j,j1,b)       = 0.0
         PREPARE Y2_ABBB(i,j,j1,b,NINDEX50) = tijjb(i,j,j1,b)
         PUT R2_ABBB_intmd(i,j,j1,b) = tijjb(i,j,j1,b)
     ENDPARDO i, j, j1, b

     ENDDO NINDEX50 

     EXECUTE  SERVER_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC REORDER_A_EIGS
#    -------------------
     
     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE 
              A_DIAGS(MINDEX50)      = EIG_VALUE 
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS 
     
     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO i, j

                            GET R1_AB_HIST(i,j,NINDEX50)
                            GET R1_AB_HIST(i,j,MINDEX50)

                            Tij(i,j)   = R1_AB_HIST(i,j,NINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i,j

                     PARDO i, j, i1, a

                           REQUEST R2_ABAA_HIST(i,j,i1,a,NINDEX50) a
                           REQUEST R2_ABAA_HIST(i,j,i1,a,MINDEX50) a

                           Tijia(i,j,i1,a)  = R2_ABAA_HIST(i,j,i1,a,NINDEX50)
                           T1ijia(i,j,i1,a) = R2_ABAA_HIST(i,j,i1,a,MINDEX50)

                           TMP     = Tijia(i,j,i1,a) * T1ijia(i,j,i1,a)
                           SUMAAA += TMP
                
                     ENDPARDO i, j, i1, a

                     PARDO i, j, j1, b
                           REQUEST R2_ABBB_HIST(i,j,j1,b,NINDEX50) b
                           REQUEST R2_ABBB_HIST(i,j,j1,b,MINDEX50)  b

                           Tijjb(i,j,j1,b)  = R2_ABBB_HIST(i,j,j1,b,NINDEX50)
                           T1ijjb(i,j,j1,b) = R2_ABBB_HIST(i,j,j1,b,MINDEX50)
                        
                           TMP     = Tijjb(i,j,j1,b) * T1ijjb(i,j,j1,b)
                           SUMBBB += TMP

                     ENDPARDO i, j, j1, b
      
                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

#bgn_debug
     execute print_static etemp  iter_count 
#end_debug

     ENDPROC C_CHECK
#    ---------------

#     BEGIN MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO = 0.0
     ONE  = 1.0
     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC
#
      CALL READ_DATA
      CALL CREATE_ARRAYS 

# The default denominator is 1-particle part and can be switched to Hbar

     CALL FORM_13H1P_DIAG
     IF EOM_DENOM == ONE
        CALL FORM_23H1P_DIAG
     ENDIF

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC
     Call FORM_INITIAL_GUESS

#bgn_debug
         execute print_scalar eom_thres 
         execute print_scalar eom_denom
         execute print_scalar eom_maxcyc
#end_debug

      MULT = ZERO 
      DO SPN_MULT

        MULT  += 1.0

        IF MULT == ONE
           SINGLET = ONE
           TRIPLET = ZERO
        ELSE
           SINGLET = ZERO
           TRIPLET = ONE
        ENDIF

        ROOT_COUNT = ZERO 

        DO NROOTS

           ROOT_COUNT += 1.0
           IF ROOT_COUNT > TARGET_ROOTS
              EXIT
           ENDIF
#bgn_debug
#        execute print_scalar SINGLET 
#        execute print_scalar TRIPLET 
#        execute print_scalar ROOT_COUNT
#end_debug

           MYROOT = ROOT_COUNT 
           CALL PREP_DIP_GUESS 
      
           ITER_COUNT = 0.0

           DO SUBSP_DIM

              CALL SET_TO_ZERO

              ITER_COUNT += 1.0
#bgn_debug
        execute print_scalar ITER_COUNT
#end_debug
              IF ITER_COUNT > MAX_SUBSP_DIM 
                 EXIT
              ENDIF 

              CALL SAVE_C_VECTORS 
#bgn_debug
#            call c_check 
#end_debug
              CALL HR_MULT
              CALL FORM_ABBB
    
              CALL SAVE_HC_VECTORS 

              IF ITER_COUNT == 1.0
                 CALL FORM_A_MATRIX_11
              ELSE
                CALL FORM_A_MATRIX_IJ
                CALL FORM_A_MATRIX_JI
                CALL FORM_A_MATRIX_II
              ENDIF 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
            EXECUTE XGEEV A_MATRIX DVECTORS 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
             IF ITER_COUNT != 1.0
                CALL REORDER_A_EIGS
             ENDIF 
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal. 
#
             IF ITER_COUNT == 1.0
                CALL FORM_NEWVECS_ITR1
             ELSE

                CALL FORM_NEWVECS 
  
                CALL SELECT_VECS

                CALL FORM_SELECTED_Y
         
                CALL FORM_HBAR_Y_VECS

                CALL FORM_RESIDUAL_VEC

                CALL CHECK_CONVERGENCE
#bgn_debug
      execute print_scalar RESIDUAL_NORM
#end_debug
                IF RESIDUAL_NORM  < EOM_THRES
                  EXIT
                ELSE

                   CALL FORM_CORRECTION_VEC

                   CALL DRIVE_ORTHO
                
                   CALL RESCALE_NEW_C

                ENDIF 

             ENDIF 

           ENDDO SUBSP_DIM

           EXECUTE SERVER_BARRIER 
#bgn_debug
      execute print_scalar OMEGA 
#end_debug

           ITER_COUNT += -1.0
           IF ITER_COUNT == MAX_SUBSP_DIM
              IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means
#
                OMEGA = 0.0
              ENDIF 
           ENDIF 

           IF SINGLET == ONE
              DO IONE
              MCOUNT = 0.0
              DO MROOTS
                 MCOUNT += 1.0
                 IF MCOUNT == ROOT_COUNT
                    DIP_S(MROOTS,IONE) = OMEGA
                    TEE(MROOTS,IONE)   = DIP_S(MROOTS,IONE)
                    PUT DIP_ENER_S(MROOTS,IONE) = TEE(MROOTS,IONE)
                 ENDIF
              ENDDO MROOTS
              ENDDO IONE
           ENDIF 
           
           IF TRIPLET == ONE
              DO IONE
              MCOUNT = 0.0
              DO MROOTS
                 MCOUNT += 1.0
                 IF MCOUNT == ROOT_COUNT
                    DIP_T(MROOTS,IONE) = OMEGA
                    TEE(MROOTS,IONE)   = DIP_T(MROOTS,IONE)
                    PUT DIP_ENER_T(MROOTS,IONE) = TEE(MROOTS,IONE)
                 ENDIF 
              ENDDO MROOTS
              ENDDO IONE
            ENDIF 

         ENDDO NROOTS 
         EXECUTE SERVER_BARRIER 
#bgn_debug
      ROOT_COUNT -= 1.0
      IF SINGLET == ONE
      execute print_static DIP_S ROOT_COUNT 
      ENDIF 
      IF TRIPLET == ONE
      execute print_static DIP_T ROOT_COUNT 
      ENDIF 
#end_debug
      ENDDO SPN_MULT

      PRINT_FLAG = 50.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG DIP_S
      PRINT_FLAG = 51.0
      EXECUTE PRINT_REL_INFO PRINT_FLAG DIP_T
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO WARNING DUMMY

                           ENDSIAL DIP_EOMCCSD
#                          -------------------


