      PROC HR_MULT
#     ------------
#
# Zero out HR arrays
# ------------------
#
      PARDO i, j
          tij(i,j)      = 0.0
          PUT HR1_AB(i,j) = tij(i,j)
      ENDPARDO i, j

      PARDO j, a
          tmpib(j,a) = 0.0
          PUT Xja(j,a) = tmpib(j,a)
      ENDPARDO j, a

      PARDO i, b
          tmpib(i,b) = 0.0
          PUT Xib(i,b) = tmpib(i,b)
      ENDPARDO i, b

      PARDO i, j, i1, a
          tijia(i,j,i1,a)       = 0.0
          PUT HR2_ABAA(i,j,i1,a) = tijia(i,j,i1,a)
      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b
          tijjb(i,j,j1,b)       = 0.0
          PUT HR2_ABBB(i,j,j1,b) = tijjb(i,j,j1,b)
      ENDPARDO i, j, j1, b

      execute sip_barrier 

# Three Body intermediates
#  
      PARDO i2, j1, i, b
         REQUEST              HBAR_JKIA_aabb(i2,i,j1,b) b
         GET                  R1_AB(i2,j1)
         tmpijib(i2,j1,i,b) = HBAR_JKIA_aabb(i2,i,j1,b)
         tmpib(i,b)         = R1_AB(i2,j1)*tmpijib(i2,j1,i,b)
         PUT Xib(i,b)      += tmpib(i,b)
      ENDPARDO i2, j1, i, b

      PARDO i, j1, i1, a1

           GET R2_ABAA(i,j1,i1,a1) 

               DO b
                  REQUEST         Vpiqj(a1,i1,b,j1) j1
                  tmpib(i,b)    = R2_ABAA(i,j1,i1,a1)*Vpiqj(a1,i1,b,j1)
                  tmpib(i,b)   *= -1.0
                  PUT Xib(i,b) += tmpib(i,b)
               ENDDO b
      ENDPARDO i, j1, i1, a1

      PARDO i, j1, j2, b1

            GET R2_ABBB(j1,i,j2,b1) 

               DO b
                  REQUEST         VSqjqj(b1,j2,b,j1) j1
                  tmpib(i,b)    = R2_ABBB(j1,i,j2,b1)*VSqjqj(b1,j2,b,j1)
                  tmpib(i,b)   *= -0.5
                  PUT Xib(i,b) += tmpib(i,b)
               ENDDO b
      ENDPARDO i, j1, j2, b1

      PARDO j2, i1, j, a
         REQUEST              HBAR_JKIA_aabb(j2,j,i1,a) a
         GET                  R1_AB(i1,j2)
         tmpijib(j2,i1,j,a) = HBAR_JKIA_aabb(j2,j,i1,a)
         tmpib(j,a)         = R1_AB(i1,j2)*tmpijib(j2,i1,j,a)
         PUT Xja(j,a)      += tmpib(j,a)
      ENDPARDO j2, i1, j, a
#  
      PARDO i3, j, i2, a1

            GET R2_ABAA(i2,j,i3,a1) 

               DO a
                  REQUEST       VSpipi(a1,i3,a,i2) a1
                  tmpja(j,a) =  R2_ABAA(i2,j,i3,a1)*VSpipi(a1,i3,a,i2)
                  tmpja(j,a)   *= -0.5
                  PUT Xja(j,a) += tmpja(j,a)
               ENDDO a
      ENDPARDO i3, j, i2, a1

      PARDO j1, j, i2, b

            GET R2_ABBB(j,i2,j1,b) 

               DO a
                  REQUEST       Vpiqj(a,i2,b,j1) j1
                  tmpja(j,a) =  R2_ABBB(j,i2,j1,b)*Vpiqj(a,i2,b,j1)
                  tmpja(j,a)   *= -1.0
                  PUT Xja(j,a) += tmpja(j,a)
               ENDDO a
      ENDPARDO j1, j, i2, b

      execute sip_barrier 

#     ------------
# P(i/j1)R(i,j1)Hbar(j1,j)
#

      PARDO i, j, j1
            GET                   R1_AB(i,j1)
            GET                   HBAR_jj(j1,j)
            t1ij(i,j)           = R1_AB(i,j1)*HBAR_jj(j1,j)
            t1ij(i,j)          *= -1.0
            PUT HR1_AB(i,j) += t1ij(i,j)
      ENDPARDO i, j, j1
#
      PARDO i, j, i1
            GET                   R1_AB(i1,j)
            GET                   HBAR_ii(i1,i)
            t1ij(i,j)           = R1_AB(i1,j)*HBAR_ii(i1,i)
            t1ij(i,j)          *= -1.0
            PUT HR1_AB(i,j) += t1ij(i,j)
      ENDPARDO i, j, i1
#
# R(i1,j1)Hbar(i1j1,ij)
#

      PARDO i, i1, j, j1
            GET                    R1_AB(i1,j1)
            REQUEST                HBAR_iijj(i1,i,j1,j) j
            tij(i,j)            =  HBAR_iijj(i1,i,j1,j)*R1_AB(i1,j1)
            PUT HR1_AB(i,j) += tij(i,j)
      ENDPARDO i, i1, j, j1

#
# R(iji1,a)Hbar(i1,a)
#
      PARDO i, j, i1, a
            GET                   R2_ABAA(i,j,i1,a) 
            GET                   HBAR_ia(i1,a)
            tij(i,j)            = R2_ABAA(i,j,i1,a)*HBAR_ia(i1,a)
            PUT HR1_AB(i,j) += tij(i,j)
      ENDPARDO i, j, i1, a
#
      PARDO i, j, j1, b1
            GET                   R2_ABBB(j,i,j1,b1) 
            GET                   HBAR_jb(j1,b1)
            tij(i,j)            = R2_ABBB(j,i,j1,b1)*HBAR_jb(j1,b1)
            PUT HR1_AB(i,j) += tij(i,j)
      ENDPARDO i, j, j1, b1

# P(i/j1.i1)R(ij1i1,a)Hbar(j1i1,ja)
#     
      PARDO i, j1, i1, a
            GET R2_ABAA(i,j1,i1,a) 
            DO j
               REQUEST                HBAR_JKIA_bbaa(j1,j,i1,a) a
               tij(i,j)            =  R2_ABAA(i,j1,i1,a)*HBAR_JKIA_bbaa(j1,j,i1,a)
               tij(i,j)           *= -1.0
               PUT HR1_AB(i,j) += tij(i,j)
            ENDDO j
      ENDPARDO i, j1, i1, a

      PARDO i, j1, j2, b
            GET R2_ABBB(j1,i,j2,b) 
            DO j
               REQUEST                HBAR_JKIA_bbbb(j1,j,j2,b) b
               tij(i,j)            =  R2_ABBB(j1,i,j2,b)*HBAR_JKIA_bbbb(j1,j,j2,b)
               tij(i,j)           *= -0.5
               PUT HR1_AB(i,j) += tij(i,j)
           ENDDO j
      ENDPARDO i, j1, j2, b

      PARDO i1, j, i2, a
            GET R2_ABAA(i1,j,i2,a) 
            DO i
               REQUEST                HBAR_JKIA_aaaa(i1,i,i2,a) a
               tij(i,j)            =  R2_ABAA(i1,j,i2,a)*HBAR_JKIA_aaaa(i1,i,i2,a)
               tij(i,j)           *= -0.5
               PUT HR1_AB(i,j) += tij(i,j)
            ENDDO i
      ENDPARDO i1, j, i2, a

      PARDO i1, j, j1, b
            GET R2_ABBB(j,i1,j1,b) 
            DO i
               REQUEST                HBAR_JKIA_aabb(i1,i,j1,b) b
               tij(i,j)            =  R2_ABBB(j,i1,j1,b)*HBAR_JKIA_aabb(i1,i,j1,b)
               tij(i,j)           *= -1.0
               PUT HR1_AB(i,j) += tij(i,j)
            ENDDO i
      ENDPARDO i1, j, j1, b
#
# P(i/j;i/i1) R(i,j1)*Hbar(ja,j1i1)
#
      PARDO j, a, i1, j1
            REQUEST HBAR_IAJK_bbaa(j1,j,a,i1) i1
            DO i
               GET                  R1_AB(i,j1)
               tijia(i,j,i1,a)    = R1_AB(i,j1)*HBAR_IAJK_bbaa(j1,j,a,i1)
               tijia(i,j,i1,a)   *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i
      ENDPARDO j, a, i1, j1

      PARDO j, a, i, j1
            REQUEST HBAR_IAJK_bbaa(j1,j,a,i) i
            DO i1
               GET                  R1_AB(i1,j1)
               tijia(i,j,i1,a)    = R1_AB(i1,j1)*HBAR_IAJK_bbaa(j1,j,a,i)
               tijia(i,j,i1,a)   *= 1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i1
      ENDPARDO j, a, i, j1

      PARDO i, a, i1, i2
            REQUEST HBAR_IAJK_aaaa(i1,i,a,i2) i2
            DO j
               GET                  R1_AB(i1,j)
               tijia(i,j,i2,a)    = R1_AB(i1,j)*HBAR_IAJK_aaaa(i1,i,a,i2)
               tijia(i,j,i2,a)   *= -1.0
               PUT HR2_ABAA(i,j,i2,a) += tijia(i,j,i2,a)
            ENDDO j
      ENDPARDO i, a, i1, i2

#
# R(iji1,a1)*Hbar(a,a1)
#
      PARDO i, j, i1, a1
            GET R2_ABAA(i,j,i1,a1) 
            DO a
               GET                  Hbar_aa(a,a1)
               tijia(i,j,i1,a)    = R2_ABAA(i,j,i1,a1)*Hbar_aa(a,a1)
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO a
      ENDPARDO i, j, i1, a1

#
# P(i/j;i/i1) R(i,j,i2,a)*Hbar(i2,i1)
#
     PARDO i, j, a, i2
            GET R2_ABAA(i,j,i2,a) 
            DO i1
               GET                          HBAR_ii(i2,i1)
               tijia(i,j,i1,a)            = R2_ABAA(i,j,i2,a)*HBAR_ii(i2,i1)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i1
     ENDPARDO i, j, a, i2

     PARDO i2, j, a, i1
            GET R2_ABAA(i2,j,i1,a) 
            DO i
               GET                          HBAR_ii(i2,i)
               tijia(i,j,i1,a)            = R2_ABAA(i2,j,i1,a)*HBAR_ii(i2,i)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i
     ENDPARDO i2, j, a, i1

     PARDO i, j1, i1, a
            GET R2_ABAA(i,j1,i1,a) 
            DO j
               GET                          HBAR_jj(j1,j)
               tijia(i,j,i1,a)            = R2_ABAA(i,j1,i1,a)*HBAR_jj(j1,j)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO j
     ENDPARDO i, j1, i1, a
#
#
# P(i/j,i/i1) R(i1j1i2,a)*Hbar(i1j1,ij)
#
      PARDO i, j, i1, j1
            REQUEST                HBAR_iijj(i1,i,j1,j) j
            tpppp(i,j,i1,j1) = HBAR_iijj(i1,i,j1,j)
            DO i3
               DO a
                  GET                 R2_ABAA(i1,j1,i3,a) 
                  tijia(i,j,i3,a)   = tpppp(i,j,i1,j1)*R2_ABAA(i1,j1,i3,a)
                  PUT HR2_ABAA(i,j,i3,a) += tijia(i,j,i3,a)
               ENDDO a
            ENDDO i3
      ENDPARDO i, j, i1, j1

      PARDO i, j1, i2, a
            GET                R2_ABAA(i,j1,i2,a) 
            tpppp(i,a,i2,j1) = R2_ABAA(i,j1,i2,a)
            DO i1
               DO J
                  REQUEST              HBAR_iijj(i2,i1,j1,j) j
                  t1pppp(i2,j1,j,i1) = HBAR_iijj(i2,i1,j1,j)
                  t2pppp(i,a,j,i1) = tpppp(i,a,i2,j1)*t1pppp(i2,j1,j,i1)
                  tijia(i,j,i1,a)  = t2pppp(i,a,j,i1)
                  PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
               ENDDO j
            ENDDO i1
      ENDPARDO i, j1, i2, a

      PARDO i2, j, i3, a
            GET R2_ABAA(i2,j,i3,a) 
            DO i
               DO i1
                  REQUEST             HBAR_iiii(i2,i,i3,i1) i1
                  tijia(i,j,i1,a)   = R2_ABAA(i2,j,i3,a)*HBAR_iiii(i2,i,i3,i1)
                  tijia(i,j,i1,a)  *= 0.5
                  PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
               ENDDO i1
            ENDDO i
      ENDPARDO i2, j, i3, a

   PARDO j, j1, a, a1
            REQUEST            HBAR_AJIB_jjaa(j1,j,a,a1) a1
            tpppp(j1,a1,j,a) = HBAR_AJIB_jjaa(j1,j,a,a1)
            DO i1
            DO i
               GET                          R2_ABAA(i,j1,i1,a1)
               t1pppp(i,i1,j1,a1)         = R2_ABAA(i,j1,i1,a1)
               t1ijia(i,i1,j,a)           = t1pppp(i,i1,j1,a1)*tpppp(j1,a1,j,a)
               tijia(i,j,i1,a)            = t1ijia(i,i1,j,a)
               PUT HR2_ABAA(i,j,i1,a)    += tijia(i,j,i1,a)
            ENDDO i
            ENDDO i1
    ENDPARDO j, j1, a, a1

#
# P(i/i2) R(iji2,a)*Hbar(i2a,a1i1)
#
    PARDO i, j, a1, i2
            GET R2_ABAA(i,j,i2,a1) 
            DO a
            DO i1
               REQUEST                      HBAR_AJIB_aaaa(i2,a1,a,i1) i1
               tpppp(i2,a1,i1,a)          = HBAR_AJIB_aaaa(i2,a1,a,i1)
               tijia(i,j,i1,a)            = R2_ABAA(i,j,i2,a1)*tpppp(i2,a1,i1,a)
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i1
            ENDDO a
    ENDPARDO i, j, a1, i2

    PARDO i2, j, a1, i1
            GET R2_ABAA(i1,j,i2,a1)
            DO a
            DO i
               REQUEST                      HBAR_AJIB_aaaa(i2,a1,a,i) i
               tpppp(i1,j,a,i)            = R2_ABAA(i1,j,i2,a1)*HBAR_AJIB_aaaa(i2,a1,a,i)
               tijia(i,j,i1,a)            = tpppp(i1,j,a,i)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i
            ENDDO a
    ENDPARDO i2, j, a1, i1

    PARDO i, j, j1, b1
            GET                R2_ABBB(j,i,j1,b1) 
            tpppp(i,j,j1,b1) = R2_ABBB(j,i,j1,b1)
            DO a
            DO i1
               REQUEST                      HBAR_AJIB_bbaa(j1,b1,a,i1) i1
               t1pppp(i,j,a,i1)           = tpppp(i,j,j1,b1)*HBAR_AJIB_bbaa(j1,b1,a,i1)
               tijia(i,j,i1,a)            = t1pppp(i,j,a,i1)
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i1
            ENDDO a
    ENDPARDO i, j, j1, b1

   PARDO i1, j, j1, b1
            GET R2_ABBB(j,i1,j1,b1) 
            DO a
            DO i
               REQUEST                      HBAR_AJIB_bbaa(j1,b1,a,i) i
               tijia(i,j,i1,a)            = R2_ABBB(j,i1,j1,b1)*HBAR_AJIB_bbaa(j1,b1,a,i)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i
            ENDDO a
    ENDPARDO i1, j, j1, b1
#
# Three Body terms computed via XAI intermediate: R(I,j,K,A) =  X(I,f)T2(jK,fA)
#
      PARDO j, i1, b1, a

            REQUEST T2ab(a,i1,b1,j) a
            Do i
               GET                          Xib(i,b1)
               tijia(i,j,i1,a)            = Xib(i,b1)*T2ab(a,i1,b1,j)
               PUT HR2_ABAA(i,j,i1,a) += tijia(i,j,i1,a)
            ENDDO i
      ENDPARDO j, i1, b1, a
#
      PARDO j, i, b1, a

            REQUEST T2ab(a,i,b1,j) a
            Do i1
               GET                          Xib(i1,b1)
               tijia(i,j,i1,a)            = Xib(i1,b1)*T2ab(a,i,b1,j)
               tijia(i,j,i1,a)           *= -1.0
               PUT HR2_ABAA(i,j,i1,a)    += tijia(i,j,i1,a)
            ENDDO i1
      ENDPARDO j, i, b1, a

      PARDO a1, i, a, i1

            REQUEST T2aa(a1,i,a,i1) i1
            Do j
               GET                          Xja(j,a1)
               tijia(i,j,i1,a)            = Xja(j,a1)*T2aa(a1,i,a,i1)
               PUT HR2_ABAA(i,j,i1,a)    += tijia(i,j,i1,a)
            ENDDO j
      ENDPARDO a1, i, a, i1

#bgn_debug
#       PARDO i,j,i1,a
#           tijia(i,j,i1,a)            = 0.0
#           PUT HR2_ABAA(i,j,i1,a)     = tijia(i,j,i1,a)
#      ENDPARDO i,j,i1,a
#end_debug
#
      execute server_barrier

      ENDPROC HR_MULT
#     ---------------

      PROC FORM_ABBB
#      --------------

      IF SINGLET == ONE

         PARDO i, j, j1, b
             GET HR2_ABAA(i,j,j1,b) 
             Tijia(i,j,j1,b) = HR2_ABAA(i,j,j1,b)
             PUT HR2_ABBB(i,j,j1,b) = Tijia(i,j,j1,b)
         ENDPARDO i, j, j1, b
               
      ENDIF 

      IF TRIPLET == ONE

         PARDO i, j

             GET HR1_AB(i,j) 
             tij(i,j) = HR1_AB(i,j)

             If i < j
                t1ij(j,i)  = tij(i,j)
                t1ij(j,i) *= -1.0
                PUT HR1_AB_ASYM(i,j) = tij(i,j)
                PUT HR1_AB_ASYM(j,i) = t1ij(j,i)
             Endif

             If i == j
                execute symm_force_ij tij 
                PUT HR1_AB_ASYM(i,j) = tij(i,j)
             Endif 
           
         ENDPARDO i, j  

         EXECUTE SIP_BARRIER 

         PARDO i, j

             GET HR1_AB_ASYM(i,j) 
             tij(i,j) = HR1_AB_ASYM(i,j)
             PUT R1_AB(i,j)  = tij(i,j)

         ENDPARDO i, j

         PARDO i, j, j1, b
             GET HR2_ABAA(i,j,j1,b)
             Tijia(i,j,j1,b) = HR2_ABAA(i,j,j1,b)
             Tijia(i,j,j1,b)*= -1.0
             PUT HR2_ABBB(i,j,j1,b) = Tijia(i,j,j1,b)
         ENDPARDO i, j, j1, b

      ENDIF
      EXECUTE SIP_BARRIER 

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo i,j
#            get hr1_ab(i,j)
#            tmp = hr1_ab(i,j) * hr1_ab(i,j)
#            tmpa+= tmp
#      endpardo i,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo i,j,i1,a
#            get hr2_abaa(i,j,i1,a)
#            tmp = hr2_abaa(i,j,i1,a) * hr2_abaa(i,j,i1,a)
#            tmpa+= tmp
#      endpardo i,j,i1,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa=0.0
#      suma=0.0
#      pardo i,j,j1,b
#            get hr2_abbb(i,j,j1,b)
#            tmp = hr2_abbb(i,j,j1,b) * hr2_abbb(i,j,j1,b)
#            tmpa+= tmp
#      endpardo i,j,j1,b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
              
      ENDPROC FORM_ABBB
#     -----------------

      PROC sAVE_C_VECTORS 
#     ------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0
         
         IF NCOUNT == ITER_COUNT

            PARDO i, j
                  GET R1_AB(i,j) 
                  Tij(i,j) = R1_AB(i,j)
                  PUT R1_AB_HIST(i,j,NINDEX50) = Tij(i,j) 
            ENDPARDO i, j

            PARDO i, j, i1, a

                GET R2_ABAA(i,j,i1,a)
                Tijia(i,j,i1,a) =  R2_ABAA(i,j,i1,a)
                PREPARE R2_ABAA_HIST(i,j,i1,a,NINDEX50) = Tijia(i,j,i1,a)

            ENDPARDO i, j, i1, a

            PARDO i, j, j1, b

                GET R2_ABBB(i,j,j1,b)
                Tijjb(i,j,j1,b) = R2_ABBB(i,j,j1,b)
                PREPARE R2_ABBB_HIST(i,j,j1,b,NINDEX50) =  Tijjb(i,j,j1,b)

            ENDPARDO i, j, j1, b

         ENDIF 

      ENDDO NINDEX50 

      EXECUTE SERVER_BARRIER 

      ENDPROC SAVE_C_VECTORS 
#     ---------------------

      PROC SAVE_HC_VECTORS
#     --------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            PARDO i, j
                  GET HR1_AB(i,j)
                  Tij(i,j) = HR1_AB(i,j)
                  PUT HR1_AB_HIST(i,j,NINDEX50) = Tij(i,j)
            ENDPARDO i, j

            PARDO i, j, i1, a

                GET HR2_ABAA(i,j,i1,a)
                Tijia(i,j,i1,a) =  HR2_ABAA(i,j,i1,a)
                PREPARE HR2_ABAA_HIST(i,j,i1,a,NINDEX50) = Tijia(i,j,i1,a)

            ENDPARDO i, j, i1, a

            PARDO i, j, j1, b

                GET HR2_ABBB(i,j,j1,b)
                Tijjb(i,j,j1,b) = HR2_ABBB(i,j,j1,b)
                PREPARE HR2_ABBB_HIST(i,j,j1,b,NINDEX50) =  Tijjb(i,j,j1,b)

            ENDPARDO i, j, j1, b

         ENDIF

      ENDDO NINDEX50

      EXECUTE SERVER_BARRIER

     ENDPROC SAVE_HC_VECTORS
#    -----------------------

     PROC FORM_A_MATRIX_11
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      ncount = 0.0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo i,j
#         get hr1_AB_hist(i,j,nindex50)
#         tmp =  hr1_AB_hist(i,j,nindex50) *  hr1_AB_hist(i,j,nindex50)
#         tmpa += tmp
#      endpardo i,j
#      tmpa =0.0
#      suma =0.0
#      ncount = 0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo a,i1,j,i
#            request hR2_ABAA_hist(i,j,i1,a,nindex50) i
#            Tijia(i,j,i1,a) = hR2_ABAA_hist(i,j,i1,a,nindex50)
#            tmp = Tijia(i,j,i1,a) *Tijia(i,j,i1,a) 
#            tmpa += tmp
#      endpardo a,i1,j,i
#      endif 
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      ncount = 0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo i,b,j,j1
#            request  hR2_ABBB_hist(i,j,j1,b,nindex50) b
#            Tijbj(i,j,b,j1) = hR2_ABBB_hist(i,j,j1,b,nindex50)
#            tmp = Tijbj(i,j,b,j1) * Tijbj(i,j,b,j1)
#            tmpa+= tmp
#      endpardo i,b,j,j1
#      endif 
#      enddo nindex50
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50 
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50 
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT 

                    PARDO i, j

                          GET HR1_AB_HIST(i,j,NINDEX50)
                          GET R1_AB_HIST(i,j,MINDEX50) 

                          Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
                          T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                          TMP   = Tij(i,j) * T1ij(i,j)
                          SUMA += TMP

                    ENDPARDO i, j

                    EXECUTE SERVER_BARRIER 
                    COLLECTIVE HC_A += SUMA

                 ENDIF

              ENDDO MINDEX50 
           ENDIF

        ENDDO NINDEX50

      ENDIF 
#
# In iteration one there are no contributions from R1AAA, R1BBB.. since
# those are zero at the start. Note that HR1AAA are non-zero but the 
# overlap is still zero.
         
     A_VALUE  = HC_A
#bgn_debug
#     execute print_scalar A_value 
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50 
               MCOUNT += 1.0
               IF MCOUNT == 1.0
  
                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF 
             ENDDO MINDEX50
         ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC FORM_A_MATRIX_11
#    -------------------------

     PROC FORM_A_MATRIX_IJ
#    ----------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO i, j

                            GET HR1_AB_HIST(i,j,NINDEX50)
                            GET R1_AB_HIST(i,j,MINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i, j

                     PARDO i, j, i1, a

                           REQUEST HR2_ABAA_HIST(i,j,i1,a,NINDEX50) a
                           REQUEST R2_ABAA_HIST(i,j,i1,a,MINDEX50) a

                           Tijia(i,j,i1,a)  = HR2_ABAA_HIST(i,j,i1,a,NINDEX50)
                           T1ijia(i,j,i1,a) = R2_ABAA_HIST(i,j,i1,a,MINDEX50)

                           TMP     =  Tijia(i,j,i1,a) * T1ijia(i,j,i1,a)
                           SUMAAA += TMP
                
                     ENDPARDO i, j, i1, a

                     PARDO i, j, j1, b

                           REQUEST HR2_ABBB_HIST(i,j,j1,b,NINDEX50) b
                           REQUEST R2_ABBB_HIST(i,j,j1,b,MINDEX50)  b

                           Tijjb(i,j,j1,b)  = HR2_ABBB_HIST(i,j,j1,b,NINDEX50)
                           T1ijjb(i,j,j1,b) = R2_ABBB_HIST(i,j,j1,b,MINDEX50)
                        
                           TMP     = Tijjb(i,j,j1,b) * T1ijjb(i,j,j1,b) 
                           SUMBBB += TMP

                     ENDPARDO i, j, j1, b

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------

     PROC FORM_A_MATRIX_JI
#    ----------------------

# Built A_jk where k=1, ..j-1, <(HC_k)_j | C_k>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT >= NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    SUMAAA = 0.0
                    SUMBBB = 0.0
                    HC_A   = 0.0
                    HC_AAA = 0.0
                    HC_BBB = 0.0

                     PARDO i, j

                            GET HR1_AB_HIST(i,j,MINDEX50)
                            GET R1_AB_HIST(i,j,NINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,MINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i, j

                     PARDO i, j, i1, a

                           REQUEST HR2_ABAA_HIST(i,j,i1,a,MINDEX50) a
                           REQUEST R2_ABAA_HIST(i,j,i1,a,NINDEX50)  a

                           Tijia(i,j,i1,a)  = HR2_ABAA_HIST(i,j,i1,a,MINDEX50)
                           T1ijia(i,j,i1,a) = R2_ABAA_HIST(i,j,i1,a,NINDEX50)

                           TMP     = Tijia(i,j,i1,a) * T1ijia(i,j,i1,a)
                           SUMAAA += TMP
                
                     ENDPARDO i, j, i1, a

                     PARDO i, j, j1, b

                           REQUEST HR2_ABBB_HIST(i,j,j1,b,MINDEX50) b
                           REQUEST R2_ABBB_HIST(i,j,j1,b,NINDEX50)  b

                           Tijjb(i,j,j1,b)  = HR2_ABBB_HIST(i,j,j1,b,MINDEX50)
                           T1ijjb(i,j,j1,b) = R2_ABBB_HIST(i,j,j1,b,NINDEX50)
                        
                           TMP     = Tijjb(i,j,j1,b) * T1ijjb(i,j,j1,b)
                           SUMBBB += TMP

                     ENDPARDO i, j, j1, b

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     COLLECTIVE HC_AAA += SUMAAA
                     COLLECTIVE HC_BBB += SUMBBB

                     A_VALUE  = HC_A
                     A_VALUE += HC_AAA
                     A_VALUE += HC_BBB
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------

     PROC  FORM_A_MATRIX_II
#    ----------------------

     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     HC_A   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0
                 IF NCOUNT == MCOUNT

                    PARDO i, j

                            GET HR1_AB_HIST(i,j,MINDEX50)
                            GET R1_AB_HIST(i,j,NINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,MINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i, j

                     PARDO i, j, i1, a

                           REQUEST HR2_ABAA_HIST(i,j,i1,a,MINDEX50) a
                           REQUEST R2_ABAA_HIST(i,j,i1,a,NINDEX50)  a

                           Tijia(i,j,i1,a)  = HR2_ABAA_HIST(i,j,i1,a,MINDEX50)
                           T1ijia(i,j,i1,a) = R2_ABAA_HIST(i,j,i1,a,NINDEX50)

                           TMP     = Tijia(i,j,i1,a) * T1ijia(i,j,i1,a)
                           SUMAAA += TMP

                     ENDPARDO i, j, i1, a

                     PARDO i, j, j1, b

                           REQUEST HR2_ABBB_HIST(i,j,j1,b,MINDEX50) b
                           REQUEST R2_ABBB_HIST(i,j,j1,b,NINDEX50)  b

                           Tijjb(i,j,j1,b)  = HR2_ABBB_HIST(i,j,j1,b,MINDEX50)
                           T1ijjb(i,j,j1,b) = R2_ABBB_HIST(i,j,j1,b,NINDEX50)

                           TMP     = Tijjb(i,j,j1,b) * T1ijjb(i,j,j1,b)
                           SUMBBB += TMP

                     ENDPARDO i, j, j1, b
 
                   EXECUTE SERVER_BARRIER
                   COLLECTIVE HC_A   += SUMA
                   COLLECTIVE HC_AAA += SUMAAA
                   COLLECTIVE HC_BBB += SUMBBB

                   A_VALUE  = HC_A
                   A_VALUE += HC_AAA
                   A_VALUE += HC_BBB

                   KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50
                ENDIF 
              ENDDO NINDEX50 
       ENDIF 

     ENDDO MINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_II
#    -------------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE 
     OMEGA0M  = A_VALUE 
     OMEGA0M *= -1.0
#bgn_debug
#     execute print_scalar OMEGA0M
#end_debug

# First the residual vector for iteration 1
     
     PARDO i, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1_AB_HIST(i,j,NINDEX50)
              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j) *= OMEGA0M
              Tij(i,j)  += T1ij(i,j)
 
              PUT RES1_AB(i,j) = Tij(i,j)

           ENDDO NINDEX50
     ENDPARDO i, j

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO i, j, i1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2_ABAA_HIST(i,j,i1,a,NINDEX50) a

              Tijia(i,j,i1,a)  = HR2_ABAA_HIST(i,j,i1,a,NINDEX50)
              PUT RES2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a)

           ENDDO NINDEX50
     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > 1.0
                 EXIT
              ENDIF 

              REQUEST HR2_ABBB_HIST(i,j,j1,b,NINDEX50) b

              Tijia(i,j,j1,b)  = HR2_ABBB_HIST(i,j,j1,b,NINDEX50)
              PUT RES2_ABBB(i,j,j1,b) = Tijia(i,j,j1,b)

           ENDDO NINDEX50
     ENDPARDO i, j, j1, b

     EXECUTE SERVER_BARRIER 

# Now the correction vector for iteration 1

     PARDO i, j
           GET RES1_AB(i,j)
           GET D1_AB(i,j)

           Tij(i,j)   = D1_AB(i,j)
           T1ij(i,j)  = RES1_AB(i,j)

           Tij(i,j)  *= -1.0
           T2ij(i,j)  = OMEGA0
           Tij(i,j)  += T2ij(i,j)

           EXECUTE APPLY_DEN2_NOR  T1ij Tij

           PUT CORR_VEC_AB(i,j) =  T1ij(i,j)
     ENDPARDO i, j

    PARDO i, j, i1, a
         GET RES2_ABAA(i,j,i1,a)
         GET D2_ABAA(i,j,i1,a)

         Tijia(i,j,i1,a)  = D2_ABAA(i,j,i1,a)
         T1ijia(i,j,i1,a) = RES2_ABAA(i,j,i1,a)

         Tijia(i,j,i1,a) *= -1.0
         T2ijia(i,j,i1,a) = OMEGA0
         Tijia(i,j,i1,a)  += T2ijia(i,j,i1,a)

         EXECUTE APPLY_DEN4 T1ijia Tijia
             
         PUT CORR_VEC_ABAA(i,j,i1,a) = T1ijia(i,j,i1,a)

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b
         GET RES2_ABBB(i,j,j1,b)
         GET D2_ABBB(i,j,j1,b)

         Tijjb(i,j,j1,b)  = D2_ABBB(i,j,j1,b)
         T1ijjb(i,j,j1,b) =  RES2_ABBB(i,j,j1,b)

         Tijjb(i,j,j1,b)  *= -1.0
         T2ijjb(i,j,j1,b)  = OMEGA0
         Tijjb(i,j,j1,b)  += T2ijjb(i,j,j1,b)

         EXECUTE APPLY_DEN4 T1ijjb Tijjb

         PUT CORR_VEC_ABBB(i,j,j1,b) = T1ijjb(i,j,j1,b)

     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     HC_A   = 0.0

     PARDO i, j
           GET CORR_VEC_AB(i,j)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = CORR_VEC_AB(i,j) 
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              TMP   = Tij(i,j) * T1ij(i,j) 
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO i, j

     EXECUTE SIP_BARRIER
     COLLECTIVE  HC_A += SUMA
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO i, j

           GET CORR_VEC_AB(i,j)
           Tij(i,j) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = CORR_VEC_AB(i,j) 
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j) *= NORM_GHG
              T1ij(i,j) *= -1.0
              Tij(i,j)  += T1ij(i,j)

           ENDDO NINDEX50

          PUT R1_AB_intmd(i,j) = Tij(i,j)
     ENDPARDO i, j

# R2aa_a_HIST, R2bb_b_HIST, R2bb_a_HIST and R2aa_b_HIST is zero.

     PARDO i, j, i1, a

           GET CORR_VEC_ABAA(i,j,i1,a)

           Tijia(i,j,i1,a)  = CORR_VEC_ABAA(i,j,i1,a)
           PUT R2_ABAA_intmd(i,j,i1,a) = Tijia(i,j,i1,a)

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

           GET CORR_VEC_ABBB(i,j,j1,b)

           Tijjb(i,j,j1,b)  = CORR_VEC_ABBB(i,j,j1,b)
           PUT R2_ABBB_intmd(i,j,j1,b) = Tijjb(i,j,j1,b)

     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER 

# Final normalization 

     SUMA    = 0.0
     SUMAA_A = 0.0
     SUMBB_B = 0.0
     HC_A    = 0.0
     HC_AAA  = 0.0
     HC_BBB  = 0.0

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            HC_A += TMP

      ENDPARDO i, j

      PARDO i, j, i1, a

              GET R2_ABAA_intmd(i,j,i1,a) 
              Tijia(i,j,i1,a) = R2_ABAA_intmd(i,j,i1,a)

              TMP   = Tijia(i,j,i1,a) * Tijia(i,j,i1,a)
              HC_AAA += TMP

      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b

              GET R2_ABBB_intmd(i,j,j1,b)
              Tijjb(i,j,j1,b) = R2_ABBB_intmd(i,j,j1,b)

              TMP   = Tijjb(i,j,j1,b) * Tijjb(i,j,j1,b)
              HC_BBB +=  TMP
              
     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     COLLECTIVE  SUMAA_A += HC_AAA
     COLLECTIVE  SUMBB_B += HC_BBB

     SUM_R  = SUMA
     SUM_R += SUMAA_A
     SUM_R += SUMBB_B

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            Tij(i,j) *= INV_SQRT_NORM_R
            PUT R1_AB(i,j) = Tij(i,j) 

      ENDPARDO i, j

      PARDO i, j, i1, a

              GET R2_ABAA_intmd(i,j,i1,a) 
              Tijia(i,j,i1,a)  = R2_ABAA_intmd(i,j,i1,a)
              Tijia(i,j,i1,a) *= INV_SQRT_NORM_R
              PUT R2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a) 

      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b

              GET R2_ABBB_intmd(i,j,j1,b)
              Tijjb(i,j,j1,b)  = R2_ABBB_intmd(i,j,j1,b)
              Tijjb(i,j,j1,b) *= INV_SQRT_NORM_R
              PUT R2_ABBB(i,j,j1,b) = Tijjb(i,j,j1,b)
              
     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER

#bgn_debug
#     tmpa=0.0
#     suma=0.0
#     pardo i,j
#         get r1_AB(i,j)
#         tmp = r1_AB(i,j) * r1_AB(i,j)
#         tmpa += tmp
#      endpardo i,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab=suma 
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,i,j
#           get  R2_ABAA(i,j,i1,a) 
#           tmp =  R2_ABAA(i,j,i1,a) * R2_ABAA(i,j,i1,a)
#           tmpa += tmp
#      endpardo a,i1,i,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo i,b,j,j1
#            get  R2_ABBB(i,j,j1,b) 
#            tmp = R2_ABBB(i,j,j1,b) * R2_ABBB(i,j,j1,b)
#            tmpa+= tmp
#      endpardo i,b,j,j1
#      execute server_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#end_debug

     ENDPROC FORM_NEWVECS_ITR1
#    -------------------------

     PROC FORM_NEWVECS
#    ------------------
     PARDO i, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1_AB_HIST(i,j,MINDEX50)
                       Tijs(i,j,MINDEX50)  = R1_AB_HIST(i,j,MINDEX50)
                       T1ijs(i,j,NINDEX50) = Tijs(i,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1_AB(i,j,NINDEX50) += T1ijs(i,j,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j

     PARDO i, j, i1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2_ABAA_HIST(i,j,i1,a,MINDEX50)  a

                       Tijias(i,j,i1,a,MINDEX50) = R2_ABAA_HIST(i,j,i1,a,MINDEX50)
                       T1ijias(i,j,i1,a,NINDEX50) = Tijias(i,j,i1,a,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2_ABAA(i,j,i1,a,NINDEX50) += T1ijias(i,j,i1,a,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0  
                             
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

                   MCOUNT = 0.0
                   DO MINDEX50
                      MCOUNT += 1.0

                      IF MCOUNT > ITER_COUNT
                         EXIT
                      ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST R2_ABBB_HIST(i,j,j1,b,MINDEX50)  j1

                       Tijjbs(i,j,j1,b,MINDEX50) = R2_ABBB_HIST(i,j,j1,b,MINDEX50)
                       T1ijjbs(i,j,j1,b,NINDEX50) = Tijjbs(i,j,j1,b,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PREPARE Y2_ABBB(i,j,j1,b,NINDEX50) += T1ijjbs(i,j,j1,b,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j, j1, b

     EXECUTE SERVER_BARRIER 

     ENDPROC FORM_NEWVECS
#    ---------------------

     PROC SELECT_VECS
#    ----------------

     NCOUNT = 0.0

     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT  > 1.0
           EXIT
        ENDIF 

           MCOUNT = 0.0
           DO MINDEX50
              MCOUNT += 1.0
              IF MCOUNT >  ITER_COUNT
                 EXIT
              ENDIF

     	         SUMA   = 0.0
                 CY_A   = 0.0

                 PARDO i, j

                       GET R1_AB_HIST(i,j,NINDEX50)
                       GET Y1_AB(i,j,MINDEX50)

                       Tij(i,j)  = R1_AB_HIST(i,j,NINDEX50) 
                       T1ij(i,j) = Y1_AB(i,j,MINDEX50) 
               
                       TMP   = Tij(i,j) * T1ij(i,j)
                       SUMA +=  TMP
                       
                  ENDPARDO i, j

                  EXECUTE SIP_BARRIER
                  COLLECTIVE CY_A += SUMA
                       
                  CY_AB  = CY_A

                  KCOUNT = 0.0 
                  DO KINDEX50 
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT 
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF 

                  ENDDO KINDEX50 

           ENDDO  MINDEX50

#        ENDIF

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
#bgn_debug
#     execute print_scalar imax 
#end_debug

     ENDPROC SELECT_VECS
#    -------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j
 
                 GET Y1_AB(i,j,NINDEX50) 
                 Tij(i,j) = Y1_AB(i,j,NINDEX50)
                 PUT Y1_AB_PICKED(i,j) = Tij(i,j)

           ENDPARDO i, j
        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, i1, a

                 REQUEST Y2_ABAA(i,j,i1,a,NINDEX50) a
                 Tijia(i,j,i1,a) = Y2_ABAA(i,j,i1,a,NINDEX50) 
                 PUT Y2_ABAA_picked(i,j,i1,a) = Tijia(i,j,i1,a)

           ENDPARDO i, j, i1, a

        ENDIF 
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, j1, b

                 REQUEST Y2_ABBB(i,j,j1,b,NINDEX50) j
                 Tijjb(i,j,j1,b) = Y2_ABBB(i,j,j1,b,NINDEX50)
                 PUT Y2_ABBB_picked(i,j,j1,b) = Tijjb(i,j,j1,b)

           ENDPARDO i, j, j1, b

        ENDIF 
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

#bgn_debug
#      sumab=0.0
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,j
#         get y1_ab_picked(i,j)
#         tmp = y1_ab_picked(i,j) * y1_ab_picked(i,j)
#         tmpa += tmp
#      endpardo i,j
#      execute sip_barrier
#      collective sumb +=tmpb
#      execute print_scalar suma
#      sumab  = suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,j,i
#            get Y2_abaa_picked(i,j,i1,a)
#            tmp = Y2_abaa_picked(i,j,i1,a) * Y2_abaa_picked(i,j,i1,a)
#            tmpa += tmp
#      endpardo a,i1,j,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab  += suma
#      tmpa =0.0
#      suma =0.0
