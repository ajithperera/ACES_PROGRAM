     PROC FORM_RESIDUAL_VEC
#    ----------------------

      EXECUTE RETURN_SELECTED A_DIAGS IMAX 
      OMEGA   = IMAX
      OMEGAM  = OMEGA
      OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug

     PARDO i, j
           GET HY1_AB_picked(i,j)
           GET Y1_AB_picked(i,j)

           Tij(i,j)   = HY1_AB_picked(i,j)
           T1ij(i,j)  = Y1_AB_picked(i,j)
           T1ij(i,j) *= Omegam
           Tij(i,j)  +=  T1ij(i,j) 
           PUT RES1_AB(i,j) =  Tij(i,j)
     ENDPARDO i, j

     PARDO i, j, i1, a

         GET HY2_ABAA_picked(i,j,i1,a)
         GET Y2_ABAA_picked(i,j,i1,a)
         Tijia(i,j,i1,a)   = HY2_ABAA_picked(i,j,i1,a)
         T1ijia(i,j,i1,a)  = Y2_ABAA_picked(i,j,i1,a)
         T1ijia(i,j,i1,a) *= Omegam
         Tijia(i,j,i1,a)  += T1ijia(i,j,i1,a)
         PUT RES2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a)

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

         GET HY2_ABBB_picked(i,j,j1,b)
         GET Y2_ABBB_picked(i,j,j1,b)
         Tijjb(i,j,j1,b)   = HY2_ABBB_picked(i,j,j1,b)
         T1ijjb(i,j,j1,b)  = Y2_ABBB_picked(i,j,j1,b)
         T1ijjb(i,j,j1,b) *= Omegam
         Tijjb(i,j,j1,b)  += T1ijjb(i,j,j1,b)
         PUT RES2_ABBB(i,j,j1,b) = Tijjb(i,j,j1,b)

     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER
#bgn_debug
