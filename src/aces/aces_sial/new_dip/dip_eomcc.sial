     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO i, j
         GET Y1_AB_PICKED(i,j)
         Tij(i,j) = Y1_AB_PICKED(i,j)
         PUT R1_AB(i,j) =  Tij(i,j)
      ENDPARDO i, j

      PARDO i, j, i1, a
         GET Y2_ABAA_picked(i,j,i1,a) 
         Tijia(i,j,i1,a) = Y2_ABAA_picked(i,j,i1,a) 
         PUT R2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a)
      ENDPARDO i, j, i1, a

      PARdO i, j, j1, b
         GET Y2_ABBB_picked(i,j,j1,b)
         Tijjb(i,j,j1,b) = Y2_ABBB_picked(i,j,j1,b)
         PUT R2_ABBB(i,j,j1,b) = Tijjb(i,j,j1,b)
      ENDPARDO i, j, j1, b

      EXECUTE SIP_BARRIER 

      CALL HR_MULT
      CALL FORM_ABBB

      PARDO i, j
            GET HR1_AB(i,j)
            Tij(i,j) = HR1_AB(i,j)
            PUT HY1_AB_picked(i,j) =  Tij(i,j)
      ENDPARDO i, j

      PARDO i, j, i1, a
         GET HR2_ABAA(i,j,i1,a)
         Tijia(i,j,i1,a) = HR2_ABAA(i,j,i1,a)
         PUT HY2_ABAA_picked(i,j,i1,a) = Tijia(i,j,i1,a)
      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b
         GET HR2_ABBB(i,j,j1,b)
         Tijjb(i,j,j1,b) =  HR2_ABBB(i,j,j1,b)
         PUT HY2_ABBB_picked(i,j,j1,b) = Tijjb(i,j,j1,b)
      ENDPARDO i, j, j1, b

      EXECUTE SIP_BARRIER

#bgn_debug
