      PROC CREATE_ARRAYS
#     --------------------

      CREATE R1_AB
      CREATE HR1_AB_ASYM
      CREATE HR1_AB
      CREATE DDII
      CREATE DDJJ
      CREATE DDAA
      CREATE DDBB
      CREATE D1_AB
      CREATE D2_ABAA
      CREATE D2_ABBB
      CREATE R1_AB_HIST
      CREATE HR1_AB_HIST
      CREATE R2_ABAA
      CREATE R2_ABBB
      CREATE HR2_ABAA
      CREATE HR2_ABBB
      CREATE Y1_AB
      CREATE Y1_AB_PICKED
      CREATE Y2_ABAA_PICKED
      CREATE Y2_ABBB_PICKED
      CREATE HY1_AB_PICKED
      CREATE HY2_ABAA_PICKED
      CREATE HY2_ABBB_PICKED
      CREATE RES1_AB
      CREATE RES2_ABAA
      CREATE RES2_ABBB
      CREATE XIB
      CREATE XJA
      CREATE CORR_VEC_AB
      CREATE CORR_VEC_ABAA
      CREATE CORR_VEC_ABBB
      CREATE ORTHO_COEF
      CREATE R1_AB_INTMD
      CREATE R2_ABAA_INTMD
      CREATE R2_ABBB_INTMD
      CREATE DIP_ENER_S
      CREATE DIP_ENER_T

      EXECUTE SIP_BARRIER 

      ENDPROC CREATE_ARRAYS
#     --------------------

     PROC FORM_INITIAL_GUESS 
#    -----------------------
#
#  The Initial guess is form by fully solving the eigenvalue problem
#   Hbar(ij,kl)R(kl) =ER(ij,p) (p=1,..n; n<= no. of occupied pairs)
#

      DO i
      DO j
          GET  HBAR_jj(i,j)
          tij(i,j)  = HBAR_jj(i,j)
          tij(i,j)  *= -1.0
          DIP_INIT_IJ(i,j) = tij(i,j)
      ENDDO j
      ENDDO i
      
      DO i
      DO i1
      DO j
      DO j1
         REQUEST HBAR_IIJJ(i,i1,j,j1) j1
         Tijij(i,i1,j,j1)  = HBAR_IIJJ(i,i1,j,j1)
         T1ijij(i,j,i1,j1) = Tijij(i,i1,j,j1)
         DIP_INIT_IJIJ(i,j,i1,j1) =  T1ijij(i,j,i1,j1)
      ENDDO j1
      ENDDO j
      ENDDO i1
      ENDDO i
 
      EXECUTE SIP_BARRIER 
      execute get_my_rank rank

      EXECUTE  FORM_DIP_HMAT DIP_INIT_IJIJ DIP_INIT_IJ 
      EXECUTE FORM_DIP_GUESS DIP_INIT_IJIJ VEC_AB

     ENDPROC FORM_INITIAL_GUESS
#    --------------------------

      PROC PREP_DIP_GUESS
#     -------------------

     EXECUTE GUESS_4CURRENT_ROOT VEC_AB MYROOT
     IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF
     EXECUTE GUESS_4CURRENT_ROOT VEC_AB MYROOT

     COUNTER = 0.0
     ONE     = 1.0
#
# Always copy the position one because the above SIP copies the
# the guess for the current root to position one.

      DO KROOTS

         COUNTER += 1.0
         IF COUNTER == ONE

            PARDO i,j
                Tij(i,j) =  VEC_AB(i,j,KROOTS)
                PUT R1_AB_intmd(i,j) =  Tij(i,j)
            ENDPARDO i,j

         ENDIF

      ENDDO KROOTS
      EXECUTE SIP_BARRIER

#bgn_debug
      suma = 0.0
      tmpa = 0.0
      pardo i, j
         get R1_ab_intmd(i,j)
         Tij(i,j) = R1_ab_intmd(i,j)
        tmp  =  Tij(i,j) * Tij(i,j)
        tmpa += tmp
      endpardo i, j
      execute sip_barrier
      collective suma+=tmpa
      execute print_scalar suma
#end_debug
#
      
      PARDO i, j, i1, a
         Tijia(i,j,i1,a) = 0.0
         PUT R2_ABAA(i,j,i1,a) = Tijia(i,j,i1,a)
      ENDPARDO i, j, i1, a

      PARDO i, j, j1, b
         Tijjb(i,j,j1,b) = 0.0
         PUT R2_ABBB(i,j,j1,b) = Tijjb(i,j,j1,b)
      ENDPARDO i, j, j1, b

      EXECUTE SERVER_BARRIER 
 
      SUMA = 0.0
      TMPA = 0.0
      PARDO i, j

            GET  R1_AB_intmd(i,j) 
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            TMPA += TMP
      ENDPARDO i, j

      EXECUTE SIP_BARRIER 
      COLLECTIVE  SUMA += TMPA

      SUMAB  = SUMA

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB 
      NORM_R = SUMAB 

      PARDO i, j
            GET  R1_AB_intmd(i,j)
            Tij(i,j)  = R1_AB_intmd(i,j)
            Tij(i,j) *= INV_SQRT_NORM_R
            PUT R1_AB(i,j)  = Tij(i,j) 
      ENDPARDO i, j

      EXECUTE SIP_BARRIER 

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,j
#         get r1_ab(i,j) 
#         Tmp = r1_ab(i,j) * r1_ab(i,j)
#         tmpa += tmp
#      endpardo i,j
#      execute server_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

      ENDPROC PREP_DIP_GUESS
#     ----------------------

      PROC FORM_23H1P_DIAG
#     --------------------
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#
           GET              HBAR_ii(i1,i)
           Sii(i1,i)      = HBAR_ii(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           tii(i1,i)     *= -1.0
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET              HBAR_jj(j1,j)
        Sjj(j1,j)      = HBAR_jj(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        tjj(j1,j)     *= -1.0
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1

     execute sip_barrier

     PARDO i, j
#
           tij(i,j)=0.0
#
           do i1
#
              get          DDii(i1,i)
              t1ij(i1,j)  = 1.0
              tii(i,i1)  = DDii(i1,i)
#
              t2ij(i,j)  = tii(i,i1)*t1ij(i1,j)
              tij(i,j)  += t2ij(i,j)
#
           enddo i1
#
           do j1
#
              get          DDjj(j1,j)
              tji(j1,i) = 1.0
              tjj(j1,j)  = DDjj(j1,j)
#
              t2ij(i,j)  = tjj(j1,j)*tji(j1,i)
              tij(i,j)  += t2ij(i,j)
#
           enddo j1

           do i2
           do j2
#
              request                   HBAR_iijj(i,i2,j,j2) j2
              Tiijj(i,i2,j,j2)        = HBAR_iijj(i,i2,j,j2)
              execute return_diagonal4  Tiijj
              t22ia(j2,i2)       = 1.0
              t2ij(i,j)         = Tiijj(i,i2,j,j2)*t22ia(j2,i2)
              tij(i,j)+=t2ij(i,j)
#
           enddo j2
           enddo i2
#
     ENDPARDO i, j
#
     PARDO i, j, i1, a
           tijia(i,j,i1,a) = 0.0

           DO a1
              GET                 HBAR_aa(a,a1)
              tpp(a,a1)         = HBAR_aa(a,a1)
              execute return_diagonal4 tpp
              t2ijia(i,j,i1,a1) = 1.0
              t1ijia(i,j,i1,a)  = t2ijia(i,j,i1,a1)*tpp(a,a1)
              tijia(i,j,i1,a)  += t1ijia(i,j,i1,a)
           ENDDO a1

           DO i2
              GET                 HBAR_ii(i2,i1)
              tpp(i2,i1)        = HBAR_ii(i2,i1)
              execute return_diagonal4 tpp
              t2ijia(i,j,i2,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i,j,i2,a)*tpp(i2,i1)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           DO i2
              GET                 HBAR_ii(i2,i)
              tpp(i2,i)         = HBAR_ii(i2,i)
              execute return_diagonal4 tpp
              t2ijia(i2,j,i1,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i2,j,i1,a)*tpp(i2,i)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           DO i2
              GET                 HBAR_ii(i2,j)
              tpp(i2,j)         = HBAR_ii(i2,j)
              execute return_diagonal4 tpp
              t2ijia(i,i2,i1,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i,i2,i1,a)*tpp(i2,j)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           DO i2
           DO i3
              REQUEST             HBAR_iijj(i2,i,i3,j) i
              tpppp(i2,i,i3,j)  = HBAR_iijj(i2,i,i3,j)
              execute return_diagonal4 tpppp
              t2ijia(i2,i3,i1,a) = 1.0
              t1pppp(i,j,i2,i3)  = tpppp(i2,i,i3,j)
              t1ijia(i,j,i1,a)   = t1pppp(i,j,i2,i3)*t2ijia(i2,i3,i1,a)
              tijia(i,j,i1,a)   += t1ijia(i,j,i1,a)
           ENDDO i3
           ENDDO i2

           DO i2
           DO i3
              REQUEST              HBAR_iijj(i2,i,i3,i1) i
              tpppp(i2,i,i3,i1)  = HBAR_iijj(i2,i,i3,i1)
              execute return_diagonal4 tpppp
              t2ijia(i2,j,i3,a) = 1.0
              t1ijia(i,j,i1,a)  = t2ijia(i2,j,i3,a)*tpppp(i2,i,i3,i1)
              tijia(i,j,i1,a)  += t1ijia(i,j,i1,a)
           ENDDO i3
           ENDDO i2

           DO i2
           DO i3
              REQUEST              HBAR_iijj(i2,j,i3,i1) j
              tpppp(i2,j,i3,i1)  = HBAR_iijj(i2,j,i3,i1)
              execute return_diagonal4 tpppp
              t1pppp(i1,j,i2,i3) = tpppp(i2,j,i3,i1)
              t2ijia(i,i2,i3,a) = 1.0
              t2pppp(i2,i3,i,a) = t2ijia(i,i2,i3,a)
              t3pppp(i1,j,i,a) = t1pppp(i1,j,i2,i3)* t2pppp(i2,i3,i,a)
              t1ijia(i,j,i1,a) = t3pppp(i1,j,i,a)
              tijia(i,j,i1,a) += t1ijia(i,j,i1,a)
           ENDDO i3
           ENDDO i2

           DO a1
           DO i2
              REQUEST             HBAR_AJIB_jjaa(i2,i1,a,a1) a
              tpppp(i2,i1,a,a1) = HBAR_AJIB_jjaa(i2,i1,a,a1)
              execute return_diagonal4 tpppp
              t1pppp(i2,a1,i1,a) = tpppp(i2,i1,a,a1)
              t2ijia(i,j,i2,a1) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i,j,i2,a1)*t1pppp(i2,a1,i1,a)
              tijia(i,j,i1,a) += t1ijia(i,j,i1,a)
           ENDDO i2
           ENDDO a1

           DO a1
           DO i2
              REQUEST             HBAR_AJIB_jjaa(i2,i,a,a1) a
              tpppp(i2,i,a,a1) = HBAR_AJIB_jjaa(i2,i,a,a1)
              execute return_diagonal4 tpppp
              t2ijia(i2,j,i1,a1) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i2,j,i1,a1)*tpppp(i2,i,a,a1)
              tijia(i,j,i1,a) += t1ijia(i,j,i1,a)
           ENDDO i2
           ENDDO a1

           DO a1
           DO i2
              REQUEST            HBAR_AJIB_jjaa(i2,j,a,a1) a
              tpppp(i2,j,a,a1) = HBAR_AJIB_jjaa(i2,j,a,a1)
              execute return_diagonal4 tpppp
              t2ijia(i,i2,i1,a1) = 1.0
              t1pppp(i,i2,i1,a1) = t2ijia(i,i2,i1,a1)
              t2pppp(i2,j,a1,a)  = tpppp(i2,j,a,a1)
              t1ijia(i,j,i1,a)   = t1pppp(i,i2,i1,a1)*t2pppp(i2,j,a1,a)
              tijia(i,j,i1,a)   += t1ijia(i,j,i1,a)
           ENDDO i2
           ENDDO a1

           PUT D2_ABAA(i,j,i1,a) = tijia(i,j,i1,a)
           PUT D2_ABBB(i,j,i1,a) = tijia(i,j,i1,a)
     ENDPARDO i, j, i1, a

     execute sip_barrier

    ENDPROC FORM_23H1P_DIAG
#   -----------------------

    PROC FORM_13H1P_DIAG
#   -------------------
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#
           GET              HBAR_ii(i1,i)
           Sii(i1,i)      = HBAR_ii(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           tii(i1,i)     *= -1.0
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET               HBAR_jj(j1,j)
        Sjj(j1,j)      =  HBAR_jj(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        tjj(j1,j)     *= -1.0
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1

     execute sip_barrier 
#
     PARDO i, j
#
           tij(i,j)=0.0
#
           do i1
#
              get          DDii(i1,i)
              tii(i,i1)  = DDii(i1,i) 
              t1ij(i1,j) = 1.0
              t2ij(i,j)  = tii(i,i1)*t1ij(i1,j)
              tij(i,j)  += t2ij(i,j)
#
           enddo i1
#
           do j1
#
              get          DDjj(j1,j)
              tjj(j1,j)  = DDjj(j1,j)
              tji(j1,i)  = 1.0
              t2ij(i,j)  = tjj(j1,j)*tji(j1,i)
              tij(i,j)  += t2ij(i,j)
#
           enddo j1

           PUT D1_AB(i,j) += tij(i,j)
#
     ENDPARDO i, j
#
     PARDO i, j, i1, a
           tijia(i,j,i1,a) = 0.0

           DO a1
              GET                 HBAR_aa(a,a1)
              tpp(a,a1)         = HBAR_aa(a,a1)
              execute return_diagonal4 tpp
              t2ijia(i,j,i1,a1) = 1.0
              t1ijia(i,j,i1,a)  = t2ijia(i,j,i1,a1)*tpp(a,a1)
              tijia(i,j,i1,a)  += t1ijia(i,j,i1,a)
           ENDDO a1

           DO i2
              GET                 HBAR_ii(i2,i1)
              tpp(i2,i1)        = HBAR_ii(i2,i1)
              execute return_diagonal4 tpp
              t2ijia(i,j,i2,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i,j,i2,a)*tpp(i2,i1)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           DO i2
              GET                 HBAR_ii(i2,i)
              tpp(i2,i)         = HBAR_ii(i2,i)
              execute return_diagonal4 tpp
              t2ijia(i2,j,i1,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i2,j,i1,a)*tpp(i2,i)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           DO i2
              GET                 HBAR_ii(i2,j)
              tpp(i2,j)         = HBAR_ii(i2,j)
              execute return_diagonal4 tpp
              t2ijia(i,i2,i1,a) = 1.0
              t1ijia(i,j,i1,a) = t2ijia(i,i2,i1,a)*tpp(i2,j)
              tijia(i,j,i1,a) -= t1ijia(i,j,i1,a)
           ENDDO i2

           PUT D2_ABAA(i,j,i1,a) = tijia(i,j,i1,a)
           PUT D2_ABBB(i,j,i1,a) = tijia(i,j,i1,a)
     ENDPARDO i, j, i1, a

     execute sip_barrier 

#bgn_debug
