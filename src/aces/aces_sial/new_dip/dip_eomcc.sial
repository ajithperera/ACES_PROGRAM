#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug
  
     ENDPROC FORM_RESIDUAL_VEC
#    -----------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA   = 0.0
     SUMAAA = 0.0
     SUMBBB = 0.0
     HC_A   = 0.0
     HC_AAA = 0.0
     HC_BBB = 0.0

     PARDO i, j

           GET RES1_AB(i,j)

           Tij(i,j)   = RES1_AB(i,j)

           TMP   = Tij(i,j) * Tij(i,j)
           SUMA += TMP

     ENDPARDO i, j

     PARDO i, j, i1, a

           GET RES2_ABAA(i,j,i1,a) 

           Tijia(i,j,i1,a)  = RES2_ABAA(i,j,i1,a)

           TMP     = Tijia(i,j,i1,a) * Tijia(i,j,i1,a)
           SUMAAA += TMP
                
     ENDPARDO i, j, i1, a
   
     PARDO i, j, j1, b
           GET RES2_ABBB(i,j,j1,b) 

           Tijjb(i,j,j1,b)  = RES2_ABBB(i,j,j1,b)
                     
           TMP     = Tijjb(i,j,j1,b) * Tijjb(i,j,j1,b)
           SUMBBB += TMP

     ENDPARDO i, j, j1, b

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A   += SUMA
     COLLECTIVE HC_AAA += SUMAAA
     COLLECTIVE HC_BBB += SUMBBB

     A_VALUE  = HC_A
     A_VALUE += HC_AAA
     A_VALUE += HC_BBB

     EXECUTE SIP_BARRIER

     HALF = 0.5
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------

     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     PARDO i, j
           GET RES1_AB(i,j)
           GET D1_AB(i,j)

           Tij(i,j)   = D1_AB(i,j)
           T1ij(i,j)  = RES1_AB(i,j)

           Tij(i,j)  *= -1.0
           T2ij(i,j)  = Omega
           Tij(i,j)  += T2ij(i,j)

           EXECUTE APPLY_DEN2_NOR  T1ij Tij

           PUT CORR_VEC_AB(i,j) =  T1ij(i,j)

     ENDPARDO i, j

     PARDO i, j, i1, a
         GET RES2_ABAA(i,j,i1,a)
         GET D2_ABAA(i,j,i1,a)

         Tijia(i,j,i1,a)  = D2_ABAA(i,j,i1,a)
         T1ijia(i,j,i1,a) = RES2_ABAA(i,j,i1,a)

         Tijia(i,j,i1,a) *= -1.0
         T2ijia(i,j,i1,a) = Omega
         Tijia(i,j,i1,a)  += T2ijia(i,j,i1,a)

         EXECUTE APPLY_DEN4 T1ijia Tijia
             
         PUT CORR_VEC_ABAA(i,j,i1,a) = T1ijia(i,j,i1,a)

     ENDPARDO i, j, i1, a

     PARDO i, j, j1, b

         GET RES2_ABBB(i,j,j1,b)
         GET D2_ABBB(i,j,j1,b)

         Tijjb(i,j,j1,b)  = D2_ABBB(i,j,j1,b)
         T1ijjb(i,j,j1,b) = RES2_ABBB(i,j,j1,b)

         Tijjb(i,j,j1,b)  *= -1.0
         T2ijjb(i,j,j1,b)  = Omega
         Tijjb(i,j,j1,b)  += T2ijjb(i,j,j1,b)

         EXECUTE APPLY_DEN4 T1ijjb Tijjb

         PUT CORR_VEC_ABBB(i,j,j1,b) = T1ijjb(i,j,j1,b)

     ENDPARDO i, j, j1, b

     EXECUTE SIP_BARRIER

