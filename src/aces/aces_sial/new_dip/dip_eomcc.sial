      Temp T1ijs(i,j,NINDEX50)
      Temp Tijias(i,j,i1,a,subsp_dim)
      Temp T1ijias(i,j,i1,a,subsp_dim)
      Temp Tijjbs(i,j,j1,b,subsp_dim)
