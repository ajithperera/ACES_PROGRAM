                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot


