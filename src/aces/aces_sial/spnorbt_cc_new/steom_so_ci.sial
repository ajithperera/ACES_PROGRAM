#---------------------------------------------------------------------------------|

#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1
                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier
      ENDDO kroot1
      ENDDO kroot
#------------------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= sing_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                    DO indone
                ttT1_L1A(a,i,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_S (a,i,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(a,i,kroot) = L1A_VECS_S (a,i,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(a,i,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(a,i,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_S (a,i,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(a,i,kroot) = L1A_VECS_S (a,i,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(a,i,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#----------------Step 2 - calculations of the matrix elements------------------------|
          tmpval =  0.0
          tmpval1 = 0.0
          tmpval2 = 0.0
#-------------------Singles contributions--------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_z(b,a) a
                 tSO_z_pq(b,a) = Fso_pq_z(b,a)
                 etemp = taa(a,b)*tSO_z_pq(b,a)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_z(j,i) i
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 tmpval += tmpval1
                 tmpval += tmpval2
#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
       mind1 = mark1
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark2
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
