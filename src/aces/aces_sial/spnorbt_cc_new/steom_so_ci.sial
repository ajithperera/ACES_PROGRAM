                execute sip_barrier
#----------------Step 2 - calculations of the matrix elements------------------------|
        ONE = 1.0   
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half
        sqrtwoinv = ONE/sqrtwo

        tmpval1 = 0.0
        tmpval2 = 0.0
        tmpval3 = 0.0
        tmpval4 = 0.0

        tmpval_re = 0.0
