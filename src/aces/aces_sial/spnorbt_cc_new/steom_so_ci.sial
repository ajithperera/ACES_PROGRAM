                 REQUEST Fso_pq_x(j,i) i
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= -1.0
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_y(a,b) a
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwoinv
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_y(j,i) i
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval
#---------Contributions to imaginary parts (Sx - components)-------------|
        tmpval_im += tmpval1
        tmpval_im += tmpval2
#---------Contributions to real parts (Sy - compoenents)-----------------|
        tmpval_re += tmpval3
        tmpval_re += tmpval4
#------------------------Block 13----------------------------------------|
       mind1 = mark4
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark1
       mind2 += cnt1
       mind2 -= 1.0


       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= 1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= 1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#------------------------Block 9-----------------------------------------|
       mind1 = mark3
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark1
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= 1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1



#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot
#---------------------------------------------------------------------------------|
#         Block   8:   <L(T,Sz=0)|V_so|R(T,Sz=-1)>                                |
#         Block  10:   <L(T,Sz=1)|V_so|R(T,Sz=0)>                                 |
#---------------------------------------------------------------------------------|

#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1
                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier
      ENDDO kroot1
      ENDDO kroot
#------------------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                    DO indone
                ttT1_L1A(a,i,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_T (a,i,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(a,i,kroot) = L1A_VECS_T (a,i,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(a,i,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(a,i,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_T (a,i,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(a,i,kroot) = L1A_VECS_T (a,i,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(a,i,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#----------------Step 2 - calculations of the matrix elements------------------------|
        ONE = 1.0
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half
        sqrtwoinv = ONE/sqrtwo

        tmpval1 = 0.0
        tmpval2 = 0.0
        tmpval3 = 0.0
        tmpval4 = 0.0

        tmpval_re = 0.0
        tmpval_im = 0.0
#------------------------Singles contributions-----------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_x(a,b) a
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_x(j,i) i
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_y(a,b) a
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_y(j,i) i
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval
#---------Contributions to imaginary parts (Sx - components)-------------|
        tmpval_im += tmpval1
        tmpval_im += tmpval2
#---------Contributions to real parts (Sy - compoenents)-----------------|
        tmpval_re += tmpval3
        tmpval_re += tmpval4
#------------------------Block 8-----------------------------------------|
       mind1 = mark2
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark4
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#------------------------Block 10----------------------------------------|
       mind1 = mark3
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark2
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1

#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot

#---------------------------------------------------------------------------------|
#         Block   7:   <L(T,Sz=0)|V_so|R(T,Sz=1)>                                 |
#         Block  14:  <L(T,Sz=-1)|V_so|R(T,Sz=0)>                                 |
#---------------------------------------------------------------------------------|

#------------Intermedites from previous step will be used-------------------------|
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count
#----------------Step 2 - calculations of the matrix elements------------------------|
        ONE = 1.0
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half
        sqrtwoinv = ONE/sqrtwo

        tmpval1 = 0.0
        tmpval2 = 0.0
        tmpval3 = 0.0
        tmpval4 = 0.0

        tmpval_re = 0.0
        tmpval_im = 0.0
#------------------------Singles contributions-----------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_x(a,b) a
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_x(j,i) i
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 REQUEST Fso_pq_y(a,b) a
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= -1.0
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 REQUEST Fso_pq_y(j,i) i
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= -1.0
                 etemp *= sqrtwoinv
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval
#---------Contributions to imaginary parts (Sx - components)-------------|
        tmpval_im += tmpval1
        tmpval_im += tmpval2
#---------Contributions to real parts (Sy - compoenents)-----------------|
        tmpval_re += tmpval3
        tmpval_re += tmpval4
#------------------------Block 7-----------------------------------------|
       mind1 = mark2
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark3
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#------------------------Block 14----------------------------------------|
       mind1 = mark4
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark2
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#----------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot


      ENDPROC SO_MATR
#     ---------------


#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
#                     MAIN  PROGRAM                                                       |
#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
     
#---------Step 1 - read eigenvalues and eigenvectors from the disk-------------------------
      CALL READ_DATA
#---------Step 2 - add non-relativistic matrix elements to EOM-SO-CI matrix---------------
      execute steomroots sing_count trp_count
      CALL NR_STEOM_CONTR
#---------Step 3 - compute SO integrals and construct SO Fock operator-------------------
      CALL SO_INT
#---------Step 4 - add spin-orbit couplings matrix elements to EOM-SO-CI matrix----------
      CALL SO_MATR
      

#---------Step 5 - diagonalize complex STEOM-SO-CI matrix---------------------------------
#--------- and print out relativistic roots to the output file --------------------------
       execute eom_so_diag so_ci_re so_ci_im


                           ENDSIAL STEOM_SO_CI
