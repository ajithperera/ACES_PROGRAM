     PROC SELECT_HBAR_Y_VEC_TOGO
#    ---------------------------

     PARDO a, i
         GET Y1a_PICKED(a,i)
         Tai(a,i) = Y1a_PICKED(a,i)
         PUT VCACT1A(a,i) =  Tai(a,i)
     ENDPARDO a, i

     PARDO i, i1, a1, a
         REQUEST Y2aa_picked(a,i,a1,i1) i1
         Taiai(a,i,a1,i1) = Y2aa_picked(a,i,a1,i1)
         PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
     ENDPARDO i, i1, a1, a

     PARDO a,i,b,j
         REQUEST Y2ab_picked(a,i,b,j) j
         Taibj(a,i,b,j) = Y2ab_picked(a,i,b,j)
         PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
     ENDPARDO a, i, b, j

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, a

                 GET HY1a(a,i,NINDEX50)
                 Tai(a,i) = HY1a(a,i,NINDEX50)
                 PUT HY1a_PICKED(a,i) = Tai(a,i)

           ENDPARDO i, a
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, i1, a1, a

                 REQUEST HY2aa(a,i1,a1,i,NINDEX50) i
                 Taiai(a,i1,a1,i) = HY2aa(a,i1,a1,i,NINDEX50)
                 PREPARE HY2aa_picked(a,i1,a1,i) = Taiai(a,i1,a1,i)

           ENDPARDO i, i1, a1, a

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, b, a

                 REQUEST HY2ab(a,i,b,j,NINDEX50) j
                 Taibj(a,i,b,j) = HY2ab(a,i,b,j,NINDEX50)
                 PREPARE HY2ab_picked(a,i,b,j) = Taibj(a,i,b,j)

           ENDPARDO i, j, b, a

        ENDIF
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

#bgn_debug
#      tmpa=0.0
#      suma=0.0
#      pardo i,a
#         get hy1a_picked(a,i)
#         tmp = hy1a_picked(a,i) * hy1a_picked(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request  hy2aa_picked(a,i1,a1,i) i
#            tmp =  hy2aa_picked(a,i1,a1,i) * hy2aa_picked(a,i1,a1,i)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i,a,b
#            request hy2ab_picked(a,i,b,j) j
#            tmp =  hy2ab_picked(a,i,b,j) * hy2ab_picked(a,i,b,j)
#            tmpa+= tmp
#      endpardo j,i,a, b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     ENDPROC SELECT_HBAR_Y_VEC_TOGO
#    ------------------------------

     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO a, i
         GET Y1a_PICKED(a,i)
         Tai(a,i) = Y1a_PICKED(a,i)
         PUT VCACT1A(a,i) =  Tai(a,i)
      ENDPARDO a, i

      PARDO i, i1, a1, a
         REQUEST Y2aa_picked(a,i,a1,i1) i1
         Taiai(a,i,a1,i1) = Y2aa_picked(a,i,a1,i1)
         PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO i, i1, a1, a

      PARDO a,i,b,j
         REQUEST Y2ab_picked(a,i,b,j) j
         Taibj(a,i,b,j) = Y2ab_picked(a,i,b,j)
         PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, i, b, j

      EXECUTE SERVER_BARRIER

      CALL HR_MULT

      PARDO a, i
         GET VCHACT1A(a,i)
         Tai(a,i) = VCHACT1A(a,i)
         PUT HY1A_PICKED(a,i) =  Tai(a,i)
      ENDPARDO a, i

      PARDO i, i1, a1, a
         REQUEST VCHACT2AA(a,i,a1,i1) i1
         Taiai(a,i,a1,i1) = VCHACT2AA(a,i,a1,i1)
         PREPARE HY2aa_picked(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO i, i1, a1, a

      PARDO a,i,b,j
         REQUEST VCHACT2AB(a,i,b,j) j
         Taibj(a,i,b,j) = VCHACT2AB(a,i,b,j)
         PREPARE HY2ab_picked(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, i, b, j

      EXECUTE SERVER_BARRIER

     ENDPROC FORM_HBAR_Y_VECS
#    ------------------------

    PROC FORM_RESIDUAL_VEC
#   ----------------------

     EXECUTE RETURN_SELECTED A_DIAGS IMAX
     OMEGA   = IMAX
     OMEGAM  = OMEGA
     OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug

     PARDO a, i

           GET HY1a_picked(a,i)
           GET Y1a_picked(a,i)

           Tai(a,i)   = HY1a_picked(a,i)
           T1ai(a,i)  = Y1a_picked(a,i)
           T1ai(a,i) *= Omegam
           Tai(a,i)  +=  T1ai(a,i)

           PUT RES1a(a,i) =  Tai(a,i)

     ENDPARDO a, i

     PARDO i, i1, a1, a

         REQUEST HY2aa_picked(a,i1,a1,i) i
         REQUEST Y2aa_picked(a,i1,a1,i)  i

         Taiai(a,i1,a1,i)   = HY2aa_picked(a,i1,a1,i)
         T1aiai(a,i1,a1,i)  = Y2aa_picked(a,i1,a1,i)
         T1aiai(a,i1,a1,i) *= Omegam
         Taiai(a,i1,a1,i)  += T1aiai(a,i1,a1,i)

         PREPARE RES2aa(a,i1,a1,i) = Taiai(a,i1,a1,i)

     ENDPARDO i, i1, a1, a

     PARDO a,i,b,j

        REQUEST HY2ab_picked(a,i,b,j) j
        REQUEST Y2ab_picked(a,i,b,j)  j

        Taibj(a,i,b,j)   = HY2ab_picked(a,i,b,j)
        T1aibj(a,i,b,j)  = Y2ab_picked(a,i,b,j)
        T1aibj(a,i,b,j) *= Omegam
        Taibj(a,i,b,j)  += T1aibj(a,i,b,j)

        PREPARE RES2ab(a,i,b,j) = Taibj(a,i,b,j)

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

    ENDPROC FORM_RESIDUAL_VEC
#   ------------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA  = 0.0
     SUMAA = 0.0
     SUMAB = 0.0
     HC_A  = 0.0
     HC_AA = 0.0
     HC_AB = 0.0

     PARDO i, a

           GET RES1a(a,i)

           Tai(a,i)   = RES1a(a,i)
           TMP   = Tai(a,i) * Tai(a,i)
           SUMA += TMP

     ENDPARDO i, a

     PARDO i, i1, a1, a

           REQUEST RES2aa(a,i,a1,i1) i1

           Taiai(a,i,a1,i1)  = RES2aa(a,i,a1,i1)
           TMP     = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
           SUMAA += TMP

     ENDPARDO i, i1, a1, a

     PARDO a, i, b, j

           REQUEST RES2ab(a,i,b,j) j

           Taibj(a,i,b,j)  = RES2ab(a,i,b,j)
           TMP     = Taibj(a,i,b,j) * Taibj(a,i,b,j)
           SUMAB += TMP

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A  += SUMA
     COLLECTIVE HC_AA += SUMAA
     COLLECTIVE HC_AB += SUMAB

#     HC_AA   *= HALF 
     A_VALUE  = HC_A
     A_VALUE += HC_A
     A_VALUE += HC_AA
     A_VALUE += HC_AA
     A_VALUE += HC_AB

     EXECUTE SIP_BARRIER
#bgn_debug
     execute print_scalar A_VALUE 
#end_debug
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------

     PROC CHECK_CONVERGENCE_CORR
#    ---------------------------
     SUMA  = 0.0
     SUMAA = 0.0
     SUMAB = 0.0
     HC_A  = 0.0
     HC_AA = 0.0
     HC_AB = 0.0

     PARDO i, a

           GET CORR_VECa(a,i)

           Tai(a,i)   = CORR_VECa(a,i)
           TMP   = Tai(a,i) * Tai(a,i)
           SUMA += TMP

     ENDPARDO i, a

     PARDO i, i1, a1, a

           REQUEST CORR_VECaa(a,i,a1,i1) i1

           Taiai(a,i,a1,i1)  = CORR_VECaa(a,i,a1,i1)
           TMP     = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
           SUMAA += TMP

     ENDPARDO i, i1, a1, a

     PARDO a, i, b, j

           REQUEST CORR_VECab(a,i,b,j) j

           Taibj(a,i,b,j)  = CORR_VECab(a,i,b,j)
           TMP     = Taibj(a,i,b,j) * Taibj(a,i,b,j)
           SUMAB += TMP

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A  += SUMA
     COLLECTIVE HC_AA += SUMAA
     COLLECTIVE HC_AB += SUMAB

#     HC_AA   *= HALF
     A_VALUE  = HC_A
     A_VALUE += HC_A
     A_VALUE += HC_AA
     A_VALUE += HC_AA
     A_VALUE += HC_AB

     EXECUTE SIP_BARRIER

#bgn_debug
     execute print_scalar a_value 
#end_debug

     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE_CORR
#    ------------------------------

     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     PARDO a, i
           GET RES1a(a,i)
           GET VCONV1A(a,i)

           Tai(a,i)   = VCONV1A(a,i)
           T1ai(a,i)  = RES1a(a,i)

           Tai(a,i)  *= -1.0
           T2ai(a,i)  = OMEGA
           Tai(a,i)  += T2ai(a,i)

           EXECUTE APPLY_DEN2_NOR  T1ai Tai

           PUT CORR_VECa(a,i) =  T1ai(a,i)
     ENDPARDO a, i

     PARDO i, i1, a1, a
         REQUEST RES2aa(a,i,a1,i1) i1
         REQUEST VCONV2AA(a,i,a1,i1) i1

         Taiai(a,i,a1,i1)  = VCONV2AA(a,i,a1,i1)
         T1aiai(a,i,a1,i1) = RES2aa(a,i,a1,i1)

         Taiai(a,i,a1,i1) *= -1.0
         T2aiai(a,i,a1,i1) = OMEGA
         Taiai(a,i,a1,i1)  += T2aiai(a,i,a1,i1)

         EXECUTE APPLY_DEN4_NODIAG T1aiai Taiai

         PREPARE CORR_VECaa(a,i,a1,i1) = T1aiai(a,i,a1,i1)

     ENDPARDO i, i1, a1, a

     PARDO a, i, b, j
        REQUEST RES2ab(a,i,b,j) j
        REQUEST VCONV2AB(a,i,b,j) j

        Taibj(a,i,b,j)   = VCONV2AB(a,i,b,j)
        T1aibj(a,i,b,j)  = RES2ab(a,i,b,j)

        Taibj(a,i,b,j)  *= -1.0
        T2aibj(a,i,b,j)  = OMEGA
        Taibj(a,i,b,j) += T2aibj(a,i,b,j)

        EXECUTE APPLY_DEN4 T1aibj Taibj

        PREPARE CORR_VECab(a,i,b,j) = T1aibj(a,i,b,j)

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_CORRECTION_VEC
#    --------------------------

     PROC NORM_CORRECTION_VEC
#    ------------------------
# Normalization of the correction vector

    SUMA  = 0.0
    SUMAA = 0.0
    SUMAB = 0.0
    HC_A  = 0.0
    HC_AA = 0.0
    HC_AB = 0.0

    PARDO i, a
        GET  CORR_VECa(a,i)
        Tai(a,i) = CORR_VECa(a,i)
        TMP   = Tai(a,i) * Tai(a,i)
        SUMA += TMP
    ENDPARDO i, a

    PARDO i, i1, a1, a
        REQUEST CORR_VECaa(a,i,a1,i1) i1
        Taiai(a,i,a1,i1) = CORR_VECaa(a,i,a1,i1)
        TMP   = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
        SUMAA += TMP
    ENDPARDO i, i1, a1, a

    PARDO i, j, b, a
        REQUEST CORR_VECab(a,i,b,j) j
        Taibj(a,i,b,j) =  CORR_VECab(a,i,b,j)
        TMP    = Taibj(a,i,b,j) * Taibj(a,i,b,j)
        SUMAB +=  TMP
    ENDPARDO i, j, b, a

    EXECUTE SIP_BARRIER
    COLLECTIVE  HC_A  += SUMA
    COLLECTIVE  HC_AA += SUMAA
    COLLECTIVE  HC_AB += SUMAB

#    HC_AA *= HALF 
    SUM_R  = HC_A
    SUM_R += HC_A
    SUM_R += HC_AA
    SUM_R += HC_AA
    SUM_R += HC_AB

    EXPONENT = HALF
    EXECUTE NORM_FAC SUM_R EXPONENT
    INV_SQRT_NORM_R = SUM_R
    EXECUTE SIP_BARRIER

#bgn_debug
    execute print_scalar exponent
#end_debug

    PARDO i, a
        GET  CORR_VECa(a,i)
        Tai(a,i)  = CORR_VECa(a,i)
        Tai(a,i) *= INV_SQRT_NORM_R
        PUT VCACT1A(a,i) = Tai(a,i)
    ENDPARDO i, a

    PARDO i, i1, a1, a
        REQUEST CORR_VECaa(a,i,a1,i1) i1
        Taiai(a,i,a1,i1)  = CORR_VECaa(a,i,a1,i1)
        Taiai(a,i,a1,i1) *= INV_SQRT_NORM_R
        PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
    ENDPARDO i, i1, a1, a

    PARDO i, j, b, a
        REQUEST CORR_VECab(a,i,b,j) j
        Taibj(a,i,b,j)  = CORR_VECab(a,i,b,j)
        Taibj(a,i,b,j) *= INV_SQRT_NORM_R
        PREPARE VCACT2AB(a,i,b,j) =  Taibj(a,i,b,j)
    ENDPARDO i, j, b, a

    EXECUTE SERVER_BARRIER

    PARDO i, a
        GET  VCACT1A(a,i)
        Tai(a,i)  = VCACT1A(a,i)
        Tai(a,i) *= INV_SQRT_NORM_R
        PUT CORR_VECa(a,i) = Tai(a,i)
    ENDPARDO i, a

    PARDO i, i1, a1, a
        REQUEST VCACT2AA(a,i,a1,i1) i1
        Taiai(a,i,a1,i1) = VCACT2AA(a,i,a1,i1)
        Taiai(a,i,a1,i1) *= INV_SQRT_NORM_R
        PREPARE CORR_VECaa(a,i,a1,i1) = Taiai(a,i,a1,i1)
    ENDPARDO i, i1, a1, a

    PARDO i, j, b, a
       REQUEST VCACT2AB(a,i,b,j) j
       Taibj(a,i,b,j)  = VCACT2AB(a,i,b,j)
       Taibj(a,i,b,j) *= INV_SQRT_NORM_R
       PREPARE CORR_VECab(a,i,b,j) =  Taibj(a,i,b,j)
    ENDPARDO i, j, b, a

    EXECUTE SERVER_BARRIER

     ENDPROC NORM_CORRECTION_VEC
#    --------------------------

     PROC MAKE_ORTHO_COEFS
#    ---------------------

     DO MINDEX50
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE SIP_BARRIER 

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

           PARDO i, a

                 GET VC1A_HIST(a,i,NINDEX50)
                 GET CORR_VECa(a,i)

                 Tai(a,i)  = VC1A_HIST(a,i,NINDEX50)
                 T1ai(a,i) = CORR_VECa(a,i)
                 TMP       =  Tai(a,i)  * T1ai(a,i)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 T1xx(NINDEX50,NINDEX50)        *= 2.0
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, a

          PARDO i, i1, a1, a

                 REQUEST VCACT2aa_HIST(a,i,a1,i1,NINDEX50) i1
                 REQUEST CORR_VECaa(a,i,a1,i1) i1

                 Taiai(a,i,a1,i1)  = VCACT2aa_HIST(a,i,a1,i1,NINDEX50)
                 T1aiai(a,i,a1,i1) = CORR_VECaa(a,i,a1,i1)

                 TMP     = Taiai(a,i,a1,i1) *  T1aiai(a,i,a1,i1)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 T1xx(NINDEX50,NINDEX50)        *= 2.0
#                 T1xx(NINDEX50,NINDEX50)        *= 0.5 
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, i1, a1, a

           PARDO i, a, b, j

                 REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
                 REQUEST CORR_VECab(a,i,b,j) j

                 Taibj(a,i,b,j)  = VCACT2AB_HIST(a,i,b,j,NINDEX50)
                 T1aibj(a,i,b,j) = CORR_VECab(a,i,b,j)

                 TMP     = Taibj(a,i,b,j)  * T1aibj(a,i,b,j)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, a, b, j

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMAA  = 0.0
     SUMAB  = 0.0
     C_A    = 0.0
     C_AA   = 0.0
     C_AB   = 0.0

     PARDO i, a

           GET CORR_VECa(a,i)
           Tai(a,i)   = CORR_VECa(a,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              GET VC1A_HIST(a,i,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)
              T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL T1xx FACT

              T1ai(a,i) *= FACT
              T1ai(a,i) *= -1.0
              Tai(a,i)  += T1ai(a,i)

           ENDDO NINDEX50

           PUT R1a_INTMD(a,i) = Tai(a,i)

           TMP    = Tai(a,i) * Tai(a,i)
           SUMA  += TMP

     ENDPARDO i, a

     EXECUTE SERVER_BARRIER
     COLLECTIVE C_A += SUMA

     PARDO i, i1, a1, a

          REQUEST CORR_VECaa(a,i,a1,i1) i1
          Taiai(a,i,a1,i1)  = CORR_VECaa(a,i,a1,i1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
             T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL T1xx FACT

             T1aiai(a,i,a1,i1)  *= FACT
             T1aiai(a,i,a1,i1)  *= -1.0
             Taiai(a,i,a1,i1)   += T1aiai(a,i,a1,i1)

           ENDDO NINDEX50

           PREPARE R2_intmd_aa(a,i,a1,i1) = Taiai(a,i,a1,i1)

           TMP  =  Taiai(a,i,a1,i1) *  Taiai(a,i,a1,i1)
           SUMAA  += TMP

     ENDPARDO i, i1, a1, a

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_AA += SUMAA

     PARDO i, a, b, j

           REQUEST CORR_VECab(a,i,b,j) j
           Taibj(a,i,b,j)  = CORR_VECab(a,i,b,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,NINDEX50)
              T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL T1xx FACT

              T1aibj(a,i,b,j) *= FACT
              T1aibj(a,i,b,j) *= -1.0
              Taibj(a,i,b,j)  += T1aibj(a,i,b,j)

          ENDDO NINDEX50

          PREPARE R2_intmd_ab(a,i,b,j) = Taibj(a,i,b,j)

          TMP =  Taibj(a,i,b,j) *  Taibj(a,i,b,j)
          SUMAB += TMP

     ENDPARDO i, a, b, j

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_AB += SUMAB

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_AA
     NORM_NEW_ORTGC += C_AB

     EXPONENT = HALF 
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a_intmd(a,i)
#         tmp = r1a_intmd(a,i) * r1a_intmd(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request  r2_intmd_aa(a,i1,a1,i) i
#            tmp =  r2_intmd_aa(a,i1,a1,i) *  r2_intmd_aa(a,i1,a1,i)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i,b,j
#            request  r2_intmd_ab(a,i,b,j) j
#            tmp =   r2_intmd_ab(a,i,b,j) *  r2_intmd_ab(a,i,b,j)
#            tmpa += tmp
#      endpardo a,i,b,j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

    PROC DRIVE_ORTHO
#   ----------------

     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT

    ENDPROC DRIVE_ORTHO
#   --------------------

     PROC RESCALE_NEW_C
#    ------------------

     SUMA  = 0.0
     SUMAA = 0.0
     SUMAB = 0.0
     HC_A  = 0.0
     HC_AA = 0.0
     HC_AB = 0.0

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            SUMA += TMP

      ENDPARDO i, a

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)

              TMP    = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
              SUMAA += TMP

      ENDPARDO i, i1, a1, a

     PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j) = R2_intmd_ab(a,i,b,j)

              TMP    = Taibj(a,i,b,j) * Taibj(a,i,b,j)
              SUMAB +=  TMP

     ENDPARDO i, j, b, a

     EXECUTE SIP_BARRIER
     COLLECTIVE HC_A  += SUMA
     COLLECTIVE HC_AA += SUMAA
     COLLECTIVE HC_AB += SUMAB

#     HC_AA *= HALF 
     SUM_R  = HC_A
     SUM_R += HC_A
     SUM_R += HC_AA
     SUM_R += HC_AA
     SUM_R += HC_AB

     EXPONENT = HALF
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXECUTE SIP_BARRIER

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i)  = R1a_intmd(a,i)
            Tai(a,i) *= INV_SQRT_NORM_R
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)
              Taiai(a,i,a1,i1) *= INV_SQRT_NORM_R
              PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)

      ENDPARDO i, i1, a1, a

      PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j)  = R2_intmd_ab(a,i,b,j)
              Taibj(a,i,b,j) *= INV_SQRT_NORM_R
              PREPARE VCACT2AB(a,i,b,j) =  Taibj(a,i,b,j)

      ENDPARDO i, j, b, a

      EXECUTE SERVER_BARRIER

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get vcact1a(a,i)
#         tmp = vcact1a(a,i) * vcact1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request  VCACT2aa(a,i1,a1,i) i
#            tmp = VCACT2aa(a,i1,a1,i) * VCACT2aa(a,i1,a1,i)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

    ENDPROC RESCALE_NEW_C
#   ---------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           OVLP_CHECK(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF

                 SUMA  = 0.0
                 SUMAA = 0.0
                 SUMAB = 0.0
                 HC_A  = 0.0
                 HC_AA = 0.0
                 HC_AB = 0.0

                 PARDO i, a

                       GET VC1A_HIST(a,i,NINDEX50)
                       GET VC1A_HIST(a,i,MINDEX50)

                        Tai(a,i)   = VC1A_HIST(a,i,NINDEX50)
                        T1ai(a,i)  = VC1A_HIST(a,i,MINDEX50)

                        TMP   = Tai(a,i) * T1ai(a,i)
                        SUMA += TMP

                 ENDPARDO i, a

                 EXECUTE SERVER_BARRIER
                 COLLECTIVE HC_A += SUMA

                PARDO i, i1, a1, a

                      REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
                      REQUEST VCACT2AA_HIST(a,i,a1,i1,MINDEX50) i1

                      Taiai(a,i,a1,i1)  = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
                      T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,MINDEX50)

                      TMP     = Taiai(a,i,a1,i1) * T1aiai(a,i,a1,i1)
                      SUMAA += TMP

                ENDPARDO i, i1, a1, a

                EXECUTE SERVER_BARRIER
                COLLECTIVE HC_AA += SUMAA

                PARDO a, i, b, j
                      REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
                      REQUEST VCACT2AB_HIST(a,i,b,j,MINDEX50) j

                      Taibj(a,i,b,j)  = VCACT2AB_HIST(a,i,b,j,NINDEX50)
                      T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,MINDEX50)

                      TMP     = Taibj(a,i,b,j) * T1aibj(a,i,b,j)
                      SUMAB += TMP

                ENDPARDO a, i, b, j

                EXECUTE SERVER_BARRIER
                COLLECTIVE HC_AB += SUMAB

#                HC_AA   *= HALF 
                A_VALUE  = HC_A
                A_VALUE += HC_A
                A_VALUE += HC_AA
                A_VALUE += HC_AA
                A_VALUE += HC_AB

                 KCOUNT = 0.0
                 DO KINDEX50
                    KCOUNT += 1
                    LCOUNT = 0.0

                    DO LINDEX50
                       LCOUNT += 1.0
                       OVLP_CHECK(MINDEX50,NINDEX50) = A_VALUE
                    ENDDO LINDEX50

                 ENDDO KINDEX50
              ENDDO MINDEX50
     ENDDO NINDEX50

     execute print_static OVLP_CHECK  iter_count

     ENDPROC C_CHECK
#    ---------------

     PROC FORM_MAX_DIAG_GUESS
#    ------------------------
     DO NROOTS
        PARDO a, i
              INIT_RVEC_AA(a,i,NROOTS) = 0.0
              DIAGA(a,i)               = 0.0
        ENDPARDO a, i
     ENDDO NROOTS

     DO a
     DO i
           GET VCONV1A(a,i)
           Tai(a,i)   = VCONV1A(a,i)
           DIAGA(a,i) = Tai(a,i)
     ENDDO i
     ENDDO a

     EXECUTE FORM_RPA_GUESS DIAGA INIT_RVEC_AA

     ENDPROC FORM_MAX_DIAG_GUESS
#    ---------------------------

    PROC PREP_MAX_DIAG_GUESS
#    -----------------------

     EXECUTE GUESS_4CURRENT_ROOT INIT_RVEC_AA MYROOT

      COUNTER = 0
      ONE     = 1.0
#
# Always copy the position one because the above SIP copies the
# the guess for the current root to position one.

      DO MROOTS

         COUNTER += 1.0
         IF COUNTER == ONE

            PARDO a, i
                Tai(a,i) =  INIT_RVEC_AA(a,i,nroots)
                PUT R1a_intmd(a,i) =  Tai(a,i)
            ENDPARDO a, i

         ENDIF

      ENDDO MROOTS
      EXECUTE SIP_BARRIER

#bgn_debug
#      tmpa = 0.0
#      do i
#      do a
#         Get R1a_intmd(a,i)
#         tmp  = R1a_intmd(a,i) * R1a_intmd(a,i)
#         tmpa += tmp
#      enddo a
#      enddo i
#      execute print_scalar tmpa
#end_debug

      SUMA = 0.0
      SUMB = 0.0
      TMPA = 0.0
      TMPB = 0.0
      PARDO i, a
            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            TMPA += TMP
      ENDPARDO i, a
      EXECUTE SIP_BARRIER
      COLLECTIVE  SUMA += TMPA
      EXECUTE SIP_BARRIER
      SUMAB  = SUMA
      SUMAB *= 2.0

#bgn_debug
#      execute print_scalar sumab
#end_debug

      EXPONENT = HALF 
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB
      NORM_R = SUMAB

      PARDO i, a
            GET  R1a_intmd(a,i)
            Tai(a,i)  = R1a_intmd(a,i)
            Tai(a,i) *= INV_SQRT_NORM_R
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO a, a1, i, i1
            Taiai(a,i,a1,i1) = 0.0
            PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO a, a1, i, i1

      PARDO a, b, i, j
            Taibj(a,i,b,j) = 0.0
            PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, b, i, j
#bgn_debug
#      tmpa = 0.0
#      do i
#      do a
#         Get VCACT1A(a,i)
#         tmp  = VCACT1A(a,i) * VCACT1A(a,i)
#         tmpa += tmp
#      enddo a
#      enddo i
#      execute print_scalar tmpa
#end_debug

     ENDPROC PREP_MAX_DIAG_GUESS
#    ---------------------------

     PROC FORCE_TO_ZERO
#    ------------------

      PARDO i, a
            Tai(a,i)  = 0.0
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO a, a1, i, i1
            Taiai(a,i,a1,i1) = 0.0
            PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO a, a1, i, i1

      PARDO a, b, i, j
            Taibj(a,i,b,j) = 0.0
            PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, b, i, j

      EXECUTE SERVER_BARRIER

     ENDPROC FORCE_TO_ZERO
#    ---------------------

     PROC TRANSFORM_C
#    ----------------

     PARDO i, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET VC1A_HIST(a,i,MINDEX50)
                       Tain(a,i,MINDEX50)  = VC1A_HIST(a,i,MINDEX50)
                       T1ain(a,i,NINDEX50) = Tain(a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(a,i,NINDEX50) += T1ain(a,i,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, a

    PARDO i, i1, a1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCACT2aa_HIST(a,i,a1,i1,MINDEX50)  i1

                       Taiain(a,i,a1,i1,MINDEX50) = VCACT2aa_HIST(a,i,a1,i1,MINDEX50)
                       T1aiain(a,i,a1,i1,NINDEX50) = Taiain(a,i,a1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) += T1aiain(a,i,a1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, a1, a

     PARDO a, i, b, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCACT2ab_HIST(a,i,b,j,MINDEX50)  j

                       Taibjn(a,i,b,j,MINDEX50) = VCACT2ab_HIST(a,i,b,j,MINDEX50)
                       T1aibjn(a,i,b,j,NINDEX50) = Taibjn(a,i,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2ab_TRUNCT(a,i,b,j,NINDEX50) += T1aibjn(a,i,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC TRANSFORM_C
#    -------------------

     PROC COPY_NORM_C
#    ----------------
      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT <= NREDUCE
            SUMA  = 0.0
            SUMAA = 0.0
            SUMAB = 0.0
            HC_A  = 0.0
            HC_AA = 0.0
            HC_AB = 0.0

            PARDO a, i
                  GET Y1A_TRUNCT(a,i,NINDEX50)
                  Tai(a,i) = Y1A_TRUNCT(a,i,NINDEX50)
                  TMP   = Tai(a,i) * Tai(a,i) 
                  SUMA += TMP
            ENDPARDO a, i

            PARDO a, a1, i, i1
                  REQUEST  Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) i1
                  Taiai(a,i,a1,i1) = Y2aa_TRUNCT(a,i,a1,i1,NINDEX50)
                  TMP    = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
                  SUMAA += TMP
            ENDPARDO a, a1, i, i1

            PARDO a, b, i, j
                  REQUEST Y2ab_TRUNCT(a,i,b,j,NINDEX50) j
                  Taibj(a,i,b,j) = Y2ab_TRUNCT(a,i,b,j,NINDEX50)
                  TMP    = Taibj(a,i,b,j) * Taibj(a,i,b,j)
                  SUMAB +=  TMP
            ENDPARDO a, b, i, j

            EXECUTE SIP_BARRIER
            COLLECTIVE HC_A  += SUMA
            COLLECTIVE HC_AA += SUMAA
            COLLECTIVE HC_AB += SUMAB

#            HC_AA *= HALF
            SUM_R  = HC_A
            SUM_R += HC_A
            SUM_R += HC_AA
            SUM_R += HC_AA
            SUM_R += HC_AB
#bgn_debug
#     execute print_scalar SUM_R
#end_debug
            EXPONENT = HALF 
            EXECUTE NORM_FAC SUM_R EXPONENT
            INV_SQRT_NORM_R = SUM_R

            EXECUTE SIP_BARRIER

            PARDO a, i
                  GET Y1A_TRUNCT(a,i,NINDEX50)
                  Tain(a,i,NINDEX50) = Y1A_TRUNCT(a,i,NINDEX50)
                  Tain(a,i,NINDEX50)*= INV_SQRT_NORM_R
                  PUT VC1A_HIST(a,i,NINDEX50) = Tain(a,i,NINDEX50)
            ENDPARDO a, i

            PARDO a, a1, i, i1
                  REQUEST  Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) i1
                  Taiain(a,i,a1,i1,NINDEX50) = Y2aa_TRUNCT(a,i,a1,i1,NINDEX50)
                  Taiain(a,i,a1,i1,NINDEX50)*= INV_SQRT_NORM_R
                  PREPARE VCACT2AA_HIST(a,i,a1,i1,NINDEX50) =  Taiain(a,i,a1,i1,NINDEX50)
            ENDPARDO a, a1, i, i1

            PARDO a, b, i, j
                  REQUEST Y2ab_TRUNCT(a,i,b,j,NINDEX50) j
                  Taibjn(a,i,b,j,NINDEX50) = Y2ab_TRUNCT(a,i,b,j,NINDEX50)
                  Taibjn(a,i,b,j,NINDEX50)*= INV_SQRT_NORM_R 
                  PREPARE VCACT2AB_HIST(a,i,b,j,NINDEX50) = Taibjn(a,i,b,j,NINDEX50)
            ENDPARDO a, b, i, j

            EXECUTE SERVER_BARRIER

        ENDIF

     ENDDO NINDEX50

     ENDPROC COPY_NORM_C
#    -------------------

     PROC INIT_TO_ZERO
#    -----------------

     NCOUNT = 0
     DO NINDEX50
         NCOUNT += 1.0

        IF NCOUNT <= NREDUCE 
        PARDO i,a
              Tai(a,i)  = 0.0
              PUT Y1a_TRUNCT(a,i,NINDEX50) = Tai(a,i)
        ENDPARDO i, a

        PARDO a, a1, i, i1
              Taiai(a,i,a1,i1) = 0.0
              PREPARE Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) = Taiai(a,i,a1,i1)
        ENDPARDO a, a1, i, i1

        PARDO a, b, i, j
              Taibj(a,i,b,j) = 0.0
              PREPARE Y2ab_TRUNCT(a,i,b,j,NINDEX50)  = Taibj(a,i,b,j)
       ENDPARDO a, b, i, j
       ENDIF 
     
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

     ENDPROC INIT_TO_ZERO
#    -------------------

     PROC TRANSFORM_HC
#    -----------------

     PARDO i, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET VCH1A_HIST(a,i,MINDEX50)
                       Tain(a,i,MINDEX50)  = VCH1A_HIST(a,i,MINDEX50)
                       T1ain(a,i,NINDEX50) = Tain(a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A_TRUNCT(a,i,NINDEX50) += T1ain(a,i,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, a

     PARDO i, i1, a1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCHACT2aa_HIST(a,i,a1,i1,MINDEX50)  i1

                       Taiain(a,i,a1,i1,MINDEX50) = VCHACT2aa_HIST(a,i,a1,i1,MINDEX50)
                       T1aiain(a,i,a1,i1,NINDEX50) = Taiain(a,i,a1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) += T1aiain(a,i,a1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, a1, a

     PARDO a, i, b, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > NREDUCE 
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCHACT2ab_HIST(a,i,b,j,MINDEX50)  j

                       Taibjn(a,i,b,j,MINDEX50) = VCHACT2ab_HIST(a,i,b,j,MINDEX50)
                       T1aibjn(a,i,b,j,NINDEX50) = Taibjn(a,i,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2ab_TRUNCT(a,i,b,j,NINDEX50) += T1aibjn(a,i,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC TRANSFORM_HC
#    --------------------

     PROC COPY_HC
#    ------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT <= NREDUCE

           PARDO a, i
               GET Y1A_TRUNCT(a,i,NINDEX50)
               Tai(a,i) = Y1A_TRUNCT(a,i,NINDEX50)
               PUT VCH1A_HIST(a,i,NINDEX50) = Tai(a,i)
           ENDPARDO a, i

           PARDO a, a1, i, i1
               REQUEST  Y2aa_TRUNCT(a,i,a1,i1,NINDEX50) i1
               Taiai(a,i,a1,i1) = Y2aa_TRUNCT(a,i,a1,i1,NINDEX50)
               PREPARE VCHACT2AA_HIST(a,i,a1,i1,NINDEX50) = Taiai(a,i,a1,i1)
           ENDPARDO a, a1, i, i1

           PARDO a, b, i, j
               REQUEST Y2ab_TRUNCT(a,i,b,j,NINDEX50) j
               Taibj(a,i,b,j) = Y2ab_TRUNCT(a,i,b,j,NINDEX50)
               PREPARE VCHACT2AB_HIST(a,i,b,j,NINDEX50) = Taibj(a,i,b,j)
           ENDPARDO a, b, i, j

         ENDIF

     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

     ENDPROC COPY_HC
#    ---------------

     PROC SET_EOM_INCLUDE
#    --------------------

     EXECUTE SET_ACES3_VARS ITER_COUNT FORT
     EXECUTE SET_ACES3_VARS ROOT_COUNT FIFT

     ENDPROC SET_EOM_INCLUDE
#    -----------------------

     PROC INIT_AUX_STATIC_ARRAYS
#    ---------------------------

      DO MINDEX50
      DO NINDEX50
         DVECTORS(NINDEX50,MINDEX50) = ZERO
      ENDDO NINDEX50
      ENDDO MINDEX50

      DO NINDEX50
        OVERLAP_R(NINDEX50) = ZERO
      ENDDO NINDEX50

      DO INDONE
      DO MROOTS
         PSEUDO_ROOTS(MROOTS,INDONE) = ZERO
         EOM_EES(MROOTS,INDONE)      = ZERO
      ENDDO MROOTS
      ENDDO INDONE

      EXECUTE SIP_BARRIER

     ENDPROC INIT_AUX_STATIC_ARRAYS
#    ------------------------------

     PROC TRUNCATE 
#    -------------
# Reduce the subspace dimension. 
   
     IF EOM_MAXCYC < TWELVE 
        NREDUCE  = EOM_MAXCYC
        NREDUCE -= THREE 
     ELSE
        NREDUCE = TWELVE
     ENDIF
     NFULL  = ITER_COUNT

     EXECUTE SET_ACES3_VARS NREDUCE TEN
     EXECUTE SET_ACES3_VARS NFULL   ELV
     EXECUTE SET_ACES3_VARS OMEGA   TWL  
     
     EXECUTE TRUNCATE_EOM_SUBSPACE A_DIAGS DVECTORS
#bgn_debug
#     execute print_static A_DIAGS NREDUCE
#     execute print_static DVECTORS NFULL 
#end_debug

     IF TRNC_COUNT > ONE
        CALL INIT_TO_ZERO 
     ENDIF 
     CALL TRANSFORM_C 
     CALL COPY_NORM_C
     CALL INIT_TO_ZERO 
     CALL TRANSFORM_HC 
     CALL COPY_HC 

     ENDPROC TRUNCATE
#    ----------------

    PROC ORTHO_NEW_ROOT
#   -------------------
# If we wants to use the exsisting sub-space for the next root, we
# need to orthogonalize the new guess vector to the exsisting subspace.
# Lets use the exsisting arrays and the Schmidt routines. 

    PARDO a, i
        GET VCACT1A(a,i)
        Tai(a,i) = VCACT1A(a,i)
        PUT CORR_VECa(a,i) = Tai(a,i)
    ENDPARDO a, i

    PARDO a, a1, i, i1
        Taiai(a,i,a1,i1) = 0.0
        PREPARE CORR_VECaa(a,i,a1,i1) = Taiai(a,i,a1,i1)
    ENDPARDO a, a1, i, i1

    PARDO a, b, i, j
        Taibj(a,i,b,j) = 0.0
        PREPARE CORR_VECab(a,i,b,j) = Taibj(a,i,b,j)
    ENDPARDO a, b, i, j
    EXECUTE SERVER_BARRIER

    CALL DRIVE_ORTHO

    CALL RESCALE_NEW_C

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get vcact1a(a,i)
#         tmp = vcact1a(a,i) * vcact1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#          request  VCACT2aa(a,i1,a1,i) i
#          tmp = VCACT2aa(a,i1,a1,i) * VCACT2aa(a,i1,a1,i)
#          tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

    ENDPROC ORTHO_NEW_ROOT
#   ----------------------

#-------------------------------------------------------------------------
#
#-------------------------------------------------------------------------
#                                                                        #
#                      \--------------------------/                      #
#                      |    BEGIN MAIN PROGRAM    |                      #
#                      /--------------------------\                      #
#                                                                        #
#-------------------------------------------------------------------------

      ZERO     = 0.0
      ONE      = 1.0
      TEN      = 10.0
      ELV      = 11.0
      TWELVE   = 12.0
      THRTEN   = 13.0
      TWL      = TWELVE 
      NINETEEN = 19.0
      MONE     = -1.0
      THREE    = 3.0
      FORT     = 14.0
      FIFT     = 15.0
      HALF     = 0.50
      TWEN     = 20.0

      CALL CREATE_ARRAYS
      CALL READ_AMP
      CALL TRAN_UHF
      execute server_barrier
      CALL HBAR
      execute server_barrier

      CALL INIT_PROP_ARRAYS 
      CALL INIT_AUX_STATIC_ARRAYS
#
# Create arrays used and zero out some scalars
# --------------------------------------------
#
     TARGET_ROOTS     = EOM_ROOTS
     EOM_THRES        = EOM_TOL
     EOM_GUESS        = EE_GUESS
     EOM_DENOM        = EE_DENOM
     EOM_MAXCYC       = EE_MAXCYC
     IDENS            = ONE
     EXACT_HY         = ZERO
     MAX_OVLP         = ONE
     MIN_ENEG         = ZERO
     LOCK_THRES       = 0.001
     FIRST_VEC        = ONE
     PREVS_VEC        = ZERO 
     LEFT             = ZERO
     RIGHT            = ZERO
     FRESH_SBSP       = ZERO
     VERY_SMALL       = EOM_THRES

# The default Guess is CIS, can be switched by proper key-values.

     EXECUTE SET_ACES3_VARS LEFT RIGHT 

     CIS_GUESS       = ONE 
     MAX_DIAGS_GUESS = ZERO 
     IF EOM_GUESS == ONE
        MAX_DIAGS_GUESS  = ONE
     ENDIF 

# The default denominator is Fock and can be switched to Hbar

     EOM_DENOM = ZERO
     IF EOM_DENOM == ONE 
        CALL FORM_12HHPP_DIAG  
     ELSE
        CALL FORM_11HHPP_DIAG
     ENDIF 

# The default iteration number is 30. Increase if desired. 
  
     MAX_SUBSP_DIM  = EOM_MAXCYC

#bgn_debug
         execute print_scalar eom_guess
         execute print_scalar eom_denom
         execute print_scalar eom_maxcyc
#end_debug

     ROOT_COUNT = ZERO
     TRNC_COUNT = ZERO
     ITER_COUNT = ZERO 
 
     DO NROOTS

         ROOT_COUNT += ONE 
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
         MYROOT = ROOT_COUNT

         IF CIS_GUESS == ONE 
            CALL PREP_CIS_GUESS
         ENDIF 

         IF MAX_DIAGS_GUESS == ONE 
            CALL PREP_MAX_DIAG_GUESS
         ENDIF 

         CALL KEEP_GUESS_VECS 

         LOCK   = ZERO 
         IDEGEN = ZERO
         IF FRESH_SBSP != ONE
            IF ROOT_COUNT != ONE
               CALL ORTHO_NEW_ROOT 
               E_OLD      = OMEGA 
            ENDIF 
         ENDIF 
         
         IF FRESH_SBSP == ONE
            ITER_COUNT = ZERO 
         ELSE

# The following logic handles a very rare occurence when the
# previous subspace of the order 20 (maximum) is used for the
# next root.

            IF ITER_COUNT == TWEN
               ITER_COUNT = ZERO
           ENDIF
         ENDIF
         SBSP_COUNT = ZERO

         DO EOM_CYCLE 

            CALL SET_TO_ZERO

            ITER_COUNT += ONE
            SBSP_COUNT += ONE

            CALL SET_EOM_INCLUDE 

# There is a misnomer here. The name iter_count and sbsp_count 
# should have been interchanged. This happened because subspace 
# truncation was added at a latter stage. Notice that iter_count
# do not exceed 20 as long as truncation is used. As a result 
# a test to terminate the loop is done using sbsp_count. 

#bgn_debug
        execute print_scalar ITER_COUNT
        execute print_scalar SBSP_COUNT
##end_debug
            IF SBSP_COUNT > MAX_SUBSP_DIM
               EXIT 
            ENDIF

            CALL SAVE_C_VECTORS
#bgn_debug
#            call c_check
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS

            IF ITER_COUNT == ONE
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
           IF ITER_COUNT != ONE
              CALL REORDER_A_EIGS
           ENDIF
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal.
#
           IF ITER_COUNT == ONE
              CALL FORM_NEWVECS_ITR1
           ELSE

              IF EXACT_HY == ONE
                 CALL FORM_NEWVECS

                 IF MAX_OVLP == ONE 
                    IF FIRST_VEC == ONE 
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF 
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF 
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF

                 CALL FORM_SELECTED_Y
                 CALL FORM_HBAR_Y_VECS
              ELSE
                 CALL FORM_NEWVECS

                 IF MAX_OVLP == ONE 
                    IF FIRST_VEC == ONE 
                       CALL SELECT_VECS_MAX_OVLP1
                    ENDIF 
                    IF PREVS_VEC == ONE
                       CALL SELECT_VECS_MAX_OVLP2
                    ENDIF
                 ENDIF 
                 IF MIN_ENEG == ONE
                    CALL SELECT_VECS_MIN_ENEG
                 ENDIF 

                 CALL FORM_SELECTED_Y
                 CALL FORM_NEW_HBAR_Y_VECS
                 CALL SELECT_HBAR_Y_VEC_TOGO
              ENDIF

              CALL FORM_RESIDUAL_VEC
              CALL CHECK_CONVERGENCE

              IF ITER_COUNT > ONE
                   EDIFF = E_OLD - OMEGA
              ENDIF
              E_OLD = OMEGA
              EDIFF *=EDIFF
              EXECUTE SQUARE_ROOT EDIFF HALF
#bgn_debug
      execute print_scalar RESIDUAL_NORM
      execute print_scalar OMEGA
      execute print_scalar EDIFF
#end_debug
              IF LOCK  == ZERO
              IF EDIFF < LOCK_THRES
                 IF IDEGEN == ONE
                     LOCK = ZERO
                  ELSE
                     LOCK = ONE
                  ENDIF
              ENDIF 
              ENDIF 
     
              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ELSE
                CALL FORM_CORRECTION_VEC
#bgn_debug
# These two calls (check convergence based on the RMS of correction
# vector as was done in the old code (not precisely right) or the
# of the correction vector before Schmidt orthonormalization have no
# effects on convergence. I keep these options for future references.
#                CALL CHECK_CONVERGENCE_CORR
#                CALL NORM_CORRECTION_VEC
#end_debug
                CALL DRIVE_ORTHO
                CALL RESCALE_NEW_C
              ENDIF 

# The subspace truncation. When the iteration count goes above
# 19 and still have not converged, then select 12 vectors closest
# to the eigenvalue of interest and start Davidson procedure
# from iteration 13 again.

              IF ITER_COUNT > NINETEEN

                 TRNC_COUNT += ONE 
                 CALL TRUNCATE
                 ITER_COUNT  = TWL

              ENDIF
          ENDIF

         ENDDO EOM_CYCLE 

         EXECUTE SERVER_BARRIER
#bgn_debug
      execute print_scalar OMEGA
#end_debug
         SBSP_COUNT += -1.0
         IF SBSP_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be located in specified 
# number of cycles.
# Lets set energy to zero and inform the user whart that means

            DO INDONE
            MCOUNT = 0.0
            DO KROOT
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  PSEUDO_ROOTS(KROOT,INDONE) = OMEGA
               ENDIF
            ENDDO KROOT 
            ENDDO INDONE 

            IF FRESH_SBSP != ONE 
              CALL SAVE_C_VECTORS 
              OMEGA_KEEP= OMEGA 
            ENDIF 
            OMEGA     = ZERO
            CALL FORCE_TO_ZERO

           ENDIF
         ENDIF

          DO INDONE
            MCOUNT = 0.0
            DO KROOT
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  EOM_EES(KROOT,INDONE)      = OMEGA
                  IF OMEGA != ZERO 
                     PSEUDO_ROOTS(KROOT,INDONE) = OMEGA 
                  ENDIF 
                  TEE(KROOT,INDONE)     = EOM_EES(KROOT,INDONE)
                  PUT REE(KROOT,INDONE) = TEE(KROOT,INDONE) 
                  PARDO a, i
                      GET VCACT1A(a,i)
                      tai(a,i) = VCACT1A(a,i)
                      PUT R1A_VECS(a,i,KROOT) = tai(a,i)
                      PUT R1B_VECS(a,i,KROOT) = tai(a,i)
                  ENDPARDO a, i

                  PARDO a, i, a1, i1
                      REQUEST VCACT2AA(a,i,a1,i1) i1
                      taiai(a,i,a1,i1) = VCACT2AA(a,i,a1,i1)
                      PREPARE R2AA_VECS(a,i,a1,i1,KROOT) =taiai(a,i,a1,i1)
                 ENDPARDO a, i, a1, i1

                 PARDO a, i, b, j
                     REQUEST VCACT2AB(a,i,b,j) j
                     taibj(a,i,b,j) = VCACT2AB(a,i,b,j)
                     PREPARE R2AB_VECS(a,i,b,j,KROOT) = taibj (a,i,b,j)
                 ENDPARDO a, i, b, j
               ENDIF
            ENDDO KROOT
          ENDDO INDONE

          EXECUTE SERVER_BARRIER
          IF FRESH_SBSP != ONE 
             OMEGA = OMEGA_KEEP 
          ENDIF 
      ENDDO NROOTS
#
      EXECUTE SERVER_BARRIER
#bgn_debug
      ROOT_COUNT -= 1.0
      execute print_static EOM_EES ROOT_COUNT
#end_debug

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get VCACT1A(a,i)
#         tmp = VCACT1A(a,i) * VCACT1A(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      ncount = 0.0
#      do nroots
#      ncount += 1.0
#      if ncount > TARGET_ROOTS
#         exit
#      endif
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a_vecs(a,i,nroots)
#        tmp = r1a_vecs(a,i,nroots)*r1a_vecs(a,i,nroots)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request r2aa_vecs(a,i1,a1,i,nroots) i
#            tmp = r2aa_vecs(a,i1,a1,i,nroots) * r2aa_vecs(a,i1,a1,i,nroots)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i1,a,b
#            request r2ab_vecs(a,i1,b,j,nroots) j
#            tmp =  r2ab_vecs(a,i1,b,j,nroots) * r2ab_vecs(a,i1,b,j,nroots)
#            tmpa+= tmp
#      endpardo j,i1,a, b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      enddo nroots 
#end_debug

       SEVEN_ZERO = 70.0
       EXECUTE  PRINT_REL_INFO  SEVEN_ZERO EOM_EES
#
# This DENS2JOBARC to call simply write a record named "EOM     " to
# JOBARC file. It will be used in a2proc.
#
       Etemp  = -2.0
       EXECUTE DENS2JOBARC EOM_EES Etemp

       EXECUTE  SERVER_BARRIER

       EXECUTE  BLOCKS_TO_LIST  REE

       EXECUTE  BLOCKS_TO_LIST  R1A_VECS
       EXECUTE  BLOCKS_TO_LIST  R2AA_VECS
       EXECUTE  BLOCKS_TO_LIST  R2AB_VECS

       EXECUTE  BLOCKS_TO_LIST  HBAR_ia
       EXECUTE  BLOCKS_TO_LIST  HBAR_jb

       EXECUTE  BLOCKS_TO_LIST  t1a
       EXECUTE  BLOCKS_TO_LIST  t1b
       EXECUTE  BLOCKS_TO_LIST  t2aa
       EXECUTE  BLOCKS_TO_LIST  t2ab
       EXECUTE  BLOCKS_TO_LIST  t2bb

       EXECUTE  BLOCKS_TO_LIST  A1a
       EXECUTE  BLOCKS_TO_LIST  A2aa
       EXECUTE  BLOCKS_TO_LIST  A2ab

       EXECUTE  BLOCKS_TO_LIST  VSpipi(p,i,p1,i1)
       EXECUTE  BLOCKS_TO_LIST  Vpiqj(p,i,q,j)

       EXECUTE  BLOCKS_TO_LIST  Vaaii
       EXECUTE  BLOCKS_TO_LIST  Viaai
       EXECUTE  BLOCKS_TO_LIST  Vaaai

       EXECUTE  SIP_BARRIER
       EXECUTE  SERVER_BARRIER
       EXECUTE  WRITE_BLOCKS_TO_LIST
       EXECUTE  SERVER_BARRIER
#
#       delete VCACT1A
#       delete VCHACT1A
#       delete VSTART1A1
#       delete VSTART1A2
#       execute sip_barrier
#
       ENDSIAL REOM_CCSD_RHF
