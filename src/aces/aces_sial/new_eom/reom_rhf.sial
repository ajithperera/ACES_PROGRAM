                       Taibjn(a,i,b,j,MINDEX50) = VCHACT2ab_HIST(a,i,b,j,MINDEX50)
                       T1aibjn(a,i,b,j,NINDEX50) = Taibjn(a,i,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE HY2ab(a,i,b,j,NINDEX50) += T1aibjn(a,i,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_NEW_HBAR_Y_VECS
#    ----------------------------

     PROC KEEP_GUESS_VECS
#    --------------------

     PARDO a, i
         GET VCACT1A(a,i)
         Tai(a,i) = VCACT1A(a,i)
         PUT INITIAL_VEC(a,i) = Tai(a,i) 
     ENDPARDO a, i

     EXECUTE SIP_BARRIER 

     ENDPROC KEEP_GUESS_VECS
#    -----------------------

     PROC SELECT_VECS_MAX_OVLP1
#    --------------------------

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT >  ITER_COUNT
           EXIT
        ENDIF

        SUMA   = 0.0
        SUMB   = 0.0
        CY_A   = 0.0
        CY_B   = 0.0

        PARDO a, i
              GET INITIAL_VEC(a,i)
              GET Y1a(a,i,MINDEX50)

              Tai(a,i)  = INITIAL_VEC(a,i)
              T1ai(a,i) = Y1a(a,i,MINDEX50)

              TMP   =  Tai(a,i) * T1ai(a,i)
              SUMA +=  TMP

        ENDPARDO a, i

        EXECUTE SERVER_BARRIER
        COLLECTIVE CY_A += SUMA

        CY_AB  = CY_A

        KCOUNT = 0.0
        DO KINDEX50
           KCOUNT += 1.0

           IF KCOUNT == MCOUNT
              OVERLAP_R(MINDEX50) = CY_AB
           ENDIF

        ENDDO KINDEX50

     ENDDO  MINDEX50

     EXECUTE SIP_BARRIER

     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
      ELSE
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
      ENDIF

#bgn_debug
     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP1
#    -----------------------------

     PROC SELECT_VECS_MAX_OVLP2
#    --------------------------

     IF PREVS_VEC == ONE
        FOLLOW = ITER_COUNT
        FOLLOW -= ONE
     ENDIF
#bgn_debug
     execute print_scalar follow
#end_debug

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT != FOLLOW
           EXIT
        ENDIF

        MCOUNT = 0.0
        DO MINDEX50
           MCOUNT += 1.0
           IF MCOUNT >  ITER_COUNT
              EXIT
           ENDIF

                 SUMA   = 0.0
                 SUMB   = 0.0
                 CY_A   = 0.0
                 CY_B   = 0.0

                 PARDO a, i

                       GET VC1A_HIST(a,i,NINDEX50)
                       GET Y1a(a,i,MINDEX50)

                       Tai(a,i)  = VC1A_HIST(a,i,NINDEX50)
                       T1ai(a,i) = Y1a(a,i,MINDEX50)

                       TMP   =  Tai(a,i) * T1ai(a,i)
                       SUMA +=  TMP

                  ENDPARDO a, i

                  EXECUTE SERVER_BARRIER
                  COLLECTIVE CY_A += SUMA

                  CY_AB  = CY_A

                  KCOUNT = 0.0
                  DO KINDEX50
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF

                  ENDDO KINDEX50

           ENDDO  MINDEX50

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     IF LOCK != ONE
        EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
        IMAX_KEEP = IMAX
      ELSE 
        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
      ENDIF 

#bgn_debug
     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MAX_OVLP2
#    -----------------------------

     PROC SELECT_VECS_MIN_ENEG
#    -------------------------

     IF ROOT_COUNT == ONE

# Always pick the closest eigenvalue to the starting eigenvalue

        EXECUTE SET_ACES3_VARS OMEGA THRTEN
        EXECUTE FIND_NEAR A_DIAGS A_DIAGS
        EXECUTE SET_ACES3_VARS IMAX MONE
        IMAX_KEEP = IMAX
        IF IMAX_KEEP ==  ZERO
           IMAX = ONE
        ENDIF

      ELSE

# Find the root from the subspace that is not too close to the
# roots that have already been found.

        IF LOCK != ONE
           EXECUTE FIND_MIN_ENEG A_DIAGS PSEUDO_ROOTS 
           EXECUTE SET_ACES3_VARS IMAX MONE
           IMAX_KEEP = IMAX
        ELSE
          EXECUTE SET_ACES3_VARS OMEGA THRTEN
          EXECUTE FIND_NEAR A_DIAGS PSEUDO_ROOTS
          EXECUTE SET_ACES3_VARS IMAX MONE
          IMAX_KEEP = IMAX
        ENDIF
      ENDIF 

#bgn_debug
     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS_MIN_ENEG
#    ----------------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, a

                 GET Y1a(a,i,NINDEX50)
                 Tai(a,i) = Y1a(a,i,NINDEX50)
                 PUT Y1a_PICKED(a,i) = Tai(a,i)

           ENDPARDO i, a
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, i1, a1, a

                 REQUEST Y2aa(a,i1,a1,i,NINDEX50) i
                 Taiai(a,i1,a1,i) = Y2aa(a,i1,a1,i,NINDEX50)
                 PREPARE Y2aa_picked(a,i1,a1,i) = Taiai(a,i1,a1,i)

           ENDPARDO i, i1, a1, a

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, b, a

                 REQUEST Y2ab(a,i,b,j,NINDEX50) j
                 Taibj(a,i,b,j) = Y2ab(a,i,b,j,NINDEX50)
                 PREPARE Y2ab_picked(a,i,b,j) = Taibj(a,i,b,j)

           ENDPARDO i, j, b, a

        ENDIF
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER

