      DELETE L1A
      DELETE L1B
      DELETE DENS_VV_A
      DELETE DENS_OO_A
      DELETE DENS_OV_A
      DELETE DENS_VO_A
      DELETE DENS_VV_B
      DELETE DENS_OO_B
      DELETE DENS_OV_B
      DELETE DENS_VO_B
