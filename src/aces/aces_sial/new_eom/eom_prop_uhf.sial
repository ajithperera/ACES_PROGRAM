#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab  = suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request l2aa_s_vecs(i,a,i1,a1,nroots) i
#            tmp = l2aa_s_vecs(i,a,i1,a1,nroots) * l2aa_s_vecs(i,a,i1,a1,nroots)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i,a,b
#            request l2ab_s_vecs(i,a,j,b,nroots) j
#            tmp =  l2ab_s_vecs(i,a,j,b,nroots)  * l2ab_s_vecs(i,a,j,b,nroots)
#            tmpa+= tmp
#      endpardo j,i,a, b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#      enddo nroots
#end_debug
 
     DO INDONE
     DO NROOTS 
         IAM_ZERO(NROOTS,INDONE) = 0.0
     ENDDO NROOTS 
     ENDDO INDONE

     DO a
     DO i
        GET         T1A(a,i)
        GET         A1A(i,a)
        LT1A(a,i) = T1A(a,i)
        LA1A(i,a) = A1A(i,a)
     ENDDO i
     ENDDO a
     DO b
     DO j
        GET         T1B(b,j)
        GET         A1B(j,b)
        LT1B(b,j) = T1B(b,j)
        LA1B(j,b) = A1B(j,b)
     ENDDO j
     ENDDO b

     EXECUTE GET_MY_RANK RANK

# The following DENS2JOBARC call add record "EOM" to the JOBARC file.
# R0_VEC is only act as a dummy array.

     IF RANK == 0.0
       NINE_NINE = 99.0
       EXECUTE PRINT_REL_INFO NINE_NINE R0_VEC
       PRINT_FLAG = -2.0
       EXECUTE DENS2JOBARC R0_VEC PRINT_FLAG
     ENDIF

     MULT = ZERO
     DO SPN_MULT

        MULT  += 1.0

        IF MULT == ONE
           SINGLET = ONE
           TRIPLET = ZERO
        ELSE
           SINGLET = ZERO
           TRIPLET = ONE
        ENDIF

        IF SINGLET == ONE
           MCOUNT = ZERO
           DO INDONE
           DO NROOTS

              MCOUNT += 1.00
              IF MCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF

              GET D_S_REE(NROOTS,INDONE)
              GET D_S_LEE(NROOTS,INDONE)
              RNN(NROOTS,INDONE) = D_S_REE(NROOTS,INDONE)
              LNN(NROOTS,INDONE) = D_S_LEE(NROOTS,INDONE)
              S_REE(NROOTS,INDONE) = RNN(NROOTS,INDONE)
              S_LEE(NROOTS,INDONE) = LNN(NROOTS,INDONE)
          ENDDO NROOTS
          ENDDO INDONE

          CALL CHECK_S_RL_EES
          CALL GET_S_R0

          KCOUNT = ZERO
          IKEEP  = ONE
          DO INDONE
          DO IROOTS

# Check whether there are any non-converged states (they appear having
# excitation energy zero. If we do, skip them to avoid dividing by
# zero error.

          EXECUTE FIND_ZEROS S_REE IAM_ZERO
          LNN(IROOTS,INDONE) = IAM_ZERO(IROOTS,INDONE)
          EXECUTE RETURN_SVAL LNN FLAG

          IF FLAG != ONE

              KCOUNT += 1.00
              IF KCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF
#bgn_debug
#              execute print_scalar kcount 
#end_debug

              MYROOT = KCOUNT
              RNN(IROOTS,INDONE) = R0_VEC(IROOTS,INDONE)
              EXECUTE RETURN_SVAL RNN R0_KEEP
              ONN(IROOTS,INDONE) = OMEGA2_VEC(IROOTS,INDONE)
              EXECUTE RETURN_SVAL ONN OMEGA2

              CALL BEGIN_PREP
              CALL GROUND_STATE_RESP_PROPS
              IDENS = IKEEP
              CALL EXCITED_STATES_RESP_PROPS
              CALL DUMP_TDENS_2JOBARC 
              IKEEP = IDENS 
              CALL END_PREP

           ENDIF 
           ENDDO IROOTS
           ENDDO INDONE

        ENDIF 
           
        IF TRIPLET == ONE

           MCOUNT = ZERO
           DO INDONE
           DO NROOTS
              MCOUNT += 1.00
              IF MCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF

              GET D_T_REE(NROOTS,INDONE)
              GET D_T_LEE(NROOTS,INDONE)
              RNN(NROOTS,INDONE) = D_T_REE(NROOTS,INDONE)
              LNN(NROOTS,INDONE) = D_T_LEE(NROOTS,INDONE)
              T_REE(NROOTS,INDONE) = RNN(NROOTS,INDONE)
              T_LEE(NROOTS,INDONE) = LNN(NROOTS,INDONE)
           ENDDO NROOTS
           ENDDO INDONE

           CALL CHECK_T_RL_EES
           CALL GET_T_R0

           KCOUNT = ZERO
           IDENS  = IKEEP 
           DO INDONE
           DO IROOTS

           EXECUTE FIND_ZEROS T_REE IAM_ZERO
           LNN(IROOTS,INDONE) = IAM_ZERO(IROOTS,INDONE)
           EXECUTE RETURN_SVAL LNN FLAG

           IF FLAG != ONE

              KCOUNT += 1.00
              IF KCOUNT > TARGET_ROOTS
                 EXIT
              ENDIF
#bgn_debug
#              execute print_scalar kcount 
#end_debug

              MYROOT = KCOUNT
              RNN(IROOTS,INDONE) = R0_VEC(IROOTS,INDONE)
              EXECUTE RETURN_SVAL RNN R0_KEEP
              ONN(IROOTS,INDONE) = OMEGA2_VEC(IROOTS,INDONE)
              EXECUTE RETURN_SVAL ONN OMEGA2

              CALL BEGIN_PREP
              CALL GROUND_STATE_RESP_PROPS
              IDENS = IKEEP
              CALL EXCITED_STATES_RESP_PROPS
              CALL DUMP_TDENS_2JOBARC 
              IKEEP = IDENS 
              CALL END_PREP

           ENDIF 
           ENDDO IROOTS
           ENDDO INDONE

        ENDIF 

    ENDDO SPN_MULT
           
                        ENDSIAL EOM_PROP_CCSD_UHF
