      CREATE L1A
      CREATE L1B
      CREATE DENS_VV_A
      CREATE DENS_OO_A
      CREATE DENS_OV_A
      CREATE DENS_VO_A
      CREATE DENS_VV_B
      CREATE DENS_OO_B
      CREATE DENS_OV_B
      CREATE DENS_VO_B
      CREATE AO_DENS
      CREATE T2L2_VV_A
      CREATE R2L2_VV_A
      CREATE DENS_INT_OV_A
      CREATE DENS_INT_OV_B
      CREATE T1L1_OO_A
      CREATE T2L2_OO_A
      CREATE R2L2_OO_A
      CREATE T2L2_VV_B
      CREATE R2L2_VV_B
      CREATE T1L1_OO_B
      CREATE T2L2_OO_B
      CREATE R2L2_OO_B
      Execute Sip_barrier 

      ENDPROC  BEGIN_PREP
