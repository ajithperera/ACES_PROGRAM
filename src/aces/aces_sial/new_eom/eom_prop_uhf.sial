      DELETE T2L2_VV_B
      DELETE R2L2_VV_B
      DELETE DENS_INT_OV_B
      DELETE T1L1_OO_B
      DELETE T2L2_OO_B
      DELETE R2L2_OO_B
      Execute Sip_barrier 

      ENDPROC  END_PREP
