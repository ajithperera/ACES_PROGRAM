     PROC CHECK_S_RL_EES
#    -------------------

     NCOUNT    = 0.0
     DIFF_NORM = 0.0
     DO INDONE
     DO NROOTS
        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        DIFF(NROOTS,INDONE)  = S_REE(NROOTS,INDONE)
        DIFF(NROOTS,INDONE) -= S_LEE(NROOTS,INDONE)

        ETEMP = DIFF(NROOTS,INDONE) * DIFF(NROOTS,INDONE)
        DIFF_NORM += ETEMP
    
     ENDDO NROOTS
     ENDDO INDONE

#bgn_debug
#     execute print_scalar DIFF_NORM
#end_debug

     IF DIFF_NORM > EOM_THRES
     ENDIF

     ENDPROC CHECK_S_RL_EES
#    ----------------------

     PROC CHECK_T_RL_EES
#    -------------------

     NCOUNT    = 0.0
     DIFF_NORM = 0.0
     DO INDONE
     DO NROOTS
        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        DIFF(NROOTS,INDONE)  = T_REE(NROOTS,INDONE)
        DIFF(NROOTS,INDONE) -= T_LEE(NROOTS,INDONE)

        ETEMP = DIFF(NROOTS,INDONE) * DIFF(NROOTS,INDONE)
        DIFF_NORM += ETEMP

     ENDDO NROOTS
     ENDDO INDONE

#bgn_debug
#     execute print_scalar DIFF_NORM
#end_debug

     IF DIFF_NORM > EOM_THRES
     ENDIF

     ENDPROC CHECK_T_RL_EES
#    ----------------------

     PROC GET_S_R0
#    ------------
     DO INDONE
     NCOUNT = 0.0
     DO NROOTS

# Check whether there are any non-converged states (they appear having
# excitation energy zero. If we do, skip them to avoid dividing by
# zero error.

        EXECUTE FIND_ZEROS S_REE IAM_ZERO
        LNN(NROOTS,INDONE) = IAM_ZERO(NROOTS,INDONE)
        EXECUTE RETURN_SVAL LNN FLAG
#bgn_debug
#     execute print_scalar flag
#end_debug

        IF FLAG != ONE

        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        RNN(NROOTS,INDONE) = S_REE(NROOTS,INDONE)
        EXECUTE RETURN_SVAL RNN OMEGA
#bgn_debug
#     execute print_scalar omega
#end_debug

        PARDO  i, a
            GET R1A_S_VECS(a,i,NROOTS)
            tai(a,i) = R1A_S_VECS(a,i,NROOTS)
            PUT  R1A(a,i) = tai (a,i)
        ENDPARDO  i, a

        PARDO  a, i, a1, i1
            REQUEST R2AA_S_VECS(a,i,a1,i1,NROOTS) i1
            taiai (a,i,a1,i1) = R2AA_S_VECS(a,i,a1,i1,NROOTS)
            PREPARE  R2AA (a,i,a1,i1) = taiai (a,i,a1,i1)
        ENDPARDO  a, i, a1, i1

        PARDO  b, j, b1, j1
            REQUEST R2BB_S_VECS(b,j,b1,j1,NROOTS) j1
            tbjbj(b,j,b1,j1) = R2BB_S_VECS(b,j,b1,j1,NROOTS)
            PREPARE  R2BB(b,j,b1,j1) = tbjbj(b,j,b1,j1)
        ENDPARDO b, j, b1, j1

        PARDO  a, i, b, j
            REQUEST R2AB_S_VECS(a,i,b,j,NROOTS) j
            taibj (a,i,b,j) = R2AB_S_VECS(a,i,b,j,NROOTS)
            PREPARE  R2AB(a,i,b,j) = taibj (a,i,b,j)
        ENDPARDO  a, i, b, j

        EXECUTE SERVER_BARRIER
        CALL R0_COMPUTE
        R0_VEC(NROOTS,INDONE) = R0
        OMEGA2_VEC(NROOTS,INDONE) = OMEGA2

        ENDIF 

     ENDDO NROOTS
     ENDDO INDONE

     ENDPROC GET_S_R0
#    ----------------

     PROC GET_T_R0
#    -------------
     DO INDONE
     NCOUNT = 0.0
     DO NROOTS

# Check whether there are any non-converged states (they appear having
# excitation energy zero. If we do, skip them to avoid dividing by
# zero error.

        EXECUTE FIND_ZEROS S_REE IAM_ZERO
        LNN(NROOTS,INDONE) = IAM_ZERO(NROOTS,INDONE)
        EXECUTE RETURN_SVAL LNN FLAG

        IF FLAG != ONE

        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        RNN(NROOTS,INDONE) = T_REE(NROOTS,INDONE)
        EXECUTE RETURN_SVAL RNN OMEGA
#bgn_debug
#     execute print_scalar omega
#end_debug

        PARDO  i, a
            GET R1A_T_VECS(a,i,NROOTS)
            tai(a,i) = R1A_T_VECS(a,i,NROOTS)
            PUT  R1A(a,i) = tai (a,i)
        ENDPARDO  i, a

        PARDO  a, i, a1, i1
            REQUEST R2AA_T_VECS(a,i,a1,i1,NROOTS) i1
            taiai (a,i,a1,i1) = R2AA_T_VECS(a,i,a1,i1,NROOTS)
            PREPARE  R2AA (a,i,a1,i1) = taiai (a,i,a1,i1)
        ENDPARDO  a, i, a1, i1

        PARDO  b, j, b1, j1
            REQUEST R2BB_T_VECS(b,j,b1,j1,NROOTS) j1
            tbjbj(b,j,b1,j1) = R2BB_T_VECS(b,j,b1,j1,NROOTS)
            PREPARE  R2BB(b,j,b1,j1) = tbjbj(b,j,b1,j1)
        ENDPARDO b, j, b1, j1

        PARDO  a, i, b, j
            REQUEST R2AB_T_VECS(a,i,b,j,NROOTS) j
            taibj (a,i,b,j) = R2AB_T_VECS(a,i,b,j,NROOTS)
            PREPARE  R2AB(a,i,b,j) = taibj (a,i,b,j)
        ENDPARDO  a, i, b, j

        EXECUTE SERVER_BARRIER
        CALL R0_COMPUTE
        R0_VEC(NROOTS,INDONE) = R0
        OMEGA2_VEC(NROOTS,INDONE) = OMEGA2
 
        ENDIF 
     ENDDO NROOTS
     ENDDO INDONE

     ENDPROC GET_T_R0
#    ----------------

     PROC GROUND_STATE_RESP_PROPS
#    ----------------------------
      ALLOCATE  GRDSECM (*,*)
      ALLOCATE  EXCSECM (*,*)
      ALLOCATE  GRDQUAD (*,*)
      ALLOCATE  EXCQUAD (*,*)

      CALL HF_DENSITY

      tmpnuc = 0.0
      DO jatom
         tmpnuc = tmpnuc + 1.0
      ENDDO jatom

      dipnucx = tmpnuc
      dipnucy = dipnucx
      dipnucz = dipnucy

      EXECUTE NUC_DIPOLE_MOMENT  ONE    dipnucx
      EXECUTE NUC_DIPOLE_MOMENT  TWO    dipnucy
      EXECUTE NUC_DIPOLE_MOMENT  THREE  dipnucz

# Compute ground state response properties; Dpq= <0|(1+L)e^-T{p+q}e^T|0>
# The Lk is lambda and Rk is excited state R vectors but not used in
# the density codes.

      R0     = ONE
      LRNORM = ONE
      CALL PUT_ZERO_IN_Rk
      LOGRIGHT = ONE
      CALL PUT_IN_Lk
      LOGRIGHT = ZERO
      GROUNDSTATE  = ONE
      CALL  COMPUTE_DENSITY
      CALL  BACK_TRANS_COMP_DIP

# Write correlated ground state density to JOBARC

      IDENS = ONE
      CALL WRITE_TO_JOBARC

      DIP_GRD_X  = DIP_MOM_X
      DIP_GRD_Y  = DIP_MOM_Y
      DIP_GRD_Z  = DIP_MOM_Z
      DIP_GRD_X += dipnucx
      DIP_GRD_Y += dipnucy
      DIP_GRD_Z += dipnucz

      EXECUTE  PRINT_SCALAR  ZERO
      EXECUTE  PRINT_SCALAR  DIP_GRD_X
      EXECUTE  PRINT_SCALAR  DIP_GRD_Y
      EXECUTE  PRINT_SCALAR  DIP_GRD_Z

      CALL  COMPUTE_MOMENTS

     ENDPROC GROUND_STATE_RESP_PROPS
#    -------------------------------

     PROC EXCITED_STATES_RESP_PROPS
#    ------------------------------

      GROUNDSTATE = ZERO
      EXCITESTATE = ZERO
      POLTOTXX = 0.0
      POLTOTYY = 0.0
      POLTOTZZ = 0.0
      POLTOTXY = 0.0
      POLTOTXZ = 0.0
      POLTOTYZ = 0.0

# The right transition density <0|(1+L)e^-T{p+q}R_ke^T|0>
# Get the right vectors; the left vectors are lambda and they
# already in.

      LOGRIGHT = ONE
      CALL PUT_IN_Rk
      R0     = R0_KEEP
      CALL COMP_R_NORM
      LRNORM = RNORM
#bgn_debug
#      execute print_scalar r0
#      execute print_scalar OMEGA2
#      execute print_scalar lrnorm
#end_debug

      CALL COMPUTE_DENSITY
      CALL BACK_TRANS_COMP_DIP

      DIP_MOM_X_R = DIP_MOM_X
      DIP_MOM_Y_R = DIP_MOM_Y
      DIP_MOM_Z_R = DIP_MOM_Z
#bgn_debug
#      execute print_scalar DIP_MOM_X_R
#      execute print_scalar DIP_MOM_Y_R
#      execute print_scalar DIP_MOM_Z_R
#end_debug

# The left transition densities  <0|L_kde^-T{p+q}e^T|0>

      LOGRIGHT = ZERO
      CALL PUT_IN_Lk
      CALL COMP_RL_NORM
      LRNORM = LNORM
      R0     = 1.0
      CALL COMPUTE_DENSITY
      CALL BACK_TRANS_COMP_DIP

      DIP_MOM_X_L = DIP_MOM_X
      DIP_MOM_Y_L = DIP_MOM_Y
      DIP_MOM_Z_L = DIP_MOM_Z

#bgn_debug
#      execute print_scalar DIP_MOM_X_L
#      execute print_scalar DIP_MOM_Y_L
#      execute print_scalar DIP_MOM_Z_L
#end_debug

# The excited state densities <0|L_kde^-T{p+q}R_ke^T|0>

      LOGRIGHT    = ONE
      R0          = R0_KEEP
      LRNORM      = LNORM * RNORM
      EXCITESTATE = ONE
      CALL  COMPUTE_DENSITY

      GROUNDSTATE = ONE
      CALL BACK_TRANS_COMP_DIP
      GROUNDSTATE = ZERO

      DIP_EXC_X  = DIP_MOM_X
      DIP_EXC_Y  = DIP_MOM_Y
      DIP_EXC_Z  = DIP_MOM_Z
      DIP_EXC_X += dipnucx
      DIP_EXC_Y += dipnucy
      DIP_EXC_Z += dipnucz

      EXECUTE  PRINT_SCALAR  ZERO
      EXECUTE  PRINT_SCALAR  DIP_EXC_X
      EXECUTE  PRINT_SCALAR  DIP_EXC_Y
      EXECUTE  PRINT_SCALAR  DIP_EXC_Z

      CALL  COMPUTE_MOMENTS
      EXCITESTATE = ZERO

      DIP_MOM_X = DIP_MOM_X_R * DIP_MOM_X_L
      DIP_MOM_Y = DIP_MOM_Y_R * DIP_MOM_Y_L
      DIP_MOM_Z = DIP_MOM_Z_R * DIP_MOM_Z_L

      OSC_STREN_X = OMEGA2 * DIP_MOM_X
      OSC_STREN_Y = OMEGA2 * DIP_MOM_Y
      OSC_STREN_Z = OMEGA2 * DIP_MOM_Z

      OSC_STREN  = OSC_STREN_X
      OSC_STREN += OSC_STREN_Y
      OSC_STREN += OSC_STREN_Z

      DIPXY = DIP_MOM_X_R * DIP_MOM_Y_R
      DIPXZ = DIP_MOM_X_R * DIP_MOM_Z_R
      DIPYZ = DIP_MOM_Y_R * DIP_MOM_Z_R

      POLXX = TWO * DIP_MOM_X
      POLYY = TWO * DIP_MOM_Y
      POLZZ = TWO * DIP_MOM_Z
      POLXY = TWO * DIPXY
      POLXZ = TWO * DIPXZ
      POLYZ = TWO * DIPYZ
      POLXX = POLXX / OMEGA
      POLYY = POLYY / OMEGA
      POLZZ = POLZZ / OMEGA
      POLXY = POLXY / OMEGA
      POLXZ = POLXZ / OMEGA
      POLYZ = POLYZ / OMEGA
      POLTOTXX += POLXX
      POLTOTYY += POLYY
      POLTOTZZ += POLZZ
      POLTOTXY += POLXY
      POLTOTXZ += POLXZ
      POLTOTYZ += POLYZ

      DEALLOCATE  GRDSECM (*,*)
      DEALLOCATE  EXCSECM (*,*)
      DEALLOCATE  GRDQUAD (*,*)
      DEALLOCATE  EXCQUAD (*,*)

# Reset the  OMEGA2 to OMEGA to print

      OMEGA  = THREE/TWO
      OMEGA *= OMEGA2
      CALL PRINT_ESTATE_RESP_PROPS

      EXECUTE SIP_BARRIER
#                                                                        #
     ENDPROC EXCITED_STATES_RESP_PROPS
#    ---------------------------------

     PROC DUMP_TDENS_2JOBARC
#    ----------------------

      DO i
      DO i1
      DO a
         GET R1A(a,i)
         GET R1A(a,i1)
         Tai(a,i)    = R1A(a,i)
         Tai1(a,i1)  = R1A(a,i1)
         Tii1(i,i1)  = Tai(a,i) * Tai1(a,i1)
         TDENS_OO_AA(i,i1) += tii1(i,i1)
         AMP_PRINT_AA(a,i) = Tai(a,i)
      ENDDO a
      ENDDO i1
      ENDDO i

      DO j 
      DO j1
      DO b
         GET R1B(b,j)
         GET R1B(b,j1)
         Tbj(b,j)    = R1B(b,j)
         Tbj1(b,j1)  = R1B(b,j1)
         Tjj1(j,j1)  = Tbj(b,j) * Tbj1(b,j1)
         TDENS_OO_BB(j,j1) += tjj1(j,j1)
         AMP_PRINT_BB(b,j) = Tbj(b,j)
      ENDDO b
      ENDDO j1
      ENDDO j

      DO a
      DO a1
      DO i
         GET R1A(a,i)
         GET R1A(a1,i)
         Tai(a,i)    = R1A(a,i)
         Tai1(a1,i)  = R1A(a1,i)
         Taa1(a,a1)  = Tai(a,i) * Tai1(a1,i)
         TDENS_VV_AA(a,a1) += taa1(a,a1)
      ENDDO i
      ENDDO a1
      ENDDO a

      DO b
      DO b1
      DO j
         GET R1B(b,j)
         GET R1B(b1,j)
         Tbj(b,j)    = R1B(b,j)
         Tbj1(b1,j)  = R1B(b1,j)
         Tbb1(b,b1)  = Tbj(b,j) * Tbj1(b1,j)
         TDENS_VV_BB(b,b1) += Tbb1(b,b1)
      ENDDO j
      ENDDO b1
      ENDDO b

      IDENS += 1.0
      EXECUTE  DENS2JOBARC  TDENS_OO_AA IDENS
      IDENS += 1.0
      EXECUTE  DENS2JOBARC  TDENS_OO_BB IDENS
      IDENS += 1.0
      EXECUTE  DENS2JOBARC  TDENS_VV_AA IDENS
      IDENS += 1.0
      EXECUTE  DENS2JOBARC  TDENS_VV_BB IDENS
      IDENS += 1.0
      EXECUTE  DENS2JOBARC  DENSITY IDENS

      EXECUTE C1_FULL_PRINT AMP_PRINT_AA AMP_PRINT_BB

     ENDPROC DUMP_TDENS_2JOBARC
#    --------------------------
#    ------------
# Main driver of excited state properties.

     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL

     ZERO      = 0.0
     ONE       = 1.0
     TWO       = 2.0
     THREE     = 3.0
     HALF      = 0.5
     R0_THRESH = EOM_TOL

     ALLOCATE LT1A(*,*)
     ALLOCATE LT1B(*,*)
     ALLOCATE LA1A(*,*)
     ALLOCATE LA1B(*,*)

     CREATE EE
     CREATE D_S_REE
     CREATE D_S_LEE
     CREATE D_T_REE
     CREATE D_T_LEE
     CREATE T1A
     CREATE T1B
     CREATE A1A
     CREATE A1B
     CREATE R1A
     CREATE R1B
     CREATE R1A_S_VECS
     CREATE R1B_S_VECS
     CREATE R1A_T_VECS
     CREATE R1B_T_VECS
     CREATE L1A_S_VECS
     CREATE L1B_S_VECS
     CREATE L1A_T_VECS
     CREATE L1B_T_VECS
     CREATE HBAR_ia
     CREATE HBAR_jb
     CREATE DHF
     CREATE ORTHO_COEF
     
     EXECUTE SIP_BARRIER

     CALL READ_RL_VECS
#bgn_debug
