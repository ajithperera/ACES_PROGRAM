#    ----------------
      PROC BEGIN_PREP
#    ----------------
#
      CREATE L1A
      CREATE L1B
      CREATE DENS_VV_A
      CREATE DENS_OO_A
      CREATE DENS_OV_A
      CREATE DENS_VO_A
      CREATE AO_DENS
      CREATE T2L2_VV_A
      CREATE R2L2_VV_A
      CREATE DENS_INT_OV_A
      CREATE T1L1_OO_A
      CREATE T2L2_OO_A
      CREATE R2L2_OO_A

      Execute sip_barrier 

      ENDPROC  BEGIN_PREP
#     -------------------
#
      PROC END_PREP
#    --------------
#
      DELETE L1A
      DELETE L1B
      DELETE DENS_VV_A
      DELETE DENS_OO_A
      DELETE DENS_OV_A
      DELETE DENS_VO_A
      DELETE AO_DENS
      DELETE T2L2_VV_A
      DELETE R2L2_VV_A
      DELETE DENS_INT_OV_A
      DELETE T1L1_OO_A
      DELETE T2L2_OO_A
      DELETE R2L2_OO_A

      EXECUTE  SIP_BARRIER
#
#    ------------------
      ENDPROC  END_PREP
#    ------------------

      PROC  WRITE_TO_JOBARC
#    -----------------------
#
#
#             Write to JOBARC
#
#
      DO mu
      DO nu

         GET            AO_DENS (mu,nu)
         txx (mu,nu)  = AO_DENS (mu,nu)
         DENSITY (mu,nu) = txx (mu,nu)

      ENDDO nu
      ENDDO mu

#bgn_debug
#      EXECUTE  PRINT_SCALAR  IDENS
#end_debut

      EXECUTE  DENS2JOBARC  DENSITY  IDENS
#
#
#          ...ready!
#
#
      ENDPROC  WRITE_TO_JOBARC
#     ------------------------

#    ------------------
      PROC  HF_DENSITY
#    ------------------
#
#
      PARDO  mu, nu
         txx (mu,nu) = 0.0
         PUT  DHF (mu,nu) = txx (mu,nu)
      ENDPARDO  mu, nu
      EXECUTE  SIP_BARRIER

      PARDO mu, nu, i

            txi (nu,i )       = CA (nu,i)
            txx (mu,nu)       = CA (mu,i) * txi (nu,i)
            txx (mu,nu)      *= 2.0

            PUT  DHF (mu,nu) += txx (mu,nu) 

      ENDPARDO mu, nu, i

      EXECUTE  SIP_BARRIER

      DO mu
      DO nu

         GET            DHF (mu,nu)
         txx (mu,nu)  = DHF (mu,nu)
         DENSITY (mu,nu) = txx (mu,nu)

      ENDDO nu
      ENDDO mu

      IDENS = 0.0
      EXECUTE  DENS2JOBARC  DENSITY  IDENS
#
#
#          ...ready!
#
#
      ENDPROC  HF_DENSITY
#     -------------------
#
      PROC PUT_ZERO_IN_Rk
#    -------------------
#
      PARDO  i, a
         tai(a,i) = 0.0
         PUT  R1A(a,i) = tai (a,i)
      ENDPARDO  i, a

      PARDO  a, i, a1, i1
         taiai (a,i,a1,i1) = 0.0
         PREPARE  R2AA (a,i,a1,i1) = taiai (a,i,a1,i1)
      ENDPARDO  a, i, a1, i1

      PARDO  a, i, b, j
         taibj (a,i,b,j) = 0.0
         PREPARE  R2AB (a,i,b,j) = taibj (a,i,b,j)

      ENDPARDO  a, i, b, j
      EXECUTE  SERVER_BARRIER
#
      ENDPROC  PUT_ZERO_IN_Rk
#    ------------------------

      PROC  PUT_IN_Rk
#    ----------------
#
   NCOUNT = 0.0
   DO NROOTS
      NCOUNT += 1.0

      IF NCOUNT == MYROOT
      PARDO  i, a
         GET R1A_VECS(a,i,NROOTS)
         tai(a,i) = R1A_VECS(a,i,NROOTS)
         PUT  R1A(a,i) = tai (a,i)
         PUT  R1B(a,i) = tai (a,i)
      ENDPARDO  i, a

      PARDO  a, i, a1, i1
         REQUEST R2AA_VECS(a,i,a1,i1,NROOTS) i1
         taiai (a,i,a1,i1) = R2AA_VECS(a,i,a1,i1,NROOTS)
         PREPARE  R2AA (a,i,a1,i1) = taiai (a,i,a1,i1)

      ENDPARDO  a, i, a1, i1

      PARDO  a, i, b, j

         REQUEST R2AB_VECS(a,i,b,j,NROOTS) j
         taibj (a,i,b,j) = R2AB_VECS(a,i,b,j,NROOTS)
         PREPARE  R2AB (a,i,b,j) = taibj (a,i,b,j) 

      ENDPARDO  a, i, b, j

      ENDIF 

    ENDDO NROOTS
    EXECUTE  SERVER_BARRIER

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get r1a(a,i)
#         tmp = r1a(a,i) * r1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      suma =0.0
#      tmpa =0.0
#      pardo j,i,a,b
#            request r2ab(a,i,b,j) j
#            tmp =  r2ab(a,i,b,j) * r2ab(a,i,b,j)
#            tmpa+= tmp
#      endpardo j,i,a, b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#bgn_debug

#
    ENDPROC  PUT_IN_Rk
#  -------------------

    PROC  PUT_IN_Lk
#  ----------------
#
   IF  LOGRIGHT == ONE
  
      PARDO  i, a
         GET A1A(i,a)
         tia(i,a) = A1A(i,a)
         PUT L1A(i,a) = tia(i,a)
         PUT L1B(i,a) = tia(i,a)
      ENDPARDO  i, a

      PARDO  a, i, a1, i1
         REQUEST A2AA(i,a,i1,a1) a1
         tiaia(i,a,i1,a1) = A2AA(i,a,i1,a1)
         PREPARE L2AA(i,a,i1,a1) = tiaia(i,a,i1,a1)
      ENDPARDO  a, i, a1, i1

      PARDO  a, i, b, j
         REQUEST A2AB(i,a,j,b) b
         tiajb(i,a,j,b) = A2AB(i,a,j,b)
         PREPARE L2AB(i,a,j,b) = tiajb(i,a,j,b)
      ENDPARDO  a, i, b, j

   ENDIF 
     
   IF LOGRIGHT == ZERO

      NCOUNT = 0.0
      DO NROOTS
         NCOUNT += 1.0

         IF NCOUNT == MYROOT
            PARDO  i, a
                GET L1A_VECS(i,a,NROOTS)
                tia(i,a) = L1A_VECS(i,a,NROOTS)
                PUT  L1A(i,a) = tia(i,a)
                PUT  L1B(i,a) = tia(i,a)
            ENDPARDO  i, a

            PARDO  a, i, a1, i1
                REQUEST L2AA_VECS(i,a,i1,a1,NROOTS) a1
                tiaia(i,a,i1,a1) = L2AA_VECS(i,a,i1,a1,NROOTS)
                PREPARE L2AA(i,a,i1,a1) = tiaia(i,a,i1,a1)
            ENDPARDO  a, i, a1, i1

            PARDO  a, i, b, j
                REQUEST L2AB_VECS(i,a,j,b,NROOTS) b
                tiajb(i,a,j,b) = L2AB_VECS(i,a,j,b,NROOTS)
                PREPARE  L2AB (i,a,j,b) = tiajb(i,a,j,b)
            ENDPARDO  a, i, b, j
         ENDIF
       ENDDO NROOTS
    ENDIF 

    EXECUTE SERVER_BARRIER 

    ENDPROC PUT_IN_Lk
