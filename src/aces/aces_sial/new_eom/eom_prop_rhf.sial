#      pardo i,a
#         get l1a_vecs(i,a,nroots)
#         tmp = l1a_vecs(i,a,nroots) * l1a_vecs(i,a,nroots)
#         tmpa += tmp
#      endpardo i,a
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab  = suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request l2aa_vecs(i,a,i1,a1,nroots) i
#            tmp = l2aa_vecs(i,a,i1,a1,nroots) * l2aa_vecs(i,a,i1,a1,nroots)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      sumab += suma
#      tmpa =0.0
#      suma =0.0
#      pardo j,i,a,b
#            request l2ab_vecs(i,a,j,b,nroots) j
#            tmp =  l2ab_vecs(i,a,j,b,nroots)  * l2ab_vecs(i,a,j,b,nroots) 
#            tmpa+= tmp
#      endpardo j,i,a, b
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      sumab += suma
#      execute print_scalar sumab
#      enddo nroots 
#end_debug

     NCOUNT = 0.0
     DO NROOTS
        NCOUNT += 1.0

        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        PARDO i, a

            GET R1A_VECS(a,i,NROOTS)
            GET L1A_VECS(i,a,NROOTS)

            Tai(a,i) = R1A_VECS(a,i,NROOTS)
            Tia(i,a) = L1A_VECS(i,a,NROOTS)
            TMP       =  Tai(a,i) * Tia(i,a)

            T1xx(NROOTS,NROOTS)        = TMP
            T1xx(NROOTS,NROOTS)       *= 2.0
            PUT ORTHO_COEF(NROOTS,NROOTS) += T1xx(NROOTS,NROOTS)

        ENDPARDO i, a

        PARDO i, i1, a1, a

            REQUEST R2AA_VECS(a,i,a1,i1,NROOTS) i1
            REQUEST L2AA_VECS(i,a,i1,a1,NROOTS) i1

            Taiai(a,i,a1,i1) = R2AA_VECS(a,i,a1,i1,NROOTS)
            Tiaia(i,a,i1,a1) = L2AA_VECS(i,a,i1,a1,NROOTS)
 
            TMP     = Taiai(a,i,a1,i1) * Tiaia(i,a,i1,a1)

            T1xx(NROOTS,NROOTS)        = TMP
            T1xx(NROOTS,NROOTS)       *= 2.0
            PUT ORTHO_COEF(NROOTS,NROOTS) += T1xx(NROOTS,NROOTS)

        ENDPARDO i, i1, a1, a

        PARDO i, a, b, j

            REQUEST R2AB_VECS(a,i,b,j,NROOTS) j
            REQUEST L2AB_VECS(i,a,j,b,NROOTS) j

            Taibj(a,i,b,j) = R2AB_VECS(a,i,b,j,NROOTS)
            Tiajb(i,a,j,b) = L2AB_VECS(i,a,j,b,NROOTS)

            TMP     = Taibj(a,i,b,j) * Tiajb(i,a,j,b)

            T1xx(NROOTS,NROOTS)         = TMP
            PUT ORTHO_COEF(NROOTS,NROOTS) += T1xx(NROOTS,NROOTS)

        ENDPARDO i, a, b, j

     ENDDO NROOTS

     EXECUTE SIP_BARRIER

    ENDPROC RL_NORM
#   ---------------

    PROC BIORTHO
#   ------------

     NCOUNT = 0.0
     DO NROOTS

        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 

        GET ORTHO_COEF(NROOTS,NROOTS)

        T1xx(NROOTS,NROOTS) =  ORTHO_COEF(NROOTS,NROOTS)
        EXECUTE RETURN_SVAL T1xx FACT
        INV_NORM = 1.0/FACT 
#bgn_debug
#        execute print_scalar INV_NORM
#end_debug  
        PARDO i, a

            GET L1A_VECS(i,a,NROOTS)
            T1ia(i,a,NROOTS)  = L1A_VECS(i,a,NROOTS)
            T1ia(i,a,NROOTS) *= INV_NORM
            PUT L1A_VECS_NRML(i,a,NROOTS) = T1ia(i,a,NROOTS)

        ENDPARDO i, a

        PARDO i, i1, a1, a

            REQUEST L2AA_VECS(i,a,i1,a1,NROOTS) i1
            T1iaia(i,a,i1,a1,NROOTS) = L2AA_VECS(i,a,i1,a1,NROOTS)
            T1iaia(i,a,i1,a1,NROOTS)*= INV_NORM
            PREPARE L2AA_VECS_NRML(i,a,i1,a1,NROOTS) = T1iaia(i,a,i1,a1,NROOTS)
        ENDPARDO i, i1, a1, a

        PARDO i, a, b, j

            REQUEST L2AB_VECS(i,a,j,b,NROOTS) j
            T1iajb(i,a,j,b,NROOTS)  = L2AB_VECS(i,a,j,b,NROOTS)
            T1iajb(i,a,j,b,NROOTS) *=  INV_NORM
            PREPARE L2AB_VECS_NRML(i,a,j,b,NROOTS) = T1iajb(i,a,j,b,NROOTS)

        ENDPARDO i, a, b, j

     ENDDO NROOTS

     EXECUTE SERVER_BARRIER

     ENDPROC BIORTHO
#    ---------------

    PROC C_CHECK
#    -----------
     DO NROOTS
        DO MROOTS
           OVLP_CHECK(NROOTS,MROOTS) = 0.0
        ENDDO MROOTS
     ENDDO NROOTS

     NCOUNT = 0.0
     DO NROOTS 
        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF

        MCOUNT = 0.0
        DO MROOTS
           MCOUNT += 1.0

           IF MCOUNT > TARGET_ROOTS
              EXIT
           ENDIF

               SUMA  = 0.0
               SUMAA = 0.0
               SUMAB = 0.0
               HC_A  = 0.0
               HC_AA = 0.0
               HC_AB = 0.0

               PARDO i, a

                   GET R1A_VECS(a,i,NROOTS)
                   GET L1A_VECS_NRML(i,a,MROOTS)

                   Tai(a,i) = R1A_VECS(a,i,NROOTS)
                   Tia(i,a) = L1A_VECS_NRML(i,a,MROOTS)

                   TMP   = Tai(a,i) * Tia(i,a)
                   SUMA += TMP

               ENDPARDO i, a

               PARDO i, i1, a1, a

                   REQUEST R2AA_VECS(a,i,a1,i1,NROOTS) i1
                   REQUEST L2AA_VECS_NRML(i,a,i1,a1,MROOTS) i1

                   Taiai(a,i,a1,i1) = R2AA_VECS(a,i,a1,i1,NROOTS)
                   Tiaia(i,a,i1,a1) = L2AA_VECS_NRML(i,a,i1,a1,MROOTS)

                   TMP     = Taiai(a,i,a1,i1) * Tiaia(i,a,i1,a1)
                   SUMAA  += TMP
               ENDPARDO i, i1, a1, a

               PARDO i, a, b, j
    
                   REQUEST R2AB_VECS(a,i,b,j,NROOTS) j
                   REQUEST L2AB_VECS_NRML(i,a,j,b,MROOTS) j

                   Taibj(a,i,b,j) = R2AB_VECS(a,i,b,j,NROOTS)
                   Tiajb(i,a,j,b) = L2AB_VECS_NRML(i,a,j,b,MROOTS)

                   TMP     = Taibj(a,i,b,j) * Tiajb(i,a,j,b)
                   SUMAB  += TMP

               ENDPARDO i, a, b, j
   
               EXECUTE SIP_BARRIER 
               COLLECTIVE HC_A   += SUMA
               COLLECTIVE HC_AA  += SUMAA
               COLLECTIVE HC_AB  += SUMAB

               NORM  =  HC_A
               NORM  += HC_A
               NORM  += HC_AA
               NORM  += HC_AA
               NORM  += HC_AB
#bgn_debug
#     execute print_scalar norm 
#end_debug
               DO IROOTS 
                  DO JROOTS 
                     OVLP_CHECK(NROOTS,MROOTS) = NORM
                  ENDDO JROOTS
               ENDDO IROOTS 

         ENDDO MROOTS 
     ENDDO NROOTS 

     execute print_static OVLP_CHECK target_roots 

    ENDPROC C_CHECK
#   --------------
           
#    Main Program      
#    ------------
# Main driver of excited state properties.

     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL

     ZERO      = 0.0
     ONE       = 1.0
     TWO       = 2.0
     THREE     = 3.0
     HALF      = 0.5
     R0_THRESH = EOM_TOL

     ALLOCATE LT1A(*,*)
     ALLOCATE LA1A(*,*)
     CREATE EE
     CREATE DREE
     CREATE DLEE
     CREATE T1A
     CREATE T1B
     CREATE A1A
     CREATE R1A
     CREATE R1B
     CREATE R1A_VECS
     CREATE L1A_VECS
     CREATE L1A_VECS_NRML
     CREATE R1A_VECS_NRML
     CREATE HBAR_ia
     CREATE HBAR_jb
     CREATE DHF
     CREATE ORTHO_COEF
     EXECUTE SIP_BARRIER 

     CALL READ_RL_VECS

     EXECUTE GET_MY_RANK RANK 

     DO a
     DO i
        GET         T1A(a,i)
        GET         A1A(i,a)
        LT1A(a,i) = T1A(a,i)
        LA1A(i,a) = A1A(i,a)
     ENDDO i
     ENDDO a

     DO INDONE 
     DO NROOTS
        GET DREE(NROOTS,INDONE)
        GET DLEE(NROOTS,INDONE)
        RNN(NROOTS,INDONE) = DREE(NROOTS,INDONE)
        LNN(NROOTS,INDONE) = DLEE(NROOTS,INDONE)
        REE(NROOTS,INDONE) = RNN(NROOTS,INDONE)
        LEE(NROOTS,INDONE) = LNN(NROOTS,INDONE)
     ENDDO NROOTS
     ENDDO INDONE 

# Make sure that R and L roots 

     CALL CHECK_RL_EES

#bgn_debug
     execute print_static ree target_roots 
     execute print_static lee target_roots 
#end_debug

     NCOUNT = ZERO 
     DO INDONE 
     DO NROOTS 
        NCOUNT += 1.0
        IF NCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 
        
        RNN(NROOTS,INDONE) = REE(NROOTS,INDONE)
        EXECUTE RETURN_SVAL RNN OMEGA 
#bgn_debug
#     execute print_scalar omega 
#     execute print_scalar ncount 
#end_debug

        PARDO a, i
            GET R1A_VECS(a,i,NROOTS)
            Tai(a,i) = R1A_VECS(a,i,NROOTS)
            PUT R1A(a,i) = Tai(a,i)
            PUT R1B(a,i) = Tai(a,i)
        ENDPARDO a, i

        PARDO a, i, a1, i1
            REQUEST R2AA_VECS(a,i,a1,i1,NROOTS) i1
            taiai(a,i,a1,i1) = R2AA_VECS(a,i,a1,i1,NROOTS)
            PREPARE R2AA(a,i,a1,i1) =taiai(a,i,a1,i1)
        ENDPARDO a, i, a1, i1

        PARDO a, i, b, j
            REQUEST R2AB_VECS(a,i,b,j,NROOTS) j
            taibj(a,i,b,j) = R2AB_VECS(a,i,b,j,NROOTS)
            PREPARE R2AB(a,i,b,j) = taibj(a,i,b,j)
        ENDPARDO a, i, b, j

        EXECUTE SERVER_BARRIER 
        CALL R0_COMPUTE 
        R0_VEC(NROOTS,INDONE) = R0
        OMEGA2_VEC(NROOTS,INDONE) = OMEGA2 

     ENDDO NROOTS 
     ENDDO INDONE 

#bgn_debug
#     execute print_static r0_vec target_roots 
#end_debug
      
#     CALL RENORM_Rk

#     CALL RL_NORM

#     CALL BIORTHO

#bgn_debug
#     call c_check
#end_debug

# The following DENS2JOBARC call add record "EOM" to the JOBARC file.
# R0_VEC is only act as a dummy array.

      IF RANK == 0.0
        NINE_NINE = 99.0
        EXECUTE PRINT_REL_INFO NINE_NINE R0_VEC
        PRINT_FLAG = -2.0
        EXECUTE DENS2JOBARC R0_VEC PRINT_FLAG
      ENDIF

     IKEEP  = ONE 
     MCOUNT = ZERO
     DO INDONE
     DO IROOTS

        MCOUNT += 1.0
        IF MCOUNT > TARGET_ROOTS
           EXIT
        ENDIF 
#bgn_debug
#     execute print_scalar mcount
#endif 
       
        MYROOT = MCOUNT
        RNN(IROOTS,INDONE) = R0_VEC(IROOTS,INDONE)
        EXECUTE RETURN_SVAL RNN R0_KEEP 
        ONN(IROOTS,INDONE) = OMEGA2_VEC(IROOTS,INDONE)
        EXECUTE RETURN_SVAL ONN OMEGA2 
  
        CALL BEGIN_PREP
        CALL GROUND_STATE_RESP_PROPS 
        CALL EXCITED_STATES_RESP_PROPS 
        IDENS = IKEEP 
        CALL DUMP_TDENS_2JOBARC
        IKEEP = IDENS 
        CALL END_PREP

     ENDDO IROOTS 
     ENDDO INDONE

     DELETE EE
     DELETE DREE
     DELETE DLEE
     DELETE T1A
     DELETE T1B
     DELETE A1A
     DELETE R1A_VECS
     DELETE L1A_VECS
     DELETE L1A_VECS_NRML
     DELETE R1A_VECS_NRML
     DELETE HBAR_ia
     DELETE HBAR_jb
     DELETE DHF
     DELETE ORTHO_COEF

                        ENDSIAL EOM_PROP_CCSD_RHF  
#                      -------------------------

