#            request r2ab_vecs(a,i,b,j,nroots) j
#            tmp =  r2ab_vecs(a,i,b,j,nroots) * r2ab_vecs(a,i,b,j,nroots)
#            tmpa+= tmp 
#      endpardo j,i,a, b
#      execute sip_barrier
