#end_debug

    ENDPROC RESCALE_NEW_C
#   ---------------------
     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           OVLP_CHECK(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF

                 SUMA  = 0.0
                 SUMB  = 0.0
                 SUMAA = 0.0
                 SUMBB = 0.0
                 SUMAB = 0.0
                 HC_A  = 0.0
                 HC_B  = 0.0
                 HC_AA = 0.0
                 HC_BB = 0.0
                 HC_AB = 0.0

                 PARDO i, a

                       GET VC1A_HIST(a,i,NINDEX50)
                       GET VC1A_HIST(a,i,MINDEX50)

                        Tai(a,i)   = VC1A_HIST(a,i,NINDEX50)
                        T1ai(a,i)  = VC1A_HIST(a,i,MINDEX50)

                        TMP   = Tai(a,i) * T1ai(a,i)
                        SUMA += TMP
 
                 ENDPARDO i, a

                 EXECUTE SERVER_BARRIER
                 COLLECTIVE HC_A += SUMA

                 PARDO j, b

                       GET VC1B_HIST(b,j,NINDEX50)
                       GET VC1B_HIST(b,j,MINDEX50)

                       Tbj(b,j)  = VC1B_HIST(b,j,NINDEX50)
                       T1bj(b,j) = VC1B_HIST(b,j,MINDEX50)

                       TMP   = Tbj(b,j) * T1bj(b,j)
                       SUMB += TMP

                 ENDPARDO j, b

                 EXECUTE SERVER_BARRIER
                 COLLECTIVE HC_B += SUMB

                PARDO i, i1, a1, a

                      REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
                      REQUEST VCACT2AA_HIST(a,i,a1,i1,MINDEX50) i1

                      Taiai(a,i,a1,i1)  = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
                      T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,MINDEX50)

                      TMP     = Taiai(a,i,a1,i1) * T1aiai(a,i,a1,i1)
                      TMP    *= 0.25
                      SUMAA += TMP

                ENDPARDO i, i1, a1, a

                EXECUTE SERVER_BARRIER
                COLLECTIVE HC_AA += SUMAA

                PARDO j, j1, b1, b
                      REQUEST VCACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
                      REQUEST VCACT2BB_HIST(b,j,b1,j1,MINDEX50) j1

                      Tbjbj(b,j,b1,j1)  = VCACT2BB_HIST(b,j,b1,j1,NINDEX50)
                      T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,MINDEX50)

                      TMP     = Tbjbj(b,j,b1,j1) *  T1bjbj(b,j,b1,j1)
                      TMP    *= 0.25
                      SUMBB += TMP

                ENDPARDO j, j1, b1, b

                EXECUTE SERVER_BARRIER
                COLLECTIVE HC_BB += SUMBB

                PARDO a, i, b, j
                      REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
                      REQUEST VCACT2AB_HIST(a,i,b,j,MINDEX50) j

                      Taibj(a,i,b,j)  = VCACT2AB_HIST(a,i,b,j,NINDEX50)
                      T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,MINDEX50)

                      TMP     = Taibj(a,i,b,j) * T1aibj(a,i,b,j)
                      SUMAB += TMP

                ENDPARDO a, i, b, j

                EXECUTE SERVER_BARRIER
                COLLECTIVE HC_AB += SUMAB

                A_VALUE  = HC_A
                A_VALUE += HC_B
                A_VALUE += HC_AA
                A_VALUE += HC_BB
                A_VALUE += HC_AB

                 KCOUNT = 0.0
                 DO KINDEX50
                    KCOUNT += 1
                    LCOUNT = 0.0

                    DO LINDEX50
                       LCOUNT += 1.0
                       OVLP_CHECK(MINDEX50,NINDEX50) = A_VALUE
                    ENDDO LINDEX50

                 ENDDO KINDEX50
              ENDDO MINDEX50
     ENDDO NINDEX50

     execute print_static OVLP_CHECK  iter_count

     ENDPROC C_CHECK
#    ---------------

     PROC FORCE_EVECS_TO_ZERO
#    ------------------------

      PARDO i, a
            Tai(a,i)  = 0.0
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO j, b
            Tbj(b,j)  =  0.0
            PUT  VCACT1B(b,j) = Tbj(b,j)
      ENDPARDO j, b

      PARDO a, a1, i, i1
            Taiai(a,i,a1,i1) = 0.0
            PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO a, a1, i, i1
#
      PARDO b, b1, j, j1
            Tbjbj(b,j,b1,j1) = 0.0
            PREPARE VCACT2BB(b,j,b1,j1) = Tbjbj(b,j,b1,j1)
      ENDPARDO b, b1, j, j1
#
      PARDO a, b, i, j
            Taibj(a,i,b,j) = 0.0
            PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, b, i, j

      EXECUTE SERVER_BARRIER

     ENDPROC FORCE_EVECS_TO_ZERO
#    ---------------------------
#-------------------------------------------------------------------------
#                                                                        #
#                      \--------------------------/                      #
#                      |    BEGIN MAIN PROGRAM    |                      #
#                      /--------------------------\                      #
#                                                                        #
#-------------------------------------------------------------------------
#                                                                        #
# Initialize the final lvector arrays (writing to blockdata file needs full
# array)

      PARDO a, i, a1, i1
          tiaia(i,a,i1,a1) = 0.0
          DO kroot
             PREPARE L2AA_S_VECS(i,a,i1,a1,kroot) = tiaia(i,a,i1,a1)
             PREPARE L2AA_T_VECS(i,a,i1,a1,kroot) = tiaia(i,a,i1,a1)
          ENDDO kroot
      ENDPARDO  a, i, a1, i1

      PARDO b, j, b1, j1
          tjbjb(j,b,j1,b1) = 0.0
          DO kroot 
              PREPARE L2BB_S_VECS(j,b,j1,b1,KROOT) = tjbjb(j,b,j1,b1)
              PREPARE L2BB_T_VECS(j,b,j1,b1,KROOT) = tjbjb(j,b,j1,b1)
          ENDDO kroot 
      ENDPARDO b, j, b1, j1

      PARDO  a, i, b, j
        tiajb (i,a,j,b) = 0.0
        DO kroot
           PREPARE L2AB_S_VECS(i,a,j,b,kroot) = tiajb (i,a,j,b)
           PREPARE L2AB_T_VECS(i,a,j,b,kroot) = tiajb (i,a,j,b)
        ENDDO kroot
     ENDPARDO  a, i, b, j
     
     execute server_barrier

      CALL CREATE_ARRAYS
      CALL READ_AMP
      CALL TRAN_UHF 
      execute server_barrier
      CALL HBAR 
      execute server_barrier

#bgn_debug 
#      CALL PRINT_INITIAL 
#end_debug

#
# Create arrays used and zero out some scalars 
# -------------------------------------------- 
#
     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_GUESS    = EE_GUESS
     EOM_DENOM    = EE_DENOM
     EOM_MAXCYC   = EE_MAXCYC
     
     IDENS            = 1.0
     MULT             = 0.0
     ONE              = 1.0
     ZERO             = 0.0

     SINGLET = ZERO
     TRIPLET = ZERO

# The default Guess is right vectors. I would think that this
# will assure that left and right will be matching.

# The default denominator is Fock and can be switched to Hbar

     CALL FORM_11HHPP_DIAG
     IF EOM_DENOM == ONE
        CALL FORM_12HHPP_DIAG
     ENDIF

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC

#bgn_debug
         execute print_scalar eom_guess
         execute print_scalar eom_denom
         execute print_scalar eom_maxcyc
#end_debug

     DO SPN_MULT

        MULT  += 1.0

        IF MULT == ONE
           SINGLET = ONE
           TRIPLET = ZERO
        ELSE
           SINGLET = ZERO
           TRIPLET = ONE
        ENDIF
#bgn_debug
#         execute print_scalar mult
         execute print_scalar singlet
         execute print_scalar triplet
#end_debug

     ROOT_COUNT = 0.0
     DO NROOTS

         ROOT_COUNT += 1.0
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
         MYROOT = ROOT_COUNT
         CALL PREP_EE_GUESS

         ITER_COUNT = 0.0

         DO SUBSP_DIM

            CALL SET_TO_ZERO

            ITER_COUNT += 1.0
#bgn_debug
        execute print_scalar ITER_COUNT
##end_debug
            IF ITER_COUNT > MAX_SUBSP_DIM
               EXIT
            ENDIF

            CALL SAVE_C_VECTORS
#bgn_debug
#            call c_check
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS

            IF ITER_COUNT == 1.0
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT
#end_debug
           IF ITER_COUNT != 1.0
              CALL REORDER_A_EIGS
           ENDIF
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal.
#
           IF ITER_COUNT == 1.0

# If right-hand side has not converged (ie. initial vectors are zero)
# then don't try the left hand for that particualar root.

              IF R_CONVERGED == ZERO
                 CALL FORCE_EVECS_TO_ZERO
                 OMEGA = 0.0
                 EXIT
               ENDIF 

               CALL FORM_NEWVECS_ITR1

           ELSE

              CALL FORM_NEWVECS

              CALL SELECT_VECS

              CALL FORM_SELECTED_Y

              CALL FORM_HBAR_Y_VECS

              CALL FORM_RESIDUAL_VEC

              CALL CHECK_CONVERGENCE
#bgn_debug
      execute print_scalar RESIDUAL_NORM
#end_debug
              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ELSE

                 CALL FORM_CORRECTION_VEC

                 CALL DRIVE_ORTHO

                 CALL RESCALE_NEW_C

              ENDIF 
          ENDIF

         ENDDO SUBSP_DIM

         EXECUTE SERVER_BARRIER
#bgn_debug
#      execute print_scalar OMEGA
#end_debug

         ITER_COUNT += -1.0
         IF ITER_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be located in specified 
# number of cycles.
# Lets set energy to zero and inform the user whart that means

                CALL FORCE_EVECS_TO_ZERO 
                OMEGA = 0.0
             ENDIF
          ENDIF

         IF SINGLET == ONE
         DO INDONE
            MCOUNT = 0.0
            DO KROOT
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  EOM_S_EES(KROOT,INDONE) = OMEGA
                  TEE(KROOT,INDONE)       = EOM_S_EES(KROOT,INDONE)
                  PUT LEE_S(KROOT,INDONE) = TEE(KROOT,INDONE)

                  PARDO a, i
                      GET VCACT1A(a,i)
                      tai(a,i) = VCACT1A(a,i)
                      tia(i,a) = tai(a,i)
                      PUT L1A_S_VECS(i,a,KROOT) = tia(i,a)
                  ENDPARDO a, i

                  PARDO b, j 
                      GET VCACT1B(b,j)
                      tbj(b,j) = VCACT1B(b,j)
                      tjb(j,b) = tbj(b,j)
                      PUT L1B_S_VECS(j,b,KROOT) = tjb(j,b)
                  ENDPARDO b, j

                  PARDO a, i, a1, i1
                      REQUEST VCACT2AA(a,i,a1,i1) i1
                      taiai(a,i,a1,i1) = VCACT2AA(a,i,a1,i1)
                      tiaia(i,a,i1,a1) = taiai(a,i,a1,i1)
                      PREPARE L2AA_S_VECS(i,a,i1,a1,KROOT) = tiaia(i,a,i1,a1)
                  ENDPARDO a, i, a1, i1

                  PARDO b, j, b1, j1
                      REQUEST VCACT2BB(b,j,b1,j1) j1
                      tbjbj(b,j,b1,j1) = VCACT2BB(b,j,b1,j1)
                      tjbjb(j,b,j1,b1) = tbjbj(b,j,b1,j1)
                      PREPARE L2BB_S_VECS(j,b,j1,b1,KROOT) = tjbjb(j,b,j1,b1)
                  ENDPARDO  b, j, b1, j1

                  PARDO a, i, b, j
                     REQUEST VCACT2AB(a,i,b,j) j
                     taibj(a,i,b,j) = VCACT2AB(a,i,b,j)
                     tiajb(i,a,j,b) = taibj(a,i,b,j)
                     PREPARE L2AB_S_VECS(i,a,j,b,KROOT) = tiajb(i,a,j,b)
                  ENDPARDO a, i, b, j
                  EXECUTE SERVER_BARRIER
               ENDIF

            ENDDO KROOT
         ENDDO INDONE 
         ENDIF 

         IF TRIPLET == ONE
         DO INDONE
            MCOUNT = 0.0
            DO KROOT
               MCOUNT += 1.0
               IF MCOUNT == ROOT_COUNT
                  EOM_T_EES(KROOT,INDONE) = OMEGA
                  TEE(KROOT,INDONE)       = EOM_T_EES(KROOT,INDONE)
                  PUT LEE_T(KROOT,INDONE) = TEE(KROOT,INDONE)

                  PARDO a, i
                      GET VCACT1A(a,i)
                      tai(a,i) = VCACT1A(a,i)
                      tia(i,a) = tai(a,i)
                      PUT L1A_T_VECS(i,a,KROOT) = tia(i,a)
                  ENDPARDO a, i

                  PARDO b, j
                      GET VCACT1B(b,j)
                      tbj(b,j) = VCACT1B(b,j)
                      tjb(j,b) = tbj(b,j)
                      PUT L1B_T_VECS(j,b,KROOT) = tjb(j,b)
                  ENDPARDO b, j

                  PARDO a, i, a1, i1
                      REQUEST VCACT2AA(a,i,a1,i1) i1
                      taiai(a,i,a1,i1) = VCACT2AA(a,i,a1,i1)
                      tiaia(i,a,i1,a1) = taiai(a,i,a1,i1)
                      PREPARE L2AA_T_VECS(i,a,i1,a1,KROOT) = tiaia(i,a,i1,a1)
                  ENDPARDO a, i, a1, i1

                  PARDO b, j, b1, j1
                      REQUEST VCACT2BB(b,j,b1,j1) j1
                      tbjbj(b,j,b1,j1) = VCACT2BB(b,j,b1,j1)
                      tjbjb(j,b,j1,b1) = tbjbj(b,j,b1,j1)
                      PREPARE L2BB_T_VECS(j,b,j1,b1,KROOT) = tjbjb(j,b,j1,b1)
                  ENDPARDO  b, j, b1, j1

                  PARDO a, i, b, j
                     REQUEST VCACT2AB(a,i,b,j) j
                     taibj(a,i,b,j) = VCACT2AB(a,i,b,j)
                     tiajb(i,a,j,b) = taibj(a,i,b,j)
                     PREPARE L2AB_T_VECS(i,a,j,b,KROOT) = tiajb(i,a,j,b)
                  ENDPARDO a, i, b, j
                  EXECUTE SERVER_BARRIER
               ENDIF
            ENDDO KROOT
         ENDDO INDONE
         ENDIF 

         EXECUTE SERVER_BARRIER 
      ENDDO NROOTS
#
#      EXECUTE  EOMROOT_PRINT_NEW EOM_S_EES S_ORDER
#      EXECUTE  EOMROOT_PRINT_NEW EOM_T_EES S_ORDER

#bgn_debug
      ROOT_COUNT -= 1.0
      IF SINGLET == ONE
         execute print_static EOM_S_EES ROOT_COUNT
      ENDIF
      IF TRIPLET == ONE
         execute print_static EOM_T_EES ROOT_COUNT
      ENDIF
#end_debug

      ENDDO SPN_MULT

      EIGHT_ZERO = 80.0
      EIGHT_ONE  = 81.0
      WARNING    = 911.0
      EXECUTE PRINT_REL_INFO  EIGHT_ZERO EOM_S_EES
      EXECUTE PRINT_REL_INFO  EIGHT_ONE  EOM_T_EES
      EXECUTE PRINT_REL_INFO  WARNING    DUMMY 

      EXECUTE  SERVER_BARRIER 
      EXECUTE  BLOCKS_TO_LIST  REE_S
      EXECUTE  BLOCKS_TO_LIST  LEE_S

      EXECUTE  BLOCKS_TO_LIST  REE_T
      EXECUTE  BLOCKS_TO_LIST  LEE_T

      EXECUTE  BLOCKS_TO_LIST  HBAR_ia
      EXECUTE  BLOCKS_TO_LIST  HBAR_jb

      EXECUTE  BLOCKS_TO_LIST  R1A_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  R1B_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2AA_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2BB_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2AB_S_VECS 

      EXECUTE  BLOCKS_TO_LIST  R1A_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  R1B_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2AA_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2BB_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  R2AB_T_VECS 

      EXECUTE  BLOCKS_TO_LIST  L1A_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  L1B_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2AA_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2BB_S_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2AB_S_VECS 

      EXECUTE  BLOCKS_TO_LIST  L1A_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  L1B_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2AA_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2BB_T_VECS 
      EXECUTE  BLOCKS_TO_LIST  L2AB_T_VECS 

      EXECUTE  BLOCKS_TO_LIST  t1a
      EXECUTE  BLOCKS_TO_LIST  t1b
      EXECUTE  BLOCKS_TO_LIST  t2aa
      EXECUTE  BLOCKS_TO_LIST  t2ab
      EXECUTE  BLOCKS_TO_LIST  t2bb

      EXECUTE  BLOCKS_TO_LIST  A1a
      EXECUTE  BLOCKS_TO_LIST  A1b
      EXECUTE  BLOCKS_TO_LIST  A2aa
      EXECUTE  BLOCKS_TO_LIST  A2ab
      EXECUTE  BLOCKS_TO_LIST  A2bb

      EXECUTE  BLOCKS_TO_LIST  VSpipi(p,i,p1,i1)
      EXECUTE  BLOCKS_TO_LIST  VSqjqj(q,j,q1,j1)
      EXECUTE  BLOCKS_TO_LIST  Vpiqj(p,i,q,j)
      EXECUTE  SERVER_BARRIER
      EXECUTE  WRITE_BLOCKS_TO_LIST
      EXECUTE  SERVER_BARRIER

      ENDSIAL LEOM_CCSD_UHF
      ---------------------

