#end_debug

      ENDPROC PREP_EE_GUESS
#     ----------------------

      PROC SET_TO_ZERO
#     ----------------

      DO MINDEX50
         OVERLAP_R(MINDEX50)  = 0.0
         DO NINDEX50
            TS(MINDEX50,NINDEX50) = 0.0
            A_MATRIX(MINDEX50,NINDEX50)   = 0.0
            PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
         ENDDO NINDEX50
      ENDDO MINDEX50

      DO NINDEX50

         PARDO i, a
               Tai(a,i)  = 0.0
               PUT Y1A(a,i,NINDEX50) = Tai(a,i)
               PUT R1a_intmd(a,i) = Tai(a,i)
           
         ENDPARDO i, a
   
         PARDO j, b
               Tbj(b,j)  = 0.0
                  PUT Y1B(b,j,NINDEX50) = Tbj(b,j)
                  PUT R1b_intmd(b,j) = Tbj(b,j)
         ENDPARDO j, b
   
         PARDO a, a1, i, i1
               Taiai(a,i,a1,i1) = 0.0
               PREPARE Y2aa(a,i,a1,i1,NINDEX50) = Taiai(a,i,a1,i1)
               PREPARE R2_intmd_aa(a,i,a1,i1) = Taiai(a,i,a1,i1)
         ENDPARDO a, a1, i, i1
#
         PARDO b, b1, j, j1
               Tbjbj(b,j,b1,j1) = 0.0
               PREPARE Y2bb(b,j,b1,j1,NINDEX50)  = Tbjbj(b,j,b1,j1)
               PREPARE R2_intmd_bb(b,j,b1,j1) = Tbjbj(b,j,b1,j1)
         ENDPARDO b, b1, j, j1
#
         PARDO a, b, i, j
               Taibj(a,i,b,j) = 0.0
               PREPARE Y2ab(a,i,b,j,NINDEX50)  = Taibj(a,i,b,j) 
               PREPARE R2_intmd_ab(a,i,b,j) = Taibj(a,i,b,j)
         ENDPARDO a, b, i, j

      ENDDO NINDEX50

      execute server_barrier

      ENDPROC SET_TO_ZERO
#     -------------------

      PROC SAVE_C_VECTORS
#     ------------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            PARDO a, i
                  GET VCACT1A(a,i)
                  Tai(a,i) = VCACT1A(a,i)
                  PUT VC1A_HIST(a,i,NINDEX50) = Tai(a,i)
            ENDPARDO a, i

            PARDO b, j
                  GET VCACT1B(b,j)
                  Tbj(b,j) = VCACT1B(b,j)
                  PUT VC1B_HIST(b,j,NINDEX50) = Tbj(b,j)
            ENDPARDO b, j

            PARDO a, a1, i, i1
                  REQUEST VCACT2AA(a,i,a1,i1) i1
                  Taiai(a,i,a1,i1) = VCACT2AA(a,i,a1,i1)
                  PREPARE VCACT2AA_HIST(a,i,a1,i1,NINDEX50) = Taiai(a,i,a1,i1)
            ENDPARDO a, a1, i, i1

            PARDO b, b1, j, j1
                  REQUEST VCACT2BB(b,j,b1,j1) j1
                  Tbjbj(b,j,b1,j1) = VCACT2BB(b,j,b1,j1)
                  PREPARE VCACT2BB_HIST(b,j,b1,j1,NINDEX50) = Tbjbj(b,j,b1,j1)
            ENDPARDO b, b1, j, j1

            PARDO a, b, i, j
                  REQUEST VCACT2AB(a,i,b,j) j
                  Taibj(a,i,b,j) = VCACT2AB(a,i,b,j)
                  PREPARE VCACT2AB_HIST(a,i,b,j,NINDEX50) = Taibj(a,i,b,j)
            ENDPARDO a, b, i, j
            
        ENDIF

      ENDDO NINDEX50
      
      execute server_barrier 
      
      ENDPROC SAVE_C_VECTORS
#     ----------------------

     PROC SAVE_HC_VECTORS
#     ------------------

      NCOUNT = 0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            PARDO a, i
                  GET VCHACT1A(a,i)
                  Tai(a,i) = VCHACT1A(a,i)
                  PUT VCH1A_HIST(a,i,NINDEX50) = Tai(a,i)
            ENDPARDO a, i

            PARDO b, j
                  GET VCHACT1B(b,j)
                  Tbj(b,j) = VCHACT1B(b,j)
                  PUT VCH1B_HIST(b,j,NINDEX50) = Tbj(b,j)
            ENDPARDO b, j

            PARDO a, a1, i, i1
                  REQUEST VCHACT2AA(a,i,a1,i1) i1
                  Taiai(a,i,a1,i1) = VCHACT2AA(a,i,a1,i1)
                  PREPARE VCHACT2AA_HIST(a,i,a1,i1,NINDEX50) = Taiai(a,i,a1,i1)
            ENDPARDO a, a1, i, i1

            PARDO b, b1, j, j1
                  REQUEST VCHACT2BB(b,j,b1,j1) j1
                  Tbjbj(b,j,b1,j1) = VCHACT2BB(b,j,b1,j1)
                  PREPARE VCHACT2BB_HIST(b,j,b1,j1,NINDEX50) = Tbjbj(b,j,b1,j1)
            ENDPARDO b, b1, j, j1

            PARDO a, b, i, j
                  REQUEST VCHACT2AB(a,i,b,j) j
                  Taibj(a,i,b,j) = VCHACT2AB(a,i,b,j)
                  PREPARE VCHACT2AB_HIST(a,i,b,j,NINDEX50) = Taibj(a,i,b,j)
            ENDPARDO a, b, i, j

        ENDIF

      ENDDO NINDEX50

      execute server_barrier

      ENDPROC SAVE_HC_VECTORS
#    ------------------------

     PROC FORM_A_MATRIX_11
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT

                    PARDO i, a

                          GET VCH1A_HIST(a,i,NINDEX50)
                          GET VC1A_HIST(a,i,MINDEX50)

                          Tai(a,i)   = VCH1A_HIST(a,i,NINDEX50)
                          T1ai(a,i)  = VC1A_HIST(a,i,MINDEX50)

                          TMP   = Tai(a,i) *  T1ai(a,i)
                          SUMA += TMP

                    ENDPARDO i, a

                    PARDO j, b

                          GET VCH1B_HIST(b,j,NINDEX50)
                          GET VC1B_HIST(b,j,MINDEX50)

                          Tbj(b,j)   = VCH1B_HIST(b,j,NINDEX50)
                          T1bj(b,j)  = VC1B_HIST(b,j,MINDEX50)

                          TMP   = Tbj(b,j) * T1bj(b,j)
                          SUMB += TMP

                    ENDPARDO j, b

                    EXECUTE SIP_BARRIER
                    COLLECTIVE HC_A += SUMA
                    COLLECTIVE HC_B += SUMB

                 ENDIF

              ENDDO MINDEX50
           ENDIF

        ENDDO NINDEX50

     A_VALUE  = HC_A
     A_VALUE += HC_B
#bgn_debug
#     execute print_scalar A_value
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50
               MCOUNT += 1.0
               IF MCOUNT == 1.0

                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF
             ENDDO MINDEX50
         ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC FORM_A_MATRIX_11
#    ------------------------

    PROC FORM_A_MATRIX_IJ
#    --------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF

                 IF MCOUNT == ITER_COUNT
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF
                 ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAA  = 0.0
                    SUMBB  = 0.0
                    SUMAB  = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AA  = 0.0
                    HC_BB  = 0.0
                    HC_AB  = 0.0

                    PARDO i, a

                            GET VCH1A_HIST(a,i,NINDEX50)
                            GET VC1A_HIST(a,i,MINDEX50)

                            Tai(a,i)   = VCH1A_HIST(a,i,NINDEX50)
                            T1ai(a,i)  = VC1A_HIST(a,i,MINDEX50)

                            TMP   = Tai(a,i) * T1ai(a,i) 
                            SUMA += TMP

                     ENDPARDO i, a

                     EXECUTE SERVER_BARRIER

                     PARDO j, b

                           GET VCH1B_HIST(b,j,NINDEX50)
                           GET VC1B_HIST(b,j,MINDEX50)

                           Tbj(b,j)  = VCH1B_HIST(b,j,NINDEX50)
                           T1bj(b,j) = VC1B_HIST(b,j,MINDEX50)

                            TMP   = Tbj(b,j) * T1bj(b,j)
                            SUMB += TMP

                     ENDPARDO j, b

                     PARDO i, i1, a1, a

                           REQUEST VCHACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
                           REQUEST VCACT2AA_HIST(a,i,a1,i1,MINDEX50)  i1

                           Taiai(a,i,a1,i1)  = VCHACT2AA_HIST(a,i,a1,i1,NINDEX50)
                           T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,MINDEX50)

                           TMP     = Taiai(a,i,a1,i1) * T1aiai(a,i,a1,i1)
                           TMP    *= 0.25
                           SUMAA  += TMP

                     ENDPARDO i, i1, a1, a

                     PARDO j, j1, b1, b

                           REQUEST VCHACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
                           REQUEST VCACT2BB_HIST(b,j,b1,j1,MINDEX50)  j1

                           Tbjbj(b,j,b1,j1)  = VCHACT2BB_HIST(b,j,b1,j1,NINDEX50)
                           T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,MINDEX50)

                           TMP     = Tbjbj(b,j,b1,j1) * T1bjbj(b,j,b1,j1)
                           TMP    *= 0.25
                           SUMBB  += TMP

                     ENDPARDO j, j1, b1, b

                     PARDO a, i, b, j
                           REQUEST VCHACT2AB_HIST(a,i,b,j,NINDEX50) j
                           REQUEST VCACT2AB_HIST(a,i,b,j,MINDEX50)  j

                           Taibj(a,i,b,j)  = VCHACT2AB_HIST(a,i,b,j,NINDEX50)
                           T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,MINDEX50)

                           TMP     = Taibj(a,i,b,j) * T1aibj(a,i,b,j) 
                           SUMAB  += TMP

                     ENDPARDO a, i, b, j

                     EXECUTE SIP_BARRIER
                     COLLECTIVE HC_A  += SUMA
                     COLLECTIVE HC_B  += SUMB
                     COLLECTIVE HC_AA += SUMAA
                     COLLECTIVE HC_BB += SUMBB
                     COLLECTIVE HC_AB += SUMAB

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AA
                     A_VALUE += HC_BB
                     A_VALUE += HC_AB
                     EXECUTE SIP_BARRIER

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------

    PROC FORM_A_MATRIX_JI
#    --------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

              MCOUNT = 0.0
              DO MINDEX50
                 MCOUNT += 1.0

                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF

                 IF MCOUNT == ITER_COUNT
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF
                 ENDIF

                    SUMA   = 0.0
                    SUMB   = 0.0
                    SUMAA  = 0.0
                    SUMBB  = 0.0
                    SUMAB  = 0.0
                    HC_A   = 0.0
                    HC_B   = 0.0
                    HC_AA  = 0.0
                    HC_BB  = 0.0
                    HC_AB  = 0.0

                    PARDO i, a

                            GET VCH1A_HIST(a,i,MINDEX50)
                            GET VC1A_HIST(a,i,NINDEX50)

                            Tai(a,i)   = VCH1A_HIST(a,i,MINDEX50)
                            T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)

                            TMP   = Tai(a,i) * T1ai(a,i) 
                            SUMA += TMP

                     ENDPARDO i, a

                     PARDO j, b
                           GET VCH1B_HIST(b,j,MINDEX50)
                           GET VC1B_HIST(b,j,NINDEX50)

                           Tbj(b,j)  = VCH1B_HIST(b,j,MINDEX50)
                           T1bj(b,j) = VC1B_HIST(b,j,NINDEX50)

                            TMP   = Tbj(b,j) * T1bj(b,j)
                            SUMB += TMP

                     ENDPARDO j, b

                     PARDO i, i1, a1, a

                           REQUEST VCHACT2AA_HIST(a,i,a1,i1,MINDEX50) i1
                           REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50)  i1

                           Taiai(a,i,a1,i1)  = VCHACT2AA_HIST(a,i,a1,i1,MINDEX50)
                           T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)

                           TMP     = Taiai(a,i,a1,i1) * T1aiai(a,i,a1,i1)
                           TMP    *= 0.25
                           SUMAA  += TMP

                     ENDPARDO i, i1, a1, a

                     PARDO j, j1, b1, b

                           REQUEST VCHACT2BB_HIST(b,j,b1,j1,MINDEX50) j1
                           REQUEST VCACT2BB_HIST(b,j,b1,j1,NINDEX50)  j1

                           Tbjbj(b,j,b1,j1)  = VCHACT2BB_HIST(b,j,b1,j1,MINDEX50)
                           T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,NINDEX50)

                           TMP     = Tbjbj(b,j,b1,j1) * T1bjbj(b,j,b1,j1)
                           TMP    *= 0.25
                           SUMBB  += TMP

                     ENDPARDO j, j1, b1, b

                     PARDO a, i, b, j
                           REQUEST VCHACT2AB_HIST(a,i,b,j,MINDEX50) j
                           REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50)  j

                           Taibj(a,i,b,j)  = VCHACT2AB_HIST(a,i,b,j,MINDEX50)
                           T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,NINDEX50)

                           TMP     = Taibj(a,i,b,j) * T1aibj(a,i,b,j) 
                           SUMAB  += TMP

                     ENDPARDO a, i, b, j

                     EXECUTE SIP_BARRIER
                     COLLECTIVE HC_A  += SUMA
                     COLLECTIVE HC_B  += SUMB
                     COLLECTIVE HC_AA += SUMAA
                     COLLECTIVE HC_BB += SUMBB
                     COLLECTIVE HC_AB += SUMAB

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AA
                     A_VALUE += HC_BB
                     A_VALUE += HC_AB
                     EXECUTE SIP_BARRIER

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------

    PROC FORM_A_MATRIX_II
#    --------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

    SUMA   = 0.0
    SUMB   = 0.0
    SUMAA  = 0.0
    SUMBB  = 0.0
    SUMAB  = 0.0
    HC_A   = 0.0
    HC_B   = 0.0
    HC_AA  = 0.0
    HC_BB  = 0.0
    HC_AB  = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0

                 IF NCOUNT == MCOUNT

                    PARDO i, a

                            GET VCH1A_HIST(a,i,NINDEX50)
                            GET VC1A_HIST(a,i,MINDEX50)

                            Tai(a,i)   = VCH1A_HIST(a,i,NINDEX50)
                            T1ai(a,i)  = VC1A_HIST(a,i,MINDEX50)

                            TMP   = Tai(a,i) * T1ai(a,i) 
                            SUMA += TMP

                     ENDPARDO i, a

                     EXECUTE SERVER_BARRIER

                     PARDO j, b

                           GET VCH1B_HIST(b,j,NINDEX50)
                           GET VC1B_HIST(b,j,MINDEX50)

                           Tbj(b,j)  = VCH1B_HIST(b,j,NINDEX50)
                           T1bj(b,j) = VC1B_HIST(b,j,MINDEX50)

                            TMP   = Tbj(b,j) * T1bj(b,j)
                            SUMB += TMP

                     ENDPARDO j, b

                     EXECUTE SERVER_BARRIER

                     PARDO i, i1, a1, a

                           REQUEST VCHACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
                           REQUEST VCACT2AA_HIST(a,i,a1,i1,MINDEX50)  i1

                           Taiai(a,i,a1,i1)  = VCHACT2AA_HIST(a,i,a1,i1,NINDEX50)
                           T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,MINDEX50)

                           TMP     = Taiai(a,i,a1,i1) * T1aiai(a,i,a1,i1)
                           TMP    *= 0.25
                           SUMAA  += TMP

                     ENDPARDO i, i1, a1, a

                     EXECUTE SERVER_BARRIER

                     PARDO j, j1, b1, b

                           REQUEST VCHACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
                           REQUEST VCACT2BB_HIST(b,j,b1,j1,MINDEX50)  j1

                           Tbjbj(b,j,b1,j1)  = VCHACT2BB_HIST(b,j,b1,j1,NINDEX50)
                           T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,MINDEX50)

                           TMP     = Tbjbj(b,j,b1,j1) * T1bjbj(b,j,b1,j1)
                           TMP    *= 0.25
                           SUMBB  += TMP

                     ENDPARDO j, j1, b1, b

                     EXECUTE SERVER_BARRIER

                     PARDO a, i, b, j
                           REQUEST VCHACT2AB_HIST(a,i,b,j,NINDEX50) j
                           REQUEST VCACT2AB_HIST(a,i,b,j,MINDEX50)  j

                           Taibj(a,i,b,j)  = VCHACT2AB_HIST(a,i,b,j,NINDEX50)
                           T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,MINDEX50)

                           TMP     = Taibj(a,i,b,j) * T1aibj(a,i,b,j) 
                           SUMAB  += TMP

                     ENDPARDO a, i, b, j

                     EXECUTE SIP_BARRIER
                     COLLECTIVE HC_A  += SUMA
                     COLLECTIVE HC_B  += SUMB
                     COLLECTIVE HC_AA += SUMAA
                     COLLECTIVE HC_BB += SUMBB
                     COLLECTIVE HC_AB += SUMAB

                     A_VALUE  = HC_A
                     A_VALUE += HC_B
                     A_VALUE += HC_AA
                     A_VALUE += HC_BB
                     A_VALUE += HC_AB
                     EXECUTE SIP_BARRIER

                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

                 ENDIF
              ENDDO NINDEX50
       ENDIF 
     ENDDO MINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC FORM_A_MATRIX_II
#    ------------------------

     PROC REORDER_A_EIGS
#    -------------------

     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              T1XX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL T1XX EIG_VALUE
              A_DIAGS(MINDEX50)      = EIG_VALUE
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS

     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE
     OMEGA0M  = A_VALUE
     OMEGA0M *= -1.0

# First the residual vector for iteration 1
   
     PARDO i, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VCH1A_HIST(a,i,NINDEX50)
              GET VC1A_HIST(a,i,NINDEX50)

              Tai(a,i)   = VCH1A_HIST(a,i,NINDEX50)
              T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)
              T1ai(a,i) *= OMEGA0M
              Tai(a,i)  += T1ai(a,i)

              PUT RES1a(a,i) = Tai(a,i)

           ENDDO NINDEX50
     ENDPARDO i, a


     PARDO j, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VCH1B_HIST(b,j,NINDEX50)
              GET VC1B_HIST(b,j,NINDEX50)

              Tbj(b,j)   = VCH1B_HIST(b,j,NINDEX50)
              T1bj(b,j)  = VC1B_HIST(b,j,NINDEX50)
              T1bj(b,j) *= OMEGA0M
              Tbj(b,j)  += T1bj(b,j)

              PUT RES1b(b,j) = Tbj(b,j)

           ENDDO NINDEX50
     ENDPARDO  j, b

     EXECUTE SIP_BARRIER

     PARDO i, i1, a1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCHACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
              REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50)  i1

              Taiai(a,i,a1,i1)   = VCHACT2AA_HIST(a,i,a1,i1,NINDEX50)
              T1aiai(a,i,a1,i1)  = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
              T1aiai(a,i,a1,i1) *= OMEGA0M
              Taiai(a,i,a1,i1)  += T1aiai(a,i,a1,i1) 
              PREPARE RES2aa(a,i,a1,i1) = Taiai(a,i,a1,i1)

           ENDDO NINDEX50
     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCHACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
              REQUEST VCACT2BB_HIST(b,j,b1,j1,NINDEX50) j1

              Tbjbj(b,j,b1,j1)   = VCHACT2BB_HIST(b,j,b1,j1,NINDEX50)
              T1bjbj(b,j,b1,j1)  = VCACT2BB_HIST(b,j,b1,j1,NINDEX50)
              T1bjbj(b,j,b1,j1) *= OMEGA0M 
              Tbjbj(b,j,b1,j1)  += T1bjbj(b,j,b1,j1)
              PREPARE RES2bb(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

           ENDDO NINDEX50
     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCHACT2AB_HIST(a,i,b,j,NINDEX50) j
              REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j

              Taibj(a,i,b,j)   = VCHACT2AB_HIST(a,i,b,j,NINDEX50)
              T1aibj(a,i,b,j)  = VCACT2AB_HIST(a,i,b,j,NINDEX50)
              T1aibj(a,i,b,j) *= OMEGA0M
              Taibj(a,i,b,j)  += T1aibj(a,i,b,j)
              PREPARE RES2ab(a,i,b,j) = Taibj(a,i,b,j)

           ENDDO NINDEX50
     ENDPARDO i, j, b, a

     EXECUTE SERVER_BARRIER
#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request  res2aa(a,i1,a1,i) i
#            tmp = res2aa(a,i1,a1,i) * res2aa(a,i1,a1,i)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1,b1
#            request  res2bb(b,j1,b1,j) j
#            tmp = res2bb(b,j1,b1,j) * res2bb(b,j1,b1,j)
#            tmpa+= tmp
#      endpardo b,j,j1,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#enddebug

# Now the correction vector for iteration 1

     PARDO a, i
           GET RES1a(a,i)
           GET VCONV1A(a,i)

           Tai(a,i)   = VCONV1A(a,i)
           T1ai(a,i)  = RES1a(a,i)

           Tai(a,i)  *= -1.0
           T2ai(a,i)  = OMEGA0
           Tai(a,i)  += T2ai(a,i)

           EXECUTE APPLY_DEN2_NOR  T1ai Tai

           PUT CORR_VECa(a,i) =  T1ai(a,i)
     ENDPARDO a, i

     PARDO b, j
            GET RES1b(b,j)
            GET VCONV1B(b,j)

            Tbj(b,j)   = VCONV1B(b,j)
            T1bj(b,j)  = RES1b(b,j)

            Tbj(b,j)  *= -1.0
            T2bj(b,j)  = OMEGA0
            Tbj(b,j)  += T2bj(b,j)

            EXECUTE APPLY_DEN2_NOR  T1bj Tbj

            PUT CORR_VECb(b,j) =  T1bj(b,j)

     ENDPARDO b, j

     PARDO i, i1, a1, a
         REQUEST RES2aa(a,i,a1,i1) i1
         REQUEST VCONV2AA(a,i,a1,i1) i1

         Taiai(a,i,a1,i1)  = VCONV2AA(a,i,a1,i1)
         T1aiai(a,i,a1,i1) = RES2aa(a,i,a1,i1)

         Taiai(a,i,a1,i1) *= -1.0
         T2aiai(a,i,a1,i1) = OMEGA0
         Taiai(a,i,a1,i1)  += T2aiai(a,i,a1,i1)

         EXECUTE APPLY_DEN4 T1aiai Taiai

         PREPARE CORR_VECaa(a,i,a1,i1) = T1aiai(a,i,a1,i1)

     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b
         REQUEST RES2bb(b,j,b1,j1) j1
         REQUEST VCONV2BB(b,j,b1,j1) j1

         Tbjbj(b,j,b1,j1)  = VCONV2BB(b,j,b1,j1)
         T1bjbj(b,j,b1,j1) = RES2bb(b,j,b1,j1)

         Tbjbj(b,j,b1,j1)  *= -1.0
         T2bjbj(b,j,b1,j1)  = OMEGA0
         Tbjbj(b,j,b1,j1)  += T2bjbj(b,j,b1,j1)

         EXECUTE APPLY_DEN4 T1bjbj Tbjbj

         PREPARE CORR_VECbb(b,j,b1,j1) = T1bjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO a, i, b, j
        REQUEST RES2ab(a,i,b,j) j
        REQUEST VCONV2AB(a,i,b,j) j

        Taibj(a,i,b,j)   = VCONV2AB(a,i,b,j)
        T1aibj(a,i,b,j)  = RES2ab(a,i,b,j)

        Taibj(a,i,b,j)  *= -1.0
        T2aibj(a,i,b,j)  = OMEGA0
        Taibj(a,i,b,j) += T2aibj(a,i,b,j)

        EXECUTE APPLY_DEN4 T1aibj Taibj

        PREPARE CORR_VECab(a,i,b,j) = T1aibj(a,i,b,j)

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER 

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     SUMB   = 0.0
     SUMAA  = 0.0
     SUMBB  = 0.0
     SUMAB  = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AA  = 0.0
     HC_BB  = 0.0
     HC_AB  = 0.0

     PARDO i, a
           GET CORR_VECa(a,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VC1A_HIST(a,i,NINDEX50)

              Tai(a,i)   = CORR_VECa(a,i)
              T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)
              TMP   = Tai(a,i) * T1ai(a,i)
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO i, a

     PARDO j, b

           GET CORR_VECb(b,j)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VC1B_HIST(b,j,NINDEX50)

              Tbj(b,j)   = CORR_VECb(b,j)
              T1bj(b,j)  = VC1B_HIST(b,j,NINDEX50)
              TMP  = Tbj(b,j) * T1bj(b,j)
              SUMB += TMP

           ENDDO NINDEX50
     ENDPARDO  j,b

     PARDO  a, i, a1, i1

           REQUEST CORR_VECaa(a,i,a1,i1) i1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCACT2aa_HIST(a,i,a1,i1,NINDEX50) i1

              Taiai(a,i,a1,i1)   =  CORR_VECaa(a,i,a1,i1) 
              T1aiai(a,i,a1,i1)   = VCACT2aa_HIST(a,i,a1,i1,NINDEX50)
              TMP  =  Taiai(a,i,a1,i1) *  T1aiai(a,i,a1,i1)
              TMP *= 0.25
              SUMAA += TMP

           ENDDO NINDEX50
     ENDPARDO  a, i, a1, i1

     PARDO  b, j, b1, j1

           REQUEST CORR_VECbb(b,j,b1,j1) j1

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCACT2bb_HIST(b,j,b1,j1,NINDEX50) j1

              Tbjbj(b,j,b1,j1)   =  CORR_VECbb(b,j,b1,j1)
              T1bjbj(b,j,b1,j1)  = VCACT2bb_HIST(b,j,b1,j1,NINDEX50)
              TMP  = Tbjbj(b,j,b1,j1) * T1bjbj(b,j,b1,j1)
              TMP *= 0.25
              SUMBB += TMP

           ENDDO NINDEX50
     ENDPARDO  b, j, b1, j1

     PARDO  a, i, b, j

           REQUEST CORR_VECab(a,i,b,j) j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              REQUEST VCACT2ab_HIST(a,i,b,j,NINDEX50) j

              Taibj(a,i,b,j)   =  CORR_VECab(a,i,b,j)
              T1aibj(a,i,b,j)  = VCACT2ab_HIST(a,i,b,j,NINDEX50)
              TMP  = Taibj(a,i,b,j) * T1aibj(a,i,b,j)
              SUMAB += TMP

           ENDDO NINDEX50
     ENDPARDO  a, i, b, j

     EXECUTE SERVER_BARRIER 
     COLLECTIVE HC_A   += SUMA
     COLLECTIVE HC_B   += SUMB
     COLLECTIVE HC_AA  += SUMAA
     COLLECTIVE HC_BB  += SUMBB
     COLLECTIVE HC_AB  += SUMAB
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
     NORM_GHG += HC_B
     NORM_GHG += HC_AA
     NORM_GHG += HC_BB
     NORM_GHG += HC_AB
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO i, a

           GET CORR_VECa(a,i)
           Tai(a,i) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VC1A_HIST(a,i,NINDEX50)

              Tai(a,i)   = CORR_VECa(a,i)
              T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)
              T1ai(a,i) *= NORM_GHG
              T1ai(a,i) *= -1.0
              Tai(a,i)  += T1ai(a,i)

           ENDDO NINDEX50

          PUT R1A_intmd(a,i) = Tai(a,i)
     ENDPARDO i, a

     PARDO j, b

           GET CORR_VECb(b,j)
           Tbj(b,j) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET VC1B_HIST(b,j,NINDEX50)

              Tbj(b,j)   = CORR_VECb(b,j)
              T1bj(b,j)  = VC1B_HIST(b,j,NINDEX50)
              T1bj(b,j) *= NORM_GHG
              T1bj(b,j) *= -1.0
              Tbj(b,j)  += T1bj(b,j)

           ENDDO NINDEX50

           PUT R1B_intmd(b,j) = Tbj(b,j)
     ENDPARDO  j, b

     PARDO i, i1, a1, a

           REQUEST CORR_VECaa(a,i,a1,i1) i1
           Taiai(a,i,a1,i1)  = CORR_VECaa(a,i,a1,i1)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
              T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
         
              T1aiai(a,i,a1,i1) *= NORM_GHG
              T1aiai(a,i,a1,i1) *= -1.0
              Taiai(a,i,a1,i1)  += T1aiai(a,i,a1,i1)

           ENDDO NINDEX50

           PREPARE R2_intmd_aa(a,i,a1,i1) = Taiai(a,i,a1,i1)

     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b

           REQUEST CORR_VECbb(b,j,b1,j1) j1
           Tbjbj(b,j,b1,j1)  = CORR_VECbb(b,j,b1,j1)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST VCACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
             T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,NINDEX50)

             T1bjbj(b,j,b1,j1) *= NORM_GHG
             T1bjbj(b,j,b1,j1) *= -1.0
             Tbjbj(b,j,b1,j1)  += T1bjbj(b,j,b1,j1)

           ENDDO NINDEX50

           PREPARE R2_intmd_bb(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

           REQUEST CORR_VECab(a,i,b,j) j
           Taibj(a,i,b,j)  = CORR_VECab(a,i,b,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
              T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,NINDEX50)

              T1aibj(a,i,b,j) *= NORM_GHG
              T1aibj(a,i,b,j) *= -1.0
              Taibj(a,i,b,j)  += T1aibj(a,i,b,j)

          ENDDO NINDEX50

          PREPARE R2_intmd_ab(a,i,b,j) = Taibj(a,i,b,j)

     ENDPARDO i, j, b, a

    EXECUTE SERVER_BARRIER
#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo a,i1,a1,i
#            request  R2_intmd_aa(a,i1,a1,i) i
#            tmp = R2_intmd_aa(a,i1,a1,i) * R2_intmd_aa(a,i1,a1,i)
#            tmpa += tmp
#      endpardo a,i1,a1,i
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#      tmpa =0.0
#      suma =0.0
#      pardo b,j,j1,b1
#            request  R2_intmd_bb(b,j1,b1,j) j
#            tmp = R2_intmd_bb(b,j1,b1,j) * R2_intmd_bb(b,j1,b1,j)
#            tmpa+= tmp
#      endpardo b,j,j1,b1
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

# Final normalization

     SUMA  = 0.0
     SUMB  = 0.0
     TMPA  = 0.0
     TMPB  = 0.0
     TMPAA = 0.0
     TMPBB = 0.0
     TMPAB = 0.0

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            TMPA += TMP

      ENDPARDO i, a

      PARDO j, b

            GET  R1b_intmd(b,j)
            Tbj(b,j) =  R1b_intmd(b,j)
            TMP   = Tbj(b,j) * Tbj(b,j)
            TMPB += TMP

      ENDPARDO j, b

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)

              TMP  = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
              TMP *= 0.25
              TMPAA += TMP

      ENDPARDO i, i1, a1, a

      PARDO j, j1, b1, b

              REQUEST R2_intmd_bb(b,j,b1,j1) j1
              Tbjbj(b,j,b1,j1) = R2_intmd_bb(b,j,b1,j1)

              TMP  = Tbjbj(b,j,b1,j1) * Tbjbj(b,j,b1,j1)
              TMP *= 0.25
              TMPBB +=  TMP

     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j) = R2_intmd_ab(a,i,b,j)

              TMP   = Taibj(a,i,b,j) * Taibj(a,i,b,j)
              TMPAB +=  TMP

     ENDPARDO i, j, b, a

     EXECUTE SERVER_BARRIER
     COLLECTIVE  SUMA  += TMPA
     COLLECTIVE  SUMB  += TMPB
     COLLECTIVE  SUMAA += TMPAA
     COLLECTIVE  SUMBB += TMPBB
     COLLECTIVE  SUMAB += TMPAB

     SUM_R  = SUMA
     SUM_R += SUMB
     SUM_R += SUMAA
     SUM_R += SUMBB
     SUM_R += SUMAB

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R

     EXECUTE SIP_BARRIER

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i)  = R1a_intmd(a,i)
            Tai(a,i) *= INV_SQRT_NORM_R
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO j, b

            GET  R1b_intmd(b,j)
            Tbj(b,j)  = R1b_intmd(b,j)
            Tbj(b,j) *= INV_SQRT_NORM_R
            PUT VCACT1B(b,j) = Tbj(b,j)

      ENDPARDO j, b

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)
              Taiai(a,i,a1,i1) *= INV_SQRT_NORM_R
              PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)

      ENDPARDO i, i1, a1, a

      PARDO j, j1, b1, b

              REQUEST R2_intmd_bb(b,j,b1,j1) j1
              Tbjbj(b,j,b1,j1)  = R2_intmd_bb(b,j,b1,j1)
              Tbjbj(b,j,b1,j1) *= INV_SQRT_NORM_R
              PREPARE VCACT2BB(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j)  = R2_intmd_ab(a,i,b,j)
              Taibj(a,i,b,j) *= INV_SQRT_NORM_R
              PREPARE VCACT2AB(a,i,b,j) =  Taibj(a,i,b,j)

     ENDPARDO i, j, b, a

     EXECUTE SERVER_BARRIER

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0 
#      sumab=0.0
