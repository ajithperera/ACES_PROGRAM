     ENDPROC FORM_NEWVECS_ITR1
#    -------------------------

     PROC FORM_NEWVECS
#    -----------------

     PARDO i, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET VC1A_HIST(a,i,MINDEX50)
                       Tain(a,i,MINDEX50)  = VC1A_HIST(a,i,MINDEX50)
                       T1ain(a,i,NINDEX50) = Tain(a,i,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1A(a,i,NINDEX50) += T1ain(a,i,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, a

     PARDO j, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET VC1B_HIST(b,j,MINDEX50)
                       Tbjn(b,j,MINDEX50)  = VC1B_HIST(b,j,MINDEX50)
                       T1bjn(b,j,NINDEX50) = Tbjn(b,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1B(b,j,NINDEX50) += T1bjn(b,j,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, b 

     PARDO i, i1, a1, a

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCACT2aa_HIST(a,i,a1,i1,MINDEX50)  i1

                       Taiain(a,i,a1,i1,MINDEX50) = VCACT2aa_HIST(a,i,a1,i1,MINDEX50)
                       T1aiain(a,i,a1,i1,NINDEX50) = Taiain(a,i,a1,i1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2aa(a,i,a1,i1,NINDEX50) += T1aiain(a,i,a1,i1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, i1, a1, a

    PARDO j, j1, b1, b

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCACT2bb_HIST(b,j,b1,j1,MINDEX50)  j1

                       Tbjbjn(b,j,b1,j1,MINDEX50) = VCACT2bb_HIST(b,j,b1,j1,MINDEX50)
                       T1bjbjn(b,j,b1,j1,NINDEX50) = Tbjbjn(b,j,b1,j1,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2bb(b,j,b1,j1,NINDEX50) += T1bjbjn(b,j,b1,j1,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50
     ENDPARDO j, j1, b1, b

     PARDO a, i, b, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)

                       REQUEST VCACT2ab_HIST(a,i,b,j,MINDEX50)  j

                       Taibjn(a,i,b,j,MINDEX50) = VCACT2ab_HIST(a,i,b,j,MINDEX50)
                       T1aibjn(a,i,b,j,NINDEX50) = Taibjn(a,i,b,j,MINDEX50) * TS(MINDEX50,NINDEX50)

                       PREPARE Y2ab(a,i,b,j,NINDEX50) += T1aibjn(a,i,b,j,NINDEX50)
                 ENDDO MINDEX50
           ENDDO NINDEX50

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_NEWVECS
#    --------------------

     PROC SELECT_VECS
#    ----------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT  > 1.0
           EXIT
        ENDIF

           MCOUNT = 0.0
           DO MINDEX50
              MCOUNT += 1.0
              IF MCOUNT >  ITER_COUNT
                 EXIT
              ENDIF

                 SUMA   = 0.0
                 SUMB   = 0.0
                 CY_A   = 0.0
                 CY_B   = 0.0

                 PARDO a, i

                       GET VC1A_HIST(a,i,NINDEX50)
                       GET Y1a(a,i,MINDEX50)

                       Tai(a,i)  = VC1A_HIST(a,i,NINDEX50)
                       T1ai(a,i) = Y1a(a,i,MINDEX50)

                       TMP   =  Tai(a,i) * T1ai(a,i)
                       SUMA +=  TMP

                  ENDPARDO a, i

                  EXECUTE SERVER_BARRIER
                  COLLECTIVE CY_A += SUMA

                  PARDO j, b

                       GET VC1b_HIST(b,j,NINDEX50)
                       GET Y1b(b,j,MINDEX50)

                       Tbj(b,j)  = VC1b_HIST(b,j,NINDEX50)
                       T1bj(b,j) = Y1b(b,j,MINDEX50)

                       TMP    =  Tbj(b,j) * T1bj(b,j)
                       SUMB   +=  TMP

                  ENDPARDO j, b
                  EXECUTE SERVER_BARRIER
                  COLLECTIVE CY_B += SUMB

                  CY_AB  = CY_A
                  CY_AB += CY_B

                  KCOUNT = 0.0
                  DO KINDEX50
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF

                  ENDDO KINDEX50

           ENDDO  MINDEX50

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
#bgn_debug
#     execute print_scalar imax
#end_debug

     ENDPROC SELECT_VECS
#    --------------------

     PROC FORM_SELECTED_Y
#    --------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, a

                 GET Y1a(a,i,NINDEX50)
                 Tai(a,i) = Y1a(a,i,NINDEX50)
                 PUT Y1a_PICKED(a,i) = Tai(a,i)

           ENDPARDO i, a
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO j, b

                 GET Y1b(b,j,NINDEX50)
                 Tbj(b,j) = Y1b(b,j,NINDEX50)
                 PUT Y1b_PICKED(b,j) = Tbj(b,j)

           ENDPARDO j, b
        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, i1, a1, a

                 REQUEST Y2aa(a,i1,a1,i,NINDEX50) i
                 Taiai(a,i1,a1,i) = Y2aa(a,i1,a1,i,NINDEX50)
                 PREPARE Y2aa_picked(a,i1,a1,i) = Taiai(a,i1,a1,i)

           ENDPARDO i, i1, a1, a

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO j, j1, b1, b

                 REQUEST Y2bb(b,j1,b1,j,NINDEX50) j
                 Tbjbj(b,j1,b1,j) = Y2bb(b,j1,b1,j,NINDEX50)
                 PREPARE Y2bb_picked(b,j1,b1,j) = Tbjbj(b,j1,b1,j)

           ENDPARDO j, j1, b1, b

        ENDIF
     ENDDO NINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT == IMAX

           PARDO i, j, b, a

                 REQUEST Y2ab(a,i,b,j,NINDEX50) j
                 Taibj(a,i,b,j) = Y2ab(a,i,b,j,NINDEX50)
                 PREPARE Y2ab_picked(a,i,b,j) = Taibj(a,i,b,j)

           ENDPARDO i, j, b, a

        ENDIF
     ENDDO NINDEX50

     EXECUTE SERVER_BARRIER 

     ENDPROC FORM_SELECTED_Y
#    -----------------------

     PROC FORM_HBAR_Y_VECS
#    ---------------------

      PARDO a, i
         GET Y1a_PICKED(a,i)
         Tai(a,i) = Y1a_PICKED(a,i)
         PUT VCACT1A(a,i) =  Tai(a,i)
      ENDPARDO a, i

      PARDO b, j
         GET Y1b_PICKED(b,j)
         Tbj(b,j) = Y1b_PICKED(b,j)
         PUT VCACT1B(b,j) = Tbj(b,j) 
      ENDPARDO b, j

      PARDO i, i1, a1, a
         REQUEST Y2aa_picked(a,i,a1,i1) i1
         Taiai(a,i,a1,i1) = Y2aa_picked(a,i,a1,i1)
         PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO i, i1, a1, a

      PARdO j, j1, b1, b
         REQUEST Y2bb_picked(b,j1,b1,j) j
         Tbjbj(b,j1,b1,j) = Y2bb_picked(b,j1,b1,j)
         PREPARE VCACT2BB(b,j1,b1,j) = Tbjbj(b,j1,b1,j)
      ENDPARDO j, j1, b1, b

      PARDO a,i,b,j
         REQUEST Y2ab_picked(a,i,b,j) j
         Taibj(a,i,b,j) = Y2ab_picked(a,i,b,j)
         PREPARE VCACT2AB(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, i, b, j
     
      EXECUTE SERVER_BARRIER 
   
      CALL HR_MULT

      PARDO a, i
         GET VCHACT1A(a,i)
         Tai(a,i) = VCHACT1A(a,i)
         PUT HY1A_PICKED(a,i) =  Tai(a,i)
      ENDPARDO a, i

      PARDO b, j
         GET VCHACT1B(b,j)
         Tbj(b,j) = VCHACT1B(b,j)
         PUT HY1b_PICKED(b,j) = Tbj(b,j) 
      ENDPARDO b, j

      PARDO i, i1, a1, a
         REQUEST VCHACT2AA(a,i,a1,i1) i1
         Taiai(a,i,a1,i1) = VCHACT2AA(a,i,a1,i1)
         PREPARE HY2aa_picked(a,i,a1,i1) = Taiai(a,i,a1,i1)
      ENDPARDO i, i1, a1, a

      PARDO j, j1, b1, b
         REQUEST VCHACT2BB(b,j1,b1,j) j
         Tbjbj(b,j1,b1,j) = VCHACT2BB(b,j1,b1,j)
         PREPARE HY2bb_picked(b,j1,b1,j) = Tbjbj(b,j1,b1,j)
      ENDPARDO j, j1, b1, b

      PARDO a,i,b,j
         REQUEST VCHACT2AB(a,i,b,j) j
         Taibj(a,i,b,j) = VCHACT2AB(a,i,b,j)
         PREPARE HY2ab_picked(a,i,b,j) = Taibj(a,i,b,j)
      ENDPARDO a, i, b, j

      EXECUTE SERVER_BARRIER 
     
     ENDPROC FORM_HBAR_Y_VECS
#    ------------------------

    PROC FORM_RESIDUAL_VEC
#   ----------------------

     EXECUTE RETURN_SELECTED A_DIAGS IMAX
     OMEGA   = IMAX
     OMEGAM  = OMEGA
     OMEGAM *= -1.0
#bgn_debug
#     execute print_scalar OMEGAM
#end_debug
     
     PARDO a, i
   
           GET HY1a_picked(a,i)
           GET Y1a_picked(a,i)

           Tai(a,i)   = HY1a_picked(a,i)
           T1ai(a,i)  = Y1a_picked(a,i)
           T1ai(a,i) *= Omegam
           Tai(a,i)  +=  T1ai(a,i)

           PUT RES1a(a,i) =  Tai(a,i)

     ENDPARDO a, i

     PARDO  b, j

            GET HY1b_picked(b,j)
            GET Y1b_picked(b,j)
            Tbj(b,j)   = HY1b_picked(b,j)
            T1bj(b,j)  = Y1b_picked(b,j)
            T1bj(b,j) *= Omegam
            Tbj(b,j)  += T1bj(b,j)

            PUT RES1b(b,j) =  Tbj(b,j)

     ENDPARDO  b, j

     PARDO i, i1, a1, a

         REQUEST HY2aa_picked(a,i1,a1,i) i
         REQUEST Y2aa_picked(a,i1,a1,i)  i

         Taiai(a,i1,a1,i)   = HY2aa_picked(a,i1,a1,i)
         T1aiai(a,i1,a1,i)  = Y2aa_picked(a,i1,a1,i)
         T1aiai(a,i1,a1,i) *= Omegam
         Taiai(a,i1,a1,i)  += T1aiai(a,i1,a1,i)

         PREPARE RES2aa(a,i1,a1,i) = Taiai(a,i1,a1,i)

     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b

         REQUEST HY2bb_picked(b,j,b1,j1) j1
         REQUEST Y2bb_picked(b,j,b1,j1)  j1

         Tbjbj(b,j,b1,j1)   = HY2bb_picked(b,j,b1,j1)
         T1bjbj(b,j,b1,j1)  = Y2bb_picked(b,j,b1,j1)
         T1bjbj(b,j,b1,j1) *= Omegam
         Tbjbj(b,j,b1,j1)  += T1bjbj(b,j,b1,j1)

         PREPARE RES2bb(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO a,i,b,j

        REQUEST HY2ab_picked(a,i,b,j) j
        REQUEST Y2ab_picked(a,i,b,j)  j

        Taibj(a,i,b,j)   = HY2ab_picked(a,i,b,j)
        T1aibj(a,i,b,j)  = Y2ab_picked(a,i,b,j)
        T1aibj(a,i,b,j) *= Omegam
        Taibj(a,i,b,j)  += T1aibj(a,i,b,j)

        PREPARE RES2ab(a,i,b,j) = Taibj(a,i,b,j)

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER 

    ENDPROC FORM_RESIDUAL_VEC
#   ------------------------

     PROC CHECK_CONVERGENCE
#    -----------------------
     SUMA  = 0.0
     SUMB  = 0.0
     SUMAA = 0.0
     SUMBB = 0.0
     SUMAB = 0.0
     HC_A  = 0.0
     HC_B  = 0.0
     HC_AA = 0.0
     HC_BB = 0.0
     HC_AB = 0.0

     PARDO i, a

           GET RES1a(a,i)

           Tai(a,i)   = RES1a(a,i)
           TMP   = Tai(a,i) * Tai(a,i) 
           SUMA += TMP

     ENDPARDO i, a

     PARDO j, b

           GET RES1b(b,j)

           Tbj(b,j)  = RES1b(b,j)
           TMP   = Tbj(b,j) * Tbj(b,j)
           SUMB += TMP

     ENDPARDO j, b

     PARDO i, i1, a1, a

           REQUEST RES2aa(a,i,a1,i1) i1

           Taiai(a,i,a1,i1)  = RES2aa(a,i,a1,i1)
           TMP     = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1) 
           TMP    *= 0.25
           SUMAA += TMP

     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b

           REQUEST RES2bb(b,j,b1,j1) j1

           Tbjbj(b,j,b1,j1)  = RES2bb(b,j,b1,j1)
           TMP     =  Tbjbj(b,j,b1,j1) * Tbjbj(b,j,b1,j1)
           TMP    *= 0.25
           SUMBB += TMP

     ENDPARDO j, j1, b1, b

     PARDO a, i, b, j

           REQUEST RES2ab(a,i,b,j) j

           Taibj(a,i,b,j)  = RES2ab(a,i,b,j)
           TMP     = Taibj(a,i,b,j) * Taibj(a,i,b,j)
           SUMAB += TMP

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER
     COLLECTIVE HC_A  += SUMA
     COLLECTIVE HC_B  += SUMB
     COLLECTIVE HC_AA += SUMAA
     COLLECTIVE HC_BB += SUMBB
     COLLECTIVE HC_AB += SUMAB

     A_VALUE  = HC_A
     A_VALUE += HC_B
     A_VALUE += HC_AA
     A_VALUE += HC_BB
     A_VALUE += HC_AB

     EXECUTE SIP_BARRIER

     HALF = 0.5
     EXECUTE SQUARE_ROOT A_VALUE HALF
     RESIDUAL_NORM = A_VALUE

     ENDPROC CHECK_CONVERGENCE
#    -------------------------

     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     PARDO a, i
           GET RES1a(a,i)
           GET VCONV1A(a,i)

           Tai(a,i)   = VCONV1A(a,i)
           T1ai(a,i)  = RES1a(a,i)

           Tai(a,i)  *= -1.0
           T2ai(a,i)  = OMEGA
           Tai(a,i)  += T2ai(a,i)

           EXECUTE APPLY_DEN2_NOR  T1ai Tai

           PUT CORR_VECa(a,i) =  T1ai(a,i)
     ENDPARDO a, i

     PARDO b, j
            GET RES1b(b,j)
            GET VCONV1B(b,j)

            Tbj(b,j)   = VCONV1B(b,j)
            T1bj(b,j)  = RES1b(b,j)

            Tbj(b,j)  *= -1.0
            T2bj(b,j)  = OMEGA
            Tbj(b,j)  += T2bj(b,j)

            EXECUTE APPLY_DEN2_NOR  T1bj Tbj

            PUT CORR_VECb(b,j) =  T1bj(b,j)

     ENDPARDO b, j

     PARDO i, i1, a1, a
         REQUEST RES2aa(a,i,a1,i1) i1
         REQUEST VCONV2AA(a,i,a1,i1) i1

         Taiai(a,i,a1,i1)  = VCONV2AA(a,i,a1,i1)
         T1aiai(a,i,a1,i1) = RES2aa(a,i,a1,i1)

         Taiai(a,i,a1,i1) *= -1.0
         T2aiai(a,i,a1,i1) = OMEGA
         Taiai(a,i,a1,i1)  += T2aiai(a,i,a1,i1)

         EXECUTE APPLY_DEN4 T1aiai Taiai

         PREPARE CORR_VECaa(a,i,a1,i1) = T1aiai(a,i,a1,i1)

     ENDPARDO i, i1, a1, a

     PARDO j, j1, b1, b
         REQUEST RES2bb(b,j,b1,j1) j1
         REQUEST VCONV2BB(b,j,b1,j1) j1

         Tbjbj(b,j,b1,j1)  = VCONV2BB(b,j,b1,j1)
         T1bjbj(b,j,b1,j1) = RES2bb(b,j,b1,j1)

         Tbjbj(b,j,b1,j1)  *= -1.0
         T2bjbj(b,j,b1,j1)  = OMEGA
         Tbjbj(b,j,b1,j1)  += T2bjbj(b,j,b1,j1)

         EXECUTE APPLY_DEN4 T1bjbj Tbjbj

         PREPARE CORR_VECbb(b,j,b1,j1) = T1bjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO a, i, b, j
        REQUEST RES2ab(a,i,b,j) j
        REQUEST VCONV2AB(a,i,b,j) j

        Taibj(a,i,b,j)   = VCONV2AB(a,i,b,j)
        T1aibj(a,i,b,j)  = RES2ab(a,i,b,j)

        Taibj(a,i,b,j)  *= -1.0
        T2aibj(a,i,b,j)  = OMEGA
        Taibj(a,i,b,j) += T2aibj(a,i,b,j)

        EXECUTE APPLY_DEN4 T1aibj Taibj

        PREPARE CORR_VECab(a,i,b,j) = T1aibj(a,i,b,j)

     ENDPARDO a, i, b, j

     EXECUTE SERVER_BARRIER

     ENDPROC FORM_CORRECTION_VEC
#    --------------------------

    PROC MAKE_ORTHO_COEFS
#   ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF

           PARDO i, a

                 GET VC1A_HIST(a,i,NINDEX50)
                 GET CORR_VECa(a,i)

                 Tai(a,i)  = VC1A_HIST(a,i,NINDEX50)
                 T1ai(a,i) = CORR_VECa(a,i)
                 TMP       =  Tai(a,i)  * T1ai(a,i)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, a

           PARDO j, b

                 GET VC1B_HIST(b,j,NINDEX50)
                 GET CORR_VECb(b,j)

                 Tbj(b,j)  = VC1B_HIST(b,j,NINDEX50)
                 T1bj(b,j) = CORR_VECb(b,j)
                 TMP          = Tbj(b,j) *  T1bj(b,j)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO j, b

           PARDO i, i1, a1, a

                 REQUEST VCACT2aa_HIST(a,i,a1,i1,NINDEX50) i1
                 REQUEST CORR_VECaa(a,i,a1,i1) i1

                 Taiai(a,i,a1,i1)  = VCACT2aa_HIST(a,i,a1,i1,NINDEX50)
                 T1aiai(a,i,a1,i1) = CORR_VECaa(a,i,a1,i1)

                 TMP     = Taiai(a,i,a1,i1) *  T1aiai(a,i,a1,i1) 
                 TMP    *= 0.25

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, i1, a1, a

           PARDO j, j1, b1, b

                 REQUEST VCACT2bb_HIST(b,j,b1,j1,NINDEX50) j1
                 REQUEST CORR_VECbb(b,j,b1,j1) j1

                 Tbjbj(b,j,b1,j1)  = VCACT2bb_HIST(b,j,b1,j1,NINDEX50)
                 T1bjbj(b,j,b1,j1) = CORR_VECbb(b,j,b1,j1)

                 TMP     = Tbjbj(b,j,b1,j1) *  T1bjbj(b,j,b1,j1)
                 TMP    *= 0.25

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO j, j1, b1, b

           PARDO i, a, b, j

                 REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
                 REQUEST CORR_VECab(a,i,b,j) j

                 Taibj(a,i,b,j)  = VCACT2AB_HIST(a,i,b,j,NINDEX50)
                 T1aibj(a,i,b,j) = CORR_VECab(a,i,b,j)

                 TMP     = Taibj(a,i,b,j)  * T1aibj(a,i,b,j)

                 T1xx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += T1xx(NINDEX50,NINDEX50)

           ENDPARDO i, a, b, j

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------
     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     SUMB   = 0.0
     SUMAA  = 0.0
     SUMBB  = 0.0
     SUMAB  = 0.0
     C_A    = 0.0
     C_B    = 0.0
     C_AA   = 0.0
     C_BB   = 0.0
     C_AB   = 0.0

     PARDO i, a

           GET CORR_VECa(a,i)
           Tai(a,i)   = CORR_VECa(a,i)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              GET VC1A_HIST(a,i,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ai(a,i)  = VC1A_HIST(a,i,NINDEX50)
              T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL T1xx FACT

              T1ai(a,i) *= FACT
              T1ai(a,i) *= -1.0
              Tai(a,i)  += T1ai(a,i)

           ENDDO NINDEX50

           PUT R1a_INTMD(a,i) = Tai(a,i)

           TMP    = Tai(a,i) * Tai(a,i)
           SUMA  += TMP

     ENDPARDO i, a

     EXECUTE SERVER_BARRIER
     COLLECTIVE C_A += SUMA

     PARDO j, b

          GET CORR_VECb(b,j)
          Tbj(b,j)  = CORR_VECb(b,j)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0

             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             GET VC1B_HIST(b,j,NINDEX50)
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bj(b,j) = VC1B_HIST(b,j,NINDEX50)
             T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL T1xx FACT

             T1bj(b,j) *= FACT
             T1bj(b,j) *= -1.0
             Tbj(b,j)  += T1bj(b,j)

          ENDDO NINDEX50

          PUT R1b_INTMD(b,j) = Tbj(b,j)

          TMP   = Tbj(b,j) * Tbj(b,j)
          SUMB += TMP

     ENDPARDO j, b

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_B += SUMB

     PARDO i, i1, a1, a

          REQUEST CORR_VECaa(a,i,a1,i1) i1
          Taiai(a,i,a1,i1)  = CORR_VECaa(a,i,a1,i1)

          NCOUNT = 0.0
          DO NINDEX50
             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST VCACT2AA_HIST(a,i,a1,i1,NINDEX50) i1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1aiai(a,i,a1,i1) = VCACT2AA_HIST(a,i,a1,i1,NINDEX50)
             T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL T1xx FACT

             T1aiai(a,i,a1,i1)  *= FACT
             T1aiai(a,i,a1,i1)  *= -1.0
             Taiai(a,i,a1,i1)   += T1aiai(a,i,a1,i1)

           ENDDO NINDEX50

           PREPARE R2_intmd_aa(a,i,a1,i1) = Taiai(a,i,a1,i1)

           TMP  =  Taiai(a,i,a1,i1) *  Taiai(a,i,a1,i1)
           SUMAA  += TMP

     ENDPARDO i, i1, a1, a

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_AA += SUMAA

     PARDO j, j1, b1, b

           REQUEST CORR_VECbb(b,j,b1,j1) j1
           Tbjbj(b,j,b1,j1)  = CORR_VECbb(b,j,b1,j1)

           NCOUNT = 0.0
           DO NINDEX50

             NCOUNT += 1.0
             IF NCOUNT > ITER_COUNT
                EXIT
             ENDIF

             REQUEST VCACT2BB_HIST(b,j,b1,j1,NINDEX50) j1
             GET ORTHO_COEF(NINDEX50,NINDEX50)

             T1bjbj(b,j,b1,j1) = VCACT2BB_HIST(b,j,b1,j1,NINDEX50)
             T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

             EXECUTE RETURN_SVAL T1xx FACT

             T1bjbj(b,j,b1,j1) *= FACT
             T1bjbj(b,j,b1,j1) *= -1.0
             Tbjbj(b,j,b1,j1) += T1bjbj(b,j,b1,j1)

           ENDDO NINDEX50

          PREPARE R2_intmd_bb(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

          TMP = Tbjbj(b,j,b1,j1) * Tbjbj(b,j,b1,j1)
          SUMBB += TMP

     ENDPARDO j, j1, b1, b

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_BB += SUMBB

     PARDO i, a, b, j

           REQUEST CORR_VECab(a,i,b,j) j
           Taibj(a,i,b,j)  = CORR_VECab(a,i,b,j)

           NCOUNT = 0.0
           DO NINDEX50

              NCOUNT += 1.0
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

              REQUEST VCACT2AB_HIST(a,i,b,j,NINDEX50) j
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1aibj(a,i,b,j) = VCACT2AB_HIST(a,i,b,j,NINDEX50)
              T1xx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL T1xx FACT

              T1aibj(a,i,b,j) *= FACT
              T1aibj(a,i,b,j) *= -1.0
              Taibj(a,i,b,j)  += T1aibj(a,i,b,j)

          ENDDO NINDEX50

          PREPARE R2_intmd_ab(a,i,b,j) = Taibj(a,i,b,j)

          TMP =  Taibj(a,i,b,j) *  Taibj(a,i,b,j)
          SUMAB += TMP

     ENDPARDO i, a, b, j

     EXECUTE SERVER_BARRIER
     COLLECTIVE   C_AB += SUMAB

     NORM_NEW_ORTGC  = C_A
     NORM_NEW_ORTGC += C_B
     NORM_NEW_ORTGC += C_AA
     NORM_NEW_ORTGC += C_BB
     NORM_NEW_ORTGC += C_AB

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

    PROC DRIVE_ORTHO
#   ----------------

     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT

    ENDPROC DRIVE_ORTHO
#   --------------------

     PROC RESCALE_NEW_C
#    ------------------

     SUMA   = 0.0
     SUMB   = 0.0
     SUMAA  = 0.0
     SUMBB  = 0.0
     SUMAB  = 0.0
     HC_A   = 0.0
     HC_B   = 0.0
     HC_AA  = 0.0
     HC_BB  = 0.0
     HC_AB  = 0.0

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i) = R1a_intmd(a,i)
            TMP   = Tai(a,i) * Tai(a,i)
            SUMA += TMP

      ENDPARDO i, a

      PARDO j, b

            GET  R1b_intmd(b,j)
            Tbj(b,j) =  R1b_intmd(b,j)
            TMP   = Tbj(b,j) * Tbj(b,j)
            SUMB += TMP

      ENDPARDO j, b

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)

              TMP    = Taiai(a,i,a1,i1) * Taiai(a,i,a1,i1)
              TMP   *= 0.25
              SUMAA += TMP

      ENDPARDO i, i1, a1, a

      PARDO j, j1, b1, b

              REQUEST R2_intmd_bb(b,j,b1,j1) j1
              Tbjbj(b,j,b1,j1) = R2_intmd_bb(b,j,b1,j1)

              TMP    = Tbjbj(b,j,b1,j1) * Tbjbj(b,j,b1,j1)
              TMP   *= 0.25
              SUMBB +=  TMP

     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j) = R2_intmd_ab(a,i,b,j)

              TMP    = Taibj(a,i,b,j) * Taibj(a,i,b,j)
              SUMAB +=  TMP

     ENDPARDO i, j, b, a

     EXECUTE SIP_BARRIER
     COLLECTIVE HC_A   += SUMA
     COLLECTIVE HC_B   += SUMB
     COLLECTIVE HC_AA  += SUMAA
     COLLECTIVE HC_BB  += SUMBB
     COLLECTIVE HC_AB  += SUMAB

     SUM_R  = HC_A
     SUM_R += HC_B
     SUM_R += HC_AA
     SUM_R += HC_BB
     SUM_R += HC_AB

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R
#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXECUTE SIP_BARRIER

     PARDO i, a

            GET  R1a_intmd(a,i)
            Tai(a,i)  = R1a_intmd(a,i)
            Tai(a,i) *= INV_SQRT_NORM_R
            PUT VCACT1A(a,i) = Tai(a,i)
      ENDPARDO i, a

      PARDO j, b

            GET  R1b_intmd(b,j)
            Tbj(b,j)  = R1b_intmd(b,j)
            Tbj(b,j) *= INV_SQRT_NORM_R
            PUT VCACT1B(b,j) = Tbj(b,j)

      ENDPARDO j, b

      PARDO i, i1, a1, a

              REQUEST R2_intmd_aa(a,i,a1,i1) i1
              Taiai(a,i,a1,i1) = R2_intmd_aa(a,i,a1,i1)
              Taiai(a,i,a1,i1) *= INV_SQRT_NORM_R
              PREPARE VCACT2AA(a,i,a1,i1) = Taiai(a,i,a1,i1)

      ENDPARDO i, i1, a1, a

      PARDO j, j1, b1, b

              REQUEST R2_intmd_bb(b,j,b1,j1) j1
              Tbjbj(b,j,b1,j1)  = R2_intmd_bb(b,j,b1,j1)
              Tbjbj(b,j,b1,j1) *= INV_SQRT_NORM_R
              PREPARE VCACT2BB(b,j,b1,j1) = Tbjbj(b,j,b1,j1)

     ENDPARDO j, j1, b1, b

     PARDO i, j, b, a

              REQUEST R2_intmd_ab(a,i,b,j) j
              Taibj(a,i,b,j)  = R2_intmd_ab(a,i,b,j)
              Taibj(a,i,b,j) *= INV_SQRT_NORM_R
              PREPARE VCACT2AB(a,i,b,j) =  Taibj(a,i,b,j)

     ENDPARDO i, j, b, a

     EXECUTE SERVER_BARRIER

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,a
#         get vcact1a(a,i)
#         tmp = vcact1a(a,i) * vcact1a(a,i)
#         tmpa += tmp
#      endpardo i,a
#      pardo j,b
#         get vcact1b(b,j)
#         tmp = vcact1b(b,j) * vcact1b(b,j)
#         tmpb += tmp
#      endpardo j,b
#      execute sip_barrier
#      collective suma +=tmpa
#      collective sumb +=tmpb
#      execute print_scalar suma
#      execute print_scalar sumb
