include ../../../../../GNUmakefile.chssi

#Compilers
FC=@FC@
CC=@CC@
CPP=@CXX@
SERIAL_CPP=@SERIAL_CPP@

#Compiler flags
FFLAGS=@FCFLAGS@
CFLAGS=@CFLAGS@
CPPFLAGS=@CXXFLAGS@

#ACESLIBS variable will be replaced by the autoconf script with appropriate libraries
LIBS = @ACESLIBS@
LIBS:= -lstdc++ -lsip1 -lsip2 -lsip_shared -lframelib -laces2 -lgeopt -lsymcor -laces2 -lerd -loed -ldup -lsip1 -lsip2 $(LIBS)

#ACESFLAGS variable will be replaced by the autoconf script with location of libraries
LIB_DIRS= @ACESFLAGS@

SIAL_COMPILER_LIBS= @SIAL_COMPILER_LIBS@


INCLUDE_DIRS := -I../../../../sia/include -I../aces2/include $(INCLUDE_DIRS)
LIB_DIRS:=-L../../../lib $(LIB_DIRS)

FSOURCE=$(wildcard *.F)
F_OBJS=$(FSOURCE:.F=.o)
fSOURCE=$(wildcard *.f)
f_OBJS:=$(fSOURCE:.f=.o)
cSOURCE=$(wildcard *.c)
c_OBJS:=$(cSOURCE:.c=.o)
CPP_SOURCE=$(wildcard *.cpp)
CPP_OBJS:=$(CPP_SOURCE:.cpp=.o)

OEDLIB=../../../../../lib/liboed.a

all: tabula_rasa $(OEDLIB)

tabula_rasa: ;
	rm -f make.out make.err

$(OEDLIB): liboedlib.a
	cp liboedlib.a $(OEDLIB)
	rm -f make.out make.err

liboedlib.a: $(F_OBJS) $(f_OBJS) $(c_OBJS)
	ar $(ARFLAGS) liboedlib.a $(F_OBJS) $(f_OBJS) $(c_OBJS)

libclean: ;
	rm -f liboedlib.a

ppclean clean distclean: % : tabula_rasa libclean
	rm -f *.o

rebuild: libclean $(FRAMELIB)

binclean relink archive: % : ;

.f.o:
	$(FC) -c $(FFLAGS) $(INCLUDE_DIRS) $< 1>>make.out 2>>make.err

.F.o:
	$(FC) -c $(FFLAGS) $(INCLUDE_DIRS) $< 1>>make.out 2>>make.err

.c.o:
	$(CC) -c $(CFLAGS) $(INCLUDE_DIRS) $< 1>>make.out 2>>make.err

# 2026-07-18/19: oed__ovl_prepare_ctr.F/oed__nai_prepare_ctr.F copy the NIJ
# exponential-prefactor array RHO into RHOAB, which their own header comments
# document can alias RHO in memory -- safe only if copied element-by-element
# in reverse (N=NIJ,1,-1). At -O2, ifx's loop-idiom recognition matches this
# reverse loop as a plain array-range copy regardless of direction and lowers
# it to a memcpy-family call, which assumes non-overlapping memory, silently
# corrupting data whenever RHO/RHOAB really do alias. -no-vec/-no-fma/
# -fp-model precise/-no-ansi-alias do NOT suppress it; only -O1 (or -O0)
# does. oed__kin_prepare_ctr.F has the identical vulnerable pattern but
# wasn't observed to misbehave in the cases tested -- included defensively.
# Verified fix bit-identical to the -O0 reference on the H2/STO-3G a3ecp
# probe; same fix already landed in ACES II's
# ~/Develop/ACESII_build/Makefiles/GNUmakefile.src (byte-identical source).
oed__ovl_prepare_ctr.o oed__nai_prepare_ctr.o oed__kin_prepare_ctr.o: FFLAGS += -O1

