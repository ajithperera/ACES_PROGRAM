#end_debug

     PARDO i, j
           GET HY1_AB_picked(i,j)
           GET Y1_AB_picked(i,j)

           Tij(i,j)   = HY1_AB_picked(i,j)
           T1ij(i,j)  = Y1_AB_picked(i,j)
           T1ij(i,j) *= Omegam
           Tij(i,j)  +=  T1ij(i,j) 
           PUT RES1_AB(i,j) =  Tij(i,j)
     ENDPARDO i, j

     EXECUTE SIP_BARRIER
