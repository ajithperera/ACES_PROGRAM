     PROC MAKE_ORTHO_COEFS
#    ---------------------

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0

        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF  

           PARDO i, j

                 GET R1_AB_HIST(i,j,NINDEX50)
                 GET CORR_VEC_AB(i,j)
                 
                 Tij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
                 T1ij(i,j) = CORR_VEC_AB(i,j)
                 TMP          = Tij(i,j) * T1ij(i,j)

                 Txx(NINDEX50,NINDEX50)         = TMP
                 PUT ORTHO_COEF(NINDEX50,NINDEX50) += Txx(NINDEX50,NINDEX50) 
                 
           ENDPARDO i, j

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER
#bgn_debug
#     do NINDEX50
#     do MINDEX50
#        GET ORTHO_COEF(NINDEX50,MINDEX50)
#        ETEMP(NINDEX50,MINDEX50) = ORTHO_COEF(NINDEX50,MINDEX50)
#     enddo MINDEX50
#     enddo NINDEX50
#     execute print_static ETEMP ITER_COUNT 
##end_debug

     ENDPROC MAKE_ORTHO_COEFS
#    ------------------------

     PROC GRAM_SCHMIDT
#    ----------------
     MCOUNT = 0.0
     SUMA   = 0.0
     C_A    = 0.0

     PARDO i, j
           GET CORR_VEC_AB(i,j)
           Tij(i,j)   = CORR_VEC_AB(i,j)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0
   
              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF 

              GET R1_AB_HIST(i,j,NINDEX50)
              GET ORTHO_COEF(NINDEX50,NINDEX50)

              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              Txx(NINDEX50,NINDEX50) = ORTHO_COEF(NINDEX50,NINDEX50)

              EXECUTE RETURN_SVAL Txx FACT

              T1ij(i,j) *= FACT
              T1ij(i,j) *= -1.0
              Tij(i,j)  += T1ij(i,j)

           ENDDO NINDEX50

           PUT R1_AB_INTMD(i,j) = Tij(i,j)

           TMP    = Tij(i,j) * Tij(i,j)
           SUMA  += TMP
                 
     ENDPARDO i, j

     EXECUTE SERVER_BARRIER 
     COLLECTIVE   C_A   += SUMA 
     EXECUTE SIP_BARRIER 

     NORM_NEW_ORTGC  = C_A

     EXPONENT = 0.5
     EXECUTE NORM_FAC NORM_NEW_ORTGC EXPONENT
     INV_SQRT_NORM_ORTGC  = NORM_NEW_ORTGC
     SQRT_OVERLAP         = EXPONENT

#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     ENDPROC GRAM_SCHMIDT
#    --------------------

     PROC DRIVE_ORTHO
#    ----------------
    
     CALL MAKE_ORTHO_COEFS
     CALL GRAM_SCHMIDT 

     ENDPROC DRIVE_ORTHO
#    -------------------

     PROC RESCALE_NEW_C
#    ------------------
     SUMA    = 0.0
     HC_A    = 0.0

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            HC_A += TMP

      ENDPARDO i, j

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     SUM_R  = SUMA

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_ORTGC  = SUM_R
     SQRT_OVERLAP         = EXPONENT
     
     EXECUTE SIP_BARRIER 
#bgn_debug
#     execute print_scalar INV_SQRT_NORM_ORTGC
#     execute print_scalar SQRT_OVERLAP 
#end_debug

     PARDO i, j
           GET R1_AB_intmd(i,j)

           Tij(i,j)  = R1_AB_intmd(i,j)
           Tij(i,j) *= INV_SQRT_NORM_ORTGC

           PUT R1_AB(i,j) =  Tij(i,j)
     ENDPARDO i, j

     EXECUTE SIP_BARRIER

#bgn_debug
      tmpa=0.0
      suma=0.0
      pardo i,j
         get r1_ab(i,j)
         tmp = r1_ab(i,j) * r1_ab(i,j)
         tmpa += tmp
      endpardo i,j
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
#end_debug

     ENDPROC RESCALE_NEW_C
#    ---------------------

     PROC SET_TO_ZERO
#    ----------------

     DO MINDEX50
        OVERLAP_R(MINDEX50)  = 0.0
        DO NINDEX50
           TS(MINDEX50,NINDEX50) = 0.0
           A_MATRIX(MINDEX50,NINDEX50)   = 0.0
           PUT ORTHO_COEF(MINDEX50,NINDEX50) = TS(MINDEX50,NINDEX50)
        ENDDO NINDEX50
     ENDDO MINDEX50
#
     DO NINDEX50 

     PARDO i, j
           tij(i,j)      = 0.0
           PUT Y1_AB(i,j,NINDEX50) = tij(i,j)
           PUT R1_AB_intmd(i,j) = tij(i,j)
     ENDPARDO i, j

     ENDDO NINDEX50 

     EXECUTE  SIP_BARRIER 

     ENDPROC SET_TO_ZERO
#    -------------------

     PROC REORDER_A_EIGS
#    -------------------
     
     DO MINDEX50
        DO NINDEX50
           IF MINDEX50  == NINDEX50
              TXX(MINDEX50,MINDEX50) = A_MATRIX(MINDEX50,MINDEX50)
              EXECUTE RETURN_SVAL TXX EIG_VALUE 
              A_DIAGS(MINDEX50)      = EIG_VALUE 
           ENDIF
         ENDDO NINDEX50
     ENDDO MINDEX50

     EXECUTE PROCESS_EIGS A_DIAGS DVECTORS 
     
     ENDPROC REORDER_A_EIGS
#    ----------------------

     PROC C_CHECK
#    -----------
     DO KINDEX50
        DO LINDEX50
           ETEMP(KINDEX50,LINDEX50) = 0.0
       ENDDO LINDEX50
     ENDDO KINDEX50

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > ITER_COUNT
                    EXIT
                 ENDIF 

                    SUMA   = 0.0
                    HC_A   = 0.0

                     PARDO i, j

                            GET R1_AB_HIST(i,j,NINDEX50)
                            GET R1_AB_HIST(i,j,MINDEX50)

                            Tij(i,j)   = R1_AB_HIST(i,j,NINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i,j

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     A_VALUE  = HC_A
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                                  ETEMP(MINDEX50,NINDEX50) = A_VALUE
                            ENDDO LINDEX50
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

#bgn_debug
     execute print_static etemp  iter_count 
#end_debug

     ENDPROC C_CHECK
#    ---------------

     PROC FORCE_TO_ZERO
#    ------------------

     PARDO i, j
         tij(i,j) = 0.0
         Put R1_AB(i,j) = tij(i,j)
     ENDPARDO i, j
     EXECUTE SIP_BARRIER 

     ENDPROC FORCE_TO_ZERO
#    --------------------

#     BEGIN MAIN PROGRAM
#     ------------------
# Read data from BLOCK_DATA -> to be partially replaced
# -----------------------------------------------------
#
     ZERO = 0.0
     ONE  = 1.0
     TARGET_ROOTS = EOM_ROOTS
     EOM_THRES    = EOM_TOL
     EOM_MAXCYC   = EE_MAXCYC
#
     CALL READ_DATA
     CALL CREATE_ARRAYS 
     CALL FORM_1HHP_DIAG

# The default iteration number is 30. Increase if desired.

     MAX_SUBSP_DIM  = EOM_MAXCYC
     Call FORM_INITIAL_GUESS

# The default denominator is 1P-Hbar and can be switched to Hbar
     
     MULT = ZERO 
     DO SPN_MULT

        MULT  += 1.0

        IF MULT == ONE
           SINGLET = ONE
           TRIPLET = ZERO
        ELSE
           SINGLET = ZERO
           TRIPLET = ONE
        ENDIF

        ROOT_COUNT = ZERO

      DO NROOTS

         ROOT_COUNT += 1.0
         IF ROOT_COUNT > TARGET_ROOTS
            EXIT
         ENDIF
#bgn_debug
        execute print_scalar ROOT_COUNT
#end_debug
         MYROOT = ROOT_COUNT 
         CALL PREP_DIP_GUESS
      
         ITER_COUNT = 0.0

         DO SUBSP_DIM

            CALL SET_TO_ZERO

            ITER_COUNT += 1.0
#bgn_debug
        execute print_scalar ITER_COUNT
#end_debug
            IF ITER_COUNT > MAX_SUBSP_DIM 
               EXIT
            ENDIF 

            CALL SAVE_C_VECTORS 
#bgn_debug
#            call c_check 
#end_debug
            CALL HR_MULT

            CALL SAVE_HC_VECTORS 

            IF ITER_COUNT == 1.0
               CALL FORM_A_MATRIX_11
            ELSE
              CALL FORM_A_MATRIX_IJ
              CALL FORM_A_MATRIX_JI
              CALL FORM_A_MATRIX_II
            ENDIF 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
          EXECUTE XGEEV A_MATRIX DVECTORS 
#bgn_debug
#            execute print_static A_MATRIX ITER_COUNT 
#end_debug
           IF ITER_COUNT != 1.0
              CALL REORDER_A_EIGS
           ENDIF 
#
# The eigen vectors are normalized and ordered in descending order of the
# eigenvalues. The corresponding eigenvalues are in the diagonal. 
#
           IF ITER_COUNT == 1.0
              CALL FORM_NEWVECS_ITR1
           ELSE

              CALL FORM_NEWVECS 

              CALL SELECT_VECS

              CALL FORM_SELECTED_Y
         
              CALL FORM_HBAR_Y_VECS

              CALL FORM_RESIDUAL_VEC

              CALL CHECK_CONVERGENCE
#bgn_debug
      execute print_scalar RESIDUAL_NORM
#end_debug
              IF RESIDUAL_NORM  < EOM_THRES
                EXIT
              ELSE
                CALL FORM_CORRECTION_VEC

                CALL DRIVE_ORTHO
         
                CALL RESCALE_NEW_C
              ENDIF 
   
           ENDIF 

         ENDDO SUBSP_DIM

         EXECUTE SERVER_BARRIER 
#bgn_debug
      execute print_scalar OMEGA 
#end_debug
         ITER_COUNT += -1.0
         IF ITER_COUNT == MAX_SUBSP_DIM
            IF RESIDUAL_NORM  > EOM_THRES
#
# The root under consideration could not be locates in 50 cycles.
# Lets set energy to zero and inform the user whart that means
#
                OMEGA = 0.0
                CALL FORCE_TO_ZERO 
             ENDIF 
         ENDIF 
             
         MCOUNT = 0.0
         DO MROOTS
            MCOUNT += 1.0
            IF MCOUNT == ROOT_COUNT
               DIP_SINGS_S(MROOTS) = OMEGA

               PARDO i, j
                   GET R1_AB(i,j) 
                   tij(i,j) = R1_AB(i,j)
                   Put DIPAB_GUESS_S(i,j,MROOTS) = tij(i,j)
               ENDPARDO i, j
            ENDIF 
         ENDDO MROOTS

     ENDDO NROOTS 

      EXECUTE SERVER_BARRIER 

#bgn_debug
      ROOT_COUNT -= 1.0
      execute print_static DIP_SINGS_S ROOT_COUNT 
#end_debug
       ENDDO SPN_MULT 

       EXECUTE BLOCKS_TO_LIST DIPAB_GUESS_S
       EXECUTE SERVER_BARRIER
       EXECUTE WRITE_BLOCKS_TO_LIST
       EXECUTE SERVER_BARRIER

                           ENDSIAL DIP_GUESS
#                          -----------------


