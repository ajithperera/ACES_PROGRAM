     PROC FORM_CORRECTION_VEC
#    ------------------------

#bgn_debug
#     execute print_scalar OMEGA
#end_debug

     PARDO i, j
           GET RES1_AB(i,j)
           GET D1_AB(i,j)

           Tij(i,j)   = D1_AB(i,j)
           T1ij(i,j)  = RES1_AB(i,j)

           Tij(i,j)  *= -1.0
           T2ij(i,j)  = Omega
           Tij(i,j)  += T2ij(i,j)

           EXECUTE APPLY_DEN2_NOR  T1ij Tij

           PUT CORR_VEC_AB(i,j) =  T1ij(i,j)

     ENDPARDO i, j

     EXECUTE SIP_BARRIER

