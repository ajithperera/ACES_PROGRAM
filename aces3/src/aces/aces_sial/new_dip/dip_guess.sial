     PROC SELECT_VECS
#    ----------------

     NCOUNT = 0.0

     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT  > 1.0
           EXIT
        ENDIF 

           MCOUNT = 0.0
           DO MINDEX50
              MCOUNT += 1.0
              IF MCOUNT >  ITER_COUNT
                 EXIT
              ENDIF

     	         SUMA   = 0.0
                 CY_A   = 0.0

                 PARDO i, j

                       GET R1_AB_HIST(i,j,NINDEX50)
                       GET Y1_AB(i,j,MINDEX50)

                       Tij(i,j)  = R1_AB_HIST(i,j,NINDEX50) 
                       T1ij(i,j) = Y1_AB(i,j,MINDEX50) 
               
                       TMP   = Tij(i,j) * T1ij(i,j)
                       SUMA +=  TMP
                       
                  ENDPARDO i, j

                  EXECUTE SIP_BARRIER
                  COLLECTIVE CY_A += SUMA
                       
                  CY_AB  = CY_A

                  KCOUNT = 0.0 
                  DO KINDEX50 
                     KCOUNT += 1.0

                     IF KCOUNT == MCOUNT 
                        OVERLAP_R(MINDEX50) = CY_AB
                     ENDIF 

                  ENDDO KINDEX50 

           ENDDO  MINDEX50

#        ENDIF

     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     EXECUTE RETURN_MAX_OVERLAP OVERLAP_R IMAX
#bgn_debug
#     execute print_scalar imax 
#end_debug

     ENDPROC SELECT_VECS
#    -------------------

