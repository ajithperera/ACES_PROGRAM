                        SIAL DIP_GUESS
#                       --------------

      index kiter    = 1, cc_iter
      index jj1      = 1, 1
      index kk1      = 1, 1
      index Spn_mult = 1, 2

      Index Ndim     = 1, 100
      Index Nroots   = 1, 12
      Index Mroots   = 1, 12
      Index Kroots   = 1, 12
      Index Subsp_dim= 1, 50
      Index Nindex50 = 1, 50
      Index Mindex50 = 1, 50
      Index Kindex50 = 1, 50
      Index Lindex50 = 1, 50
#
      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#
      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
#
      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt
#
      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
#
      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

#     CCSD amplitudes
#     ---------------
#
      distributed t1a(a,i)
      distributed t1b(b,j)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)
#
#     Transformed integrals
#     ---------------------
#
      served VSpipi(p,i,p1,i1)
      served VSqjqj(q,j,q1,j1)
      served Vpiqj(p,i,q,j)
      served VSaaai(a,a1,a2,i)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)
#
#     HBAR
#     ----
#
      distributed HBAR_AA(a,a1)
      distributed HBAR_BB(b,b1)
      distributed HBAR_II(i1,i)
      distributed HBAR_JJ(j1,j)
      distributed HBAR_IA(i,a)
      distributed HBAR_JB(j,b)

      distributed DDaa(a,a1)
      distributed DDii(i,i1)
      distributed DDia(i,a)
      distributed DDbb(b,b1)
      distributed DDjj(j,j1)

      distributed D1_AB(i,j)
#
      served HBAR_iiii(i,i1,i2,i3)
      served HBAR_jjjj(j,j1,j2,j3)
      served HBAR_iijj(i,i1,j,j1)
#
      Distributed R1_AB(i,j)
      Distributed R1_AB_guess(i,j)
      Distributed R1_AB_INTMD(i,j)
      Distributed R1_AB_HIST(i,j,subsp_dim)
      Distributed Y1_AB(i,j,subsp_dim)
      Distributed Y1_AB_picked(i,j)
      Distributed HY1_AB_picked(i,j)
      Distributed RES1_AB(i,j)
      Distributed HR1_AB(i,j)
      Distributed CORR_VEC_AB(i,j)
      Distributed HR1_AB_HIST(i,j,subsp_dim)
      Distributed ORTHO_COEF(NINDEX50,MINDEX50)
      Distributed DIPAB_GUESS_S(i,j,Nroots)

#     Temporary arrays
#     ---------------
#
      Temp Tij(i,j)
      Temp T1ij(i,j)
      Temp T2ij(i,j)
      Temp Tji(j,i)
      Temp Tpp(p,p1)

      Temp Tijia(i,j,i1,a)
      Temp T1ijia(i,j,i1,a)
      Temp Tijjb(i,j,j1,b) 
      Temp Tiijj(i,i2,j,j2)
      Temp T22ia(j2,i2)
      Temp T2ijia(i,j,i1,a)
      Temp T1ijjb(i,j,j1,b)
      Temp T2ijjb(i,j,j1,b)
      
      Temp Tmpijib(i2,j1,i,b) 
      Temp Tmpib(i,b) 
      Temp Tmpja(j,a)

      Temp Tqppq(q1,p1,p,q)
      Temp T1qppq(q1,p1,p,q)
      Temp Tpqpq(p,q,p1,q1)
      Temp T1pqpq(p,q,p1,q1)
      Temp Tpppp(p,p1,p2,p3)
      Temp T1pppp(p,p1,p2,p3)
      Temp T2pppp(p,p1,p2,p3)
      Temp T3pppp(p,p1,p2,p3)
      Temp T4pppp(p,p1,p2,p3)
      Temp Tqqqq(q,q1,q2,q3)
      Temp T1qqqq(q,q1,q2,q3)
      Temp T2qqqq(q,q1,q2,q3)
      Temp T3qqqq(q,q1,q2,q3)
      Temp T4qqqq(q,q1,q2,q3)

      Temp TiN(i,NROOTS)
      Temp TjN(j,NROOTS)
      Temp Tii(i,i1)
      Temp Tjj(j,j1)

      Temp Tip(i,nroots)
      Temp Tjp(j,nroots)
      Temp Tikk(i,kk1)
      Temp Tjkk(j,kk1)
      Temp T1ikk(i,kk1)
      Temp T1jkk(j,kk1)
      Temp Taiki(a,i,kk1,i1)
      Temp Tbjkj(b,j,kk1,j1)
      Temp Taikj(a,i,kk1,j)
      Temp Tbjki(b,j,kk1,i)
      Temp T1aiki(a,i,kk1,i1)
      Temp T1bjkj(b,j,kk1,j1)
      Temp T1aikj(a,i,kk1,j)
      Temp T1bjki(b,j,kk1,i)
      Temp T2ikk(i,kk1)
      Temp T2jkk(j,kk1)
      Temp Tix(i,kk1)
      Temp Tjx(j,kk1)
      Temp T1ix(i,kk1)
      Temp T1jx(j,kk1)
      Temp Taixi(a,i,kk1,i1)
      Temp Tbjxj(b,j,kk1,j1)
      Temp Taixj(a,i,kk1,j)
      Temp Tbjxi(b,j,kk1,i)
      Temp Tax(a,kk1)
      Temp Tbx(b,kk1)
      Temp Tiiii(i3,i1,i2,i)
      Temp T1aixi(a,i,kk1,i1)
      Temp Tjjjj(j3,j1,j2,j)
      Temp T1bjxj(b,j1,kk1,j)
      Temp Tjjii(j1,j,i1,i)
      Temp TS(MINDEX50,NINDEX50)
      Temp Tijs(i,j,MINDEX50)
      Temp T1ijs(i,j,NINDEX50)
      Temp Tijias(i,j,i1,a,subsp_dim)
      Temp T1ijias(i,j,i1,a,subsp_dim)
      Temp Tijjbs(i,j,j1,b,subsp_dim)
      Temp T1ijjbs(i,j,j1,b,subsp_dim)

      Temp Taa(a,a1)
      Temp Tbb(b,b1)
      Temp Tis(i,kk1)
      Temp T1is(i,kk1)
      Temp T2is(i,kk1)
      Temp Tjs(j,kk1)
      Temp T1js(j,kk1)
      Temp T2js(j,kk1)
      Temp Tiaix(i2,a,i,kk1)
      Temp T1iaix(i2,a,i,kk1)
      Temp T2aixi(a2,i,kk1,i1)
      Temp Tjbjx(j2,b,j,kk1)
      Temp T2bjxj(b2,j,kk1,j1)
      Temp T1aixj(a,i,kk1,j1)
      Temp Tiajx(i2,a,j1,kk1)
      Temp T2aixj(a2,i,kk1,j1)
      Temp Tibjx(i2,b,j,kk1)
      Temp T1bjxi(b,j,kk1,i1)
      Temp Tjxi(b,j,kk1,i1)
      Temp Tjbix(j2,b,i1,kk1)
      Temp T2bjxi(b,j,kk1,i1)
      Temp Taaii(a,a2,i1,i3)
      Temp T1iaxi(i,a2,kk1,i3)
      Temp Tbbjj(b,b2,j1,j3)
      Temp T1jbxj(j,b2,kk1,j3)
      Temp Tjaix(j2,a,i,kk1)
      Temp T2aiki(a,i,kk1,i1)
      Temp T2bjkj(b,j1,kk1,j)
      Temp T2aikj(a,i,kk1,j)
      Temp T2bjki(b,j,kk1,i)
      Temp Txx(NINDEX50,NINDEX50)
      Temp T3aixi(a,i1,kk1,i) 
      Temp T3bjxj(b,j1,kk1,j)
      Temp Taajj(a,a1,j,j1)
      Temp Tbbii(b,b1,i,i1)
      Temp T1ijij(i,j,i1,j1)

#     Static arrays
#     -------------
#
      Static RVEC_AA_INTMD(i,Nroots)
      Static RVEC_BB_INTMD(j,Nroots)
      Static A_MATRIX(mindex50,nindex50)
      Static INIT_RVEC_AB(i,j)
      Static A_DIAGS(MINDEX50)
      Static DVECTORS(mindex50,nindex50)
      Static OVERLAP_R(Nindex50)
      Static Sdii(i,i1)
      Static Sii(i,i1)
      Static Saa(a,a1)
      Static Sdaa(a,a1)
      Static Sdjj(j,j1)
      Static Sjj(j,j1)
      Static Sbb(b,b1)
      Static Sdbb(b,b1)
      Static ETEMP(mindex50,nindex50)
      Static DIP_SINGS_S(MROOTS)
      Static DIP_INIT_IJIJ(i,j,i1,j1)
      Static DIP_INIT_IJ(i,j)
      Static VEC_AB(i,j,NROOTS)

#     Scalar arrays
#     -------------
#     
      Scalar ROOT_COUNT
      Scalar TARGET_ROOTS
      Scalar EOM_THRES
