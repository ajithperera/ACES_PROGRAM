# -----------------------------------------------------------

      PROC READ_DATA
#     --------------
#
      create t1a
      create t1b
      create HBAR_AA
      create HBAR_BB
      create HBAR_II
      create HBAR_JJ
      create HBAR_IA
      create HBAR_JB

      execute sip_barrier
      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vbbii
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
#
      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb
#
      execute list_to_blocks                HBAR_AA
      execute list_to_blocks                HBAR_BB
      execute list_to_blocks                HBAR_II
      execute list_to_blocks                HBAR_JJ
      execute list_to_blocks                HBAR_IA
      execute list_to_blocks                HBAR_JB
#
      execute list_to_blocks                HBAR_IIII
      execute list_to_blocks                HBAR_JJJJ
      execute list_to_blocks                HBAR_IIJJ
#
      execute server_barrier
      execute read_list_to_blocks
      execute server_barrier
#
      ENDPROC READ_DATA
#     -----------------

      PROC CREATE_ARRAYS
#     --------------------

      CREATE R1_AB
      CREATE HR1_AB
      CREATE DDII
      CREATE DDJJ
      CREATE DDAA
      CREATE DDBB
      CREATE D1_AB
      CREATE R1_AB_HIST
      CREATE HR1_AB_HIST
      CREATE Y1_AB
      CREATE Y1_AB_PICKED
      CREATE HY1_AB_PICKED
      CREATE RES1_AB
      CREATE CORR_VEC_AB
      CREATE ORTHO_COEF
      CREATE R1_AB_INTMD
      CREATE DIPAB_GUESS_S

      EXECUTE SIP_BARRIER 

      ENDPROC CREATE_ARRAYS
#     --------------------

      PROC FORM_INITIAL_GUESS
#     -----------------------

      DO i
      DO j
          GET  HBAR_jj(i,j)
          tij(i,j)  = HBAR_jj(i,j)
          tij(i,j)  *= -1.0
          DIP_INIT_IJ(i,j) = tij(i,j)
      ENDDO j
      ENDDO i

      DO i
      DO i1
      DO j
      DO j1
         T1ijij(i,j,i1,j1) = 0.0
         DIP_INIT_IJIJ(i,j,i1,j1) =  T1ijij(i,j,i1,j1)
      ENDDO j1
      ENDDO j
      ENDDO i1
      ENDDO i

      EXECUTE SIP_BARRIER

      EXECUTE FORM_DIP_HMAT DIP_INIT_IJIJ DIP_INIT_IJ
      EXECUTE FORM_DIP_GUESS DIP_INIT_IJIJ VEC_AB

      ENDPROC FORM_INITIAL_GUESS
#     --------------------------

      PROC PREP_DIP_GUESS
#     -------------------

     EXECUTE GUESS_4CURRENT_ROOT VEC_AB MYROOT
     IF TRIPLET == ONE
          MYROOT *= -1.0
      ENDIF
      EXECUTE GUESS_4CURRENT_ROOT VEC_AB MYROOT
#
# Always copy the position one because the above SIP copies the
# the guess for the current root to position one.

      DO KROOTS

         COUNTER += 1.0
         IF COUNTER == ONE

            PARDO i,j
                Tij(i,j) =  VEC_AB(i,j,KROOTS)
                PUT R1_AB_intmd(i,j) =  Tij(i,j)
            ENDPARDO i,j

         ENDIF

      ENDDO KROOTS
      EXECUTE SIP_BARRIER
#bgn_debug
      tmpa = 0.0
      suma = 0.0
      pardo i, j
         get R1_ab_intmd(i,j)
         Tij(i,j) = R1_ab_intmd(i,j)
         tmp  =  Tij(i,j) * Tij(i,j)
         tmpa += tmp
      endpardo i,j
      execute sip_barrier 
      collective suma+=tmpa
      execute print_scalar suma
#end_debug
#
      SUMA = 0.0
      TMPA = 0.0
      PARDO i, j

            GET  R1_AB_intmd(i,j) 
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            TMPA += TMP
      ENDPARDO i, j

      EXECUTE SIP_BARRIER 
      COLLECTIVE  SUMA += TMPA

      SUMAB  = SUMA

      EXPONENT = 0.5
      EXECUTE NORM_FAC SUMAB EXPONENT
      INV_SQRT_NORM_R = SUMAB 
      NORM_R = SUMAB 

      PARDO i, j
            GET  R1_AB_intmd(i,j)
            Tij(i,j)  = R1_AB_intmd(i,j)
            Tij(i,j) *= INV_SQRT_NORM_R
            PUT R1_AB(i,j)  = Tij(i,j) 
      ENDPARDO i, j

      EXECUTE SIP_BARRIER 

#bgn_debug
#      tmpb=0.0
#      tmpa=0.0
#      suma=0.0
#      sumb=0.0
#      pardo i,j
#         get r1_ab(i,j) 
#         Tmp = r1_ab(i,j) * r1_ab(i,j)
#         tmpa += tmp
#      endpardo i,j
#      execute server_barrier 
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

      ENDPROC PREP_DIP_GUESS
#     ----------------------

    PROC FORM_1HHP_DIAG
#   -------------------
#
# -----prepare f_ii diagonal = DDii
#
     PARDO i, i1
#
           GET              HBAR_ii(i1,i)
           Sii(i1,i)      = HBAR_ii(i1,i)
           execute return_diagonal Sii Sdii
           tii(i1,i)      = Sdii(i1,i)
           put DDii(i1,i) = tii(i1,i)
#
     ENDPARDO i, i1
#
# -----prepare f_jj diagonal = DDjj
#
     PARDO j, j1
#
        GET              HBAR_jj(j1,j)
        Sjj(j1,j)      = HBAR_jj(j1,j)
        execute return_diagonal Sjj Sdjj
        tjj(j1,j)      = Sdjj(j1,j)
        put DDjj(j1,j) = tjj(j1,j)
#
     ENDPARDO j, j1

     execute sip_barrier 
#
     PARDO i, j
#
           tij(i,j)=0.0
#
           do i1
#
              get          DDii(i1,i)
              t1ij(i1,j)  = 1.0
              tii(i,i1)  = DDii(i1,i)
#            
              t2ij(i,j)  = tii(i,i1)*t1ij(i1,j)
              tij(i,j)  += t2ij(i,j)
#
           enddo i1
#
           do j1
#
              get          DDjj(j1,j)
              tji(j1,i) = 1.0
              tjj(j1,j)  = DDjj(j1,j)
#
              t2ij(i,j)  = tjj(j1,j)*tji(j1,i)
              tij(i,j)  += t2ij(i,j)
#
           enddo j1

           PUT D1_AB(i,j) += tij(i,j)
#
     ENDPARDO i, j
#
     execute sip_barrier 

#bgn_debug
#      tmpa =0.0
#      suma =0.0
#      pardo i,j
#            get  d1_ab(i,j)
#            tmp = d1_ab(i,j) * d1_ab(i,j)
#            tmpa += tmp
#      endpardo i, j
#      execute sip_barrier
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

    ENDPROC FORM_1HHP_DIAG
#   ----------------------

      PROC HR_MULT
#     ------------
#
# Zero out HR arrays
# ------------------
#
      PARDO i, j
            tij(i,j)      = 0.0
            PUT HR1_AB(i,j) = tij(i,j)
      ENDPARDO i, j
      execute sip_barrier 

#     ------------
# P(i/j1)R(i,j1)Hbar(j1,j)
#

      PARDO i, j, j1
            GET                   R1_AB(i,j1)
            GET                   HBAR_jj(j1,j)
            t1ij(i,j)           = R1_AB(i,j1)*HBAR_jj(j1,j)
            t1ij(i,j)          *= -1.0
            PUT HR1_AB(i,j) += t1ij(i,j)
      ENDPARDO i, j, j1
#
      PARDO i, j, i1
            GET                   R1_AB(i1,j)
            GET                   HBAR_ii(i1,i)
            t1ij(i,j)           = R1_AB(i1,j)*HBAR_ii(i1,i)
            t1ij(i,j)          *= -1.0
            PUT HR1_AB(i,j) += t1ij(i,j)
      ENDPARDO i, j, i1
#
# R(i1,j1)Hbar(i1j1,ij)
#

      PARDO i, i1, j, j1
            GET                    R1_AB(i1,j1)
            REQUEST                HBAR_iijj(i1,i,j1,j) j
            tij(i,j)            =  HBAR_iijj(i1,i,j1,j)*R1_AB(i1,j1)
            PUT HR1_AB(i,j) += tij(i,j)
      ENDPARDO i, i1, j, j1

      execute sip_barrier

      ENDPROC HR_MULT
#     ---------------

      PROC SAVE_C_VECTORS 
#     ------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0
         
         IF NCOUNT == ITER_COUNT

            PARDO i, j
                  GET R1_AB(i,j) 
                  Tij(i,j) = R1_AB(i,j)
                  PUT R1_AB_HIST(i,j,NINDEX50) = Tij(i,j) 
            ENDPARDO i, j

         ENDIF 

      ENDDO NINDEX50 

      EXECUTE SERVER_BARRIER 

      ENDPROC SAVE_C_VECTORS 
#     ---------------------

      PROC SAVE_HC_VECTORS
#     --------------------

      NCOUNT = 0.0
      DO NINDEX50
         NCOUNT += 1.0

         IF NCOUNT == ITER_COUNT

            PARDO i, j
                  GET HR1_AB(i,j)
                  Tij(i,j) = HR1_AB(i,j)
                  PUT HR1_AB_HIST(i,j,NINDEX50) = Tij(i,j)
            ENDPARDO i, j

         ENDIF

      ENDDO NINDEX50

      EXECUTE SERVER_BARRIER

     ENDPROC SAVE_HC_VECTORS
#    -----------------------

     PROC FORM_A_MATRIX_11
#    ----------------------

     SUMA   = 0.0
     SUMB   = 0.0
     HC_A   = 0.0
     HC_B   = 0.0

#bgn_debug
#      tmpa=0.0
#      tmpb=0.0
#      suma=0.0
#      sumb=0.0
#      ncount = 0.0
#      do nindex50
#      ncount += 1.0
#      if ncount == iter_count
#      pardo i,j
#         get hr1_AB_hist(i,j,nindex50)
#         tmp =  hr1_AB_hist(i,j,nindex50) *  hr1_AB_hist(i,j,nindex50)
#         tmpa += tmp
#      endpardo i,j
#      collective suma +=tmpa
#      execute print_scalar suma
#end_debug

     IF ITER_COUNT == 1.0

# Build A(1,1) for the first iteraion

        NCOUNT = 0.0
        DO NINDEX50 
           NCOUNT += 1.0
           IF NCOUNT == ITER_COUNT

              MCOUNT = 0.0
              DO MINDEX50 
                 MCOUNT += 1.0
                 IF MCOUNT == ITER_COUNT 

                    PARDO i, j

                          GET HR1_AB_HIST(i,j,NINDEX50)
                          GET R1_AB_HIST(i,j,MINDEX50) 

                          Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
                          T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                          TMP   = Tij(i,j) * T1ij(i,j)
                          SUMA += TMP

                    ENDPARDO i, j

                    EXECUTE SERVER_BARRIER 
                    COLLECTIVE HC_A += SUMA
                    COLLECTIVE HC_B += SUMB

                 ENDIF

              ENDDO MINDEX50 
           ENDIF

        ENDDO NINDEX50

      ENDIF 
#
# In iteration one there are no contributions from R1AAA, R1BBB.. since
# those are zero at the start. Note that HR1AAA are non-zero but the 
# overlap is still zero.
         
     A_VALUE  = HC_A
     A_VALUE += HC_B
#bgn_debug
#     execute print_scalar A_value 
#end_debug

     NCOUNT = 0.0
     MCOUNT = 0.0

     DO NINDEX50
         NCOUNT += 1.0
         IF NCOUNT == 1.0

            DO MINDEX50 
               MCOUNT += 1.0
               IF MCOUNT == 1.0
  
                   A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                ENDIF 
             ENDDO MINDEX50
         ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC FORM_A_MATRIX_11
#    -------------------------

     PROC FORM_A_MATRIX_IJ
#    ----------------------

# Built A_kj where k=1, ..j-1, <C_k | (HC_k)_j>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT > NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    HC_A   = 0.0

                    PARDO i, j

                            GET HR1_AB_HIST(i,j,NINDEX50)
                            GET R1_AB_HIST(i,j,MINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,MINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i, j

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     A_VALUE  = HC_A
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(MINDEX50,NINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_IJ
#    -------------------------

     PROC FORM_A_MATRIX_JI
#    ----------------------

# Built A_jk where k=1, ..j-1, <(HC_k)_j | C_k>

     NCOUNT = 0.0
     DO NINDEX50
        NCOUNT += 1.0
        IF NCOUNT > ITER_COUNT
           EXIT
        ENDIF
        
              MCOUNT = 0.0
              DO MINDEX50  
                 MCOUNT += 1.0
 
                 IF MCOUNT >= NCOUNT
                    EXIT
                 ENDIF 

                 IF MCOUNT == ITER_COUNT 
                    IF NCOUNT == ITER_COUNT
                       EXIT
                    ENDIF 
                 ENDIF 

                    SUMA   = 0.0
                    HC_A   = 0.0

                    PARDO i, j

                            GET HR1_AB_HIST(i,j,MINDEX50)
                            GET R1_AB_HIST(i,j,NINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,MINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                     ENDPARDO i, j

                     EXECUTE SERVER_BARRIER
                     COLLECTIVE HC_A   += SUMA
                     A_VALUE  = HC_A
 
                     KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50

#                 ENDIF 
              ENDDO MINDEX50
#        ENDIF
     ENDDO NINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_JI
#    -------------------------

     PROC  FORM_A_MATRIX_II
#    ----------------------

     SUMA   = 0.0
     HC_A   = 0.0

     MCOUNT = 0.0
     DO MINDEX50
        MCOUNT += 1.0
        IF MCOUNT == ITER_COUNT

              NCOUNT = 0.0
              DO NINDEX50
                 NCOUNT += 1.0
                 IF NCOUNT == MCOUNT

                    PARDO i, j

                            GET HR1_AB_HIST(i,j,MINDEX50)
                            GET R1_AB_HIST(i,j,NINDEX50)

                            Tij(i,j)   = HR1_AB_HIST(i,j,MINDEX50)
                            T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)

                            TMP   = Tij(i,j) * T1ij(i,j)
                            SUMA += TMP

                   ENDPARDO i, j

                   EXECUTE SERVER_BARRIER
                   COLLECTIVE HC_A   += SUMA
                   A_VALUE  = HC_A

                   KCOUNT = 0.0
                     DO KINDEX50
                         KCOUNT += 1.0
                         IF KCOUNT  == NCOUNT

                            LCOUNT = 0.0
                            DO LINDEX50
                               LCOUNT += 1.0
                               IF LCOUNT == MCOUNT

                                  A_MATRIX(NINDEX50,MINDEX50) = A_VALUE

                               ENDIF
                            ENDDO LINDEX50
                         ENDIF
                     ENDDO KINDEX50
                ENDIF 
              ENDDO NINDEX50 
       ENDIF 

     ENDDO MINDEX50

     EXECUTE SIP_BARRIER 

     ENDPROC  FORM_A_MATRIX_II
#    -------------------------

     PROC FORM_NEWVECS_ITR1
#    ----------------------

     OMEGA0   = A_VALUE 
     OMEGA0M  = A_VALUE 
     OMEGA0M *= -1.0
#bgn_debug
#     execute print_scalar OMEGA0M
#end_debug

# First the residual vector for iteration 1
     
     PARDO i, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET HR1_AB_HIST(i,j,NINDEX50)
              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = HR1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j) *= OMEGA0M
              Tij(i,j)  += T1ij(i,j)
 
              PUT RES1_AB(i,j) = Tij(i,j)

           ENDDO NINDEX50
     ENDPARDO i, j

     EXECUTE SIP_BARRIER 

# Now the correction vector for iteration 1

     PARDO i, j
           GET RES1_AB(i,j)
           GET D1_AB(i,j)

           Tij(i,j)   = D1_AB(i,j)
           T1ij(i,j)  = RES1_AB(i,j)

           Tij(i,j)  *= -1.0
           T2ij(i,j)  = OMEGA0
           Tij(i,j)  += T2ij(i,j)

           EXECUTE APPLY_DEN2_NOR  T1ij Tij

           PUT CORR_VEC_AB(i,j) =  T1ij(i,j)
     ENDPARDO i, j

     EXECUTE SIP_BARRIER

# Orthognalize to the Guess vector; first get the norm.

     SUMA   = 0.0
     HC_A   = 0.0

     PARDO i, j
           GET CORR_VEC_AB(i,j)

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = CORR_VEC_AB(i,j) 
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              TMP   = Tij(i,j) * T1ij(i,j) 
              SUMA += TMP

           ENDDO NINDEX50
     ENDPARDO i, j

     EXECUTE SIP_BARRIER
     COLLECTIVE  HC_A += SUMA
#
# There are no contribution from the doubles since the starting doubles
# are zero.

     NORM_GHG  = HC_A
#
# Orthogonalization  (i.e. <G|HG> = 0.0) (G=Guess vectors)
#
     PARDO i, j

           GET CORR_VEC_AB(i,j)
           Tij(i,j) = 0.0

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > 1.0
                 EXIT
              ENDIF

              GET R1_AB_HIST(i,j,NINDEX50)

              Tij(i,j)   = CORR_VEC_AB(i,j) 
              T1ij(i,j)  = R1_AB_HIST(i,j,NINDEX50)
              T1ij(i,j) *= NORM_GHG
              T1ij(i,j) *= -1.0
              Tij(i,j)  += T1ij(i,j)

           ENDDO NINDEX50

          PUT R1_AB_intmd(i,j) = Tij(i,j)
     ENDPARDO i, j

     EXECUTE SIP_BARRIER 

# Final normalization 

     SUMA    = 0.0
     HC_A    = 0.0

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            TMP   = Tij(i,j) * Tij(i,j)
            HC_A += TMP

      ENDPARDO i, j

     EXECUTE SIP_BARRIER
     COLLECTIVE  SUMA    += HC_A
     SUM_R  = SUMA

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXPONENT = 0.5
     EXECUTE NORM_FAC SUM_R EXPONENT
     INV_SQRT_NORM_R = SUM_R

#bgn_debug
#     execute print_scalar SUM_R
#end_debug

     EXECUTE SIP_BARRIER 

     PARDO i, j

            GET  R1_AB_intmd(i,j)
            Tij(i,j) = R1_AB_intmd(i,j)
            Tij(i,j) *= INV_SQRT_NORM_R
            PUT R1_AB(i,j) = Tij(i,j) 

      ENDPARDO i, j

     EXECUTE SIP_BARRIER
#
#bgn_debug
      tmpb=0.0
      suma=0.0
      pardo i,j
         get r1_ab(i,j)
         tmp = r1_ab(i,j) * r1_ab(i,j)
         tmpa += tmp
      endpardo i,j
      execute sip_barrier
      collective suma +=tmpa
      execute print_scalar suma
#end_debug

     ENDPROC FORM_NEWVECS_ITR1
#    -------------------------

     PROC FORM_NEWVECS
#    ------------------
     PARDO i, j

           NCOUNT = 0.0
           DO NINDEX50
              NCOUNT += 1.0

              IF NCOUNT > ITER_COUNT
                 EXIT
              ENDIF

                 MCOUNT = 0.0
                 DO MINDEX50
                    MCOUNT += 1.0

                    IF MCOUNT > ITER_COUNT 
                       EXIT
                    ENDIF

                       TS(MINDEX50,NINDEX50) = DVECTORS(MINDEX50,NINDEX50)
                       GET R1_AB_HIST(i,j,MINDEX50)
                       Tijs(i,j,MINDEX50)  = R1_AB_HIST(i,j,MINDEX50)
                       T1ijs(i,j,NINDEX50) = Tijs(i,j,MINDEX50) * TS(MINDEX50,NINDEX50)
                       PUT Y1_AB(i,j,NINDEX50) += T1ijs(i,j,NINDEX50)

                 ENDDO  MINDEX50
           ENDDO NINDEX50
     ENDPARDO i, j

     EXECUTE SIP_BARRIER 

#bgn_debug
