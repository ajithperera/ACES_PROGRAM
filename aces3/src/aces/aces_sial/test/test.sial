#               TXBXI(MU,B,NU,I) += T1XBXI(MU,B,NU,I)
#            ENDDO LAMBDA
#            PREPARE VXBXI(MU,B,NU,I) += TXBXI(MU,B,NU,I)
#         ENDDO B
#
#     ENDPARDO MU, NU, I
#
#     PARDO MU, NU, J
#
#         DO LAMBDA
#            REQUEST  VXXXJ(MU,NU,LAMBDA,J) J
#            L1XXXJ(MU,NU,LAMBDA,J) = VXXXJ(MU,NU,LAMBDA,J)
#         ENDDO LAMBDA
#
#         DO B
#            TXXBJ(MU,NU,B,J) = 0.0
#            DO LAMBDA
#               T1XXBJ(MU,NU,B,J) = L1XXXJ(MU,NU,LAMBDA,J) * CB(LAMBDA,B)
#               TXXBJ(MU,NU,B,J) += T1XXBJ(MU,NU,B,J)
#            ENDDO LAMBDA
#            PREPARE VXXBJ(MU,NU,B,J) += TXXBJ(MU,NU,B,J)
#         ENDDO B
#
#     ENDPARDO MU, NU, J
#
#     PARDO MU, NU, J
#
#         DO LAMBDA
#            REQUEST  VXXXJ(MU,LAMBDA,NU,J) J
#            L1XXXJ(MU,LAMBDA,NU,J) = VXXXJ(MU,LAMBDA,NU,J)
#         ENDDO LAMBDA
#
#         DO B
#            TXBXJ(MU,B,NU,J) = 0.0
#            DO LAMBDA
#               T1XBXJ(MU,B,NU,J) = L1XXXJ(MU,LAMBDA,NU,J) * CB(LAMBDA,B)
#               TXBXJ(MU,B,NU,J) += T1XBXJ(MU,B,NU,J)
#            ENDDO LAMBDA
#            PREPARE VXBXJ(MU,B,NU,J) = TXBXJ(MU,B,NU,J)
#         ENDDO B
#
#     ENDPARDO MU, NU, J
#
#     PARDO MU, NU, J
#
#         DO LAMBDA
#            REQUEST  VXXXJ(MU,LAMBDA,NU,J) J
#            L1XXXJ(MU,LAMBDA,NU,J) = VXXXJ(MU,LAMBDA,NU,J)
#         ENDDO LAMBDA
#
#         DO A
#            TXAXJ(MU,A,NU,J) = 0.0
#            DO LAMBDA
#               T1XAXJ(MU,A,NU,J) = L1XXXJ(MU,LAMBDA,NU,J) * CA(LAMBDA,A)
#               TXAXJ(MU,A,NU,J) += T1XAXJ(MU,A,NU,J)
#            ENDDO LAMBDA
#            PREPARE VXAXJ(MU,A,NU,J) = TXAXJ(MU,A,NU,J)
#         ENDDO A
#
#     ENDPARDO MU, NU, J
#
#     EXECUTE SERVER_BARRIER
#
     ENDPROC CHECK_TRAN 
#    ------------------

#    MAIN PROGRAM BLOCK
#    -------------------

      CALL MO_OVERLAP
      CALL FORM_DELTABLOCKS
      CALL CHECK_PUTS # Watson routine

#      CALL CHECK_FIND_ZEROS
#      CALL CHECK_RETURN_DIAGS 

      CALL CHECK_TRAN
  

      ENDSIAL TEST


