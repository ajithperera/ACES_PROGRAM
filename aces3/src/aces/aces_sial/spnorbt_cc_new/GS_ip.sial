               ENDIF 
#---------------------------------------------------------------------  |
               COEF_R += COEF_R_a
               COEF_L += COEF_L_a
               COEF_R += COEF_R_b
               COEF_L += COEF_L_b
               COEF_R += COEF_R_aaa
               COEF_L += COEF_L_aaa
               COEF_R += COEF_R_bbb
               COEF_L += COEF_L_bbb
               COEF_R += COEF_R_abb
               COEF_L += COEF_L_abb
#               COEF_R += COEF_R_g1
#               COEF_L += COEF_L_g1
#               COEF_R += COEF_R_g2
#               COEF_L += COEF_L_g2
#               COEF_R += COEF_R_g3
#               COEF_L += COEF_L_g3
#               COEF_R += COEF_R_g4
#               COEF_L += COEF_L_g4

               VNORM += VNORM_a
               VNORM += VNORM_b
               VNORM += VNORM_aaa
               VNORM += VNORM_bbb
               VNORM += VNORM_abb
#---------------Geminal part-----------------------------             
#               VNORM += VNORM_g1
#               VNORM += VNORM_g2
#               VNORM += VNORM_g3
#               VNORM += VNORM_g4 
#--------------------------------------------------------
#               execute print_scalar COEF_R_a
#               execute print_scalar COEF_L_a
#               execute print_scalar COEF_R_b
#               execute print_scalar COEF_L_b
#               execute print_scalar COEF_R_aaa
#               execute print_scalar COEF_L_aaa
#               execute print_scalar COEF_R_bbb
#               execute print_scalar COEF_L_bbb
#               execute print_scalar COEF_R_abb
#               execute print_scalar COEF_L_abb
#
#-------------------------------------------------------------- |
               norm_sqr = VNORM
               norm_sqr *= VNORM
               half = 0.5

               execute square_root norm_sqr half

               tmpval = 1.0/VNORM
               COEF_R *= tmpval
               COEF_L *= tmpval

               execute server_barrier
#-----------Gramm - Schmit coefficients are done--------------- |
#-----------Now the subtraction itselfs------------------------ |
#---------------------------------------------------------------|

#---------------alpha part--------------------------------------|
                               PARDO i
                 REQUEST IP_EVEC_R_p_a(i,target_roots1) i
                 REQUEST IP_EVEC_L_p_a(i,target_roots1) i

                 DAV_temp_R_p_a(i) = IP_EVEC_R_p_a(i,target_roots1)
                 DAV_temp_L_p_a(i) = IP_EVEC_L_p_a(i,target_roots1)

                 DAV_temp_R_p_a_targ(i,target_roots) = 0.0
                 DAV_temp_L_p_a_targ(i,target_roots) = 0.0


                 DAV_temp_R_p_a(i) *= COEF_R
                 DAV_temp_L_p_a(i) *= COEF_L
                 DAV_temp_R_p_a(i) *= -1.0
                 DAV_temp_L_p_a(i) *= -1.0

                 execute addrootindex DAV_temp_R_p_a DAV_temp_R_p_a_targ
                 execute addrootindex DAV_temp_L_p_a DAV_temp_L_p_a_targ


                 PREPARE IP_EVEC_R_aux_p_a(i,target_roots) = DAV_temp_R_p_a_targ(i,target_roots)
                 PREPARE IP_EVEC_L_aux_p_a(i,target_roots) = DAV_temp_L_p_a_targ(i,target_roots)

                               ENDPARDO i 

               execute server_barrier


               PARDO i
               REQUEST IP_EVEC_R_aux_p_a(i,target_roots) i
               REQUEST IP_EVEC_L_aux_p_a(i,target_roots) i
               DAV_temp_R_p_a_targ(i,target_roots) = IP_EVEC_R_aux_p_a(i,target_roots)
               DAV_temp_L_p_a_targ(i,target_roots) = IP_EVEC_L_aux_p_a(i,target_roots)
               PREPARE IP_EVEC_R_p_a(i,target_roots) += DAV_temp_R_p_a_targ(i,target_roots)
               PREPARE IP_EVEC_L_p_a(i,target_roots) += DAV_temp_L_p_a_targ(i,target_roots)
               ENDPARDO i

               execute server_barrier
#----------------alpha-alpha-alpha part------------------------  |
               PARDO i1,c1,i
               REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,target_roots1) i
               REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,target_roots1) i

                 DAV_temp_R_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,target_roots1)
                 DAV_temp_L_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,target_roots1)

                 DAV_RX_temp_aaa_targ(i1,c1,i,target_roots) = 0.0
                 DAV_LX_temp_aaa_targ(i1,c1,i,target_roots) = 0.0

                 DAV_temp_R_abi_aaa(i1,c1,i) *= COEF_R
                 DAV_temp_L_abi_aaa(i1,c1,i) *= COEF_L
                 DAV_temp_R_abi_aaa(i1,c1,i) *= -1.0
                 DAV_temp_L_abi_aaa(i1,c1,i) *= -1.0

                 execute addrootindex DAV_temp_R_abi_aaa DAV_RX_temp_aaa_targ
                 execute addrootindex DAV_temp_L_abi_aaa DAV_LX_temp_aaa_targ

     PREPARE IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots) = DAV_RX_temp_aaa_targ(i1,c1,i,target_roots)
     PREPARE IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots) = DAV_LX_temp_aaa_targ(i1,c1,i,target_roots)

                   ENDPARDO i1,c1,i

               execute server_barrier

               PARDO i1,c1,i
               REQUEST IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots) i
               REQUEST IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots) i
               DAV_RX_temp_aaa_targ(i1,c1,i,target_roots) = IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots)
               DAV_LX_temp_aaa_targ(i1,c1,i,target_roots) = IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots)
            PREPARE IP_EVEC_R_abi_aaa(i1,c1,i,target_roots) += DAV_RX_temp_aaa_targ(i1,c1,i,target_roots)
            PREPARE IP_EVEC_L_abi_aaa(i1,c1,i,target_roots) += DAV_LX_temp_aaa_targ(i1,c1,i,target_roots)
               ENDPARDO i1,c1,i
               execute server_barrier
#----------------alpha-beta-beta part--------------------------- |
                  PARDO i,d,j

                  REQUEST IP_EVEC_R_abi_abb(i,d,j,target_roots1) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,target_roots1) j

                 DAV_temp_R_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,target_roots1)
                 DAV_temp_L_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,target_roots1)

                 DAV_RX_temp_abb_targ(i,d,j,target_roots) = 0.0
                 DAV_LX_temp_abb_targ(i,d,j,target_roots) = 0.0

                 DAV_temp_R_abi_abb(i,d,j) *= COEF_R
                 DAV_temp_L_abi_abb(i,d,j) *= COEF_L
                 DAV_temp_R_abi_abb(i,d,j) *= -1.0
                 DAV_temp_L_abi_abb(i,d,j) *= -1.0

                 execute addrootindex DAV_temp_R_abi_abb DAV_RX_temp_abb_targ
                 execute addrootindex DAV_temp_L_abi_abb DAV_LX_temp_abb_targ

          PREPARE IP_EVEC_R_aux_abi_abb(i,d,j,target_roots) = DAV_RX_temp_abb_targ(i,d,j,target_roots)
          PREPARE IP_EVEC_L_aux_abi_abb(i,d,j,target_roots) = DAV_LX_temp_abb_targ(i,d,j,target_roots)

                   ENDPARDO i,d,j

               execute server_barrier

                 PARDO i,d,j
                 REQUEST IP_EVEC_R_aux_abi_abb(i,d,j,target_roots) j
                 REQUEST IP_EVEC_L_aux_abi_abb(i,d,j,target_roots) j
                 DAV_RX_temp_abb_targ(i,d,j,target_roots) = IP_EVEC_R_aux_abi_abb(i,d,j,target_roots)
                 DAV_LX_temp_abb_targ(i,d,j,target_roots) = IP_EVEC_L_aux_abi_abb(i,d,j,target_roots)
                 PREPARE IP_EVEC_R_abi_abb(i,d,j,target_roots) += DAV_RX_temp_abb_targ(i,d,j,target_roots)
                 PREPARE IP_EVEC_L_abi_abb(i,d,j,target_roots) += DAV_LX_temp_abb_targ(i,d,j,target_roots)
                 ENDPARDO i,d,j
                 execute server_barrier
#---------------------------------------------------------------|
      ENDDO target_roots1
      ENDDO target_roots     

      ENDPROC GSO
#     -----------

#----------------------------------------------------------------------|
#            Normalization of obtained vectors                         |
#----------------------------------------------------------------------|
      PROC NORMALIZE
#     --------------

         cnt = 0.0
#----------Loop over roots--------------------------------------|
         DO target_roots
#----------Check if number of roots is exceeded-----------------|
         cnt += 1.0
         IF cnt > n_target_roots
         EXIT
         ENDIF
#---------------------------------------------------------------
         VNORM = 0.0
         VNORM_a = 0.0
         VNORM_b = 0.0
         VNORM_aaa = 0.0
         VNORM_bbb = 0.0
         VNORM_abb = 0.0
         VNORM_g1 = 0.0
         VNORM_g2 = 0.0
         VNORM_g3 = 0.0
         VNORM_g4 = 0.0    
#-----------------alpha-alpha part------------------------------|
           VNORM_aux = 0.0

               PARDO i
                 REQUEST IP_EVEC_R_p_a(i,target_roots) i
                 REQUEST IP_EVEC_L_p_a(i,target_roots) i

                 DAV_temp_RC_p_a(i) = IP_EVEC_R_p_a(i,target_roots)
                 DAV_temp_LC_p_a(i) = IP_EVEC_L_p_a(i,target_roots)

                 tmpval =  DAV_temp_LC_p_a(i)*DAV_temp_RC_p_a(i)
                 VNORM_aux += tmpval

               ENDPARDO i

               execute server_barrier

               collective VNORM_a += VNORM_aux
#-----------------alpha-alpha-alpha part------------------------|
               VNORM_aux = 0.0

                   PARDO i1,c1,i
                 REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,target_roots) i
                 REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,target_roots) i

                 DAV_temp_RC_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,target_roots)
                 DAV_temp_LC_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,target_roots)

                 tmpval = DAV_temp_RC_abi_aaa(i1,c1,i)*DAV_temp_LC_abi_aaa(i1,c1,i)

                 VNORM_aux += tmpval

                   ENDPARDO i1,c1,i

               execute server_barrier

               collective VNORM_aaa += VNORM_aux
#--------------alpha-beta-beta part------------------------------|
               VNORM_aux = 0.0

                   PARDO i,d,j
                  REQUEST IP_EVEC_R_abi_abb(i,d,j,target_roots) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,target_roots) j

                  DAV_temp_RC_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,target_roots)
                  DAV_temp_LC_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,target_roots)

                 tmpval = DAV_temp_RC_abi_abb(i,d,j)*DAV_temp_LC_abi_abb(i,d,j)

                 VNORM_aux += tmpval

                   ENDPARDO i,d,j

               execute server_barrier

               collective VNORM_abb += VNORM_aux
#----------Geminal contribution to the norm-------------------------------|
               IF EAEOMF12CALC == 1.0 
#-----------Auxiliary intermediates--------------------------
        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT1(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT2(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT3(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT4(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier
#-------------------------------------------------------------------|
#     --------Construction of auxiliary intermediates -----         |  
#-------------------------------------------------------------------|
#        PARDO a,b,i
#                 REQUEST EE_EVEC_R_p_a(a,i,target_roots) i
#                 DAV_temp_RC_p_a(a,i) = EE_EVEC_R_p_a(a,i,target_roots)
#                 REQUEST INTERM1(a,b) a
#                 tINTERM1(a,b) = INTERM1(a,b)
#                 tINTERM7(b,i) = DAV_temp_RC_p_a(a,i)*tINTERM1(a,b)
#                 PREPARE AUXINT1(b,i) += tINTERM7(b,i)
#        ENDPARDO a,b,i
#        execute server_barrier

#        PARDO a,b,i
#                 REQUEST EE_EVEC_R_p_a(a,i,target_roots) i
#                 DAV_temp_RC_p_a(a,i) = EE_EVEC_R_p_a(a,i,target_roots)
#                 REQUEST INTERM2(a,b) a
#                 tINTERM1(a,b) = INTERM2(a,b)
#                 tINTERM7(b,i) = DAV_temp_RC_p_a(a,i)*tINTERM1(a,b)
#                 PREPARE AUXINT2(b,i) += tINTERM7(b,i)
#        ENDPARDO a,b,i
#        execute server_barrier

#        PARDO a,b,i,j
#                 REQUEST EE_EVEC_R_p_a(b,j,target_roots) j
#                 DAV_temp_RC_p_a(b,j) = EE_EVEC_R_p_a(b,j,target_roots)
#                 REQUEST INTERM3(b,a,i,j) i
#                 tINTERM3(b,a,i,j) = INTERM3(b,a,i,j)
#                 tINTERM7(a,i) = tINTERM3(b,a,i,j)*DAV_temp_RC_p_a(b,j)
#                 PREPARE AUXINT3(a,i) += tINTERM7(a,i)
#        ENDPARDO a,b,i,j
#        execute server_barrier

#        PARDO a,b,i,j
#                 REQUEST EE_EVEC_R_p_a(b,j,target_roots1) j
#                 DAV_temp_RC_p_a(b,j) = EE_EVEC_R_p_a(b,j,target_roots1)
#                 REQUEST INTERM4(i,j,b,a) a
#                 tINTERM4(i,j,b,a) = INTERM4(i,j,b,a)
#                 tINTERM7(a,i) = tINTERM4(i,j,b,a)*DAV_temp_RC_p_a(b,j)
#                 PREPARE AUXINT4(a,i) += tINTERM7(a,i)
#        ENDPARDO a,b,i,j
#        execute server_barrier
#--------------Geminal overlap------------------------------------
           VNORM_aux = 0.0

#               PARDO a,i
#                 REQUEST AUXINT1(a,i) i
#                 REQUEST EE_EVEC_L_p_a(a,i,target_roots) i

#                 DAV_temp_RC_p_a(a,i) = AUXINT1(a,i)
#                 DAV_temp_LC_p_a(a,i) = EE_EVEC_L_p_a(a,i,target_roots)

#                 tmpval =  DAV_temp_LC_p_a(a,i)*DAV_temp_RC_p_a(a,i)
#                 tmpval *= 4.0
#                 VNORM_aux += tmpval
#               ENDPARDO a,i

#               execute server_barrier

#               collective VNORM_g1 += VNORM_aux
#-----------------------------------------------
           VNORM_aux = 0.0

#               PARDO a,i
#                 REQUEST AUXINT2(a,i) i
#                 REQUEST EE_EVEC_L_p_a(a,i,target_roots) i

#                 DAV_temp_RC_p_a(a,i) = AUXINT2(a,i)
#                 DAV_temp_LC_p_a(a,i) = EE_EVEC_L_p_a(a,i,target_roots)

#                 tmpval =  DAV_temp_LC_p_a(a,i)*DAV_temp_RC_p_a(a,i)
#                 tmpval *= 4.0
#                 VNORM_aux += tmpval
#               ENDPARDO a,i

#               execute server_barrier

#               collective VNORM_g2 += VNORM_aux
#-----------------------------------------------
           VNORM_aux = 0.0

#               PARDO a,i
#                 REQUEST AUXINT3(a,i) i
#                 REQUEST EE_EVEC_L_p_a(a,i,target_roots) i

#                 DAV_temp_RC_p_a(a,i) = AUXINT3(a,i)
#                 DAV_temp_LC_p_a(a,i) = EE_EVEC_L_p_a(a,i,target_roots)

#                 tmpval =  DAV_temp_LC_p_a(a,i)*DAV_temp_RC_p_a(a,i)
#                 tmpval *= -2.0
#                 VNORM_aux += tmpval
#               ENDPARDO a,i

#               execute server_barrier

#               collective VNORM_g3 += VNORM_aux
#-----------------------------------------------
           VNORM_aux = 0.0

#               PARDO a,i
#                 REQUEST AUXINT4(a,i) i
#                 REQUEST EE_EVEC_L_p_a(a,i,target_roots) i

#                 DAV_temp_RC_p_a(a,i) = AUXINT4(a,i)
#                 DAV_temp_LC_p_a(a,i) = EE_EVEC_L_p_a(a,i,target_roots)

#                 tmpval =  DAV_temp_LC_p_a(a,i)*DAV_temp_RC_p_a(a,i)
#                 tmpval *= -2.0
#                 VNORM_aux += tmpval
#               ENDPARDO a,i

#               execute server_barrier

#               collective VNORM_g4 += VNORM_aux
#-----------------------------------------------



#-------------------------------------------------------------
               ENDIF
#-------------------------------------------------------------------------|
               VNORM += VNORM_a
               VNORM += VNORM_b
               VNORM += VNORM_aaa
               VNORM += VNORM_bbb
               VNORM += VNORM_abb
#               VNORM += VNORM_g1
#               VNORM += VNORM_g2
#               VNORM += VNORM_g3
#               VNORM += VNORM_g4

               execute server_barrier
#----------Normalization factor--------------------------------------------------|
               norm_sqr = VNORM
               norm_sqr *= VNORM
               half = 0.5

               execute square_root norm_sqr half

               IF norm_sqr > tresh_denom

           minus = 0.0

           tmpval = 1.0/VNORM
           IF tmpval < 0.0
           tmpval *= -1.0
           minus = 1.0
           ENDIF


           half = 0.5

           execute square_root tmpval half

           VNORM =  tmpval

               ENDIF
#--------Multiplication of vectors by normalization factors----------------------|
               PARDO i
                REQUEST IP_EVEC_R_p_a(i,target_roots) i
                REQUEST IP_EVEC_L_p_a(i,target_roots) i

                 DAV_temp_RC_p_a(i) = IP_EVEC_R_p_a(i,target_roots)
                 DAV_temp_LC_p_a(i) = IP_EVEC_L_p_a(i,target_roots)

                 DAV_temp_RC_p_a(i) *= VNORM
                 DAV_temp_LC_p_a(i) *= VNORM

                 DAV_temp_R_p_a_targ(i,target_roots) = 0.0
                 DAV_temp_L_p_a_targ(i,target_roots) = 0.0

                 IF minus == 1.0
                 DAV_temp_LC_p_a(i) *= -1.0
                 ENDIF

                 execute addrootindex DAV_temp_RC_p_a DAV_temp_R_p_a_targ
                 execute addrootindex DAV_temp_LC_p_a DAV_temp_L_p_a_targ

                 PREPARE IP_EVEC_R_aux_p_a(i,target_roots) = DAV_temp_R_p_a_targ(i,target_roots)
                 PREPARE IP_EVEC_L_aux_p_a(i,target_roots) = DAV_temp_L_p_a_targ(i,target_roots)

               ENDPARDO i
               execute server_barrier

               PARDO i
               REQUEST IP_EVEC_R_aux_p_a(i,target_roots) i
               REQUEST IP_EVEC_L_aux_p_a(i,target_roots) i
               DAV_temp_R_p_a_targ(i,target_roots) = IP_EVEC_R_aux_p_a(i,target_roots)
               DAV_temp_L_p_a_targ(i,target_roots) = IP_EVEC_L_aux_p_a(i,target_roots)
               PREPARE IP_EVEC_R_p_a(i,target_roots) = DAV_temp_R_p_a_targ(i,target_roots)
               PREPARE IP_EVEC_L_p_a(i,target_roots) = DAV_temp_L_p_a_targ(i,target_roots)
               ENDPARDO i

               execute server_barrier
#----------------alpha-alpha-alpha part------------------------  |

               PARDO i1,c1,i
               REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,target_roots) i
               REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,target_roots) i

                 DAV_temp_RC_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,target_roots)
                 DAV_temp_LC_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,target_roots)

                 DAV_temp_RC_abi_aaa(i1,c1,i) *= VNORM
                 DAV_temp_LC_abi_aaa(i1,c1,i) *= VNORM


                 DAV_RX_temp_aaa_targ(i1,c1,i,target_roots) = 0.0
                 DAV_LX_temp_aaa_targ(i1,c1,i,target_roots) = 0.0

                 IF minus == 1.0
                 DAV_temp_LC_abi_aaa(i1,c1,i) *= -1.0
                 ENDIF

                 execute addrootindex DAV_temp_RC_abi_aaa DAV_RX_temp_aaa_targ
                 execute addrootindex DAV_temp_LC_abi_aaa DAV_LX_temp_aaa_targ

         PREPARE IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots) = DAV_RX_temp_aaa_targ(i1,c1,i,target_roots)
         PREPARE IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots) = DAV_LX_temp_aaa_targ(i1,c1,i,target_roots)

                   ENDPARDO i1,c1,i
                   execute server_barrier

               PARDO i1,c1,i
               REQUEST IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots) i
               REQUEST IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots) i
               DAV_RX_temp_aaa_targ(i1,c1,i,target_roots) = IP_EVEC_R_aux_abi_aaa(i1,c1,i,target_roots)
               DAV_LX_temp_aaa_targ(i1,c1,i,target_roots) = IP_EVEC_L_aux_abi_aaa(i1,c1,i,target_roots)
            PREPARE IP_EVEC_R_abi_aaa(i1,c1,i,target_roots) = DAV_RX_temp_aaa_targ(i1,c1,i,target_roots)
            PREPARE IP_EVEC_L_abi_aaa(i1,c1,i,target_roots) = DAV_LX_temp_aaa_targ(i1,c1,i,target_roots)
               ENDPARDO i1,c1,i
               execute server_barrier
#----------------alpha-beta-beta part---------------------------  |
                  PARDO i,d,j
                  REQUEST IP_EVEC_R_abi_abb(i,d,j,target_roots) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,target_roots) j

                  DAV_temp_RC_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,target_roots)
                  DAV_temp_LC_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,target_roots)

                  DAV_temp_RC_abi_abb(i,d,j) *= VNORM
                  DAV_temp_LC_abi_abb(i,d,j) *= VNORM

                  DAV_RX_temp_abb_targ(i,d,j,target_roots) = 0.0
                  DAV_LX_temp_abb_targ(i,d,j,target_roots) = 0.0

                  IF minus == 1.0
                  DAV_temp_LC_abi_abb(i,d,j) *= -1.0
                  ENDIF

                 execute addrootindex DAV_temp_RC_abi_abb DAV_RX_temp_abb_targ
                 execute addrootindex DAV_temp_LC_abi_abb DAV_LX_temp_abb_targ

              PREPARE IP_EVEC_R_aux_abi_abb(i,d,j,target_roots) = DAV_RX_temp_abb_targ(i,d,j,target_roots)
              PREPARE IP_EVEC_L_aux_abi_abb(i,d,j,target_roots) = DAV_LX_temp_abb_targ(i,d,j,target_roots)

                   ENDPARDO i,d,j

                 execute server_barrier


                 PARDO i,d,j
                 REQUEST IP_EVEC_R_aux_abi_abb(i,d,j,target_roots) j
                 REQUEST IP_EVEC_L_aux_abi_abb(i,d,j,target_roots) j
                 DAV_RX_temp_abb_targ(i,d,j,target_roots) = IP_EVEC_R_aux_abi_abb(i,d,j,target_roots)
                 DAV_LX_temp_abb_targ(i,d,j,target_roots) = IP_EVEC_L_aux_abi_abb(i,d,j,target_roots)
                 PREPARE IP_EVEC_R_abi_abb(i,d,j,target_roots) = DAV_RX_temp_abb_targ(i,d,j,target_roots)
                 PREPARE IP_EVEC_L_abi_abb(i,d,j,target_roots) = DAV_LX_temp_abb_targ(i,d,j,target_roots)
                 ENDPARDO i,d,j
                 execute server_barrier
#---------------------------------------------------------------- |

                  ENDDO target_roots

      ENDPROC NORMALIZE  
#     -----------------

#-------------------------------------------------------------------|
      PROC INTERM
#     -----------

#--------------Preparation of C_ijab and C_iajb------------------------------ 
      PARDO i,j,a,b
      tmp_C_ijab(i,j,a,b) = 0.0
      tmp_C_iajb(i,a,j,b) = 0.0
      execute f12_c_ijab_coef tmp_C_ijab tmp_C_iajb
      PREPARE C_ijab(i,j,a,b) = tmp_C_ijab(i,j,a,b)
      PREPARE C_iajb(i,a,j,b) = tmp_C_iajb(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier
#----------Auxiliary intermediates-------------------------------------------
      PARDO i,j,a,b
      tINTERMAUX1(a,b,i,j) = 0.0       
      DO k
      DO d 
      REQUEST C_ijab(k,i,a,d) i
      tmp_C_ijab(k,i,a,d) = C_ijab(k,i,a,d)  
      REQUEST Xabjl(d,b,k,j) j
      tXabjl(d,b,k,j) = Xabjl(d,b,k,j)
      tINTERMAUX2(a,b,i,j) = tXabjl(d,b,k,j)*tmp_C_ijab(k,i,a,d)
      tINTERMAUX1(a,b,i,j) += tINTERMAUX2(a,b,i,j) 
      ENDDO d
      ENDDO k    

      PREPARE INTERMAUX1(a,b,i,j) = tINTERMAUX1(a,b,i,j)
      ENDPARDO i,j,a,b
      execute server_barrier  
#-------------------------------------------------------
      PARDO a,i,b,j 
      tINTERMAUX3(a,i,b,j) = 0.0
      DO k
      DO d
      REQUEST C_iajb(i,d,k,b) i
      tmp_C_iajb(i,d,k,b) = C_iajb(i,d,k,b)
      REQUEST Xabjl(d,a,k,j) j
      tXabjl(d,a,k,j) = Xabjl(d,a,k,j)
      tINTERMAUX4(a,i,b,j) = tXabjl(d,a,k,j)*tmp_C_iajb(i,d,k,b)
      tINTERMAUX3(a,i,b,j) += tINTERMAUX4(a,i,b,j) 
      ENDDO d
      ENDDO k

      PREPARE INTERMAUX2(a,i,b,j) = tINTERMAUX3(a,i,b,j) 
      ENDPARDO a,i,b,j
      execute server_barrier 
#----------Intermediates itself------------------------------------|
      PARDO a,b,i,j
      DO d
      REQUEST INTERMAUX1(a,d,i,j) i
      tINTERMAUX1(a,d,i,j)=INTERMAUX1(a,d,i,j)
      REQUEST C_ijab(i,j,d,b) i
      tmp_C_ijab(i,j,d,b) = C_ijab(i,j,d,b)
      tINTERM1(a,b) = tINTERMAUX1(a,d,i,j)*tmp_C_ijab(i,j,d,b)
      PREPARE INTERM1(a,b) += tINTERM1(a,b)
      ENDDO d
      ENDPARDO a,b,i,j
      execute server_barrier

      PARDO a,b,i,j
      DO d
      REQUEST INTERMAUX2(d,i,a,j) j 
      tINTERMAUX3(d,i,a,j) = INTERMAUX2(d,i,a,j)
      REQUEST C_iajb(i,d,j,b) i
      tmp_C_iajb(i,d,j,b) = C_iajb(i,d,j,b)
      tINTERM2(a,b) = tINTERMAUX3(d,i,a,j)*tmp_C_iajb(i,d,j,b)
      PREPARE INTERM2(a,b) += tINTERM2(a,b)
      ENDDO d 
      ENDPARDO a,b,i,j
      execute server_barrier
#----------------------------------------------------
      PARDO a,b,i,j
      DO l
      DO d 
      REQUEST INTERMAUX1(a,d,i,l) l
      tINTERMAUX1(a,d,i,l)=INTERMAUX1(a,d,i,l)
      REQUEST C_ijab(j,l,d,b) j
      tmp_C_ijab(j,l,d,b) = C_ijab(j,l,d,b)
      tINTERM3(a,b,i,j) = tINTERMAUX1(a,d,i,l)*tmp_C_ijab(j,l,d,b)
      PREPARE INTERM3(a,b,i,j) += tINTERM3(a,b,i,j)
      ENDDO d 
      ENDDO l
      ENDPARDO a,b,i,j
      execute server_barrier 

      PARDO a,b,i,j
      DO l
      DO d
      REQUEST INTERMAUX2(d,i,a,l) i
      tINTERMAUX3(d,i,a,l) = INTERMAUX2(d,i,a,l)
      REQUEST C_iajb(j,d,l,b) j
      tmp_C_iajb(j,d,l,b) = C_iajb(j,d,l,b)
      tINTERM4(i,j,a,b) = tINTERMAUX3(d,i,a,l)*tmp_C_iajb(j,d,l,b)
      PREPARE INTERM4(i,j,a,b) += tINTERM4(i,j,a,b) 
      ENDDO d 
      ENDDO l
      ENDPARDO a,b,i,j
      execute server_barrier
#---------------------------------------------------------------------

      ENDPROC INTERM
#     -------------- 

#---------------------------------------------------------------------
      PROC RLOVER
#     -----------

       DO kroot
       DO kroot1

      LROVER = 0.0
      LROVER_aa = 0.0
      LROVER_bb = 0.0
      LROVER_aaaa = 0.0
      LROVER_bbbb = 0.0
      LROVER_aabb = 0.0
#-----------------------------------------

#-------------------------------------------------------------------
               VNORM_aux = 0.0

               PARDO i
                 REQUEST IP_EVEC_R_p_a(i,kroot) i
                 REQUEST IP_EVEC_L_p_a(i,kroot1) i

                 DAV_temp_R_p_a(i) = IP_EVEC_R_p_a(i,kroot)
                 DAV_temp_L_p_a(i) = IP_EVEC_L_p_a(i,kroot1)


                 tmpval =  DAV_temp_L_p_a(i)*DAV_temp_R_p_a(i)
                 VNORM_aux += tmpval
               ENDPARDO i

               execute server_barrier

               collective LROVER_aa += VNORM_aux
#-------------------------------------------------------------------
              VNORM_aux = 0.0

              PARDO i,i1,c1

                 REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,kroot) i
                 REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,kroot1) i

                 DAV_temp_R_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,kroot)
                 DAV_temp_L_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,kroot1)

                 tmpval = DAV_temp_R_abi_aaa(i1,c1,i)*DAV_temp_L_abi_aaa(i1,c1,i)
                 VNORM_aux += tmpval

              ENDPARDO i,i1,c1

              execute server_barrier

              collective LROVER_aaaa += VNORM_aux
#-----------------------------------------------------------------------
             VNORM_aux = 0.0

                                PARDO i,d,j
                  REQUEST IP_EVEC_R_abi_abb(i,d,j,kroot) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,kroot1) j

                  DAV_temp_R_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,kroot)
                  DAV_temp_L_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,kroot1)

                 tmpval = DAV_temp_R_abi_abb(i,d,j)*DAV_temp_L_abi_abb(i,d,j)
                 VNORM_aux += tmpval
                                ENDPARDO i,d,j

               execute server_barrier

               collective LROVER_aabb += VNORM_aux


#-----------------------------------------------------------------------
      LROVER += LROVER_aa
      LROVER += LROVER_aaaa
      LROVER += LROVER_aabb

      overvec1(kroot,kroot1) = LROVER

      ENDDO kroot1
      ENDDO kroot

      execute prsolrover overvec1(kroot,kroot1)
#-------------------------------------------------------------------|
#-------------------------------------------------------------------|


      ENDPROC RLOVER
#     --------------

#---------------------------------------------------------------------


#---------------------------------------------------------------------|
#                     Main program                                    |
#---------------------------------------------------------------------|                              

      n_target_roots = IP_ROOTS  
      execute print_scalar n_target_roots  
      execute eomeaf12info EAEOMF12CALC
#------------------------------------------------------------------|
#       READ VECTORS FROM THE DISK                                 | 
#------------------------------------------------------------------|
      CALL READ_DATA 
#------------------------------------------------------------------|
#       PREPARE GEMINAL OVERLAP INTERMEDIATES                      |
#------------------------------------------------------------------|
#      IF EAEOMF12CALC == 1.0
#      CALL INTERM
#      ENDIF 
#------------------------------------------------------------------|
#      Gramm-Schmit biorthogonalization                            |
#------------------------------------------------------------------|
      CALL GSO
#------------------------------------------------------------------|
#      Normalization of obtained vectors                           |
#------------------------------------------------------------------|
      CALL NORMALIZE 
#------------------------------------------------------------------|
#     Calculate overlap of obtained vectors                        |
#------------------------------------------------------------------|
#      CALL RLOVER
#------------------------------------------------------------------|

#---------------------------------------------------------------|
#  Dump integrals, eigenvectors and eigenvalues to the disc     |
#---------------------------------------------------------------|
           execute blocks_to_list               RIP
           execute blocks_to_list               IP_EVEC_R_p_a
           execute blocks_to_list               IP_EVEC_R_abi_aaa
           execute blocks_to_list               IP_EVEC_R_abi_abb
           execute blocks_to_list               IP_EVEC_L_p_a
           execute blocks_to_list               IP_EVEC_L_abi_aaa
           execute blocks_to_list               IP_EVEC_L_abi_abb
           execute blocks_to_list               t1a
           execute blocks_to_list               t1b
           execute blocks_to_list               T2aa
           execute blocks_to_list               T2bb
           execute blocks_to_list               T2ab

        execute write_blocks_to_list
        execute server_barrier
#-------------------------------------------------------------------------




                        ENDSIAL GRAMM_SCHMIT_BIORTH_IP
