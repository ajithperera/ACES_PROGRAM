

                        SIAL GRAMM_SCHMIT_BIORTH_IP
#                       ------------------------
      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
      moaindex k = baocc, eaocc
      moaindex l = baocc, eaocc

#
      moaindex b = bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1= bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt

      index   kk1 = 1,1
      index   target_roots = 1,12
      index   target_roots1 = 1,12
      index   Nroots = 1,12
      index kroot = 1,12
      index kroot1 =1,12

      distributed  RIP (target_roots,kk1)
#-----------Lambda amplitudes------------------------------------------------------------
      distributed A1a(i,a)
      distributed A1b(j,b)
      served A2aa(i,a,i1,a1)
      served A2ab(i,a,j,b)
      served A2bb(j,b,j1,b1)
      served Xabjl(a,b,j,i)
#-----------Cluster amplitudes-----------------------------------------------------------
      served T2aa(a,i,a1,i1)
      served T2ab(a,i,b,j)
      served T2bb(b,j,b1,j1)
      distributed t1a(a,i)
      distributed t1b(b,j)
#-----------Some auxilirary arrays-------------------------------------------------------
      served IP_EVAL1(kk1,target_roots)
      served IP_EVEC_R_p_a(i,target_roots)
      served IP_EVEC_R_p_b(j,target_roots)
      served IP_EVEC_R_abi_aaa(i,c1,i1,target_roots)
      served IP_EVEC_R_abi_bbb(j,d,j1,target_roots)
      served IP_EVEC_R_abi_abb(i,d,j,target_roots)
      served IP_EVEC_L_p_a(i,target_roots)
      served IP_EVEC_L_p_b(j,target_roots)
      served IP_EVEC_L_abi_aaa(i,c1,i1,target_roots)
      served IP_EVEC_L_abi_bbb(j,d,j1,target_roots)
      served IP_EVEC_L_abi_abb(i,d,j,target_roots)
#-----------Auxiliary vectors-----------------------------------|
      Distributed R1a_vecs(i,kk1,Nroots)
      Distributed R1b_vecs(j,kk1,Nroots)
      Distributed L1a_vecs(i,kk1,Nroots)
      Distributed L1b_vecs(j,kk1,Nroots)

      SERVED R2aa_a_vecs(a,i,kk1,i1,Nroots)
      SERVED R2bb_b_vecs(b,j,kk1,j1,Nroots)
      SERVED R2aa_b_vecs(a,i,kk1,j,Nroots)
      SERVED R2bb_a_vecs(b,j,kk1,i,Nroots)
      SERVED L2aa_a_vecs(a,i,kk1,i1,Nroots)
      SERVED L2bb_b_vecs(b,j,kk1,j1,Nroots)
      SERVED L2aa_b_vecs(a,i,kk1,j,Nroots)
      SERVED L2bb_a_vecs(b,j,kk1,i,Nroots)
#---------------------------------------------------------------|
      served IP_EVEC_R_aux_p_a(i,target_roots)
      served IP_EVEC_R_aux_p_b(j,target_roots)
      served IP_EVEC_R_aux_abi_aaa(i,c1,i1,target_roots)
      served IP_EVEC_R_aux_abi_bbb(j,d,j1,target_roots)
      served IP_EVEC_R_aux_abi_abb(i,d,j,target_roots)
      served IP_EVEC_L_aux_p_a(i,target_roots)
      served IP_EVEC_L_aux_p_b(j,target_roots)
      served IP_EVEC_L_aux_abi_aaa(i,c1,i1,target_roots)
      served IP_EVEC_L_aux_abi_bbb(j,d,j1,target_roots)
      served IP_EVEC_L_aux_abi_abb(i,d,j,target_roots)
#---------------------------------------------------------------|
      temp DAV_temp_R_p_a(i)
      temp DAV_temp_L_p_a(i)
      temp DAV_temp_RC_p_a(i)
      temp DAV_temp_LC_p_a(i)

      temp DAV_temp_R_p_b(j)
      temp DAV_temp_L_p_b(j)
      temp DAV_temp_RC_p_b(j)
      temp DAV_temp_LC_p_b(j)

      temp DAV_temp_R_abi_aaa(i1,a1,i)
      temp DAV_temp_L_abi_aaa(i1,a1,i)
      temp DAV_temp_RC_abi_aaa(i1,a1,i)
      temp DAV_temp_LC_abi_aaa(i1,a1,i)

      temp DAV_temp_R_abi_bbb(j1,b1,j)
      temp DAV_temp_L_abi_bbb(j1,b1,j)
      temp DAV_temp_RC_abi_bbb(j1,b1,j)
      temp DAV_temp_LC_abi_bbb(j1,b1,j)

      temp DAV_temp_R_abi_abb(i,b,j)
      temp DAV_temp_L_abi_abb(i,b,j)
      temp DAV_temp_RC_abi_abb(i,b,j)
      temp DAV_temp_LC_abi_abb(i,b,j)

      temp DAV_temp_R_p_a_targ(i,target_roots)
      temp DAV_temp_R_p_b_targ(j,target_roots)
      temp DAV_temp_L_p_a_targ(i,target_roots)
      temp DAV_temp_L_p_b_targ(j,target_roots)

      temp DAV_RX_temp_aaa_targ(i1,c1,i,target_roots)
      temp DAV_LX_temp_aaa_targ(i1,c1,i,target_roots)
      temp DAV_RX_temp_bbb_targ(j1,d,j,target_roots)
      temp DAV_LX_temp_bbb_targ(j1,d,j,target_roots)
      temp DAV_RX_temp_abb_targ(i,d,j,target_roots)
      temp DAV_LX_temp_abb_targ(i,d,j,target_roots)
      temp DAV_RX_temp_baa_targ(j,c1,i,target_roots)
      temp DAV_LX_temp_baa_targ(j,c1,i,target_roots)

      temp tR1a_vecs(i,kk1,Nroots)
      temp tL1a_vecs(i,kk1,Nroots)
      temp tR1a_vecs1(i,Nroots,kk1)
      temp tL1a_vecs1(i,Nroots,kk1)
      temp tIP_EVEC_R_p_a(i,target_roots)
      temp tIP_EVEC_L_p_a(i,target_roots)
      temp tR2aa_a_vecs(a,i,kk1,i1,Nroots)
      temp tR2aa_a_vecs1(a,i,kk1,i1)
      temp tR2aa_a_vecs2(i,a,i1,kk1)
      temp tR2aa_a_vecs3(i,a,i1)
      temp tIP_EVEC_R_abi_aaa(i,a,i1,Nroots)
      temp tR2aa_b_vecs(a,i,kk1,i1,Nroots)
      temp tR2aa_b_vecs1(a,i,kk1,i1)
      temp tR2aa_b_vecs2(i,a,i1,kk1)
      temp tR2aa_b_vecs3(i,a,i1)
      temp tIP_EVEC_R_abi_abb(i,a,i1,Nroots)

      temp tL2aa_a_vecs(a,i,kk1,i1,Nroots)
      temp tL2aa_a_vecs1(a,i,kk1,i1)
      temp tL2aa_a_vecs2(i,a,i1,kk1)
      temp tL2aa_a_vecs3(i,a,i1)
      temp tIP_EVEC_L_abi_aaa(i,a,i1,Nroots)
      temp tL2aa_b_vecs(a,i,kk1,i1,Nroots)
      temp tL2aa_b_vecs1(a,i,kk1,i1)
      temp tL2aa_b_vecs2(i,a,i1,kk1)
      temp tL2aa_b_vecs3(i,a,i1)
      temp tIP_EVEC_L_abi_abb(i,a,i1,Nroots)


      scalar LROVER 
      scalar LROVER_aa
      scalar LROVER_bb 
      scalar LROVER_aaaa 
      scalar LROVER_bbbb 
      scalar LROVER_aabb 



      scalar cnt
      scalar cnt1
      scalar cnt2
      scalar cnt3
      scalar tmpval
      scalar tmpval_R
      scalar tmpval_L
      scalar n_target_roots
      scalar half 
      scalar minus
      scalar tresh_denom 

      scalar VNORM
      scalar COEF_R
      scalar COEF_L

      scalar VNORM_a
      scalar COEF_R_a
      scalar COEF_L_a

      scalar VNORM_b
      scalar COEF_R_b
      scalar COEF_L_b

      scalar VNORM_aaa
      scalar COEF_R_aaa
      scalar COEF_L_aaa

      scalar VNORM_bbb
      scalar COEF_R_bbb
      scalar COEF_L_bbb

      scalar VNORM_abb
      scalar COEF_R_abb
      scalar COEF_L_abb

      scalar VNORM_aux
      scalar COEF_R_aux
      scalar COEF_L_aux
      scalar norm_sqr

      scalar VNORM_g1
      scalar VNORM_g2
      scalar VNORM_g3
      scalar VNORM_g4

      scalar COEF_R_g1
      scalar COEF_R_g2
      scalar COEF_R_g3
      scalar COEF_R_g4

      scalar COEF_L_g1
      scalar COEF_L_g2
      scalar COEF_L_g3
      scalar COEF_L_g4
#-------------------------------------------------------------
      scalar F12CALC
      scalar EAEOMF12CALC
#-------------------------------------------------------------
      temp tmp_C_ijab(i,j,a,b)
      temp tmp_C_iajb(i,a,j,b)
      served C_ijab(i,j,a,b)
      served C_iajb(i,a,j,b)
      served INTERMAUX1(a,b,i,j)
      served INTERMAUX2(a,i,b,j)
      served INTERM1(a,b)
      served INTERM2(a,b)
      served INTERM3(a,b,i,j)
      served INTERM4(i,j,a,b) 
      temp tINTERMAUX1(a,b,i,j)
      temp tINTERMAUX2(a,b,i,j)
      temp tINTERMAUX3(a,i,b,j)
      temp tINTERMAUX4(a,i,b,j)
      temp tXabjl(a,b,i,j)
      temp tINTERM1(a,b)
      temp tINTERM2(a,b)
      temp tINTERM3(a,b,i,j)
      temp tINTERM4(i,j,a,b)  
      served AUXINT1(a,i)
      served AUXINT2(a,i) 
      served AUXINT3(a,i)
      served AUXINT4(a,i)
      served AUXINT5(a,i)
      served AUXINT6(a,i)
      served AUXINT7(a,i)
      served AUXINT8(a,i)
      temp tINTERM7(a,i)
      temp qww(i)
      static overvec(kroot,kroot1)
      static overvec1(kroot,kroot1)



      PROC READ_DATA
#     --------------
      create t1a
      create t1b
      create A1a
      create A1b
      create RIP 
      create R1a_vecs
      create L1a_vecs
  
#-------------------------------------------------------------------
           execute list_to_blocks               RIP
           execute list_to_blocks               R1a_vecs
           execute list_to_blocks               R2aa_a_vecs
           execute list_to_blocks               R2aa_b_vecs
           execute list_to_blocks               L1a_vecs
           execute list_to_blocks               L2aa_a_vecs
           execute list_to_blocks               L2aa_b_vecs
           execute list_to_blocks               t1a
           execute list_to_blocks               t1b
           execute list_to_blocks               T2aa
           execute list_to_blocks               T2ab
           execute list_to_blocks               T2bb
           IF EAEOMF12CALC == 1.0
#           execute list_to_blocks               Xabjl
           ENDIF   
      execute read_list_to_blocks
      execute sip_barrier
      execute server_barrier
#-----------Prepare necessary R and L vectors-----------------------
         DO Nroots
          DO kk1

#------------One particle contributions-------------------------------
          DO i
          tIP_EVEC_R_p_a(i,Nroots) = 0.0
          GET R1a_vecs(i,kk1,Nroots)
          tR1a_vecs(i,kk1,Nroots) = R1a_vecs(i,kk1,Nroots)
          qww(i) = tR1a_vecs(i,kk1,Nroots)           
          execute addrootindex qww tIP_EVEC_R_p_a
          PREPARE IP_EVEC_R_p_a(i,Nroots) = tIP_EVEC_R_p_a(i,Nroots) 
          ENDDO i
          execute server_barrier

          DO i
          tIP_EVEC_L_p_a(i,Nroots) = 0.0
          GET L1a_vecs(i,kk1,Nroots)
          qww(i) = L1a_vecs(i,kk1,Nroots)
          execute addrootindex qww tIP_EVEC_L_p_a
          PREPARE IP_EVEC_L_p_a(i,Nroots) = tIP_EVEC_L_p_a(i,Nroots)
          ENDDO i
          execute server_barrier
#-----------Two-particle contributions--------------------------------
          PARDO a,i,i1
          tIP_EVEC_R_abi_aaa(i,a,i1,Nroots) = 0.0
          REQUEST R2aa_a_vecs(a,i1,kk1,i,Nroots) a
          tR2aa_a_vecs(a,i1,kk1,i,Nroots) = R2aa_a_vecs(a,i1,kk1,i,Nroots)
          tR2aa_a_vecs1(a,i1,kk1,i) = tR2aa_a_vecs(a,i1,kk1,i,Nroots)
          tR2aa_a_vecs2(i,a,i1,kk1) = tR2aa_a_vecs1(a,i1,kk1,i)
          tR2aa_a_vecs3(i,a,i1) = tR2aa_a_vecs2(i,a,i1,kk1)
          execute addrootindex tR2aa_a_vecs3 tIP_EVEC_R_abi_aaa
          PREPARE IP_EVEC_R_abi_aaa(i,a,i1,Nroots) = tIP_EVEC_R_abi_aaa(i,a,i1,Nroots)
          ENDPARDO a,i,i1
          execute server_barrier

          PARDO a,i,j
          tIP_EVEC_R_abi_abb(j,a,i,Nroots) = 0.0
          REQUEST R2aa_b_vecs(a,i,kk1,j,Nroots) a
          tR2aa_b_vecs(a,i,kk1,j,Nroots) = R2aa_b_vecs(a,i,kk1,j,Nroots)
          tR2aa_b_vecs1(a,i,kk1,j) = tR2aa_b_vecs(a,i,kk1,j,Nroots)
          tR2aa_b_vecs2(j,a,i,kk1) = tR2aa_b_vecs1(a,i,kk1,j)
          tR2aa_b_vecs3(j,a,i) = tR2aa_b_vecs2(j,a,i,kk1)
          execute addrootindex tR2aa_b_vecs3 tIP_EVEC_R_abi_abb
          PREPARE IP_EVEC_R_abi_abb(j,a,i,Nroots) = tIP_EVEC_R_abi_abb(j,a,i,Nroots)
          ENDPARDO a,i,j
          execute server_barrier 

          PARDO a,i,i1
          tIP_EVEC_L_abi_aaa(i,a,i1,Nroots) = 0.0
          REQUEST L2aa_a_vecs(a,i1,kk1,i,Nroots) a
          tL2aa_a_vecs(a,i1,kk1,i,Nroots) = L2aa_a_vecs(a,i1,kk1,i,Nroots)
          tL2aa_a_vecs1(a,i1,kk1,i) = tL2aa_a_vecs(a,i1,kk1,i,Nroots)
          tL2aa_a_vecs2(i,a,i1,kk1) = tL2aa_a_vecs1(a,i1,kk1,i)
          tL2aa_a_vecs3(i,a,i1) = tL2aa_a_vecs2(i,a,i1,kk1)
          execute addrootindex tL2aa_a_vecs3 tIP_EVEC_L_abi_aaa
          PREPARE IP_EVEC_L_abi_aaa(i,a,i1,Nroots) = tIP_EVEC_L_abi_aaa(i,a,i1,Nroots)
          ENDPARDO a,i,i1
          execute server_barrier

          PARDO a,i,j
          tIP_EVEC_L_abi_abb(j,a,i,Nroots) = 0.0
          REQUEST L2aa_b_vecs(a,i,kk1,j,Nroots) a
          tL2aa_b_vecs(a,i,kk1,j,Nroots) = L2aa_b_vecs(a,i,kk1,j,Nroots)
          tL2aa_b_vecs1(a,i,kk1,j) = tL2aa_b_vecs(a,i,kk1,j,Nroots)
          tL2aa_b_vecs2(j,a,i,kk1) = tL2aa_b_vecs1(a,i,kk1,j)
          tL2aa_b_vecs3(j,a,i) = tL2aa_b_vecs2(j,a,i,kk1)
          execute addrootindex tL2aa_b_vecs3 tIP_EVEC_L_abi_abb
          PREPARE IP_EVEC_L_abi_abb(j,a,i,Nroots) = tIP_EVEC_L_abi_abb(j,a,i,Nroots)
          ENDPARDO a,i,j
          execute server_barrier



          ENDDO kk1
         ENDDO Nroots
#-------------------------------------------------------------------
      ENDPROC READ_DATA
#     -----------------

#------------------------------------------------------------------
#------------------------------------------------------------------
      PROC GSO
#     --------

#----------------------------------------------------------------------|
#         Gramm-Schmidt biorthogonalization                            |
#----------------------------------------------------------------------|

      cnt = 0.0
#------------Loop over target roots------------------------------------|
      DO target_roots
#----------Check if number of target roots is exceeded-----------------|
      cnt += 1.0
      IF cnt > n_target_roots
      EXIT
      ENDIF

#----------------------------------------------------------------|
#        Subtraction of projection on the other vectors          |
#----------------------------------------------------------------|

#-----------Second Loop over target roots-------------------------------|
      cnt2 = cnt
      cnt2 -= 1.0
      cnt3 = 0.0
      DO target_roots1
#----------Check if number of roots is exceeded------------------|
      cnt3 += 1.0
      IF cnt3 > cnt2
      EXIT
      ENDIF
#---------Norm and Gramm-Schmit coefficients---------------------|
          VNORM = 0.0
          COEF_R = 0.0
          COEF_L = 0.0

          VNORM_a = 0.0
          COEF_R_a = 0.0
          COEF_L_a = 0.0

          VNORM_b = 0.0
          COEF_R_b = 0.0
          COEF_L_b = 0.0

          VNORM_aaa = 0.0
          COEF_R_aaa = 0.0
          COEF_L_aaa = 0.0

          VNORM_bbb = 0.0
          COEF_R_bbb = 0.0
          COEF_L_bbb = 0.0

          VNORM_abb = 0.0
          COEF_R_abb = 0.0
          COEF_L_abb = 0.0

          VNORM_g1 = 0.0
          VNORM_g2 = 0.0
          VNORM_g3 = 0.0
          VNORM_g4 = 0.0  

          COEF_R_g1 = 0.0
          COEF_L_g1 = 0.0
          COEF_R_g2 = 0.0
          COEF_L_g2 = 0.0
          COEF_R_g3 = 0.0
          COEF_L_g3 = 0.0
          COEF_R_g4 = 0.0
          COEF_L_g4 = 0.0
#--------- singles contribution ---------------------------------|

#----------------alpha part--------------------------------------|
          VNORM_aux = 0.0
          COEF_R_aux = 0.0
          COEF_L_aux = 0.0

               PARDO i
                 REQUEST IP_EVEC_R_p_a(i,target_roots1) i
                 REQUEST IP_EVEC_L_p_a(i,target_roots1) i
                 REQUEST IP_EVEC_R_p_a(i,target_roots) i
                 REQUEST IP_EVEC_L_p_a(i,target_roots) i

                 DAV_temp_R_p_a(i) = IP_EVEC_R_p_a(i,target_roots1)
                 DAV_temp_L_p_a(i) = IP_EVEC_L_p_a(i,target_roots1)
             
                 DAV_temp_RC_p_a(i) = IP_EVEC_R_p_a(i,target_roots)
                 DAV_temp_LC_p_a(i) = IP_EVEC_L_p_a(i,target_roots)


                 tmpval =  DAV_temp_L_p_a(i)*DAV_temp_R_p_a(i)
                 tmpval_R = DAV_temp_L_p_a(i)*DAV_temp_RC_p_a(i)
                 tmpval_L = DAV_temp_R_p_a(i)*DAV_temp_LC_p_a(i)
                 VNORM_aux += tmpval
                 COEF_R_aux += tmpval_R
                 COEF_L_aux += tmpval_L

               ENDPARDO i

               execute server_barrier

               collective VNORM_a += VNORM_aux
               collective COEF_R_a += COEF_R_aux
               collective COEF_L_a += COEF_L_aux
#----------------alpha-alpha-alpha part------------------------|
               VNORM_aux = 0.0
               COEF_R_aux = 0.0
               COEF_L_aux = 0.0

                   PARDO i1,c1,i
                 REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,target_roots1) i
                 REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,target_roots1) i
                 REQUEST IP_EVEC_R_abi_aaa(i1,c1,i,target_roots) i
                 REQUEST IP_EVEC_L_abi_aaa(i1,c1,i,target_roots) i

                 DAV_temp_R_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,target_roots1)
                 DAV_temp_L_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,target_roots1)
                 DAV_temp_RC_abi_aaa(i1,c1,i) = IP_EVEC_R_abi_aaa(i1,c1,i,target_roots)
                 DAV_temp_LC_abi_aaa(i1,c1,i) = IP_EVEC_L_abi_aaa(i1,c1,i,target_roots)

                 tmpval = DAV_temp_R_abi_aaa(i1,c1,i)*DAV_temp_L_abi_aaa(i1,c1,i)
                 tmpval_R = DAV_temp_L_abi_aaa(i1,c1,i)*DAV_temp_RC_abi_aaa(i1,c1,i)
                 tmpval_L = DAV_temp_R_abi_aaa(i1,c1,i)*DAV_temp_LC_abi_aaa(i1,c1,i)

                 VNORM_aux += tmpval
                 COEF_R_aux += tmpval_R
                 COEF_L_aux += tmpval_L

                   ENDPARDO i1,c1,i

               execute server_barrier

               collective VNORM_aaa += VNORM_aux
               collective COEF_R_aaa += COEF_R_aux
               collective COEF_L_aaa += COEF_L_aux
#----------------alpha-beta-beta part--------------------------- |
               VNORM_aux = 0.0
               COEF_R_aux = 0.0
               COEF_L_aux = 0.0

                   PARDO i,d,j
                  REQUEST IP_EVEC_R_abi_abb(i,d,j,target_roots1) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,target_roots1) j
                  REQUEST IP_EVEC_R_abi_abb(i,d,j,target_roots) j
                  REQUEST IP_EVEC_L_abi_abb(i,d,j,target_roots) j

                  DAV_temp_R_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,target_roots1)
                  DAV_temp_L_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,target_roots1)
                  DAV_temp_RC_abi_abb(i,d,j) = IP_EVEC_R_abi_abb(i,d,j,target_roots)
                  DAV_temp_LC_abi_abb(i,d,j) = IP_EVEC_L_abi_abb(i,d,j,target_roots)

                 tmpval = DAV_temp_R_abi_abb(i,d,j)*DAV_temp_L_abi_abb(i,d,j)
                 tmpval_R = DAV_temp_L_abi_abb(i,d,j)*DAV_temp_RC_abi_abb(i,d,j)
                 tmpval_L = DAV_temp_R_abi_abb(i,d,j)*DAV_temp_LC_abi_abb(i,d,j)

                 VNORM_aux += tmpval
                 COEF_R_aux += tmpval_R
                 COEF_L_aux += tmpval_L

                   ENDPARDO i,d,j

               execute server_barrier

               collective VNORM_abb += VNORM_aux
               collective COEF_R_abb += COEF_R_aux
               collective COEF_L_abb += COEF_L_aux

#---------Contributions from geminal part of vector--------------------- |
               IF EAEOMF12CALC == 1.0 

#------------Zero out auxiliary intermediates---------
        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT1(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier 

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT2(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier   

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT3(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT4(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT5(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

        PARDO a,i
        tINTERM7(a,i) = 0.0
        PREPARE AUXINT6(a,i) = tINTERM7(a,i)
        ENDPARDO a,i
        execute server_barrier

