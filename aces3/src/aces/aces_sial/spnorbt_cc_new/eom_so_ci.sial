#----------------------------------------------------------------------------------------|
#   The purpose of this code is to calculate spin-orbit splittings of excited states     |
#         using EOM-SO-CI method with Pauli-Breit hamiltonian                            |    
#     Added to ACES3 by Denis Bokhan, Moscow Lomonosov State University,                 |
#                            Moscow, Russian  Federation                                 |
#----------------------------------------------------------------------------------------|


                           SIAL EOM_SO_CI
#--------------Definition of indices------------------------------------------------------
      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#
      moaindex i = baocc, eaocc
      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc
#
      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
#
      moaindex j = baocc, eaocc
      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc
      moaindex k = baocc, eaocc
#
      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1 = bavirt, eavirt
#                                                                                                     
      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
      moaindex q= baocc, eavirt
#----------Simple indices---------------------
      index indone = 1, 1 # Watson
      index kroot = 1, 24 # Watson
      index kroot1 = 1, 24 
      index kindex12 =1, 24
      index soind1 = 1, 50
      index soind2 = 1, 50
      index   kk1 = 1,1
      index   target_roots = 1,24
#--------------Definition of arrays------------------------------------------------------

#-----------Non-relativistic EOM eigenvalues---------------------------------------------
      distributed  LEE (kroot,indone)
      distributed  REE (kroot,indone)
#-----------Non-relativistic EOM right eigenvectors--------------------------------------
      distributed  R1A_VECS (a,i,kindex12)
      distributed  R1B_VECS (b,j,kindex12)
      served       R2AA_VECS (a,i,a1,i1,kindex12)
      served       R2BB_VECS (b,j,b1,j1,kindex12)
      served       R2AB_VECS (a,i,b,j,kindex12)
      distributed  R1A_VECS_T (a,i,kroot)
      distributed  R1B_VECS_T (b,j,kroot)
      served       R2AA_VECS_T (a,i,a1,i1,kindex12)
      served       R2BB_VECS_T (b,j,b1,j1,kindex12)
      served       R2AB_VECS_T (a,i,b,j,kindex12)
      distributed  R1A_VECS_S (a,i,kroot)
      distributed  R1B_VECS_S (b,j,kroot)
      served       R2AA_VECS_S (a,i,a1,i1,kindex12)
      served       R2BB_VECS_S (b,j,b1,j1,kindex12)
      served       R2AB_VECS_S (a,i,b,j,kindex12)


#-----------Non-relativistic EOM left eigenvectors---------------------------------------
      distributed  L1A_VECS (i,a,kroot)
      distributed  L1B_VECS (j,b,kroot)
      served       L2AA_VECS (i,a,i1,a1,kroot)
      served       L2BB_VECS (j,b,j1,b1,kroot)
      served       L2AB_VECS (i,a,j,b,kroot)
      distributed  L1A_VECS_T (i,a,kroot)
      distributed  L1B_VECS_T (j,b,kroot)
      served       L2AA_VECS_T (i,a,i1,a1,kroot)
      served       L2BB_VECS_T (j,b,j1,b1,kroot)
      served       L2AB_VECS_T (i,a,j,b,kroot)
      distributed  L1A_VECS_S (i,a,kroot)
      distributed  L1B_VECS_S (j,b,kroot)
      served       L2AA_VECS_S (i,a,i1,a1,kroot)
      served       L2BB_VECS_S (j,b,j1,b1,kroot)
      served       L2AB_VECS_S (i,a,j,b,kroot)

      distributed  L1A_VECS_new (i,a,kroot)
      distributed  L1B_VECS_new (j,b,kroot)
      served       L2AA_VECS_new (i,a,i1,a1,kroot)
      served       L2BB_VECS_new (j,b,j1,b1,kroot)
      served       L2AB_VECS_new (i,a,j,b,kroot)
       

#-----------Lambda amplitudes------------------------------------------------------------
      distributed A1a(i,a)  
      distributed A1b(j,b)
      served A2aa(i,a,i1,a1) 
      served A2ab(i,a,j,b)   
      served A2bb(j,b,j1,b1) 
#-----------Cluster amplitudes-----------------------------------------------------------
      served T2aa(a,i,a1,i1)
      served T2ab(a,i,b,j)
      served T2bb(b,j,b1,j1)
      distributed t1a(a,i)
      distributed t1b(b,j)
#-----------Some auxilirary arrays-------------------------------------------------------
      served EE_EVAL1(kk1,target_roots)
      served EE_EVEC_R_p_a(a,i,target_roots)
      served EE_EVEC_R_p_b(b,j,target_roots)
      served EE_EVEC_R_abi_aaa(a,i,c1,i1,target_roots)
      served EE_EVEC_R_abi_bbb(b,j,d,j1,target_roots)
      served EE_EVEC_R_abi_abb(a,i,d,j,target_roots)
      served EE_EVEC_L_p_a(a,i,target_roots)
      served EE_EVEC_L_p_b(b,j,target_roots)
      served EE_EVEC_L_abi_aaa(a,i,c1,i1,target_roots)
      served EE_EVEC_L_abi_bbb(b,j,d,j1,target_roots)
      served EE_EVEC_L_abi_abb(a,i,d,j,target_roots)

#----------Spin-orbit integrals and related arrays---------------------------------------
      distributed SO_x_ao(mu,nu)
      distributed SO_y_ao(mu,nu)
      distributed SO_z_ao(mu,nu)
      distributed SO_x_pmu(mu,p)
      distributed SO_y_pmu(mu,p)
      distributed SO_z_pmu(mu,p)
      distributed SO_x_pq(p,q)
      distributed SO_y_pq(p,q)
      distributed SO_z_pq(p,q)
    
      served V2ixxi_x(i1,nu,lambda,i)
      served V2ixxi_y(i1,nu,lambda,i)
      served V2ixxi_z(i1,nu,lambda,i)

      served V2ipxi_x(i2,p,lambda,i)
      served V2ipxi_y(i2,p,lambda,i)
      served V2ipxi_z(i2,p,lambda,i)

      served V2iixx_x(i2,i,lambda,sigma)
      served V2iixx_y(i2,i,lambda,sigma)
      served V2iixx_z(i2,i,lambda,sigma)
     
      served V2xiix_x(mu,i,i2,sigma)
      served V2xiix_y(mu,i,i2,sigma)
      served V2xiix_z(mu,i,i2,sigma)

      served V2iipx_x(i2,i,p,sigma)
      served V2iipx_y(i2,i,p,sigma)
      served V2iipx_z(i2,i,p,sigma)

      served V2piix_x(p,i,i2,sigma)
      served V2piix_y(p,i,i2,sigma)
      served V2piix_z(p,i,i2,sigma)
 
      served V2ipqi_x(i2,p,q,i)
      served V2ipqi_y(i2,p,q,i)
      served V2ipqi_z(i2,p,q,i)

      served V2iipq_x(i2,i,p,q)
      served V2iipq_y(i2,i,p,q)
      served V2iipq_z(i2,i,p,q)

      served V2piiq_x(p,i,i2,q)
      served V2piiq_y(p,i,i2,q)
      served V2piiq_z(p,i,i2,q)
#----------------------------------------------------------------------------------------
      distributed HBAR_ia(i,a)
      distributed HBAR_jb(j,b)
#-----------SOMF Fock operators----------------------------------------------------------
      distributed Fso_pq_x(p,q)
      distributed Fso_pq_y(p,q)
      distributed Fso_pq_z(p,q)

      distributed Fso_pq_x_aux(p,q)
      distributed Fso_pq_y_aux(p,q)
      distributed Fso_pq_z_aux(p,q)

      distributed somfex_x_1(p,q)
      distributed somfex_y_1(p,q)
      distributed somfex_z_1(p,q)

      distributed somfex_x_2(p,q)
      distributed somfex_y_2(p,q)
      distributed somfex_z_2(p,q)

      distributed somfex_x_3(p,q)
      distributed somfex_y_3(p,q)
      distributed somfex_z_3(p,q)
#---------------SO matrix elements related arrays---------------------------------------- 
      distributed ILR_ab(a,b,kroot,kroot1)
      distributed ILR_ij(i,j,kroot,kroot1)
      distributed ILR_2p_ab(a,b,kroot,kroot1)
      distributed ILR_2p_ij(i,j,kroot,kroot1)     
      distributed ILR_AB_2p_ab(a,b,kroot,kroot1)
      distributed ILR_AB_2p_ij(i,j,kroot,kroot1)
      distributed ILR_AB1_2p_ab(a,b,kroot,kroot1)
      distributed ILR_AB1_2p_ij(i,j,kroot,kroot1)
      distributed ILR_AB2_2p_ab(a,b,kroot,kroot1)
      distributed ILR_AB2_2p_ij(i,j,kroot,kroot1)
      distributed ILR_AB3_2p_ab(a,b,kroot,kroot1)
      distributed ILR_AB3_2p_ij(i,j,kroot,kroot1)
      served LILR_ab(a,b,kroot,indone)
      served LILR_ij(i,j,kroot,indone)
      served LILR_2p_ab(a,b,kroot,indone)
      served LILR_2p_ij(i,j,kroot,indone)
      served LILR_AB_2p_ab(a,b,kroot,indone)
      served LILR_AB_2p_ij(i,j,kroot,indone)
      served LILR_AB1_2p_ab(a,b,kroot,indone)
      served LILR_AB1_2p_ij(i,j,kroot,indone)
      served LILR_AB2_2p_ab(a,b,kroot,indone)
      served LILR_AB2_2p_ij(i,j,kroot,indone)
      served LILR_AB3_2p_ab(a,b,kroot,indone)
      served LILR_AB3_2p_ij(i,j,kroot,indone) 
#-----------Temporal arrays--------------------------------------------------------------
      TEMP  Tee(kroot,indone)
      TEMP  T1_R1A(a,i)
      TEMP  T1_R1B(b,j)
      TEMP  L1_R1A(i,a)
      TEMP  L1_R1B(j,b)
      temp  tT1_R1A(a,i,kroot)
      temp  tT1_R1B(a,i,kroot)
      temp  tzT1_R1A(a,i,kroot)
      temp  tzT1_R1B(a,i,kroot)
      temp  tzT1_L1A(i,a,kroot)
      temp  tzT1_L1B(j,b,kroot)
      temp  tqT1_R1A(a,i,target_roots)
      temp  tqT1_R1B(a,i,target_roots)
      temp  tqT1_L1A(a,i,target_roots)
      temp  tqT1_L1B(a,i,target_roots)
      temp  tT1_L1A(i,a,kroot)
      temp  tT1_L1B(i,a,kroot)
      temp  tTR2AA_VECS (a,i,a1,i1,kindex12)
      temp  tTL2AA_VECS (i,a,i1,a1,kroot)
      temp  tTL2BB_VECS (j,b,j1,d,kroot)
      temp  tTL2AB_VECS (i,a,j,b,kroot)
      temp  tqTR2AA_VECS (a,i,a1,i1,target_roots)
      temp  tqTR2BB_VECS (b,j,d,j1,target_roots)
      temp  tqTR2AB_VECS (a,i,b,j,target_roots)
      temp  tqTL2AA_VECS (a,i,a1,i1,target_roots)
      temp  tqTL2BB_VECS (b,j,d,j1,target_roots)
      temp  tqTL2AB_VECS (a,i,b,j,target_roots) 
      temp  TR2_VECS (a,i,a1,i1)
      temp  TL2_VECS (i,a,j,b)
      temp troot(kroot,indone)
      temp tmp_EE_EVAL1(kk1,target_roots)
      temp tr(kroot)
      temp tkk(kk1)  
      temp troot1(kroot,indone)
      temp tover(kroot,kroot1)
      TEMP Tmp_1SOIX(mu,nu)
      TEMP Tmp_1SOIY(mu,nu)
      TEMP Tmp_1SOIZ(mu,nu)
      temp tTR2BB_VECS (b,j,d,j1,kroot)
      temp tTR2AB_VECS (a,i,b,j,kroot) 
      temp T1_L1A(i,a)
      temp T1_L1B(j,b)

      TEMP Tmp_2SOIX(mu,nu,lambda,sigma)
      TEMP Tmp_2SOIY(mu,nu,lambda,sigma)
      TEMP Tmp_2SOIZ(mu,nu,lambda,sigma)

      temp tSO_x_pmu(mu,p)
      temp tSO_y_pmu(mu,p)
      temp tSO_z_pmu(mu,p)
      temp tSO_x_pq(p,q)
      temp tSO_y_pq(p,q)
      temp tSO_z_pq(p,q)
      temp tsox(p,q,i,j)
      temp txxxi(mu,nu,lambda,i)
      temp tixxi(i2,nu,lambda,i)
      temp tipxi(i2,p,lambda,i)
      temp tipqi(i2,p,q,i)
      temp txixx(mu,i,lambda,sigma)
      temp tiixx(i2,i,lambda,sigma)
      temp txiix(mu,i,i2,sigma)
      temp tiipx(i2,i,p,sigma)
      temp tpiix(p,i,i2,sigma)
      temp tiipq(i2,i,p,q)
      temp tpiiq(p,i,i2,q)
      temp tsomf(p,q)
      temp tILR_ab(a,b,kroot,kroot1)
      temp tILR_ij(i,j,kroot,kroot1)
      temp tILR_2p_ab(a,b,kroot,kroot1)
      temp tILR_2p_ij(i,j,kroot,kroot1)
      temp tILR_AB_2p_ab(a,b,kroot,kroot1)
      temp tILR_AB_2p_ij(i,j,kroot,kroot1)
      temp tILR_AB1_2p_ab(a,b,kroot,kroot1)
      temp tILR_AB1_2p_ij(i,j,kroot,kroot1)
      temp tILR_AB2_2p_ab(a,b,kroot,kroot1)
      temp tILR_AB2_2p_ij(i,j,kroot,kroot1)
      temp tILR_AB3_2p_ab(a,b,kroot,kroot1)
      temp tILR_AB3_2p_ij(i,j,kroot,kroot1)
      temp ttT1_L1A(i,a,kroot,indone)
      temp ttT1_R1A(b,i,kroot,indone) 
      temp rILR_ab(a,b,kroot,indone)
      temp rILR_ij(i,j,kroot,indone) 
      temp taa(a,b)
      temp tii(i,j) 
      temp so_temp(soind1,soind2)   
#-----------local arrays----------------------------------------------------------------
      local V1_4_x(mu,nu,lambda,i)
      local V1_4_y(mu,nu,lambda,i)
      local V1_4_z(mu,nu,lambda,i)
 
      local V2_4_x(mu,i,lambda,sigma)
      local V2_4_y(mu,i,lambda,sigma)
      local V2_4_z(mu,i,lambda,sigma)


#-----------auxiliary arrays-------------------------------------------------------------
      static overvec(kroot,kroot1)
      static overvec1(kroot,kroot1)
      static root_ind(kroot,indone)
      static lroot_ind(kroot,indone)
      static roots(kroot,indone)
      static roots_S(kroot,indone)
      static roots_T(kroot,indone)  
      static so_ci_re(soind1,soind2)
      static so_ci_im(soind1,soind2)
      static vecstat(a,i) 
#-----------Scalar variables-------------------------------------------------------------
      scalar  ZERO
      scalar  ONE
      scalar  TWO
      scalar  half
      scalar  sqrtwo
      scalar  rootcount
      scalar  trp_count
      scalar  sing_count
      scalar  etemp
      scalar  etemp_sq
      scalar  tresh
      SCALAR  ASUM
      SCALAR  BSUM
      SCALAR  A_SUM
      SCALAR  B_SUM
      scalar cnt
      scalar cnt_s
      scalar cnt_t 
      scalar rootmax
      scalar rootmax1
      scalar ind
      scalar sct
      scalar tct
      scalar tct1
      scalar tct2 
      scalar E_ccsd
      scalar cnt1
      scalar cnt2
      scalar so_ci_size
      scalar cnt1_size
      scalar cnt2_size
      scalar mark1
      scalar mark2
      scalar mark3
      scalar mark4
      scalar mark5
      scalar tmpval
      scalar ecorr
      scalar so_pref
      scalar auxval
      scalar tmpval1
      scalar tmpval2
      scalar tmpval3
      scalar tmpval4
      scalar tmpval5
      scalar tmpval6
      scalar tmpval7
      scalar tmpval8
      scalar tmpval9
      scalar tmpval10 
      scalar tmpval11
      scalar tmpval12
      scalar tmpval13 
      scalar tmpval14 
      scalar tmpval15 
      scalar tmpval16 
      scalar tmpval17 
      scalar tmpval18
      scalar tmpval19
      scalar tmpval20
      scalar tmpval21
      scalar tmpval22
      scalar tmpval23
      scalar tmpval24
      scalar tmpval25
      scalar tmpval26
      scalar tmpval_re
      scalar tmpval_im 

      scalar LROVER
      scalar LROVER_aa
      scalar LROVER_bb
      scalar LROVER_aaaa
      scalar LROVER_bbbb
      scalar LROVER_aabb 
      scalar NORM 
      scalar norm_sqr  
      scalar mind1
      scalar mind2
      scalar mind3
      scalar mind4 
#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
      PROC READ_DATA
#     -------------- 

      create REE
      create LEE
      create t1a
      create t1b
      create A1a
      create A1b
      create R1A_VECS
      create R1B_VECS
      create L1A_VECS
      create L1B_VECS
      create HBAR_ia
      create HBAR_jb  
#----------------Read data from EE-EOM-CCSD----------- 

           execute list_to_blocks               REE
           execute list_to_blocks               EE_EVEC_R_p_a
           execute list_to_blocks               EE_EVEC_R_p_b
           execute list_to_blocks               EE_EVEC_R_abi_aaa
           execute list_to_blocks               EE_EVEC_R_abi_bbb
           execute list_to_blocks               EE_EVEC_R_abi_abb
           execute list_to_blocks               EE_EVEC_L_p_a
           execute list_to_blocks               EE_EVEC_L_p_b
           execute list_to_blocks               EE_EVEC_L_abi_aaa
           execute list_to_blocks               EE_EVEC_L_abi_bbb
           execute list_to_blocks               EE_EVEC_L_abi_abb
           execute list_to_blocks               t1a
           execute list_to_blocks               t1b
           execute list_to_blocks               T2aa
           execute list_to_blocks               T2bb
           execute list_to_blocks               T2ab
           execute list_to_blocks               A1a
           execute list_to_blocks               A1b
           execute list_to_blocks               A2aa
           execute list_to_blocks               A2bb
           execute list_to_blocks               A2ab

      execute read_list_to_blocks
      execute sip_barrier
      execute server_barrier
#---------Preparation on arrays-----------------------------

#-------------Eigenvalues----------------------------------
#        cnt1 = 0.0    
#        DO kroot 
#        cnt1 += 1.0   

#        cnt2 = 0.0
#        DO target_roots
#        cnt2 += 1.0   
  
#        IF cnt1 == cnt2 
#        DO kk1
#        troot(kroot,kk1) = 0.0
#        REQUEST EE_EVAL1(kk1,target_roots) kk1 
#        tmp_EE_EVAL1(kk1,target_roots) = EE_EVAL1(kk1,target_roots)
#        tkk(kk1) = tmp_EE_EVAL1(kk1,target_roots)   
#        execute addrootindex tkk troot
#        PUT REE (kroot,kk1) = troot(kroot,kk1) 
#        ENDDO kk1
#        ENDIF 
#        ENDDO target_roots 
#        ENDDO kroot
#        execute sip_barrier
#-------------Eigenvectors--------------------------------- 
        cnt1 = 0.0
        DO kroot
        cnt1 += 1.0

        cnt2 = 0.0
        DO target_roots
        cnt2 += 1.0

        IF cnt1 == cnt2
        DO kk1
#-------------Right vectors---------------------------------
        PARDO i,a
        tzT1_R1A(a,i,kroot) = 0.0
        REQUEST EE_EVEC_R_p_a(a,i,target_roots) i
        tqT1_R1A(a,i,target_roots) = EE_EVEC_R_p_a(a,i,target_roots)
        T1_R1A(a,i) = tqT1_R1A(a,i,target_roots)
        execute addrootindex T1_R1A tzT1_R1A
        PUT R1A_VECS(a,i,kroot) = tzT1_R1A(a,i,kroot)
        ENDPARDO i,a
        execute sip_barrier

        PARDO j,b
        tzT1_R1B(b,j,kroot) = 0.0
        REQUEST EE_EVEC_R_p_b(b,j,target_roots) j
        tqT1_R1B(b,j,target_roots) = EE_EVEC_R_p_b(b,j,target_roots)
        T1_R1B(b,j) = tqT1_R1B(b,j,target_roots)
        execute addrootindex T1_R1B tzT1_R1B
        PUT R1B_VECS(b,j,kroot) = tzT1_R1B(b,j,kroot)
        ENDPARDO j,b
        execute sip_barrier
         
        PARDO a,i,c1,i1 
        tTR2AA_VECS (a,i,c1,i1,kroot) = 0.0
        REQUEST EE_EVEC_R_abi_aaa(a,i,c1,i1,target_roots) i 
        tqTR2AA_VECS (a,i,c1,i1,target_roots) = EE_EVEC_R_abi_aaa(a,i,c1,i1,target_roots)
        TR2_VECS(a,i,c1,i1) = tqTR2AA_VECS (a,i,c1,i1,target_roots)
        execute addrootindex TR2_VECS tTR2AA_VECS 
        PREPARE R2AA_VECS(a,i,c1,i1,kroot) = tTR2AA_VECS (a,i,c1,i1,kroot)
        ENDPARDO a,i,c1,i1
        execute server_barrier

        PARDO b,j,d,j1
        tTR2BB_VECS (b,j,d,j1,kroot) = 0.0
        REQUEST EE_EVEC_R_abi_bbb(b,j,d,j1,target_roots) j
        tqTR2BB_VECS(b,j,d,j1,target_roots) = EE_EVEC_R_abi_bbb(b,j,d,j1,target_roots)
        TR2_VECS(b,j,d,j1) = tqTR2BB_VECS(b,j,d,j1,target_roots)
        execute addrootindex TR2_VECS tTR2BB_VECS
        PREPARE R2BB_VECS(b,j,d,j1,kroot) = tTR2BB_VECS(b,j,d,j1,kroot)
        ENDPARDO b,j,d,j1
        execute server_barrier

        PARDO a,i,b,j
        tTR2AB_VECS (a,i,b,j,kroot) = 0.0  
        REQUEST EE_EVEC_R_abi_abb(a,i,b,j,target_roots) j  
        tqTR2AB_VECS(a,i,b,j,target_roots) = EE_EVEC_R_abi_abb(a,i,b,j,target_roots)
        TR2_VECS(a,i,b,j) = tqTR2AB_VECS(a,i,b,j,target_roots) 
        execute addrootindex TR2_VECS tTR2AB_VECS  
        PREPARE R2AB_VECS(a,i,b,j,kroot) = tTR2AB_VECS(a,i,b,j,kroot)
        ENDPARDO a,i,b,j
        execute server_barrier   
#--------------Left vectors---------------------------------
        PARDO i,a
        tzT1_L1A(i,a,kroot) = 0.0
        REQUEST EE_EVEC_L_p_a(a,i,target_roots) i
        tqT1_L1A(a,i,target_roots) = EE_EVEC_L_p_a(a,i,target_roots)
        T1_R1A(a,i) = tqT1_L1A(a,i,target_roots)
        T1_L1A(i,a) = T1_R1A(a,i)
        execute addrootindex T1_L1A tzT1_L1A
        PUT L1A_VECS(i,a,kroot) = tzT1_L1A(i,a,kroot)
        ENDPARDO i,a
        execute sip_barrier

        PARDO j,b
        tzT1_L1B(j,b,kroot) = 0.0
        REQUEST EE_EVEC_L_p_b(b,j,target_roots) j
        tqT1_L1B(b,j,target_roots) = EE_EVEC_L_p_b(b,j,target_roots)
        T1_R1B(b,j) = tqT1_L1B(b,j,target_roots)
        T1_L1B(j,b) = T1_R1B(b,j)
        execute addrootindex T1_L1B tzT1_L1B
        PUT L1B_VECS(j,b,kroot) = tzT1_L1B(j,b,kroot)
        ENDPARDO j,b
        execute sip_barrier

        PARDO a,i,c1,i1
        tTL2AA_VECS (i,a,i1,c1,kroot) = 0.0
        REQUEST EE_EVEC_L_abi_aaa(a,i,c1,i1,target_roots) i
        tqTR2AA_VECS (a,i,c1,i1,target_roots) = EE_EVEC_L_abi_aaa(a,i,c1,i1,target_roots)
        TR2_VECS(a,i,c1,i1) = tqTR2AA_VECS (a,i,c1,i1,target_roots)
        TL2_VECS (i,a,i1,c1) = TR2_VECS(a,i,c1,i1)
        execute addrootindex TL2_VECS tTL2AA_VECS
        PREPARE L2AA_VECS(i,a,i1,c1,kroot) = tTL2AA_VECS (i,a,i1,c1,kroot)
        ENDPARDO a,i,c1,i1
        execute server_barrier

        PARDO b,j,d,j1
        tTL2BB_VECS (j,b,j1,d,kroot) = 0.0
        REQUEST EE_EVEC_L_abi_bbb(b,j,d,j1,target_roots) j
        tqTR2BB_VECS(b,j,d,j1,target_roots) = EE_EVEC_L_abi_bbb(b,j,d,j1,target_roots)
        TR2_VECS(b,j,d,j1) = tqTR2BB_VECS(b,j,d,j1,target_roots)
        TL2_VECS (j,b,j1,d) = TR2_VECS(b,j,d,j1)
        execute addrootindex TL2_VECS tTL2BB_VECS
        PREPARE L2BB_VECS(j,b,j1,d,kroot) = tTL2BB_VECS(j,b,j1,d,kroot)
        ENDPARDO b,j,d,j1
        execute server_barrier

        PARDO a,i,b,j
        tTL2AB_VECS (i,a,j,b,kroot) = 0.0
        REQUEST EE_EVEC_L_abi_abb(a,i,b,j,target_roots) j
        tqTR2AB_VECS(a,i,b,j,target_roots) = EE_EVEC_L_abi_abb(a,i,b,j,target_roots)
        TR2_VECS(a,i,b,j) = tqTR2AB_VECS(a,i,b,j,target_roots)
        TL2_VECS (i,a,j,b) = TR2_VECS(a,i,b,j)
        execute addrootindex TL2_VECS tTL2AB_VECS
        PREPARE L2AB_VECS(i,a,j,b,kroot) = tTL2AB_VECS(i,a,j,b,kroot)
        ENDPARDO a,i,b,j
        execute server_barrier

#-----------------------------------------------------------
        ENDDO kk1
        ENDIF
        ENDDO target_roots
        ENDDO kroot      
       
#----------------------------------------------------------

#-----------------------------------------------------------
      ENDPROC READ_DATA
#     ------------------

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|

      PROC RLOVERLAP
#     --------------

      create L1A_VECS_new
      create L1B_VECS_new


#-------------Step 1 - calculate overlap between left and right EOM vectors---------------|
      DO kroot
       DO kroot1 

      LROVER = 0.0
      LROVER_aa = 0.0
      LROVER_bb = 0.0
      LROVER_aaaa = 0.0
      LROVER_bbbb = 0.0
      LROVER_aabb = 0.0

#------alpha part----------------|
      tmpval = 0.0
      PARDO i,a
      GET L1A_VECS (i,a,kroot)
      L1_R1A(i,a) = L1A_VECS (i,a,kroot)
      GET R1A_VECS (a,i,kroot1)
      T1_R1A(a,i) = R1A_VECS(a,i,kroot1)      
      etemp = L1_R1A(i,a)*T1_R1A(a,i)
      tmpval += etemp
      ENDPARDO i,a
      execute server_barrier      

      collective LROVER_aa += tmpval   
#-------beta part----------------|
      tmpval = 0.0
      PARDO i,a
      GET L1B_VECS (i,a,kroot)
      L1_R1A(i,a) = L1B_VECS (i,a,kroot)
      GET R1B_VECS (a,i,kroot1)
      T1_R1A(a,i) = R1B_VECS(a,i,kroot1)
      etemp = L1_R1A(i,a)*T1_R1A(a,i)
      tmpval += etemp
      ENDPARDO i,a
      execute server_barrier

      collective LROVER_bb += tmpval
#-------alpha-alpha part---------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2AA_VECS (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2AA_VECS (i,a,j,b,kroot)
      REQUEST R2AA_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2AA_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      etemp *= 0.25
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_aaaa += tmpval 
#-------beta-beta part-----------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2BB_VECS (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2BB_VECS (i,a,j,b,kroot)
      REQUEST R2BB_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2BB_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      etemp *= 0.25
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_bbbb += tmpval
#-------alpha-beta part----------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2AB_VECS (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2AB_VECS (i,a,j,b,kroot)
      REQUEST R2AB_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2AB_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_aabb += tmpval
#--------------------------------|
       LROVER += LROVER_aa
       LROVER += LROVER_bb
       LROVER += LROVER_aaaa
       LROVER += LROVER_bbbb
       LROVER += LROVER_aabb

       overvec(kroot,kroot1) = LROVER

       ENDDO kroot1
      ENDDO kroot  

#-----Step 2 - reorder left eigenvectors according to overlap with rirgt eigenvectors-----|
#--------- also multiply left eigenvectors by normalization factors-----------------------|       
      
      DO kroot
      DO indone 
      lroot_ind(kroot,indone) = 0.0
      ENDDO indone 
      ENDDO kroot

#----------Generate root correspondence table-----------------------|        

      execute lrootcorr overvec lroot_ind

#----------Create ordered left eigenvectors arrays-------------------|
     DO kroot
     DO indone
     troot(kroot,indone) = lroot_ind(kroot,indone)
     execute return_sval troot ind    
     ENDDO indone
          cnt = 0.0
          DO kroot1
          cnt += 1.0

          IF cnt == ind  
          tover(kroot1,kroot) = overvec(kroot1,kroot)
          execute return_sval tover tmpval

               norm_sqr = tmpval
               norm_sqr *= tmpval
               half = 0.5
               execute square_root norm_sqr half
              
#               execute print_scalar tmpval

               IF norm_sqr > 0.000001 
               NORM = 1.0/tmpval
               ENDIF

               IF norm_sqr < 0.000001
               NORM = 1.0
               ENDIF

               execute print_scalar NORM
#----------------------------------|
          PARDO i,a
          tT1_L1A(i,a,kroot) = 0.0
          GET L1A_VECS (i,a,kroot1)
          L1_R1A(i,a) = L1A_VECS (i,a,kroot1)
          L1_R1A(i,a) *= NORM 
          execute addrootindex L1_R1A tT1_L1A
          PUT L1A_VECS_new (i,a,kroot) = tT1_L1A(i,a,kroot)
          ENDPARDO i,a
          execute sip_barrier 
#----------------------------------|
          PARDO i,a
          tT1_L1B(i,a,kroot) = 0.0
          GET L1B_VECS (i,a,kroot1)
          L1_R1B(i,a) = L1B_VECS (i,a,kroot1)
          L1_R1B(i,a) *= NORM 
          execute addrootindex L1_R1B tT1_L1B
          PUT L1B_VECS_new (i,a,kroot) = tT1_L1B(i,a,kroot)
          ENDPARDO i,a
          execute sip_barrier
#----------------------------------|
          PARDO i,a,j,b 
          tTL2AA_VECS (i,a,j,b,kroot) = 0.0
          REQUEST L2AA_VECS (i,a,j,b,kroot1) i
          TL2_VECS (i,a,j,b) = L2AA_VECS (i,a,j,b,kroot1)
          TL2_VECS (i,a,j,b) *= NORM
          execute addrootindex TL2_VECS tTL2AA_VECS
          PREPARE L2AA_VECS_new (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
          ENDPARDO i,a,j,b
          execute server_barrier
#----------------------------------|
          PARDO i,a,j,b
          tTL2AA_VECS (i,a,j,b,kroot) = 0.0
          REQUEST L2BB_VECS (i,a,j,b,kroot1) i
          TL2_VECS (i,a,j,b) = L2BB_VECS (i,a,j,b,kroot1)
          TL2_VECS (i,a,j,b) *= NORM
          execute addrootindex TL2_VECS tTL2AA_VECS
          PREPARE L2BB_VECS_new (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
          ENDPARDO i,a,j,b
          execute server_barrier
#----------------------------------|
          PARDO i,a,j,b
          tTL2AA_VECS (i,a,j,b,kroot) = 0.0
          REQUEST L2AB_VECS (i,a,j,b,kroot1) i
          TL2_VECS (i,a,j,b) = L2AB_VECS (i,a,j,b,kroot1)
          TL2_VECS (i,a,j,b) *= NORM
          execute addrootindex TL2_VECS tTL2AA_VECS
          PREPARE L2AB_VECS_new (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
          ENDPARDO i,a,j,b
          execute server_barrier
#----------------------------------|
          ENDIF 

          ENDDO kroot1
     ENDDO kroot

#----------Check of the overlap of new vectors----------------------|

      DO kroot
       DO kroot1

      LROVER = 0.0
      LROVER_aa = 0.0
      LROVER_bb = 0.0
      LROVER_aaaa = 0.0
      LROVER_bbbb = 0.0
      LROVER_aabb = 0.0

#------alpha part----------------|

      tmpval = 0.0
      PARDO i,a
      GET L1A_VECS_new (i,a,kroot)
      L1_R1A(i,a) = L1A_VECS_new (i,a,kroot)
      GET R1A_VECS (a,i,kroot1)
      T1_R1A(a,i) = R1A_VECS(a,i,kroot1)
      etemp = L1_R1A(i,a)*T1_R1A(a,i)
      tmpval += etemp
      ENDPARDO i,a
      execute server_barrier

      collective LROVER_aa += tmpval
#-------beta part----------------|
      tmpval = 0.0
      PARDO i,a
      GET L1B_VECS_new (i,a,kroot)
      L1_R1A(i,a) = L1B_VECS_new (i,a,kroot)
      GET R1B_VECS (a,i,kroot1)
      T1_R1A(a,i) = R1B_VECS(a,i,kroot1)
      etemp = L1_R1A(i,a)*T1_R1A(a,i)
      tmpval += etemp
      ENDPARDO i,a
      execute server_barrier

      collective LROVER_bb += tmpval
#-------alpha-alpha part---------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2AA_VECS_new (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2AA_VECS_new (i,a,j,b,kroot)
      REQUEST R2AA_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2AA_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      etemp *= 0.25
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_aaaa += tmpval
#-------beta-beta part-----------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2BB_VECS_new (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2BB_VECS_new (i,a,j,b,kroot)
      REQUEST R2BB_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2BB_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      etemp *= 0.25
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_bbbb += tmpval
#-------alpha-beta part----------|
      tmpval = 0.0
      PARDO a,i,b,j
      REQUEST L2AB_VECS_new (i,a,j,b,kroot) i
      TL2_VECS (i,a,j,b) = L2AB_VECS_new (i,a,j,b,kroot)
      REQUEST R2AB_VECS (a,i,b,j,kroot1) i
      TR2_VECS (a,i,b,j) = R2AB_VECS (a,i,b,j,kroot1)
      etemp = TL2_VECS (i,a,j,b)*TR2_VECS (a,i,b,j)
      tmpval += etemp
      ENDPARDO a,i,b,j
      execute server_barrier

      collective LROVER_aabb += tmpval
#--------------------------------|
       LROVER += LROVER_aa
       LROVER += LROVER_bb
       LROVER += LROVER_aaaa
       LROVER += LROVER_bbbb
       LROVER += LROVER_aabb

       overvec1(kroot,kroot1) = LROVER

       ENDDO kroot1
      ENDDO kroot

      execute prsolrover overvec1(kroot,kroot1)
#-------------------------------------------------------------------|
      ENDPROC RLOVERLAP
#     -----------------

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
      PROC FIND_TRIPLETS
#     ------------------
#------------------------------------------------|
#   for triplet roots we have:                   |
#      r_ia(alpha) = - r_ia(beta)                |
#------------------------------------------------|

         trp_count = 0.0
         rootcount = 0.0
         cnt = 0.0
         rootmax = eom_roots
         ONE = 1.0

         rootmax1 = rootmax 
         rootmax1 *= 2.0

         DO kroot
         cnt += 1.0
         IF cnt > rootmax1
         EXIT
         ENDIF

         ASUM = 0.0
         BSUM = 0.0
         A_SUM = 0.0
         B_SUM = 0.0     

            PARDO a, i
                   GET  R1A_VECS (a,i,kroot)
                   T1_R1A(a,i)    = R1A_VECS (a,i,kroot)
                   EXECUTE SUM_2D_ARRAY T1_R1A ASUM
            ENDPARDO a, i
            execute server_barrier
            COLLECTIVE A_SUM += ASUM  

            PARDO b, j
                   GET  R1B_VECS (b,j,kroot)
                   T1_R1B(b,j)    = R1B_VECS (b,j,kroot)
                   EXECUTE SUM_2D_ARRAY T1_R1B BSUM
            ENDPARDO b, j
            execute server_barrier
            COLLECTIVE B_SUM += BSUM

#            execute print_scalar A_SUM
#            execute print_scalar B_SUM  

            etemp = A_SUM 
            etemp += B_SUM

            IF etemp < 0.0
            etemp *= -1.0
            endif 

#            execute print_scalar etemp

            DO indone 
            root_ind(kroot,indone) = 0.0

            IF etemp < tresh
               rootcount += 1
               root_ind(kroot,indone) = ONE
            ENDIF
            ENDDO indone
         ENDDO kroot

         trp_count = rootcount

         EXECUTE  SERVER_BARRIER

         execute print_scalar trp_count 

      ENDPROC FIND_TRIPLETS
#     --------------------- 

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|

      PROC FIND_SINGLETS
#     ------------------
#------------------------------------------------|
#   for singlet roots we have:                   |
#      r_ia(alpha) = r_ia(beta)                  |
#------------------------------------------------|


         sing_count = 0
         rootcount = 0
         TWO = 2.0

         ASUM = 0.0
         BSUM = 0.0
         A_SUM = 0.0
         B_SUM = 0.0
         cnt = 0.0
         rootmax = eom_roots

         rootmax1 = rootmax
         rootmax1 *= 2.0


         DO kroot
         cnt += 1.0
         IF cnt > rootmax1
         EXIT
         ENDIF

            PARDO a, i
                   GET  R1A_VECS (a,i,kroot)
                   T1_R1A(a,i)    = R1A_VECS (a,i,kroot)
                   EXECUTE SUM_2D_ARRAY T1_R1A ASUM
            ENDPARDO a, i
            execute server_barrier
            COLLECTIVE A_SUM += ASUM  

            PARDO b, j
                   GET  R1B_VECS (b,j,kroot)
                   T1_R1B(b,j)    = R1B_VECS (b,j,kroot)
                   EXECUTE SUM_2D_ARRAY T1_R1B BSUM
            ENDPARDO b, j
            execute server_barrier
            COLLECTIVE B_SUM += BSUM

#            execute print_scalar A_SUM
#            execute print_scalar B_SUM

            etemp = A_SUM 
            etemp -= B_SUM
              
            IF etemp < 0.0
            etemp *= -1.0
            endif
               


            DO indone 

            IF etemp < tresh
               rootcount += 1
               root_ind(kroot,indone) = TWO
            ENDIF
            ENDDO indone
         ENDDO kroot

         sing_count = rootcount

         EXECUTE  SERVER_BARRIER

         execute print_scalar sing_count


      ENDPROC FIND_SINGLETS
#     --------------------- 

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
      PROC COPY_ST
#     ------------ 

      create  R1A_VECS_T 
      create  R1B_VECS_T 
      create  R1A_VECS_S 
      create  R1B_VECS_S 
      create  L1A_VECS_T 
      create  L1B_VECS_T 
      create  L1A_VECS_S 
      create  L1B_VECS_S 
#----------Zero out singlet and triplet vectors arrays-------------------
      DO kroot

#-------------Singles-------------------------------------
       PARDO a, i
       tT1_R1A(a,i,kroot) = 0.0
       PUT R1A_VECS_T(a,i,kroot) = tT1_R1A(a,i,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_R1B(a,i,kroot) = 0.0
       PUT R1B_VECS_T(a,i,kroot) = tT1_R1B(a,i,kroot)
       ENDPARDO a,i
       execute sip_barrier      

       PARDO a, i
       tT1_R1A(a,i,kroot) = 0.0
       PUT R1A_VECS_S(a,i,kroot) = tT1_R1A(a,i,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_R1B(a,i,kroot) = 0.0
       PUT R1B_VECS_S(a,i,kroot) = tT1_R1B(a,i,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i 
       tT1_L1A(i,a,kroot) = 0.0
       PUT L1A_VECS_T(i,a,kroot) = tT1_L1A(i,a,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_L1B(i,a,kroot) = 0.0
       PUT L1B_VECS_T(i,a,kroot) = tT1_L1B(i,a,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_L1A(i,a,kroot) = 0.0
       PUT L1A_VECS_S(i,a,kroot) = tT1_L1A(i,a,kroot)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_L1B(i,a,kroot) = 0.0
       PUT L1B_VECS_S(i,a,kroot) = tT1_L1B(i,a,kroot)
       ENDPARDO a,i
       execute sip_barrier


#-------------Doubles----------------------------------------
       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2AA_VECS_T(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot) 
       ENDPARDO i,a,b,j
       execute server_barrier 

       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2BB_VECS_T(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot)
       ENDPARDO i,a,b,j
       execute server_barrier

       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2AB_VECS_T(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot)
       ENDPARDO i,a,b,j
       execute server_barrier

       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2AA_VECS_S(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot)
       ENDPARDO i,a,b,j
       execute server_barrier

       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2BB_VECS_S(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot)
       ENDPARDO i,a,b,j
       execute server_barrier

       PARDO i,a,b,j
       tTR2AA_VECS (a,i,b,j,kroot) = 0.0
       PREPARE R2AB_VECS_S(a,i,b,j,kroot) = tTR2AA_VECS (a,i,b,j,kroot)
       ENDPARDO i,a,b,j
       execute server_barrier
#-----------------------------------------------------------------------
       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2AA_VECS_T (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier 

       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2BB_VECS_T (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2AB_VECS_T (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2AA_VECS_S (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2BB_VECS_S (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTL2AA_VECS (i,a,j,b,kroot) = 0.0
       PREPARE L2AB_VECS_S (i,a,j,b,kroot) = tTL2AA_VECS (i,a,j,b,kroot)
       ENDPARDO a,i,b,j
       execute server_barrier

      ENDDO kroot 

       DO kroot 
        DO indone
         roots_T(kroot,indone) = 0.0
         roots_S(kroot,indone) = 0.0
        ENDDO indone
       ENDDO kroot         

#|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
#       COPY VECTORS INTO TRIPLET AND SINGLET ARRAYS                 |
#\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\|
      rootmax = eom_roots
      rootmax1 = rootmax
      rootmax1 *= 2.0
      cnt = 0.0 
      sct = 0.0
      tct = 0.0 

      DO kroot
         cnt += 1.0
         IF cnt > rootmax1
         EXIT
         ENDIF
           
         DO indone 
         troot(kroot,indone) = root_ind(kroot,indone)
         execute return_sval troot ind 
#         execute print_scalar ind

#-----------Triplets----------------------------------
         IF ind == 1.0 
         tct += 1.0
         cnt_t = 0.0
           DO kroot1
           cnt_t += 1.0
           IF cnt_t == tct 

#           execute print_scalar cnt_t
#------------Eigenvalues-----------------------
            GET REE (kroot,indone)
            troot1(kroot,indone) = REE (kroot,indone)
            execute return_sval troot1 tmpval             
            roots_T(kroot1,indone) = tmpval
#-------------Right vectors--------------------
       PARDO a, i
       tT1_R1A(a,i,kroot1) = 0.0
       GET R1A_VECS (a,i,kroot)
       T1_R1A(a,i) = R1A_VECS (a,i,kroot)
       execute addrootindex T1_R1A tT1_R1A
       PUT R1A_VECS_T(a,i,kroot1) = tT1_R1A(a,i,kroot1)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_R1B(a,i,kroot1) = 0.0
       GET R1B_VECS (a,i,kroot)
       T1_R1B(a,i) = R1B_VECS (a,i,kroot)
       execute addrootindex T1_R1B tT1_R1B
       PUT R1B_VECS_T(a,i,kroot1) = tT1_R1B(a,i,kroot1)
       ENDPARDO a,i
       execute sip_barrier
#---------------------------------------------
       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2AA_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2AA_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2AA_VECS_T(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2BB_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2BB_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2BB_VECS_T(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2AB_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2AB_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2AB_VECS_T(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

#-------------Left vectors---------------------
       PARDO i,a
       tT1_L1A(i,a,kroot1) = 0.0 
       GET L1A_VECS_new (i,a,kroot)
       L1_R1A(i,a) = L1A_VECS_new (i,a,kroot)
       execute addrootindex L1_R1A tT1_L1A
       PUT L1A_VECS_T (i,a,kroot1) = tT1_L1A(i,a,kroot1)  
       ENDPARDO i,a
       execute sip_barrier

       PARDO i,a
       tT1_L1B(i,a,kroot1) = 0.0
       GET L1B_VECS_new (i,a,kroot)
       L1_R1B(i,a) = L1B_VECS_new (i,a,kroot)
       execute addrootindex L1_R1B tT1_L1B
       PUT L1B_VECS_T (i,a,kroot1) = tT1_L1B(i,a,kroot1)
       ENDPARDO i,a
       execute sip_barrier
#-------------------------------------
       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0 
       REQUEST L2AA_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2AA_VECS_new (i,a,j,b,kroot) 
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2AA_VECS_T (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1) 
       ENDPARDO i,a,j,b
       execute server_barrier 

       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0
       REQUEST L2BB_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2BB_VECS_new (i,a,j,b,kroot)
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2BB_VECS_T (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1)
       ENDPARDO i,a,j,b
       execute server_barrier

       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0
       REQUEST L2AB_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2AB_VECS_new (i,a,j,b,kroot)
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2AB_VECS_T (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1)
       ENDPARDO i,a,j,b
       execute server_barrier

#----------------------------------------------
           ENDIF
           ENDDO kroot1 
         ENDIF

#-----------Singlets----------------------------------
         IF ind == 2.0
         sct += 1.0 
         cnt_s = 0.0
           DO kroot1
           cnt_s += 1.0
           IF cnt_s == sct 

#           execute print_scalar cnt_s
#-------------Eigenvalues----------------------
            GET REE (kroot,indone)
            troot1(kroot,indone) = REE (kroot,indone)
            execute return_sval troot1 tmpval
            roots_S(kroot1,indone) = tmpval
#-------------Right vectors--------------------
       PARDO a, i
       tT1_R1A(a,i,kroot1) = 0.0
       GET R1A_VECS (a,i,kroot) 
       T1_R1A(a,i) = R1A_VECS (a,i,kroot)
       execute addrootindex T1_R1A tT1_R1A
       PUT R1A_VECS_S(a,i,kroot1) = tT1_R1A(a,i,kroot1)
       ENDPARDO a,i
       execute sip_barrier

       PARDO a, i
       tT1_R1B(a,i,kroot1) = 0.0
       GET R1B_VECS (a,i,kroot)
       T1_R1B(a,i) = R1B_VECS (a,i,kroot) 
       execute addrootindex T1_R1B tT1_R1B
       PUT R1B_VECS_S(a,i,kroot1) = tT1_R1B(a,i,kroot1)
       ENDPARDO a,i
       execute sip_barrier
#----------------------------------------------
       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2AA_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2AA_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2AA_VECS_S(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2BB_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2BB_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2BB_VECS_S(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

       PARDO a,i,b,j
       tTR2AA_VECS (a,i,b,j,kroot1) = 0.0
       REQUEST R2AB_VECS (a,i,b,j,kroot) a
       TR2_VECS (a,i,b,j) = R2AB_VECS (a,i,b,j,kroot)
       execute addrootindex TR2_VECS tTR2AA_VECS
       PREPARE R2AB_VECS_S(a,i,b,j,kroot1) = tTR2AA_VECS (a,i,b,j,kroot1)
       ENDPARDO a,i,b,j
       execute server_barrier

#-------------Left vectors---------------------
       PARDO i,a
       tT1_L1A(i,a,kroot1) = 0.0
       GET L1A_VECS_new (i,a,kroot)
       L1_R1A(i,a) = L1A_VECS_new (i,a,kroot)
       execute addrootindex L1_R1A tT1_L1A
       PUT L1A_VECS_S (i,a,kroot1) = tT1_L1A(i,a,kroot1)
       ENDPARDO i,a
       execute sip_barrier

       PARDO i,a
       tT1_L1B(i,a,kroot1) = 0.0
       GET L1B_VECS_new (i,a,kroot)
       L1_R1B(i,a) = L1B_VECS_new (i,a,kroot)
       execute addrootindex L1_R1B tT1_L1B
       PUT L1B_VECS_S (i,a,kroot1) = tT1_L1B(i,a,kroot1)
       ENDPARDO i,a
       execute sip_barrier
#----------------------------------------------
       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0
       REQUEST L2AA_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2AA_VECS_new (i,a,j,b,kroot)
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2AA_VECS_S (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1)
       ENDPARDO i,a,j,b
       execute server_barrier

       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0
       REQUEST L2BB_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2BB_VECS_new (i,a,j,b,kroot)
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2BB_VECS_S (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1)
       ENDPARDO i,a,j,b
       execute server_barrier

       PARDO i,a,j,b
       tTL2AA_VECS (i,a,j,b,kroot1) = 0.0
       REQUEST L2AB_VECS_new (i,a,j,b,kroot) i
       TL2_VECS (i,a,j,b) = L2AB_VECS_new (i,a,j,b,kroot)
       execute addrootindex TL2_VECS tTL2AA_VECS
       PREPARE L2AB_VECS_S (i,a,j,b,kroot1) = tTL2AA_VECS (i,a,j,b,kroot1)
       ENDPARDO i,a,j,b
       execute server_barrier


#----------------------------------------------
           ENDIF 
           ENDDO kroot1 
         ENDIF

         ENDDO indone
      ENDDO kroot
#----------Print out non-relativistic eigenvalues to the output file----------
      DO kroot
       DO indone
       GET REE (kroot,indone)
       troot(kroot,indone) = REE (kroot,indone) 
       roots(kroot,indone) = troot(kroot,indone) 
       ENDDO indone
      ENDDO kroot

      execute print_eomso_roots roots root_ind 
 
      ENDPROC COPY_ST
#     ---------------

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
      PROC NR_EOM_CONTR
#     ------------------ 

#--------Step 1 - zero out EOM-SO-CI arrays--------------------------------
      DO soind1
      DO soind2
      ZERO = 0.0
      so_ci_re(soind1,soind2) = ZERO      
      ENDDO soind2
      ENDDO soind1  

      DO soind1
      DO soind2
      ZERO = 0.0
      so_ci_im(soind1,soind2) = ZERO
      ENDDO soind2
      ENDDO soind1
#----------------------------------------------------------------------------
      so_ci_size = 0.0
      so_ci_size += 1.0
      so_ci_size += sing_count 
      so_ci_size += trp_count
      so_ci_size += trp_count
      so_ci_size += trp_count
#--------------------------------
      mark1 = 2.0

      mark2 = mark1
      mark2 += sing_count  

      mark3 = mark2
      mark3 += trp_count

      mark4 = mark3
      mark4 += trp_count

      mark5 = mark4
      mark5 += trp_count
#--------------------------------
      sct = 0.0
      tct = 0.0
      tct1 = 0.0
      tct2 = 0.0

      cnt1_size = 0.0
#--------------------------------
      ecorr = totenerg
      ecorr -= scfeneg
      execute print_scalar ecorr
      E_ccsd = ecorr 
#--------------------------------
      DO soind1
      cnt2_size = 0.0
      cnt1_size += 1.0
         IF cnt1_size > so_ci_size
#         EXIT
         ENDIF
   
         DO soind2
         cnt2_size += 1.0
         IF cnt2_size > so_ci_size
#         EXIT
         ENDIF 

#---------Step 2 - adding elements to blocks 1,7,13,19,25--------------------
                  
#--------------------block 1-------------------------------------------------
         IF cnt1_size == 1.0
            IF cnt2_size == 1.0
            so_ci_re(soind1,soind2) = E_ccsd
            ENDIF
         ENDIF
#--------------------block 7------------------------------------------------- 
          IF cnt1_size >= mark1
          IF cnt1_size < mark2 
               IF cnt2_size >= mark1
               IF cnt2_size <  mark2
                    IF cnt1_size == cnt2_size
                    sct += 1.0
                        cnt = 0.0
                        tmpval = 0.0
                        DO kroot
                         DO indone
                         cnt += 1.0
                          IF cnt == sct
                          troot(kroot,indone)=roots_S(kroot,indone)
                          execute return_sval troot tmpval
                          tmpval += E_ccsd 
                          ENDIF
                         ENDDO indone
                        ENDDO kroot

                    so_ci_re(soind1,soind2) = tmpval
                    ENDIF
               ENDIF
               ENDIF
          ENDIF
          ENDIF
#--------------------block 13------------------------------------------------ 
          IF cnt1_size >= mark2
          IF cnt1_size < mark3 
               IF cnt2_size >= mark2
               IF cnt2_size <  mark3
                    IF cnt1_size == cnt2_size
                    tct += 1.0 
                        cnt = 0.0
                        tmpval = 0.0
                        DO kroot
                         DO indone
                          cnt += 1.0
                          IF cnt == tct
                          troot(kroot,indone)=roots_T(kroot,indone)
                          execute return_sval troot tmpval
                          tmpval += E_ccsd
                          ENDIF
                         ENDDO indone
                        ENDDO kroot

                    so_ci_re(soind1,soind2) = tmpval
                    ENDIF
               ENDIF
               ENDIF
          ENDIF
          ENDIF
#--------------------block 19------------------------------------------------
          IF cnt1_size >= mark3
          IF cnt1_size < mark4
               IF cnt2_size >= mark3
               IF cnt2_size <  mark4
                    IF cnt1_size == cnt2_size
                    tct1 += 1.0
                        cnt = 0.0
                        tmpval = 0.0 
                        DO kroot
                         DO indone
                         cnt += 1.0
                          IF cnt == tct1
                          troot(kroot,indone)=roots_T(kroot,indone)
                          execute return_sval troot tmpval
                          tmpval += E_ccsd
                          ENDIF
                         ENDDO indone
                        ENDDO kroot

                    so_ci_re(soind1,soind2) = tmpval
                    ENDIF
               ENDIF
               ENDIF
          ENDIF
          ENDIF
#--------------------block 25------------------------------------------------
          IF cnt1_size >= mark4
          IF cnt1_size <  mark5
               IF cnt2_size >= mark4
               IF cnt2_size <  mark5 
                    IF cnt1_size == cnt2_size
                    tct2 += 1.0
                        cnt = 0.0
                        tmpval = 0.0
                        DO kroot
                         DO indone
                         cnt += 1.0
                          IF cnt == tct2
                          troot(kroot,indone)=roots_T(kroot,indone)
                          execute return_sval troot tmpval
                          tmpval += E_ccsd
                          ENDIF  
                         ENDDO indone
                        ENDDO kroot


                    so_ci_re(soind1,soind2) = tmpval
                    ENDIF
               ENDIF
               ENDIF
          ENDIF
          ENDIF
#----------------------------------------------------------------------------
         ENDDO soind2
      ENDDO soind1 

      execute server_barrier
      
      ENDPROC NR_EOM_CONTR
#     --------------------

#-----------------------------------------------------------------------------------------|
#-----------------------------------------------------------------------------------------|
      PROC SO_INT
#     ----------- 

      create SO_x_ao
      create SO_y_ao
      create SO_z_ao
      create SO_x_pmu
      create SO_y_pmu
      create SO_z_pmu
      create SO_x_pq
      create SO_y_pq
      create SO_z_pq

      PARDO mu,p
      tSO_x_pmu(mu,p) = 0.0
      PUT SO_x_pmu(mu,p) = tSO_x_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
      tSO_y_pmu(mu,p) = 0.0
      PUT SO_y_pmu(mu,p) = tSO_y_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
      tSO_z_pmu(mu,p) = 0.0
      PUT SO_z_pmu(mu,p) = tSO_z_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier
#--------------------------------------------
      PARDO p,q
      tSO_x_pq(p,q) = 0.0
      PUT SO_x_pq(p,q) = tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier   

      PARDO p,q
      tSO_y_pq(p,q) = 0.0
      PUT SO_y_pq(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_z_pq(p,q) = 0.0
      PUT SO_z_pq(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier
#---------------------------------------------
      create Fso_pq_x_aux
      create Fso_pq_y_aux
      create Fso_pq_z_aux


      PARDO p,q
      tSO_x_pq(p,q) = 0.0
      PUT Fso_pq_x_aux(p,q) = tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_y_pq(p,q) = 0.0
      PUT Fso_pq_y_aux(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_z_pq(p,q) = 0.0
      PUT Fso_pq_z_aux(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier
#---------------------------------------------


#--------Step 1 - calculate and transform one-electron spin-orbit integrals-------|

      PARDO mu,nu 
      Tmp_1SOIX(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_XBATCH Tmp_1SOIX(mu, nu)
      PUT SO_x_ao(mu,nu) = Tmp_1SOIX(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
      Tmp_1SOIY(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_YBATCH Tmp_1SOIY(mu, nu)
      PUT SO_y_ao(mu,nu) = Tmp_1SOIY(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
      Tmp_1SOIZ(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_ZBATCH Tmp_1SOIZ(mu, nu)
      PUT SO_z_ao(mu,nu) = Tmp_1SOIZ(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier
#------------------------------------------ 
      PARDO mu,nu
       GET SO_x_ao(mu,nu)
       Tmp_1SOIX(mu,nu) = SO_x_ao(mu,nu)
       DO p  
       tSO_x_pmu(mu,p) = Tmp_1SOIX(mu,nu)*ca(nu,p)
       PUT SO_x_pmu(mu,p) += tSO_x_pmu(mu,p)
       ENDDO p 
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
       GET SO_y_ao(mu,nu)
       Tmp_1SOIY(mu,nu) = SO_y_ao(mu,nu)
       DO p
       tSO_y_pmu(mu,p) = Tmp_1SOIY(mu,nu)*ca(nu,p)
       PUT SO_y_pmu(mu,p) += tSO_y_pmu(mu,p)
       ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
       GET SO_z_ao(mu,nu)
       Tmp_1SOIZ(mu,nu) = SO_z_ao(mu,nu)
       DO p
       tSO_z_pmu(mu,p) = Tmp_1SOIZ(mu,nu)*ca(nu,p)
       PUT SO_z_pmu(mu,p) += tSO_z_pmu(mu,p)
       ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier
#----------------------------------------------------------|
#     Prefactor of Pauli-Breit Hamiltonian:                |
#           alpha^2/2 = 1/2c^2                             |
            so_pref = 0.00002664 
#----------------------------------------------------------|
      PARDO mu,p
       GET SO_x_pmu(mu,p)
       tSO_x_pmu(mu,p) = SO_x_pmu(mu,p)
       DO q
       tSO_x_pq(q,p) = tSO_x_pmu(mu,p)*ca(mu,q)
       tSO_x_pq(q,p) *= so_pref 
       PUT SO_x_pq(q,p) += tSO_x_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier
  
      PARDO mu,p
       GET SO_y_pmu(mu,p)
       tSO_y_pmu(mu,p) = SO_y_pmu(mu,p)
       DO q
       tSO_y_pq(q,p) = tSO_y_pmu(mu,p)*ca(mu,q)
       tSO_y_pq(q,p) *= so_pref
       PUT SO_y_pq(q,p) += tSO_y_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
       GET SO_z_pmu(mu,p)
       tSO_z_pmu(mu,p) = SO_z_pmu(mu,p)
       DO q
       tSO_z_pq(q,p) = tSO_z_pmu(mu,p)*ca(mu,q)
       tSO_z_pq(q,p) *= so_pref
       PUT SO_z_pq(q,p) += tSO_z_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier

#=================================================================================|
#--------Step 2 - calculate and transform two-electron spin-orbit integrals-------|
#=================================================================================|


        PARDO mu, lambda, nu

              allocate V1_4_x(mu,nu,lambda,*)

#-------------------------------------------------------------------------------|
# NOTE: Ajith's routines do calculation of 2-e SO integrals, where derivatives  |
#  are taken like this: ( [d/dx mu] nu |V_so| lambda sigma), i.e. first pair    |
#                       of indices                                              |  
#-------------------------------------------------------------------------------|

#-----------------First index transformation------------------------------------|
#                     x - component                                             |
#-------------------------------------------------------------------------------|
          DO sigma

             Tmp_2SOIX(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_XBATCH Tmp_2SOIX(lambda,sigma,mu,nu)


                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIX(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_x(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma

#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tixxi(i2,nu,lambda,i)           = V1_4_x(mu,nu,lambda,i)*ca(mu,i2)
                 PREPARE V2ixxi_x(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
              ENDDO i2
              ENDDO i

              deallocate V1_4_x(mu,nu,lambda,*)

        ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
        execute server_barrier  

#---------------------------------------------------------------------------------
#---------------------------------------------------------------------------------

        PARDO mu, lambda, nu

              allocate V1_4_y(mu,nu,lambda,*)

#-----------------First index transformation------------------------------------|
#                     y - component                                             |
#-------------------------------------------------------------------------------|
          DO sigma

             Tmp_2SOIY(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_YBATCH Tmp_2SOIY(lambda,sigma,mu,nu)

                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIY(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_y(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tixxi(i2,nu,lambda,i)           = V1_4_y(mu,nu,lambda,i)*ca(mu,i2)
                 PREPARE V2ixxi_y(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
              ENDDO i2
              ENDDO i

              deallocate V1_4_y(mu,nu,lambda,*)

        ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
        execute server_barrier
        
#---------------------------------------------------------------------------------
#---------------------------------------------------------------------------------

        PARDO mu, lambda, nu

              allocate V1_4_z(mu,nu,lambda,*)

#-----------------First index transformation------------------------------------|
#                     z - component                                             |
#-------------------------------------------------------------------------------|

          DO sigma

             Tmp_2SOIZ(lambda,sigma,mu,nu)  = 0.0
            EXECUTE COMPUTE_2SOI_ZBATCH Tmp_2SOIZ(lambda,sigma,mu,nu)

                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIZ(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_z(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tixxi(i2,nu,lambda,i)           = V1_4_z(mu,nu,lambda,i)*ca(mu,i2)
                 PREPARE V2ixxi_z(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
              ENDDO i2
              ENDDO i

              deallocate V1_4_z(mu,nu,lambda,*)

        ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
        execute server_barrier
        




#----------Third index transformation---------------------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_x(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_x(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_x(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier 
#-----------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_y(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_y(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_y(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier
#------------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_z(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_z(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_z(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier
#----------Fourth index transformation----------------------------------------|
#  At this point we generate <JQ|h_so(x/y/z)|PI> integrals                    |
#  Note the h_so = r12 x p2, i.e J index is affected by differential operator |
#-----------------------------------------------------------------------------|

        PARDO i2,p,lambda,i
              REQUEST V2ipxi_x(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_x(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_x(i2,p,q,i) += tipqi(i2,p,q,i) 
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#-----------------------------------------
        PARDO i2,p,lambda,i
              REQUEST V2ipxi_y(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_y(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_y(i2,p,q,i) += tipqi(i2,p,q,i)
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#-----------------------------------------
        PARDO i2,p,lambda,i
              REQUEST V2ipxi_z(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_z(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_z(i2,p,q,i) += tipqi(i2,p,q,i)
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#------------------------------------------------------------------------------

#|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

        PARDO mu, lambda, sigma

              allocate V2_4_x(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     x - component                                             |
#-------------------------------------------------------------------------------|
          DO nu

             Tmp_2SOIX(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_XBATCH Tmp_2SOIX(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIX(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_x(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_x(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_x(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i 
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_x(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_x(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i 

              deallocate V2_4_x(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
        execute server_barrier
#---------------------------------------------------------------------------------        
        PARDO mu, lambda, sigma

              allocate V2_4_y(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     y - component                                             |
#-------------------------------------------------------------------------------|
          DO nu

             Tmp_2SOIY(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_YBATCH Tmp_2SOIY(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIY(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_y(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_y(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_y(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_y(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_y(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i

              deallocate V2_4_y(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
        execute server_barrier
#---------------------------------------------------------------------------------        
        PARDO mu, lambda, sigma

              allocate V2_4_z(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     z - component                                             |
#-------------------------------------------------------------------------------|

          DO nu

             Tmp_2SOIZ(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_ZBATCH Tmp_2SOIZ(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIZ(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_z(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_z(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_z(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_z(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_z(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i

              deallocate V2_4_z(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
        execute server_barrier

#----------Third index transformation---------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_x(i2,i,lambda,sigma) i 
               tiixx(i2,i,lambda,sigma) = V2iixx_x(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_x(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_x(mu,i,i2,sigma) i 
              txiix(mu,i,i2,sigma) = V2xiix_x(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_x(p,i,i2,sigma) += tpiix(p,i,i2,sigma) 
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#-------------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_y(i2,i,lambda,sigma) i
               tiixx(i2,i,lambda,sigma) = V2iixx_y(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_y(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_y(mu,i,i2,sigma) i
              txiix(mu,i,i2,sigma) = V2xiix_y(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_y(p,i,i2,sigma) += tpiix(p,i,i2,sigma)
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#-------------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_z(i2,i,lambda,sigma) i
               tiixx(i2,i,lambda,sigma) = V2iixx_z(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_z(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_z(mu,i,i2,sigma) i
              txiix(mu,i,i2,sigma) = V2xiix_z(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_z(p,i,i2,sigma) += tpiix(p,i,i2,sigma)
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#----------Fourth index transformation----------------------------------------|
#  At this point we generate <IP|h_so(x/y/z)|JQ> and                          |
#                            <PI|h_so(x/y/z)|JQ> integrals                    |
#  Note the h_so = r12 x p2, i.e Q index is affected by differential operator |
#-----------------------------------------------------------------------------|
        PARDO i2,i,p,sigma
              REQUEST V2iipx_x(i2,i,p,sigma) i2 
              tiipx(i2,i,p,sigma) = V2iipx_x(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref 
              PREPARE V2iipq_x(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_x(p,i,i2,sigma) i2 
              tpiix(p,i,i2,sigma) = V2piix_x(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_x(p,i,i2,q) += tpiiq(p,i,i2,q) 
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#---------------------------------------------------------------
        PARDO i2,i,p,sigma
              REQUEST V2iipx_y(i2,i,p,sigma) i2
              tiipx(i2,i,p,sigma) = V2iipx_y(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref
              PREPARE V2iipq_y(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_y(p,i,i2,sigma) i2
              tpiix(p,i,i2,sigma) = V2piix_y(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_y(p,i,i2,q) += tpiiq(p,i,i2,q)
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#---------------------------------------------------------------
        PARDO i2,i,p,sigma
              REQUEST V2iipx_z(i2,i,p,sigma) i2
              tiipx(i2,i,p,sigma) = V2iipx_z(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref
              PREPARE V2iipq_z(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_z(p,i,i2,sigma) i2
              tpiix(p,i,i2,sigma) = V2piix_z(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_z(p,i,i2,q) += tpiiq(p,i,i2,q)
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#------------------------------------------------------------------------------|
#                Construction of the SOMF Fock operators                       |
#   F_so(pq) = h_so(pq) + sum_{M}(-2<MP|h_so|MQ>+3<PM|h_so|MQ>+3<Mp|h_so|qM>)  |
#   Additionally, all F_so will be multipled by factor 1/2 due to the          |
#             definition of second-quantized S(k) operators                    |
#------------------------------------------------------------------------------|
      create Fso_pq_x
      create Fso_pq_y
      create Fso_pq_z
      create somfex_x_1
      create somfex_y_1
      create somfex_z_1
      create somfex_x_2
      create somfex_y_2
      create somfex_z_2
      create somfex_x_3
      create somfex_y_3
      create somfex_z_3

#------------One-particle contributions------------------------------------------
      PARDO p,q  
      GET SO_x_pq(p,q) 
      tSO_x_pq(p,q) = SO_x_pq(p,q)
      tSO_x_pq(p,q) *= -0.5
      PUT Fso_pq_x(p,q) = tSO_x_pq(p,q)   
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET SO_y_pq(p,q) 
      tSO_y_pq(p,q) = SO_y_pq(p,q)
      tSO_y_pq(p,q) *= -0.5
      PUT Fso_pq_y(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET SO_z_pq(p,q) 
      tSO_z_pq(p,q) = SO_z_pq(p,q)
      tSO_z_pq(p,q) *= -0.5
      PUT Fso_pq_z(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

#------------Two-particle contributions------------------------------------------


#---------- <MP|h_so|MQ> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0      
      REQUEST V2iipq_x(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_x(i,j,p,q)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= 2.0
      tSO_x_pq(p,q) *= -0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2iipq_y(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_y(i,j,p,q)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= 2.0
      tSO_y_pq(p,q) *= -0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)    
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2iipq_z(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_z(i,j,p,q)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= 2.0
      tSO_z_pq(p,q) *= -0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier
#---------- <MP|h_so|QM> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_x(i,q,p,j) i 
      tipqi(i,q,p,j) = V2ipqi_x(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= 3.0
      tSO_x_pq(p,q) *= 0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier 

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_y(i,q,p,j) i
      tipqi(i,q,p,j) = V2ipqi_y(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= 3.0
      tSO_y_pq(p,q) *= 0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_z(i,q,p,j) i
      tipqi(i,q,p,j) = V2ipqi_z(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= 3.0
      tSO_z_pq(p,q) *= 0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier
#---------- <PM|h_so|MQ> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_x(p,i,j,q) i 
      tpiiq(p,i,j,q) = V2piiq_x(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= 3.0
      tSO_x_pq(p,q) *= 0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_y(p,i,j,q) i
      tpiiq(p,i,j,q) = V2piiq_y(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= 3.0
      tSO_y_pq(p,q) *= 0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_z(p,i,j,q) i
      tpiiq(p,i,j,q) = V2piiq_z(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= 3.0
      tSO_z_pq(p,q) *= 0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

#-----------Test of integrals------------------------------

      PARDO p,q
      GET Fso_pq_x(p,q)
      tSO_x_pq(p,q) = Fso_pq_x(p,q) 
#      execute dump_amp tSO_x_pq
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_y(p,q)
      tSO_y_pq(p,q) = Fso_pq_y(p,q)
#      execute dump_amp tSO_y_pq
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_z(p,q)
      tSO_z_pq(p,q) = Fso_pq_z(p,q)
#      execute dump_amp tSO_z_pq
      ENDPARDO p,q
      execute sip_barrier
#------------Similarity transformation-------------------------------------------

#--------------a,b part-------------------------
      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_x(b,i)   
      tSO_x_pq(a,b) = t1a(a,i)*Fso_pq_x(b,i)
      tSO_x_pq(a,b) *= -1.0 
      PUT Fso_pq_x_aux(a,b) += tSO_x_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier  

      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_y(b,i)
      tSO_y_pq(a,b) = t1a(a,i)*Fso_pq_y(b,i)
      tSO_y_pq(a,b) *= -1.0 
      PUT Fso_pq_y_aux(a,b) += tSO_y_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_z(b,i)
      tSO_z_pq(a,b) = t1a(a,i)*Fso_pq_z(b,i)
      tSO_z_pq(a,b) *= -1.0
      PUT Fso_pq_z_aux(a,b) += tSO_z_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier

#--------------i,j part-------------------------
      PARDO i,j,a  
      GET t1a(a,i)
      GET Fso_pq_x(j,a)
      tSO_x_pq(i,j) = t1a(a,i)*Fso_pq_x(j,a)   
      PUT Fso_pq_x_aux(i,j) += tSO_x_pq(i,j) 
      ENDPARDO i,j,a
      execute sip_barrier  

      PARDO i,j,a
      GET t1a(a,i)
      GET Fso_pq_y(j,a)
      tSO_y_pq(i,j) = t1a(a,i)*Fso_pq_y(j,a)
      PUT Fso_pq_y_aux(i,j) += tSO_y_pq(i,j)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,i)
      GET Fso_pq_z(j,a)
      tSO_z_pq(i,j) = t1a(a,i)*Fso_pq_z(j,a)
      PUT Fso_pq_z_aux(i,j) += tSO_z_pq(i,j)
      ENDPARDO i,j,a
      execute sip_barrier
#--------------a,i part--------------------------

#-------------------------------------------
      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_x(j,i)
      tSO_x_pq(a,i) = Fso_pq_x(j,i)*t1a(a,j)
      tSO_x_pq(a,i) *= -1.0
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_y(j,i)
      tSO_y_pq(a,i) = Fso_pq_y(j,i)*t1a(a,j)
      tSO_y_pq(a,i) *= -1.0
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_z(j,i)
      tSO_z_pq(a,i) = Fso_pq_z(j,i)*t1a(a,j)
      tSO_z_pq(a,i) *= -1.0
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier
#-------------------------------------------
      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_x(a,b)
      tSO_x_pq(a,i) = t1a(b,i)*Fso_pq_x(a,b)
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier   

      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_y(a,b)
      tSO_y_pq(a,i) = t1a(b,i)*Fso_pq_y(a,b)
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier 

      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_z(a,b)
      tSO_z_pq(a,i) = t1a(b,i)*Fso_pq_z(a,b)
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier
#-------------------------------------------
      PARDO a,i,b,j
      GET Fso_pq_x(j,b)
      REQUEST T2ab(a,j,b,i) a  
      TR2_VECS (a,j,b,i) = T2ab(a,j,b,i)
      tSO_x_pq(a,i) = TR2_VECS (a,j,b,i)*Fso_pq_x(j,b)
      tSO_x_pq(a,i) *= -1.0
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)  
      ENDPARDO a,i,b,j
      execute sip_barrier

      PARDO a,i,b,j
      GET Fso_pq_y(j,b)
      REQUEST T2ab(a,j,b,i) a
      TR2_VECS (a,j,b,i) = T2ab(a,j,b,i)
      tSO_y_pq(a,i) = TR2_VECS (a,j,b,i)*Fso_pq_y(j,b)
      tSO_y_pq(a,i) *= -1.0
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier
#-------------------------------------------
      PARDO a,i,b,j
      GET Fso_pq_z(j,b)
      REQUEST T2ab(a,i,b,j) a
      TR2_VECS (a,i,b,j) = T2ab(a,i,b,j)
      tSO_z_pq(a,i) = TR2_VECS (a,i,b,j)*Fso_pq_z(j,b)
      tSO_z_pq(a,i) *= -1.0
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier

      PARDO a,i,b,j
      GET Fso_pq_z(j,b)
      REQUEST T2aa(a,i,b,j) a
      TR2_VECS (a,i,b,j) = T2aa(a,i,b,j)
      tSO_z_pq(a,i) = TR2_VECS (a,i,b,j)*Fso_pq_z(j,b)
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier
#------------Addition of similarity transformed terms---------------------
      PARDO p,q
      GET Fso_pq_x_aux(p,q)
      tSO_x_pq(p,q) = Fso_pq_x_aux(p,q)
      tSO_x_pq(p,q) *= -1.0
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_y_aux(p,q)
      tSO_y_pq(p,q) = Fso_pq_y_aux(p,q)
      tSO_y_pq(p,q) *= -1.0
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_z_aux(p,q)
      tSO_z_pq(p,q) = Fso_pq_z_aux(p,q)
      tSO_z_pq(p,q) *= -1.0
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

#-------------------------------------------------------------------------
      ENDPROC SO_INT
#     --------------

#-----------------------------------------------------------------------------------------
#-----------------------------------------------------------------------------------------

      PROC SO_MATR
#     ------------

#---------------------------------------------------------------------------------|
#         Blocks 1,7 and 19 will not contain contributions from V_so              |
#               since <L(Sz=0)|V_so|R(Sz=0)> = 0                                  |
#---------------------------------------------------------------------------------|

#---------------------------------------------------------------------------------|
#         Block 25:   <L(T,Sz=1)|V_so|R(T,Sz=1)>                                  |
#         Block 13:  <L(T,Sz=-1)|V_so|R(T,Sz=-1)>                                 |
#         In fact, <L(T,Sz=1)|V_so|R(T,Sz=1)> = - <L(T,Sz=-1)|V_so|R(T,Sz=-1)>    |
#            so we can calculate two blocks from one calculation                  |
#---------------------------------------------------------------------------------|

#---------------------------------------------------------------------------------|
#              Contributions from singles                                         |
#---------------------------------------------------------------------------------|
      create ILR_ab
      create ILR_ij
      create ILR_2p_ab
      create ILR_2p_ij 
      create ILR_AB_2p_ab
      create ILR_AB_2p_ij 
      create ILR_AB1_2p_ab
      create ILR_AB1_2p_ij
      create ILR_AB2_2p_ab
      create ILR_AB2_2p_ij
      create ILR_AB3_2p_ab
      create ILR_AB3_2p_ij
#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1
       
                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier
               
                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

      ENDDO kroot1
      ENDDO kroot 
#------------------------------------------------------------

      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count    
                 
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A  
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)                     
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1) 
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                
                PARDO i,j,a
                    DO indone 
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)        
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier 
#------------------Two-particle intermediates-------------------------------------|

#------------------alpha-alpha and beta-beta contributions-----------------|
                PARDO i,j,a,b,d
                tILR_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_T (i,a,j,d,kroot) 
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_2p_ab
                PUT ILR_2p_ab(a,b,kroot,kroot1) += tILR_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_2p_ij
                PUT ILR_2p_ij(i,j,kroot,kroot1) += tILR_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier 
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------------Exchenge terms-----------------------------|
                PARDO i,j,a,b,d
                tILR_AB1_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,d,j,a,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,d,j,a) =  L2AB_VECS_T (i,d,j,a,kroot)
                taa(a,b) = TL2_VECS (i,d,j,a)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB1_2p_ab
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) += tILR_AB1_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB1_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (k,a,i,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (k,a,i,b) =  L2AB_VECS_T (k,a,i,b,kroot)
                tii(i,j) = TL2_VECS (k,a,i,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB1_2p_ij
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) += tILR_AB1_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#------------------------------------------------------| 
                PARDO i,j,a,b,d
                tILR_AB2_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB2_2p_ab
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) += tILR_AB2_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB2_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB2_2p_ij
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) += tILR_AB2_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#------------------------------------------------------|
                PARDO i,j,a,b,d
                tILR_AB3_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB3_2p_ab
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) += tILR_AB3_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB3_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB3_2p_ij
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) += tILR_AB3_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier



#----------------Step 2 - calculations of the matrix elements------------------------|

                 tmpval =  0.0
                 tmpval1 = 0.0
                 tmpval2 = 0.0
                 tmpval3 = 0.0
                 tmpval4 = 0.0
                 tmpval5 = 0.0
                 tmpval6 = 0.0
                 tmpval7 = 0.0
                 tmpval8 = 0.0
                 tmpval9 = 0.0
                 tmpval10 = 0.0
                 tmpval11 = 0.0
                 tmpval12 = 0.0

#-------------------Singles contributions--------------------------------------------|

                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1) 
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b) 
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b) 
                 auxval += etemp
                 ENDPARDO a,b  
                 execute server_barrier 

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)  
                 etemp = tii(i,j)*tSO_z_pq(j,i) 
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval 

                 tmpval += tmpval1 
                 tmpval += tmpval2
                 tmpval *= 2.0 

#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions---------------
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval

                 tmpval += tmpval3
                 tmpval += tmpval4
#-------------------alpha-beta contributions-------------------------------------------
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval5 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval6 += auxval

                 tmpval += tmpval5
                 tmpval += tmpval6

#-----------------Exchange terms--------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB1_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB1_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval7 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB1_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB1_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -1.0  
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval8 += auxval

                 tmpval += tmpval7
                 tmpval += tmpval8
#-----------------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval9 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval10 += auxval

                 tmpval += tmpval9
                 tmpval += tmpval10
#                 execute print_scalar tmpval
#-----------------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval11 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval12 += auxval

                 tmpval += tmpval11
                 tmpval += tmpval12


#--------------------------------------------------------------------------------------
#                 execute print_scalar cnt
#                 execute print_scalar cnt1
#                 execute print_scalar tmpval  

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
       mind1 = mark4
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark4
       mind2 += cnt1
       mind2 -= 1.0 

#       execute print_scalar mark4
#       execute print_scalar mind1
#       execute print_scalar mind2

#------------------------------------------------------------|
#       p = -ih d/dx, so we need to multiply tmpval by -1.0  |
#------------------------------------------------------------|


#-----------------Block 25 contributions----------------------|
       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp 
                  ENDIF  
                ENDIF
             ENDDO soind2
        ENDDO soind1   

#-----------------Block 13 contributions-----------------------|
#     is the negative of block 25 contribution                 |
#--------------------------------------------------------------|
       mind3 = mark2
       mind3 += cnt
       mind3 -= 1.0

       mind4 = mark2
       mind4 += cnt1
       mind4 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind3
                  IF cnt2_size == mind4
                  etemp = tmpval
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
        ENDDO soind1



#--------------------------------------------------------------------------------|

                ENDIF
             ENDDO kroot1
        ENDIF  
      ENDDO kroot  

#-------------------------------------------------------------------------------

#---------------------------------------------------------------------------------|
#         Block 9:   <L(S)|V_so|R(T,Sz=0)>                                        |
#---------------------------------------------------------------------------------|

#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

      ENDDO kroot1
      ENDDO kroot
#------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= sing_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count

#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|

                PARDO i,a,b
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_S (i,a,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_S (i,a,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_S (i,a,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_S (i,a,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#------------------Two-particle intermediates-------------------------------------|

#------------------alpha-alpha and beta-beta contributions-----------------|

                PARDO i,j,a,b,d
                tILR_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_2p_ab
                PUT ILR_2p_ab(a,b,kroot,kroot1) += tILR_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_2p_ij
                PUT ILR_2p_ij(i,j,kroot,kroot1) += tILR_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier



#----------------Step 2 - calculations of the matrix elements------------------------|

                 tmpval =  0.0
                 tmpval1 = 0.0
                 tmpval2 = 0.0
                 tmpval3 = 0.0
                 tmpval4 = 0.0
                 tmpval5 = 0.0
                 tmpval6 = 0.0
                 tmpval7 = 0.0
                 tmpval8 = 0.0
                 tmpval9 = 0.0
                 tmpval10 = 0.0
                 tmpval11 = 0.0
                 tmpval12 = 0.0

#-------------------Singles contributions--------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 tmpval += tmpval1
                 tmpval += tmpval2
                 tmpval *= 2.0

#              execute print_scalar cnt
#              execute print_scalar cnt1
#              execute print_scalar tmpval

#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions--------------- 

                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
#                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
#                 etemp *= 0.5
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval

                 tmpval += tmpval3
                 tmpval += tmpval4
#------------------alpha-beta contributions-------------------------------------------
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= 2.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval5 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -2.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval6 += auxval

                 tmpval += tmpval5
                 tmpval += tmpval6


#--------------------------------------------------------------------------------------
#              execute print_scalar cnt
#              execute print_scalar cnt1
#              execute print_scalar tmpval

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
       mind1 = mark1
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark3
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
        ENDDO soind1


#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot


#---------------------------------------------------------------------------------|
#                  Block 17:   <L(T,Sz=0)|V_so|R(S)>                              |
#---------------------------------------------------------------------------------|

#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

      ENDDO kroot1
      ENDDO kroot
#------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= sing_count

#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_S (b,i,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_S (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_S (a,j,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_S (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#------------------Two-particle intermediates-------------------------------------|


#------------------alpha-alpha and beta-beta contributions-----------------|
                PARDO i,j,a,b,d
                tILR_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_S (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_S (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_2p_ab
                PUT ILR_2p_ab(a,b,kroot,kroot1) += tILR_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_S (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_S (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_2p_ij
                PUT ILR_2p_ij(i,j,kroot,kroot1) += tILR_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_S (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_S (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_S (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_S (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier


#----------------Step 2 - calculations of the matrix elements------------------------|

                 tmpval =  0.0
                 tmpval1 = 0.0
                 tmpval2 = 0.0
                 tmpval3 = 0.0
                 tmpval4 = 0.0
                 tmpval5 = 0.0
                 tmpval6 = 0.0
                 tmpval7 = 0.0
                 tmpval8 = 0.0
                 tmpval9 = 0.0
                 tmpval10 = 0.0
                 tmpval11 = 0.0
                 tmpval12 = 0.0

#-------------------Singles contributions--------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval1 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval2 += auxval

                 tmpval += tmpval1
                 tmpval += tmpval2
                 tmpval *= 2.0


#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions---------------

                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
#                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
#                 etemp *= 0.5
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval

                 tmpval += tmpval3
                 tmpval += tmpval4
#------------------alpha-beta contributions-------------------------------------------
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_AB_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= 2.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval5 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -2.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval6 += auxval

                 tmpval += tmpval5
                 tmpval += tmpval6

#--------------------------------------------------------------------------------------
#              execute print_scalar cnt
#              execute print_scalar cnt1
#              execute print_scalar tmpval

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|

       mind1 = mark3
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark1
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1

#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot


      execute server_barrier
      execute sip_barrier 
#---------------------------------------------------------------------------------|
#                  Block 16:   <L(T,Sz=0)|V_so|0>                                 |
#---------------------------------------------------------------------------------|
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count
#----------------Step 1 - calculations of the matrix elements------------------------|

        tmpval =  0.0
        tmpval1 = 0.0

                 auxval  = 0.0
                 PARDO a,i
                 GET L1A_VECS_T (i,a,kroot)
                 L1_R1A(i,a) = L1A_VECS_T (i,a,kroot)
                 GET Fso_pq_z(a,i)
                 tSO_z_pq(a,i) = Fso_pq_z(a,i)
                 etemp = L1_R1A(i,a)*tSO_z_pq(a,i)
                 auxval += etemp
                 ENDPARDO a,i
                 execute server_barrier

                 collective tmpval1 += auxval

                 tmpval += tmpval1
                 tmpval *= 2.0

              execute print_scalar cnt
              execute print_scalar tmpval

                 
#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|

       mind1 = mark3
       mind1 += cnt
       mind1 -= 1.0

       mind2 = 1.0


       cnt1_size = 0.0
       DO soind1
       cnt1_size += 1.0
       cnt2_size = 0.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1

        ENDIF
      ENDDO kroot


#---------------------------------------------------------------------------------|
#         Block 4:   <0|(1+Lambda)V_so|R(T,Sz=0)>                                 |
#---------------------------------------------------------------------------------|
#------------------Zero out arrays-----------------------------
      DO kroot
      DO indone

                PARDO a,b
                rILR_ab(a,b,kroot,indone) = 0.0
                PREPARE LILR_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                rILR_ij(i,j,kroot,indone) = 0.0
                PREPARE LILR_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone) 
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                rILR_ab(a,b,kroot,indone) = 0.0
                PREPARE LILR_2p_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                rILR_ij(i,j,kroot,indone) = 0.0
                PREPARE LILR_2p_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                rILR_ab(a,b,kroot,indone) = 0.0
                PREPARE LILR_AB_2p_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                rILR_ij(i,j,kroot,indone) = 0.0
                PREPARE LILR_AB_2p_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j
                execute sip_barrier

      ENDDO indone
      ENDDO kroot    

#--------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count
        DO indone
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                rILR_ab(a,b,kroot,indone) = 0.0
                GET A1a(i,a)
                GET R1A_VECS_T (b,i,kroot)
                L1_R1A(i,a) = A1a(i,a) 
                T1_R1A(b,i) = R1A_VECS_T (b,i,kroot)
                taa(a,b) = L1_R1A(i,a)*T1_R1A(b,i)
                execute addrootindex taa rILR_ab
                PREPARE LILR_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                rILR_ij(i,j,kroot,indone) = 0.0
                GET A1a(i,a)
                GET R1A_VECS_T (a,j,kroot)
                L1_R1A(i,a) = A1a(i,a)
                T1_R1A(a,j) = R1A_VECS_T (a,j,kroot)
                tii(i,j) = L1_R1A(i,a)*T1_R1A(a,j)
                execute addrootindex tii rILR_ij
                PREPARE LILR_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,a
                execute sip_barrier
#------------------Two-particle intermediates-------------------------------------|

#------------------alpha-alpha and beta-beta contributions-----------------|
                PARDO i,j,a,b,d
                rILR_ab(a,b,kroot,indone) = 0.0
                REQUEST A2aa (i,a,j,d) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot)
                TL2_VECS (i,a,j,d) =  A2aa (i,a,j,d)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa rILR_ab
                PREPARE LILR_2p_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                rILR_ij(i,j,kroot,indone) = 0.0
                REQUEST A2aa (i,a,k,b) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot)
                TL2_VECS (i,a,k,b) =  A2aa (i,a,k,b)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii rILR_ij
                PREPARE LILR_2p_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                rILR_ab(a,b,kroot,indone) = 0.0
                REQUEST A2ab (i,a,j,d) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot)
                TL2_VECS (i,a,j,d) =  A2ab (i,a,j,d)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa rILR_ab
                PREPARE LILR_AB_2p_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                rILR_ij(i,j,kroot,indone) = 0.0
                REQUEST A2ab (i,a,k,b) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot)
                TL2_VECS (i,a,k,b) =  A2ab (i,a,k,b)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii rILR_ij
                PREPARE LILR_AB_2p_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,k,a,b
                execute sip_barrier


#----------------Step 2 - calculations of the matrix elements------------------------|
                 tmpval =  0.0
                 tmpval1 = 0.0
                 tmpval2 = 0.0
                 tmpval3 = 0.0
                 tmpval4 = 0.0
                 tmpval5 = 0.0
                 tmpval6 = 0.0
                 tmpval7 = 0.0
                 tmpval8 = 0.0
                 tmpval9 = 0.0
                 tmpval10 = 0.0
                 tmpval11 = 0.0
                 tmpval12 = 0.0

#-------------------Singles contributions--------------------------------------------|
                 auxval  = 0.0
                 PARDO a,i
                 GET R1A_VECS_T (a,i,kroot)
                 T1_R1A(a,i) = R1A_VECS_T (a,i,kroot)
                 GET Fso_pq_z(i,a)
                 tSO_z_pq(i,a) = Fso_pq_z(i,a)
                 etemp = T1_R1A(a,i)*tSO_z_pq(i,a)
                 etemp *= 2.0
                 auxval += etemp
                 ENDPARDO a,i
                 execute server_barrier

                 collective tmpval1 += auxval

                 tmpval += tmpval1
#-------------------------------------------------------------|                
                 auxval = 0.0
                 PARDO a,b
                 REQUEST LILR_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_ab(a,b,kroot,indone)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= 2.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval2 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_ij(i,j,kroot,indone)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -2.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval3 += auxval

                 tmpval += tmpval2
                 tmpval += tmpval3
 
#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions---------------
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval4 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval5 += auxval

                 tmpval += tmpval4
                 tmpval += tmpval5
#-----------------alpha-beta contributions----------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_z(a,b)
                 tSO_z_pq(a,b) = Fso_pq_z(a,b)
                 etemp = taa(a,b)*tSO_z_pq(a,b)
                 etemp *= 2.0
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval6 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_z(j,i)
                 tSO_z_pq(j,i) = Fso_pq_z(j,i)
                 etemp = tii(i,j)*tSO_z_pq(j,i)
                 etemp *= - 2.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval7 += auxval

                 tmpval += tmpval6
                 tmpval += tmpval7

              execute print_scalar cnt
              execute print_scalar tmpval

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
       mind1 = 1.0  

       mind2 = mark3
       mind2 += cnt
       mind2 -= 1.0


       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  ENDIF
                ENDIF
             ENDDO soind2
        ENDDO soind1



       ENDDO indone
        ENDIF
      ENDDO kroot

#---------------------------------------------------------------------------------|
#                  Block 11:   <L(T,Sz=-1)|V_so|0>                                |
#                  Block 21:    <L(T,Sz=1)|V_so|0>                                |
#---------------------------------------------------------------------------------|

      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

#----------------Step 1 - calculations of the matrix elements------------------------|
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half 

        tmpval1 = 0.0
        tmpval2 = 0.0

        auxval  = 0.0
        PARDO a,i
        GET L1A_VECS_T (i,a,kroot)
        L1_R1A(i,a) = L1A_VECS_T (i,a,kroot)
        GET Fso_pq_x(a,i)
        tSO_x_pq(a,i) = Fso_pq_x(a,i)
        etemp = L1_R1A(i,a)*tSO_x_pq(a,i)
        etemp *= sqrtwo
        auxval += etemp
        ENDPARDO a,i
        execute server_barrier

        collective tmpval1 += auxval

        auxval  = 0.0
        PARDO a,i
        GET L1A_VECS_T (i,a,kroot)
        L1_R1A(i,a) = L1A_VECS_T (i,a,kroot)
        GET Fso_pq_y(a,i)
        tSO_y_pq(a,i) = Fso_pq_y(a,i)
        etemp = L1_R1A(i,a)*tSO_y_pq(a,i)
        etemp *= sqrtwo
        auxval += etemp
        ENDPARDO a,i
        execute server_barrier

        collective tmpval2 += auxval

#                      execute print_scalar cnt
                      execute print_scalar tmpval1
                      execute print_scalar tmpval2

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
# Note: V_so(x) matrix elements contributes to the imaginary part of matrix,     |
# while V_so(y) matrix elements contributes to the real part of matrix           |
#--------------------------------------------------------------------------------|

#-----------------------Block 11-------------------------------------------------|
       mind1 = mark2
       mind1 += cnt
       mind1 -= 1.0

       mind2 = 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  etemp = tmpval1
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  so_ci_re(soind1,soind2) = tmpval2 
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
       
#-----------------------Block 21-------------------------------------------------|   
       mind1 = mark4
       mind1 += cnt
       mind1 -= 1.0

       mind2 = 1.0   

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
                  so_ci_im(soind1,soind2) = tmpval1                  
                  so_ci_re(soind1,soind2) = tmpval2
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#----------------------------------------------------------------

        ENDIF
      ENDDO kroot  

#---------------------------------------------------------------------------------|
#         Block 3:   <0|(1+Lambda)V_so|R(T,Sz=-1)>                                |
#         Block 5:   <0|(1+Lambda)V_so|R(T,Sz=1)>                                 |
#---------------------------------------------------------------------------------|

#----------------Zero out arrays---------------------------------------------------|
      DO kroot
      DO indone  
      
       PARDO a,b
       rILR_ab(a,b,kroot,indone) = 0.0
       PREPARE LILR_AB1_2p_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
       ENDPARDO a,b
       execute sip_barrier

       PARDO i,j
       rILR_ij(i,j,kroot,indone) = 0.0
       PREPARE LILR_AB1_2p_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone)
       ENDPARDO i,j
       execute sip_barrier

       PARDO a,b
       rILR_ab(a,b,kroot,indone) = 0.0
       PREPARE LILR_AB2_2p_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
       ENDPARDO a,b
       execute sip_barrier

       PARDO i,j
       rILR_ij(i,j,kroot,indone) = 0.0
       PREPARE LILR_AB2_2p_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone)
       ENDPARDO i,j
       execute sip_barrier

       PARDO a,b
       rILR_ab(a,b,kroot,indone) = 0.0
       PREPARE LILR_AB3_2p_ab(a,b,kroot,indone) = rILR_ab(a,b,kroot,indone)
       ENDPARDO a,b
       execute sip_barrier

       PARDO i,j
       rILR_ij(i,j,kroot,indone) = 0.0
       PREPARE LILR_AB3_2p_ij(i,j,kroot,indone) = rILR_ij(i,j,kroot,indone)
       ENDPARDO i,j
       execute sip_barrier

      ENDDO indone
      ENDDO kroot
#----------------------------------------------------------------------------------|
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count
        DO indone 
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------Two-particle additional intermediates--------------------------|

                PARDO i,j,a,b,d
                rILR_ab(a,b,kroot,indone) = 0.0
                REQUEST A2ab (i,a,j,d) i
                REQUEST R2AB_VECS_T (d,i,b,j,kroot) i
                TR2_VECS (d,i,b,j) =  R2AB_VECS_T (d,i,b,j,kroot)
                TL2_VECS (i,a,j,d) =  A2ab (i,a,j,d)
                taa(a,b) = TL2_VECS(i,a,j,d)*TR2_VECS(d,i,b,j)
                execute addrootindex taa rILR_ab
                PREPARE LILR_AB1_2p_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                rILR_ij(i,j,kroot,indone) = 0.0
                REQUEST A2ab (i,a,k,b) k
                REQUEST R2AB_VECS_T (a,k,b,j,kroot) k
                TR2_VECS (a,k,b,j) =  R2AB_VECS_T (a,k,b,j,kroot)
                TL2_VECS (i,a,k,b) =  A2ab (i,a,k,b)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,k,b,j)
                execute addrootindex tii rILR_ij
                PREPARE LILR_AB1_2p_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

                PARDO i,j,a,b,d
                rILR_ab(a,b,kroot,indone) = 0.0
                REQUEST A2ab (i,a,j,d) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot)
                TL2_VECS (i,a,j,d) =  A2ab (i,a,j,d)
                taa(a,b) = TL2_VECS(i,a,j,d)*TR2_VECS(b,i,d,j)
                execute addrootindex taa rILR_ab
                PREPARE LILR_AB2_2p_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,j,a,b,d
                execute sip_barrier
                
                PARDO i,j,k,a,b
                rILR_ij(i,j,kroot,indone) = 0.0
                REQUEST A2ab (i,a,k,b) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot)
                TL2_VECS (i,a,k,b) =  A2ab (i,a,k,b)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii rILR_ij
                PREPARE LILR_AB2_2p_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

                PARDO i,j,a,b,d
                rILR_ab(a,b,kroot,indone) = 0.0
                REQUEST A2aa (i,a,j,d) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot)
                TL2_VECS (i,a,j,d) =  A2aa (i,a,j,d)
                taa(a,b) = TL2_VECS(i,a,j,d)*TR2_VECS(b,i,d,j)
                execute addrootindex taa rILR_ab
                PREPARE LILR_AB3_2p_ab(a,b,kroot,indone) += rILR_ab(a,b,kroot,indone)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                rILR_ij(i,j,kroot,indone) = 0.0
                REQUEST A2aa (i,a,k,b) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot)
                TL2_VECS (i,a,k,b) =  A2aa (i,a,k,b)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii rILR_ij
                PREPARE LILR_AB3_2p_ij(i,j,kroot,indone) += rILR_ij(i,j,kroot,indone)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

#----------------Step 2 - calculations of the matrix elements------------------------|
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half

        tmpval1 = 0.0
        tmpval2 = 0.0
        tmpval2 = 0.0
        tmpval3 = 0.0
        tmpval4 = 0.0
        tmpval5 = 0.0
        tmpval6 = 0.0
        tmpval7 = 0.0
        tmpval8 = 0.0
        tmpval9 = 0.0
        tmpval10 = 0.0
        tmpval11 = 0.0
        tmpval12 = 0.0
        tmpval13 = 0.0
        tmpval14 = 0.0
        tmpval15 = 0.0
        tmpval16 = 0.0
        tmpval17 = 0.0
        tmpval18 = 0.0
        tmpval19 = 0.0
        tmpval20 = 0.0
        tmpval21 = 0.0
        tmpval22 = 0.0
        tmpval23 = 0.0
        tmpval24 = 0.0
        tmpval25 = 0.0
        tmpval26 = 0.0

        tmpval_re = 0.0
        tmpval_im = 0.0 
#------------------------------

                 auxval  = 0.0
                 PARDO a,i
                 GET R1A_VECS_T (a,i,kroot)
                 T1_R1A(a,i) = R1A_VECS_T (a,i,kroot)
                 GET Fso_pq_x(i,a)
                 tSO_x_pq(i,a) = Fso_pq_x(i,a)
                 etemp = T1_R1A(a,i)*tSO_x_pq(i,a)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,i
                 execute server_barrier

                 collective tmpval1 += auxval


                 auxval  = 0.0
                 PARDO a,i
                 GET R1A_VECS_T (a,i,kroot)
                 T1_R1A(a,i) = R1A_VECS_T (a,i,kroot)
                 GET Fso_pq_y(i,a)
                 tSO_y_pq(i,a) = Fso_pq_y(i,a)
                 etemp = T1_R1A(a,i)*tSO_y_pq(i,a)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,i
                 execute server_barrier

                 collective tmpval2 += auxval

#-------------------------------------------------------------|


                 auxval = 0.0
                 PARDO a,b
                 REQUEST LILR_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= -1.0
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval

                 auxval = 0.0
                 PARDO a,b
                 REQUEST LILR_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval5 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= -1.0
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval6 += auxval
#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions---------------
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.25
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval7 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.25
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval8 += auxval

                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.25
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval9 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.25
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval10 += auxval

#-----------------alpha-beta contributions----------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval11 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval12 += auxval

                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval13 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 etemp *= -1.0
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval14 += auxval
#------------------Exchange alpha-beta terms--------------------------
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB1_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB1_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval15 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB1_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB1_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval16 += auxval

                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB1_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB1_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval17 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB1_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB1_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval18 += auxval
#---------------------------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB2_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB2_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval19 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB2_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB2_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval20 += auxval

                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB2_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB2_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval21 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB2_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB2_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval22 += auxval
#---------------------------------------------------------------|
                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB3_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB3_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval23 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB3_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB3_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval24 += auxval

                 auxval  = 0.0
                 PARDO a,b
                 REQUEST LILR_AB3_2p_ab(a,b,kroot,indone) a
                 taa(a,b) = LILR_AB3_2p_ab(a,b,kroot,indone)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval25 += auxval

                 auxval = 0.0
                 PARDO i,j
                 REQUEST LILR_AB3_2p_ij(i,j,kroot,indone) i
                 tii(i,j) = LILR_AB3_2p_ij(i,j,kroot,indone)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval26 += auxval
#---------Contributions to imaginary parts (Sx - components)-------------|
          tmpval_im += tmpval1
          tmpval_im += tmpval3
          tmpval_im += tmpval4
          tmpval_im += tmpval7
          tmpval_im += tmpval8
          tmpval_im += tmpval11
          tmpval_im += tmpval12
          tmpval_im += tmpval15
          tmpval_im += tmpval16
          tmpval_im += tmpval19
          tmpval_im += tmpval20
          tmpval_im += tmpval23
          tmpval_im += tmpval24      
#---------Contributions to real parts (Sy - compoenents)-----------------|
          tmpval_re += tmpval2 
          tmpval_re += tmpval5
          tmpval_re += tmpval6
          tmpval_re += tmpval9
          tmpval_re += tmpval10
          tmpval_re += tmpval13
          tmpval_re += tmpval14
          tmpval_re += tmpval17
          tmpval_re += tmpval18
          tmpval_re += tmpval21
          tmpval_re += tmpval22
          tmpval_re += tmpval25
          tmpval_re += tmpval26

#------Put calculated matrix elements into the EOM-SO-CI matrix matrix-----------|
# Note: V_so(x) matrix elements contributes to the imaginary part of matrix,     |
# while V_so(y) matrix elements contributes to the real part of matrix           |
#--------------------------------------------------------------------------------|

#-----------------------Block 3--------------------------------------------------|

       mind1 = 1.0

       mind2 = mark2
       mind2 += cnt
       mind2 -= 1.0


       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#-----------------------Block 5--------------------------------------------------|
#         Note: block 5 is just complex-conjugated of block 3                    |
#--------------------------------------------------------------------------------|
       mind1 = 1.0

       mind2 = mark4
       mind2 += cnt
       mind2 -= 1.0


       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= 1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1


#----------------------------------------------------------------
        ENDDO indone
        ENDIF
      ENDDO kroot

#---------------------------------------------------------------------------------|
#         Block  8:   <L(S)|V_so|R(T,Sz=-1)>                                      |
#         Block 10:    <L(S)|V_so|R(T,Sz=1)>                                      |
#---------------------------------------------------------------------------------|


#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier


                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier


      ENDDO kroot1
      ENDDO kroot



#--------------------------------------------------------------
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= sing_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count

#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|

                PARDO i,a,b
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_S (i,a,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_S (i,a,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_S (i,a,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_S (i,a,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#------------------Two-particle intermediates-------------------------------------|

#------------------alpha-alpha and beta-beta contributions-----------------|
                PARDO i,j,a,b,d
                tILR_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_2p_ab
                PUT ILR_2p_ab(a,b,kroot,kroot1) += tILR_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_2p_ij
                PUT ILR_2p_ij(i,j,kroot,kroot1) += tILR_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#------------------exchange terms------------------------------------------------|
                PARDO i,j,a,b,d
                tILR_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (d,i,b,j,kroot1) i
                TR2_VECS (d,i,b,j) =  R2AB_VECS_T (d,i,b,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS(i,a,j,d)*TR2_VECS(d,i,b,j)
                execute addrootindex taa tILR_ab
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,k,b,j,kroot1) k
                TR2_VECS (a,k,b,j) =  R2AB_VECS_T (a,k,b,j,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,k,b,j)
                execute addrootindex tii tILR_ij
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#---------------------------------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_S (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_S (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_S (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier


#----------------Step 2 - calculations of the matrix elements------------------------|
        sqrtwo = 2.0
