#------------------------------------------------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval19 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval20 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB2_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval21 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB2_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval22 += auxval
#------------------------------------------------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval23 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval24 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval25 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval26 += auxval


#---------Contributions to imaginary parts (Sx - components)-------------|
          tmpval_im += tmpval3
          tmpval_im += tmpval4
          tmpval_im += tmpval7
          tmpval_im += tmpval8
          tmpval_im += tmpval11
          tmpval_im += tmpval12
          tmpval_im += tmpval15
          tmpval_im += tmpval16
          tmpval_im += tmpval19
          tmpval_im += tmpval20
          tmpval_im += tmpval23
          tmpval_im += tmpval24
#---------Contributions to real parts (Sy - compoenents)-----------------|
          tmpval_re += tmpval5
          tmpval_re += tmpval6
          tmpval_re += tmpval9
          tmpval_re += tmpval10
          tmpval_re += tmpval13
          tmpval_re += tmpval14
          tmpval_re += tmpval17
          tmpval_re += tmpval18
          tmpval_re += tmpval21
          tmpval_re += tmpval22
          tmpval_re += tmpval25
          tmpval_re += tmpval26
#-----------------------Block 20-------------------------------------------------|
       mind1 = mark3
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark4
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#-----------------------Block 14--------------------------------------------------|
       mind1 = mark2
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark3
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1


#---------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot


      ENDPROC SO_MATR
#     ---------------

