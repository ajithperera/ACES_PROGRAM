#---------Step 1 - read eigenvalues and eigenvectors from the disk-------------------------
      CALL READ_DATA 
#---------Step 2 - sort out singlet and triplet eigenvectors ------------------------------
      CALL RLOVERLAP
      CALL FIND_TRIPLETS
      CALL FIND_SINGLETS
      execute set_tr_sin trp_count sing_count  
      CALL COPY_ST
#---------Step 3 - add non-relativistic matrix elements to EOM-SO-CI matrix---------------
      CALL NR_EOM_CONTR 
#---------Step 4 - compute SO integrals and construct SO Fock operator-------------------
      CALL SO_INT
#---------Step 5 - add spin-orbit couplings matrix elements to EOM-SO-CI matrix----------
      CALL SO_MATR

#---------Step 6 - diagonalize complex EOM-SO-CI matrix----------------------------------
#--------- and print out relativistic roots to the output file --------------------------

       execute eom_so_diag so_ci_re so_ci_im  

