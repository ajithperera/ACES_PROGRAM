                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval22 += auxval

#                 execute print_scalar tmpval22
#-----------------------------------------------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval23 += auxval


                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval24 += auxval


                 auxval = 0.0
                 PARDO a,b
                 GET ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_AB3_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= -0.5
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval25 += auxval


                 auxval = 0.0
                 PARDO i,j
                 GET ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_AB3_2p_ij(i,j,kroot,kroot1)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 etemp *= 0.5
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval26 += auxval


#---------Contributions to imaginary parts (Sx - components)-------------|
          tmpval_im += tmpval3
          tmpval_im += tmpval4
          tmpval_im += tmpval7
          tmpval_im += tmpval8
          tmpval_im += tmpval11
          tmpval_im += tmpval12
          tmpval_im += tmpval15
          tmpval_im += tmpval16
          tmpval_im += tmpval19
          tmpval_im += tmpval20
          tmpval_im += tmpval23
          tmpval_im += tmpval24
#---------Contributions to real parts (Sy - compoenents)-----------------|
          tmpval_re += tmpval5
          tmpval_re += tmpval6
          tmpval_re += tmpval9
          tmpval_re += tmpval10
          tmpval_re += tmpval13
          tmpval_re += tmpval14
          tmpval_re += tmpval17
          tmpval_re += tmpval18
          tmpval_re += tmpval21
          tmpval_re += tmpval22
          tmpval_re += tmpval25
          tmpval_re += tmpval26
#-----------------------Block 12-------------------------------------------------|
       mind1 = mark2
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark1
       mind2 += cnt1
       mind2 -= 1.0


       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= -1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1
#-----------------------Block 22-------------------------------------------------|
       mind1 = mark4
       mind1 += cnt
       mind1 -= 1.0

       mind2 = mark1
       mind2 += cnt1
       mind2 -= 1.0

       cnt1_size = 0.0
       DO soind1
       cnt2_size = 0.0
       cnt1_size += 1.0
             DO soind2
             cnt2_size += 1.0
                IF cnt1_size == mind1
                  IF cnt2_size == mind2
#                  execute print_scalar mind1
#                  execute print_scalar mind2
                  etemp = tmpval_im
                  etemp *= 1.0
                  so_ci_im(soind1,soind2) = etemp
                  etemp = tmpval_re
                  etemp *= -1.0
                  so_ci_re(soind1,soind2) = etemp
                 ENDIF
                ENDIF
             ENDDO soind2
       ENDDO soind1


#--------------------------------------------------------------------------------|
                ENDIF
             ENDDO kroot1
        ENDIF
      ENDDO kroot

#---------------------------------------------------------------------------------|
#         Block  18:   <L(T,Sz=0)|V_so|R(T,Sz=-1)>                                |
#         Block  24:   <L(T,Sz=1)|V_so|R(T,Sz=0)>                                 |
#---------------------------------------------------------------------------------|

#------------------Zero out arrays-----------------------------
      DO kroot
      DO kroot1

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

                PARDO a,b
                tILR_ab(a,b,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) = tILR_ab(a,b,kroot,kroot1)
                ENDPARDO a,b
                execute sip_barrier

                PARDO i,j
                tILR_ij(i,j,kroot,kroot1) = 0.0
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) = tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j
                execute sip_barrier

      ENDDO kroot1
      ENDDO kroot   
#---------------------------------------------------------------------------------|
      cnt = 0.0
      DO kroot
        cnt += 1.0
        IF cnt <= trp_count

             cnt1 = 0.0
             DO kroot1
                cnt1 += 1.0
                IF cnt1 <= trp_count
#----------------Step 1 - preparation of the intermediates------------------------|

#------------------One-particle intermediates-------------------------------------|
                PARDO i,a,b
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(b,i,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_T (b,i,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(b,i,kroot1) = R1A_VECS_T (b,i,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ab(a,b,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(b,i,kroot1,indone)
                PUT ILR_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,a,b
                execute sip_barrier

                PARDO i,j,a
                    DO indone
                ttT1_L1A(i,a,kroot,indone) = 0.0
                ttT1_R1A(a,j,kroot1,indone) = 0.0
                GET L1A_VECS_T (i,a,kroot)
                GET R1A_VECS_T (a,j,kroot1)
                tT1_L1A(i,a,kroot) = L1A_VECS_T (i,a,kroot)
                tT1_R1A(a,j,kroot1) = R1A_VECS_T (a,j,kroot1)
                execute addrootindex tT1_L1A ttT1_L1A
                execute addrootindex tT1_R1A ttT1_R1A
                tILR_ij(i,j,kroot,kroot1) = ttT1_L1A(i,a,kroot,indone)*ttT1_R1A(a,j,kroot1,indone)
                PUT ILR_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                    ENDDO indone
                ENDPARDO i,j,a
                execute sip_barrier
#------------------Two-particle intermediates-------------------------------------|

#------------------alpha-alpha and beta-beta contributions-----------------|
                PARDO i,j,a,b,d
                tILR_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_2p_ab
                PUT ILR_2p_ab(a,b,kroot,kroot1) += tILR_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_2p_ij
                PUT ILR_2p_ij(i,j,kroot,kroot1) += tILR_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#-----------------alpha-beta contributions----------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#------------------exchange terms------------------------------------------------|
                PARDO i,j,a,b,d
                tILR_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (d,i,b,j,kroot1) i
                TR2_VECS (d,i,b,j) =  R2AB_VECS_T (d,i,b,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS(i,a,j,d)*TR2_VECS(d,i,b,j)
                execute addrootindex taa tILR_ab
                PUT ILR_AB1_2p_ab(a,b,kroot,kroot1) += tILR_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,k,b,j,kroot1) k
                TR2_VECS (a,k,b,j) =  R2AB_VECS_T (a,k,b,j,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,k,b,j)
                execute addrootindex tii tILR_ij
                PUT ILR_AB1_2p_ij(i,j,kroot,kroot1) += tILR_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier
#---------------------------------------------------------|
                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AA_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AA_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AB_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB2_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AB_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AA_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AA_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AB_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB2_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

                PARDO i,j,a,b,d
                tILR_AB_2p_ab(a,b,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,j,d,kroot) i
                REQUEST R2AB_VECS_T (b,i,d,j,kroot1) i
                TR2_VECS (b,i,d,j) =  R2AB_VECS_T (b,i,d,j,kroot1)
                TL2_VECS (i,a,j,d) =  L2AA_VECS_T (i,a,j,d,kroot)
                taa(a,b) = TL2_VECS (i,a,j,d)*TR2_VECS (b,i,d,j)
                execute addrootindex taa tILR_AB_2p_ab
                PUT ILR_AB3_2p_ab(a,b,kroot,kroot1) += tILR_AB_2p_ab(a,b,kroot,kroot1)
                ENDPARDO i,j,a,b,d
                execute sip_barrier

                PARDO i,j,k,a,b
                tILR_AB_2p_ij(i,j,kroot,kroot1) = 0.0
                REQUEST L2AA_VECS_T (i,a,k,b,kroot) k
                REQUEST R2AB_VECS_T (a,j,b,k,kroot1) k
                TR2_VECS (a,j,b,k) =  R2AB_VECS_T (a,j,b,k,kroot1)
                TL2_VECS (i,a,k,b) =  L2AA_VECS_T (i,a,k,b,kroot)
                tii(i,j) = TL2_VECS (i,a,k,b)*TR2_VECS (a,j,b,k)
                execute addrootindex tii tILR_AB_2p_ij
                PUT ILR_AB3_2p_ij(i,j,kroot,kroot1) += tILR_AB_2p_ij(i,j,kroot,kroot1)
                ENDPARDO i,j,k,a,b
                execute sip_barrier

#----------------Step 2 - calculations of the matrix elements------------------------|
        sqrtwo = 2.0
        half = 0.5
        execute square_root sqrtwo half

        tmpval1 = 0.0
        tmpval2 = 0.0
        tmpval2 = 0.0
        tmpval3 = 0.0
        tmpval4 = 0.0
        tmpval5 = 0.0
        tmpval6 = 0.0
        tmpval7 = 0.0
        tmpval8 = 0.0
        tmpval9 = 0.0
        tmpval10 = 0.0
        tmpval11 = 0.0
        tmpval12 = 0.0
        tmpval13 = 0.0
        tmpval14 = 0.0
        tmpval15 = 0.0
        tmpval16 = 0.0
        tmpval17 = 0.0
        tmpval18 = 0.0
        tmpval19 = 0.0
        tmpval20 = 0.0
        tmpval21 = 0.0
        tmpval22 = 0.0
        tmpval23 = 0.0
        tmpval24 = 0.0
        tmpval25 = 0.0
        tmpval26 = 0.0

        tmpval_re = 0.0
        tmpval_im = 0.0
#------------------------Singles contributions-----------------------------------|
                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval3 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 GET Fso_pq_x(j,i)
                 tSO_x_pq(j,i) = Fso_pq_x(j,i)
                 etemp = tii(i,j)*tSO_x_pq(j,i)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval4 += auxval

                 auxval = 0.0
                 PARDO a,b
                 GET ILR_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_ab(a,b,kroot,kroot1)
                 GET Fso_pq_y(a,b)
                 tSO_y_pq(a,b) = Fso_pq_y(a,b)
                 etemp = taa(a,b)*tSO_y_pq(a,b)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval5 += auxval

                 auxval = 0.0
                 PARDO i,j
                 GET ILR_ij(i,j,kroot,kroot1)
                 tii(i,j) = ILR_ij(i,j,kroot,kroot1)
                 GET Fso_pq_y(j,i)
                 tSO_y_pq(j,i) = Fso_pq_y(j,i)
                 etemp = tii(i,j)*tSO_y_pq(j,i)
                 etemp *= sqrtwo
                 auxval += etemp
                 ENDPARDO i,j
                 execute server_barrier

                 collective tmpval6 += auxval
#----------alpha-alpha-alpha-alpha and beta-beta-beta-beta contributions--------------
                 auxval  = 0.0
                 PARDO a,b
                 GET ILR_2p_ab(a,b,kroot,kroot1)
                 taa(a,b) = ILR_2p_ab(a,b,kroot,kroot1)
                 GET Fso_pq_x(a,b)
                 tSO_x_pq(a,b) = Fso_pq_x(a,b)
                 etemp = taa(a,b)*tSO_x_pq(a,b)
                 etemp *= sqrtwo
                 etemp *= 0.25
                 auxval += etemp
                 ENDPARDO a,b
                 execute server_barrier

                 collective tmpval7 += auxval

                 auxval = 0.0
                 PARDO i,j
