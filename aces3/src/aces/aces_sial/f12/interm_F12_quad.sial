#----------------------------------------------------------

      PROC INTERMB
#     ------------

#------Zero out intermediates----------------------
      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      PREPARE Bx(i,k,j,l) = tB1(i,k,j,l)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      PREPARE By(i,k,j,l) = tB1(i,k,j,l)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      PREPARE Bz(i,k,j,l) = tB1(i,k,j,l)
      ENDPARDO i,k,j,l
      execute server_barrier
#--------------------------------------------------

#------Step 1 - <ij|d1*f12^2|kl> - contribution-----------|

      PARDO i,k,j,l
      REQUEST FF12X(i,k,j,l) i
      tB1(i,k,j,l) = FF12X(i,k,j,l)
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      REQUEST FF12Y(i,k,j,l) i
      tB1(i,k,j,l) = FF12Y(i,k,j,l)
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      REQUEST FF12Z(i,k,j,l) i
      tB1(i,k,j,l) = FF12Z(i,k,j,l)
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

#------Step 2 - sum_{M} <ijm|f12*f13*d1|kml>--------------|

      PARDO i,k,j,l
      REQUEST F12F13X(i,k,j,l) i
      tB1(i,k,j,l) = F12F13X(i,k,j,l)
      tB1(i,k,j,l) *= -1.0
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      REQUEST F12F13Y(i,k,j,l) i
      tB1(i,k,j,l) = F12F13Y(i,k,j,l)
      tB1(i,k,j,l) *= -1.0
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      REQUEST F12F13Z(i,k,j,l) i
      tB1(i,k,j,l) = F12F13Z(i,k,j,l)
      tB1(i,k,j,l) *= -1.0
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

#------Step 3 - sum_{M} <ijm|f12*f23*d3|mlk> = -----------|
#      sum_{M,p} <ijm|f12*f23|mlp><p|d|k>                 |
#---------------------------------------------------------|

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p 
      REQUEST F12F23_2(i,p,j,l) i
      GET dip_pq_x(p,k)
      tB2(i,k,j,l) = F12F23_2(i,p,j,l)*dip_pq_x(p,k)
      tB2(i,k,j,l) *= -1.0   
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier  

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p
      REQUEST F12F23_2(i,p,j,l) i
      GET dip_pq_y(p,k)
      tB2(i,k,j,l) = F12F23_2(i,p,j,l)*dip_pq_y(p,k)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p
      REQUEST F12F23_2(i,p,j,l) i
      GET dip_pq_z(p,k)
      tB2(i,k,j,l) = F12F23_2(i,p,j,l)*dip_pq_z(p,k)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

#------Step 4 - sum_{M} <ijm|d1*f12*f23|mlk> = -----------|
#      sum_{M,p} <i|d|p><pjm|f12*f23|mlk>                 |
#---------------------------------------------------------|

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p
      REQUEST F12F23_1(p,k,j,l) l
      GET dip_pq_x(i,p)
      tB2(i,k,j,l) = F12F23_1(p,k,j,l)*dip_pq_x(i,p)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p
      REQUEST F12F23_1(p,k,j,l) l
      GET dip_pq_y(i,p)
      tB2(i,k,j,l) = F12F23_1(p,k,j,l)*dip_pq_y(i,p)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO p
      REQUEST F12F23_1(p,k,j,l) l
      GET dip_pq_z(i,p)
      tB2(i,k,j,l) = F12F23_1(p,k,j,l)*dip_pq_z(i,p)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO p
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

#---------Step 5 - M,N - components-----------------------|

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,k,n,l) m
      REQUEST F12Xpipi(j,n,i,m) m
      tB2(i,k,j,l) = F12Xpipi(j,n,i,m)*V2pipi(m,k,n,l)
      tB1(i,k,j,l) += tB2(i,k,j,l) 
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier
       
      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,k,n,l) m
      REQUEST F12Ypipi(j,n,i,m) m
      tB2(i,k,j,l) = F12Ypipi(j,n,i,m)*V2pipi(m,k,n,l)
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,k,n,l) m
      REQUEST F12Zpipi(j,n,i,m) m
      tB2(i,k,j,l) = F12Zpipi(j,n,i,m)*V2pipi(m,k,n,l)
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier
#---------------------------------------------
      
      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,i,n,j) m
      REQUEST F12Xpipi(l,n,k,m) m
      tB2(i,k,j,l) = F12Xpipi(l,n,k,m)*V2pipi(m,i,n,j)
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,i,n,j) m
      REQUEST F12Ypipi(l,n,k,m) m
      tB2(i,k,j,l) = F12Ypipi(l,n,k,m)*V2pipi(m,i,n,j)
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE By(i,k,j,l) += tB1(i,k,j,l)
      PREPARE By(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO m
      DO n
      REQUEST V2pipi(m,i,n,j) m
      REQUEST F12Zpipi(l,n,k,m) m
      tB2(i,k,j,l) = F12Zpipi(l,n,k,m)*V2pipi(m,i,n,j)
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO n
      ENDDO m
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bz(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bz(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

#---------Step 6 - A,B - components-----------------------|

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO a
      DO b
      REQUEST V2pipi(a,k,b,l) a
      REQUEST F12Xpipi(j,b,i,a) a
      tB2(i,k,j,l) = F12Xpipi(j,b,i,a)*V2pipi(a,k,b,l)
      tB2(i,k,j,l) *= -1.0
      tB1(i,k,j,l) += tB2(i,k,j,l)
      ENDDO b
      ENDDO a
      tB3(j,l,i,k) = tB1(i,k,j,l)
      PREPARE Bx(i,k,j,l) += tB1(i,k,j,l)
      PREPARE Bx(j,l,i,k) += tB3(j,l,i,k)
      ENDPARDO i,k,j,l
      execute server_barrier

      PARDO i,k,j,l
      tB1(i,k,j,l) = 0.0
      DO a
      DO b
      REQUEST V2pipi(a,k,b,l) a
      REQUEST F12Ypipi(j,b,i,a) a
