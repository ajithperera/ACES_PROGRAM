#----------------------------------------------------------------------------------------|
# The purpose of this part is to  generate necessary set of F12-related integrals        |
#   and intermediates for calculations of dipole moments and polarizabilities            |
#     Added to ACES3 by Denis Bokhan, Moscow Lomonosov State University,                 |
#                            Moscow, Russian  Federation                                 |
#----------------------------------------------------------------------------------------|

                           SIAL INTERM_F12_QUAD
#--------------Definition of indices-----------------------------------------------------
      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      moaindex    i  = baocc, eaocc
      moaindex    j  = baocc, eaocc
      moaindex    j1  = baocc, eaocc
      moaindex    j2  = baocc, eaocc
      moaindex    j3  = baocc, eaocc
      moaindex    k  = baocc, eaocc
      moaindex    l  = baocc, eaocc
      moaindex    m  = baocc, eaocc
      moaindex   i1  = baocc, eaocc
      moaindex   i2  = baocc, eaocc
      moaindex   i3  = baocc, eaocc
      moaindex    p  = baocc, eavirt
      moaindex    q  = baocc, eavirt
      moaindex   p1  = baocc, eavirt
      moaindex   p2  = baocc, eavirt
      moaindex   q1  = baocc, eavirt
      moaindex   q2  = baocc, eavirt
      moaindex   a   = bavirt, eavirt
      moaindex   a1  = bavirt, eavirt
      moaindex   a2  = bavirt, eavirt
      moaindex   a3  = bavirt, eavirt
      moaindex   b   = bavirt, eavirt
      moaindex   b1   = bavirt, eavirt
      moaindex   b2   = bavirt, eavirt
      moaindex   d   = bavirt, eavirt
      moaindex    n  = baocc, eaocc
      moaindex   i4  = baocc, eaocc

      index   g   =1, 1000000
      index k4=1,4
#--------------Definition of arrays------------------------------------------------------

#-----------Molecular integrals----------------------------|
#      served VSpipi(p1,i,p,i1)
#      served Viaai(i,a1,a,i1)
#      served Vaaii(a,a1,i,i1)
#      served Vaaai(a2,a,a1,i)
#      served VSaaai(a2,a,a1,i)
#      served Vpiqj(p,i,q,j)

      served VSpipi(p1,i,p,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vaaai(a2,a,a1,i)
      served VSaaai(a2,a,a1,i)
      served Vpiqj(p,i,q,j)

      served VSqjqj(q,j,q1,j1)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)


      served F12F23_1(p,i1,i2,i3)
      served F12F23_2(i1,p,i2,i3)
      temp tF12F23_1(p,i1,i2,i3)
      temp tF12F23_2(i1,p,i2,i3)
      served X_ijkl(i,i1,i2,i3)
      temp tX_ijkl(i,i1,i2,i3)
      temp t1X_ijkl(i,i1,i2,i3)
      served F12F13X(i,i1,i2,i3)
      served F12F13Y(i,i1,i2,i3)
      served F12F13Z(i,i1,i2,i3)
      temp tF12F13X(i,i1,i2,i3)
      temp tF12F13Y(i,i1,i2,i3)
      temp tF12F13Z(i,i1,i2,i3)
      served F12Xpipi(i,p,j,q)
      served F12Ypipi(i,p,j,q)
      served F12Zpipi(i,p,j,q) 
      served FF12X(i,j,k,l)
      served FF12Y(i,j,k,l)
      served FF12Z(i,j,k,l)
      temp tF12pipi(i,p,j,q)
      temp tFF12(i,j,k,l)
      served F12F13Sx(i,i1,i2,i3) 
      served F12F13Sy(i,i1,i2,i3)
      served F12F13Sz(i,i1,i2,i3)
      
#---------Cluster amplitudes-------------------------------|
      distributed t1a_old(a,i)
      served T2old_aa(a,i,a1,i1)
      served T2old_ab(a,i,b,j)

      temp tt1a_old(a,i)
      temp tT2old_aa(a,i,a1,i1)
      temp tT2old_ab(a,i,b,j)
#---------Lambda amplitudes--------------------------------|
      distributed l1a_old(i,a)
      served L2old_aa(i,a,i1,a1)
      served L2old_ab(i,a,j,b)

      temp tl1a_old(i,a)
      temp tL2old_aa(i,a,i1,a1)
      temp tL2old_ab(i,a,j,b)
#--------One-particle elements of Hbar------
      distributed dip_ao_x(mu,nu)
      distributed dip_ao_y(mu,nu)
      distributed dip_ao_z(mu,nu)

      distributed dip_am_x(p,nu)
      distributed dip_am_y(p,nu)
      distributed dip_am_z(p,nu)

      distributed dip_pq_x(p,q)
      distributed dip_pq_y(p,q)
      distributed dip_pq_z(p,q)

      served quad_pq_x(p,q)
      served quad_pq_y(p,q)
      served quad_pq_z(p,q)

      distributed Uaa(a,a1)
      distributed Ubb(b,b1)
      distributed Uii(i1,i)
      distributed Ujj(j1,j)
      distributed Uia(i,a)
      distributed Ujb(j,b)

      temp T_x(mu,nu)
      temp T_y(mu,nu)
      temp T_z(mu,nu)

      temp T1_x(p,nu)
      temp T1_y(p,nu)
      temp T1_z(p,nu)

      temp T2_x(p,q)
      temp T2_y(p,q)
      temp T2_z(p,q)
      temp ttx(i,j)

      temp tmoval(p)
      temp tmoval1(p)
      temp tmoover(p,p1)
      temp tmpint1(p,p1)
      temp tmpint2(p,p1)
      temp tmp3center(mu,nu)
      temp tmp3grad(mu,nu)
      temp tmp3center_imu(mu,p)
      temp tmp3center_pi(p,q)


#---------Two-particle elements of Hbar-----
      served Wiiii(i,i1,i2,i3)
      served Wjjjj(j,j1,j2,j3)
      served Wiijj(i,i1,j,j1)

      served Waaia(a,a1,i,a2)
      served Wbbjb(b,b1,j,b2)
      served Waajb(a,a1,j,b2)
      served Wbbia(b,b1,i,a2)

      served Wiiia(i1,i,i2,a)
      served Wjjjb(j1,j,j2,b)
      served Wiijb(i1,i,j2,b)
      served Wjjia(j1,j,i2,a)

      served Wiiai(i,i1,a,i2)
      served Wiibj(i,i1,b,j)
      served Wjjai(j,j1,a,i)
      served Wjjbj(j,j1,b,j2)

      served Wiaai(i1,a1,a,i)
      served Wjbbj(j1,b1,b,j)
      served Wiabj(i,a,b,j)
      served Wjbai(j,b,a,i)
      served Wiibb(i1,i,b,b1)
      served Wjjaa(j1,j,a,a1)
      served W1iibb(i1,i,b,b1)
      served W1jjaa(j1,j,a,a1)

      served Waaai(a,a1,a2,i)
      served Wbbbj(b,b1,b2,j)
      served Waabj(a,a1,b,j)
      served Wbbai(b,b1,a,i)

      served Waiaa(a,a1,i,a2) # HBAR_AIBC_aaaa
      served Wbjbb(b,b1,j,b2) # HBAR_AIBC_bbbb
      served Waibb(a,a1,j,b2) # HBAR_AIBC_aabb
      served Wbjaa(b,b1,i,a2) # HBAR_AIBC_bbaa
      served auxint1x(i,a,l,j)
      served auxint1y(i,a,l,j)
      served auxint1z(i,a,l,j)
      served auxint2x(i,a,j,b)
      served auxint2y(i,a,j,b)
      served auxint2z(i,a,j,b)
      served auxint3x(i,j,m,n)
      served auxint3y(i,j,m,n)
      served auxint3z(i,j,m,n)
      served auxint4x(i,a,j,b)
      served auxint4y(i,a,j,b)
      served auxint4z(i,a,j,b)
      served C_coef(i,j,k,l)
      served CC2(i,j,k,l)
      served CC1(i,j,k,l)
      served cpinterm1(p,a)
      served cpinterm2(p,a)
      served cpinterm4(p,a)  

      temp tccusp(i,j,k,l)
      temp t1ccusp(i,j,k,l)
      temp tauxint1(i,a,l,j)
      temp tauxint2(i,a,j,b)
      temp tauxint3(i,a,l,j)
      temp tauxint4(i,a,j,b)
      temp taux(i,j,k,l)

      served Waiia(a,i,i1,a1)
      served Wbjjb(b,j,j1,b1)
      served Waijb(a,i,j,b)
      served Wbjia(b,j,i,a)
      served Hbar_ab_eomea(a,a1)
      served Hbar_ia_eomea(a,i)
      served Hbar_ik_aj_eomea(i,k,a,j)
      served Hbar_ij_ab_eomea(i,j,a,b)
      served Hbar_ai_jb_eomea(a,i,j,b)

#---------------F12 intermediates------------------------------------
      served T1_1(i,a)
      served T1_2(i,j)
      served T1_3(a,p)
      served T2_5(a,i,b,j)
      served T2_6(a,i,q,j)
      served T2_7(q,i,a,j)
      served T2_3(i,j,i1,j1)
      served T2_3S(i,j,i1,j1)
      served T2_8(a,i,p,j)
      served T2_9(a,p,i,j)
      served T2_89S(a,i,b,j)
      served T2_1(a,i,b,j)
      served T2_2(j,k,i,a)
      served T2_10(i,a,d,b)
      served T2_11(d,a,j,b)
      served T2_10_3e(i,a,d,b)
      served T2_11_3e(d,a,j,b)
      served Hbar_ijka_F12(i,j,k,a)
      served Hbar_ijka_F12S(i,j,k,a)
      served Hbar_abci_F12(a,a1,i,d)
      served Hbar_abci_F12S(a,a1,i,d)
      served V0pipi(p,i,q,j)
      served V0aapi(a,b,p,i)
      served V0apai(a,p,b,i)
      served V2ppii(p,q,i,j)
      served V2piai(p,i,a,j)
      served V2pipi(p2,i,p1,i1)
      served V3iiii(i,i1,i2,i3)
      temp tv2pipi1(p2,i,p1,i1)
      temp tv2pipi2(p2,i,p1,i1)

#--------Local arrays------------------------------
       local MOVAL(p)
       local MOOVER(p,p1)
       local MOOVERX(p,p1)
       local MOOVERY(p,p1)
       local MOOVERZ(p,p1)
       local slater_ip(p,i)
       local slater_sq_ip(p,i)
       local l3center_imu(mu,q)
       local overint1(p,q)
       local overint2(i,p)
       local overint3(i,i1)
       local overint4(p,i)
       local overint5(p,q)
       temp tslat1(p,q)
       temp tslat2(p,q)  
#------------Output arrays---------------------------
        served intl1x(i,a)
        served intl1y(i,a) 
        served intl1z(i,a)
        temp tintl1(i,a)
        served intl2x(i,a,j,b)
        served intl2y(i,a,j,b)
        served intl2z(i,a,j,b)
        temp tintl2(i,a,j,b)
        temp tintl2_1(i,a,j,b)
        temp tintl2_2(i,a,j,b)
        served Xijkl(i,k,j,l)
        served Bx(i,j,k,l)
        served By(i,j,k,l)
        served Bz(i,j,k,l)
        temp tB1(i,j,k,l)
        temp tB2(i,j,k,l)
        temp tB3(i,j,k,l) 
#--------Scalar variables----------------------------

      scalar PTW
      scalar Ng
      scalar cnt
      scalar ind
      scalar int1_type
      scalar F12_GAMMA

#----------------------------------------------------------
#----------------------------------------------------------
     PROC READ_DATA 
#    --------------

      create t1a_old
      create l1a_old
      create Uaa
      create Ubb
      create Uii
      create Ujj
      create Uia
      create Ujb
      execute sip_barrier

      execute server_barrier

#----------Integrals----------------------------------------------
#      execute list_to_blocks                VSpipi
#      execute list_to_blocks                Vaaii
#      execute list_to_blocks                Viaai
#      execute list_to_blocks                Vaaai
#      execute list_to_blocks                Vpiqj

      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Vbbii


#----------Cluster amplitudes-------------------------------------
      execute list_to_blocks                t1a_old
      execute list_to_blocks                T2old_aa
      execute list_to_blocks                T2old_ab
#----------Lambda amplitudes--------------------------------------
      execute list_to_blocks                l1a_old
      execute list_to_blocks                L2old_aa
      execute list_to_blocks                L2old_ab
#----------One-paticle Hbar elements------------------------------
      execute list_to_blocks                Uaa
      execute list_to_blocks                Ubb
      execute list_to_blocks                Uii
      execute list_to_blocks                Ujj
      execute list_to_blocks                Uia
      execute list_to_blocks                Ujb
#----------Two-particle Hbar elements-----------------------------
      execute list_to_blocks                Wiiii
      execute list_to_blocks                Wjjjj
      execute list_to_blocks                Wiijj
      execute list_to_blocks                Waiaa # HBAR_AIBC_aaaa
      execute list_to_blocks                Wbjbb # HBAR_AIBC_bbbb
      execute list_to_blocks                Waibb # HBAR_AIBC_aabb
      execute list_to_blocks                Wbjaa # HBAR_AIBC_bbaa
      execute list_to_blocks                Wiiia # HBAR_JKIA_aaaa
      execute list_to_blocks                Wjjjb # HBAR_JKIA_bbbb
      execute list_to_blocks                Wiijb # HBAR_JKIA_aabb
      execute list_to_blocks                Wjjia # HBAR_JKIA_bbaa
      execute list_to_blocks                Wiiai # HBAR_IAJK_aaaa
      execute list_to_blocks                Wiibj # HBAR_IAJK_aabb
      execute list_to_blocks                Wjjai # HBAR_IAJK_bbaa
      execute list_to_blocks                Wjjbj # HBAR_IAJK_bbbb
      execute list_to_blocks                Wiaai # HBAR_AJIB_aaaa
      execute list_to_blocks                Wjbbj # HBAR_AJIB_bbbb
      execute list_to_blocks                Wiabj # HBAR_AJIB_aabb
      execute list_to_blocks                Wjbai # HBAR_AJIB_BBAA
      execute list_to_blocks                W1iibb # HBAR_AJIB_iibb
      execute list_to_blocks                W1jjaa # HBAR_AJIB_jjaa
      execute list_to_blocks                Waaai # HBAR_ABCI_aaaa
      execute list_to_blocks                Wbbbj # HBAR_ABCI_bbbb
      execute list_to_blocks                Waabj # HBAR_ABCI_aabb
      execute list_to_blocks                Wbbai # HBAR_ABCI_bbaa
      execute list_to_blocks                quad_pq_x
      execute list_to_blocks                quad_pq_y
      execute list_to_blocks                quad_pq_z
#----------------F12-related intermediates-----------------------------
      execute list_to_blocks      T1_1
      execute list_to_blocks      T1_3
      execute list_to_blocks      T1_2
      execute list_to_blocks      T2_1
      execute list_to_blocks      T2_2
      execute list_to_blocks      T2_3S
      execute list_to_blocks      T2_3
      execute list_to_blocks      T2_5
      execute list_to_blocks      T2_6
      execute list_to_blocks      T2_7
      execute list_to_blocks      Hbar_ijka_F12S
      execute list_to_blocks      Hbar_ijka_F12
      execute list_to_blocks      T2_89S
      execute list_to_blocks      T2_8
      execute list_to_blocks      T2_9
      execute list_to_blocks      T2_10
      execute list_to_blocks      T2_11
      execute list_to_blocks      T2_10_3e
      execute list_to_blocks      T2_11_3e
      execute list_to_blocks      V2piai
      execute list_to_blocks      V0pipi
      execute list_to_blocks      V0apai
      execute list_to_blocks      V0aapi
      execute list_to_blocks      V2pipi
      execute list_to_blocks      V3iiii
      
      execute read_list_to_blocks
      execute server_barrier

#---------------------------------------------------------------------------

     ENDPROC READ_DATA
#    -----------------

#----------------------------------------------------------
#----------------------------------------------------------

     PROC DIPINT
#    ----------- 

      create dip_ao_x
      create dip_ao_y
      create dip_ao_z

      create dip_am_x
      create dip_am_y
      create dip_am_z

      create dip_pq_x
      create dip_pq_y
      create dip_pq_z

      execute sip_barrier
#--------Step 1 - copy quadrupole moment integrals------------------
      PARDO p,q
      REQUEST quad_pq_x(p,q) q
      T2_x(p,q) = quad_pq_x(p,q)
      PUT dip_pq_x(p,q) = T2_x(p,q)
      ENDPARDO p,q
      execute sip_barrier
#--------------------------------
      PARDO p,q
      REQUEST quad_pq_y(p,q) q
      T2_y(p,q) = quad_pq_y(p,q)
      PUT dip_pq_y(p,q) = T2_y(p,q)
      ENDPARDO p,q
      execute sip_barrier
#--------------------------------
      PARDO p,q
      REQUEST quad_pq_z(p,q) q
      T2_z(p,q) = quad_pq_z(p,q)
      PUT dip_pq_z(p,q) = T2_z(p,q)
      ENDPARDO p,q
      execute sip_barrier
#----------------------------------------------------
#----------------------------------------------------


     ENDPROC DIPINT
#    --------------

#----------------------------------------------------------
#----------------------------------------------------------

     PROC NUMINT
#    -----------

#-----------Step 1 - definition of the number of grid points--------------------------
            Ng = 0.0
            cnt = 0.0
            execute get_grid_size Ng
#---------Loop over the grid points---------------------------------------------------
            DO g
            cnt += 1.0
#--------Check if g is exceeded the number of grid points------
            IF cnt > Ng
            EXIT
            ENDIF
#----------Define to which worker belongs current point g--------------------------------
            execute grid_point_range cnt ind
#-----If g belongs to current worker - then do calculation-------------------------------           
            IF ind == 1.0
#----------Get the weight of current point g---------------------------------------------
            execute grid_point_weight cnt PTW
#========================================================================================
#========================================================================================
#-----------Generation of values of molecular orbitals on the grid-----------------------
                              allocate MOVAL(*)

                               DO p
#-----------------------------Molecular orbitals---------------------------------------   
                               MOVAL(p) = 0.0
                               tmoval(p) = 0.0
                               execute F12_2center_moobj tmoval cnt
                               MOVAL(p) = tmoval(p)
                               ENDDO p
#=====================================================================================
#=====================================================================================
                               allocate MOOVER(*,*)
                               allocate MOOVERX(*,*)
                               allocate MOOVERY(*,*)
                               allocate MOOVERZ(*,*)

#------------Preparation of MO overlap arrays-----------------------------------------
                               DO p
                               DO p1
                               tmoval(p) = MOVAL(p)
                               tmoval1(p1) =  MOVAL(p1)
                               tmoover(p,p1) = tmoval(p)^tmoval1(p1)
                               tmoover(p,p1) *= PTW
                               MOOVER(p,p1) = tmoover(p,p1)
                               ENDDO p1
                               ENDDO p
#---Preparation of MO overlap arrays, multiplied by x (component of dipole moment)----
                               DO p
                               DO p1 
                               tmoover(p,p1) = MOOVER(p,p1)
                               execute overquadx tmoover cnt
                               MOOVERX(p,p1) = tmoover(p,p1)
                               ENDDO p1
                               ENDDO p
#---Preparation of MO overlap arrays, multiplied by y (component of dipole moment)----
                               DO p
                               DO p1
                               tmoover(p,p1) = MOOVER(p,p1)
                               execute overquady tmoover cnt
                               MOOVERY(p,p1) = tmoover(p,p1)
                               ENDDO p1
                               ENDDO p
#---Preparation of MO overlap arrays, multiplied by z (component of dipole moment)----
                               DO p
                               DO p1
                               tmoover(p,p1) = MOOVER(p,p1)
                               execute overquadz tmoover cnt
                               MOOVERZ(p,p1) = tmoover(p,p1)
                               ENDDO p1
                               ENDDO p


#=====================================================================================
#=====================================================================================
#     Generation of 3-center objects, which are necessary for the calculation        |
#                   of three-electron integrals                                      |
#=====================================================================================


#-----------Allocate arrays for 3-center objects--------------------------------------
                              allocate slater_ip(*,*)
                              allocate slater_sq_ip(*,*)
#---------------Calculation of f_{1g} integrals------------------------------------------
                       int1_type = 2.0
                       execute int1_setup cnt int1_type


                               DO mu
                                 allocate l3center_imu(mu,*)
                                DO nu
                                          tmp3center(mu,nu) = 0.0
                                          execute f12_1el_gen tmp3center(mu,nu)
                                   DO i
                                   tmp3center_imu(mu,i) = tmp3center(mu,nu)*ca(nu,i)
                                   l3center_imu(mu,i) += tmp3center_imu(mu,i)
                                   ENDDO i

                                ENDDO nu

                                   DO i
                                   DO p
                                   tmp3center_pi(p,i) = l3center_imu(mu,i)*ca(mu,p)
                                   slater_ip(p,i) += tmp3center_pi(p,i)
                                   ENDDO p
                                   ENDDO i

                                   deallocate l3center_imu(mu,*)
                               ENDDO mu
#---------------Calculation of f_{1g}^2 integrals----------------------------------------
                       int1_type = 3.0
                       execute int1_setup cnt int1_type

                               DO mu
                                 allocate l3center_imu(mu,*)
                                DO nu
                                          tmp3center(mu,nu) = 0.0
                                          execute f12_1el_gen tmp3center(mu,nu)
                                   DO i
                                   tmp3center_imu(mu,i) = tmp3center(mu,nu)*ca(nu,i)
                                   l3center_imu(mu,i) += tmp3center_imu(mu,i)
                                   ENDDO i

                                ENDDO nu

                                   DO i
                                   DO p
                                   tmp3center_pi(p,i) = l3center_imu(mu,i)*ca(mu,p)
                                   slater_sq_ip(p,i) += tmp3center_pi(p,i)
                                   ENDDO p
                                   ENDDO i

                                   deallocate l3center_imu(mu,*)
                               ENDDO mu
#============================================================================|
#              Calculation of 3-electron integrals                           |
#============================================================================|

#----------------------------------------------------------------------------|
#                         sum_{M} <pjM|f12*f23|Mlk>                          |
#----------------------------------------------------------------------------|
                              allocate overint4(*,*)
                              DO p
                               DO j
                                tmoover(p,j) = 0.0
                                overint4(p,j) = 0.0

                                DO m
                                tmpint1(j,m) = 0.0
                                tmpint2(p,m) = 0.0
                                tmpint1(j,m) = slater_ip(j,m)
                                tmpint2(p,m) = slater_ip(p,m)

                                tmoover(p,j) = tmpint1(j,m)*tmpint2(p,m)
                                overint4(p,j) += tmoover(p,j)

                                ENDDO m
                               ENDDO j
                              ENDDO p
#-----------------------------------------------------------------------------
                              DO p
                               DO k
                                DO j
                                 DO l
                                 tF12F23_1(p,k,j,l) = 0.0
                                 tF12F23_1(p,k,j,l) = overint4(p,k)^MOOVER(j,l)
                                 PREPARE F12F23_1(p,k,j,l) += tF12F23_1(p,k,j,l)
                                 ENDDO l
                                ENDDO j
                               ENDDO k
                              ENDDO p
#----------------------------------------------------------------------------|
#                         sum_{M} <ijm|f12*f23|mlp>                          |
#----------------------------------------------------------------------------|
                              DO i
                               DO p
                                DO j
                                 DO l 
                                 tF12F23_2(i,p,j,l) = 0.0
                                 tF12F23_2(i,p,j,l) = overint4(p,i)^MOOVER(j,l)
                                 PREPARE F12F23_2(i,p,j,l) += tF12F23_2(i,p,j,l)
                                 ENDDO l
                                ENDDO j
                               ENDDO p
                              ENDDO i   
                              deallocate overint4(*,*)
#---------------------------------------------------------------------------------------
#       Three - electron integrals for X_ijkl - intermediate (geminal overlap)         |
#---------------------------------------------------------------------------------------
                              allocate overint1(*,*)
                              DO i
                              DO j
                              overint1(i,j) = 0.0
                              DO m
                              tslat1(j,m) = slater_ip(j,m)
                              tslat2(i,m) = slater_ip(i,m)
                              tmoover(i,j) = tslat1(j,m)*tslat2(i,m)
                              overint1(i,j) += tmoover(i,j)
                              ENDDO m
                              ENDDO j
                              ENDDO i
#---------------------------------------------------------------------------------------
                               DO i
                                DO k
                                 DO j
                                  DO l

                                  tX_ijkl(i,k,j,l) = overint1(i,k)^MOOVER(j,l)
                                  t1X_ijkl(i,k,j,l) = MOOVER(i,k)^overint1(j,l)
                                  tX_ijkl(i,k,j,l) += t1X_ijkl(i,k,j,l)
                                  tX_ijkl(i,k,j,l) *= -1.0
                                  PREPARE X_ijkl(i,k,j,l) += tX_ijkl(i,k,j,l)
                                                                                                                                                      ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i
#---------------------------------------------------------------------------------------
#               F12F13X = sum_{M} <ijM|f12*f13*x1|kml>                                 |  
#---------------------------------------------------------------------------------------
                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13X(i,k,j,l) = overint1(j,l)^MOOVERX(i,k)
                                  PREPARE F12F13X(i,k,j,l) += tF12F13X(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i
#---------------------------------------------------------------------------------------
#               F12F13Y = sum_{M} <ijM|f12*f13*y1|kml>                                 |  
#---------------------------------------------------------------------------------------
                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13Y(i,k,j,l) = overint1(j,l)^MOOVERY(i,k)
                                  PREPARE F12F13Y(i,k,j,l) += tF12F13Y(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i
#---------------------------------------------------------------------------------------
#               F12F13Z = sum_{M} <ijM|f12*f13*z1|kml>                                 |  
#---------------------------------------------------------------------------------------
                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13Z(i,k,j,l) = overint1(j,l)^MOOVERZ(i,k)
                                  PREPARE F12F13Z(i,k,j,l) += tF12F13Z(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i
                               deallocate overint1(*,*)
#---------------------------------------------------------------------------------------
#               F12F23Sx = sum_{M,N} <ijm|f12*f23|nlk><n|x|m>                          |
#---------------------------------------------------------------------------------------
                               allocate overint5(*,*) 
                              DO i
                              DO m
                               DO n
                               GET dip_pq_x(n,m)
                               tmoover(i,m) = slater_ip(i,n)*dip_pq_x(n,m)
                               overint5(i,m) += tmoover(i,m)
                               ENDDO n
                              ENDDO m
                              ENDDO i 

                               allocate overint3(*,*)
                                DO i   
                                DO k 
                                 DO m  
                                 tmoover(i,k) = overint5(i,m)*slater_ip(m,k)
                                 overint3(i,k) += tmoover(i,k)
                                 ENDDO m
                                ENDDO k  
                                ENDDO i 

                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13X(i,k,j,l) = overint3(i,k)^MOOVER(j,l)
                                  PREPARE F12F13Sx(i,k,j,l) += tF12F13X(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i

                               deallocate overint3(*,*)
                               deallocate overint5(*,*)
#---------------------------------------------------------------------------------------
#               F12F23Sy = sum_{M,N} <ijm|f12*f23|nlk><n|y|m>                          |
#---------------------------------------------------------------------------------------
                               allocate overint5(*,*)
                              DO i
                              DO m
                               DO n
                               GET dip_pq_y(n,m)
                               tmoover(i,m) = slater_ip(i,n)*dip_pq_y(n,m)
                               overint5(i,m) += tmoover(i,m)
                               ENDDO n
                              ENDDO m
                              ENDDO i

                               allocate overint3(*,*)
                                DO i
                                DO k
                                 DO m
                                 tmoover(i,k) = overint5(i,m)*slater_ip(m,k)
                                 overint3(i,k) += tmoover(i,k)
                                 ENDDO m
                                ENDDO k
                                ENDDO i

                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13Y(i,k,j,l) = overint3(i,k)^MOOVER(j,l)
                                  PREPARE F12F13Sy(i,k,j,l) += tF12F13Y(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i

                               deallocate overint3(*,*)
                               deallocate overint5(*,*)
#---------------------------------------------------------------------------------------
#               F12F23Sz = sum_{M,N} <ijm|f12*f23|nlk><n|z|m>                          |
#---------------------------------------------------------------------------------------
                               allocate overint5(*,*)
                              DO i
                              DO m
                               DO n
                               GET dip_pq_z(n,m)
                               tmoover(i,m) = slater_ip(i,n)*dip_pq_z(n,m)
                               overint5(i,m) += tmoover(i,m)
                               ENDDO n
                              ENDDO m
                              ENDDO i

                               allocate overint3(*,*)
                                DO i
                                DO k
                                 DO m
                                 tmoover(i,k) = overint5(i,m)*slater_ip(m,k)
                                 overint3(i,k) += tmoover(i,k)
                                 ENDDO m
                                ENDDO k
                                ENDDO i

                               DO i
                                DO k
                                 DO j
                                  DO l
                                  tF12F13Z(i,k,j,l) = overint3(i,k)^MOOVER(j,l)
                                  PREPARE F12F13Sz(i,k,j,l) += tF12F13Z(i,k,j,l)
                                  ENDDO l
                                 ENDDO j
                                ENDDO k
                               ENDDO i

                               deallocate overint3(*,*)
                               deallocate overint5(*,*)


#============================================================================|
#              Calculation of 2-electron integrals                           |
#============================================================================|

#----------------------------------------------------------------------------|
#               FF12X = <ij|f12^2*x1|kl>                                     |
#----------------------------------------------------------------------------|
                              DO i
                               DO k
                                DO j
                                 DO l
                                 tFF12(i,k,j,l)= slater_sq_ip(j,l)^MOOVERX(i,k)
                                 PREPARE FF12X(i,k,j,l) += tFF12(i,k,j,l) 
                                 ENDDO l
                                ENDDO j
                               ENDDO k
                              ENDDO i       
#----------------------------------------------------------------------------|
#               FF12Y = <ij|f12^2*y1|kl>                                     |
#----------------------------------------------------------------------------|
                              DO i
                               DO k
                                DO j
                                 DO l
                                 tFF12(i,k,j,l)= slater_sq_ip(j,l)^MOOVERY(i,k)
                                 PREPARE FF12Y(i,k,j,l) += tFF12(i,k,j,l)
                                 ENDDO l
                                ENDDO j
                               ENDDO k
                              ENDDO i
#----------------------------------------------------------------------------|
#               FF12Z = <ij|f12^2*z1|kl>                                     |
#----------------------------------------------------------------------------|
                              DO i
                               DO k
                                DO j
                                 DO l
                                 tFF12(i,k,j,l)= slater_sq_ip(j,l)^MOOVERZ(i,k)
                                 PREPARE FF12Z(i,k,j,l) += tFF12(i,k,j,l)
                                 ENDDO l
                                ENDDO j
                               ENDDO k
                              ENDDO i
#----------------------------------------------------------------------------|
#               F12Xpipi = <ij|f12*x2|pq>                                    |
#----------------------------------------------------------------------------|
                             DO i
                              DO p
                               DO j
                                DO q
                                tF12pipi(i,p,j,q) = slater_ip(p,i)^MOOVERX(j,q)
                                PREPARE F12Xpipi(i,p,j,q) += tF12pipi(i,p,j,q)  
                                ENDDO q
                               ENDDO j
                              ENDDO p
                             ENDDO i
#----------------------------------------------------------------------------|
#               F12Ypipi = <ij|f12*y2|pq>                                    |
#----------------------------------------------------------------------------|
                             DO i
                              DO p
                               DO j
                                DO q
                                tF12pipi(i,p,j,q) = slater_ip(p,i)^MOOVERY(j,q)
                                PREPARE F12Ypipi(i,p,j,q) += tF12pipi(i,p,j,q)  
                                ENDDO q
                               ENDDO j
                              ENDDO p
                             ENDDO i
#----------------------------------------------------------------------------|
#               F12Zpipi = <ij|f12*z2|pq>                                    |
#----------------------------------------------------------------------------|
                             DO i
                              DO p
                               DO j
                                DO q
                                tF12pipi(i,p,j,q) = slater_ip(p,i)^MOOVERZ(j,q)
                                PREPARE F12Zpipi(i,p,j,q) += tF12pipi(i,p,j,q)
                                ENDDO q
                               ENDDO j
                              ENDDO p
                             ENDDO i
#---------------------------------------------------------------------------------------- 
                              deallocate slater_ip(*,*)
                              deallocate slater_sq_ip(*,*)
                              deallocate MOOVERX(*,*)
                              deallocate MOOVERY(*,*)
                              deallocate MOOVERZ(*,*)
                              deallocate MOOVER(*,*) 
                              deallocate MOVAL(*)
#----------------------------------------------------------------------------------------
            ENDIF
            ENDDO g
            execute server_barrier
#

     ENDPROC NUMINT
#    --------------

#----------------------------------------------------------
#----------------------------------------------------------

     PROC INTERM1
#    ------------

#--------------Make C-coefficients according to cusp conditions-------------------------
      PARDO i,j,k,l
      tccusp(i,j,k,l) = 0.0
      execute f12_c_coef tccusp F12_GAMMA
      PREPARE C_coef(i,j,k,l) = tccusp(i,j,k,l)
      ENDPARDO i,j,k,l

      execute server_barrier

#-----------Auxiliary intermediates for T1 amplitudes contributions -------------------

      PARDO i,j,k,l
      REQUEST C_coef(i,j,k,l) i
      REQUEST C_coef(i,l,k,j) i
      tccusp(i,j,k,l) = C_coef(i,j,k,l)
      tccusp(i,j,k,l) *= -2.0
      t1ccusp(i,j,k,l) = C_coef(i,l,k,j)
      tccusp(i,j,k,l)  += t1ccusp(i,j,k,l)
      PREPARE CC1(i,j,k,l) += tccusp(i,j,k,l)
      ENDPARDO i,j,k,l

      execute server_barrier

      PARDO i,j,k,l
      REQUEST C_coef(i,j,k,l) i
      REQUEST C_coef(i,l,k,j) i
      tccusp(i,j,k,l) = C_coef(i,j,k,l)
      tccusp(i,j,k,l) *= 2.0
      t1ccusp(i,j,k,l) = C_coef(i,l,k,j)
      t1ccusp(i,j,k,l) *= -1.0
      tccusp(i,j,k,l) += t1ccusp(i,j,k,l)
      PREPARE CC2(i,j,k,l) += tccusp(i,j,k,l)
      ENDPARDO i,j,k,l
      execute server_barrier
#-------------Auxiliary intermediates----------------------|

#--------------Zero out intermediates-----------------------
 
      PARDO i,a,l,j
      tauxint1(i,a,l,j) = 0.0
      PREPARE auxint1x(i,a,l,j) = tauxint1(i,a,l,j)
      ENDPARDO i,a,l,j
      execute server_barrier

      PARDO i,a,l,j
      tauxint1(i,a,l,j) = 0.0
      PREPARE auxint1y(i,a,l,j) = tauxint1(i,a,l,j)
      ENDPARDO i,a,l,j
      execute server_barrier

      PARDO i,a,l,j
      tauxint1(i,a,l,j) = 0.0
      PREPARE auxint1z(i,a,l,j) = tauxint1(i,a,l,j)
      ENDPARDO i,a,l,j
      execute server_barrier
#-------------------------------
      PARDO i,a,j,b
      tauxint2(i,a,j,b) = 0.0
      PREPARE auxint2x(i,a,j,b) = tauxint2(i,a,j,b)
      ENDPARDO i,a,j,b
      execute server_barrier

      PARDO i,a,j,b
      tauxint2(i,a,j,b) = 0.0
      PREPARE auxint2y(i,a,j,b) = tauxint2(i,a,j,b)
      ENDPARDO i,a,j,b
      execute server_barrier  

      PARDO i,a,j,b
      tauxint2(i,a,j,b) = 0.0
      PREPARE auxint2z(i,a,j,b) = tauxint2(i,a,j,b)
      ENDPARDO i,a,j,b
      execute server_barrier
#-------------------------------------------------------------------

      PARDO i,j,a,l
      tauxint1(i,a,l,j) = 0.0
      DO p
      REQUEST V2pipi(a,i,p,j) a
      GET dip_pq_x(p,l) 
      tauxint3(i,a,l,j) = V2pipi(a,i,p,j)*dip_pq_x(p,l)
      tauxint1(i,a,l,j) += tauxint3(i,a,l,j)
      ENDDO p
      PREPARE auxint1x(i,a,l,j) += tauxint1(i,a,l,j)
      ENDPARDO i,j,a,l
      execute server_barrier 

      PARDO i,j,a,l
      tauxint1(i,a,l,j) = 0.0
      DO p
      REQUEST V2pipi(a,i,p,j) a
      GET dip_pq_y(p,l)
      tauxint3(i,a,l,j) = V2pipi(a,i,p,j)*dip_pq_y(p,l)
      tauxint1(i,a,l,j) += tauxint3(i,a,l,j)
      ENDDO p
      PREPARE auxint1y(i,a,l,j) += tauxint1(i,a,l,j)
      ENDPARDO i,j,a,l
      execute server_barrier

      PARDO i,j,a,l
      tauxint1(i,a,l,j) = 0.0
      DO p
      REQUEST V2pipi(a,i,p,j) a
      GET dip_pq_z(p,l)
      tauxint3(i,a,l,j) = V2pipi(a,i,p,j)*dip_pq_z(p,l)
      tauxint1(i,a,l,j) += tauxint3(i,a,l,j)
      ENDDO p
      PREPARE auxint1z(i,a,l,j) += tauxint1(i,a,l,j)
      ENDPARDO i,j,a,l
      execute server_barrier
#-------------------------------------------------------------------

      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(p,k,b,l) k
      GET dip_pq_x(p,a)
      tauxint4(k,a,l,b) = V2pipi(p,k,b,l)*dip_pq_x(p,a)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p  
      PREPARE auxint2x(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier 

      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(a,k,p,l) k
      GET dip_pq_x(p,b)
      tauxint4(k,a,l,b) = V2pipi(a,k,p,l)*dip_pq_x(p,b)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p
      PREPARE auxint2x(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier 
#-----------------------------------
      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(p,k,b,l) k
      GET dip_pq_y(p,a)
      tauxint4(k,a,l,b) = V2pipi(p,k,b,l)*dip_pq_y(p,a)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p
      PREPARE auxint2y(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier

      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(a,k,p,l) k
      GET dip_pq_y(p,b)
      tauxint4(k,a,l,b) = V2pipi(a,k,p,l)*dip_pq_y(p,b)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p
      PREPARE auxint2y(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier
#-----------------------------------
      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(p,k,b,l) k
      GET dip_pq_z(p,a)
      tauxint4(k,a,l,b) = V2pipi(p,k,b,l)*dip_pq_z(p,a)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p
      PREPARE auxint2z(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier

      PARDO k,l,a,b
      tauxint2(k,a,l,b) = 0.0
      DO p
      REQUEST V2pipi(a,k,p,l) k
      GET dip_pq_z(p,b)
      tauxint4(k,a,l,b) = V2pipi(a,k,p,l)*dip_pq_z(p,b)
      tauxint2(k,a,l,b) += tauxint4(k,a,l,b)
      ENDDO p
      PREPARE auxint2z(k,a,l,b) += tauxint2(k,a,l,b)
      ENDPARDO k,l,a,b
      execute server_barrier
#-----------------------------------



#----------------------------------------------------------|
#   Generate intermediate for L1 contribution              |
#----------------------------------------------------------|

      PARDO k,a
      tintl1(k,a) = 0.0
      PREPARE intl1x(k,a) = tintl1(k,a)
      ENDPARDO k,a
      execute server_barrier

      PARDO k,a
      tintl1(k,a) = 0.0
      PREPARE intl1y(k,a) = tintl1(k,a)
      ENDPARDO k,a
      execute server_barrier 

      PARDO k,a
      tintl1(k,a) = 0.0
      PREPARE intl1z(k,a) = tintl1(k,a)
      ENDPARDO k,a
      execute server_barrier

#----------------x-component-------------------------------|
      PARDO i,j,k,l,a
      REQUEST F12Xpipi(i,a,j,l) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*F12Xpipi(i,a,j,l)
      PREPARE intl1x(k,a) += tintl1(k,a)     
      ENDPARDO i,j,k,l,a
      execute server_barrier 

      PARDO i,j,k,l,a
      REQUEST auxint1x(i,a,l,j) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*auxint1x(i,a,l,j)
      tintl1(k,a) *= -1.0
      PREPARE intl1x(k,a) += tintl1(k,a)
      ENDPARDO i,j,k,l,a
      execute server_barrier 
#----------------y-component-------------------------------|
      PARDO i,j,k,l,a
      REQUEST F12Ypipi(i,a,j,l) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*F12Ypipi(i,a,j,l)
      PREPARE intl1y(k,a) += tintl1(k,a)
      ENDPARDO i,j,k,l,a
      execute server_barrier

      PARDO i,j,k,l,a
      REQUEST auxint1y(i,a,l,j) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*auxint1y(i,a,l,j)
      tintl1(k,a) *= -1.0
      PREPARE intl1y(k,a) += tintl1(k,a)
      ENDPARDO i,j,k,l,a
      execute server_barrier
#----------------z-component-------------------------------|
      PARDO i,j,k,l,a
      REQUEST F12Zpipi(i,a,j,l) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*F12Zpipi(i,a,j,l)
      PREPARE intl1z(k,a) += tintl1(k,a)
      ENDPARDO i,j,k,l,a
      execute server_barrier

      PARDO i,j,k,l,a
      REQUEST auxint1z(i,a,l,j) i
      REQUEST CC2(i,k,j,l) i
      tintl1(k,a) = CC2(i,k,j,l)*auxint1z(i,a,l,j)
      tintl1(k,a) *= -1.0
      PREPARE intl1z(k,a) += tintl1(k,a)
      ENDPARDO i,j,k,l,a
      execute server_barrier
#----------------------------------------------------------|
#   Generate intermediate for L2 contribution              |
#----------------------------------------------------------|

#-------------Zero out intermediates-----------------------|
      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      PREPARE intl2x(i,a,j,b) = tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      PREPARE intl2y(i,a,j,b) = tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      PREPARE intl2z(i,a,j,b) = tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

#----------------x-component-------------------------------|
      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST F12Xpipi(l,b,k,a) k
      REQUEST F12Xpipi(k,a,l,b) k 
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = F12Xpipi(l,b,k,a)*C_coef(i,k,j,l)
      tintl2_2(i,a,j,b) = F12Xpipi(k,a,l,b)*C_coef(i,k,j,l)
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      tintl2(i,a,j,b) += tintl2_2(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2x(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier 

      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST auxint2x(k,a,l,b) k
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = auxint2x(k,a,l,b)*C_coef(i,k,j,l)
      tintl2_1(i,a,j,b) *= -1.0
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2x(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier
#----------------y-component-------------------------------|
      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST F12Ypipi(l,b,k,a) k
      REQUEST F12Ypipi(k,a,l,b) k
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = F12Ypipi(l,b,k,a)*C_coef(i,k,j,l)
      tintl2_2(i,a,j,b) = F12Ypipi(k,a,l,b)*C_coef(i,k,j,l)
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      tintl2(i,a,j,b) += tintl2_2(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2y(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST auxint2y(k,a,l,b) k
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = auxint2y(k,a,l,b)*C_coef(i,k,j,l)
      tintl2_1(i,a,j,b) *= -1.0
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2y(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier
#----------------z-component-------------------------------|
      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST F12Zpipi(l,b,k,a) k
      REQUEST F12Zpipi(k,a,l,b) k
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = F12Zpipi(l,b,k,a)*C_coef(i,k,j,l)
      tintl2_2(i,a,j,b) = F12Zpipi(k,a,l,b)*C_coef(i,k,j,l)
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      tintl2(i,a,j,b) += tintl2_2(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2z(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

      PARDO i,j,a,b
      tintl2(i,a,j,b) = 0.0
      DO k
      DO l
      REQUEST auxint2z(k,a,l,b) k
      REQUEST C_coef(i,k,j,l) i
      tintl2_1(i,a,j,b) = auxint2z(k,a,l,b)*C_coef(i,k,j,l)
      tintl2_1(i,a,j,b) *= -1.0
      tintl2(i,a,j,b) += tintl2_1(i,a,j,b)
      ENDDO l
      ENDDO k
      PREPARE intl2z(i,a,j,b) += tintl2(i,a,j,b)
      ENDPARDO i,j,a,b
      execute server_barrier

     ENDPROC INTERM1
