#----------------------------------------------------------
#----------------------------------------------------------
     PROC INTERMX
#    ------------ 

#--------Zero out intermediate-----------------------------
     PARDO i,j,k,l
     tX_ijkl(i,j,k,l) = 0.0
     PREPARE Xijkl(i,j,k,l) = tX_ijkl(i,j,k,l)
     ENDPARDO i,j,k,l
     execute server_barrier
#------<ij|f12^2|kl> and 3e components---------------------

     PARDO i,j,k,l
     tX_ijkl(i,k,j,l) = 0.0
     REQUEST V3iiii(i,k,j,l) i
     tX_ijkl(i,k,j,l) = V3iiii(i,k,j,l)
     PREPARE Xijkl(i,k,j,l) += tX_ijkl(i,k,j,l)
     ENDPARDO i,j,k,l
     execute server_barrier

     PARDO i,k,j,l
     tX_ijkl(i,k,j,l) = 0.0
     REQUEST X_ijkl(i,k,j,l) i
     tX_ijkl(i,k,j,l) = X_ijkl(i,k,j,l)
     PREPARE Xijkl(i,k,j,l) += tX_ijkl(i,k,j,l)
     ENDPARDO i,k,j,l
     execute server_barrier


#----------M,N - component-------------------------------- 
     
     PARDO i,k,j,l
     tX_ijkl(i,k,j,l) = 0.0
     DO m
     DO n
     REQUEST V2pipi(m,i,n,j) m
     REQUEST V2pipi(m,k,n,l) m
     tv2pipi1(m,i,n,j) = V2pipi(m,i,n,j)
     tv2pipi2(m,k,n,l) = V2pipi(m,k,n,l)
     t1X_ijkl(i,k,j,l) = tv2pipi1(m,i,n,j)*tv2pipi2(m,k,n,l)
     tX_ijkl(i,k,j,l) += t1X_ijkl(i,k,j,l) 
     ENDDO n
     ENDDO m
     PREPARE Xijkl(i,k,j,l) += tX_ijkl(i,k,j,l)
     ENDPARDO i,k,j,l
     execute server_barrier   


#----------A,B - component--------------------------------

     PARDO i,k,j,l
     tX_ijkl(i,k,j,l) = 0.0
     DO a
     DO b
     REQUEST V2pipi(a,i,b,j) a
     REQUEST V2pipi(a,k,b,l) a
     tv2pipi1(a,i,b,j) = V2pipi(a,i,b,j)
     tv2pipi2(a,k,b,l) = V2pipi(a,k,b,l)
     t1X_ijkl(i,k,j,l) = tv2pipi1(a,i,b,j)*tv2pipi2(a,k,b,l)
     t1X_ijkl(i,k,j,l) *= -1.0
     tX_ijkl(i,k,j,l) += t1X_ijkl(i,k,j,l)
     ENDDO b
     ENDDO a
     PREPARE Xijkl(i,k,j,l) += tX_ijkl(i,k,j,l)
     ENDPARDO i,k,j,l
     execute server_barrier 

     ENDPROC INTERMX
