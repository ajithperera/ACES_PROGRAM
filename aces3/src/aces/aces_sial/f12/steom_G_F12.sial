      execute server_barrier

      PARDO i,j,a,b,d
      DO vact
      REQUEST S_ej_ab(vact,a,d,j) a
      tmp_S_ej_ab(vact,a,d,j) = S_ej_ab(vact,a,d,j)
      REQUEST Wbjaa(b,d,i,a) a
      tmp_bjaa(b,d,i,a) = Wbjaa(b,d,i,a)
      tmp_P_bj_ke(vact,i,j,b) = tmp_S_ej_ab(vact,a,d,j)*tmp_bjaa(b,d,i,a)
      PREPARE P_bj_ke(vact,i,j,b) += tmp_P_bj_ke(vact,i,j,b)
      ENDDO vact
      ENDPARDO i,j,a,b,d
      execute server_barrier 
#-----------F12 contribition to P_bj_ke intermediate----------|

      IF EAEOMF12CALC == 1.0

      chunk_type = 1.0
      RL = 4.0
      execute eomchunk RL chunk_type

      PARDO i,j,a,b
      REQUEST Hbar_ai_jb_eomea(a,i,j,b) a
      tmp_Hbar_ai_jb_eomea(a,i,j,b) = Hbar_ai_jb_eomea(a,i,j,b)

      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      tmp_P_bj_ke(vact,i,j,b) = 0.0

      IF cnt_virt <= ea_ind
      execute steom_f12_vact tmp_Hbar_ai_jb_eomea tmp_P_bj_ke
      ENDIF
      
      PREPARE P_bj_ke_F12(vact,i,j,b) += tmp_P_bj_ke(vact,i,j,b)
      ENDDO vact
      ENDPARDO i,j,a,b
      execute server_barrier
#---------------------------------------------------------|
#---------------------------------------------------------|
      PARDO i,j,b
      DO vact
      REQUEST P_bj_ke_F12(vact,i,j,b) b
      tmp_P_bj_ke(vact,i,j,b) = P_bj_ke_F12(vact,i,j,b)
      PREPARE P_bj_ke(vact,i,j,b) += tmp_P_bj_ke(vact,i,j,b)
      ENDDO vact
      ENDPARDO i,j,b
      execute server_barrier      



      ENDIF

#----------------------------------|
#      P_bj_me(oact,vact,j,b)      |
#----------------------------------|

       PARDO a,b,j
       DO oact
       REQUEST X_ma(oact,a) a
       tmp_X_ma(oact,a) = X_ma(oact,a)
       DO vact
       REQUEST S_ej_ab(vact,a,b,j) a
       tmp_S_ej_ab(vact,a,b,j) = S_ej_ab(vact,a,b,j)
       tmp_P_bj_me(oact,vact,j,b) = tmp_S_ej_ab(vact,a,b,j)*tmp_X_ma(oact,a)
       PREPARE P_bj_me(oact,vact,j,b) += tmp_P_bj_me(oact,vact,j,b)
       ENDDO vact
       ENDDO oact
       ENDPARDO a,b,j
       execute server_barrier

       PARDO k,b,j
       DO oact
       REQUEST S_ij_mb(oact,k,j,b) b
       tmp_S_ij_mb(oact,k,j,b) = S_ij_mb(oact,k,j,b)
       DO vact
       REQUEST X_ie(k,vact) k
       tmp_X_ie(k,vact) = X_ie(k,vact)
       tmp_P_bj_me(oact,vact,j,b) = tmp_S_ij_mb(oact,k,j,b)*tmp_X_ie(k,vact)
       tmp_P_bj_me(oact,vact,j,b) *= -1.0
       PREPARE P_bj_me(oact,vact,j,b) += tmp_P_bj_me(oact,vact,j,b) 
       ENDDO vact
       ENDDO oact
       ENDPARDO k,b,j
       execute server_barrier
       
       PARDO k,d,b,j
       DO oact
       REQUEST Y_ki_md(oact,d,j,k) k
       tmp_Y_ki_md(oact,d,j,k) = Y_ki_md(oact,d,j,k)
       DO vact
       REQUEST S_ej_ab(vact,d,b,k) k
       tmp_S_ej_ab(vact,d,b,k) = S_ej_ab(vact,d,b,k)
       tmp_P_bj_me(oact,vact,j,b) = tmp_S_ej_ab(vact,d,b,k)*tmp_Y_ki_md(oact,d,j,k)
       tmp_P_bj_me(oact,vact,j,b) *= -1.0
       PREPARE P_bj_me(oact,vact,j,b) += tmp_P_bj_me(oact,vact,j,b)
       ENDDO vact
       ENDDO oact
       ENDPARDO k,d,b,j
       execute server_barrier

       PARDO k,l,b,j
       DO oact
       REQUEST S_ij_mb(oact,k,l,b) b
       tmp_S_ij_mb(oact,k,l,b) = S_ij_mb(oact,k,l,b)
       DO vact
       REQUEST Y_ki_le(vact,k,j,l) k
       tmp_Y_ki_le(vact,k,j,l) = Y_ki_le(vact,k,j,l)      
       tmp_P_bj_me(oact,vact,j,b) = tmp_Y_ki_le(vact,k,j,l)*tmp_S_ij_mb(oact,k,l,b)
       PREPARE P_bj_me(oact,vact,j,b) += tmp_P_bj_me(oact,vact,j,b)
       ENDDO vact
       ENDDO oact
       ENDPARDO k,l,b,j
       execute server_barrier

#----------------------------------

      ENDPROC MAKE_INTERM_pqrs
#     -------------------------

#---------------------------------------------------------------|
#        Preparation of Gbar elemennts                          |
#---------------------------------------------------------------|

      PROC MAKE_Gbar
#     ---------------------


#-------------G_ki----------------------------------------------|

#----- RL = 1.0 - one active occupied index---------------------|

      chunk_type = 1.0
      RL = 1.0
      execute eomchunk RL chunk_type

      
      PARDO i,j
      GET Uii(j,i)
      tii(j,i) = Uii(j,i)
      tmp_G_ik(i,j) = tii(j,i)
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST X_mi(oact,i) i 
      tmp_X_mi(oact,i) = X_mi(oact,i)
      execute steom_gbar tmp_X_mi tmp_G_ik
      ENDIF
      ENDDO oact
      PREPARE G_ik(i,j) += tmp_G_ik(i,j) 
      ENDPARDO i,j
      execute server_barrier 

#-------------G_ac----------------------------------------------|

      chunk_type = 1.0
      RL = 2.0
      execute eomchunk RL chunk_type

      PARDO a,b
      GET   Uaa(a,b)
      tmp_G_ac(a,b) = Uaa(a,b)
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST X_ae(a,vact) a
      tmp_X_ae(a,vact) = X_ae(a,vact)
      execute steom_gbar tmp_X_ae tmp_G_ac
      ENDDO vact
      PREPARE G_ac(a,b) += tmp_G_ac(a,b)
      ENDPARDO a,b
      execute server_barrier

#-------------G_ia----------------------------------------------|

      chunk_type = 1.0
      RL = 3.0
      execute eomchunk RL chunk_type

      PARDO i,a
      GET Uia(i,a)
      tmp_G_ia(i,a) = Uia(i,a)
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind     
      ELSE
      REQUEST X_ma(oact,a) a
      tmp_X_ma(oact,a) = X_ma(oact,a)     
      execute steom_gbar tmp_X_ma tmp_G_ia
      ENDIF
      ENDDO oact
      PREPARE G_ia(i,a) += tmp_G_ia(i,a)
      ENDPARDO i,a
      execute server_barrier
      
      chunk_type = 1.0
      RL = 4.0
      execute eomchunk RL chunk_type

      PARDO i,a
      tmp_G_ia(i,a) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST X_ie(i,vact) i
      tmp_X_ie(i,vact) = X_ie(i,vact)
      execute steom_gbar tmp_X_ie tmp_G_ia
      ENDDO vact
      PREPARE G_ia(i,a) += tmp_G_ia(i,a)
      ENDPARDO i,a
      execute server_barrier


#---------------G_ik_ld-----------------------------------------|

      chunk_type = 1.0
      RL = 5.0
      execute eomchunk RL chunk_type

      PARDO i,k,l,d
      REQUEST Wiijb(k,i,l,d) i
      tmp_iijb(k,i,l,d) = Wiijb(k,i,l,d)
      tmp_G_ik_ld(i,k,l,d) = tmp_iijb(k,i,l,d)
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST Y_mi_ld(oact,i,l,d) i 
      tmp_Y_mi_ld(oact,i,l,d) = Y_mi_ld(oact,i,l,d) 
      execute steom_gbar tmp_Y_mi_ld tmp_G_ik_ld
      ENDIF
      ENDDO oact
      PREPARE G_ik_ld(i,k,l,d) += tmp_G_ik_ld(i,k,l,d)
      ENDPARDO i,k,l,d
      execute server_barrier

      chunk_type = 1.0
      RL = 6.0
      execute eomchunk RL chunk_type

      PARDO i,k,l,d
      tmp_G_ik_ld(i,k,l,d) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST Y_ki_md(oact,d,i,k) k
      tmp_Y_ki_md(oact,d,i,k) = Y_ki_md(oact,d,i,k)
      execute steom_gbar tmp_Y_ki_md tmp_G_ik_ld
      ENDIF
      ENDDO oact
      PREPARE G_ik_ld(i,k,l,d) += tmp_G_ik_ld(i,k,l,d)
      ENDPARDO i,k,l,d
      execute server_barrier

      chunk_type = 1.0
      RL = 7.0
      execute eomchunk RL chunk_type

      PARDO i,k,l,d
      tmp_G_ik_ld(i,k,l,d) = 0.0 
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST Y_ki_le(vact,l,i,k) k 
      tmp_Y_ki_le(vact,l,i,k) = Y_ki_le(vact,l,i,k)
      execute steom_gbar tmp_Y_ki_le tmp_G_ik_ld
      ENDDO vact
      PREPARE G_ik_ld(i,k,l,d) += tmp_G_ik_ld(i,k,l,d)
      ENDPARDO i,k,l,d
      execute server_barrier

#---------------G_ac_ld-----------------------------------------|
      chunk_type = 1.0
      RL = 8.0
      execute eomchunk RL chunk_type

      PARDO a,b,l,d
      REQUEST Wbjaa(a,b,l,d) a
      tmp_G_ac_ld(a,b,l,d) = Wbjaa(a,b,l,d) 
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST Y_dl_ea(vact,a,l,d) d 
      tmp_Y_dl_ea(vact,a,l,d) = Y_dl_ea(vact,a,l,d)
      execute steom_gbar tmp_Y_dl_ea tmp_G_ac_ld
      ENDDO vact
      PREPARE G_ac_ld(a,b,l,d) += tmp_G_ac_ld(a,b,l,d)
      ENDPARDO a,b,l,d
      execute server_barrier      

      chunk_type = 1.0
      RL = 9.0
      execute eomchunk RL chunk_type

      PARDO a,b,l,d
      tmp_G_ac_ld(a,b,l,d) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST Y_ac_le(vact,l,a,b) a 
      tmp_Y_ac_le(vact,l,a,b) = Y_ac_le(vact,l,a,b) 
      execute steom_gbar tmp_Y_ac_le tmp_G_ac_ld
      ENDDO vact
      PREPARE G_ac_ld(a,b,l,d) += tmp_G_ac_ld(a,b,l,d)
      ENDPARDO a,b,l,d
      execute server_barrier

      chunk_type = 1.0
      RL = 10.0
      execute eomchunk RL chunk_type

      PARDO a,b,l,d
      tmp_G_ac_ld(a,b,l,d) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST Y_md_ac(oact,d,a,b) a
      tmp_Y_md_ac(oact,d,a,b) = Y_md_ac(oact,d,a,b)
      execute steom_gbar tmp_Y_md_ac tmp_G_ac_ld
      ENDIF
      ENDDO oact
      PREPARE G_ac_ld(a,b,l,d) += tmp_G_ac_ld(a,b,l,d)
      ENDPARDO a,b,l,d
      execute server_barrier 
#---------------G_ik_jl-----------------------------------------|      

      chunk_type = 1.0
      RL = 11.0
      execute eomchunk RL chunk_type

      PARDO i,j,k,l
      REQUEST  Wiijj(k,i,l,j) i
      tmp_G_ik_jl(k,i,l,j) = Wiijj(k,i,l,j)
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST V_mi_lj(oact,i,j,l) i 
      tmp_V_mi_lj(oact,i,j,l) = V_mi_lj(oact,i,j,l)
      execute steom_gbar tmp_V_mi_lj tmp_G_ik_jl
      ENDIF
      ENDDO oact
      PREPARE G_ik_jl(k,i,l,j) += tmp_G_ik_jl(k,i,l,j)
      ENDPARDO i,j,k,l
      execute server_barrier

      chunk_type = 1.0
      RL = 12.0
      execute eomchunk RL chunk_type

      PARDO i,j,k,l
      tmp_G_ik_jl(k,i,l,j) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST V_mi_lj(oact,j,i,k) i 
      tmp_V_mi_lj(oact,j,i,k) = V_mi_lj(oact,j,i,k)
      execute steom_gbar tmp_V_mi_lj tmp_G_ik_jl
      ENDIF
      ENDDO oact
      PREPARE G_ik_jl(k,i,l,j) += tmp_G_ik_jl(k,i,l,j)
      ENDPARDO i,j,k,l
      execute server_barrier

      chunk_type = 1.0
      RL = 13.0
      execute eomchunk RL chunk_type

      PARDO i,j,k,l
      tmp_G_ik_jl(k,i,l,j) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      cnt_occ1 = 0.0
      DO oact1
      cnt_occ1 += 1.0
      IF cnt_occ1 < ip_ind
      ELSE
      REQUEST Z_mi_nj(oact,i,oact1,j) j
      tmp_Z_mi_nj(oact,i,oact1,j) = Z_mi_nj(oact,i,oact1,j)
      execute steom_gbar tmp_Z_mi_nj tmp_G_ik_jl
      ENDIF
      ENDDO oact1
      ENDIF
      ENDDO oact
      PREPARE G_ik_jl(k,i,l,j) += tmp_G_ik_jl(k,i,l,j)
      ENDPARDO i,j,k,l
      execute server_barrier

#---------------G_ac_bd-----------------------------------------|

      chunk_type = 1.0
      RL = 14.0
      execute eomchunk RL chunk_type

      PARDO a,a1,b,b1
      tmp_G_ac_bd(a,a1,b,b1) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST V_ae_bd(vact,a,b,b1) a
      tmp_V_ae_bd(vact,a,b,b1) = V_ae_bd(vact,a,b,b1)
      execute steom_gbar tmp_V_ae_bd tmp_G_ac_bd
      ENDDO vact
      PREPARE G_ac_bd(a,a1,b,b1) += tmp_G_ac_bd(a,a1,b,b1)
      ENDPARDO a,a1,b,b1
      execute server_barrier

      chunk_type = 1.0
      RL = 15.0
      execute eomchunk RL chunk_type

      PARDO a,a1,b,b1
      tmp_G_ac_bd(a,a1,b,b1) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST V_ae_bd(vact,b,a,a1) a
      tmp_V_ae_bd(vact,b,a,a1) = V_ae_bd(vact,b,a,a1)
      execute steom_gbar tmp_V_ae_bd tmp_G_ac_bd
      ENDDO vact
      PREPARE G_ac_bd(a,a1,b,b1) += tmp_G_ac_bd(a,a1,b,b1)
      ENDPARDO a,a1,b,b1
      execute server_barrier


      chunk_type = 1.0
      RL = 16.0
      execute eomchunk RL chunk_type

      PARDO a,a1,b,b1
      tmp_G_ac_bd(a,a1,b,b1) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      cnt_virt1 = 0.0 
      DO vact1
      cnt_virt1 += 1.0
      IF cnt_virt1 > ea_ind
      EXIT
      ENDIF
      REQUEST Z_ae_bf(vact,a,vact1,b) a
      tmp_Z_ae_bf(vact,a,vact1,b) =  Z_ae_bf(vact,a,vact1,b)
      execute steom_gbar tmp_Z_ae_bf tmp_G_ac_bd
      ENDDO vact1
      ENDDO vact
      PREPARE G_ac_bd(a,a1,b,b1) += tmp_G_ac_bd(a,a1,b,b1)
      ENDPARDO a,a1,b,b1
      execute server_barrier
#---------------G_ab_ij-----------------------------------------|

      chunk_type = 1.0
      RL = 17.0
      execute eomchunk RL chunk_type

      PARDO a,b,i,j
      REQUEST Wiibb(j,i,a,b) j
      tmp_iibb(j,i,a,b) = Wiibb(j,i,a,b)
      tmp_iibb(j,i,a,b) *= -1.0
      tmp_G_ab_ij(a,b,i,j) = tmp_iibb(j,i,a,b)
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST Q_ki_ae(i,j,a,vact) i 
      tmp_Q_ki_ae(i,j,a,vact) = Q_ki_ae(i,j,a,vact)   
      execute steom_gbar tmp_Q_ki_ae tmp_G_ab_ij
      ENDDO vact
      PREPARE G_ab_ij(a,b,i,j) += tmp_G_ab_ij(a,b,i,j)
      ENDPARDO a,b,i,j
      execute server_barrier 

      chunk_type = 1.0
      RL = 18.0
      execute eomchunk RL chunk_type

      PARDO a,b,i,j
      tmp_G_ab_ij(a,b,i,j) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST Q_ac_mi(oact,i,a,b) a
      tmp_Q_ac_mi(oact,i,a,b) = Q_ac_mi(oact,i,a,b)      
      execute steom_gbar tmp_Q_ac_mi tmp_G_ab_ij
      ENDIF
      ENDDO oact
      PREPARE G_ab_ij(a,b,i,j) += tmp_G_ab_ij(a,b,i,j)
      ENDPARDO a,b,i,j
      execute server_barrier

      chunk_type = 1.0
      RL = 19.0
      execute eomchunk RL chunk_type

      PARDO a,b,i,j
      tmp_G_ab_ij(a,b,i,j) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST Q_mi_ae(oact,i,a,vact) a
      tmp_Q_mi_ae(oact,i,a,vact) = Q_mi_ae(oact,i,a,vact)
      execute steom_gbar tmp_Q_mi_ae tmp_G_ab_ij
      ENDDO vact 
      ENDIF
      ENDDO oact
      PREPARE G_ab_ij(a,b,i,j) += tmp_G_ab_ij(a,b,i,j)
      ENDPARDO a,b,i,j
      execute server_barrier
#---------------G_ai_bj-----------------------------------------|      

      chunk_type = 1.0
      RL = 20.0
      execute eomchunk RL chunk_type

      PARDO a,i,b,j
      REQUEST Wiabj(j,b,a,i) i
      tmp_aibj(j,b,a,i) = Wiabj(j,b,a,i) 
      tmp1_G_ai_bj(b,j,a,i) = tmp_aibj(j,b,a,i)
      tmp_G_ai_bj(b,j,a,i) = 0.0
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST P_bj_ke(vact,j,i,a) i
      tmp_P_bj_ke(vact,j,i,a) = P_bj_ke(vact,j,i,a) 
      execute steom_gbar tmp_P_bj_ke tmp_G_ai_bj
      ENDDO vact
      tmp_G_ai_bj(b,j,a,i) += tmp1_G_ai_bj(b,j,a,i)
      PREPARE G_ai_bj(b,j,a,i) += tmp_G_ai_bj(b,j,a,i)
      ENDPARDO a,i,b,j
      execute server_barrier           

      chunk_type = 1.0
      RL = 21.0
      execute eomchunk RL chunk_type

      PARDO a,i,b,j
      tmp_G_ai_bj(b,j,a,i) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      REQUEST P_bj_mc(oact,b,i,a) a
      tmp_P_bj_mc(oact,b,i,a) = P_bj_mc(oact,b,i,a)
      execute steom_gbar tmp_P_bj_mc tmp_G_ai_bj
      ENDIF
      ENDDO oact
      PREPARE G_ai_bj(b,j,a,i) += tmp_G_ai_bj(b,j,a,i)
      ENDPARDO a,i,b,j
      execute server_barrier      


      chunk_type = 1.0
      RL = 22.0
      execute eomchunk RL chunk_type

      PARDO a,i,b,j
      tmp_G_ai_bj(b,j,a,i) = 0.0
      cnt_occ = 0.0
      DO oact
      cnt_occ += 1.0
      IF cnt_occ < ip_ind
      ELSE
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      IF cnt_virt > ea_ind
      EXIT
      ENDIF
      REQUEST P_bj_me(oact,vact,i,a) a
      tmp_P_bj_me(oact,vact,i,a) = P_bj_me(oact,vact,i,a)
      execute steom_gbar tmp_P_bj_me tmp_G_ai_bj
      ENDDO vact
      ENDIF
      ENDDO oact
      PREPARE G_ai_bj(b,j,a,i) += tmp_G_ai_bj(b,j,a,i)
      ENDPARDO a,i,b,j
      execute server_barrier
#---------------------------------------------------------------|

#         PARDO a,i,b,j
#         REQUEST G_ai_bj(a,i,b,j) a
#         tmp_G_ai_bj(a,i,b,j) = G_ai_bj(a,i,b,j)
#         execute dump_amp tmp_G_ai_bj
#         ENDPARDO a,i,b,j
#         execute server_barrier



      ENDPROC MAKE_Gbar
#     ---------------------

#---------------------------------------------------------------|
#          Dump Gbar elements to the disk                       |
#---------------------------------------------------------------|

      PROC DUMP_GBAR
#     --------------   

            execute blocks_to_list      G_ik
            execute blocks_to_list      G_ac
            execute blocks_to_list      G_ia 
            execute blocks_to_list      G_ik_ld
            execute blocks_to_list      G_ac_ld
            execute blocks_to_list      G_ik_jl
            execute blocks_to_list      G_ac_bd
            execute blocks_to_list      G_ab_ij
            execute blocks_to_list      G_ai_bj(a,i,b,j)

            execute write_blocks_to_list
            execute server_barrier

      ENDPROC DUMP_GBAR
#     ------------------

#===============================================================|
#                    Main program                               |
#===============================================================|

     F12CALC = 0.0
     execute f12info F12CALC
     execute print_scalar F12CALC
     execute eomeaf12info EAEOMF12CALC

#---------Read integrals and Hbar-------------------------------|
      CALL READ_DATA
#---------------------------------------------------------------|


#---------------------------------------------------------------|
#   Get number of active occupied and virtual orbitals          |
#---------------------------------------------------------------|
        execute eomearoots n_act_virt
        execute eomiproots n_act_occ

      ip_ind = 0.0
      DO oact
      ip_ind += 1.0
      ENDDO oact
      execute print_scalar ip_ind  

      ip_ind -= n_act_occ
      ip_ind += 1.0
      execute print_scalar ip_ind

      ea_ind = 0.0
      ea_ind += n_act_virt
      execute print_scalar ea_ind
#---------------------------------------------------------------|
#   Genration of S(+) and S(-) amplitudes                       |
#---------------------------------------------------------------|
      CALL MAKE_S_AMPLITUDES
#---------------------------------------------------------------|
#       Generation of single-particle intermediates             |
#---------------------------------------------------------------|
      CALL MAKE_INTERM_pq
#---------------------------------------------------------------|
#       Generation of two-particle intermediates                |
#---------------------------------------------------------------|
      CALL MAKE_INTERM_pqrs 
#---------------------------------------------------------------|
#        Preparation of Gbar elemennts                          |
#---------------------------------------------------------------|
      CALL MAKE_Gbar
#---------------------------------------------------------------|
#        Dump Gbar elements to the disk                         |
#---------------------------------------------------------------|
      CALL DUMP_GBAR
#----------------------------------------------------------------
                      ENDSIAL STEOM_G_F12 

