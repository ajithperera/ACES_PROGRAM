#--------------------------------------------------------------------------|
# This part of code does construction of matrix elements of doubly         | 
# transformed effective  hamiltonian  G = {exp(S)}^{-1}*Hbar*exp{S}, which |
# are necessary for STEOM-EE,STEOM-DIP and STEOM-DEA calculations          |
#  Added by Denis Bokhan, Moscow Lomonosov State University,               | 
#                 Moscow, Russian Federation                               | 
#--------------------------------------------------------------------------|


                       SIAL STEOM_G_F12
#--------------------------------------------------------------|
#     Maximal number of target IP and EA roots - 20            |
#--------------------------------------------------------------|
      index   root = 1,20
      index   root1 = 1,20
      index   root2 = 1,20
      index   target_roots = 1,25
      index   niter =  1,40
      index   niter_main = 1,40
      index   auxind1 = 1,800
      index   auxind2 = 1,800
      index   ind = 1, 3
      index   kk1 = 1,1
      index   kk2 = 1,1
      index   oact = 1, naoccorb
      index   vact = 1, navirtorb
      index   oact1 = 1, naoccorb
      index   vact1 = 1, navirtorb
#--------------------------------------------------------------|
# Indices for molecular orbitals                               |
#--------------------------------------------------------------|
      moaindex i = baocc, eaocc
      moaindex j = baocc, eaocc
      moaindex k = baocc, eaocc
      moaindex l = baocc, eaocc

      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc

      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1 = bavirt, eavirt

      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc

      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt

      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt

      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt

      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb


#--------------------------------------------------------------|
#    Arrays of EOM-CCSD EA and IP vectorswhich will be used to | 
#    generate S(+) and S(-) amplitudes                         |
#--------------------------------------------------------------|

      served EA_EVAL(kk1,target_roots)
      served EA_EVEC_R_p_a(a,target_roots)
      served EA_EVEC_R_p_b(b,target_roots)
      served EA_EVEC_R_abi_aaa(a,c1,i,target_roots)
      served EA_EVEC_R_abi_bbb(b,d,j,target_roots)
      served EA_EVEC_R_abi_abb(a,d,j,target_roots)
      served EA_EVEC_R_abi_baa(b,c1,i,target_roots)
      served EA_EVEC_L_p_a(a,target_roots)
      served EA_EVEC_L_p_b(b,target_roots)
      served EA_EVEC_L_abi_aaa(a,c1,i,target_roots)
      served EA_EVEC_L_abi_bbb(b,d,j,target_roots)
      served EA_EVEC_L_abi_abb(a,d,j,target_roots)
      served EA_EVEC_L_abi_baa(b,c1,i,target_roots)

      served IP_EVAL(kk1,target_roots)
      served IP_EVEC_R_h_a(i,target_roots)
      served IP_EVEC_R_h_b(j,target_roots)
      served IP_EVEC_R_ija_aaa(i,k,a,target_roots)
      served IP_EVEC_R_ija_bbb(j,l,b,target_roots)
      served IP_EVEC_R_ija_abb(i,l,b,target_roots)
      served IP_EVEC_R_ija_baa(j,k,a,target_roots)
      served IP_EVEC_L_h_a(i,target_roots)
      served IP_EVEC_L_h_b(j,target_roots)
      served IP_EVEC_L_ija_aaa(i,k,a,target_roots)
      served IP_EVEC_L_ija_bbb(j,l,b,target_roots)
      served IP_EVEC_L_ija_abb(i,l,b,target_roots)
      served IP_EVEC_L_ija_baa(j,k,a,target_roots)

#-----------S(+) and S(-) amplitudes----------------
      served S_ij_mb(oact,i,j,b)
      served S_ej_ab(vact,a,b,j)
      served Sbar_ij_mb(oact,i,j,b)
      served Sbar_ej_ab(vact,a,b,j)

      temp tmp_S_ij_mb(oact,i,j,b)
      temp tmp_S_ej_ab(vact,a,b,j)
      temp tmp_S1_ij_mb(oact,i,j,b)
      temp tmp_S1_ej_ab(vact,a,b,j)
      temp tmp_S2_ij_mb(oact,i,j,b)
      temp tmp_S2_ej_ab(vact,a,b,j)
      temp tmp_Sbar_ij_mb(oact,i,j,b)
      temp tmp_Sbar_ej_ab(vact,a,b,j)
#--------Single-particle intermediates----------------            
      served X_mi(oact,i)
      served X_ae(a,vact)
      served X_ma(oact,a)
      served X_ie(i,vact)

      temp tmp_X_mi(oact,i)
      temp tmp_X_ae(a,vact)
      temp tmp_X_ma(oact,a)
      temp tmp_X_ie(i,vact)

      temp tmp_R_ija_abb(j,l,b,target_roots) 
      temp tmp_R_abi_abb(b,c1,i,target_roots)
      temp tmp_ia(i,a)
      temp tmp_iijb(k,i,j,a) 
      temp tmp_bjaa(a,d,i,b)
      temp tmp_piqj(a,i,b,j)
#--------Two-particle intermediates--------------------
      served Y_mi_ld(oact,i,j,b)
      served Y_ki_md(oact,b,i,j)
      served Y_ki_le(vact,k,i,j)
      served Y_dl_ea(vact,d,j,b)
      served Y_ac_le(vact,k,a,b)
      served Y_md_ac(oact,d,a,b)

      temp tmp_Y_mi_ld(oact,i,j,b)
      temp tmp_Y_ki_md(oact,b,i,j)
      temp tmp_Y_ki_le(vact,k,i,j)
      temp tmp_Y_dl_ea(vact,d,j,b)
      temp tmp_Y_ac_le(vact,k,a,b)
      temp tmp_Y_md_ac(oact,d,a,b)

      served V_mi_lj(oact,i,l,j)
      served V_ae_bd(vact,a,b,d)
      served Z_mi_nj(oact,i,oact1,j)
      served Z_ae_bf(vact,a,vact1,b)

      temp tmp_V_mi_lj(oact,i,l,j)
      temp tmp_V_ae_bd(vact,a,b,d)
      temp tmp_Z_mi_nj(oact,i,oact1,j)
      temp tmp_Z_ae_bf(vact,a,vact1,b) 

#------Two-particle intermediates for STEOM-EE--------

      served Q_ac_mi(oact,i,a,b)
      served Q_ki_ae(i,j,a,vact)
      served Q_mi_ae(oact,i,a,vact) 

      temp tmp_Q_ac_mi(oact,i,a,b)
      temp tmp_Q_ki_ae(i,j,a,vact)
      temp tmp_Q_mi_ae(oact,i,a,vact)  

      served P_bj_mc(oact,a,j,b)
      served P_bj_ke(vact,i,j,b)
      served P_bj_me(oact,vact,j,b)

      served P_bj_ke_F12(vact,i,j,b)
      served Q_ki_ae_F12(i,j,a,vact)
      served Y_ki_le_F12(vact,k,i,j)
      served X_ae_F12(a,vact)
      served X_ie_F12(i,vact)

      temp tmp_P_bj_mc(oact,a,j,b)
      temp tmp_P_bj_ke(vact,i,j,b)
      temp tmp_P_bj_me(oact,vact,j,b)

#---Transformed effective Hamiltonian elements-------- 

      served G_ik(i,k)
      served G_ac(a,b)
      served G_ia(i,a)

      served G_ik_ld(i,k,l,d)
      served G_ac_ld(a,b,l,d)
      served G_ik_jl(i,k,j,l)
      served G_ac_bd(a,a1,b,b1)
      served G_ab_ij(a,b,i,j)
      served G_ai_bj(a,i,b,j)

      temp tmp_G_ik(i,k)
      temp tmp_G_ac(a,b)
      temp tmp_G_ia(i,a)
      temp tmp_G_ik_ld(i,k,l,d) 
      temp tmp_G_ac_ld(a,b,l,d)
      temp tmp_G_ik_jl(i,k,j,l)
      temp tmp_G_ac_bd(a,a1,b,b1)
      temp tmp_G_ab_ij(a,b,i,j)
      temp tmp_G_ai_bj(a,i,b,j)
      temp tmp1_G_ai_bj(a,i,b,j)
      temp tmp1_G_ab_ij(a,b,i,j)
#----------------------------------------------------

#
#     CCSD amplitudes 
#     --------------- 

 
      distributed t1a(a,i)
      distributed t1b(b,j)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)

      served Tau_aa(a,i,a1,i1)
      served Tau_bb(b,j,b1,j1)
      served Tau_ab(a,i,b,j)


#     Transformed integrals
#     --------------------- 

      served VSpipi(p,i,p1,i1)
      served VSqjqj(q,j,q1,j1)
      served Vpiqj(p,i,q,j)
      served VSaaai(a,a1,a2,i)
      served VSbbbj(b,b1,b2,j)
      served Vaabj(a,a1,b,j)
      served Vbbai(b,b1,a,i)
      served Vjbii(j,b,i,i1)
      served Viabj(i,a,b,j)
      served Vaajj(a,a1,j,j1)
      served Vbbii(b,b1,i,i1)
      served Viaai(i,a1,a,i1)
      served Vaaii(a,a1,i,i1)
      served Vjbbj(j,b1,b,j1)
      served Vbbjj(b,b1,j,j1)
#
#     HBAR 
#     ---- 

      distributed Uaa(a,a1)
      distributed Ubb(b,b1)
      distributed Uii(i1,i)
      distributed Ujj(j1,j)
      distributed Uia(i,a)
      distributed Ujb(j,b)
#
      served Wiiii(i,i1,i2,i3)
      served Wjjjj(j,j1,j2,j3)
      served Wiijj(i,i1,j,j1)
#
      served Waaia(a,a1,i,a2)
      served Wbbjb(b,b1,j,b2)
      served Waajb(a,a1,j,b2)
      served Wbbia(b,b1,i,a2)
#
      served Wiiia(i1,i,i2,a)
      served Wjjjb(j1,j,j2,b)
      served Wiijb(i1,i,j2,b)
      served Wjjia(j1,j,i2,a)
#
      served Wiiai(i,i1,a,i2)
      served Wiibj(i,i1,b,j)
      served Wjjai(j,j1,a,i)
      served Wjjbj(j,j1,b,j2)
#
      served Wiaai(i1,a1,a,i)
      served Wjbbj(j1,b1,b,j)
      served Wiabj(i,a,b,j)
      served Wjbai(j,b,a,i)
      served Wiibb(i1,i,b,b1)
      served Wjjaa(j1,j,a,a1)
#
      served Waaai(a,a1,a2,i)
      served Wbbbj(b,b1,b2,j)
      served Waabj(a,a1,b,j)
      served Wbbai(b,b1,a,i)

#
## NOT USED ??? 
#
      served Waiaa(a,a1,i,a2) # HBAR_AIBC_aaaa
      served Wbjbb(b,b1,j,b2) # HBAR_AIBC_bbbb
      served Waibb(a,a1,j,b2) # HBAR_AIBC_aabb
      served Wbjaa(b,b1,i,a2) # HBAR_AIBC_bbaa
      served auxint2(a,i,p,j)
      served C_coef(i,j,k,l)

      served Waiia(a,i,i1,a1)
      served Wbjjb(b,j,j1,b1)
      served Waijb(a,i,j,b)
      served Wbjia(b,j,i,a)
      served Hbar_ab_eomea(a,a1)
      served Hbar_ia_eomea(a,i)
      served Hbar_ik_aj_eomea(i,k,a,j)
      served Hbar_ij_ab_eomea(i,j,a,b)
      served Hbar_ai_jb_eomea(a,i,j,b)

      static S_aux_ip(i,target_roots)
      static S_aux_ea(a,target_roots)   
      static U_ip_inv(oact,target_roots)
      static U_ea_inv(vact,target_roots)

      temp temp_S_ip(i,target_roots)
      temp temp_S_ea(a,target_roots)
      temp temp_U_ip_inv(oact,target_roots)
      temp temp_U_ea_inv(vact,target_roots)

      temp tii(i,j)
      temp taa(a,b)
      temp tai(a,i)
      temp tmp_iibb(j,i,a,b)
      temp tmp_aibj(i,a,b,j)
      temp tmp_Hbar_ab_eomea(a,a1)
      temp tmp_Hbar_ia_eomea(a,i)
      temp tmp_Hbar_ik_aj_eomea(i,k,a,j)
      temp tmp_Hbar_ij_ab_eomea(i,j,a,b)
      temp tmp_Hbar_ai_jb_eomea(a,i,j,b)

      scalar F12CALC
      scalar EAEOMF12CALC  
      scalar n_act_occ
      scalar n_act_virt
      scalar cnt_target_roots 
      scalar chunk_type
      scalar RL
      scalar ip_ind
      scalar ea_ind
      scalar cnt_occ
      scalar cnt_virt
      scalar cnt_occ1
      scalar cnt_virt1
      scalar test

#----------------------------------------------------------------|
#        Read necessary Hbar and EOM vectors                     |
#----------------------------------------------------------------|        
      PROC READ_DATA
#     --------------
      create t1a
      create t1b
      create Uaa
      create Ubb
      create Uii
      create Ujj
      create Uia
      create Ujb
      execute sip_barrier

      execute list_to_blocks                VSpipi(p,i,p1,i1)
      execute list_to_blocks                Vaaii
      execute list_to_blocks                Viaai
      execute list_to_blocks                VSaaai
      execute list_to_blocks                VSqjqj(q,j,q1,j1)
      execute list_to_blocks                Vbbjj
      execute list_to_blocks                Vjbbj
      execute list_to_blocks                VSbbbj
      execute list_to_blocks                Vjbii
      execute list_to_blocks                Vbbai
      execute list_to_blocks                Vpiqj(p,i,q,j)
      execute list_to_blocks                Viabj
      execute list_to_blocks                Vaabj
      execute list_to_blocks                Vaajj
      execute list_to_blocks                Vbbii

      execute list_to_blocks                t1a
      execute list_to_blocks                t1b
      execute list_to_blocks                T2aa
      execute list_to_blocks                T2ab
      execute list_to_blocks                T2bb
#
      execute list_to_blocks                Uaa
      execute list_to_blocks                Ubb
      execute list_to_blocks                Uii
      execute list_to_blocks                Ujj
      execute list_to_blocks                Uia
      execute list_to_blocks                Ujb
#
      execute list_to_blocks                Wiiii
      execute list_to_blocks                Wjjjj
      execute list_to_blocks                Wiijj
#
      execute list_to_blocks                Waiaa # HBAR_AIBC_aaaa
      execute list_to_blocks                Wbjbb # HBAR_AIBC_bbbb
      execute list_to_blocks                Waibb # HBAR_AIBC_aabb
      execute list_to_blocks                Wbjaa # HBAR_AIBC_bbaa
#
      execute list_to_blocks                Wiiia # HBAR_JKIA_aaaa
      execute list_to_blocks                Wjjjb # HBAR_JKIA_bbbb
      execute list_to_blocks                Wiijb # HBAR_JKIA_aabb
      execute list_to_blocks                Wjjia # HBAR_JKIA_bbaa
#
      execute list_to_blocks                Wiiai # HBAR_IAJK_aaaa
      execute list_to_blocks                Wiibj # HBAR_IAJK_aabb
      execute list_to_blocks                Wjjai # HBAR_IAJK_bbaa
      execute list_to_blocks                Wjjbj # HBAR_IAJK_bbbb
#
      execute list_to_blocks                Wiaai # HBAR_AJIB_aaaa
      execute list_to_blocks                Wjbbj # HBAR_AJIB_bbbb
      execute list_to_blocks                Wiabj # HBAR_AJIB_aabb
      execute list_to_blocks                Wjbai # HBAR_AJIB_BBAA
      execute list_to_blocks                Wiibb # HBAR_AJIB_iibb
      execute list_to_blocks                Wjjaa # HBAR_AJIB_jjaa
#
      execute list_to_blocks                Waaai # HBAR_ABCI_aaaa
      execute list_to_blocks                Wbbbj # HBAR_ABCI_bbbb
      execute list_to_blocks                Waabj # HBAR_ABCI_aabb
      execute list_to_blocks                Wbbai # HBAR_ABCI_bbaa
#
      execute list_to_blocks                IP_EVAL
      execute list_to_blocks                IP_EVEC_R_h_a
      execute list_to_blocks                IP_EVEC_R_h_b
      execute list_to_blocks                IP_EVEC_R_ija_aaa
      execute list_to_blocks                IP_EVEC_R_ija_bbb
      execute list_to_blocks                IP_EVEC_R_ija_abb
      execute list_to_blocks                IP_EVEC_R_ija_baa
      execute list_to_blocks                IP_EVEC_L_h_a
      execute list_to_blocks                IP_EVEC_L_h_a
      execute list_to_blocks                IP_EVEC_L_ija_aaa
      execute list_to_blocks                IP_EVEC_L_ija_bbb
      execute list_to_blocks                IP_EVEC_L_ija_abb
      execute list_to_blocks                IP_EVEC_L_ija_baa

      execute list_to_blocks                EA_EVAL
      execute list_to_blocks                EA_EVEC_R_p_a
      execute list_to_blocks                EA_EVEC_R_p_b
      execute list_to_blocks                EA_EVEC_R_abi_aaa
      execute list_to_blocks                EA_EVEC_R_abi_bbb
      execute list_to_blocks                EA_EVEC_R_abi_abb
      execute list_to_blocks                EA_EVEC_R_abi_baa
      execute list_to_blocks                EA_EVEC_L_p_a
      execute list_to_blocks                EA_EVEC_L_p_a
      execute list_to_blocks                EA_EVEC_L_abi_aaa
      execute list_to_blocks                EA_EVEC_L_abi_bbb
      execute list_to_blocks                EA_EVEC_L_abi_abb
      execute list_to_blocks                EA_EVEC_L_abi_baa

      IF EAEOMF12CALC == 1.0
      execute list_to_blocks                Hbar_ab_eomea
      execute list_to_blocks                Hbar_ia_eomea
      execute list_to_blocks                Hbar_ik_aj_eomea
      execute list_to_blocks                Hbar_ij_ab_eomea
      execute list_to_blocks                Hbar_ai_jb_eomea
      ENDIF

      execute read_list_to_blocks
      execute server_barrier

      ENDPROC READ_DATA
#     ----------------- 

#------------------------------------------------------------------|
#       Generate S(+) and S(-) amplitudes                          |
#------------------------------------------------------------------|
      PROC MAKE_S_AMPLITUDES
#     ----------------------

#--------------Initialization of arrays----------------------------|

      DO target_roots
       DO i
       temp_S_ip(i,target_roots) = 0.0
       S_aux_ip(i,target_roots) = temp_S_ip(i,target_roots) 
       ENDDO i
      ENDDO target_roots

      execute server_barrier

      DO target_roots
       DO a
       temp_S_ea(a,target_roots) = 0.0
       S_aux_ea(a,target_roots) = temp_S_ea(a,target_roots)
       ENDDO a
      ENDDO target_roots

      execute server_barrier


      DO target_roots
       DO oact
       temp_U_ip_inv(oact,target_roots) = 0.0
       U_ip_inv(oact,target_roots) = temp_U_ip_inv(oact,target_roots)
       ENDDO oact
      ENDDO target_roots

      execute server_barrier

      DO target_roots
       DO vact
       temp_U_ea_inv(vact,target_roots) = 0.0
       U_ea_inv(vact,target_roots) = temp_U_ea_inv(vact,target_roots)
       ENDDO vact
      ENDDO target_roots

      execute server_barrier



#----------Occupied active orbitals-------------------|
      cnt_target_roots = 0.0
     
      DO target_roots
      cnt_target_roots += 1.0
      IF cnt_target_roots > n_act_occ
      EXIT
      ENDIF 

       DO i
       REQUEST IP_EVEC_R_h_a(i,target_roots) i
       temp_S_ip(i,target_roots) = IP_EVEC_R_h_a(i,target_roots)
       S_aux_ip(i,target_roots) = temp_S_ip(i,target_roots)
       ENDDO i
      ENDDO target_roots
 
      execute server_barrier 
#----------Virtual active orbitals--------------------|
      cnt_target_roots = 0.0

      DO target_roots
      cnt_target_roots += 1.0
      IF cnt_target_roots > n_act_virt
      EXIT
      ENDIF

       DO a
       REQUEST EA_EVEC_R_p_a(a,target_roots) a
       temp_S_ea(a,target_roots) = EA_EVEC_R_p_a(a,target_roots)
       S_aux_ea(a,target_roots) = temp_S_ea(a,target_roots)
       ENDDO a
      ENDDO target_roots

      execute server_barrier
#-----------------------------------------------------|
#   Make [U(+)]^{-1} and [U(-)]^{-1}                  | 
#-----------------------------------------------------|

           chunk_type = 1.0
           RL = 1.0
           execute eomchunk RL chunk_type           
           execute steom_u_inv S_aux_ip U_ip_inv
           RL = 2.0
           execute eomchunk RL chunk_type
           execute steom_u_inv S_aux_ea U_ea_inv

           execute server_barrier
#--------------------------------------------------------|
#          S_ij_mb amplitudes                            |
#--------------------------------------------------------|            

           PARDO i,j,a
   
           cnt_target_roots = 0.0
           DO target_roots
           cnt_target_roots += 1.0
           IF cnt_target_roots > n_act_occ
           EXIT
           ENDIF

           REQUEST IP_EVEC_R_ija_abb(i,j,a,target_roots) i      
           tmp_R_ija_abb(i,j,a,target_roots) = IP_EVEC_R_ija_abb(i,j,a,target_roots)

           DO oact
           temp_U_ip_inv(oact,target_roots) = U_ip_inv(oact,target_roots)
           tmp_S_ij_mb(oact,i,j,a) = tmp_R_ija_abb(i,j,a,target_roots)*temp_U_ip_inv(oact,target_roots)
           tmp_S_ij_mb(oact,i,j,a) *= -1.0

           PREPARE  S_ij_mb(oact,i,j,a) += tmp_S_ij_mb(oact,i,j,a)

           ENDDO oact 
           ENDDO target_roots 
           ENDPARDO i,j,a

           execute server_barrier


#--------------------------------------------------------|
#          S_ej_ab amplitudes                            |
#--------------------------------------------------------|            
           PARDO a,b,i

           cnt_target_roots = 0.0
           DO target_roots
           cnt_target_roots += 1.0
           IF cnt_target_roots > n_act_virt
           EXIT
           ENDIF

           REQUEST EA_EVEC_R_abi_abb(a,b,i,target_roots) a
           tmp_R_abi_abb(a,b,i,target_roots) = EA_EVEC_R_abi_abb(a,b,i,target_roots)

           DO vact
           temp_U_ea_inv(vact,target_roots) = U_ea_inv(vact,target_roots)
           tmp_S_ej_ab(vact,a,b,i) = tmp_R_abi_abb(a,b,i,target_roots)*temp_U_ea_inv(vact,target_roots)
         
           PREPARE S_ej_ab(vact,a,b,i) += tmp_S_ej_ab(vact,a,b,i) 

           ENDDO vact
           ENDDO target_roots
           ENDPARDO a,b,i

           execute server_barrier


#----------------------------------------------------------------------|
# Sbar_ij_mb = 2*S_ij_mb - S_ji_mb ; Sbar_ej_ab = 2*S_ej_ab - S_ej_ba  |
#----------------------------------------------------------------------|

         PARDO i,j,a
         DO oact
         REQUEST S_ij_mb(oact,i,j,a) i
         REQUEST S_ij_mb(oact,j,i,a) i
         tmp_S_ij_mb(oact,i,j,a) = S_ij_mb(oact,i,j,a)
         tmp_S1_ij_mb(oact,j,i,a) = S_ij_mb(oact,j,i,a)
         tmp_S2_ij_mb(oact,i,j,a) = tmp_S1_ij_mb(oact,j,i,a)
         tmp_S_ij_mb(oact,i,j,a) *= 2.0
         tmp_S2_ij_mb(oact,i,j,a) *= -1.0      
         tmp_Sbar_ij_mb(oact,i,j,a) = tmp_S_ij_mb(oact,i,j,a)
         tmp_Sbar_ij_mb(oact,i,j,a) += tmp_S2_ij_mb(oact,i,j,a)

         PREPARE Sbar_ij_mb(oact,i,j,a) += tmp_Sbar_ij_mb(oact,i,j,a) 
         ENDDO oact
         ENDPARDO i,j,a
         execute server_barrier

        PARDO a,b,i
         DO vact
         REQUEST S_ej_ab(vact,a,b,i) i
         REQUEST S_ej_ab(vact,b,a,i) i
         tmp_S_ej_ab(vact,a,b,i) = S_ej_ab(vact,a,b,i)
         tmp_S1_ej_ab(vact,b,a,i) = S_ej_ab(vact,b,a,i)
         tmp_S2_ej_ab(vact,a,b,i) = tmp_S1_ej_ab(vact,b,a,i) 
         tmp_S_ej_ab(vact,a,b,i) *= 2.0
         tmp_S2_ej_ab(vact,a,b,i) *= -1.0
         tmp_Sbar_ej_ab(vact,a,b,i) = tmp_S_ej_ab(vact,a,b,i)
         tmp_Sbar_ej_ab(vact,a,b,i) += tmp_S2_ej_ab(vact,a,b,i)  

         PREPARE Sbar_ej_ab(vact,a,b,i) += tmp_Sbar_ej_ab(vact,a,b,i)

         ENDDO vact
         ENDPARDO a,b,i
         execute server_barrier
#---------------------------------------------------------|

      ENDPROC MAKE_S_AMPLITUDES
#     -------------------------

#---------------------------------------------------------|
#     Generation of single-particle intermediates         |
#---------------------------------------------------------|
      PROC MAKE_INTERM_pq
#     ----------------------

#----------------------------------|
#     X_mi(m,i)                    |
#----------------------------------|
      PARDO i,j,a
      GET Uia(j,a)
      tmp_ia(j,a) = Uia(j,a)
      DO oact
      REQUEST Sbar_ij_mb(oact,i,j,a) i
      tmp_Sbar_ij_mb(oact,i,j,a) = Sbar_ij_mb(oact,i,j,a)
      tmp_X_mi(oact,i) = tmp_Sbar_ij_mb(oact,i,j,a)*tmp_ia(j,a)      
      PREPARE X_mi(oact,i) += tmp_X_mi(oact,i)
      ENDDO oact
      ENDPARDO i,j,a
      execute server_barrier

      PARDO i,j,k,a
      REQUEST Wiijb(k,i,j,a) i
      tmp_iijb(k,i,j,a) = Wiijb(k,i,j,a)  
      DO oact
      REQUEST Sbar_ij_mb(oact,k,j,a) j
      tmp_Sbar_ij_mb(oact,k,j,a) = Sbar_ij_mb(oact,k,j,a)
      tmp_X_mi(oact,i) = tmp_Sbar_ij_mb(oact,k,j,a)*tmp_iijb(k,i,j,a)
      tmp_X_mi(oact,i) *= -1.0
      PREPARE X_mi(oact,i) += tmp_X_mi(oact,i)
      ENDDO oact
      ENDPARDO i,j,k,a
      execute server_barrier
#----------------------------------|
#     X_ae(a,e)                    |
#----------------------------------|
      PARDO a,b,i
      GET Uia(i,b)
      tmp_ia(i,b) = Uia(i,b)
      DO vact
      REQUEST Sbar_ej_ab(vact,a,b,i) a
      tmp_Sbar_ej_ab(vact,a,b,i) = Sbar_ej_ab(vact,a,b,i)
      tmp_X_ae(a,vact) = tmp_Sbar_ej_ab(vact,a,b,i)*tmp_ia(i,b)
      PREPARE X_ae(a,vact) += tmp_X_ae(a,vact)
      ENDDO vact
      ENDPARDO a,b,i  
      execute server_barrier

      PARDO a,b,d,i
      REQUEST Wbjaa(a,d,i,b) a
      tmp_bjaa(a,d,i,b) = Wbjaa(a,d,i,b) 
      DO vact
      REQUEST Sbar_ej_ab(vact,d,b,i) d
      tmp_Sbar_ej_ab(vact,d,b,i) = Sbar_ej_ab(vact,d,b,i)
      tmp_X_ae(a,vact) = tmp_Sbar_ej_ab(vact,d,b,i)*tmp_bjaa(a,d,i,b)
      PREPARE X_ae(a,vact) += tmp_X_ae(a,vact)
      ENDDO vact
      ENDPARDO a,b,d,i
      execute server_barrier
#-----------F12 contribition to X_ae intermediate----------| 

      IF EAEOMF12CALC == 1.0
      
      chunk_type = 1.0
      RL = 1.0
      execute eomchunk RL chunk_type

 
      PARDO a,b
      REQUEST Hbar_ab_eomea(b,a) a
      tmp_Hbar_ab_eomea(b,a) = Hbar_ab_eomea(b,a)
      tmp_Hbar_ab_eomea(b,a) *= -1.0

      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      tmp_X_ae(a,vact) = 0.0

      IF cnt_virt <= ea_ind
      execute steom_f12_vact tmp_Hbar_ab_eomea tmp_X_ae 
      ENDIF 

      PREPARE X_ae_F12(a,vact) += tmp_X_ae(a,vact)
      ENDDO vact
      ENDPARDO a,b 
      execute server_barrier

#---------------------------------------------------------|
#---------------------------------------------------------|

      PARDO a
      DO vact
      REQUEST X_ae_F12(a,vact) a
      tmp_X_ae(a,vact) = X_ae_F12(a,vact)
      PREPARE X_ae(a,vact) += tmp_X_ae(a,vact)  
      ENDDO vact
      ENDPARDO a
      execute server_barrier


      ENDIF
#----------------------------------|
#     X_ma(m,a)                    |
#----------------------------------|
      PARDO i,j,a,b
      REQUEST Vpiqj(a,i,b,j) a
      tmp_piqj(a,i,b,j) = Vpiqj(a,i,b,j)
      DO oact
      REQUEST Sbar_ij_mb(oact,i,j,b) i
      tmp_Sbar_ij_mb(oact,i,j,b) = Sbar_ij_mb(oact,i,j,b)
      tmp_X_ma(oact,a) = tmp_Sbar_ij_mb(oact,i,j,b)*tmp_piqj(a,i,b,j)
      tmp_X_ma(oact,a) *= -1.0
      PREPARE X_ma(oact,a) += tmp_X_ma(oact,a)
      ENDDO oact
      ENDPARDO i,j,a,b
      execute server_barrier
#----------------------------------|
#     X_ie(i,e)                    |
#----------------------------------|
      PARDO i,j,a,b
      REQUEST Vpiqj(a,i,b,j) a
      tmp_piqj(a,i,b,j) = Vpiqj(a,i,b,j)
      DO vact
      REQUEST Sbar_ej_ab(vact,a,b,j) a
      tmp_Sbar_ej_ab(vact,a,b,j) = Sbar_ej_ab(vact,a,b,j)
      tmp_X_ie(i,vact) = tmp_Sbar_ej_ab(vact,a,b,j)*tmp_piqj(a,i,b,j)
      PREPARE X_ie(i,vact) += tmp_X_ie(i,vact)
      ENDDO vact
      ENDPARDO i,j,a,b
      execute server_barrier

#-----------F12 contribition to X_ie intermediate----------|

      IF EAEOMF12CALC == 1.0

      chunk_type = 1.0
      RL = 1.0
      execute eomchunk RL chunk_type


      PARDO i,a
      REQUEST Hbar_ia_eomea(a,i) i
      tmp_Hbar_ia_eomea(a,i) = Hbar_ia_eomea(a,i)

      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      tmp_X_ie(i,vact) = 0.0

      IF cnt_virt <= ea_ind
      execute steom_f12_vact tmp_Hbar_ia_eomea tmp_X_ie
      ENDIF

      PREPARE X_ie_F12(i,vact) += tmp_X_ie(i,vact)
      ENDDO vact
      ENDPARDO i,a
      execute server_barrier
#---------------------------------------------------------|
#---------------------------------------------------------|
      PARDO i
      DO vact 
      REQUEST X_ie_F12(i,vact) i
      tmp_X_ie(i,vact) = X_ie_F12(i,vact)
      PREPARE X_ie(i,vact) += tmp_X_ie(i,vact)
      ENDDO vact
      ENDPARDO i
      execute server_barrier


      ENDIF
#----------------------------------|
      ENDPROC MAKE_INTERM_pq 
#     -------------------------

#---------------------------------------------------------------|
#       Generation of two-particle intermediates                |
#---------------------------------------------------------------|
      PROC MAKE_INTERM_pqrs
#     ---------------------

#----------------------------------|
#     Y_mi_ld(oact,i,j,b)          |
#----------------------------------|
      PARDO i,j,k,a,b
      REQUEST Vpiqj(a,k,b,j) a
      tmp_piqj(a,k,b,j) = Vpiqj(a,k,b,j)
      DO oact
      REQUEST Sbar_ij_mb(oact,i,k,a) i
      tmp_Sbar_ij_mb(oact,i,k,a) = Sbar_ij_mb(oact,i,k,a) 
      tmp_Y_mi_ld(oact,i,j,b) = tmp_Sbar_ij_mb(oact,i,k,a)*tmp_piqj(a,k,b,j)
      PREPARE Y_mi_ld(oact,i,j,b) += tmp_Y_mi_ld(oact,i,j,b)
      ENDDO oact
      ENDPARDO i,j,k,a,b
      execute server_barrier

      PARDO i,j,k,a,b
      REQUEST Vpiqj(a,j,b,k) a
      tmp_piqj(a,j,b,k) = Vpiqj(a,j,b,k)
      DO oact
      REQUEST S_ij_mb(oact,i,k,a) i
      tmp_S_ij_mb(oact,i,k,a) = S_ij_mb(oact,i,k,a)
      tmp_Y_mi_ld(oact,i,j,b) = tmp_S_ij_mb(oact,i,k,a)*tmp_piqj(a,j,b,k)
      tmp_Y_mi_ld(oact,i,j,b) *= -1.0
      PREPARE Y_mi_ld(oact,i,j,b) += tmp_Y_mi_ld(oact,i,j,b)
      ENDDO oact
      ENDPARDO i,j,k,a,b
      execute server_barrier
#----------------------------------|
#     Y_ki_md(oact,b,i,j)          |
#----------------------------------|
      PARDO i,j,k,a,b
      REQUEST Vpiqj(a,j,b,k) a
      tmp_piqj(a,j,b,k) = Vpiqj(a,j,b,k)
      DO oact
      REQUEST S_ij_mb(oact,k,i,a) i
      tmp_S_ij_mb(oact,k,i,a) = S_ij_mb(oact,k,i,a)
      tmp_Y_ki_md(oact,b,i,j) = tmp_S_ij_mb(oact,k,i,a)*tmp_piqj(a,j,b,k)
      tmp_Y_ki_md(oact,b,i,j) *= -1.0
      PREPARE Y_ki_md(oact,b,i,j) += tmp_Y_ki_md(oact,b,i,j)
      ENDDO oact
      ENDPARDO i,j,k,a,b
      execute server_barrier

#----------------------------------|
#     Y_ki_le(vact,k,i,j)          |
#----------------------------------|
      PARDO i,j,k,a,b 
      REQUEST Vpiqj(a,k,b,j) a
      tmp_piqj(a,k,b,j) = Vpiqj(a,k,b,j) 
      DO vact
      REQUEST S_ej_ab(vact,a,b,i) a
      tmp_S_ej_ab(vact,a,b,i) = S_ej_ab(vact,a,b,i)
      tmp_Y_ki_le(vact,k,i,j) = tmp_S_ej_ab(vact,a,b,i)*tmp_piqj(a,k,b,j)
      PREPARE Y_ki_le(vact,k,i,j) += tmp_Y_ki_le(vact,k,i,j) 
      ENDDO vact 
      ENDPARDO i,j,k,a,b
      execute server_barrier
#-----------F12 contribition to Y_ki_le intermediate----------|
      IF EAEOMF12CALC == 1.0

      chunk_type = 1.0
      RL = 2.0
      execute eomchunk RL chunk_type


      PARDO i,j,k,a
      REQUEST Hbar_ik_aj_eomea(i,j,a,k) i 
      tmp_Hbar_ik_aj_eomea(i,j,a,k) = Hbar_ik_aj_eomea(i,j,a,k)
 
      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      tmp_Y_ki_le(vact,k,i,j) = 0.0

      IF cnt_virt <= ea_ind
      execute steom_f12_vact tmp_Hbar_ik_aj_eomea tmp_Y_ki_le
      ENDIF       

      PREPARE Y_ki_le_F12(vact,k,i,j) += tmp_Y_ki_le(vact,k,i,j)
      ENDDO vact
      ENDPARDO i,j,k,a
      execute server_barrier
#---------------------------------------------------------|
#---------------------------------------------------------|
      PARDO i,j,k
      DO vact
      REQUEST Y_ki_le_F12(vact,k,i,j) k
      tmp_Y_ki_le(vact,k,i,j) = Y_ki_le_F12(vact,k,i,j)
      PREPARE Y_ki_le(vact,k,i,j) += tmp_Y_ki_le(vact,k,i,j)
      ENDDO vact
      ENDPARDO i,j,k
      execute server_barrier


      ENDIF

#----------------------------------|
#     Y_dl_ea(vact,d,j,b)          |
#----------------------------------|
      PARDO a,b,d,i,j
      REQUEST Vpiqj(a,i,b,j) a
      tmp_piqj(a,i,b,j) = Vpiqj(a,i,b,j)
      DO vact
      REQUEST Sbar_ej_ab(vact,d,a,i) a
      tmp_Sbar_ej_ab(vact,d,a,i) = Sbar_ej_ab(vact,d,a,i)
      tmp_Y_dl_ea(vact,d,j,b) = tmp_Sbar_ej_ab(vact,d,a,i)*tmp_piqj(a,i,b,j)
      PREPARE Y_dl_ea(vact,d,j,b) += tmp_Y_dl_ea(vact,d,j,b)
      ENDDO vact
      ENDPARDO a,b,d,i,j
      execute server_barrier

      PARDO a,b,d,i,j
      REQUEST Vpiqj(a,j,b,i) a
      tmp_piqj(a,j,b,i) = Vpiqj(a,j,b,i)
      DO vact
      REQUEST S_ej_ab(vact,d,a,i) a
      tmp_S_ej_ab(vact,d,a,i) = S_ej_ab(vact,d,a,i)
      tmp_Y_dl_ea(vact,d,j,b) = tmp_S_ej_ab(vact,d,a,i)*tmp_piqj(a,j,b,i)
      tmp_Y_dl_ea(vact,d,j,b) *= -1.0
      PREPARE Y_dl_ea(vact,d,j,b) += tmp_Y_dl_ea(vact,d,j,b)
      ENDDO vact
      ENDPARDO a,b,d,i,j
      execute server_barrier
#----------------------------------|
#     Y_ac_le(vact,k,a,b)          |
#----------------------------------|
      PARDO a,b,d,i,j
      REQUEST Vpiqj(d,j,b,i) d
      tmp_piqj(d,j,b,i) = Vpiqj(d,j,b,i)
      DO vact
      REQUEST S_ej_ab(vact,d,a,i) d
      tmp_S_ej_ab(vact,d,a,i) = S_ej_ab(vact,d,a,i)
      tmp_Y_ac_le(vact,j,a,b) = tmp_S_ej_ab(vact,d,a,i)*tmp_piqj(d,j,b,i)
      tmp_Y_ac_le(vact,j,a,b) *= -1.0
      PREPARE Y_ac_le(vact,j,a,b) += tmp_Y_ac_le(vact,j,a,b)
      ENDDO vact
      ENDPARDO a,b,d,i,j
      execute server_barrier
#----------------------------------|
#     Y_md_ac(oact,d,a,b)          |
#----------------------------------|
      PARDO a,b,d,i,j
      REQUEST Vpiqj(d,j,b,i) d
      tmp_piqj(d,j,b,i) = Vpiqj(d,j,b,i)
      DO oact
      REQUEST S_ij_mb(oact,j,i,a) i
      tmp_S_ij_mb(oact,j,i,a) = S_ij_mb(oact,j,i,a)
      tmp_Y_md_ac(oact,d,a,b) = tmp_S_ij_mb(oact,j,i,a)*tmp_piqj(d,j,b,i)
      PREPARE Y_md_ac(oact,d,a,b) += tmp_Y_md_ac(oact,d,a,b)
      ENDDO oact
      ENDPARDO a,b,d,i,j
      execute server_barrier

#----------------------------------|
#     V_mi_lj(oact,i,l,j)          |
#----------------------------------|
      PARDO i,l,j,a
      GET Uia(j,a)
      tmp_ia(j,a) = Uia(j,a)
      DO oact
      REQUEST S_ij_mb(oact,i,l,a) i
      tmp_S_ij_mb(oact,i,l,a) = S_ij_mb(oact,i,l,a)
      tmp_V_mi_lj(oact,i,l,j) = tmp_S_ij_mb(oact,i,l,a)*tmp_ia(j,a)
      PREPARE V_mi_lj(oact,i,l,j) += tmp_V_mi_lj(oact,i,l,j)
      ENDDO oact
      ENDPARDO i,l,j,a
      execute server_barrier

      PARDO i,l,j,k,a
      REQUEST Wiijb(j,l,k,a) j
      tmp_iijb(j,l,k,a) = Wiijb(j,l,k,a) 
      DO oact
      REQUEST Sbar_ij_mb(oact,i,k,a) i
      tmp_Sbar_ij_mb(oact,i,k,a) = Sbar_ij_mb(oact,i,k,a)
      tmp_V_mi_lj(oact,i,l,j) = tmp_Sbar_ij_mb(oact,i,k,a)*tmp_iijb(j,l,k,a)
      PREPARE V_mi_lj(oact,i,l,j) += tmp_V_mi_lj(oact,i,l,j)
      ENDDO oact 
      ENDPARDO i,l,j,k,a
      execute server_barrier

      PARDO i,l,j,k,a
      REQUEST Wiijb(k,l,j,a) k
      tmp_iijb(k,l,j,a) = Wiijb(k,l,j,a)
      DO oact
      REQUEST S_ij_mb(oact,i,k,a) i
      tmp_S_ij_mb(oact,i,k,a) = S_ij_mb(oact,i,k,a)
      tmp_V_mi_lj(oact,i,l,j) = tmp_S_ij_mb(oact,i,k,a)*tmp_iijb(k,l,j,a)
      tmp_V_mi_lj(oact,i,l,j) *= -1.0
      PREPARE V_mi_lj(oact,i,l,j) += tmp_V_mi_lj(oact,i,l,j)
      ENDDO oact
      ENDPARDO i,l,j,k,a
      execute server_barrier

      PARDO i,l,j,k,a
      REQUEST Wiijb(k,i,j,a) k
      tmp_iijb(k,i,j,a) = Wiijb(k,i,j,a)
      DO oact
      REQUEST S_ij_mb(oact,k,l,a) k
      tmp_S_ij_mb(oact,k,l,a) = S_ij_mb(oact,k,l,a)
      tmp_V_mi_lj(oact,i,l,j) = tmp_S_ij_mb(oact,k,l,a)*tmp_iijb(k,i,j,a)
      tmp_V_mi_lj(oact,i,l,j) *= -1.0
      PREPARE V_mi_lj(oact,i,l,j) += tmp_V_mi_lj(oact,i,l,j)
      ENDDO oact
      ENDPARDO i,l,j,k,a
      execute server_barrier

#----------------------------------|
#     V_ae_bd(vact,a,b,d)          |
#----------------------------------|
      PARDO a,b,d,i
      GET Uia(i,d)
      tmp_ia(i,d) = Uia(i,d)
      DO vact
      REQUEST S_ej_ab(vact,a,b,i) a
      tmp_S_ej_ab(vact,a,b,i) = S_ej_ab(vact,a,b,i)      
      tmp_V_ae_bd(vact,a,b,d) = tmp_S_ej_ab(vact,a,b,i)*tmp_ia(i,d) 
      tmp_V_ae_bd(vact,a,b,d) *= -1.0
      PREPARE V_ae_bd(vact,a,b,d) += tmp_V_ae_bd(vact,a,b,d)
      ENDDO vact
      ENDPARDO a,b,d,i
      execute server_barrier

      PARDO a,b,d,i,a1
      REQUEST Wbjaa(b,d,i,a1) a1
      tmp_bjaa(b,d,i,a1) = Wbjaa(b,d,i,a1)
      DO vact
      REQUEST Sbar_ej_ab(vact,a,a1,i) a
      tmp_Sbar_ej_ab(vact,a,a1,i) = Sbar_ej_ab(vact,a,a1,i)
      tmp_V_ae_bd(vact,a,b,d) = tmp_Sbar_ej_ab(vact,a,a1,i)*tmp_bjaa(b,d,i,a1)
      PREPARE V_ae_bd(vact,a,b,d) += tmp_V_ae_bd(vact,a,b,d)
      ENDDO vact
      ENDPARDO a,b,d,i,a1
      execute server_barrier 

      PARDO a,b,d,i,a1
      REQUEST Wbjaa(b,a1,i,d) a1
      tmp_bjaa(b,a1,i,d) = Wbjaa(b,a1,i,d)
      DO vact
      REQUEST S_ej_ab(vact,a,a1,i) a
      tmp_S_ej_ab(vact,a,a1,i) = S_ej_ab(vact,a,a1,i)
      tmp_V_ae_bd(vact,a,b,d) = tmp_S_ej_ab(vact,a,a1,i)*tmp_bjaa(b,a1,i,d)
      tmp_V_ae_bd(vact,a,b,d) *= -1.0
      PREPARE V_ae_bd(vact,a,b,d) += tmp_V_ae_bd(vact,a,b,d)
      ENDDO vact
      ENDPARDO a,b,d,i,a1
      execute server_barrier

      PARDO a,b,d,i,a1
      REQUEST Wbjaa(a,a1,i,d) a1
      tmp_bjaa(a,a1,i,d) = Wbjaa(a,a1,i,d)
      DO vact
      REQUEST S_ej_ab(vact,a1,b,i) a1
      tmp_S_ej_ab(vact,a1,b,i) = S_ej_ab(vact,a1,b,i)
      tmp_V_ae_bd(vact,a,b,d) = tmp_S_ej_ab(vact,a1,b,i)*tmp_bjaa(a,a1,i,d)
      tmp_V_ae_bd(vact,a,b,d) *= -1.0
      PREPARE V_ae_bd(vact,a,b,d) += tmp_V_ae_bd(vact,a,b,d) 
      ENDDO vact
      ENDPARDO a,b,d,i,a1
      execute server_barrier

