#-----------F12 contribition to Q_ki_ae intermediate----------|

      IF EAEOMF12CALC == 1.0

      chunk_type = 1.0
      RL = 3.0
      execute eomchunk RL chunk_type

      PARDO i,j,a,b
      REQUEST Hbar_ij_ab_eomea(i,j,b,a) i
      tmp_Hbar_ij_ab_eomea(i,j,b,a) = Hbar_ij_ab_eomea(i,j,b,a) 

      cnt_virt = 0.0
      DO vact
      cnt_virt += 1.0
      tmp_Q_ki_ae(i,j,a,vact) = 0.0
      IF cnt_virt <= ea_ind
      execute steom_f12_vact tmp_Hbar_ij_ab_eomea tmp_Q_ki_ae  
      ENDIF 

      PREPARE Q_ki_ae_F12(i,j,a,vact) += tmp_Q_ki_ae(i,j,a,vact) 
      ENDDO vact
      ENDPARDO i,j,a,b
      execute server_barrier 
