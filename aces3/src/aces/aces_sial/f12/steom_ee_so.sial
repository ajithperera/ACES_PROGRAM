#--------------------------------------------------------------------------|
# This part of code does construction of EE-STEOM-SO-CI  complex  matrix   |
# of transformed effective  hamiltonian  G = {exp(S)}^{-1}*Hbar*exp{S}.    |
# After its diagonalization set of STEOM spin-orbit splitted excitation    |
#                            energies are avalable.                        |
#  Added by Denis Bokhan, Moscow Lomonosov State University,               | 
#                 Moscow, Russian Federation                               | 
#--------------------------------------------------------------------------|


                       SIAL STEOM_EE_SO
#                      ----------------

      index  roots  = 1,20
      index  cis = 1,1900
      index  cis1 = 1,1900
      index kk1 = 1,1
      index   oact = 1, naoccorb
      index   vact = 1, navirtorb
      index   oact1 = 1, naoccorb
      index   vact1 = 1, navirtorb
      index soind1 = 1, 2000
      index soind2 = 1, 2000
#--------------------------------------------------------------|


#--------------------------------------------------------------|
# Indices for molecular orbitals                               |
#--------------------------------------------------------------|

      aoindex mu     = 1, norb
      aoindex nu     = 1, norb
      aoindex lambda = 1, norb
      aoindex sigma  = 1, norb
#
      moaindex i = baocc, eaocc
      moaindex j = baocc, eaocc
      moaindex k = baocc, eaocc
      moaindex l = baocc, eaocc

      moaindex i1= baocc, eaocc
      moaindex i2= baocc, eaocc
      moaindex i3= baocc, eaocc

      moaindex a = bavirt, eavirt
      moaindex a1= bavirt, eavirt
      moaindex a2= bavirt, eavirt
      moaindex a3= bavirt, eavirt
      moaindex d = bavirt, eavirt
      moaindex c1 = bavirt, eavirt

      moaindex j1= baocc, eaocc
      moaindex j2= baocc, eaocc
      moaindex j3= baocc, eaocc

      moaindex b = bavirt, eavirt
      moaindex b1= bavirt, eavirt
      moaindex b2= bavirt, eavirt
      moaindex b3= bavirt, eavirt

      moaindex p = baocc, eavirt
      moaindex p1= baocc, eavirt
      moaindex p2= baocc, eavirt
      moaindex p3= baocc, eavirt
      moaindex q = baocc, eavirt
      moaindex q1= baocc, eavirt
      moaindex q2= baocc, eavirt
      moaindex q3= baocc, eavirt



#     CCSD amplitudes 
#     --------------- 


      distributed t1a(a,i)
      distributed t1b(b,j)
      served T2aa(a,i,a1,i1)
      served T2bb(b,j,b1,j1)
      served T2ab(a,i,b,j)

      served Tau_aa(a,i,a1,i1)
      served Tau_bb(b,j,b1,j1)
      served Tau_ab(a,i,b,j)


#---Transformed effective Hamiltonian elements--------
      served G_ik(i,k)
      served G_ac(a,b)
      served G_ia(i,a)

      served G_ik_ld(i,k,l,d)
#      served G_ac_ld(a,b,l,d)
      served G_ik_jl(i,k,j,l)
#      served G_ac_bd(a,a1,b,b1)
      served G_ab_ij(a,b,i,j)
      served G_ai_bj(a,i,b,j)

      temp tmp_G_ik(i,k)
      temp tmp_G_ac(a,b)
      temp tmp_G_ia(i,a)
      temp tmp_G_ik_ld(i,k,l,d)
      temp tmp_G_ac_ld(a,b,l,d)
      temp tmp_G_ik_jl(i,k,j,l)
#      temp tmp_G_ac_bd(a,a1,b,b1)
      temp tmp_G_ab_ij(a,b,i,j)
      temp tmp_G_ai_bj(a,i,b,j)
#-----------S(+) and S(-) amplitudes----------------
      served S_ij_mb(oact,i,j,b)
      served S_ej_ab(vact,a,b,j)
      served Sbar_ij_mb(oact,i,j,b)
      served Sbar_ej_ab(vact,a,b,j)

      temp tmp_S_ij_mb(oact,i,j,b)
      temp tmp_S_ej_ab(vact,a,b,j)
      temp tmp_S1_ij_mb(oact,i,j,b)
      temp tmp_S1_ej_ab(vact,a,b,j)
      temp tmp_S2_ij_mb(oact,i,j,b)
      temp tmp_S2_ej_ab(vact,a,b,j)
      temp tmp_Sbar_ij_mb(oact,i,j,b)
      temp tmp_Sbar_ej_ab(vact,a,b,j)


#----------------------------------------------------
      served STEOM_S_EVAL(roots)
      temp tmp_STEOM_S_EVAL(roots)
      served STEOM_T_EVAL(roots)
      temp tmp_STEOM_T_EVAL(roots)
      temp tmp_zzz(cis,cis1)
#------- A matrix-----------------
      static steom_matr_re(soind1,soind2)
      static steom_matr_im(soind1,soind2)
      static vecstat(a,i)
#----------Spin-orbit integrals and related arrays---------------------------------------

      distributed SO_x_ao(mu,nu)
      distributed SO_y_ao(mu,nu)
      distributed SO_z_ao(mu,nu)
      distributed SO_x_pmu(mu,p)
      distributed SO_y_pmu(mu,p)
      distributed SO_z_pmu(mu,p)
      distributed SO_x_pq(p,q)
      distributed SO_y_pq(p,q)
      distributed SO_z_pq(p,q)

      served V2ixxi_x(i1,nu,lambda,i)
      served V2ixxi_y(i1,nu,lambda,i)
      served V2ixxi_z(i1,nu,lambda,i)

      served V2ipxi_x(i2,p,lambda,i)
      served V2ipxi_y(i2,p,lambda,i)
      served V2ipxi_z(i2,p,lambda,i)

      served V2iixx_x(i2,i,lambda,sigma)
      served V2iixx_y(i2,i,lambda,sigma)
      served V2iixx_z(i2,i,lambda,sigma)

      served V2xiix_x(mu,i,i2,sigma)
      served V2xiix_y(mu,i,i2,sigma)
      served V2xiix_z(mu,i,i2,sigma)

      served V2iipx_x(i2,i,p,sigma)
      served V2iipx_y(i2,i,p,sigma)
      served V2iipx_z(i2,i,p,sigma)

      served V2piix_x(p,i,i2,sigma)
      served V2piix_y(p,i,i2,sigma)
      served V2piix_z(p,i,i2,sigma)

      served V2ipqi_x(i2,p,q,i)
      served V2ipqi_y(i2,p,q,i)
      served V2ipqi_z(i2,p,q,i)

      served V2iipq_x(i2,i,p,q)
      served V2iipq_y(i2,i,p,q)
      served V2iipq_z(i2,i,p,q)

      served V2piiq_x(p,i,i2,q)
      served V2piiq_y(p,i,i2,q)
      served V2piiq_z(p,i,i2,q)
#-----------SOMF Fock operators----------------------------------------------------------
      distributed Fso_pq_x(p,q)
      distributed Fso_pq_y(p,q)
      distributed Fso_pq_z(p,q)

      distributed Fso_pq_x_aux(p,q)
      distributed Fso_pq_y_aux(p,q)
      distributed Fso_pq_z_aux(p,q)

      distributed somfex_x_1(p,q)
      distributed somfex_y_1(p,q)
      distributed somfex_z_1(p,q)

      distributed somfex_x_2(p,q)
      distributed somfex_y_2(p,q)
      distributed somfex_z_2(p,q)

      distributed somfex_x_3(p,q)
      distributed somfex_y_3(p,q)
      distributed somfex_z_3(p,q)


#----------------------------------------------------------------------------------------
      TEMP Tmp_1SOIX(mu,nu)
      TEMP Tmp_1SOIY(mu,nu)
      TEMP Tmp_1SOIZ(mu,nu)

      TEMP Tmp_2SOIX(mu,nu,lambda,sigma)
      TEMP Tmp_2SOIY(mu,nu,lambda,sigma)
      TEMP Tmp_2SOIZ(mu,nu,lambda,sigma)


      temp tSO_x_pmu(mu,p)
      temp tSO_y_pmu(mu,p)
      temp tSO_z_pmu(mu,p)
      temp tSO_x_pq(p,q)
      temp tSO_y_pq(p,q)
      temp tSO_z_pq(p,q)
      temp tsox(p,q,i,j)
      temp txxxi(mu,nu,lambda,i)
      temp tixxi(i2,nu,lambda,i)
      temp tipxi(i2,p,lambda,i)
      temp tipqi(i2,p,q,i)
      temp txixx(mu,i,lambda,sigma)
      temp tiixx(i2,i,lambda,sigma)
      temp txiix(mu,i,i2,sigma)
      temp tiipx(i2,i,p,sigma)
      temp tpiix(p,i,i2,sigma)
      temp tiipq(i2,i,p,q)
      temp tpiiq(p,i,i2,q)
      temp tsomf(p,q)
      temp  TR2_VECS (a,i,a1,i1)
      temp  TL2_VECS (i,a,j,b)
      temp tmp_t2(a,j,b,i)
#-----------local arrays----------------------------------------------------------------
      local V1_4_x(mu,nu,lambda,i)
      local V1_4_y(mu,nu,lambda,i)
      local V1_4_z(mu,nu,lambda,i)

      local V2_4_x(mu,i,lambda,sigma)
      local V2_4_y(mu,i,lambda,sigma)
      local V2_4_z(mu,i,lambda,sigma)

#--------------------------------------------------------------------------------
      scalar F12CALC
      scalar EAEOMF12CALC
      scalar n_ee_roots
      scalar n_singlet_roots
      scalar n_triplet_roots
      scalar g_type
      scalar chunk_type
      scalar RL
      scalar cnt
      scalar cnt1
      scalar ncis
      scalar EVL
      scalar printnumber

      scalar n_act_occ
      scalar n_act_virt
      scalar cnt_target_roots
      scalar ip_ind
      scalar ea_ind
      scalar cnt_occ
      scalar cnt_virt
      scalar cnt_occ1
      scalar cnt_virt1

      scalar  ZERO
      scalar  ONE
      scalar  TWO
      scalar  half
      scalar  sqrtwo
      scalar  rootcount
      scalar  trp_count
      scalar  sing_count
      scalar  etemp
      scalar  etemp_sq
      scalar  tresh
      SCALAR  ASUM
      SCALAR  BSUM
      SCALAR  A_SUM
      SCALAR  B_SUM
      scalar cnt_s
      scalar cnt_t
      scalar rootmax
      scalar ind
      scalar sct
      scalar tct
      scalar tct1
      scalar tct2
      scalar E_ccsd
      scalar cnt2
      scalar so_ci_size
      scalar cnt1_size
      scalar cnt2_size
      scalar mark1
      scalar mark2
      scalar mark3
      scalar mark4
      scalar mark5
      scalar tmpval
      scalar ecorr
      scalar so_pref
      scalar auxval
      scalar tmpval1
      scalar tmpval2
      scalar tmpval3
      scalar tmpval4
      scalar tmpval5
      scalar tmpval6
      scalar tmpval7
      scalar tmpval8
      scalar tmpval9
      scalar tmpval10
      scalar tmpval11
      scalar tmpval12
      scalar tmpval13
      scalar tmpval14
      scalar tmpval15
      scalar tmpval16
      scalar tmpval17
      scalar tmpval18
      scalar tmpval19
      scalar tmpval20
      scalar tmpval21
      scalar tmpval22
      scalar tmpval23
      scalar tmpval24
      scalar tmpval25
      scalar tmpval26
      scalar tmpval_re
      scalar tmpval_im

      scalar LROVER
      scalar LROVER_aa
      scalar LROVER_bb
      scalar LROVER_aaaa
      scalar LROVER_bbbb
      scalar LROVER_aabb
      scalar NORM
      scalar norm_sqr
      scalar mind1
      scalar mind2
      scalar mind3
      scalar mind4

      scalar RANK

#------------------------------------------------------------------|
#------------------------------------------------------------------|
      PROC READ_DATA      
#     --------------

            create t1a
            create t1b

            execute list_to_blocks     t1a
            execute list_to_blocks     t1b
            execute list_to_blocks     T2aa
            execute list_to_blocks     T2ab
            execute list_to_blocks     T2bb

#            execute list_to_blocks     S_ij_mb
#            execute list_to_blocks     S_ej_ab
#            execute list_to_blocks     Sbar_ij_mb
#            execute list_to_blocks     Sbar_ej_ab


            execute list_to_blocks      G_ik
            execute list_to_blocks      G_ac
            execute list_to_blocks      G_ia
            execute list_to_blocks      G_ik_ld
#            execute list_to_blocks      G_ac_ld
            execute list_to_blocks      G_ik_jl
#            execute list_to_blocks      G_ac_bd
            execute list_to_blocks      G_ab_ij
            execute list_to_blocks      G_ai_bj(a,i,b,j)


            execute read_list_to_blocks
            execute server_barrier

      ENDPROC READ_DATA
#     -----------------

#-------------------------------------------------------------------|
#-------------------------------------------------------------------|

      PROC SO_INT
#     ----------- 

      create SO_x_ao
      create SO_y_ao
      create SO_z_ao
      create SO_x_pmu
      create SO_y_pmu
      create SO_z_pmu
      create SO_x_pq
      create SO_y_pq
      create SO_z_pq

      PARDO mu,p
      tSO_x_pmu(mu,p) = 0.0
      PUT SO_x_pmu(mu,p) = tSO_x_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
      tSO_y_pmu(mu,p) = 0.0
      PUT SO_y_pmu(mu,p) = tSO_y_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
      tSO_z_pmu(mu,p) = 0.0
      PUT SO_z_pmu(mu,p) = tSO_z_pmu(mu,p)
      ENDPARDO mu,p
      execute sip_barrier
#--------------------------------------------
      PARDO p,q
      tSO_x_pq(p,q) = 0.0
      PUT SO_x_pq(p,q) = tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_y_pq(p,q) = 0.0
      PUT SO_y_pq(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_z_pq(p,q) = 0.0
      PUT SO_z_pq(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier
#---------------------------------------------
      create Fso_pq_x_aux
      create Fso_pq_y_aux
      create Fso_pq_z_aux

      PARDO p,q
      tSO_x_pq(p,q) = 0.0
      PUT Fso_pq_x_aux(p,q) = tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_y_pq(p,q) = 0.0
      PUT Fso_pq_y_aux(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      tSO_z_pq(p,q) = 0.0
      PUT Fso_pq_z_aux(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier
#---------------------------------------------

#--------Step 1 - calculate and transform one-electron spin-orbit integrals-------|
      PARDO mu,nu
      Tmp_1SOIX(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_XBATCH Tmp_1SOIX(mu, nu)
      PUT SO_x_ao(mu,nu) = Tmp_1SOIX(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
      Tmp_1SOIY(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_YBATCH Tmp_1SOIY(mu, nu)
      PUT SO_y_ao(mu,nu) = Tmp_1SOIY(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
      Tmp_1SOIZ(mu,nu) = 0.0
      EXECUTE COMPUTE_1SOI_ZBATCH Tmp_1SOIZ(mu, nu)
      PUT SO_z_ao(mu,nu) = Tmp_1SOIZ(mu,nu)
      ENDPARDO mu,nu
      execute sip_barrier
#------------------------------------------ 
      PARDO mu,nu
       GET SO_x_ao(mu,nu)
       Tmp_1SOIX(mu,nu) = SO_x_ao(mu,nu)
       DO p
       tSO_x_pmu(mu,p) = Tmp_1SOIX(mu,nu)*ca(nu,p)
       PUT SO_x_pmu(mu,p) += tSO_x_pmu(mu,p)
       ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
       GET SO_y_ao(mu,nu)
       Tmp_1SOIY(mu,nu) = SO_y_ao(mu,nu)
       DO p
       tSO_y_pmu(mu,p) = Tmp_1SOIY(mu,nu)*ca(nu,p)
       PUT SO_y_pmu(mu,p) += tSO_y_pmu(mu,p)
       ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier

      PARDO mu,nu
       GET SO_z_ao(mu,nu)
       Tmp_1SOIZ(mu,nu) = SO_z_ao(mu,nu)
       DO p
       tSO_z_pmu(mu,p) = Tmp_1SOIZ(mu,nu)*ca(nu,p)
       PUT SO_z_pmu(mu,p) += tSO_z_pmu(mu,p)
       ENDDO p
      ENDPARDO mu,nu
      execute sip_barrier
#----------------------------------------------------------|
#----------------------------------------------------------|
#     Prefactor of Pauli-Breit Hamiltonian:                |
#           alpha^2/2 = 1/2c^2                             |
       so_pref = 0.00002664
#----------------------------------------------------------|
      PARDO mu,p
       GET SO_x_pmu(mu,p)
       tSO_x_pmu(mu,p) = SO_x_pmu(mu,p)
       DO q
       tSO_x_pq(q,p) = tSO_x_pmu(mu,p)*ca(mu,q)
       tSO_x_pq(q,p) *= so_pref
       PUT SO_x_pq(q,p) += tSO_x_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
       GET SO_y_pmu(mu,p)
       tSO_y_pmu(mu,p) = SO_y_pmu(mu,p)
       DO q
       tSO_y_pq(q,p) = tSO_y_pmu(mu,p)*ca(mu,q)
       tSO_y_pq(q,p) *= so_pref
       PUT SO_y_pq(q,p) += tSO_y_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier

      PARDO mu,p
       GET SO_z_pmu(mu,p)
       tSO_z_pmu(mu,p) = SO_z_pmu(mu,p)
       DO q
       tSO_z_pq(q,p) = tSO_z_pmu(mu,p)*ca(mu,q)
       tSO_z_pq(q,p) *= so_pref
       PUT SO_z_pq(q,p) += tSO_z_pq(q,p)
       ENDDO q
      ENDPARDO mu,p
      execute sip_barrier
#=================================================================================|
#--------Step 2 - calculate and transform two-electron spin-orbit integrals-------|
#=================================================================================|
       PARDO mu, lambda, nu

             allocate V1_4_x(mu,nu,lambda,*)
#-------------------------------------------------------------------------------|
# NOTE: Ajith's routines do calculation of 2-e SO integrals, where derivatives  |
#  are taken like this: ( [d/dx mu] nu |V_so| lambda sigma), i.e. first pair    |
#                       of indices                                              |  
#-------------------------------------------------------------------------------|

#-----------------First index transformation------------------------------------|
#                     x - component                                             |
#-------------------------------------------------------------------------------|
          DO sigma

             Tmp_2SOIX(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_XBATCH Tmp_2SOIX(lambda,sigma,mu,nu)


                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIX(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_x(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma

#-----------------Second index transformation------------------------------------
          DO i
          DO i2
             tixxi(i2,nu,lambda,i)           = V1_4_x(mu,nu,lambda,i)*ca(mu,i2)
             PREPARE V2ixxi_x(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
          ENDDO i2
          ENDDO i

             deallocate V1_4_x(mu,nu,lambda,*)

        ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
        execute server_barrier

#---------------------------------------------------------------------------------
#---------------------------------------------------------------------------------
        PARDO mu, lambda, nu

             allocate V1_4_y(mu,nu,lambda,*)

#-----------------First index transformation------------------------------------|
#                     y - component                                             |
#-------------------------------------------------------------------------------|
          DO sigma

             Tmp_2SOIY(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_YBATCH Tmp_2SOIY(lambda,sigma,mu,nu)

                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIY(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_y(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma
#-----------------Second index transformation------------------------------------
          DO i
          DO i2
             tixxi(i2,nu,lambda,i)           = V1_4_y(mu,nu,lambda,i)*ca(mu,i2)
             PREPARE V2ixxi_y(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
          ENDDO i2
          ENDDO i

          deallocate V1_4_y(mu,nu,lambda,*)

          ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
               execute server_barrier

#---------------------------------------------------------------------------------
#---------------------------------------------------------------------------------
        PARDO mu, lambda, nu

              allocate V1_4_z(mu,nu,lambda,*)

#-----------------First index transformation------------------------------------|
#                     z - component                                             |
#-------------------------------------------------------------------------------|
          DO sigma

             Tmp_2SOIZ(lambda,sigma,mu,nu)  = 0.0
            EXECUTE COMPUTE_2SOI_ZBATCH Tmp_2SOIZ(lambda,sigma,mu,nu)

                   DO i
                   txxxi(mu,nu,lambda,i) = Tmp_2SOIZ(lambda,sigma,mu,nu)*ca(sigma,i)
                   V1_4_z(mu,nu,lambda,i) += txxxi(mu,nu,lambda,i)
                   ENDDO i

          ENDDO sigma
#-----------------Second index transformation------------------------------------
          DO i
          DO i2
             tixxi(i2,nu,lambda,i)           = V1_4_z(mu,nu,lambda,i)*ca(mu,i2)
             PREPARE V2ixxi_z(i2,nu,lambda,i) += tixxi(i2,nu,lambda,i)
          ENDDO i2
          ENDDO i

              deallocate V1_4_z(mu,nu,lambda,*)

          ENDPARDO mu, lambda, nu
#---------------------------------------------------------------------------------
          execute server_barrier


#----------Third index transformation---------------------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_x(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_x(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_x(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier
#-----------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_y(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_y(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_y(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier
#------------------------------------
        PARDO i2,nu,lambda,i
              REQUEST V2ixxi_z(i2,nu,lambda,i) i
              tixxi(i2,nu,lambda,i) = V2ixxi_z(i2,nu,lambda,i)
               DO p
               tipxi(i2,p,lambda,i) = tixxi(i2,nu,lambda,i)*ca(nu,p)
               PREPARE V2ipxi_z(i2,p,lambda,i) += tipxi(i2,p,lambda,i)
              ENDDO p
        ENDPARDO i2,nu,lambda,i
        execute server_barrier
#----------Fourth index transformation----------------------------------------|
#  At this point we generate <JQ|h_so(x/y/z)|PI> integrals                    |
#  Note the h_so = r12 x p2, i.e J index is affected by differential operator |
#-----------------------------------------------------------------------------|
        PARDO i2,p,lambda,i
              REQUEST V2ipxi_x(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_x(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_x(i2,p,q,i) += tipqi(i2,p,q,i)
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#-----------------------------------------
        PARDO i2,p,lambda,i
              REQUEST V2ipxi_y(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_y(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_y(i2,p,q,i) += tipqi(i2,p,q,i)
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#-----------------------------------------
        PARDO i2,p,lambda,i
              REQUEST V2ipxi_z(i2,p,lambda,i) i
              tipxi(i2,p,lambda,i) = V2ipxi_z(i2,p,lambda,i)
               DO q
               tipqi(i2,p,q,i) = tipxi(i2,p,lambda,i)*ca(lambda,q)
               tipqi(i2,p,q,i) *= so_pref
               PREPARE V2ipqi_z(i2,p,q,i) += tipqi(i2,p,q,i)
               ENDDO q
        ENDPARDO i2,p,lambda,i
        execute server_barrier
#------------------------------------------------------------------------------

#|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||
        PARDO mu, lambda, sigma

             allocate V2_4_x(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     x - component                                             |
#-------------------------------------------------------------------------------|

          DO nu

             Tmp_2SOIX(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_XBATCH Tmp_2SOIX(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIX(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_x(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_x(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_x(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_x(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_x(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i

              deallocate V2_4_x(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
#        execute server_barrier
#---------------------------------------------------------------------------------        
        PARDO mu, lambda, sigma

               allocate V2_4_y(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     y - component                                             |
#-------------------------------------------------------------------------------|
          DO nu

             Tmp_2SOIY(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_YBATCH Tmp_2SOIY(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIY(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_y(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_y(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_y(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_y(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_y(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i

              deallocate V2_4_y(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
        execute server_barrier
#---------------------------------------------------------------------------------        
        PARDO mu, lambda, sigma

              allocate V2_4_z(mu,*,lambda,sigma)

#-----------------First index transformation------------------------------------|
#                     z - component                                             |
#-------------------------------------------------------------------------------|
          DO nu

             Tmp_2SOIZ(lambda,sigma,mu,nu)  = 0.0
             EXECUTE COMPUTE_2SOI_ZBATCH Tmp_2SOIZ(lambda,sigma,mu,nu)

                   DO i
                   txixx(mu,i,lambda,sigma) = Tmp_2SOIZ(lambda,sigma,mu,nu)*ca(nu,i)
                   V2_4_z(mu,i,lambda,sigma) += txixx(mu,i,lambda,sigma)
                   ENDDO i

          ENDDO nu
#-----------------Second index transformation------------------------------------
              DO i
              DO i2
                 tiixx(i2,i,lambda,sigma)           = V2_4_z(mu,i,lambda,sigma)*ca(mu,i2)
                 PREPARE V2iixx_z(i2,i,lambda,sigma) += tiixx(i2,i,lambda,sigma)
              ENDDO i2
              ENDDO i

              DO i
              DO i2
               txiix(mu,i,i2,sigma) = V2_4_z(mu,i,lambda,sigma)*ca(lambda,i2)
               PREPARE V2xiix_z(mu,i,i2,sigma) += txiix(mu,i,i2,sigma)
              ENDDO i2
              ENDDO i

              deallocate V2_4_z(mu,*,lambda,sigma)

        ENDPARDO mu, lambda, sigma
#---------------------------------------------------------------------------------
        execute server_barrier

#----------Third index transformation---------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_x(i2,i,lambda,sigma) i
               tiixx(i2,i,lambda,sigma) = V2iixx_x(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_x(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_x(mu,i,i2,sigma) i
              txiix(mu,i,i2,sigma) = V2xiix_x(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_x(p,i,i2,sigma) += tpiix(p,i,i2,sigma)
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#-------------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_y(i2,i,lambda,sigma) i
               tiixx(i2,i,lambda,sigma) = V2iixx_y(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_y(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_y(mu,i,i2,sigma) i
              txiix(mu,i,i2,sigma) = V2xiix_y(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_y(p,i,i2,sigma) += tpiix(p,i,i2,sigma)
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#-------------------------------------------------
        PARDO i2,i,lambda,sigma
              REQUEST V2iixx_z(i2,i,lambda,sigma) i
               tiixx(i2,i,lambda,sigma) = V2iixx_z(i2,i,lambda,sigma)
               DO p
               tiipx(i2,i,p,sigma) = tiixx(i2,i,lambda,sigma)*ca(lambda,p)
               PREPARE V2iipx_z(i2,i,p,sigma) += tiipx(i2,i,p,sigma)
              ENDDO p
        ENDPARDO i2,i,lambda,sigma
        execute server_barrier

        PARDO mu,i,i2,sigma
              REQUEST V2xiix_z(mu,i,i2,sigma) i
              txiix(mu,i,i2,sigma) = V2xiix_z(mu,i,i2,sigma)
              DO p
              tpiix(p,i,i2,sigma) = txiix(mu,i,i2,sigma)*ca(mu,p)
              PREPARE V2piix_z(p,i,i2,sigma) += tpiix(p,i,i2,sigma)
              ENDDO p
        ENDPARDO mu,i,i2,sigma
        execute server_barrier
#----------Fourth index transformation----------------------------------------|
#  At this point we generate <IP|h_so(x/y/z)|JQ> and                          |
#                            <PI|h_so(x/y/z)|JQ> integrals                    |
#  Note the h_so = r12 x p2, i.e Q index is affected by differential operator |
#-----------------------------------------------------------------------------|
        PARDO i2,i,p,sigma
              REQUEST V2iipx_x(i2,i,p,sigma) i2
              tiipx(i2,i,p,sigma) = V2iipx_x(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref
              PREPARE V2iipq_x(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_x(p,i,i2,sigma) i2
              tpiix(p,i,i2,sigma) = V2piix_x(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_x(p,i,i2,q) += tpiiq(p,i,i2,q)
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#---------------------------------------------------------------
        PARDO i2,i,p,sigma
              REQUEST V2iipx_y(i2,i,p,sigma) i2
              tiipx(i2,i,p,sigma) = V2iipx_y(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref
              PREPARE V2iipq_y(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_y(p,i,i2,sigma) i2
              tpiix(p,i,i2,sigma) = V2piix_y(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_y(p,i,i2,q) += tpiiq(p,i,i2,q)
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#---------------------------------------------------------------
        PARDO i2,i,p,sigma
              REQUEST V2iipx_z(i2,i,p,sigma) i2
              tiipx(i2,i,p,sigma) = V2iipx_z(i2,i,p,sigma)
              DO q
              tiipq(i2,i,p,q) = tiipx(i2,i,p,sigma)*ca(sigma,q)
              tiipq(i2,i,p,q) *= so_pref
              PREPARE V2iipq_z(i2,i,p,q) += tiipq(i2,i,p,q)
              ENDDO q
        ENDPARDO i2,i,p,sigma
        execute server_barrier

        PARDO p,i,i2,sigma
              REQUEST V2piix_z(p,i,i2,sigma) i2
              tpiix(p,i,i2,sigma) = V2piix_z(p,i,i2,sigma)
              DO q
              tpiiq(p,i,i2,q) = tpiix(p,i,i2,sigma)*ca(sigma,q)
              tpiiq(p,i,i2,q) *= so_pref
              PREPARE V2piiq_z(p,i,i2,q) += tpiiq(p,i,i2,q)
              ENDDO q
        ENDPARDO p,i,i2,sigma
        execute server_barrier
#------------------------------------------------------------------------------|
#                Construction of the SOMF Fock operators                       |
#   F_so(pq) = h_so(pq) + sum_{M}(-2<MP|h_so|MQ>+3<PM|h_so|MQ>+3<Mp|h_so|qM>)  |
#   Additionally, all F_so will be multipled by factor 1/2 due to the          |
#             definition of second-quantized S(k) operators                    |
#------------------------------------------------------------------------------|
      create Fso_pq_x
      create Fso_pq_y
      create Fso_pq_z
      create somfex_x_1
      create somfex_y_1
      create somfex_z_1
      create somfex_x_2
      create somfex_y_2
      create somfex_z_2
      create somfex_x_3
      create somfex_y_3
      create somfex_z_3

#------------One-particle contributions------------------------------------------
      PARDO p,q
      GET SO_x_pq(p,q)
      tSO_x_pq(p,q) = SO_x_pq(p,q)
      tSO_x_pq(p,q) *= -0.5
      PUT Fso_pq_x(p,q) = tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET SO_y_pq(p,q)
      tSO_y_pq(p,q) = SO_y_pq(p,q)
      tSO_y_pq(p,q) *= -0.5
      PUT Fso_pq_y(p,q) = tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET SO_z_pq(p,q)
      tSO_z_pq(p,q) = SO_z_pq(p,q)
      tSO_z_pq(p,q) *= -0.5
      PUT Fso_pq_z(p,q) = tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier
#------------Two-particle contributions------------------------------------------

#---------- <MP|h_so|MQ> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2iipq_x(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_x(i,j,p,q)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= 2.0
      tSO_x_pq(p,q) *= 0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2iipq_y(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_y(i,j,p,q)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= 2.0
      tSO_y_pq(p,q) *= 0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2iipq_z(i,j,p,q) i
      tiipq(i,j,p,q) = V2iipq_z(i,j,p,q)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= 2.0
      tSO_z_pq(p,q) *= 0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier
#---------- <MP|h_so|QM> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_x(i,q,p,j) i
      tipqi(i,q,p,j) = V2ipqi_x(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= -3.0
      tSO_x_pq(p,q) *= 0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_y(i,q,p,j) i
      tipqi(i,q,p,j) = V2ipqi_y(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= -3.0
      tSO_y_pq(p,q) *= 0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2ipqi_z(i,q,p,j) i
      tipqi(i,q,p,j) = V2ipqi_z(i,q,p,j)
      tiipq(i,j,p,q) = tipqi(i,q,p,j)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= -3.0
      tSO_z_pq(p,q) *= 0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier
#---------- <PM|h_so|MQ> part ------------------------------
      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_x(p,i,j,q) i
      tpiiq(p,i,j,q) = V2piiq_x(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_x_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_x_pq
      tSO_x_pq(p,q) *= -3.0
      tSO_x_pq(p,q) *= 0.5
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_y(p,i,j,q) i
      tpiiq(p,i,j,q) = V2piiq_y(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_y_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_y_pq
      tSO_y_pq(p,q) *= -3.0
      tSO_y_pq(p,q) *= 0.5
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

      PARDO p,q,i,j
      tiipq(i,j,p,q) = 0.0
      REQUEST V2piiq_z(p,i,j,q) i
      tpiiq(p,i,j,q) = V2piiq_z(p,i,j,q)
      tiipq(i,j,p,q) = tpiiq(p,i,j,q)
      tSO_z_pq(p,q) = 0.0
      execute mksomfex tiipq tSO_z_pq
      tSO_z_pq(p,q) *= -3.0
      tSO_z_pq(p,q) *= 0.5
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q,i,j
      execute sip_barrier

#-----------Test of integrals------------------------------
      PARDO p,q
      GET Fso_pq_x(p,q)
      tSO_x_pq(p,q) = Fso_pq_x(p,q)
#      execute dump_amp tSO_x_pq
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_y(p,q)
      tSO_y_pq(p,q) = Fso_pq_y(p,q)
#      execute dump_amp tSO_y_pq
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_z(p,q)
      tSO_z_pq(p,q) = Fso_pq_z(p,q)
#      execute dump_amp tSO_z_pq
      ENDPARDO p,q
      execute sip_barrier
#------------Similarity transformation-------------------------------------------

#--------------a,b part-------------------------
      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_x(b,i)
      tSO_x_pq(a,b) = t1a(a,i)*Fso_pq_x(b,i)
      tSO_x_pq(a,b) *= -1.0
      PUT Fso_pq_x_aux(a,b) += tSO_x_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_y(b,i)
      tSO_y_pq(a,b) = t1a(a,i)*Fso_pq_y(b,i)
      tSO_y_pq(a,b) *= -1.0
      PUT Fso_pq_y_aux(a,b) += tSO_y_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
      GET t1a(a,i)
      GET Fso_pq_z(b,i)
      tSO_z_pq(a,b) = t1a(a,i)*Fso_pq_z(b,i)
      tSO_z_pq(a,b) *= -1.0
      PUT Fso_pq_z_aux(a,b) += tSO_z_pq(a,b)
      ENDPARDO a,b,i
      execute sip_barrier
#--------------i,j part-------------------------
      PARDO i,j,a
      GET t1a(a,i)
      GET Fso_pq_x(j,a)
      tSO_x_pq(i,j) = t1a(a,i)*Fso_pq_x(j,a)
      PUT Fso_pq_x_aux(i,j) += tSO_x_pq(i,j)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,i)
      GET Fso_pq_y(j,a)
      tSO_y_pq(i,j) = t1a(a,i)*Fso_pq_y(j,a)
      PUT Fso_pq_y_aux(i,j) += tSO_y_pq(i,j)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,i)
      GET Fso_pq_z(j,a)
      tSO_z_pq(i,j) = t1a(a,i)*Fso_pq_z(j,a)
      PUT Fso_pq_z_aux(i,j) += tSO_z_pq(i,j)
      ENDPARDO i,j,a
      execute sip_barrier
#--------------a,i part--------------------------

#-------------------------------------------
      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_x(j,i)
      tSO_x_pq(a,i) = Fso_pq_x(j,i)*t1a(a,j)
      tSO_x_pq(a,i) *= -1.0
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_y(j,i)
      tSO_y_pq(a,i) = Fso_pq_y(j,i)*t1a(a,j)
      tSO_y_pq(a,i) *= -1.0
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier

      PARDO i,j,a
      GET t1a(a,j)
      GET Fso_pq_z(j,i)
      tSO_z_pq(a,i) = Fso_pq_z(j,i)*t1a(a,j)
      tSO_z_pq(a,i) *= -1.0
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO i,j,a
      execute sip_barrier
#-------------------------------------------
      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_x(a,b)
      tSO_x_pq(a,i) = t1a(b,i)*Fso_pq_x(a,b)
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_y(a,b)
      tSO_y_pq(a,i) = t1a(b,i)*Fso_pq_y(a,b)
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier

      PARDO a,b,i
      GET t1a(b,i)
      GET Fso_pq_z(a,b)
      tSO_z_pq(a,i) = t1a(b,i)*Fso_pq_z(a,b)
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,b,i
      execute sip_barrier
#-------------------------------------------
      PARDO a,i,b,j
      GET Fso_pq_x(j,b)
      REQUEST T2ab(a,j,b,i) a
      tmp_t2(a,j,b,i) = T2ab(a,j,b,i)
      tSO_x_pq(a,i) = tmp_t2(a,j,b,i)*Fso_pq_x(j,b)
      tSO_x_pq(a,i) *= -1.0
      PUT Fso_pq_x_aux(a,i) += tSO_x_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier

      PARDO a,i,b,j
      GET Fso_pq_y(j,b)
      REQUEST T2ab(a,j,b,i) a
      tmp_t2(a,j,b,i) = T2ab(a,j,b,i)
      tSO_y_pq(a,i) = tmp_t2(a,j,b,i)*Fso_pq_y(j,b)
      tSO_y_pq(a,i) *= -1.0
      PUT Fso_pq_y_aux(a,i) += tSO_y_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier
#-------------------------------------------
      PARDO a,i,b,j
      GET Fso_pq_z(j,b)
      REQUEST T2ab(a,i,b,j) a
      tmp_t2 (a,i,b,j) = T2ab(a,i,b,j)
      tSO_z_pq(a,i) = tmp_t2 (a,i,b,j)*Fso_pq_z(j,b)
      tSO_z_pq(a,i) *= -1.0
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier

      PARDO a,i,b,j
      GET Fso_pq_z(j,b)
      REQUEST T2aa(a,i,b,j) a
      tmp_t2 (a,i,b,j) = T2aa(a,i,b,j)
      tSO_z_pq(a,i) = tmp_t2 (a,i,b,j)*Fso_pq_z(j,b)
      PUT Fso_pq_z_aux(a,i) += tSO_z_pq(a,i)
      ENDPARDO a,i,b,j
      execute sip_barrier
#------------Addition of similarity transformed terms---------------------
      PARDO p,q
      GET Fso_pq_x_aux(p,q)
      tSO_x_pq(p,q) = Fso_pq_x_aux(p,q)
      PUT Fso_pq_x(p,q) += tSO_x_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_y_aux(p,q)
      tSO_y_pq(p,q) = Fso_pq_y_aux(p,q)
      PUT Fso_pq_y(p,q) += tSO_y_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      PARDO p,q
      GET Fso_pq_z_aux(p,q)
      tSO_z_pq(p,q) = Fso_pq_z_aux(p,q)
      PUT Fso_pq_z(p,q) += tSO_z_pq(p,q)
      ENDPARDO p,q
      execute sip_barrier

      ENDPROC SO_INT
#     --------------

