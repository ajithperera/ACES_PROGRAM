#----------------------------------------------------------|

      PROC NR_STEOM_CONTR
#     -----------------

#--Zero out real and imaginary parts of STEOM-SO matrix----|

      execute get_my_rank RANK


      IF RANK == 0.0
 
      DO soind1
      DO soind2
      ZERO = 0.0
      steom_matr_re(soind1,soind2) = ZERO
      ENDDO soind2
      ENDDO soind1
#      execute server_barrier

      DO soind1
      DO soind2
      ZERO = 0.0
      steom_matr_im(soind1,soind2) = ZERO
      ENDDO soind2
      ENDDO soind1
#      execute server_barrier

      ENDIF

      execute broadcast_array steom_matr_re
      execute broadcast_array steom_matr_im

      execute server_barrier
#-------------------------------------------------|

#---------------Block 1-------------------------------------|

#--------G_ij - contribution-------------------------|
         chunk_type = 1.0
         RL = 1.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         REQUEST G_ik(i,j) i
         tmp_G_ik(i,j) = G_ik(i,j)
         execute steom_matr_nr tmp_G_ik steom_matr_re
         ENDDO j
         ENDDO i
         execute server_barrier
#--------G_ab - contribution-------------------------|
         chunk_type = 1.0
         RL = 2.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         REQUEST G_ac(a,b) a
         tmp_G_ac(a,b) = G_ac(a,b)
         execute steom_matr_nr tmp_G_ac steom_matr_re
         ENDDO b
         ENDDO a
         execute server_barrier
#--------G_ai_bj contribitions-----------------------|
