         DO j
         GET Fso_pq_x(j,i)
         tSO_x_pq(i,j) = Fso_pq_x(j,i)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 10.0
         RL = 2.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_x(a,b)
         tSO_x_pq(b,a) = Fso_pq_x(a,b)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO b
         ENDDO a
         execute server_barrier

#--------------F_so_y contribution----------------------|

#--------F_so_ij - contribution-------------------------|
         chunk_type = 10.0
         RL = 10.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         GET Fso_pq_y(j,i)
         tSO_y_pq(i,j) = Fso_pq_y(j,i)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 10.0
         RL = 20.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_y(a,b)
         tSO_y_pq(b,a) = Fso_pq_y(a,b)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO b
         ENDDO a
         execute server_barrier
#---------------Block 13------------------------------------|

#--------------F_so_x contribution----------------------| 

#--------F_so_ij - contribution-------------------------|
         chunk_type = 13.0
         RL = 1.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         GET Fso_pq_x(j,i)
         tSO_x_pq(i,j) = Fso_pq_x(j,i)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 13.0
         RL = 2.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_x(a,b)
         tSO_x_pq(b,a) = Fso_pq_x(a,b)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO b
         ENDDO a
         execute server_barrier

#--------------F_so_y contribution----------------------|

#--------F_so_ij - contribution-------------------------|
         chunk_type = 13.0
         RL = 10.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         GET Fso_pq_y(j,i)
         tSO_y_pq(i,j) = Fso_pq_y(j,i)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 13.0
         RL = 20.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_y(a,b)
         tSO_y_pq(b,a) = Fso_pq_y(a,b)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO b
         ENDDO a
         execute server_barrier
#---------------Block 14------------------------------------|

#--------------F_so_x contribution----------------------| 

#--------F_so_ij - contribution-------------------------|
         chunk_type = 14.0
         RL = 1.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         GET Fso_pq_x(j,i)
         tSO_x_pq(i,j) = Fso_pq_x(j,i)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 14.0
         RL = 2.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_x(a,b)
         tSO_x_pq(b,a) = Fso_pq_x(a,b)
         execute steom_matr_so tSO_x_pq steom_matr_im
         ENDDO b
         ENDDO a
         execute server_barrier

#--------------F_so_y contribution----------------------|

#--------F_so_ij - contribution-------------------------|
         chunk_type = 14.0
         RL = 10.0
         execute eomchunk RL chunk_type

         DO i
         DO j
         GET Fso_pq_y(j,i)
         tSO_y_pq(i,j) = Fso_pq_y(j,i)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO j
         ENDDO i
         execute server_barrier
#--------F_so_ab - contribution------------------------|
         chunk_type = 14.0
         RL = 20.0
         execute eomchunk RL chunk_type

         DO a
         DO b
         GET Fso_pq_y(a,b)
         tSO_y_pq(b,a) = Fso_pq_y(a,b)
         execute steom_matr_so tSO_y_pq steom_matr_re
         ENDDO b
         ENDDO a
         execute server_barrier
#-------------------------------------------------------------------|


      ENDPROC SO_MATR
#     ---------------

#===============================================================|
#                    Main program                               |
#===============================================================|

      F12CALC = 0.0
      execute f12info F12CALC
      execute print_scalar F12CALC
      execute eomeaf12info EAEOMF12CALC
      execute steomroots n_singlet_roots n_triplet_roots

#---------------------------------------------------------------|
#   Get number of active occupied and virtual orbitals          |
#---------------------------------------------------------------|
         execute eomearoots n_act_virt
         execute eomiproots n_act_occ

      ip_ind = 0.0
      DO oact
      ip_ind += 1.0
      ENDDO oact

      ip_ind -= n_act_occ
      ip_ind += 1.0

      ea_ind = 0.0
      ea_ind += n_act_virt

#----Read elements of doubly-transformed Hamiltonian G----------|
       CALL READ_DATA
#---------------------------------------------------------------|

#---Add non-relativistic matrix elements to STEOM-SO-CI matrix--|
      CALL NR_STEOM_CONTR
#---------------------------------------------------------------|

#--------- Compute SO integrals and construct SO Fock operator--|
      CALL SO_INT
#---------------------------------------------------------------|

#-Add spin-orbit couplings matrix elements to STEOM-SO-CI matrix|
      CALL SO_MATR

#---------Diagonalize complex STEOM-SO-CI matrix----------------|
#----- and print out relativistic roots to the output file -----|
       execute steom_so_diag steom_matr_re steom_matr_im


                 ENDSIAL STEOM_EE_SO
#                -------------------
