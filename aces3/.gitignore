# NOTE: this pattern covers ONLY the configure-generated Makefiles (the ones
# named in configure.ac's AC_CONFIG_FILES). The recursive driver Makefiles --
# src/Makefile, src/aces/Makefile, src/sia/Makefile, tests/Makefile and the
# rest -- are hand-written source and ARE tracked; configure never recreates
# them, so a checkout without them cannot build at all (they were lost that
# way once, in 5173405e). Being tracked already, they are unaffected by this
# rule. They are listed as explicit exceptions below rather than left to
# "well, they are already tracked": that is exactly the state 5173405e
# destroyed, and a bare `git add` skips an ignored path silently.
Makefile
!/doc/Makefile
!/src/Makefile
!/src/aces/Makefile
!/src/aces/aces_library/Makefile
!/src/aces/aces_library/a2driver/Makefile
!/src/aces/aces_library/special_directory/Makefile
!/src/aces/aces_library/special_directory/prop_ints/Makefile
!/src/sia/Makefile
!/src/sia/sip/Makefile
!/src/sial_compiler/Makefile
!/tests/Makefile

# configure/build outputs, regenerated by configure_line.* + gmake -- never
# source. The copies previously tracked here were stale HiPerGator artifacts
# (config.log still held the pre-07938684 CPU-vendor-locked -axcore-avx2 flags;
# make.err/nohup.out were logs from a long-dead /ufrc/bartlett/perera/acesiii
# build tree), i.e. exactly the kind of drift aces2 already stopped tracking
# in 5173405e.
/config.h
/config.log
/config.status
/nohup.out
*.swp
*.swo
autom4te.cache/
CVS/

tests/fast/JOBARC
tests/fast/__pycache__/
