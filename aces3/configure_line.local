# Local workstation counterpart to configure_line.ufhpc: same build, Intel
# oneAPI instead of HiPerGator's Intel-built OpenMPI.
#
# Why the wrapper names differ from the ufhpc line's mpif77/mpicc/mpicxx:
# under Intel MPI those three wrap *gcc/gfortran*, not the Intel compilers
# (`mpif77 -show` prints gfortran), which would silently mix toolchains and
# then choke on -Zp8/-zero/-shared-intel. The mpii* wrappers are the Intel
# ones -- but note mpiicc/mpiicpc are dead in oneAPI 2024.0+ (they call the
# removed classic icc/icpc); mpiicx/mpiicpx are the icx/icpx wrappers.
#
# -diag-disable=10448 silences ifort's "classic is deprecated" remark, which
# it otherwise prints on every single compile (and into every autoconf test).
./configure F77=mpiifort \
            FC=mpiifort \
            CC=mpiicx \
            CXX=mpiicpx \
            MKLFLAGS=-L$MKLROOT/lib/intel64 \
            MKLLIBS="-Wl,--start-group -lmkl_intel_lp64 -lmkl_sequential -lmkl_core  -Wl,--end-group" \
            FCFLAGS="-D__fortran -D__fortran77 -DMPIF2C -Zp8 -zero -traceback -DMPI2 -shared-intel -O2 -march=core-avx2 -diag-disable=10448" \
            CFLAGS="-DMPIF2C -DC_SUFFIX  -DMPI2 -DCB_SUFFIX -shared-intel -O2 -march=core-avx2" \
            CXXFLAGS="-DMPIF2C -DC_SUFFIX -DCB_SUFFIX  -DMPI2 -shared-intel -O2 -march=core-avx2" \
            --enable-mkl
