test -n "$USERDIR" || exit 1
# DOCI at the converged OO-pCCD orbitals (pccd_doci.in). Job 1 (r1)
# converges H2O STO-3G sym off from HF orbitals; xoorot SAVE writes the
# orbitals to c0.dat. Job 2 restarts from them (oorot LOAD) with
# pccd_doci.in: DOCI at the first point (= the minimum). DOCIENER is the
# DOCI energy (pilot_doci.py, determinant FCI in the seniority-zero
# space: -75.005667504017 from the dumped integrals).
cat <<. >ZMAT
H2O OO-pCCD RFO STO-3G DOCI
H
O 1 R
H 2 R 1 A

R=0.957
A=104.5

*ACES2(BASIS=STO-3G
CALC=PCCD,PROGRAM=PCCD
REF=RHF,MEM_SIZE=2gb
sym=off
PCCD_REF=OPTIMIZED,OO_METHOD=RFO
BRUCK_CONV=6,OO_MAXCYC=300
cc_conv=10,scf_conv=10)

.
mkdir r1 || exit 1
cp ZMAT r1 || exit 1
cd r1 || exit 1
ln -s $GENBAS . || exit 1
xjoda || exit 1
xrunpccd || exit 1
echo SAVE >oorot.in
xoorot || exit 1
test -s c0.dat || exit 1
cd .. || exit 1
cp r1/c0.dat r1/TGUESS . || exit 1
rm -rf r1
ln -s $GENBAS . || exit 1
echo LOAD >oorot.in
touch pccd_doci.in
xjoda || exit 1
xrunpccd >job2.out 2>&1 || { tail -15 job2.out; exit 1; }
grep "@-DOCI" job2.out
grep -q "@-DOCI energy" job2.out || { echo "no DOCI energy"; exit 1; }
grep -q "converged to a minimum" job2.out || { echo "no verified minimum"; exit 1; }
