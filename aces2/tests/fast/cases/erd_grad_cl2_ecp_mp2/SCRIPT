test -n "$GENBAS" && test -n "$ECPDATA" || exit 1
# MBPT(2) gradient of Cl2 with the SBKJC ECP (10 core electrons):
# xerdgrad, with its own ECP derivative integrals, against xvdint.
cat <<. >ZMAT
Cl2 SBKJC ECP MBPT(2) gradient
CL
CL 1 R*

R=2.0

*ACES2
CALC=MBPT(2),ECP=ON,SPHERICAL=OFF,BASIS=SPECIAL,OPT_MAXCYC=1
SCF_CONV=10,CC_CONV=10

CL:SBKJC
CL:SBKJC

CL:SBKJC
CL:SBKJC

.
cp $ECPDATA ECPDATA || exit 1
. "$(dirname "$0")/../../erdgrad_check.sh"
